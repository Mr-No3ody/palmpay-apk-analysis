<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelPageTitleArea
        android:id="@+id/ssma_page_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp172"
        app:cta_content_text="@string/sm_send_to_mobile_desc"
        app:cta_title="@string/sm_set_amount_text"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp168">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/sm_foreground"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.custom_view.input.CustomTextInputLayout
                    android:textColorHint="@color/ppColorTextNormal"
                    android:id="@+id/ciar_til"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/core_amount"
                    app:contentInsetStart="0dp"
                    app:contentPaddingRight="0dp"
                    app:editHintTextSize="@dimen/dp14">
                    <com.transsnet.palmpay.custom_view.AmountEditText
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#ff263138"
                        android:textColorHint="@color/ppColorTextNormal"
                        android:id="@+id/set_money_et"
                        android:background="@drawable/cv_title_input_underline"
                        android:paddingTop="6dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLength="10"
                        android:drawablePadding="2dp"
                        android:inputType="numberDecimal"/>
                </com.transsnet.palmpay.custom_view.input.CustomTextInputLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ppColorError"
                    android:id="@+id/amount_error_tv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"/>
                <com.transsnet.palmpay.custom_view.TitleEditView
                    android:id="@+id/set_money_remark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp25"
                    app:cv_max_length="40"
                    app:cv_te_inputType="text"
                    app:cv_te_title="@string/core_whats_it_for"/>
            </LinearLayout>
            <Button
                android:textSize="18dp"
                android:textColor="@color/sm_confirm_btn_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/set_money_confirm_bt"
                android:background="@drawable/core_next_btn_selector_bg"
                android:layout_width="270dp"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="@string/sm_send_money_next"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
