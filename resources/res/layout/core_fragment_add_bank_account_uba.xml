<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.core.viewmodel.ModelBankInfoItem
        android:id="@+id/itemBankInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <com.transsnet.palmpay.custom_view.TitleEditView
        android:id="@+id/itemAccountNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_te_enable="false"
        app:cv_te_inputType="bankcode"
        app:cv_te_text_color="@color/ppColorTextPrimary"
        app:cv_te_title="@string/core_bank_account_number"
        app:cv_te_title_color="@color/ppColorTextPrimary"/>
    <com.transsnet.palmpay.custom_view.TitleEditView
        android:id="@+id/itemBirth"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_te_enable="false"
        app:cv_te_show_clear_button="false"
        app:cv_te_text_color="@color/ppColorTextPrimary"
        app:cv_te_title="@string/core_date_of_birth"
        app:cv_te_title_color="@color/ppColorTextPrimary"/>
    <com.transsnet.palmpay.custom_view.TitleEditView
        android:id="@+id/itemBVN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_max_length="11"
        app:cv_te_inputType="number"
        app:cv_te_title="@string/core_bvn_of_bank_account"
        app:cv_te_title_color="@color/ppColorTextPrimary"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="25dp"
        android:text="@string/core_next"
        android:layout_marginHorizontal="25dp"
        style="@style/ppButtonStyle"/>
</LinearLayout>
