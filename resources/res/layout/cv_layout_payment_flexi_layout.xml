<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_payment_flexi_bg"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp20"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp52"
    android:paddingHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_payment_flexi_icon"
        android:layout_width="@dimen/dp24"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_flexi_icon"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorFlexiPrimary"
        android:id="@+id/tv_payment_flexi_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_payment_flexi_title"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/flexbox_payment_flexi_tag_layout"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_flexi_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexbox_payment_flexi_tag_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        app:alignItems="flex_start"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_payment_flexi_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_payment_flexi_title"
        app:layout_constraintWidth_percent="0.6"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_flexi_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_payment_flexi_get_now"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cv_get_now"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_flexi_arrow"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
</merge>
