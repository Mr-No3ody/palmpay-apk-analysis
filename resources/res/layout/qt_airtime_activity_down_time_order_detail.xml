<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:layout_below="@+id/titleBar"
        android:paddingHorizontal="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp32"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.custom_view.model.TransactionDetailHeaderModel
                android:id="@+id/model_order_result_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/model_phone_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/core_recipient_mobile"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/model_provider_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/qt_airtime_provider"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/model_bill_type_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/qt_airtime_bill_type"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/layout_bottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp40"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:layout_width="@dimen/dp20"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/tv_top_up_again"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp40"
            android:text="@string/qt_airtime_buy_again"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
