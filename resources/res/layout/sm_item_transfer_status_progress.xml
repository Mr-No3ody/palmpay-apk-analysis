<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp12">
    <View
        android:id="@+id/v_divider"
        android:background="@color/ppColorSuccess"
        android:layout_width="1.5dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_progress"
        app:layout_constraintStart_toStartOf="@+id/iv_progress"
        app:layout_constraintTop_toTopOf="@+id/iv_progress"
        style="@style/core_divider_vertical"/>
    <ImageView
        android:id="@+id/iv_progress"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:src="@drawable/cv_check_gray"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_progress_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        android:lineHeight="@dimen/dp18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_progress"
        app:layout_constraintTop_toTopOf="@+id/iv_progress"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_progress_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_progress_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_progress_title"
        style="@style/Text.9ca2aa.10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
