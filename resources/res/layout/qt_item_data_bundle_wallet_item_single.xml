<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white_stroke_dark_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/item_ratio_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,154:118"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ppColorWarning"
        android:gravity="center"
        android:id="@+id/set_meal_promotion_tv"
        android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_12"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp14"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.10"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/data_bundle_title_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/amount_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/set_meal_promotion_tv"
        app:layout_constraintVertical_chainStyle="packed">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/data_bundle_size_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Text.medium.202046.18"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/data_bundle_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp4"
            style="@style/Text.202046.12"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/ll_data_bundle_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_bundle_title_group"
        style="@style/Text.6306b2.12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_data_bundle_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintBottom_toTopOf="@+id/recent_purchase_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount_tv">
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/data_bundle_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/data_bundle_name_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6f7b85.12"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/data_bundle_name_iv"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="@dimen/dp2"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_InformationOutline"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/data_bundle_name_tv"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/recent_purchase_group"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginBottom="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/recent_purchase_iv"
            android:layout_width="@dimen/dp12"
            android:layout_height="@dimen/dp12"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_ScheduleOutline"
            app:iiv_size="@dimen/dp12"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/recent_purchase_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:text="@string/qt_data_bundle_recent_purchases"
            android:layout_marginStart="@dimen/dp2"
            style="@style/Text.6306b2.10"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
