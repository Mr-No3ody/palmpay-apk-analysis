<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/mm_auto_save"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_open"
        android:background="@color/ppColorBackgroundDark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/cv_rect_corner_12_bg_white"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12">
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvAutoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Save Status"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.6f7b85.16"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvAutoSave"
                android:paddingLeft="@dimen/dp6"
                android:paddingRight="@dimen/dp6"
                android:layout_height="@dimen/dp18"
                android:layout_marginLeft="@dimen/dp8"
                android:text="ON"
                app:layout_constraintBottom_toBottomOf="@+id/tvAutoStatus"
                app:layout_constraintLeft_toRightOf="@+id/tvAutoStatus"
                app:layout_constraintTop_toTopOf="@+id/tvAutoStatus"
                style="@style/Text.medium.202046.12"/>
            <TextView
                android:gravity="left"
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Money in your PalmPay Balance will be automatically credited to your CashBox to Earn Daily for you"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAutoStatus"
                style="@style/Text.6f7b85.12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/tvContent">
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mm_icon_auto_save_logo"
                    app:layout_constraintBottom_toBottomOf="@+id/tvUpto"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvUpto"/>
                <TextView
                    android:textStyle="bold"
                    android:id="@+id/tvUpto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp12"
                    android:text="UP\10TO"
                    android:lineSpacingMultiplier="0.9"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="@+id/tvInterestRate"
                    app:layout_constraintStart_toEndOf="@+id/iv_logo"
                    app:layout_constraintTop_toTopOf="@+id/tvInterestRate"
                    style="@style/Text.202046.10"/>
                <TextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/tvInterestRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="20%"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toEndOf="@+id/tvUpto"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.24"/>
                <TextView
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Annual Yield"
                    app:layout_constraintBottom_toBottomOf="@+id/tvInterestRate"
                    app:layout_constraintStart_toEndOf="@+id/tvInterestRate"
                    style="@style/Text.202046.10"/>
                <View
                    android:id="@+id/vLine"
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvInterestRate"/>
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Now You Can Enjoy:"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vLine"
                    style="@style/Text.medium.202046.12"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="Stress-Free Earning on Every Naira"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_start_icon="pay_SelectedOutline"
                    app:iiv_start_padding="4dp"
                    app:iiv_start_size="@dimen/dp20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                    style="@style/Text.6f7b85.12"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:id="@+id/tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="Withdraw from CashBox Anytime"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_start_icon="pay_SelectedOutline"
                    app:iiv_start_padding="4dp"
                    app:iiv_start_size="@dimen/dp20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv1"
                    style="@style/Text.6f7b85.12"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:id="@+id/tv3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="Spend Money like Your PalmPay Balance"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_start_icon="pay_SelectedOutline"
                    app:iiv_start_padding="4dp"
                    app:iiv_start_size="@dimen/dp20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv2"
                    style="@style/Text.6f7b85.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/rtvBackToCash"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp16"
            android:text="Back to CashBox"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/tvProtocol"
            app:layout_goneMarginTop="@dimen/dp24"
            app:rtv_background_color="@color/ppColorPrimary"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/tvTurnOffAutoSave"
            android:visibility="visible"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/mm_turn_off_auto_save"
            style="@style/Text.6306b2.14"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp24"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_close"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <TextView
                android:textStyle="bold"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Don’t Want to Miss"
                style="@style/Text.medium.202046.32"/>
            <TextView
                android:textStyle="bold"
                android:textColor="#6a35ff"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Interest ?"
                style="@style/Text.medium.202046.32"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mm_bg_intro_banner"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/barrier"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:translationZ="-1dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_banner"
                    app:layout_constraintLeft_toLeftOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
                    android:paddingTop="@dimen/dp16"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:translationZ="-1dp"
                    app:layout_constraintTop_toTopOf="@+id/barrier">
                    <TextView
                        android:gravity="left"
                        android:id="@+id/tvEarlyDialy"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp3"
                        android:paddingRight="@dimen/dp10"
                        android:paddingBottom="@dimen/dp3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="@dimen/dp4"
                        android:text="Turn on Auto Save, money in your PalmPay Balance will be automatically move to CashBox to Earn Daily"
                        android:layout_marginHorizontal="16dp"
                        android:paddingHorizontal="@dimen/dp10"
                        android:paddingVertical="@dimen/dp3"
                        style="@style/Text.202046.12"/>
                    <com.transsnet.palmpay.custom_view.RoundedTextView
                        android:textColor="@color/cv_color_ffffff"
                        android:id="@+id/rtvToggleAutoSave"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginBottom="@dimen/dp12"
                        android:text="@string/mm_turn_on_auto_save"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:layout_marginVertical="@dimen/dp12"
                        app:layout_constraintTop_toBottomOf="@+id/tvProtocol"
                        app:layout_goneMarginTop="@dimen/dp24"
                        app:rtv_background_color="@color/ppColorPrimary"
                        app:rtv_corner_radius="@dimen/dp12"
                        style="@style/Text.medium.ffffff.16"/>
                    <TextView
                        android:id="@+id/tv_agree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I confirm and accept Automatic Saving Service Agreement"
                        style="@style/Text.202046.10"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What Can You Get?"
                    style="@style/Text.medium.202046.16"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="1.Stress-Free Earning on Every Naira"
                    style="@style/Text.6f7b85.14"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="2.Withdraw from CashBox Anytime"
                    style="@style/Text.6f7b85.14"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="3.Spend Money like Your PalmPay Balance"
                    style="@style/Text.6f7b85.14"/>
            </LinearLayout>
            <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="@dimen/dp24"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
