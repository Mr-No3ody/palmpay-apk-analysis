<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivSuccess"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp60"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/cv_result_success"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SUCCESS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivSuccess"
        style="@style/txt_b_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvMsg"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Check your bonus and enjoy PalmPay"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutInfo"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMsg">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSubTitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PalmPay Account Number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvNo"
            android:paddingTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cv_palmpay_number_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubTitle1"
            style="@style/txt_b_b_b"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/cv_dash_line_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNo"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="KYC Level"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNo"
            style="@style/txt_mi_g"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="end|center_vertical"
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tier 1"
            app:layout_constraintBottom_toBottomOf="@+id/tv1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv1"
            style="@style/txt_mi_b_b"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp16"
            android:src="@drawable/cv_tier_1"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvLevel"
            app:layout_constraintEnd_toStartOf="@+id/tvLevel"
            app:layout_constraintTop_toTopOf="@+id/tvLevel"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ac_daily_transaction_limit_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLevel"
            style="@style/txt_mi_g"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="end|center_vertical"
            android:id="@+id/tvDailyLimit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="₦50,000"
            android:fontFamily="@font/cv_palmpay_number_bold"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv1"
            app:layout_constraintTop_toTopOf="@+id/tv2"
            style="@style/txt_mi_g"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ac_balance_limit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDailyLimit"
            style="@style/txt_mi_g"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="end|center_vertical"
            android:id="@+id/tvBalanceLimit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="₦300,000"
            android:fontFamily="@font/cv_palmpay_number_bold"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv1"
            app:layout_constraintTop_toTopOf="@+id/tv3"
            style="@style/txt_mi_g"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnView"
        android:layout_width="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="24dp"
        android:text="View Bonus"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutInfo"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
