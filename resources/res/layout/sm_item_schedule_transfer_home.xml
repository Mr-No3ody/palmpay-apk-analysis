<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp12"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <TextView
        android:id="@+id/tv_schedule_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_lg"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:id="@+id/tv_schedule_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_name"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:id="@+id/tv_schedule_type_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_amount"
        style="@style/txt_s_b"/>
    <TextView
        android:id="@+id/tv_schedule_end_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_schedule_type_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_schedule_type_name"
        style="@style/Text.6f7b85.12"/>
    <ImageView
        android:id="@+id/iv_status"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_schedule_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_schedule_name"/>
    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintTop_toBottomOf="@+id/tv_schedule_type_name"
        style="@style/core_divider_horizontal"/>
    <TextView
        android:id="@+id/tvNextTransfer"
        android:background="@drawable/cv_shape_rect_corner_2_bg_dark"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDivider"
        style="@style/Text.9ca2aa.12"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupNextTransfer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="vDivider,tvNextTransfer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
