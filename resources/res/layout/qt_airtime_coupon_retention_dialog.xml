<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp12"
        android:contentDescription="@string/qt_close"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp36"
        android:text="@string/qt_airtime_coupon_retention_title"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/couponContent"
        android:layout_width="229dp"
        android:layout_height="@dimen/dp78"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription">
        <ImageView
            android:id="@+id/ivCouponBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/qt_airtime_coupon_retention_bg"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvCouponAmount"
            android:layout_width="128dp"
            android:layout_height="0dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_number_me_b_b"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvCouponType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/couponTypeGuide"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.ffffff.14"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/couponTypeGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.53"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp16"
        android:gravity="center"
        android:id="@+id/btnGiveUp"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/qt_airtime_coupon_give_up"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnUse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/couponContent"
        style="@style/ppSecondaryButtonStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp16"
        android:gravity="center"
        android:id="@+id/btnUse"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/qt_airtime_coupon_use_it"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnGiveUp"
        app:layout_constraintTop_toBottomOf="@+id/couponContent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
