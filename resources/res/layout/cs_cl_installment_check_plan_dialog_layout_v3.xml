<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvTitle"
        android:layout_marginTop="@dimen/dp13"
        android:text="@string/core_congratulations"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp20"
        android:text="@string/cs_check_your_repayment_plan_now"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpRepaymentGuide"
        android:layout_width="match_parent"
        android:layout_height="256dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vpRepaymentGuide">
        <View
            android:id="@+id/dot0"
            android:background="@drawable/cs_repayment_guide_dot_selected"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"/>
        <View
            android:id="@+id/dot1"
            android:background="@drawable/cs_repayment_guide_dot_unselected"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"
            android:layout_marginStart="@dimen/dp8"/>
        <View
            android:id="@+id/dot2"
            android:background="@drawable/cs_repayment_guide_dot_unselected"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"
            android:layout_marginStart="@dimen/dp8"/>
        <View
            android:id="@+id/dot3"
            android:background="@drawable/cs_repayment_guide_dot_unselected"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"
            android:layout_marginStart="@dimen/dp8"/>
        <View
            android:id="@+id/dot4"
            android:background="@drawable/cs_repayment_guide_dot_unselected"
            android:visibility="gone"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"
            android:layout_marginStart="@dimen/dp8"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/btnAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_repayment_guide_next"
        android:textAllCaps="false"
        android:backgroundTint="@color/cs_main_color"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llIndicator"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llDualButtons"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llIndicator">
        <com.palmpay.lib.ui.button.PpButton
            android:textColor="@color/cs_main_color"
            android:id="@+id/btnLast"
            android:background="@drawable/cs_cl_f0ecfc_12_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cs_repayment_guide_last"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Space
            android:layout_width="@dimen/dp12"
            android:layout_height="match_parent"/>
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cs_repayment_guide_next"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:backgroundTint="@color/cs_main_color"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
