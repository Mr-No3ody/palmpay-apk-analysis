<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/main_pay_bills"/>
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/textAd"
        android:background="@color/color_foecfc"
        android:paddingLeft="@dimen/dp10"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        android:singleLine="true"
        android:drawableLeft="@drawable/cv_notify_icon"
        android:drawablePadding="@dimen/dp5"
        app:layout_constraintTop_toTopOf="parent"
        app:mvTextColor="@color/ppColorPrimary"
        app:mvTextSize="@dimen/dp12"/>
    <FrameLayout
        android:id="@+id/flBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/bundle_app_bar"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/malb_bill_save_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_scrollFlags="scroll">
                    <LinearLayout
                        android:id="@+id/mal_new_user_banner"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="158:160"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.49">
                        <com.transsnet.adsdk.widgets.banner.BannerAdView
                            android:id="@+id/adBannerLifeHome"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            app:slot_id="@string/main_home_life_bill_slot_id"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/barrier_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="right"
                        app:constraint_referenced_ids="mal_new_user_banner"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/adHome1"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:ad_default_src="@drawable/main_life_default_banner"
                        app:layout_constraintBottom_toTopOf="@+id/adHome2"
                        app:layout_constraintDimensionRatio="158:76"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0"
                        app:layout_constraintVertical_chainStyle="spread_inside"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.49"
                        app:slot_id="@string/bill_payment_home_slot_id1"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/adHome2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:ad_default_src="@drawable/main_life_default_banner"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="158:76"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/adHome1"
                        app:layout_constraintVertical_bias="1"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.49"
                        app:slot_id="@string/bill_payment_home_slot_id2"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/malb_recommend_item_area"
                    android:background="@drawable/cv_shape_rect_top_corner_white_12"
                    android:paddingTop="@dimen/dp20"
                    android:paddingBottom="@dimen/dp20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16">
                    <include
                        android:id="@+id/ma_biller_search_item"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        layout="@layout/main_layout_search_item"/>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/layout_favorites"
                        android:background="@color/ppColorBackgroundLight"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp16">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/main_life_favourites"
                            android:layout_weight="1"
                            style="@style/txt_me_b_b"/>
                        <com.mikepenz.iconics.view.IconicsTextView
                            android:gravity="center_vertical"
                            android:id="@+id/tv_edit_favourites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_edit"
                            android:drawablePadding="4dp"
                            app:iiv_end_color="@color/ppColorPrimary"
                            app:iiv_end_icon="pay_ArrowCenterRight"
                            app:iiv_end_size="@dimen/dp20"
                            style="@style/txt_s_g"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lifeMenu"
                        android:background="@color/ppColorBackgroundLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/layout_favorites"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/menuList"
                        android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                        android:paddingBottom="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp16"
                        android:layout_below="@+id/lifeMenu"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/adHome3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_below="@+id/menuList"
                        app:slot_id="@string/airtime_home_bottom_slot_id"/>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</LinearLayout>
