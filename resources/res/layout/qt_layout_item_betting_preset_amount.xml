<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/amountArea"
        android:background="@drawable/qt_preset_amount_bg_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp7"
        app:layout_constraintDimensionRatio="100:72"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/qt_tab_text_color_purple_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_currency_char_nig"
                style="@style/txt_s_b_b"/>
            <TextView
                android:textSize="@dimen/dp20"
                android:textColor="@color/qt_tab_text_color_purple_black"
                android:id="@+id/tvAmount"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_s_b_b"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvDiscount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/tvBonus"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
