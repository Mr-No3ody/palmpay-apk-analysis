<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iiv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp48"
        android:text="@string/sm_faster_send_to_palmpay_account"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <View
        android:id="@+id/iv_bg_info"
        android:background="@drawable/cv_shape_rectangle_gradient_transparent_disabled_transparent"
        android:layout_width="328dp"
        android:layout_height="@dimen/dp94"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_info">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:src="@drawable/cv_palmpay_icon_circle_purple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp180"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.14"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tv_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            style="@style/Text.medium.202046.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/iv_bg_info">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="And enjoy the benefits listed below:"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_g"/>
        <TextView
            android:textStyle="italic"
            android:gravity="center"
            android:id="@+id/tv11"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dp16"
            android:text="Free"
            app:layout_constraintEnd_toStartOf="@+id/view12"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv1"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="Absolute Free"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/tv11"
            app:layout_constraintStart_toStartOf="@+id/tv11"
            app:layout_constraintTop_toBottomOf="@+id/tv11"
            style="@style/txt_mi_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/view12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Add"
            app:iiv_size="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv11"
            app:layout_constraintEnd_toStartOf="@+id/tv13"
            app:layout_constraintStart_toEndOf="@+id/tv11"
            app:layout_constraintTop_toTopOf="@+id/tv11"/>
        <TextView
            android:textStyle="italic"
            android:gravity="center"
            android:id="@+id/tv13"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/sm_less_than_60s"
            app:layout_constraintBottom_toBottomOf="@+id/tv11"
            app:layout_constraintEnd_toStartOf="@+id/view14"
            app:layout_constraintStart_toEndOf="@+id/view12"
            app:layout_constraintTop_toTopOf="@+id/tv11"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="Credited in 60s\10Guaranteed"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/tv13"
            app:layout_constraintStart_toStartOf="@+id/tv13"
            app:layout_constraintTop_toBottomOf="@+id/tv11"
            style="@style/txt_mi_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/view14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Add"
            app:iiv_size="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv11"
            app:layout_constraintEnd_toStartOf="@+id/tv15"
            app:layout_constraintStart_toEndOf="@+id/tv13"
            app:layout_constraintTop_toTopOf="@+id/tv11"/>
        <TextView
            android:textStyle="italic"
            android:gravity="center"
            android:id="@+id/tv15"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/sm_100_percent"
            app:layout_constraintBottom_toBottomOf="@+id/tv11"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view14"
            app:layout_constraintTop_toTopOf="@+id/tv11"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="Instant Success"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/tv15"
            app:layout_constraintStart_toStartOf="@+id/tv15"
            app:layout_constraintTop_toBottomOf="@+id/tv11"
            style="@style/txt_mi_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/result_left_btn"
        android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginTop="@dimen/dp36"
        android:text="@string/core_ignore"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintEnd_toStartOf="@+id/result_right_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewContainer"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/result_right_btn"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:text="@string/core_transfer"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/result_left_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/result_left_btn"
        app:layout_constraintTop_toTopOf="@+id/result_left_btn"/>
    <com.mikepenz.iconics.view.IconicsCheckBox
        android:id="@+id/iicb_not_asking_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp22"
        android:checked="false"
        android:text="@string/sm_not_asking_next_time"
        android:drawablePadding="@dimen/dp40"
        app:iiv_checked_color="@color/ppColorPrimary"
        app:iiv_checked_icon="pay_CheckboxFill"
        app:iiv_checked_size="@dimen/dp20"
        app:iiv_unchecked_color="@color/ppColorTextAssist"
        app:iiv_unchecked_icon="pay_CheckboxOutline"
        app:iiv_unchecked_size="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/result_left_btn"
        style="@style/Text.9ca2aa.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
