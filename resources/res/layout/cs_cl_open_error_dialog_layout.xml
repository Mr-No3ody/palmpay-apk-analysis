<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="12dp"
        android:src="@drawable/cs_oc_close_icon"
        android:layout_marginEnd="12dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/close_avatar_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:srcCompat="@drawable/cs_oc_open_failed_img"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_horizontal"
        android:id="@+id/stop_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="Sorry, Flexi Cash is temporarily unavailable."
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#858a8f"
        android:gravity="center_horizontal"
        android:id="@+id/stop_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/stop_ok_bt"
        android:background="@drawable/cs_oc_got_it_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="28dp"
        android:text="@string/core_ok"
        android:textAllCaps="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
