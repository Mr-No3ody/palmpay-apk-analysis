<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp40"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp8">
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvBookingCode"
        android:layout_width="@dimen/dp62"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.14"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvFolds"
        android:layout_width="@dimen/dp64"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvBookingCode"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvOdds"
        android:layout_width="@dimen/dp72"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvFolds"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvReward"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tvOdds"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/qt_quick_bet_sports_arrow_up_icon"/>
    <TextView
        android:textColor="@color/ppColorWarning"
        android:ellipsize="end"
        android:id="@+id/tvReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvBet"
        app:layout_constraintStart_toEndOf="@+id/ivReward"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvBet"
        android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp24"
        android:text="Bet"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
