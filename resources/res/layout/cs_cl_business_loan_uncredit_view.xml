<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivProductIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/cs_cl_business_loan_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvProductTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Business Loan"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/ivProductIcon"
        app:layout_constraintStart_toEndOf="@+id/ivProductIcon"
        app:layout_constraintTop_toTopOf="@+id/ivProductIcon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvLoanAmountTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="Loanable Amount up to"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivProductIcon"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/tvLoanAmountValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="₦1,000,000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLoanAmountTitle"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvLoanApply"
        android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="@dimen/dp64"
        android:text="Apply"
        android:paddingHorizontal="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/tvLoanAmountValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLoanAmountValue"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLoanInfoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLoanApply"/>
</androidx.constraintlayout.widget.ConstraintLayout>
