<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_30"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_body"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dp5"
        android:paddingBottom="@dimen/dp5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/qt_airtime_book_airtime_top_up"
        android:paddingVertical="@dimen/dp5"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_body"
        style="@style/txt_me_b_b"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/cv_close_grey"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/qaacd_agree_text"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_operator_msg_tips"
                android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp8"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/qt_airtime_down_time_operator_tips"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp8"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="left"
                android:id="@+id/tv_operator_msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/qt_airtime_down_time_operator_msg_tips"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_operator_msg_tips"
                style="@style/txt_mi_g"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_ll_downtime_msg_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_operator_msg">
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/model_phone"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    app:cv_bm_title="@string/core_mobile_number"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/model_biller_name"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    app:cv_bm_title="@string/qt_biller_name"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/model_amount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    app:cv_bm_title="@string/qt_amount"/>
            </LinearLayout>
            <View
                android:id="@+id/view_divider_line"
                android:background="@color/ppColorDividerLine"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp1"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_ll_downtime_msg_item"/>
            <TextView
                android:id="@+id/tv_payment_method_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/qt_airtime_payment_method"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_divider_line"
                style="@style/txt_s_b_b"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_payment_method"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:cardCornerRadius="@dimen/dp12"
                app:cardElevation="@dimen/dp1"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_payment_method_title">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_ll_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_payment_method_item_ok_card"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp80"
                        android:paddingHorizontal="@dimen/dp16">
                        <ImageView
                            android:id="@+id/iv_payment_method_flexi_icon"
                            android:layout_width="@dimen/dp40"
                            android:layout_height="@dimen/dp40"
                            android:src="@drawable/cv_ok_card_icon"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:id="@+id/tv_payment_method_flexi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_ok_card"
                            android:layout_marginStart="@dimen/dp10"
                            app:layout_constraintBottom_toTopOf="@+id/tv_payment_method_flexi_desc"
                            app:layout_constraintStart_toEndOf="@+id/iv_payment_method_flexi_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"
                            style="@style/txt_b_b_b"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_okcard"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_payment_method_flexi_title"
                            app:layout_constraintStart_toEndOf="@+id/tv_payment_method_flexi_title"
                            app:layout_constraintTop_toTopOf="@+id/tv_payment_method_flexi_title"
                            style="@style/txt_s_g"/>
                        <TextView
                            android:id="@+id/tv_payment_method_flexi_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_payment_method_flexi_selected"
                            app:layout_constraintStart_toStartOf="@+id/tv_payment_method_flexi_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_payment_method_flexi_title"
                            style="@style/txt_s_b"/>
                        <ImageView
                            android:id="@+id/iv_payment_method_flexi_selected"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            android:src="@drawable/cv_circle_unchecked"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_payment_method_item_balance"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp80"
                        android:paddingHorizontal="@dimen/dp16">
                        <ImageView
                            android:id="@+id/iv_payment_method_balance_icon"
                            android:layout_width="@dimen/dp40"
                            android:layout_height="@dimen/dp40"
                            android:src="@drawable/cv_palmpay_icon_circle_purple_2"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:id="@+id/tv_payment_method_balance_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_palmpay_payment_balance"
                            android:layout_marginStart="@dimen/dp10"
                            app:layout_constraintBottom_toTopOf="@+id/tv_payment_method_balance_desc"
                            app:layout_constraintStart_toEndOf="@+id/iv_payment_method_balance_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"
                            style="@style/txt_b_b_b"/>
                        <TextView
                            android:id="@+id/tv_payment_method_balance_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_payment_method_balance_selected"
                            app:layout_constraintStart_toStartOf="@+id/tv_payment_method_balance_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_payment_method_balance_title"
                            style="@style/txt_s_b"/>
                        <ImageView
                            android:id="@+id/iv_payment_method_balance_selected"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            android:src="@drawable/cv_circle_unchecked"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="@dimen/dp12"
        android:id="@+id/qaacd_agree_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/layout_payment_method_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_payment_method_update"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp15"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp8"
            app:iiv_color="@color/ppColorTextBase"
            app:iiv_icon="pay_ScheduleOutline"
            app:iiv_size="@dimen/dp24"/>
        <TextView
            android:textColor="@color/ppColorButtonTextWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_airtime_down_time_book_transaction"
            style="@style/txt_me_w_b"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
