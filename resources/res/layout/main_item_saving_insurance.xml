<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="106dp"
    android:layout_marginTop="@dimen/dp10">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        app:layout_constraintLeft_toRightOf="@+id/ivPic"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <ImageView
        android:id="@+id/ivLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintBottom_toTopOf="@+id/tvAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ivPic"
        app:layout_constraintStart_toEndOf="@+id/ivPic"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.9ca2aa.12"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorPrimary"
        android:gravity="left"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/rtvGet"
        app:layout_constraintStart_toEndOf="@+id/ivPic"
        app:layout_constraintTop_toTopOf="@+id/rtvGet"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="left"
        android:id="@+id/tvInterval"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
        app:layout_constraintStart_toEndOf="@+id/tvAmount"
        app:layout_constraintTop_toTopOf="@+id/tvAmount"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="14dp"
        android:textColor="@color/cv_color_ffffff"
        android:id="@+id/rtvGet"
        android:layout_width="44dp"
        android:layout_height="@dimen/dp24"
        android:text="Get"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        style="@style/Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
