<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="272dp"
    android:layout_height="136dp"
    android:paddingHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="@+id/ivPic"
        app:layout_constraintLeft_toRightOf="@+id/ivPic"
        app:layout_constraintTop_toTopOf="@+id/ivPic"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:maxLines="5"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivPic"
        style="@style/Text.6f7b85.12"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp9"
        android:src="@drawable/main_icon_comment_face"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
