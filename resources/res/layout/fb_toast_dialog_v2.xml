<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?android:attr/actionBarSize">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/fb_toast_dialog_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/fb_dp16"
        style="@style/CardView">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/fb_transparent_54"
            android:paddingTop="@dimen/fb_dp12"
            android:paddingBottom="@dimen/fb_dp12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/fb_dp16"
            android:paddingEnd="@dimen/fb_dp8"
            android:paddingVertical="@dimen/fb_dp12">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fb_tips_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitXY"
                app:tint="@color/ppColorTextBase"/>
            <TextView
                android:textSize="@dimen/fb_dp12"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center_vertical"
                android:id="@+id/fb_tips_msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/fb_ivClose"
                android:padding="@dimen/fb_dp8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
