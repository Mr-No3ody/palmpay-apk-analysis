<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/mm_color_f6f6fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="72:41"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/mm_create_plan_title"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvCreatePlanTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/mm_creating_plan_title"
        android:lineHeight="@dimen/dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adView"
        style="@style/Text.medium.202046.16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAmount"
        android:background="@drawable/mm_bg_plan_info"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tvCreatePlanTitle">
        <TextView
            android:id="@+id/tvAmountDesc"
            android:text="Enter the amount you want to save?"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <TextView
            android:id="@+id/tvAmountUnit"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmountDesc"
            style="@style/Text.202046.16"/>
        <com.transsnet.palmpay.custom_view.AmountEditText
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="left"
            android:id="@+id/etAmount"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp8"
            android:singleLine="true"
            android:inputType="number"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tvAmountUnit"
            app:layout_constraintLeft_toRightOf="@+id/tvAmountUnit"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAmountUnit"
            style="@style/Text.202046.16"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="#6a35ff"
            android:id="@+id/rtvAll"
            android:visibility="gone"
            android:layout_width="45dp"
            android:layout_height="@dimen/dp24"
            android:text="@string/core_all"
            app:layout_constraintBottom_toBottomOf="@+id/etAmount"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/etAmount"
            app:rtv_background_color="@color/ppColorSecondary"
            app:rtv_corner_radius="@dimen/dp16"
            style="@style/Text.medium.ffffff.12"/>
        <View
            android:id="@+id/amountViewDivider"
            android:background="@color/ppColorTextPrimary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintTop_toBottomOf="@+id/tvAmountUnit"/>
        <TextView
            android:textColor="@color/mm_color_ff575c"
            android:gravity="left"
            android:id="@+id/tvAmountError"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/amountViewDivider"
            style="@style/Text.ffffff.12"/>
        <TextView
            android:id="@+id/tvPalmpayBalance"
            android:layout_marginTop="@dimen/dp4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmountError"
            style="@style/Text.9ca2aa.12"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_add_money"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmountError">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insufficient balance"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=", add money"
                android:textAlignment="center"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center"
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="16dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvPalmpayBalance,ll_add_money"/>
        <TextView
            android:id="@+id/tvInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Interest Rate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/Text.202046.12"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvInterestValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvInterest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInterest"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:id="@+id/tvTotalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Total Payout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInterest"
            style="@style/Text.202046.12"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvTotalTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTotalTitle"
            style="@style/Text.6f7b85.12"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/totalBarrier"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTotalTitle,tvTotalValue"/>
        <TextView
            android:id="@+id/tvDisableInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Disable Interest on Savings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTotalTitle"
            style="@style/Text.202046.12"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/switchInterestWidget"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp20"
            android:src="@drawable/cv_switch_close_gray"
            app:layout_constraintBottom_toBottomOf="@+id/tvDisableInterest"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDisableInterest"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPaybackDate"
        android:background="@drawable/mm_bg_plan_info"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/layoutAmount">
        <TextView
            android:id="@+id/tvPaybackDateDesc"
            android:layout_marginTop="@dimen/dp4"
            android:text="Savings Duration"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:weightSum="4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPaybackDateDesc"/>
        <TextView
            android:textColorHint="@color/mm_color_c0c3c8"
            android:gravity="left"
            android:id="@+id/tvPaybackDate"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:singleLine="true"
            android:drawableRight="@drawable/mm_micro_more_icon"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPaybackDateDesc"
            style="@style/Text.202046.16"/>
        <TextView
            android:id="@+id/tvMaturityDate"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonContainer"
            style="@style/Text.9ca2aa.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutGoal"
        android:background="@drawable/mm_bg_plan_info"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/layoutPaybackDate">
        <TextView
            android:id="@+id/tvGoalDesc"
            android:layout_marginTop="@dimen/dp4"
            android:text="What’s it for?"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColorHint="@color/mm_color_c0c3c8"
            android:gravity="left"
            android:id="@+id/etGoal"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:hint="Name your goal(optional)"
            android:singleLine="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGoalDesc"
            style="@style/Text.202046.16"/>
        <View
            android:id="@+id/goalViewDivider"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintTop_toBottomOf="@+id/etGoal"/>
        <TextView
            android:textColor="@color/mm_color_ff575c"
            android:gravity="left"
            android:id="@+id/tvGoalError"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:text="Limit description to 30 characters."
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goalViewDivider"
            style="@style/Text.ffffff.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAutoSave"
        android:background="@drawable/mm_bg_plan_info"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/layoutGoal">
        <include
            android:id="@+id/createAutoItem"
            layout="@layout/mm_create_auto_renewal_item"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp24"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:enabled="false"
            android:textColor="@color/md_white_1000"
            android:id="@+id/rtvNext"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
