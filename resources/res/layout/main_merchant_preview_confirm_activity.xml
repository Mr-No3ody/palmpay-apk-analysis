<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingBottom="70dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_preview_dialog_title_height"
            layout="@layout/cv_layout_preview_dialog_title"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.core.viewmodel.PreviewTitleView
                    android:id="@+id/previewTitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                    android:id="@+id/merchant_name"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_te_title="@string/core_merchant"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/merchant_id"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_title="@string/main_order_id_desc"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/merchant_amount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_amount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/merchant_fee"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_fee"/>
                <com.transsnet.palmpay.core.viewmodel.ModelUsePointsWithSwitch
                    android:id="@+id/merchant_points_use"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/merchant_points_earn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_amount_sign="₦"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_tips_text="@string/core_msg_points_rules"/>
                <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
                    android:id="@+id/itemPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/merchant_confirm_btn"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:text="@string/core_next"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/cv_preview_item_margin"
        android:layout_marginEnd="@dimen/cv_preview_item_margin"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
