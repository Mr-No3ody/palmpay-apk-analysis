<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/cvTextViewTitle"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        style="@style/EditHintText"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/small_text"
            android:textColorHint="@color/ppColorTextNormal"
            android:id="@+id/cvEditTextInput"
            android:background="@drawable/cv_title_input_underline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:drawablePadding="4dp"
            android:textCursorDrawable="@drawable/cv_editor_cursor_purple"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:importantForAutofill="no"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/cvTextViewHint"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp2"
            style="@style/txt_mi_lg"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tvBillerviewDesc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/viewError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/ppColorError"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/textViewErrorText"
            android:paddingLeft="0dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="0dp"
            android:paddingEnd="5dp"
            style="@style/txt_mi_g"/>
    </LinearLayout>
</merge>
