<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp10"
    android:layout_marginRight="@dimen/dp10"
    android:layout_marginHorizontal="@dimen/dp10">
    <ImageView
        android:id="@+id/topBgIv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintDimensionRatio="328:120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/closeIv"
        android:paddingTop="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorButtonTextWhite"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/contentTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBgIv"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llCouponLayout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="106dp"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contentTv">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/core_coupon_frame_left"
            android:padding="@dimen/dp8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/couponDateTv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0">
                <ImageView
                    android:id="@+id/couponIconIv"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:src="@drawable/cv_coupon_icon"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp4"
                    android:layout_marginRight="@dimen/dp14"
                    android:layout_toRightOf="@+id/icii_coupon_icon">
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/couponNameTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        style="@style/Text.medium.202046.14"/>
                    <TextView
                        android:gravity="start"
                        android:id="@+id/couponLimitTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/couponDateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Text.6f7b85.10"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llRightLayout"
            android:background="@drawable/core_coupon_frame_right"
            android:layout_width="@dimen/dp100"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/dp24"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/couponAmountTv"
                android:paddingTop="@dimen/dp5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_number_s_b_b"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llMobileNumberLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llCouponLayout">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_recipient_mobile"
            style="@style/Text.9ca2aa.14"/>
        <TextView
            android:gravity="end"
            android:id="@+id/mobileTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.202046.14"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llTopUpAmountLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llMobileNumberLayout">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_top_up_amount"
            style="@style/Text.9ca2aa.14"/>
        <TextView
            android:gravity="end"
            android:id="@+id/topUpAmountTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.202046.14"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/confirmTv"
        android:background="@drawable/cv_button_bg_purple_corner_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:text="@string/core_top_up"
        android:elevation="0dp"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llTopUpAmountLayout"
        style="@style/Text.medium.ffffff.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
