<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/statusBarView"
        app:title_bar_title="@string/core_safety_assessment"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvQuestionTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/Text.6f7b85.12"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/slvQuestionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/nextBtn"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestionTips"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llQuestionContainer"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:padding="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:gravity="start"
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp12"
                    style="@style/Text.medium.202046.14"/>
            </LinearLayout>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorTextAssist"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:text="PalmPay prioritize the security of your data"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp4"
                app:iiv_start_color="@color/ppColorTextAssist"
                app:iiv_start_icon="pay_SecurityOutline"
                app:iiv_start_size="@dimen/dp16"
                style="@style/Text.9ca2aa.12"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/nextBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp10"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
