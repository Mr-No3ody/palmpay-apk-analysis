<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cii_access_bank_iv"
        android:layout_width="@dimen/dp25"
        android:layout_height="@dimen/dp25"
        android:src="@drawable/cv_ok_card_icon"
        app:layout_constraintBottom_toBottomOf="@+id/cs_container"
        app:layout_constraintTop_toTopOf="@+id/cii_ll1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cii_ll1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="@dimen/dp12"
        android:paddingEnd="44dp"
        app:layout_constraintLeft_toRightOf="@+id/cii_access_bank_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/dp16">
        <TextView
            android:ellipsize="end"
            android:id="@+id/cii_bankname_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_okcard_instalments"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="left"
            android:id="@+id/cii_bank_card_number_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/text_color_gray14_646970"
        android:ellipsize="end"
        android:id="@+id/cii_hint1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="4dp"
        android:text="@string/cs_buy_now_pay_later"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/cii_access_bank_iv"
        app:layout_constraintTop_toBottomOf="@+id/cii_ll1"/>
    <FrameLayout
        android:id="@+id/cs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        app:layout_constraintLeft_toRightOf="@+id/cii_access_bank_iv"
        app:layout_constraintRight_toLeftOf="@+id/cii_apply_tv"
        app:layout_constraintTop_toBottomOf="@+id/cii_hint1">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="#63c778"
            android:id="@+id/cii_hint2"
            android:background="@drawable/cv_rect_corner_4_bg_d9fae1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_random_cashback"
            android:paddingStart="@dimen/dp5"
            android:paddingEnd="@dimen/dp5"
            app:layout_constraintLeft_toRightOf="@+id/cii_access_bank_iv"
            app:layout_constraintTop_toBottomOf="@+id/cii_hint1"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/cii_select_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_gray_unchecked"
        app:layout_constraintBottom_toBottomOf="@+id/cs_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cii_ll1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/cii_apply_tv"
        android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
        android:visibility="gone"
        android:layout_width="@dimen/dp64"
        android:layout_height="30sp"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_apply"
        android:paddingStart="@dimen/dp8"
        android:paddingEnd="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/cii_hint2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cii_ll1"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cii_rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cs_container"/>
    <RelativeLayout
        android:id="@+id/viewPaymentPlan"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp30"
        app:layout_constraintTop_toBottomOf="@+id/cii_rcv">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp10"
            android:text="@string/cs_view_payment_plan"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp16"
            android:layout_alignParentEnd="true"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"/>
    </RelativeLayout>
    <View
        android:id="@+id/cs_bottom"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/viewPaymentPlan"/>
    <View
        android:id="@+id/cii_line1"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/cs_bottom"/>
</merge>
