<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="Manage Transaction Limits"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="You are choosing to manage your daily transaction limit."
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_mi_g"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp24"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvMsg">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Transaction Limit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_me_b_b"/>
        <TextView
            android:textSize="@dimen/dp32"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/txt_b_b_b"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBarAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp2"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp2"
            android:progressDrawable="@drawable/ac_seekbar_quota_manage_style"
            android:thumb="@drawable/ac_seekbar_thumb"
            android:thumbOffset="0dp"
            android:layout_marginHorizontal="@dimen/dp2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
        <ImageView
            android:id="@+id/ivDot1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:src="@drawable/ac_dot_2dp_text_primary"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seekBarAmount"/>
        <TextView
            android:gravity="top"
            android:id="@+id/tvMsg2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivDot1"
            app:layout_constraintTop_toBottomOf="@+id/seekBarAmount"
            style="@style/txt_mi_g"/>
        <ImageView
            android:id="@+id/ivDot2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:src="@drawable/ac_dot_2dp_text_primary"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg2"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMsg3"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="The transaction limit adjustment does not apply to withdrawal limits for Cashbox, Target Savings, Spend &amp; Save, Fixed Savings and Loan services provided by Blooms Microfinance Bank in PalmPay."
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivDot2"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg2"
            style="@style/txt_mi_g"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkAgreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:button="@drawable/cv_checkbox_selector2"
        android:paddingEnd="4dp"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAgreement"/>
    <TextView
        android:textAppearance="@style/txt_mi_b"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvAgreement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingEnd="3dp"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkAgreement"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupAgreement"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvAgreement, checkAgreement"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp10"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
