<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/cs_how_to_unfreeze"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.credit.ui.viewmodel.FlexiCashUnfreezeItem
                android:id="@+id/flexiUnfreezeItem"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trans_type="g7"/>
            <com.transsnet.palmpay.credit.ui.viewmodel.FlexiCashUnfreezeItem
                android:id="@+id/cashUnfreezeItem"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trans_type="j7"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layoutTaskList"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16">
                <TextView
                    android:id="@+id/tvHowToUnfreezeTitle"
                    android:background="@drawable/cs_how_to_unfreeze_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_how_to_unfreeze"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.ffffff.14"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/tvTaskListDesc"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/cs_cl_with_uncompleted_tasks_desc"
                    app:layout_constraintTop_toTopOf="@+id/tvHowToUnfreezeTitle"
                    style="@style/Text.6f7b85.12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"/>
                <TextView
                    android:textColor="@color/md_black_1000"
                    android:gravity="left"
                    android:id="@+id/tvCompletedTasksTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="Completed tasks"
                    style="@style/Text.medium.ffffff.16"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/tvCompletedTaskListDesc"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp6"
                    android:text="@string/cs_cl_without_uncompleted_tasks_desc"
                    style="@style/Text.6f7b85.12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCompletedTaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_marginVertical="@dimen/dp8"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ViewStub
        android:id="@+id/viewStub"
        android:layout="@layout/cs_layout_no_frozen_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/loadingView"
        android:visibility="gone"
        android:layout_width="@dimen/dp102"
        android:layout_height="88dp"
        app:cardBackgroundColor="@color/transparent_70"
        app:cardCornerRadius="@dimen/dp16"
        app:cardElevation="0dp"
        app:contentPadding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center_horizontal"
            android:id="@+id/progressBar"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:layout_marginTop="@dimen/dp16"
            app:indicatorColor="@color/ppColorTextBase"
            app:indicatorName="com.transsnet.palmpay.custom_view.indicator.BallClipRotateWithoutScaleIndicator"
            style="@style/AVLoadingIndicatorView.Large"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp55"
            android:text="Loading"
            style="@style/txt_s_w"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
