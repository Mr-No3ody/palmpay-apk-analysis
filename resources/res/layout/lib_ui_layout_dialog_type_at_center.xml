<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/topHeaderBgStub"
        android:layout="@layout/lib_ui_dialog_top_header_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/headerOverlapGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="24dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ivTopHeaderBg,headerOverlapGuide"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/viewRoot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="@dimen/ppDialogBgCornerRadius"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBottomBarrier"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="@dimen/ppDialogVerticalMargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ppDialogTopIconSize"
                android:layout_marginBottom="10dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/secondHeaderStub"
                android:layout="@layout/lib_ui_layout_dialog_second_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
            <org.sufficientlysecure.htmltextview.HtmlTextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:paddingLeft="@dimen/ppDialogHorizontalMargin"
                android:paddingRight="@dimen/ppDialogHorizontalMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ppDialogHorizontalMargin"
                android:paddingEnd="@dimen/ppDialogHorizontalMargin"
                android:paddingHorizontal="@dimen/ppDialogHorizontalMargin"
                style="@style/ppTextStyleT5"/>
            <org.sufficientlysecure.htmltextview.HtmlTextView
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center_vertical"
                android:id="@+id/tv_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:lineSpacingExtra="4dp"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"
                style="@style/ppTextStyleT3"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/viewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
            <ViewStub
                android:layout_gravity="center_horizontal"
                android:id="@+id/bigIconStub"
                android:layout="@layout/lib_ui_layout_dialog_big_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
            <ViewStub
                android:id="@+id/horizontalButtonStub"
                android:layout="@layout/lib_ui_layout_dialog_horizontal_buttons"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ppButtonHeight"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
            <ViewStub
                android:id="@+id/verticalButtonStub"
                android:layout="@layout/lib_ui_layout_dialog_vertical_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/iv_close"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"/>
    </androidx.cardview.widget.CardView>
    <ViewStub
        android:id="@+id/topHeaderIconStub"
        android:layout="@layout/lib_ui_dialog_top_header_icon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ppDialogHeaderIconHeight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
