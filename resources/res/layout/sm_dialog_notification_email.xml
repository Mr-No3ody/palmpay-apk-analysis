<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_top"
        android:layout_width="@dimen/dp68"
        android:layout_height="@dimen/dp62"
        android:layout_marginTop="@dimen/dp22"
        android:src="@drawable/sm_ic_notification_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/sm_get_notification_via_email"
        app:layout_constraintTop_toBottomOf="@+id/iv_top"
        style="@style/txt_me_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/sm_get_notified_via_email_for"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_tip_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="@string/sm_transactions_above"
        android:lineSpacingExtra="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip"
        style="@style/txt_mi_lg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_email"
        android:background="@drawable/cv_shape_rect_corner_16_bg_dark"
        android:paddingBottom="@dimen/dp30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_content">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_email_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/sm_would_you_like_to_get_the_notification_through_this_email_address"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp20"
            android:gravity="center"
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:drawablePadding="8dp"
            android:breakStrategy="balanced"
            app:iiv_end_color="@color/ppColorPrimary"
            app:iiv_end_icon="pay_Edit"
            app:iiv_end_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_email_tip"
            style="@style/txt_s_b_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/btn_cancel_tv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp36"
        android:text="@string/core_no_thanks"
        android:layout_below="@+id/crp_desc_tv"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintEnd_toStartOf="@+id/btn_confirm_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_email"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/btn_confirm_tv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp40"
        android:text="@string/core_yes_please"
        android:layout_below="@+id/crp_desc_tv"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_cancel_tv"
        app:layout_constraintTop_toTopOf="@+id/btn_cancel_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
