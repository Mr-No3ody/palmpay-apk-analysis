<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp36"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:src="@drawable/cv_close_grey"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:text="@string/cs_fill_your_information"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_fill_your_information_content"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:textColor="@color/ppColorFlexiCashPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvBorrowNow"
        android:layout_marginTop="@dimen/dp28"
        android:text="@string/cs_cl_borrow_now_with_count_down"
        style="@style/Text.medium.202046.16"/>
</LinearLayout>
