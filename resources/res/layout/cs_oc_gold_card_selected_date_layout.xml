<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_16_bg_white"
            android:padding="@dimen/dp16"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_repayment_date"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:paddingVertical="@dimen/dp16">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/cs_oc_repayment_date_bg"
                    android:layout_width="114dp"
                    android:layout_height="106dp">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/cs_main_color"
                        android:id="@+id/repayment_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/cs_main_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="of each month"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/next_change_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/cs_oc_next_adjustable_date"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_oc_my_billing_period"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_up_to_start"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=" 31 Days"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/oc_bill_period_content_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/cs_oc_bill_period_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_oc_imperial_crown"
            android:layout_marginEnd="@dimen/dp2"/>
    </FrameLayout>
</LinearLayout>
