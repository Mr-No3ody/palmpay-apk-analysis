<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sm_confirm_details"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_b_b_b"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/ivClose"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_close_grey"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:cardBackgroundColor="@color/ppColorAssisBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPaddingBottom="8dp"
        app:contentPaddingLeft="12dp"
        app:contentPaddingRight="12dp"
        app:contentPaddingTop="8dp">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/cv_warning_yellow"
            android:scaleType="fitXY"/>
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            style="@style/txt_mi_b"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/layoutName"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_name"
            android:paddingEnd="8dp"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_account_number"
            android:paddingEnd="8dp"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_amount"
            android:paddingEnd="8dp"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvConfirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="12dp"
        android:text="@string/core_confirm"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        style="@style/txt_b_w"/>
</LinearLayout>
