<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_TextViewTitle"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        style="@style/fb_EditHintText"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="@dimen/fb_small_text"
            android:textColorHint="@color/ppColorTextNormal"
            android:id="@+id/fb_EditTextInput"
            android:background="@drawable/fb_title_input_underline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:drawablePadding="4dp"
            android:textCursorDrawable="@drawable/fb_editor_cursor_purple"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:importantForAutofill="no"/>
        <TextView
            android:textSize="@dimen/fb_dp16"
            android:textColor="@color/fb_text_color_gray11_c0c3c8"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/fb_TextViewHint"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fb_dp2"
            style="@style/fb_txt_mi_lg"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/fb_dp10"
        android:textColor="@color/fb_text_color_gray3"
        android:id="@+id/fb_tvBillerviewDesc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fb_viewError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/fb_base_color_fail"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/fb_textViewErrorText"
            android:paddingLeft="0dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="0dp"
            android:paddingEnd="5dp"
            style="@style/fb_txt_mi_g"/>
    </LinearLayout>
</merge>
