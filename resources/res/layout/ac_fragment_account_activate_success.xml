<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutInfo"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="190dp"
            android:layout_height="190dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/cv_anim_signup_success"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cv_icon_signup_success"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Success!"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivSuccess"
            style="@style/txt_b_b_b"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvMsg"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp20"
            android:text="Congrats! Your PalmPay account details are shown below."
            android:layout_marginHorizontal="@dimen/dp20"
            android:paddingHorizontal="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/txt_mi_g"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAccountNo"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvSubTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PalmPay Account Number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_mi_b"/>
            <TextView
                android:textSize="28dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvNo"
                android:paddingTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cv_palmpay_number_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSubTitle1"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Copy"
                app:iiv_size="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvNo"
                app:layout_constraintStart_toEndOf="@+id/tvNo"
                app:layout_constraintTop_toTopOf="@+id/tvNo"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="KYC Level"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutAccountNo"
            style="@style/txt_s_lg"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tier 1"
            app:layout_constraintBottom_toBottomOf="@+id/tv1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv1"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ac_daily_transaction_limit_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLevel"
            style="@style/txt_s_lg"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tvDailyLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦50,000"
            android:fontFamily="@font/cv_palmpay_number_bold"
            android:paddingStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv2"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Account Balance Limit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDailyLimit"
            style="@style/txt_s_lg"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tvBalanceLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦300,000"
            android:fontFamily="@font/cv_palmpay_number_bold"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv3"
            style="@style/txt_s_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnView"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="@dimen/dp16"
        android:text="Start PalmPay Now"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="34dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/btnView"
        app:layout_constraintEnd_toEndOf="@+id/btnView"
        app:slot_id="FBEFFD7E75C34490867929D3A28C9ABA"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
