<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/dp18"
    android:paddingRight="@dimen/dp18"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp54"
    android:paddingHorizontal="@dimen/dp18">
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvPhoneNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="@dimen/dp60"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="center"
            android:id="@+id/jp_invitees_status"
            android:background="@drawable/jp_shape_invitees_bg_orange"
            android:layout_width="@dimen/dp60"
            android:layout_height="@dimen/dp24"
            android:text="@string/jp_refer_remind"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/jp_invitees_complete"
            android:layout_width="@dimen/dp34"
            android:layout_height="@dimen/dp34"
            android:src="@drawable/jp_invite_complete"/>
    </FrameLayout>
</LinearLayout>
