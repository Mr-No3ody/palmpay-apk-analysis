<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <fragment
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/v_mask"
            android:background="#b2000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/p2p_move_module"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="68dp">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/p2p_single_agent_module"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp">
            <include layout="@layout/p2p_agent_item_layout"/>
        </FrameLayout>
        <androidx.cardview.widget.CardView
            android:layout_gravity="bottom"
            android:id="@+id/p2p_agent_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/ppColorBackgroundLight"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/p2p_str_detailed_status"
                app:srcCompat="@drawable/cv_empty_no_agent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="84dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="16dp"
                android:text="@string/p2p_str_there_are_no_palmpay_agent_here_______"/>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/p2p_loc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="260dp"
            android:src="@mipmap/p2p_loc"
            android:contentDescription="@string/p2p_str_desc"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/p2p_list"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="210dp"
            android:src="@mipmap/p2p_list"
            android:contentDescription="@string/p2p_str_desc"/>
        <androidx.viewpager.widget.ViewPager
            android:layout_gravity="bottom"
            android:id="@+id/p2p_viewpager"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="14dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/viewContainer"
        android:background="@drawable/p2p_gradient_white_2_transparent"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/p2p_asdfasd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/p2p_str_asdfasdf"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/p2p_alskdjflaksjf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/p2p_str_asdfasdk"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/p2p_lasjdfklajf"
            app:layout_constraintTop_toBottomOf="@+id/p2p_asdfasd"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/p2p_lasjdfklajf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Arrowdown"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/p2p_alskdjflaksjf"
            app:layout_constraintLeft_toRightOf="@+id/p2p_alskdjflaksjf"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/p2p_alskdjflaksjf"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/p2p_back"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/cv_arrow_back_white"
        android:contentDescription="@string/p2p_str_desc"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/p2p_laksjdlfk"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="300dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="14dp"
                android:text="@string/p2p_str_lakejdflkja"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/p2p_agreement_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/cv_close_grey"/>
            <View
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="60dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/viewADBanner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:ad_rounded_corners="@dimen/dp8"
                    app:bvp_page_margin="5dp"
                    app:bvp_reveal_width="10dp"
                    app:slot_id="@string/ad_nearby_agent_guide_banner_slot_id"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/p2p_content"
                    android:paddingTop="2.5dp"
                    android:paddingBottom="2.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
