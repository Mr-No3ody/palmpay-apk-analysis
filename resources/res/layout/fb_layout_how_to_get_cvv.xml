<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/fb_shape_rect_bg_white_corner_14"
    android:paddingLeft="@dimen/fb_dp24"
    android:paddingTop="20dp"
    android:paddingRight="@dimen/fb_dp24"
    android:paddingBottom="@dimen/fb_dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/fb_dp24">
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fb_how_to_view_cvv"
        style="@style/fb_txt_b_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/fb_msg_how_to_view_cvv"
        style="@style/fb_txt_mi_b"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp20"
        android:layout_marginBottom="@dimen/fb_dp20"
        android:src="@drawable/fb_how_to_get_cvv"
        android:scaleType="fitXY"
        android:layout_marginVertical="@dimen/fb_dp20"/>
    <com.palmpay.lib.ui.button.PpButton
        android:layout_gravity="center"
        android:id="@+id/fb_tvOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_default_button_height"
        android:layout_marginTop="0dp"
        android:text="@string/fb_core_ok"
        style="@style/fbButtonStyle"/>
</LinearLayout>
