<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ccci_root"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp77">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ccci_area1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/ccci_remind_time_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp15"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/ccci_phone_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ccci_tag_iv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp24"
            android:layout_marginLeft="@dimen/dp10"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="center_vertical"
            android:id="@+id/ccci_tag_tv"
            android:background="@drawable/cv_preview_payee_info_bg"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp10"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/ccci_remind_time_item"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/ccci_clock_iv"
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp5"
            android:src="@drawable/cv_icon_clock_reminder1"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/ccci_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:layout_toRightOf="@+id/ccci_clock_iv"
            android:layout_marginStart="@dimen/dp6"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/ccci_remind_time_item2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ccci_remind_time_item">
        <ImageView
            android:id="@+id/ccci_clock_iv2"
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp5"
            android:src="@drawable/cv_icon_clock_reminder2"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/ccci_time_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:layout_toRightOf="@+id/ccci_clock_iv2"
            android:layout_marginStart="@dimen/dp6"/>
    </RelativeLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ccci_edit_iv"
        android:padding="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp66"
        android:layout_marginTop="30dp"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_EditFill"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
