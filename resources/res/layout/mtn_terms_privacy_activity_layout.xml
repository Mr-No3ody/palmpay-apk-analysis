<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/mtn_black"
        android:gravity="center"
        android:id="@+id/mtn_terms_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/mtn_str_terms_privacy_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/mtn_img_flow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_terms_privacy">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/mtn_bank"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="6dp"
            android:src="@mipmap/mtn_right_orientation"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/mtn_oneloop"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="4dp"
            android:src="@mipmap/mtn_right_orientation"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/mtn_palm_pay"/>
    </LinearLayout>
    <com.transsnet.mtn.sdk.ui.view.PrivacyItemView
        android:id="@+id/mtn_secured"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="26dp"
        android:layout_marginRight="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_img_flow"
        app:privacy_item_view_bar_title="@string/mtn_str_secured"
        app:privacy_item_view_content="@string/mtn_str_secured_content"
        app:privacy_item_view_img="@mipmap/mtn_lock_icon"
        app:privacy_item_view_is_show_divider="false"/>
    <com.transsnet.mtn.sdk.ui.view.PrivacyItemView
        android:id="@+id/mtn_private_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_secured"
        app:privacy_item_view_bar_title="@string/mtn_str_private"
        app:privacy_item_view_content="@string/mtn_str_private_content"
        app:privacy_item_view_img="@mipmap/mtn_eye_close"
        app:privacy_item_view_is_show_divider="false"/>
    <com.transsnet.mtn.sdk.ui.view.PrivacyItemView
        android:id="@+id/mtn_protected_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_private_id"
        app:privacy_item_view_bar_title="@string/mtn_str_protected"
        app:privacy_item_view_content="@string/mtn_str_protected_content"
        app:privacy_item_view_img="@mipmap/mtn_shield"
        app:privacy_item_view_is_show_divider="false"/>
    <View
        android:background="#99c0c3c8"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/mtn_chk_wrapper"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/mtn_chk_wrapper"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="6dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/mtn_handle_btn"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/mtn_agree_txt">
        <CheckBox
            android:textSize="12sp"
            android:id="@+id/mtn_chk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/mtn_terms_privacy_chk_btn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/mtn_agree_txt"
            app:layout_constraintTop_toBottomOf="@+id/mtn_terms_privacy"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/mtn_black"
        android:id="@+id/mtn_agree_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mtn_str_i_agree_to"
        app:layout_constraintBottom_toBottomOf="@+id/mtn_chk_wrapper"
        app:layout_constraintLeft_toRightOf="@+id/mtn_chk_wrapper"
        app:layout_constraintRight_toLeftOf="@+id/mtn_ok_data_t_c"
        app:layout_constraintTop_toTopOf="@+id/mtn_chk_wrapper"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#8312ff"
        android:id="@+id/mtn_ok_data_t_c"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:text="@string/mtn_str_one_loop_t_c"
        app:layout_constraintBottom_toBottomOf="@+id/mtn_agree_txt"
        app:layout_constraintLeft_toRightOf="@+id/mtn_agree_txt"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtn_agree_txt"/>
    <com.transsnet.mtn.sdk.ui.view.MTNButton
        android:id="@+id/mtn_handle_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:mtn_button_size="small"
        app:mtn_button_status="disable"
        app:mtn_button_text="@string/mtn_str_i_agree"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#858a8f"
        android:id="@+id/mtn_cancel_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/mtn_str_cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_handle_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
