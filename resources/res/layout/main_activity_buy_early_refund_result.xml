<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.ReboundScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.transsnet.palmpay.core.viewmodel.ModelPaymentResultProgress
                android:id="@+id/payProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="30dp"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemTranstype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_te_title="@string/core_service_type"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_te_title="@string/core_coverage"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemCustomId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_te_title="@string/core_customer_id"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_te_title="@string/core_payment_method"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemTransId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_te_title="@string/main_trans_id"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/bannerAdId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/main_ad_early_refund_result_page"/>
        </LinearLayout>
    </com.transsnet.palmpay.custom_view.ReboundScrollView>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/buttonContainer"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/textView1"
            android:background="@drawable/cv_button_bg_light_purple_corner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="2dp"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:elevation="0dp"
            style="@style/txt_me_w"/>
        <View
            android:layout_width="15dp"
            android:layout_height="match_parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/textView2"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="2dp"
            android:text="@string/main_pay_again"
            android:singleLine="true"
            android:layout_weight="1"
            android:elevation="0dp"
            style="@style/txt_me_w"/>
    </LinearLayout>
</RelativeLayout>
