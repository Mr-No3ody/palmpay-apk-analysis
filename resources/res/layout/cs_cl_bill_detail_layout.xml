<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_color_cl_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivWaiverFlag"
        android:background="@drawable/cs_cl_waiver_header_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="183dp"
        android:layout_alignParentTop="true"/>
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/cl_bill_mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_below="@+id/statusBarView"
        app:title_bar_right_text="@string/cs_cl_more_details"
        app:title_bar_title="@string/cs_repayment"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cl_bill_mtb">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/includeWaiverHeader"
                layout="@layout/cs_cl_bill_detail_waiver_header"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/bill_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="@dimen/dp8"
                        android:drawableStart="@drawable/cs_cl_bill_apply_date_icon"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/bill_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_loan_overview"
                        android:drawableEnd="@drawable/cs_cl_view_loan_arrow_icon"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/bill_date_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/bill_date_tv"/>
                    <View
                        android:id="@+id/csTextview110"
                        android:background="@color/ppColorBackgroundDark"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="@+id/bill_amount_tv"
                        app:layout_constraintStart_toStartOf="@+id/bill_date_tv"
                        app:layout_constraintTop_toBottomOf="@+id/bill_date_tv"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/layoutLegacyAmountHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/tvLegacyAmountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_current_outstanding"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/extended_tag_tv"
                            android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                            android:paddingLeft="@dimen/dp4"
                            android:paddingRight="@dimen/dp4"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_extended"
                            android:layout_marginStart="@dimen/dp2"
                            android:paddingHorizontal="@dimen/dp4"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextNormal"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tvWaiverAmountLabel"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"/>
                    <TextView
                        android:textSize="@dimen/dp36"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/bill_repayment_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        style="@style/txt_number_s_b_b"/>
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextDisable"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tvWaiverOriginalAmount"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/due_day_tv"
                        android:padding="@dimen/dp3"
                        android:paddingLeft="@dimen/dp4"
                        android:paddingTop="@dimen/dp2"
                        android:paddingRight="@dimen/dp4"
                        android:paddingBottom="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        android:paddingHorizontal="@dimen/dp4"
                        android:paddingVertical="@dimen/dp2"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4">
                        <ImageView
                            android:id="@+id/ivAutomicDeduct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/cs_cl_overview_automic_deduct_arrow_up"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/ppColorBackgroundDark"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:gravity="center"
                            android:background="@drawable/cs_cl_overview_auto_deduct_bg"
                            android:paddingLeft="@dimen/dp6"
                            android:paddingRight="@dimen/dp6"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp22"
                            android:text="Automatic deduction from Balance/Cashbox/Bank card"
                            android:paddingHorizontal="@dimen/dp6"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/ivAutomicDeduct"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:background="@color/ppColorBackgroundDark"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginBottom="@dimen/dp16"
                        android:paddingStart="@dimen/dp16"
                        android:paddingEnd="@dimen/dp16">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextNormal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_cl_unpaid_principal"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/bill_loan_amount_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp14">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextNormal"
                                android:id="@+id/cl_bill_interest_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_cl_unpaid_interest"
                                android:drawablePadding="@dimen/dp4"
                                android:drawableEnd="@drawable/cs_cl_info_icon"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="end"
                                android:id="@+id/bill_interest_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp14">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextNormal"
                                android:id="@+id/cl_bill_service_title_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_cl_unpaid_service_fee"
                                android:drawablePadding="@dimen/dp4"
                                android:drawableEnd="@drawable/cs_cl_info_icon"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="end"
                                android:id="@+id/cl_bill_service_content_tv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp14">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextNormal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_cl_unpaid_penalty"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/dp12"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/bill_repaid_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/rowWaiverDiscount"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp14">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/ppColorTextNormal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_cl_waiver_discount_label"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/ppColorWarning"
                                android:gravity="center"
                                android:id="@+id/tvWaiverDiscountAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llWaiverCountdown"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp8"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp8"
                        android:paddingVertical="@dimen/dp4">
                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/cs_cl_loan_fully_date_bj"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextNormal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_waiver_limited_offer_prefix"
                            android:layout_marginStart="@dimen/dp8"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorFlexiCashPrimary"
                            android:id="@+id/tvBillWaiverDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvBillWaiverHour"
                            android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp16"
                            android:layout_marginStart="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorFlexiCashPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            android:layout_marginRight="@dimen/dp4"
                            android:text=":"
                            android:layout_marginHorizontal="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvBillWaiverMinute"
                            android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp16"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorFlexiCashPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            android:layout_marginRight="@dimen/dp4"
                            android:text=":"
                            android:layout_marginHorizontal="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvBillWaiverSecond"
                            android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp16"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16">
                        <Button
                            android:textSize="16sp"
                            android:textColor="@color/cv_color_ffffff"
                            android:id="@+id/cl_bill_repay_bt"
                            android:background="@drawable/cs_cl_shape_rect_corner_12_bg_00a49a"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp48"
                            android:text="@string/cs_cl_bill_repay"
                            android:textAllCaps="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/ppColorTextBase"
                            android:id="@+id/extend_label_tv"
                            android:background="@drawable/cs_cl_extend_label_bg"
                            android:paddingLeft="@dimen/dp4"
                            android:paddingRight="@dimen/dp4"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_extendable"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="@dimen/dp4"
                            app:layout_constraintBottom_toTopOf="@+id/cl_bill_repay_bt"
                            app:layout_constraintEnd_toEndOf="@+id/cl_bill_repay_bt"
                            app:layout_constraintTop_toTopOf="@+id/cl_bill_repay_bt"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorFlexiCashPrimary"
                        android:gravity="center"
                        android:id="@+id/extend_tips_tv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginRight="@dimen/dp16"
                        android:text="extendable days： Gives you longer loan Period. "
                        android:layout_marginHorizontal="@dimen/dp16"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/repayment_count_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_cl_outstanding_terms"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bill_repayment_rv"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp6"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cs_cl_main_color_new"
                android:layout_gravity="center"
                android:id="@+id/repayment_record_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginBottom="@dimen/dp16"
                android:text="@string/cs_cl_view_repayment_records"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
