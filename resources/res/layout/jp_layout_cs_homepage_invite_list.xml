<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/jp_refer_earn_bg"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tvInvitees"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/jp_your_invitees"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_w_b"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/jp_my_cash_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintTop_toBottomOf="@+id/tvInvitees"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNoInvitees"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvInvitees"
        app:srcCompat="@drawable/cv_empty_no_transaction_history"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvNoInvitees"
        android:paddingBottom="40dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_no_invitees"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivNoInvitees"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="jp_my_cash_rv, tvNoInvitees"/>
    <com.palmpay.lib.ui.text.ImageTextView
        android:textColor="@color/ppColorDisabled"
        android:gravity="center_vertical"
        android:id="@+id/jp_iv_expand"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_more"
        app:itv_color="@color/ppColorDisabled"
        app:itv_icon="pay_Arrowdown"
        app:itv_img_gravity="right_center"
        app:itv_img_size="@dimen/dp14"
        app:itv_img_top_margin="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
