<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/cv_text_color_white"
        android:ellipsize="end"
        android:id="@+id/jp_history_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/cv_text_color_white"
        android:id="@+id/jp_history_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp20"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_history_name"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/jp_history_processing"
        android:id="@+id/jp_history_risk_desc"
        android:paddingTop="@dimen/dp5"
        android:paddingBottom="@dimen/dp5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Risk Factor violation"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp20"
        android:paddingVertical="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="@+id/jp_history_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_history_time"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/jp_history_action"
        android:background="@drawable/jp_resolve_btn_r6_bg"
        android:paddingLeft="@dimen/dp5"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="@dimen/dp5"
        android:paddingBottom="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_resolve"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp20"
        android:paddingHorizontal="@dimen/dp5"
        android:paddingVertical="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="@+id/jp_history_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_history_time"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/jp_history_succ"
        android:id="@+id/jp_history_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/jp_history_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_history_name"/>
    <TextView
        android:textColor="@color/jp_history_failed"
        android:id="@+id/jp_history_failed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_failed"
        android:drawablePadding="@dimen/dp7"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/jp_history_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_history_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
