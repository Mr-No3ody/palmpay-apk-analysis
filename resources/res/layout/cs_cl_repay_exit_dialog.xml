<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutContent"
        android:background="@drawable/cs_cl_repay_exit_dialog_bg"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp80"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp45"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_cl_want_to_quit"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <TextView
            android:textColor="@color/cs_oc_use_flexi_time_text_color"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_repay_get_loan_amount_increase"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.202046.14"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="40sp"
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:id="@+id/increase_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_number_me_b_b"/>
            <Space
                android:id="@+id/space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/increase_amount_tv"
                app:layout_constraintRight_toRightOf="@+id/increase_amount_tv"
                app:layout_constraintTop_toTopOf="@+id/increase_amount_tv"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/csTextview87"
                android:background="@drawable/cs_oc_up_to_bg"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="@dimen/dp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/cs_oc_exit_up_to"
                android:paddingHorizontal="@dimen/dp4"
                app:layout_constraintLeft_toRightOf="@+id/space"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/repay_now_bt"
            android:background="@drawable/cs_cl_bw_next_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:minHeight="0dp"
            android:text="@string/cs_oc_repay_now"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Widget.AppCompat.Button.Borderless"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/cs_oc_use_flexi_time_text_color"
            android:id="@+id/stop_repay_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_give_up_amount_increase"
            android:layout_marginHorizontal="@dimen/dp24"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/csImageview30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_cl_repay_exit_img"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layoutContent"
        app:srcCompat="@drawable/cs_oc_dialog_close_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
