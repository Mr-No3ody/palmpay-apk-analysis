<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/core_transaction_details"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llTop"
        android:background="@color/ppColorBackgroundLight"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/dp44"
            android:layout_height="@dimen/dp44"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/qt_data_bundle_opened_successfully"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:id="@+id/tvStatusTips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/Text.202046.12"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llTop">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutAmountItemList"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutResultItemList"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/llRenewBenefits"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp12">
                <TextView
                    android:background="@drawable/cv_rect_corner_bl_br_12_bg_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginRight="@dimen/dp24"
                    android:text="@string/qt_renew_benefits"
                    android:layout_marginHorizontal="@dimen/dp24"
                    style="@style/Text.medium.202046.14"/>
                <ImageView
                    android:id="@+id/ivAutoRenewBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:adjustViewBounds="true"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvConfirm"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/qt_manage_renewal_items"
                    app:iiv_end_color="@color/ppColorTextNormal"
                    app:iiv_end_icon="pay_ArrowCenterRight"
                    app:iiv_end_size="@dimen/dp16"
                    style="@style/Text.6f7b85.12"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutBottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/tvComplete"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/core_complete"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/ppButtonStyle"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/tvEnableNotify"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/qt_enable_push_notifications"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/ppButtonStyle"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvChangeFreq"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/qt_change_frequency"
            style="@style/txt_s_g"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
