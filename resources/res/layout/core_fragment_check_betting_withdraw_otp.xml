<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent_38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_top_corner_white_12"
        android:layout_width="match_parent"
        android:layout_height="440dp">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/cbw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_please_enter_otp_verification"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/cbw_close"
            android:padding="@dimen/dp16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/cbw_edittext"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:hint="@string/core_enter_otp_verification"
            android:maxLines="1"
            android:maxLength="8"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbw_title"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="#858a8f"
            android:id="@+id/cbw_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_betting_withdraw_opt_desc"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbw_edittext"/>
        <TextView
            android:textColor="@color/core_opt_text_color"
            android:id="@+id/cbw_time_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_get_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbw_desc"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/cbw_withdraw"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp16"
            android:text="@string/core_withdraw"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
