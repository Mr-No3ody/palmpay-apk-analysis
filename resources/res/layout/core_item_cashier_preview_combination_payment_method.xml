<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/combinationRoot"
    android:paddingLeft="@dimen/dp8"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp8"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp78"
    android:paddingHorizontal="@dimen/dp8"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivCashierItemPaymentMethodIconBg"
        android:layout_width="@dimen/dp28"
        android:layout_height="0dp"
        android:src="@drawable/cv_shape_rect_corner_14_bg_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivCashierItemPaymentMethodIcon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginBottom="@dimen/dp2"
        android:src="@drawable/cv_palmpay_icon_circle_purple"
        app:layout_constraintBottom_toTopOf="@+id/ivCashierItemSubPaymentMethodIcon"
        app:layout_constraintEnd_toEndOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintStart_toStartOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintTop_toTopOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <ImageView
        android:id="@+id/ivCashierItemSubPaymentMethodIcon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp2"
        android:src="@drawable/cv_palmpay_icon_circle_purple"
        app:layout_constraintBottom_toBottomOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintEnd_toEndOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintStart_toStartOf="@+id/ivCashierItemPaymentMethodIconBg"
        app:layout_constraintTop_toBottomOf="@+id/ivCashierItemPaymentMethodIcon"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvCashierItemPaymentMethodName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivCashierItemPaymentMethodIcon"
        app:layout_constraintEnd_toStartOf="@+id/tvCashierItemPaymentBalance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivCashierItemPaymentMethodIcon"
        app:layout_constraintTop_toTopOf="@+id/ivCashierItemPaymentMethodIcon"
        app:layout_constraintWidth_min="@dimen/dp32"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvCashierItemPaymentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCashierItemPaymentMethodName"
        app:layout_constraintEnd_toStartOf="@+id/tvCashierItemPaymentPayAmount"
        app:layout_constraintStart_toEndOf="@+id/tvCashierItemPaymentMethodName"
        app:layout_goneMarginEnd="@dimen/dp20"
        style="@style/txt_number_s_b"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tvCashierItemPaymentPayAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCashierItemPaymentMethodName"
        app:layout_constraintEnd_toStartOf="@+id/cashierItemBarrierEnd"
        app:layout_goneMarginEnd="@dimen/dp4"
        style="@style/txt_s_lg"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvCashierItemSubPaymentMethodName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivCashierItemSubPaymentMethodIcon"
        app:layout_constraintEnd_toStartOf="@+id/tvCashierItemSubPaymentBalance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivCashierItemSubPaymentMethodIcon"
        app:layout_constraintTop_toTopOf="@+id/ivCashierItemSubPaymentMethodIcon"
        app:layout_constraintWidth_min="@dimen/dp32"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvCashierItemSubPaymentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCashierItemSubPaymentMethodName"
        app:layout_constraintEnd_toStartOf="@+id/tvCashierItemSubPaymentPayAmount"
        app:layout_constraintStart_toEndOf="@+id/tvCashierItemSubPaymentMethodName"
        app:layout_goneMarginEnd="@dimen/dp20"
        style="@style/txt_number_s_b"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tvCashierItemSubPaymentPayAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCashierItemSubPaymentBalance"
        app:layout_constraintEnd_toStartOf="@+id/cashierItemBarrierEnd"
        app:layout_goneMarginEnd="@dimen/dp4"
        style="@style/txt_s_lg"/>
    <ImageView
        android:id="@+id/ivCashierItemSelected"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cashierItemBarrierEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ivCashierItemSelected"/>
</androidx.constraintlayout.widget.ConstraintLayout>
