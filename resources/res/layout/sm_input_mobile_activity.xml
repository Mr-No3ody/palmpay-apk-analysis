<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/sm_search_recipient"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/inputView"
                android:background="@drawable/sm_content_view_bg"
                android:addStatesFromChildren="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <EditText
                    android:textSize="12dp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:textColorHint="@color/ppColorTextDisable"
                    android:ellipsize="end"
                    android:id="@+id/search_et"
                    android:background="@null"
                    android:paddingLeft="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/sm_search_hint_text_new_3"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:drawableLeft="@drawable/cv_search_icon"
                    android:drawablePadding="4dp"
                    android:layout_weight="1"
                    android:inputType="text"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/delete_bt"
                    android:background="?attr/selectableItemBackground"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cv_circle_gray_cross_32dp"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/si_contact_tv"
                    android:padding="@dimen/dp10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Addressbook"
                    app:iiv_size="24dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorTextAssist"
                android:id="@+id/tv_search_tip"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/inputView"/>
            <TextView
                android:id="@+id/tv_search_tag_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:text="@string/sm_search_recipient_by"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_search_tip"
                style="@style/txt_s_b_b"/>
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:constraint_referenced_ids="tv_palmpay_tag,tv_email"
                app:flow_horizontalAlign="start"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="8dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="10dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_search_tag_title"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_mobile"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/core_mobile"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_palmpay_tag"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:text="@string/core_palmpay_tag"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_facebook_name"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:minWidth="@dimen/dp60"
                android:text="@string/core_facebook_name"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp12"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_qr_account_number"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:minWidth="@dimen/dp60"
                android:text="@string/core_qr_account"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_email"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:minWidth="@dimen/dp60"
                android:text="@string/core_email"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_partner_number"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="@dimen/dp60"
                android:text="@string/core_partner_account_id"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp5"
                android:layout_marginEnd="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/tv_business_number"
                android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="@dimen/dp60"
                android:text="@string/core_merchant_account_id"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp5"
                android:layout_marginEnd="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp10"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp22"
                android:src="@drawable/sm_ic_search_tag_new"
                app:layout_constraintBottom_toBottomOf="@+id/tv_qr_account_number"
                app:layout_constraintEnd_toEndOf="@+id/tv_qr_account_number"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp22"
                android:src="@drawable/sm_ic_search_tag_new"
                app:layout_constraintBottom_toBottomOf="@+id/tv_partner_number"
                app:layout_constraintEnd_toEndOf="@+id/tv_partner_number"/>
            <ImageView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp22"
                android:src="@drawable/sm_ic_search_tag_new"
                app:layout_constraintBottom_toBottomOf="@+id/tv_business_number"
                app:layout_constraintEnd_toEndOf="@+id/tv_business_number"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_searching"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/flow_view">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/tips_view"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sm_searching"
                    android:paddingEnd="@dimen/dp6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputView"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_animation"
                    android:layout_width="@dimen/dp30"
                    android:layout_height="@dimen/dp28"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/sm_searching"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/result_view"
                android:background="@drawable/sm_content_view_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/flow_view"
                app:layout_constraintVertical_bias="0"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/note_view"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sm_note_check_info"
                app:layout_constraintBottom_toBottomOf="@+id/result_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEmpty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/flow_view"
                app:srcCompat="@drawable/cv_empty_no_transaction_history"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_view"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sm_no_found_number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivEmpty"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textSize="14dp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/directly_send_view"
                android:background="@drawable/sm_content_view_bg"
                android:paddingLeft="16dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:drawablePadding="10dp"
                app:iiv_end_color="@color/ppColorTextAssist"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/empty_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
