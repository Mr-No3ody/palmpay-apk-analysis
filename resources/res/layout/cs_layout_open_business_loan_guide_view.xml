<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp12">
    <TextView
        android:textColor="@color/cs_main_color"
        android:id="@+id/tvLoanCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Business Loan"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutApply"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLoanCardTitle">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvLoanAmountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:text="Loanable Amount up to"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanAmountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/endBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tvLoanAmountTitle, tvLoanAmountValue"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvLoanApply"
            android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
            android:layout_width="@dimen/dp64"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/cs_cl_apply"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/cs_main_color"
            android:id="@+id/tvBusinessLoanDesc0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Unlock Big Funds"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/cs_cl_icon_check_primary"
            android:layout_marginStart="@dimen/dp10"
            app:layout_constraintStart_toEndOf="@+id/endBarrier"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/cs_main_color"
            android:id="@+id/tvBusinessLoanDesc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="Power Your Hustle"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/cs_cl_icon_check_primary"
            app:layout_constraintStart_toStartOf="@+id/tvBusinessLoanDesc0"
            app:layout_constraintTop_toBottomOf="@+id/tvBusinessLoanDesc0"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/cs_main_color"
            android:id="@+id/tvBusinessLoanDesc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="Funds In Seconds"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/cs_cl_icon_check_primary"
            app:layout_constraintStart_toStartOf="@+id/tvBusinessLoanDesc0"
            app:layout_constraintTop_toBottomOf="@+id/tvBusinessLoanDesc1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
