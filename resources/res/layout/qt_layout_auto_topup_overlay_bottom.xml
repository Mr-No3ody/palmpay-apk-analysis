<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_tl_tr_24_bg_f6f6fa"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_padding="@dimen/dp2"
        app:iiv_size="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginRight="@dimen/dp20"
        android:text="@string/qt_auto_top_up_airtime"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cardPlan"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:padding="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvPlanLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qt_betting_auto_topup_plan"/>
        <TextView
            android:textSize="@dimen/dp24"
            android:textStyle="bold"
            android:id="@+id/tvPlanAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            style="@style/Text.202046.24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llFirstTopupRow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvFirstTopupLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/qt_betting_first_topup_special"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tvFirstTopupOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp4"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvFirstTopupDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.medium.202046.16"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/confirmationContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPlan">
        <com.mikepenz.iconics.view.IconicsCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/cbAgreement"
            android:background="@null"
            android:padding="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_checked_color="@color/ppColorTextPrimary"
            app:iiv_checked_icon="pay_CheckboxFill"
            app:iiv_checked_size="@dimen/dp16"
            app:iiv_unchecked_color="@color/ppColorTextAssist"
            app:iiv_unchecked_icon="pay_CheckboxOutline"
            app:iiv_unchecked_size="@dimen/dp16"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:id="@+id/tvAgreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmationContainer">
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/btnTurnOn"
            android:layout_width="0dp"
            android:text="@string/qt_betting_turn_on"
            android:layout_weight="1"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvDontRemind"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/qt_betting_dont_remind_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonContainer"
        style="@style/Text.9ca2aa.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
