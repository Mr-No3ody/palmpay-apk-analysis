<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/giea_time_line_container"
        android:layout_width="@dimen/dp20"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_alignTop="@+id/ciei_info_area"
        android:layout_alignBottom="@+id/ciei_info_area">
        <View
            android:id="@+id/gieaLine"
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="@dimen/dp1"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/gieaGrayPoint"
            android:layout_width="@dimen/dp7"
            android:layout_height="@dimen/dp7"
            android:layout_marginTop="@dimen/dp15"
            android:src="@drawable/cv_shape_circle_c1ccd5"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/gieaArriveIcon"
            android:visibility="gone"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginTop="@dimen/dp8"
            android:src="@drawable/cv_icon_expressage_arrive"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ciei_info_area"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_toRightOf="@+id/giea_time_line_container">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/gieaExpressageTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp15"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/gieaTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp15"/>
    </LinearLayout>
</RelativeLayout>
