<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_progress_tips"
    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivTop"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp19"
        android:layout_marginTop="@dimen/dp10"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvStatus"
        android:background="@drawable/cv_shape_rect_corner_4_bg_primary"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivTop"
        app:layout_constraintEnd_toStartOf="@+id/iivArrowRight"
        app:layout_constraintTop_toTopOf="@+id/ivTop"
        style="@style/Text.ffffff.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iivArrowRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/ivTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivTop"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/ivTop"
        style="@style/Text.6f7b85.12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_progress"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTips">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/core_text_common_btn"
            android:id="@+id/btnApplyRefund"
            android:background="@drawable/core_selector_rect_round_stroke_purple_to_disable"
            android:paddingLeft="@dimen/dp8"
            android:paddingRight="@dimen/dp8"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp24"
            android:layout_margin="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_progress"
            style="@style/Text.medium.ffffff.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
