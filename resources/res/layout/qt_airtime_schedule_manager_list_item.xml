<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp105">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivOperatorIcon"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp14"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_default_palmpay_icon_gray"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTagName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/ivEdit"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivOperatorIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivEdit"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Edit"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/tvTagName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvTagName"/>
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/ivOperatorIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTagName"
        style="@style/Text.202046.16"/>
    <View
        android:id="@+id/vDividerLine"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp14"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivOperatorIcon"/>
    <TextView
        android:id="@+id/tvEvery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_every"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDividerLine"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:id="@+id/tvDate"
        android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp3"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
        app:layout_constraintStart_toEndOf="@+id/tvEvery"
        style="@style/Text.medium.6306b2.12"/>
    <TextView
        android:id="@+id/tvAutoTopUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qt_auto_top_up"
        android:layout_marginStart="@dimen/dp3"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
        app:layout_constraintStart_toEndOf="@+id/tvDate"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:id="@+id/tvPrice"
        android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp3"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
        app:layout_constraintStart_toEndOf="@+id/tvAutoTopUp"
        style="@style/Text.medium.6306b2.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_arrow_right"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDividerLine"/>
</androidx.constraintlayout.widget.ConstraintLayout>
