<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            layout="@layout/ac_layout_login_header"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp20"
            android:text="Verify Phone Number"
            android:layout_marginHorizontal="@dimen/dp20"
            style="@style/Text.medium.202046.24"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginHorizontal="@dimen/dp20"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvMessageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_step_1_check_the_code_you_received"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginEnd="@dimen/dp8"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/ivMsgIcon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMessageTitle"
                style="@style/txt_s_g"/>
            <ImageView
                android:id="@+id/ivMsgIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvMessage"
                app:srcCompat="@drawable/ac_otp_sms_icon_1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.transsnet.palmpay.core.viewmodel.OneTimeCodeV5View
            android:id="@+id/viewOTC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginHorizontal="@dimen/dp20"
            app:core_title_text="@string/ac_step_2_fill_in_the_box_below_with_the_code"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/securityKeyBoard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_number_keyboard_layout"/>
</FrameLayout>
