<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/statusView"
        app:title_bar_back_icon="@null"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/core_wealth"/>
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <androidx.core.widget.NestedScrollView
            android:orientation="vertical"
            android:id="@+id/nsvRoot"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp88"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
                    android:id="@+id/topTextAd"
                    android:paddingLeft="@dimen/dp10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp32"
                    android:layout_marginBottom="@dimen/dp16"
                    android:drawablePadding="@dimen/dp5"
                    app:slot_id="@string/main_ad_invest_top_slot_id"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTask"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/main_saving_task_layout"
                    app:mode="0"/>
                <include layout="@layout/main_saving_account_top_layout"/>
                <include layout="@layout/main_saving_account_list_layout"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncRecomend"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/main_saving_recommend_layout"
                    app:mode="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:paddingTop="@dimen/dp16"
                    android:paddingBottom="@dimen/dp6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/functionList"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/functionIndicator"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-10dp"/>
                </LinearLayout>
                <com.transsnet.adsdk.widgets.banner.BannerAdView
                    android:id="@+id/adMiddle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp12"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:slot_id="@string/main_ad_invest_middle_slot_id"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_dynmic_module"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <Space
                    android:id="@+id/space"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
                    android:id="@+id/cashBoxIntroductionView"
                    android:paddingBottom="@dimen/dp20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
    <ViewStub
        android:id="@+id/viewNotNetworkStub"
        android:layout="@layout/main_layout_not_network_home_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
