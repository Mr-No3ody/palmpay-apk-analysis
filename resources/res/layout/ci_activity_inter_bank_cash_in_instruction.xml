<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_right_text="@string/core_history"
        app:title_bar_title="@string/ci_fund_instructions"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp16"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tv_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ci_receive_money_from_bank"
                android:fontFamily="sans-serif-medium"
                style="@style/txt_me_b"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvAccountNumberTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_msg_receive_money_from_bank"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:textSize="16dp"
                    android:id="@+id/tvAccountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="4dp"
                    app:layout_constraintStart_toStartOf="@+id/tvAccountNumberTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvAccountNumberTitle"
                    app:layout_goneMarginTop="@dimen/dp8"
                    style="@style/txt_number_me_b_b"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:id="@+id/ivCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:text="@string/core_copy"
                    android:includeFontPadding="false"
                    android:drawablePadding="@dimen/dp4"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="@dimen/dp8"
                    app:iiv_start_color="@color/ppColorPrimary"
                    app:iiv_start_icon="pay_Copy"
                    app:iiv_start_size="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAccountNumber"
                    app:layout_constraintStart_toEndOf="@+id/tvAccountNumber"
                    app:layout_constraintTop_toTopOf="@+id/tvAccountNumber"
                    style="@style/Text.6306b2.12"/>
                <View
                    android:id="@+id/v_divider_account_no"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAccountNumber"
                    style="@style/core_divider_horizontal"/>
                <TextView
                    android:id="@+id/tvBankNameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/ci_choose_bank"
                    app:layout_constraintTop_toBottomOf="@+id/v_divider_account_no"
                    style="@style/Text.6f7b85.12"/>
                <ImageView
                    android:id="@+id/ivBankName"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp8"
                    android:src="@drawable/cv_palmpay_logo_5"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBankNameTitle"/>
                <TextView
                    android:id="@+id/tvBankName"
                    android:text="@string/core_app_name"
                    android:layout_marginStart="@dimen/dp8"
                    app:layout_constraintBottom_toBottomOf="@+id/ivBankName"
                    app:layout_constraintStart_toEndOf="@+id/ivBankName"
                    app:layout_constraintTop_toTopOf="@+id/ivBankName"
                    style="@style/Text.medium.202046.14"/>
                <View
                    android:id="@+id/v_divider_bank"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivBankName"
                    style="@style/core_divider_horizontal"/>
                <TextView
                    android:id="@+id/tvBeneficiaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/ci_choose_recipient"
                    app:layout_constraintTop_toBottomOf="@+id/v_divider_bank"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:id="@+id/tvBeneficiary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@+id/tvBeneficiaryTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvBeneficiaryTitle"
                    style="@style/Text.medium.202046.14"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/tvShare"
                    android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                    android:paddingTop="@dimen/dp10"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ppButtonHeight"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/ci_share_account_information"
                    android:paddingVertical="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/tvBeneficiary"
                    style="@style/Text.medium.6306b2.16"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ci_select_bank_to_transfer_account_instruction"
                style="@style/Text.medium.202046.14"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8">
                <TextView
                    android:id="@+id/tv_step_1_title"
                    android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:text="1"
                    style="@style/Text.6306b2.14"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_step_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_copy_the_palmpay_account_number_above"
                    android:layout_marginStart="@dimen/dp12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_step_1_title"
                    app:layout_constraintTop_toTopOf="@+id/tv_step_1_title"
                    style="@style/Text.6f7b85.14"/>
                <TextView
                    android:id="@+id/tv_step_2_title"
                    android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="2"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step_1"
                    style="@style/Text.6306b2.14"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_step_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_open_the_bank_app_you_want_to_transfer_from"
                    android:layout_marginStart="@dimen/dp12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_step_2_title"
                    app:layout_constraintTop_toTopOf="@+id/tv_step_2_title"
                    style="@style/Text.6f7b85.14"/>
                <TextView
                    android:id="@+id/tv_step_3_title"
                    android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="3"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step_2"
                    style="@style/Text.6306b2.14"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_step_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_select_the_palmpay_and_transfer"
                    android:layout_marginStart="@dimen/dp12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_step_3_title"
                    app:layout_constraintTop_toTopOf="@+id/tv_step_3_title"
                    style="@style/Text.6f7b85.14"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ci_select_bank_to_view_instruction"
                style="@style/Text.medium.202046.14"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bankList"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp12"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
