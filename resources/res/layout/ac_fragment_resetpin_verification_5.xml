<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_msg_reset_pin_verification_valid_id"
            style="@style/txt_s_g"/>
        <TextView
            android:id="@+id/inputIdType"
            android:paddingTop="18dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            style="@style/txt_s_b"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputIdNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:cv_max_length="@integer/max_email_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/ac_enter_id_number"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/textViewNext"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="270dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginTop="35dp"
            android:text="@string/core_next"
            style="@style/txt_b_w"/>
    </LinearLayout>
    <TextView
        android:textColor="#9200ff"
        android:gravity="center_vertical"
        android:id="@+id/tvContactUs"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/ac_contact_us"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/txt_s_g"/>
</RelativeLayout>
