<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:iiv_color="@color/ppColorError"
        app:iiv_icon="pay_WarningOutline"
        app:iiv_size="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dp24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/layoutAccount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:gravity="center"
            android:id="@+id/tvAccount1"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:gravity="center"
            android:id="@+id/tvAccount2"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBtn"
        android:background="@drawable/lib_ui_button_bg_corner_flexi_cash_primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/layoutAccount">
        <ImageView
            android:id="@+id/ivBtnIcon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvBtn"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorButtonTextWhite"
            android:id="@+id/tvBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_confirm"
            android:lines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBtnIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivClose"
        android:padding="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/cs_oc_dialog_close_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
