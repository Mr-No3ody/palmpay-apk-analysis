<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbci_root"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp60"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/iv_cashier_item_payment_method_icon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/cv_palmpay_icon_circle_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_cashier_item_payment_method_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_item_payment_method_normal_tips"
        app:layout_constraintEnd_toStartOf="@+id/tv_cashier_item_payment_balance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iv_cashier_item_payment_method_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/tv_cashier_item_payment_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_cashier_item_payment_method_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_payment_method_discount_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_cashier_item_payment_method_name"
        app:layout_goneMarginEnd="@dimen/dp20"
        style="@style/txt_number_s_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tv_item_payment_method_discount_amount"
        android:background="@drawable/cv_button_bg_yellow_corner_2"
        android:paddingLeft="@dimen/dp4"
        android:paddingTop="@dimen/dp1"
        android:paddingRight="@dimen/dp4"
        android:paddingBottom="@dimen/dp1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp30"
        android:paddingHorizontal="@dimen/dp4"
        android:paddingVertical="@dimen/dp1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cashier_item_payment_method_name"
        app:layout_constraintEnd_toStartOf="@+id/cashier_item_barrier_end"
        app:layout_constraintStart_toEndOf="@+id/tv_cashier_item_payment_balance"
        app:layout_constraintTop_toTopOf="@+id/tv_cashier_item_payment_method_name"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:id="@+id/tv_item_payment_method_normal_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintBottom_toTopOf="@+id/tv_item_payment_method_activity_tips"
        app:layout_constraintEnd_toStartOf="@+id/cashier_item_barrier_end"
        app:layout_constraintStart_toStartOf="@+id/tv_cashier_item_payment_method_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_cashier_item_payment_method_name"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorWarning"
        android:id="@+id/tv_item_payment_method_activity_tips"
        android:background="@drawable/cv_shape_rect_corner_4_bg_fff7e8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:paddingStart="@dimen/dp5"
        android:paddingEnd="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cashier_item_barrier_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_cashier_item_payment_method_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_payment_method_normal_tips"
        style="@style/txt_s_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_cashier_item_top_up"
        android:background="@drawable/cv_shape_halfround_purple"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp30"
        android:text="@string/core_top_up"
        android:paddingHorizontal="@dimen/dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_w"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_cashier_item_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorSuccess"
        app:iiv_icon="pay_Selected"
        app:iiv_size="24dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cashier_item_barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_cashier_item_selected,tv_cashier_item_top_up"/>
</androidx.constraintlayout.widget.ConstraintLayout>
