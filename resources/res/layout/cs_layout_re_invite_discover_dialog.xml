<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp17"
    android:layout_marginRight="@dimen/dp17"
    android:paddingStart="@dimen/dp19"
    android:paddingEnd="@dimen/dp19"
    android:layout_marginHorizontal="@dimen/dp17"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:src="@drawable/cs_re_discover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStatus">
        <TextView
            android:textSize="@dimen/dp22"
            android:textColor="@color/cv_text_color_white"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_discover"
            android:fontFamily="sans-serif-black"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/cv_text_color_white"
            android:gravity="center"
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_invite_re_content"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp16"
        android:textColor="@color/cv_text_color_white"
        android:id="@+id/btnConfirm"
        android:background="@drawable/cs_shape_orange_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp26"
        android:layout_marginBottom="@dimen/dp20"
        android:text="@string/cs_invite_now"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llContent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
