<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:paddingBottom="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_recipient_account"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_b_b"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <EditText
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/et_bank_account"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:hint="@string/sm_enter_10_digit_account_number"
            android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
            android:digits="0123456789"
            style="@style/txt_me_b_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iivContacts"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_AddressbookFill"
            app:iiv_size="@dimen/dp24"/>
    </FrameLayout>
    <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
        android:id="@+id/med_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <RelativeLayout
        android:id="@+id/rlSelectBank"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/tvSelectBank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:text="@string/sm_select_your_bank"
            android:layout_centerVertical="true"
            style="@style/txt_me_b"/>
        <ImageView
            android:id="@+id/account_bank_icon"
            android:visibility="gone"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/cv_bank_account"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/account_select_bank"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/iv_arrow_right"
            android:layout_toRightOf="@+id/account_bank_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp10"
            style="@style/txt_me_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_arrow_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp10"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"/>
    </RelativeLayout>
    <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
        android:id="@+id/med_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_status"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp30"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/indicatorView"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:indeterminate="true"
                app:indicatorColor="@color/ppColorTextPrimary"
                app:indicatorSize="@dimen/dp16"
                app:trackThickness="@dimen/dp1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_looking_for_this_user_name"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_name"
            android:background="@drawable/cv_shape_rect_corner_8_bg_e4f7f0"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp16"
            android:minHeight="@dimen/dp30"
            android:backgroundTint="@color/ppColorSuccessBackground"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp6">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_query_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_SelectedFill"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tv_recipient_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_matched_bank"
            android:background="@drawable/sm_bg_matched_bank"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp6"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
</LinearLayout>
