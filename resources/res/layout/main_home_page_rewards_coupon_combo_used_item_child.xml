<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/vRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp72">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_reward_coupon_item_bg"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.10"/>
    <TextView
        android:textSize="@dimen/dp22"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tvAmount"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp10"
        android:autoSizeMaxTextSize="@dimen/dp22"
        app:layout_constraintBottom_toTopOf="@+id/tvUse"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_goneMarginTop="@dimen/dp18"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/tvUse"
        android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_use_now"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"
        style="@style/Text.ffffff.10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
