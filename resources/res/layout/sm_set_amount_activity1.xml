<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelPageTitleArea
        android:id="@+id/ssma_page_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp172"
        app:cta_content_text="Please enter the amount"
        app:cta_title="Set Amount"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp168">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/sm_foreground"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/set_money_store_name_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/notes_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/core_store_name"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/set_money_store_name_tv"
                        android:background="@drawable/cv_title_input_underline"
                        android:paddingBottom="@dimen/dp10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:maxLines="@integer/sm_msg_edit_text_max_lines"
                        android:maxLength="@integer/sm_msg_edit_text_max_length"/>
                </LinearLayout>
                <com.transsnet.palmpay.custom_view.input.CustomTextInputLayout
                    android:textColorHint="@color/ppColorTextNormal"
                    android:id="@+id/transfer_money_til"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/core_amount"
                    app:contentInsetStart="0dp"
                    app:contentPaddingRight="0dp"
                    app:editHintTextSize="@dimen/dp14"
                    app:hintTextAppearance="@style/EditHintText1">
                    <com.transsnet.palmpay.custom_view.AmountEditText
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#ff263138"
                        android:textColorHint="@color/ppColorTextNormal"
                        android:id="@+id/set_money_et"
                        android:background="@drawable/cv_title_input_underline"
                        android:paddingTop="6dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLength="10"
                        android:drawablePadding="2dp"
                        android:inputType="numberDecimal"/>
                </com.transsnet.palmpay.custom_view.input.CustomTextInputLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ppColorError"
                    android:id="@+id/amount_error_tv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <Button
                android:textSize="18dp"
                android:textColor="@color/sm_confirm_btn_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/set_money_confirm_bt"
                android:background="@drawable/core_next_btn_selector_bg"
                android:layout_width="270dp"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="@string/sm_send_money_next"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
