<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/sm_background"
            android:paddingTop="15dp"
            android:paddingBottom="20dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingBottom="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/core_recipient_account"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_s_b_b"/>
                <EditText
                    android:textColorHint="@color/text_color_gray4"
                    android:gravity="center_vertical"
                    android:id="@+id/et_bank_account"
                    android:background="@color/transparent"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:hint="@string/sm_enter_10_digit_account_number"
                    android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
                    android:inputType="number"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_me_b"/>
                <View
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp8"
                    android:layout_marginHorizontal="@dimen/dp8"
                    style="@style/core_divider_horizontal"/>
                <RelativeLayout
                    android:id="@+id/rl_select_bank"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <TextView
                        android:textColor="@color/text_color_gray4"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_select_bank"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp50"
                        android:text="@string/sm_select_your_bank"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-medium"
                        style="@style/txt_me_b"/>
                    <ImageView
                        android:id="@+id/iv_bank"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/cv_bank_account"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:id="@+id/tv_bank_name"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/iv_arrow_right"
                        android:layout_toRightOf="@+id/iv_bank"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp10"
                        style="@style/txt_me_b"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/iv_arrow_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp10"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowCenterRight"
                        app:iiv_size="@dimen/dp16"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:paddingBottom="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/sm_recipient_mobile_number_opt"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_s_b_b"/>
                <com.transsnet.palmpay.custom_view.MobileNumberEditText
                    android:textColorHint="@color/text_color_gray4"
                    android:gravity="center_vertical"
                    android:id="@+id/mobile_number"
                    android:background="@color/transparent"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:hint="@string/sm_enter_recipient_mobile_number_opt"
                    android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
                    android:inputType="number"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_me_b_b"/>
            </LinearLayout>
            <TextView
                android:enabled="false"
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/save"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ppButtonHeight"
                android:layout_marginLeft="@dimen/dp8"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp8"
                android:text="@string/core_save"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="@dimen/dp8"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
