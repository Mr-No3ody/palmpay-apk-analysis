<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_benefits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_dialog_benefits"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_benefits">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end"
            android:id="@+id/iiv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:iiv_color="@color/ppColorTextDisable"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="There is a chance to obtain installment\10amount"/>
        <TextView
            android:textSize="@dimen/dp44"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:text="₦50,000"
            style="@style/txt_number_s_b_b"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:src="@drawable/cs_dialog_benefits_icon"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp6"
            android:src="@drawable/cs_dialog_benefits_btn"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:background="@drawable/cs_dialog_benefits_title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginRight="@dimen/dp26"
        android:text="Privilege for high-quality customers"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp26"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_benefits"/>
</androidx.constraintlayout.widget.ConstraintLayout>
