<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp85">
    <View
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ira_root"
        android:background="@drawable/cv_rect_cornet_12_stroke_f2f2f2_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp85"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/itemNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qt_top_up_plan"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/itemAmountTv"
        app:layout_constraintEnd_toEndOf="@+id/ira_root"
        app:layout_constraintStart_toStartOf="@+id/ira_root"
        app:layout_constraintTop_toTopOf="@+id/ira_root"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/itemAmountTv"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toTopOf="@+id/itemValueTv"
        app:layout_constraintEnd_toEndOf="@+id/ira_root"
        app:layout_constraintStart_toStartOf="@+id/ira_root"
        app:layout_constraintTop_toBottomOf="@+id/itemNameTv"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/itemValueTv"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ira_root"
        app:layout_constraintStart_toStartOf="@+id/ira_root"
        app:layout_constraintTop_toBottomOf="@+id/itemAmountTv"/>
    <ImageView
        android:id="@+id/remarkIv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp36"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
