<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/face_titlebar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_back_icon="@drawable/lib_liveness_ic_back"/>
    <FrameLayout
        android:id="@+id/centerFrameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_below="@+id/face_titlebar"
        android:layout_centerHorizontal="true">
        <com.palmpay.lib.liveness.ui.widget.RoundFrameLayout
            android:layout_gravity="center"
            android:id="@+id/face_circle_framelayout"
            android:layout_width="238dp"
            android:layout_height="238dp">
            <androidx.camera.view.PreviewView
                android:layout_gravity="center"
                android:id="@+id/camera_preview"
                android:layout_width="238dp"
                android:layout_height="238dp"/>
        </com.palmpay.lib.liveness.ui.widget.RoundFrameLayout>
        <com.palmpay.lib.liveness.ui.widget.AlgorithmScheduleProgressBar
            android:layout_gravity="center"
            android:id="@+id/face_algorithm_schedule_progressbar"
            android:layout_width="248dp"
            android:layout_height="248dp"
            app:face_color_bg_width="248dp"
            app:face_end_angle="345"
            app:face_max="3600"
            app:face_progress_shader="true"
            app:face_round_progress_end_color="@color/face_progress_end_color"
            app:face_round_progress_start_color="@color/face_progress_start_color"
            app:face_round_width="3dp"
            app:face_start_angle="15"
            app:face_text_is_displayable="false"/>
    </FrameLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/face_bottom_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/centerFrameView"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="16dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/face_pp_license"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:src="@drawable/lib_liveness_pp_license"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
