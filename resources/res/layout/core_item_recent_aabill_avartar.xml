<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_aabill_avartar"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:src="@drawable/cv_avatar_default"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="#0052d9"
        android:gravity="center"
        android:id="@+id/tv_more_num"
        android:background="@drawable/core_rect_round_corner_bg_d4e3fc"
        android:visibility="gone"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_aabill_name"
        android:layout_width="@dimen/dp120"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp5"
        app:layout_constraintStart_toEndOf="@+id/iv_aabill_avartar"
        app:layout_constraintTop_toTopOf="@+id/iv_aabill_avartar"
        style="@style/txt_s_b"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:ellipsize="end"
        android:id="@+id/tv_aabill_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_aabill_avartar"
        app:layout_constraintEnd_toEndOf="@+id/tv_aabill_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_aabill_avartar"
        style="@style/txt_s_b"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_aabill_name,tv_aabill_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
