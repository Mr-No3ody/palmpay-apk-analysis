<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_none_trial_cash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_bg_has_trial_cash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:src="@drawable/cv_ic_bg_has_trial_cash"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tv_has_trial_cash"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You have ₦50,00 Trial Cash to claim ,You have ₦50,00 Trial Cash to claim"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp44"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_has_trial_cash"
        app:layout_constraintEnd_toStartOf="@+id/btn_claim"
        app:layout_constraintStart_toStartOf="@+id/iv_bg_has_trial_cash"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_has_trial_cash"
        style="@style/Text.202046.12"/>
    <TextView
        android:id="@+id/btn_claim"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="@dimen/dp52"
        android:layout_height="@dimen/dp24"
        android:text="@string/cv_claim"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_has_trial_cash"
        app:layout_constraintEnd_toEndOf="@+id/iv_bg_has_trial_cash"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_has_trial_cash"
        style="@style/Text.6306b2.12"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_has_trial_cash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_bg_has_trial_cash,tv_has_trial_cash,btn_claim"/>
</merge>
