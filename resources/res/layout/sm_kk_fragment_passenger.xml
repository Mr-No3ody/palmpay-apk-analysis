<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorTextPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBarKkPassenger"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_back_icon="@drawable/core_actionbar_back_white"
        app:title_bar_right_text="@string/sm_kk_switch_to_rider"
        app:title_bar_title="@string/sm_kk_brand_title"
        app:title_bar_title_color="@color/ppColorTextBase"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svKkPassengerContent"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp4"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp6"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/includeCvLoginRegisterBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBarKkPassenger">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.send_money.ui.view.kkcar.KkCarQrView
                android:id="@+id/viewKkQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/adKkQuickActionsTop"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/sm_kk_ad_quick_actions_top_slot_id"/>
            <FrameLayout
                android:id="@+id/flKkQuickActionsCard"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/llKkQrHistory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/dp8"
                        android:paddingEnd="@dimen/dp8">
                        <ImageView
                            android:id="@+id/ivKkQrHistoryIcon"
                            android:layout_width="@dimen/dp28"
                            android:layout_height="@dimen/dp28"
                            android:contentDescription="@string/sm_kk_quick_action_history"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            android:text="@string/sm_kk_quick_action_history"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/llKkQrSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/dp8"
                        android:paddingEnd="@dimen/dp8">
                        <ImageView
                            android:id="@+id/ivKkQrSettingsIcon"
                            android:layout_width="@dimen/dp28"
                            android:layout_height="@dimen/dp28"
                            android:contentDescription="@string/sm_kk_settings_title"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            android:text="@string/sm_kk_settings_title"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/adKkQuickActionsBottom"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/sm_kk_ad_quick_actions_bottom_slot_id"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/includeCvLoginRegisterBottom"
        android:background="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
