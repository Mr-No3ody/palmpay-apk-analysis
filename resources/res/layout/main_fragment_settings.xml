<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_login_setting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_login_settings"
            android:summary=""/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_pay_set"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_payment_setting"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutDarkMode"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_dark_mode"
            android:layout="@layout/main_pref_layout_single_line_content"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_dark_mode"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_minor_account_management"
            android:layout="@layout/main_pref_layout_single_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="Minor Account Management"
            android:summary=""/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_minor_guardian"
            android:layout="@layout/main_pref_layout_single_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="Guardian Management"
            android:summary=""/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_sms_subscribe"
            android:layout="@layout/main_pref_layout_single_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="SMS Notification Subscribe"
            android:summary=""/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_notification_setting"
            android:layout="@layout/main_pref_layout_single_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_notification_settings"
            android:summary=""
            android:defaultValue="false"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_email_alert_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_email_alert_settings"
            android:defaultValue="false"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_speaker_on"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_speaker_on"
            android:defaultValue="true"
            app:st_checkStyle="true"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutMerchantSettings"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_login_author"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_login_author_management"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_merchant"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_merchant_payment"
            android:summary=""
            android:defaultValue="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_about"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_about"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutCloseAccount"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_close_account"
            android:layout="@layout/main_pref_layout_single_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_close_account"
            app:st_showDivider="false"/>
    </LinearLayout>
</LinearLayout>
