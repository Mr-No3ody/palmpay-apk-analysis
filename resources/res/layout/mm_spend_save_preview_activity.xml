<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/mm_bg_fixed_saving_preview"
        android:paddingTop="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textStyle="bold"
            android:id="@+id/tvTitle"
            android:text="Payment"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp16"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutOrderInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp16"
            android:divider="@drawable/mm_bg_transparent_v_divider_20"
            android:showDividers="middle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
            android:id="@+id/paymentMethodItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            app:layout_constraintTop_toBottomOf="@+id/layoutOrderInfo"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:enabled="false"
            android:textStyle="bold"
            android:id="@+id/rtvPay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp48"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/paymentMethodItem"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
