<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbdti_root"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp5"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/mbdti_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp10"
        android:drawablePadding="4dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/mbdti_content_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/mbdti_title_tv">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="right"
            android:id="@+id/mbdti_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:maxLines="2"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/mbdti_copy_iv"
            android:padding="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Copy"
            app:iiv_size="16dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="right"
        android:id="@+id/mbdti_content_desc_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        android:maxLines="2"
        android:layout_below="@+id/mbdti_content_ll"
        android:layout_alignParentRight="true"
        android:fontFamily="sans-serif"/>
    <View
        android:id="@+id/content_divider"
        android:background="#ffe2e8ed"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp5"
        android:layout_below="@+id/mbdti_content_desc_tv"/>
</RelativeLayout>
