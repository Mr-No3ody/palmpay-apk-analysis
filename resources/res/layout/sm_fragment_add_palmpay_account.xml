<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsnet.palmpay.custom_view.input.CustomAutoCompleteTextView
        android:textSize="@dimen/medium_text"
        android:textColor="@color/ppColorTextPrimary"
        android:textColorHint="@color/ppColorTextDisable"
        android:gravity="center_vertical"
        android:id="@+id/et_bank_account"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:hint="@string/sm_enter_10_digit_account_number"
        android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
        android:digits="0123456789"
        android:inputType="phone"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/MyAutoCompleteTextView"/>
    <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
        android:id="@+id/med_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginHorizontal="@dimen/dp8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlSelectBank"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:id="@+id/account_bank_icon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/cv_bank_account"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/account_select_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_app_name"
            android:layout_marginStart="@dimen/dp10"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_label"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/account_bank_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_me_b"/>
        <ImageView
            android:id="@+id/iv_label"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/dp10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/account_select_bank"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
        android:id="@+id/med_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginHorizontal="@dimen/dp8"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp34"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.wang.avi.AVLoadingIndicatorView
                android:layout_gravity="center"
                android:id="@+id/indicatorView"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:indicatorColor="@color/ppColorPrimary"
                app:indicatorName="BallSpinFadeLoaderIndicator"
                style="@style/AVLoadingIndicatorView.Large"/>
            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_looking_for_this_user_name"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_name"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:minHeight="@dimen/dp34"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8">
            <ImageView
                android:id="@+id/iv_query_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"/>
            <TextView
                android:id="@+id/tv_recipient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_s_b_b"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_next"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_next"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/txt_me_w_b"/>
    </FrameLayout>
</LinearLayout>
