<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/couponView"
        android:background="@drawable/main_rewards_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="#202046"
            android:gravity="center"
            android:id="@+id/text1"
            android:layout_width="@dimen/dp80"
            android:layout_height="@dimen/dp30"
            android:layout_marginTop="@dimen/dp3"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"
            style="@style/txt_mi_b"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3">
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="#6b36ea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_currency_char_nig"
                android:fontFamily="sans-serif-black"
                android:textFontWeight="800"/>
            <TextView
                android:textSize="@dimen/dp22"
                android:textColor="#6b36ea"
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp2"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="800"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn"
            android:background="@drawable/cv_rect_round_corner_bg_38d79f"
            android:layout_width="@dimen/dp63"
            android:layout_height="@dimen/dp24"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="4dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/core_use_now"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_hot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        android:src="@drawable/main_rewards_hot"/>
</RelativeLayout>
