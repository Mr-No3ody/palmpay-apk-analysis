<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view_bg_coupon_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_bg_coupon_mid"
        app:layout_constraintHeight_min="@dimen/dp46"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_shape_rect_corner_tl_bl_4_bg_white"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view_bg_coupon_mid"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg_coupon_start"
        app:layout_constraintEnd_toStartOf="@+id/view_bg_coupon_end"
        app:layout_constraintTop_toTopOf="@+id/view_bg_coupon_start"
        app:srcCompat="@drawable/core_bg_coupon_mid"/>
    <ImageView
        android:id="@+id/iv_coupon_icon"
        android:layout_width="@dimen/dp18"
        android:layout_height="wrap_content"
        android:src="@drawable/core_ticket_discount_coupon"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg_coupon_start"
        app:layout_constraintStart_toStartOf="@+id/view_bg_coupon_start"
        app:layout_constraintTop_toTopOf="@+id/view_bg_coupon_start"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:id="@+id/tv_coupon_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp5"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_coupon_limit"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_coupon_limit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp5"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_bg_coupon_start"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_value"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_coupon_limit_single"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_coupon_value"
        app:layout_constraintEnd_toEndOf="@+id/view_bg_coupon_start"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_coupon_value"
        style="@style/Text.6f7b85.12"/>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/view_bg_coupon_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.28">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/cv_shape_rect_corner_rt_rb_4_bg_white"/>
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center"
            android:id="@+id/view_loading_indicator"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:indicatorColor="@color/ppColorPrimary"
            app:indicatorName="BallSpinFadeLoaderIndicator"
            style="@style/AVLoadingIndicatorView.Large"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_coupon_claim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/core_claim"
            style="@style/Text.medium.6306b2.12"/>
    </FrameLayout>
</merge>
