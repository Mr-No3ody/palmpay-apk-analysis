<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp95">
    <ImageView
        android:id="@+id/iv_recommend_badge"
        android:layout_width="@dimen/dp68"
        android:layout_height="@dimen/dp68"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recommend_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_recommend_buy"
        app:layout_constraintStart_toEndOf="@+id/iv_recommend_badge"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/ppColorButtonTextWhite"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_recommend_tag"
            android:background="@drawable/qt_shape_data_bundle_recommend_tag"
            android:paddingLeft="@dimen/dp5"
            android:paddingRight="@dimen/dp5"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp5"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Text.medium.ffffff.10"/>
        <TextView
            android:textSize="@dimen/dp30"
            android:ellipsize="end"
            android:id="@+id/tv_recommend_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginBottom="@dimen/dp4"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginVertical="@dimen/dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_recommend_validity"
            app:layout_constraintEnd_toStartOf="@+id/recommend_price_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_recommend_tag"
            style="@style/txt_number_s_b_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recommend_price_container"
            android:background="@drawable/cv_rect_corner_8_bg_f6f6fa"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:layout_marginStart="@dimen/dp4"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_recommend_volume"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/tv_recommend_volume"
            app:layout_constraintTop_toTopOf="@+id/tv_recommend_volume">
            <TextView
                android:textSize="@dimen/dp12"
                android:id="@+id/tv_recommend_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/txt_number_s_b_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextAssist"
                android:id="@+id/tv_recommend_business_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp4"
                style="@style/txt_number_s_b"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_recommend_validity"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp16"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_recommend_info"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_recommend_volume"
            style="@style/Text.202046.12"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_recommend_info"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="@dimen/dp2"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_InformationOutline"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_recommend_validity"
            app:layout_constraintStart_toEndOf="@+id/tv_recommend_validity"
            app:layout_constraintTop_toTopOf="@+id/tv_recommend_validity"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:id="@+id/btn_recommend_buy"
        android:background="@drawable/qt_shape_data_bundle_recommend_buy"
        android:layout_width="@dimen/dp55"
        android:layout_height="@dimen/dp24"
        android:text="@string/qt_buy"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppSmallButtonNoPaddingStyle"/>
</merge>
