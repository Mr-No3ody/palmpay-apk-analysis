<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_color_total_bill_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/cl_repayment_mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_background="@color/cs_color_status_bar_color"
        app:title_bar_title="Repayment"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/repay_coupon_ll"
        android:background="@drawable/cs_oc_repay_zone_bg"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_repayment_coupon"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coupon_rv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp6"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="@dimen/dp12"
            android:layout_height="@dimen/dp12"
            android:src="@drawable/cs_oc_coupon_right_arrow"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/cs_color_status_bar_color"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:paddingStart="@dimen/dp24"
        android:paddingEnd="@dimen/dp24">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/csTextview24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_repayment_amount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/bw_symbol_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/repay_input_et"
            app:layout_constraintStart_toStartOf="@+id/csTextview24"
            app:layout_constraintTop_toTopOf="@+id/repay_input_et"/>
        <com.transsnet.palmpay.custom_view.AmountEditText
            android:theme="@style/csCLRepayEditTextTheme"
            android:textSize="36sp"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="@color/cv_color_504e56"
            android:id="@+id/repay_input_et"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp14"
            android:hint="@string/cs_cl_borrow_0_00"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@+id/clear_input_tv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/bw_symbol_tv"
            app:layout_constraintTop_toBottomOf="@+id/csTextview24"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cs_main_color"
            android:gravity="center"
            android:id="@+id/clear_input_tv"
            android:background="@drawable/cs_cl_repay_clear_icon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            app:layout_constraintBottom_toBottomOf="@+id/repay_input_et"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/repay_input_et"/>
        <View
            android:id="@+id/repayment_input_divider_view"
            android:background="@color/cs_cl_input_divider_normal_color"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/clear_input_tv"
            app:layout_constraintStart_toStartOf="@+id/bw_symbol_tv"
            app:layout_constraintTop_toBottomOf="@+id/bw_symbol_tv"/>
        <TextView
            android:textColor="@color/cs_cl_repayment_amount_tips_txt_color"
            android:id="@+id/repay_input_tips_tv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/cs_cl_min_repayment_amount"
            app:layout_constraintEnd_toEndOf="@+id/repayment_input_divider_view"
            app:layout_constraintStart_toStartOf="@+id/repayment_input_divider_view"
            app:layout_constraintTop_toBottomOf="@+id/repayment_input_divider_view"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/repay_min_amount_tv"
            android:background="@drawable/cs_cl_amount_tv_bg"
            android:paddingLeft="@dimen/dp8"
            android:paddingRight="@dimen/dp8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp26"
            android:text="@string/cs_cl_min_amount"
            android:layout_marginStart="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="@+id/repay_all_amount_tv"
            app:layout_constraintStart_toEndOf="@+id/repay_all_amount_tv"
            app:layout_constraintTop_toTopOf="@+id/repay_all_amount_tv"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/repay_all_amount_tv"
            android:background="@drawable/cs_cl_amount_tv_bg"
            android:visibility="visible"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp26"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_cl_all_amount"
            app:layout_constraintStart_toStartOf="@+id/bw_symbol_tv"
            app:layout_constraintTop_toBottomOf="@+id/repay_input_tips_tv"/>
        <TextView
            android:id="@+id/csTextview111"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_cl_principal"
            app:layout_constraintStart_toStartOf="@+id/repayment_input_divider_view"
            app:layout_constraintTop_toBottomOf="@+id/repay_all_amount_tv"
            style="@style/csClRepaymentItemTitleStyle"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/principal_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview111"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview111"
            app:layout_constraintTop_toTopOf="@+id/csTextview111"
            style="@style/csClRepaymentItemContentStyle"/>
        <TextView
            android:id="@+id/interest_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_interest"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintStart_toStartOf="@+id/csTextview111"
            app:layout_constraintTop_toBottomOf="@+id/principal_amount_tv"
            style="@style/csClRepaymentItemTitleStyle"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/interest_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/interest_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/interest_title_tv"
            app:layout_constraintTop_toTopOf="@+id/interest_title_tv"
            style="@style/csClRepaymentItemContentStyle"/>
        <TextView
            android:id="@+id/service_fee_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_service_fee"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintStart_toStartOf="@+id/interest_title_tv"
            app:layout_constraintTop_toBottomOf="@+id/interest_title_tv"
            style="@style/csClRepaymentItemTitleStyle"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/service_fee_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/service_fee_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/service_fee_title_tv"
            app:layout_constraintTop_toTopOf="@+id/service_fee_title_tv"
            style="@style/csClRepaymentItemContentStyle"/>
        <TextView
            android:id="@+id/penalty_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_penalty"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintStart_toStartOf="@+id/service_fee_title_tv"
            app:layout_constraintTop_toBottomOf="@+id/service_fee_title_tv"
            style="@style/csClRepaymentItemTitleStyle"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/penalty_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/penalty_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/penalty_title_tv"
            app:layout_constraintTop_toTopOf="@+id/penalty_title_tv"
            style="@style/csClRepaymentItemContentStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.credit.ui.viewmodel.AvailableCouponItem
        android:background="@color/cv_color_ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:transTypes="j7"
        app:viewStyle="white"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/cl_repay_bt_sav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp24"
        app:slot_id="@string/cl_repayment_bt_slot_id"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:id="@+id/cl_repayment_next_bt"
        android:background="@drawable/cs_cl_repay_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:text="@string/cs_cl_bill_repay"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/cs_cl_main_color"
        android:id="@+id/cl_extend_bt"
        android:background="@drawable/cs_c_expend_bt_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_cl_extension_repay_amount"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/extend_date_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_cl_repayment_date_extended_date"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
            android:id="@+id/cl_repayment_dkv"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:core_confirm_key_bg="@drawable/cs_cl_keyboard_confirm_bg"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </FrameLayout>
</LinearLayout>
