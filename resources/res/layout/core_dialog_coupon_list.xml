<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50">
        <TextView
            android:textSize="@dimen/dp16"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/coupons_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_available_coupon"
            android:layout_centerInParent="true"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/cdcl_close_iv"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginRight="@dimen/dp10"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp10"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"/>
    </RelativeLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginEnd="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/cdcl_rcv"
        android:layout_width="match_parent"
        android:layout_height="465dp"
        android:layout_marginBottom="20dp"/>
</LinearLayout>
