<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/layoutContent"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/viewBottompAd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/topSpace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivInstallmentLoanIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topSpace"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvInstallmentLoan"
            android:layout_marginLeft="@dimen/dp6"
            android:text="@string/cs_cl_installment_loan"
            app:layout_constraintBottom_toBottomOf="@+id/ivInstallmentLoanIcon"
            app:layout_constraintLeft_toRightOf="@+id/ivInstallmentLoanIcon"
            app:layout_constraintTop_toBottomOf="@+id/topSpace"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:id="@+id/tvRightBorrowed"
            app:layout_constraintBottom_toBottomOf="@+id/tvInstallmentLoan"
            app:layout_constraintRight_toLeftOf="@+id/ivBorrowedArrow"
            app:layout_constraintTop_toTopOf="@+id/tvInstallmentLoan"
            style="@style/Text.202046.14"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivBorrowedArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp2"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowUp"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/tvRightBorrowed"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvRightBorrowed"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmountTitle"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_loan_amount"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInstallmentLoan"
            style="@style/Text.202046.12"/>
        <ImageView
            android:id="@+id/ivLoanableAmountIcon"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintStart_toEndOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="@color/ppColorError"
            android:id="@+id/rtvFrozen"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:layout_marginLeft="@dimen/dp4"
            android:text="@string/cs_frozen"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"
            app:rtv_background_color="@color/transparent"
            app:rtv_border_color="@color/ppColorError"
            app:rtv_border_width="@dimen/dp1"
            app:rtv_corner_radius="@dimen/dp4"
            style="@style/Text.ffffff.10"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodTitle"
            android:layout_marginRight="@dimen/dp36"
            android:text="@string/cs_loan_period"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"
            style="@style/Text.202046.12"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="@+id/tvLoanPeriodTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodDays"
            android:layout_marginLeft="@dimen/dp3"
            android:layout_marginTop="@dimen/dp6"
            android:text="Days"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvLoanPeriod"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanPeriod"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/cv_color_906948"
            android:id="@+id/tvDailyInterest"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.medium.202046.12"/>
        <TextView
            android:id="@+id/tvFrozenReason"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.202046.12"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/viewTopAd"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toBottomOf="@+id/tvDailyInterest"/>
        <View
            android:id="@+id/viewEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/viewTopAd"
            app:layout_constraintTop_toTopOf="@+id/layoutBtn"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewTopAd"
            app:layout_goneMarginTop="@dimen/dp12">
            <com.transsnet.palmpay.credit.view.FitFontSizePpButton
                android:textColor="@color/cv_color_906948"
                android:id="@+id/rtvIncrease"
                android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:text="@string/cs_cl_increase_limit"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp4"
                android:layout_marginEnd="@dimen/dp6"
                app:layout_constraintEnd_toStartOf="@+id/layoutBorrowWithLight"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rtv_background_color="@color/ppColorSecondary"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/ppButtonStyle"/>
            <FrameLayout
                android:id="@+id/layoutBorrowWithLight"
                android:clipChildren="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginStart="@dimen/dp6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/rtvIncrease"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp">
                <com.transsnet.palmpay.credit.view.FitFontSizePpButton
                    android:textColor="@color/cs_borrow_text_color"
                    android:id="@+id/rtvBorrow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/cs_cl_borrow"
                    android:paddingStart="@dimen/dp4"
                    android:paddingEnd="@dimen/dp4"
                    app:rtv_background_color="@color/cs_cash_main_borrow_background_color"
                    app:rtv_corner_radius="@dimen/dp12"
                    style="@style/ppButtonStyle"/>
                <com.transsnet.palmpay.credit.view.MultiLoanCtaLightView
                    android:id="@+id/multiLoanCtaLight"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.transsnet.palmpay.credit.view.MultiLoanHomeBannerView
            android:id="@+id/multiLoanBanner"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutBtn"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/llProductProvidedBy"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/multiLoanBanner">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ppColorTextAssist"
                android:id="@+id/tvProductProvidedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/ivProductProvidedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp6"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/installment_ifJointDebit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_borrow_before_is_joint_debit_tips"
            app:layout_constraintEnd_toEndOf="@+id/layoutBtn"
            app:layout_constraintStart_toStartOf="@+id/layoutBtn"
            app:layout_constraintTop_toBottomOf="@+id/layoutBtn"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvLoanableAmountTitle,tvLoanPeriodTitle,tvLoanableAmount,tvLoanPeriod,tvLoanPeriodDays,tvDailyInterest,layoutBtn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cs_cl_installment_loan_terms_text_color"
        android:id="@+id/tvLoanTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
