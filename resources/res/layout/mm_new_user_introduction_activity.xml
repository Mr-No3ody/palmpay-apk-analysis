<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/mm_color_f6f6fa"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rgIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/mm_bg_transparent_h_divider_8"
        android:showDividers="middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.609"/>
    <TextView
        android:id="@+id/tvSkip"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:text="@string/mm_loading_skip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.056"
        style="@style/Text.858a8f.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvSignIn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/mm_sign_in"
        app:layout_constraintBottom_toTopOf="@+id/rtvCreateAccount"
        app:layout_constraintRight_toRightOf="parent"
        app:rtv_background_color="@color/mm_color_6306b2"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/mm_sign_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:rtv_background_color="@color/mm_color_f0ecfc"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.6306b2.16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupUnLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rtvCreateAccount,rtvSignIn"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:rtv_background_color="@color/mm_color_6306b2"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
