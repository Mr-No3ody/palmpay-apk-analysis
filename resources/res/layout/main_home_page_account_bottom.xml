<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
    android:paddingTop="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:translationZ="-1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootAccountBottom"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp9"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBusinessIcon"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:src="@drawable/cv_palmpay_icon_gray"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp4"
            android:layout_marginRight="24dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/ivBusinessIcon"
            app:layout_constraintEnd_toStartOf="@+id/tvJumpContent"
            app:layout_constraintStart_toEndOf="@+id/ivBusinessIcon"
            app:layout_constraintTop_toTopOf="@+id/ivBusinessIcon"
            style="@style/Text.202046.12"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tvJumpContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp2"
            android:minWidth="@dimen/dp20"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@+id/ivBusinessJumpIcon"
            app:layout_constraintEnd_toStartOf="@+id/ivBusinessJumpIcon"
            app:layout_constraintTop_toTopOf="@+id/ivBusinessJumpIcon"
            style="@style/Text.202046.10"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBusinessJumpIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/cv_arrow_right_purple_with_circle"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
