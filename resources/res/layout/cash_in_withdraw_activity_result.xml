<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:paddingLeft="@dimen/dp15"
                android:paddingRight="@dimen/dp15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp22"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_result_hint_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ciar_iv"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="center_horizontal"
                    android:id="@+id/ciar_result_hint_text_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp25"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp25"
                    android:text="@string/ci_fund_success_hint_text"
                    android:layout_below="@+id/ciar_result_hint_tv"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="3dp"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ciar_iv"
                    android:layout_width="@dimen/cv_result_success_img_size"
                    android:layout_height="@dimen/cv_result_success_img_size"
                    android:layout_marginTop="@dimen/dp50"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_centerHorizontal="true"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/cv_result_success"/>
            </RelativeLayout>
            <com.transsnet.palmpay.core.viewmodel.ModelPaymentResultProgress
                android:id="@+id/payProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp50"/>
            <RelativeLayout
                android:id="@+id/ciar_receipt_item"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp25"
                android:paddingRight="@dimen/dp25"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp45">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextNormal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_receipt_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_recipient"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_receipt_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/ppColorDividerLineDark"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/ciar_pay_method_item"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp25"
                android:paddingRight="@dimen/dp25"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp45">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextNormal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_pay_method_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ci_payment_method"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="right"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_pay_method_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="1"
                    android:layout_toRightOf="@+id/ciar_pay_method_title_tv"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <View
                    android:background="@color/ppColorDividerLineDark"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <com.transsnet.palmpay.core.ui.widget.ModelResultAmountList
                android:id="@+id/model_result_amount_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginRight="@dimen/dp25"
                android:layout_marginHorizontal="@dimen/dp25"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/actur_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.transsnet.palmpay.core.viewmodel.FailResultPageAdView
                android:id="@+id/fail_okcard_ad"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp14"
        android:layout_marginRight="@dimen/dp14"
        android:layout_marginBottom="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/ciar_complete_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:layout_width="@dimen/dp12"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/ciar_withdraw_again_btn"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/ci_withdraw_again"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
