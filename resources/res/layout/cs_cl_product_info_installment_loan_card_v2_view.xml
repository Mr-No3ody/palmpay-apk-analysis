<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_loan_card_top_header"/>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/cv_shape_rect_bottom_corner_white_12"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/layoutContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layoutContent"/>
    <ImageView
        android:id="@+id/ivMask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_home_loan_card_bg_1"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTopBar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutContent"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTopBar">
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvAmountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:textSize="40sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvAmountValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/cv_palmpay_number_bold"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivPolygon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/cv_icon_polygon"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layoutLimitIncreased"
            android:background="@drawable/cs_cl_special_offer_limit_capsule_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tvLimitIncreased"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.6f7b85.12"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivLimitIncreased"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                app:iiv_color="@color/cs_main_color"
                app:iiv_icon="pay_UpdateFill"
                app:iiv_size="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layoutInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/cs_icon_interest"/>
            <TextView
                android:id="@+id/tvInterestValue2"
                android:layout_marginStart="4dp"
                style="@style/Text.medium.202046.14"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutInfoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="4dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivInterestIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/cs_icon_interest"/>
                    <TextView
                        android:id="@+id/tvInterestValue"
                        android:layout_marginStart="4dp"
                        style="@style/Text.medium.202046.14"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center"
                        android:id="@+id/tvInterestBadge"
                        android:background="@drawable/cs_cl_special_offer_dropped_badge_bg"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="4dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvInterestLabel"
                    android:layout_marginTop="2dp"
                    style="@style/Text.6f7b85.10"/>
            </LinearLayout>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="1dp"
                android:layout_height="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="4dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivPeriodIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_Calendar"
                        app:iiv_size="20dp"/>
                    <TextView
                        android:id="@+id/tvPeriodValue"
                        android:layout_marginStart="4dp"
                        style="@style/Text.medium.202046.14"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center"
                        android:id="@+id/tvExtendBadge"
                        android:background="@drawable/cs_cl_special_offer_dropped_badge_bg"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="6dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvPeriodLabel"
                    android:layout_marginTop="2dp"
                    style="@style/Text.6f7b85.10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutOverdueNoticeBar"
            android:background="@drawable/cs_cl_overdue_notice_bar_bg"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/cs_cl_overdue_txt_color"
                android:id="@+id/tvOverdueNoticeMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.3"/>
            <TextView
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnOverdueRepay"
                android:background="@drawable/cs_cl_overdue_repay_btn_bg"
                android:paddingLeft="12dp"
                android:paddingTop="2dp"
                android:paddingRight="12dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="44dp"
                android:text="@string/cs_oc_repay"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="2dp"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCoupon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24">
            <ImageView
                android:id="@+id/ivCouponBg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_loan_card_coupon_bg"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#5e3e1f"
                android:id="@+id/tvCouponTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="48dp"
                app:layout_constraintBottom_toTopOf="@+id/tvCouponExpireTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivCouponBg"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tvCouponExpireTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivCouponBg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvCouponTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvCouponTitle"
                style="@style/Text.6f7b85.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/rtvBorrow"
            android:background="@drawable/cv_button_bg_text_primary_corner_12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="12dp"
            android:text="@string/cs_cl_borrow"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
