<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_head_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp10"
        style="@style/txt_mi_lg"/>
    <TextView
        android:id="@+id/tv_head_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp10"
        style="@style/txt_s_b"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/result_item_view"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp16">
        <ImageView
            android:id="@+id/photoIv"
            android:layout_width="40dp"
            android:layout_height="@dimen/dp40"
            android:layout_marginLeft="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/text1Tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="true"
            android:layout_alignTop="@+id/photoIv"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/photoIv"
            app:layout_constraintEnd_toStartOf="@+id/iv_agent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/photoIv"
            app:layout_constraintTop_toTopOf="@+id/photoIv"
            app:layout_constraintWidth_default="wrap"
            style="@style/txt_s_b"/>
        <ImageView
            android:id="@+id/iv_agent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:src="@drawable/cv_sm_ic_send_agent_tag"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp3"
            app:layout_constraintEnd_toStartOf="@+id/iv_cash_back"
            app:layout_constraintStart_toEndOf="@+id/text1Tv"
            app:layout_constraintTop_toTopOf="@+id/text1Tv"
            app:layout_goneMarginEnd="@dimen/dp10"/>
        <ImageView
            android:id="@+id/iv_cash_back"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:src="@drawable/cv_sm_ic_send_agent_tag"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp3"
            android:layout_marginEnd="@dimen/dp10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_agent"
            app:layout_constraintTop_toTopOf="@+id/text1Tv"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:ellipsize="end"
            android:id="@+id/text2Tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="1"
            android:includeFontPadding="true"
            android:layout_below="@+id/text1Tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_palmpay_tag"
            app:layout_constraintStart_toStartOf="@+id/text1Tv"
            app:layout_constraintTop_toBottomOf="@+id/text1Tv"
            style="@style/txt_mi_b"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:id="@+id/tv_palmpay_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:includeFontPadding="true"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/text2Tv"
            app:layout_constraintTop_toBottomOf="@+id/text1Tv"
            style="@style/txt_mi_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_search_type"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_below="@+id/text2Tv"
            android:layout_alignStart="@+id/text1Tv"
            app:layout_constraintStart_toStartOf="@+id/text1Tv"
            app:layout_constraintTop_toBottomOf="@+id/text2Tv">
            <ImageView
                android:id="@+id/iv_searchType"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:src="@drawable/sm_ic_list_facebook"/>
            <TextView
                android:id="@+id/tv_searchType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp2"
                style="@style/txt_s_b"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
