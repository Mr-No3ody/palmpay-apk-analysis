<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivMale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ac_male_2"
        android:scaleType="fitXY"
        android:paddingEnd="8dp"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_male"
        style="@style/txt_me_b"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkMale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:button="@drawable/cv_checkbox_selector1"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:id="@+id/ivFemale"
        android:paddingLeft="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ac_female_2"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:text="@string/ac_female"
        style="@style/txt_me_b"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkFemale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:button="@drawable/cv_checkbox_selector1"
        android:layout_marginStart="4dp"/>
</merge>
