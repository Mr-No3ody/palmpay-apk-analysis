<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/llCoupon"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp68">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/core_coupon_frame_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/ivCouponIcon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/cv_coupon_icon"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp12"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp14">
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvCouponName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/couponLimitTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                style="@style/Text.202046.12"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llRight"
        android:background="@drawable/core_coupon_frame_right"
        android:layout_width="@dimen/dp100"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/dp24"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/tvCouponAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/txt_number_s_b_b"/>
    </LinearLayout>
</LinearLayout>
