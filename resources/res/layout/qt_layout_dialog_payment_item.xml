<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_list_item_bg"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/qld_cashback_iv"
        android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp18"
        android:layout_marginTop="@dimen/dp10"
        android:paddingStart="@dimen/dp7"
        android:paddingEnd="@dimen/dp7"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/tvText"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="0dp"
        style="@style/txt_me_b"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/textViewText"/>
</LinearLayout>
