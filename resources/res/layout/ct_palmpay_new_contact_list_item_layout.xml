<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/delete_tv"
            android:background="@color/ppColorError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ct_delete"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/contact_swipe"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:id="@+id/contact_photo"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="15dp"
                android:textColor="#ff272a2d"
                android:ellipsize="end"
                android:id="@+id/contact_note_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ff6f7b85"
                android:ellipsize="end"
                android:id="@+id/contact_full_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ct_contact_status_selector_color"
            android:gravity="center"
            android:id="@+id/contact_status"
            android:background="@drawable/ct_purple_corner_selector_bg"
            android:layout_width="50dp"
            android:layout_height="20dp"/>
    </LinearLayout>
</com.daimajia.swipe.SwipeLayout>
