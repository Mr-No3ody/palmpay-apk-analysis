<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bettingWithdrawLl"
        android:paddingBottom="@dimen/dp40"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/bettingWithdrawNScrollView"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/billerRoot"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16">
                    <com.transsnet.palmpay.custom_view.ModelItemSelection
                        android:id="@+id/tevSelectBiller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:cv_item_selection_start_icon_visible="true"
                        app:cv_item_selection_title_visible="false"
                        app:cv_item_selection_value_max_line="2"
                        app:cv_item_selection_value_text_size="@dimen/dp16"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/paymentRoot"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16">
                    <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                        android:id="@+id/viewBettingCustomerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        app:cv_arrow_icon_visible="false"
                        app:cv_contacts_icon_visible="gone_forever"
                        app:cv_hint="@string/qt_please_enter_user_id"
                        app:cv_show_error_text="true"
                        app:cv_title="@string/qt_user_id"
                        app:cv_title_visible="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/amountWithdrawRoot"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_withdraw_amount"/>
                    <com.palmpay.lib.ui.edit.PpAmountEditText
                        android:id="@+id/etBettingAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        android:inputType="number"
                        app:am_edit_hint="@string/qt_s_is_minimum"
                        app:am_edit_show_button="false"
                        app:am_edit_show_lock="false"
                        app:am_edit_show_title="false"
                        app:am_edit_text_size="@dimen/dp16"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/confirmCodeWithdrawRoot"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12">
                    <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                        android:id="@+id/viewBettingConfirmCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        app:cv_arrow_icon_visible="false"
                        app:cv_contacts_icon_visible="gone_forever"
                        app:cv_hint=" "
                        app:cv_show_error_text="true"
                        app:cv_title="@string/qt_confirm_code"
                        app:cv_title_visible="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/authNameWithdrawRoot"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_first_name_and_surname"/>
                    <TextView
                        android:textSize="@dimen/dp16"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/authNameWithdrawName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorError"
                        android:id="@+id/authNameNotPass"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp9"
                        android:text="@string/qt_your_betting_withdraw_tips"/>
                </LinearLayout>
                <com.transsnet.adsdk.widgets.banner.BannerAdView
                    android:id="@+id/adBettingBanner"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"
                    app:ad_rounded_corners="@dimen/dp8"
                    app:slot_id="@string/betting_withdraw_home_page_banner_slot_id"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp68">
            <TextView
                android:gravity="center"
                android:id="@+id/bettingWithdraw"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cv_default_button_height"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginRight="@dimen/dp24"
                android:text="@string/core_withdraw"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/dp24"
                style="@style/Text.medium.ffffff.16"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
