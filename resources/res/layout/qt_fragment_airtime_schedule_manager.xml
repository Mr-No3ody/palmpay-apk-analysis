<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/adTopBanner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/ad_payment_schedule_old_user_top_banner_slot_id"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryScheduleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryFAQ"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp24"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:paddingHorizontal="@dimen/dp24"
        android:paddingVertical="@dimen/dp12">
        <TextView
            android:id="@+id/tvAddNumbers"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/qt_add_numbers"
            style="@style/Text.ffffff.16"/>
    </LinearLayout>
</LinearLayout>
