<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/top_acc_ll_one_borrow"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp16">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_loan_amount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/available_amount_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:fontFamily="@font/cv_palmpay_number_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSingleCashAvailableAmount"/>
        <com.transsnet.palmpay.credit.ui.view.OneTouchBorrowView
            android:id="@+id/oneTouchBorrowView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:otb_agreement_show="false"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/cv_flexi_cash_base_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/borrow_other_amount_tv"
            android:background="@drawable/cs_cl_shape_borrow_all_top"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_borrow_installment_other_amount"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/agreement_ll"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp15"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp15">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_loan_agreement"
            android:layout_weight="1"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextDisable"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="@dimen/dp20"/>
    </LinearLayout>
</LinearLayout>
