<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/break_top_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_gold_frozen"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/break_top_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_oc_gold_frozen_title"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:id="@+id/break_top_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_oc_gold_frozen_content"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/break_got_bt"
        android:background="@drawable/cs_oc_primary_bt_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_got_it"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/break_disable_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp44"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_oc_reactivate_and_upgrade_now"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/break_account_cl"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingBottom="@dimen/dp14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/amount_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/cs_oc_flexi_outstanding"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorError"
            android:id="@+id/disable_tv"
            android:background="@drawable/cs_oc_disable_txt_bg"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_disabled"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/amount_title_tv"
            app:layout_constraintStart_toEndOf="@+id/amount_title_tv"
            app:layout_constraintTop_toTopOf="@+id/amount_title_tv"/>
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/outstanding_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="@+id/amount_title_tv"
            app:layout_constraintTop_toBottomOf="@+id/amount_title_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/repay_tv"
            android:background="@drawable/cs_corner_16_bg_00c2ff"
            android:layout_width="@dimen/dp86"
            android:layout_height="@dimen/dp32"
            android:text="@string/cs_oc_repay_now"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/outstanding_amount_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/outstanding_amount_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorWarning"
            android:id="@+id/reactive_use_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_reactive_to_use"
            app:layout_constraintStart_toStartOf="@+id/outstanding_amount_tv"
            app:layout_constraintTop_toBottomOf="@+id/outstanding_amount_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
