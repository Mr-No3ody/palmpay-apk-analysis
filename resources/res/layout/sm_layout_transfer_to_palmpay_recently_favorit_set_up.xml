<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_favorit_set_up"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:src="@drawable/cv_icon_polygon"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ppColorBackgroundDark"/>
    <org.sufficientlysecure.htmltextview.HtmlTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_favorit_tip"
        android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="60dp"
        android:backgroundTint="@color/ppColorBackgroundDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivArrow"
        style="@style/txt_mi_b"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/btnSetup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sm_set_up"
        android:layout_marginEnd="@dimen/dp8"
        app:iiv_end_color="@color/ppColorPrimary"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_favorit_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_favorit_tip"
        style="@style/Text.6306b2.10"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/btnInvite"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="@dimen/dp20"
        android:text="@string/core_invite"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_favorit_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_favorit_tip"
        style="@style/ppStrokeButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
