<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/main_download_statement"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/main_select_trading_range"
                style="@style/txt_b_b_b"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/viewContainer"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:paddingHorizontal="@dimen/dp16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_types_of_services"
                    style="@style/txt_s_b_b"/>
                <LinearLayout
                    android:id="@+id/llBillType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tvType"
                        android:background="@drawable/main_bg_select_tag"
                        android:paddingLeft="@dimen/dp6"
                        android:paddingRight="@dimen/dp6"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:text="@string/main_all"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:paddingHorizontal="@dimen/dp6"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvTypeCustomize"
                        android:background="@drawable/main_bg_select_tag"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:text="@string/main_customize"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:gravity="center"
                        android:background="@drawable/cv_rect_corner_8_solid_bg_dark"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="@string/main_transaction_type"
                    style="@style/txt_s_b_b"/>
                <LinearLayout
                    android:id="@+id/viewIO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvIO"
                        android:tag="0"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:text="@string/main_all"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvMoneyIn"
                        android:tag="1"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:text="@string/main_money_in"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvMoneyOut"
                        android:tag="2"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:text="@string/main_money_out"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="@string/main_duration"
                    style="@style/txt_s_b_b"/>
                <LinearLayout
                    android:id="@+id/viewDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvLastMonth"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:text="@string/main_last_month"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tv3Month"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:text="@string/main_last_3_month"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/main_select_white_black"
                        android:gravity="center"
                        android:id="@+id/tvMonthCustomize"
                        android:background="@drawable/main_bg_select_tag"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:layout_marginLeft="@dimen/dp8"
                        android:text="@string/main_customize"
                        android:layout_weight="1"
                        style="@style/txt_s_b"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="@string/main_start_date"
                    style="@style/txt_s_b"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llStartDate"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_default_button_height"
                    android:layout_marginTop="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp16">
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvStartDate"
                        android:background="@color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:hint="@string/main_select_start_date"
                        android:layout_weight="1"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_Arrowdown"
                        app:iiv_size="16dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="@string/main_end_date"
                    style="@style/txt_s_b"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llStartEnd"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_default_button_height"
                    android:layout_marginTop="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp16">
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvEndDate"
                        android:background="@color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:hint="@string/main_select_end_date"
                        android:layout_weight="1"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_Arrowdown"
                        app:iiv_size="16dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="Export Information"
                    style="@style/txt_s_b"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llMyAddress"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_default_button_height"
                    android:layout_marginTop="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp16">
                    <com.mikepenz.iconics.view.IconicsCheckBox
                        android:id="@+id/checkAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text=" My Address"
                        android:drawablePadding="@dimen/dp40"
                        app:iiv_checked_color="@color/ppColorPrimary"
                        app:iiv_checked_icon="pay_CheckboxFill"
                        app:iiv_checked_size="@dimen/dp20"
                        app:iiv_unchecked_color="@color/ppColorTextAssist"
                        app:iiv_unchecked_icon="pay_CheckboxOutline"
                        app:iiv_unchecked_size="@dimen/dp20"
                        style="@style/Text.202046.12"/>
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvMyAddress"
                        android:background="@color/transparent"
                        android:paddingLeft="@dimen/dp2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:text="My Address"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_continue"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
</LinearLayout>
