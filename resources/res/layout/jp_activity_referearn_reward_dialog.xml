<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#020202"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/jarrd_lottie"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:layout_marginTop="@dimen/dp100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/jarrd_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp150"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/jarrd_pick_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/jp_pickcard_title"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="@dimen/dp32"
            android:textColor="#ff9a3a"
            android:gravity="center"
            android:id="@+id/jarrd_earn"
            android:background="@drawable/jp_earn_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp46"
            android:layout_marginTop="@dimen/dp6"
            android:layout_marginRight="@dimen/dp46"
            android:fontFamily="sans-serif-black"
            android:layout_marginHorizontal="@dimen/dp46"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/jarrd_pick_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp192"
            android:layout_marginLeft="@dimen/dp25"
            android:layout_marginRight="@dimen/dp25"
            android:divider="@drawable/cv_shape_transparent_h_divider_8"
            android:showDividers="middle"
            android:dividerPadding="@dimen/dp8"
            android:layout_marginHorizontal="@dimen/dp25">
            <RelativeLayout
                android:id="@+id/jarrd_pick_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textColor="#370e80"
                    android:gravity="center"
                    android:background="@drawable/jp_pick_me_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp28"
                    android:text="Pick Me"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/jarrd_pick_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textColor="#370e80"
                    android:gravity="center"
                    android:background="@drawable/jp_pick_me_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp28"
                    android:text="Pick Me"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/jarrd_pick_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textColor="#370e80"
                    android:gravity="center"
                    android:background="@drawable/jp_pick_me_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp28"
                    android:text="Pick Me"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/jarrd_cases_reward_one"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp90"
                android:textColor="#ff6b00"
                android:id="@+id/jarrd_reward_cases_one_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp60"
                android:fontFamily="sans-serif-black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp40"
                android:textColor="#b78fff"
                android:id="@+id/jarrd_reward_cases_one_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp100"
                android:fontFamily="sans-serif-black"
                android:layout_marginEnd="@dimen/dp20"
                app:layout_constraintEnd_toStartOf="@+id/jarrd_reward_cases_one_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp40"
                android:textColor="#b78fff"
                android:id="@+id/jarrd_reward_cases_one_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp100"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="@dimen/dp20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/jarrd_reward_cases_one_1"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/jarrd_cases_reward_two"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp40"
                android:textColor="#ff6b00"
                android:id="@+id/jarrd_reward_cases_two_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp95"
                android:fontFamily="sans-serif-black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp22"
                android:textColor="#b78fff"
                android:id="@+id/jarrd_reward_cases_two_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp110"
                android:fontFamily="sans-serif-black"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toStartOf="@+id/jarrd_reward_cases_two_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp22"
                android:textColor="#b78fff"
                android:id="@+id/jarrd_reward_cases_two_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp110"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/jarrd_reward_cases_two_1"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/jarrd_invite_claim_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp90">
            <TextView
                android:textColor="#370e80"
                android:gravity="center"
                android:id="@+id/jarrd_action_btn"
                android:background="@drawable/jp_pick_me_bg"
                android:layout_width="@dimen/dp200"
                android:layout_height="@dimen/dp35"
                android:text="@string/jp_invite_now"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/jarrd_invite_claim_auto_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/jp_this_will_automatically_close_in_s"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp30"
            app:iiv_color="@color/ppColorBackgroundLight"
            app:iiv_icon="pay_CloseOutline"
            app:iiv_size="20dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/jarrd_case_three"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp150"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/jarrd_case_three_img"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/dp25"
            android:textColor="@color/cv_color_ffbf13"
            android:id="@+id/jarrd_case_three_received"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp105"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-black"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
