<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/p2p_base"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="9dp"
        app:layout_constraintBottom_toTopOf="@+id/p2p_hour"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/p2p_shadow1"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/p2p_shadow_bg"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_hour"
        app:layout_constraintRight_toRightOf="@+id/p2p_hour"
        app:layout_constraintTop_toTopOf="@+id/p2p_base"/>
    <ImageView
        android:id="@+id/p2p_shadow2"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/p2p_shadow_bg"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_minute"
        app:layout_constraintRight_toRightOf="@+id/p2p_minute"
        app:layout_constraintTop_toTopOf="@+id/p2p_base"/>
    <ImageView
        android:id="@+id/p2p_shadow3"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/p2p_shadow_bg"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_second"
        app:layout_constraintRight_toRightOf="@+id/p2p_second"
        app:layout_constraintTop_toTopOf="@+id/p2p_base"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/p2p_hour"
        android:layout_width="33dp"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:elevation="20dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/p2p_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#aa202046"
        android:id="@+id/p2p_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginRight="19dp"
        android:text="@string/p2p_dot2"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_hour"
        app:layout_constraintLeft_toRightOf="@+id/p2p_hour"
        app:layout_constraintRight_toLeftOf="@+id/p2p_minute"
        app:layout_constraintTop_toTopOf="@+id/p2p_hour"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/p2p_minute"
        android:layout_width="33dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_hour"
        app:layout_constraintLeft_toRightOf="@+id/p2p_2"
        app:layout_constraintRight_toLeftOf="@+id/p2p_4"
        app:layout_constraintTop_toTopOf="@+id/p2p_hour"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#aa202046"
        android:id="@+id/p2p_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginRight="19dp"
        android:text="@string/p2p_dot2"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_hour"
        app:layout_constraintLeft_toRightOf="@+id/p2p_minute"
        app:layout_constraintRight_toLeftOf="@+id/p2p_second"
        app:layout_constraintTop_toTopOf="@+id/p2p_hour"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/p2p_second"
        android:layout_width="33dp"
        android:layout_height="36dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_hour"
        app:layout_constraintLeft_toRightOf="@+id/p2p_4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/p2p_hour"/>
    <com.transsnet.palmpay.p2pcash.ui.atm.view.ProgressLineView
        android:id="@+id/p2p_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_hour"
        app:layout_constraintRight_toRightOf="@+id/p2p_second"
        app:layout_constraintTop_toBottomOf="@+id/p2p_hour"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_shadow"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_hour"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_hour"
        app:layout_constraintRight_toRightOf="@+id/p2p_hour"
        app:layout_constraintTop_toTopOf="@+id/p2p_hour"/>
</androidx.constraintlayout.widget.ConstraintLayout>
