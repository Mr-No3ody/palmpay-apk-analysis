<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_apply_result_exit_dialog_close_icon"
        android:layout_marginEnd="@dimen/dp16"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cs_oc_apply_result_exit_dialog_content_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20">
        <TextView
            android:textSize="36sp"
            android:gravity="center"
            android:id="@+id/off_amount_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp25"
            android:text="@string/cs_oc_off_amount"
            style="@style/Text.medium.202046"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/bvn_content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_oc_expire_tomorrow"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp6"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_oc_as_soon_as_possible"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/use_tv"
            android:background="@drawable/cs_oc_apply_result_exit_dialog_use_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp80"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_oc_go_to_use"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/give_up_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/cs_oc_give_up_the_discount"
            android:layout_marginHorizontal="@dimen/dp24"/>
    </LinearLayout>
</LinearLayout>
