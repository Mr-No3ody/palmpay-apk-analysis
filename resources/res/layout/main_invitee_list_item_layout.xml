<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/invitee_photo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/invitee_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ff272a2d"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/invitee_name"
        android:paddingTop="17dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="10dp"
        app:layout_constraintLeft_toRightOf="@+id/invitee_photo"
        app:layout_constraintRight_toLeftOf="@+id/rewards_points"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ff95a1ab"
        android:id="@+id/invitee_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/invitee_photo"
        app:layout_constraintTop_toBottomOf="@+id/invitee_name"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/rewards_points"
        android:paddingTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/invitee_name"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/invitee_num"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
