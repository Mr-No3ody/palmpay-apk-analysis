<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/core_rect_corner_24_bg_00a49a"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorBackgroundLight"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_cl_migrate_coupon_desc_0"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_cl_migrate_coupon_desc_1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24">
        <ImageView
            android:id="@+id/iv_coupon_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp90"
            android:src="@drawable/cs_cl_migrate_interest_coupon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6d4e37"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_cl_migrate_coupon_sub_desc_0"
            android:layout_marginStart="38dp"
            app:layout_constraintStart_toStartOf="@+id/iv_coupon_bg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_migrate_coupon_sub_desc_1"
            android:layout_marginEnd="@dimen/dp14"
            app:layout_constraintEnd_toEndOf="@+id/iv_coupon_bg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#681612"
            android:id="@+id/tv_coupon_count_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_cl_migrate_coupon_desc_2"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_download"
        android:background="@drawable/cs_cl_migrate_interest_coupon_download_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp32"
        android:layout_marginTop="@dimen/dp45"
        android:layout_marginRight="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp45"
        android:text="@string/core_download"
        android:layout_marginHorizontal="@dimen/dp32"/>
</LinearLayout>
