<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/ivFlexiLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:src="@drawable/cs_oc_flexi_logo_with_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvCreditLimit"
        android:layout_marginTop="@dimen/dp11"
        android:text="@string/cs_oc_str_credit_limit"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivFlexiLogo"
        style="@style/Text.9ca2aa.12"/>
    <ImageView
        android:id="@+id/ivHelp"
        android:layout_width="@dimen/dp14"
        android:layout_height="@dimen/dp14"
        android:layout_marginLeft="@dimen/dp4"
        android:src="@drawable/cs_oc_setting_help_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tvCreditLimit"
        app:layout_constraintLeft_toRightOf="@+id/tvCreditLimit"
        app:layout_constraintTop_toTopOf="@+id/tvCreditLimit"/>
    <TextView
        android:textSize="36dp"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tvFlexiBalanceAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp11"
        android:text="₦10,000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCreditLimit"
        style="@style/txt_number_s_b_b"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/ppColorError"
        android:id="@+id/rtvFrozen"
        android:paddingLeft="@dimen/dp3"
        android:paddingRight="@dimen/dp3"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginLeft="@dimen/dp4"
        android:text="@string/cs_frozen"
        android:paddingHorizontal="@dimen/dp3"
        app:layout_constraintLeft_toRightOf="@+id/tvFlexiBalanceAmount"
        app:layout_constraintTop_toTopOf="@+id/tvFlexiBalanceAmount"
        app:rtv_background_color="@color/ppColorBackgroundLight"
        app:rtv_border_color="@color/ppColorError"
        app:rtv_border_width="@dimen/dp1"
        app:rtv_corner_radius="@dimen/dp4"
        style="@style/Text.202046.10"/>
    <TextView
        android:id="@+id/tvFrozenReason"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_repayment_late_than_due_date"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFlexiBalanceAmount"
        style="@style/Text.202046.12"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:id="@+id/tvPaymentDate"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFrozenReason"
        style="@style/Text.202046.12"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvApplyForUnfree"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_apply_for_unfreezing"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvPaymentDate"
        app:rtv_background_color="@color/cs_main_color"
        app:rtv_corner_radius="12dp"
        style="@style/Text.medium.ffffff.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
