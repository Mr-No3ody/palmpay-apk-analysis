<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="Feedback details"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/feedback_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#38d79f"
                    android:gravity="center"
                    android:id="@+id/feedback_status_tv"
                    android:background="@drawable/cs_oc_feedback_status_tv_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:paddingStart="@dimen/dp4"
                    android:paddingEnd="@dimen/dp4"
                    android:layout_marginStart="@dimen/dp9"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/user_avatar_img"
                    android:layout_width="@dimen/dp35"
                    android:layout_height="@dimen/dp35"
                    android:src="@drawable/cs_oc_feedback_user_icon"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/csUserAvatarImgStyle"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_feedback"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp10"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="center"
                    android:id="@+id/submit_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp5"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/cs_oc_feedback_content_bg"
                android:paddingTop="@dimen/dp18"
                android:paddingBottom="@dimen/dp22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:gravity="start"
                    android:id="@+id/feedback_content_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp11"
                    android:layout_marginEnd="@dimen/dp11"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/feedback_img_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp11"
                    android:layout_marginEnd="@dimen/dp11"/>
            </LinearLayout>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center_vertical"
                android:id="@+id/feedback_no_tv"
                android:background="@drawable/cs_oc_feedback_no_tv_bg"
                android:paddingTop="@dimen/dp10"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_feedback_no"
                android:drawablePadding="4dp"
                android:paddingStart="@dimen/dp18"
                android:paddingEnd="@dimen/dp18"
                android:layout_marginHorizontal="@dimen/dp16"
                app:iiv_end_color="@color/ppColorTextDisable"
                app:iiv_end_icon="pay_Copy"
                app:iiv_end_size="@dimen/dp12"/>
            <View
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/complete_fl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp36"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/dp35"
                        android:layout_height="@dimen/dp35"
                        android:src="@drawable/cv_ok_card_icon"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_feedback_replay"
                        android:layout_marginStart="@dimen/dp10"/>
                    <TextView
                        android:textSize="12sp"
                        android:gravity="center"
                        android:id="@+id/reply_time_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp2"
                        android:layout_marginStart="@dimen/dp5"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cs_oc_feedback_content_bg"
                    android:paddingTop="@dimen/dp18"
                    android:paddingBottom="@dimen/dp22"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:paddingStart="@dimen/dp18"
                    android:paddingEnd="@dimen/dp18"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/reply_content_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"/>
                    <ImageView
                        android:id="@+id/reply_img"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/dp16"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="@string/cs_problem_still_not_resolved"
                    android:lineSpacingMultiplier="1.3"/>
                <View
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textSize="14sp"
                    android:textColor="@color/cs_main_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/phone_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/cs_online_customer_service"
                    android:drawablePadding="4dp"
                    app:iiv_end_color="@color/cs_main_color"
                    app:iiv_end_icon="pay_CustomerService"
                    app:iiv_end_size="@dimen/dp16"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/cs_email_support"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
