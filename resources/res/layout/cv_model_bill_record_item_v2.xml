<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp70"
    android:paddingHorizontal="@dimen/dp16">
    <View
        android:id="@+id/view_bottom_divide"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/iv_item_icon"
        android:layout_width="@dimen/dp34"
        android:layout_height="@dimen/dp34"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/iv_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:background="@drawable/cv_shape_rect_corner_4_bg_086306b2_stroke_primary"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:text="@string/cv_book"
        android:layout_marginStart="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_item_title"
        app:layout_constraintStart_toEndOf="@+id/tv_item_title"
        style="@style/txt_mi_g"/>
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_item_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_title"
        style="@style/txt_mi_lg"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_state"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_state"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textColor="@color/text_color_gray4"
        android:id="@+id/tv_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount"
        style="@style/txt_mi_lgn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
