<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_icon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/lib_liveness_face_logo"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ppDialogTitleTextSize"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:paddingLeft="@dimen/ppDialogHorizontalMargin"
        android:paddingRight="@dimen/ppDialogHorizontalMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="@dimen/ppDialogHorizontalMargin"
        android:paddingEnd="@dimen/ppDialogHorizontalMargin"
        android:paddingHorizontal="@dimen/ppDialogHorizontalMargin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        style="@style/ppTextStyleT6"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tipsContainer"
        android:background="@drawable/lib_liveness_bg_green_tip"
        android:paddingLeft="6dp"
        android:paddingTop="8dp"
        android:paddingRight="6dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
        android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/lib_liveness_security_logo"
            android:tint="#1bc286"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#1bc286"
            android:gravity="start"
            android:id="@+id/tvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#6f7b85"
        android:gravity="center_vertical"
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
        android:lineSpacingExtra="4dp"
        android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tipsContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
