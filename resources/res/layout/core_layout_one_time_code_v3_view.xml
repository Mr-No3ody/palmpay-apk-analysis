<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="center_horizontal"
        android:id="@+id/smsCodeView"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="60dp"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="10dp"
        app:digitStrokeColor="@color/ppColorTextDisable"
        app:digitStrokeWidth="0.5dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="36dp"
        app:digitWidth="50dp"
        app:mask=""
        app:numDigits="4"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvInputError"
        android:paddingLeft="@dimen/dp20"
        android:paddingRight="@dimen/dp20"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/core_verification_incorrect"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp20"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp17"
        style="@style/txt_s_g"/>
    <TextView
        android:enabled="true"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewSendSms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp17"
        android:text="@string/core_send_sms"
        android:drawableLeft="@drawable/cv_message_blue"
        android:drawablePadding="6dp"
        style="@style/txt_s_b"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/llOthers"
        android:paddingLeft="@dimen/dp7"
        android:paddingRight="@dimen/dp7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp42"
        android:paddingHorizontal="@dimen/dp7">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_cant_receive_sms"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="center_horizontal"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp2"
            android:text="@string/core_get_code_via_other_methods"/>
    </LinearLayout>
    <com.wang.avi.AVLoadingIndicatorView
        android:layout_gravity="center_horizontal"
        android:id="@+id/loadingView"
        android:visibility="gone"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp42"
        app:indicatorColor="@color/ppColorPrimary"
        app:indicatorName="BallSpinFadeLoaderIndicator"
        style="@style/AVLoadingIndicatorView.Large"/>
</merge>
