<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:text="@string/core_early_refund_service_terms_and_conditions"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/core_divider_horizontal"/>
    <com.transsnet.palmpay.core.viewmodel.AndroidXWebView
        android:id="@+id/wv_protocol"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginBottom="@dimen/dp12"
        app:layout_constraintBottom_toTopOf="@+id/tv_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_confirm"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/txt_me_w"/>
</androidx.constraintlayout.widget.ConstraintLayout>
