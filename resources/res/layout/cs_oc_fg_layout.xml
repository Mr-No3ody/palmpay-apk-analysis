<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/oc_guide_fl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/oc_normal_ll"
        android:background="@color/cs_color_cl_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/oc_main_top_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/cs_oc_main_top_img"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/oc_main_top_sav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:slot_id="@string/oc_main_top_bg_slot_id"/>
        <LinearLayout
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/oc_main_top_ll"
                android:paddingTop="@dimen/dp40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp80"
                android:paddingStart="@dimen/dp24"
                android:paddingEnd="@dimen/dp24">
                <ImageView
                    android:id="@+id/left_arrow_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_oc_back_icon_black"
                    android:layout_marginEnd="@dimen/dp12"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/title_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableStart="@drawable/cs_oc_flex_icon"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/logo_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_ok_card"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="@dimen/dp14"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/right_menu_img"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp28"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_Setup"
                    app:iiv_size="24dp"/>
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/oc_nsv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/main_content_ll"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/top_tips_tv"
                            android:background="@drawable/cs_oc_finance_top_tips_bg"
                            android:padding="@dimen/dp12"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginTop="@dimen/dp28"
                            android:layout_marginRight="@dimen/dp16"
                            android:drawablePadding="@dimen/dp8"
                            android:drawableStart="@drawable/cs_oc_finance_tip_warn_icon"
                            android:drawableEnd="@drawable/cs_select_arrow_right"
                            android:layout_marginHorizontal="@dimen/dp16"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.transsnet.palmpay.credit.view.OcModelOkCard
                            android:id="@+id/oc_model_omoc"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp12"
                            android:layout_marginStart="@dimen/dp16"
                            android:layout_marginEnd="@dimen/dp16"
                            app:layout_constraintTop_toBottomOf="@+id/top_tips_tv"
                            app:layout_goneMarginTop="@dimen/dp28"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/menu_rv"
                        android:background="@drawable/cs_menu_bg"
                        android:paddingTop="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp98"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:text="@string/cs_oc_service"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"/>
                    <com.transsnet.palmpay.credit.view.FlexiPaymentMenuView
                        android:id="@+id/flexi_payment_menu_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        app:fpmv_businessType="Flexi"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/adView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"
                        app:slot_id="@string/oc_single_ad_slot_id"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ad_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16">
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/bottom_left_adView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/dp8"
                            app:slot_id="@string/oc_main_bottom_left_slot_id"/>
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/bottom_right_adView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/dp8"
                            app:slot_id="@string/oc_main_bottom_right_slot_id"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextDisable"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginBottom="@dimen/dp16"
                        android:text="@string/cs_oc_common_bottom_txt"
                        android:layout_marginVertical="@dimen/dp16"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
