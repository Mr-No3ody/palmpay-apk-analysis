<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:text="You’ll now earn daily interest"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose"
        app:layout_goneMarginTop="@dimen/dp24"
        style="@style/Text.medium.202046.20"/>
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="Money in your Wallet Balance has been transferred to your CashBox and any money sent to your PalmPay Balance will be instantly credited to your CashBox"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_goneMarginTop="@dimen/dp36"
        style="@style/Text.6f7b85.14"/>
    <ImageView
        android:id="@+id/ivContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:src="@drawable/mm_icon_auto_save_middle"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:divider="@drawable/cv_shape_transparent_h_divider_12"
        android:showDividers="middle"
        app:layout_constraintTop_toBottomOf="@+id/ivContent">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/rtvToCashBox"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Go to CashBox"
            android:layout_weight="1"
            style="@style/ppSecondaryButtonStyle"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/rtvConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/core_confirm"
            android:layout_weight="1"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
