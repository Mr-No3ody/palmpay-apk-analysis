<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/core_share_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_16_bg_dark"
        android:layout_width="match_parent"
        android:layout_height="328dp"
        android:layout_margin="@dimen/dp16">
        <EditText
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="#858a8f"
            android:gravity="start|top"
            android:id="@+id/editComment"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp140"
            android:layout_margin="@dimen/dp16"
            android:hint="@string/core_comment_hint"
            android:maxLength="300"
            android:fontFamily="sans-serif"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:id="@+id/tvCount"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            style="@style/txt_s_g"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGrabShareImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="2dp"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/btnPublish"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_publish"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toStartOf="@+id/btnDetails"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppButtonStyle"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <CheckBox
            android:id="@+id/cbAnonymous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/core_checkbox_selector_bg"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_anonymous"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp8"/>
    </LinearLayout>
</LinearLayout>
