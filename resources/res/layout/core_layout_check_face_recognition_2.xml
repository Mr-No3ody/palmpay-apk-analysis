<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:src="@drawable/cv_face_verify_fail"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="38dp"
        android:text="@string/core_title_face_verification_fail_1"
        android:layout_marginHorizontal="38dp"
        style="@style/ppTextStyleT4"/>
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="38dp"
        android:text="@string/core_msg_face_verification_fail_1"
        android:layout_marginHorizontal="38dp"
        style="@style/txt_s_g"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="38dp"
        android:text="@string/core_msg_face_verification_fail_2"
        android:layout_marginHorizontal="38dp"
        style="@style/txt_s_b_b"/>
    <TextView
        android:gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="38dp"
        android:text="@string/core_msg_face_verification_fail_3"
        android:drawableLeft="@drawable/cv_icon_phone_circle"
        android:drawablePadding="8dp"
        android:layout_marginHorizontal="38dp"
        style="@style/txt_s_b"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="38dp"
        android:text="@string/core_msg_face_verification_fail_4"
        android:drawableLeft="@drawable/cv_icon_add_contact"
        android:drawablePadding="8dp"
        android:layout_marginHorizontal="38dp"
        style="@style/txt_s_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/core_confirm"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/ppButtonStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/tvCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/core_cancel"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/ppSecondaryButtonStyle"/>
</LinearLayout>
