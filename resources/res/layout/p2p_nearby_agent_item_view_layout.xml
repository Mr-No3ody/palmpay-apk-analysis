<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/p2p_location_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_PositionFill"
        app:iiv_size="17dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_location_logo"
        app:layout_constraintLeft_toRightOf="@+id/p2p_location_logo"
        app:layout_constraintTop_toTopOf="@+id/p2p_location_logo"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_label"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="8dp"
        app:cardBackgroundColor="#effcf7"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:contentPaddingLeft="6dp"
        app:contentPaddingRight="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_time"
        app:layout_constraintLeft_toRightOf="@+id/p2p_time"
        app:layout_constraintTop_toTopOf="@+id/p2p_time">
        <TextView
            android:textSize="12sp"
            android:textColor="#38d79f"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p2p_str_recent"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/p2p_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@mipmap/p2p_unselect_img"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_location_logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/p2p_location_logo"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/p2p_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="48dp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_time"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#6f7b85"
        android:id="@+id/p2p_distance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/p2p_address"
        app:layout_constraintTop_toBottomOf="@+id/p2p_address"/>
    <View
        android:id="@+id/p2p_line"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_distance"/>
</androidx.constraintlayout.widget.ConstraintLayout>
