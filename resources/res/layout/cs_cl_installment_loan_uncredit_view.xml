<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivTitleIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivApprovalIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvContent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvContent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvContent"
        android:layout_marginLeft="@dimen/dp4"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintLeft_toRightOf="@+id/ivApprovalIcon"
        app:layout_constraintTop_toBottomOf="@+id/ivTitleIcon"
        app:layout_goneMarginLeft="0dp"
        app:layout_goneMarginTop="0dp"
        style="@style/Text.202046.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivRightArrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvContent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvContent"
        app:tint="@color/ppColorError"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvApply"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp24"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvRightContent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
