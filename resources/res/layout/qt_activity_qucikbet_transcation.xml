<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewBg"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp350"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintTop_toTopOf="@+id/viewBg"/>
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp44"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        app:layout_constraintTop_toTopOf="@+id/viewBg"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:textSize="@dimen/dp32"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.medium.202046.22"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
    <TextView
        android:id="@+id/tvNumberTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_customer_id"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintBottom_toTopOf="@+id/tvComplete"
        app:layout_constraintEnd_toStartOf="@+id/tvNumberValue"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        style="@style/Text.9ca2aa.14"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvNumberValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvNumberTitle"
        app:layout_constraintEnd_toStartOf="@+id/copyIv"
        app:layout_constraintStart_toEndOf="@+id/tvNumberTitle"
        style="@style/Text.202046.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/copyIv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp24"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Copy"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvNumberTitle"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintTop_toTopOf="@+id/tvNumberTitle"/>
    <TextView
        android:id="@+id/tvComplete"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_complete"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/viewBg"
        app:layout_constraintEnd_toEndOf="@+id/viewBg"
        app:layout_constraintStart_toStartOf="@+id/viewBg"
        style="@style/Text.medium.ffffff.16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gpNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="copyIv,tvNumberTitle,tvNumberValue"/>
</androidx.constraintlayout.widget.ConstraintLayout>
