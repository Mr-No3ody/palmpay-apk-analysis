<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ppColorBackgroundLight"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_booked_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_booking_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_payment_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_payment_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_change_label"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#fff8ec"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/p2p_i"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorWarning"
                    app:iiv_icon="pay_InformationOutline"
                    app:iiv_size="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/p2p_str_order_amount_changed_by_the_exchange_point"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_booking_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
            android:id="@+id/p2p_completion_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
