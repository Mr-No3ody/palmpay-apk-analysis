<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_oc_contact_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_otp_top_bar"
        layout="@layout/cs_oc_router_top_bar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.credit.view.OpenAccountRouterProgressViewV2
                android:id="@+id/router_progress_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#646970"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_oc_media_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp28">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:id="@+id/csTextview5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_social_media"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_medial_optional"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/csTextview5"
                    app:layout_constraintStart_toEndOf="@+id/csTextview5"
                    app:layout_constraintTop_toTopOf="@+id/csTextview5"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/social_contact_rv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview5"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#858a8f"
                    android:id="@+id/csTextview64"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/cs_account_number"
                    app:layout_constraintStart_toStartOf="@+id/social_contact_rv"
                    app:layout_constraintTop_toBottomOf="@+id/social_contact_rv"/>
                <EditText
                    android:gravity="center_vertical"
                    android:id="@+id/account_num_et"
                    android:background="@drawable/cs_oc_contact_et_bg"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp45"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="26dp"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:imeActionLabel="Done"
                    android:paddingStart="@dimen/dp15"
                    android:paddingEnd="@dimen/dp15"
                    android:layout_marginEnd="18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/csTextview64"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview64"/>
                <ImageView
                    android:id="@+id/social_contact_img"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_marginTop="18dp"
                    android:src="@drawable/cs_oc_contact_checked_icon"
                    android:layout_marginEnd="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginVertical="@dimen/dp16"/>
    <Button
        android:enabled="true"
        android:textSize="16sp"
        android:textColor="@color/cs_oc_contact_next_txt_color"
        android:layout_gravity="bottom"
        android:id="@+id/contact_next_bt"
        android:background="@drawable/cs_oc_contact_next_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/cs_oc_next"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
