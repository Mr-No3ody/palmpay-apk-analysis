<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/lib_ui_bg_top_corner_15_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppPickerTitleHeight"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_date_picker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppPickerTitleHeight"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="fill"
        app:tabIndicator="@null"
        app:tabIndicatorColor="@color/ppColorPrimary"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/pp_transparent"
        app:tabSelectedTextColor="@color/ppColorPrimary"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabTextColor="@color/ppColorTextAssist"/>
    <TextView
        android:textSize="@dimen/ppPickerTitleTextSize"
        android:textStyle="bold"
        android:textColor="#202046"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/ppPickerMarginHorizontal"
        app:layout_constraintBottom_toBottomOf="@+id/v_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_title"/>
    <include
        android:id="@+id/ly_title"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/lib_ui_layout_title"/>
    <View
        android:id="@+id/v_divider"
        android:background="#e2e8ed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppPickerDividerHeight"
        app:layout_constraintTop_toBottomOf="@+id/ly_title"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_date_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
