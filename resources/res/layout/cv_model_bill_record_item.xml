<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mbri_root"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp15"
    android:paddingRight="@dimen/dp15"
    android:layout_width="match_parent"
    android:layout_height="84dp">
    <View
        android:id="@+id/mbri_center_base_view"
        android:layout_width="1dp"
        android:layout_height="0.1dp"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/mbri_divide_view"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/mbri_iv"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp3"
        android:layout_marginRight="@dimen/dp3"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp20"
        android:layout_toLeftOf="@+id/mbri_trade_amount_tv"
        android:layout_toRightOf="@+id/mbri_iv"
        android:layout_toStartOf="@+id/mbri_trade_amount_tv"
        android:layout_toEndOf="@+id/mbri_iv">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/mbri_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tv_booked"
            android:background="@drawable/cv_shape_rect_corner_4_bg_086306b2_stroke_primary"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp16"
            android:text="@string/cv_book"
            android:layout_marginStart="@dimen/dp6"
            android:layout_toEndOf="@+id/mbri_title_tv"
            android:paddingHorizontal="@dimen/dp4"
            style="@style/txt_mi_g"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/mbri_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp11"
        android:layout_toRightOf="@+id/mbri_iv"
        android:layout_below="@+id/mbri_center_base_view"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="bottom|right"
        android:id="@+id/mbri_trade_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/extra_margin"
        android:layout_marginTop="@dimen/dp20"
        android:singleLine="true"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/text_color_gray4"
        android:id="@+id/mbri_trade_state_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="@dimen/dp13"
        android:layout_below="@+id/mbri_center_base_view"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
