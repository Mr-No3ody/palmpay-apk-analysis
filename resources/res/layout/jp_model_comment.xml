<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/parent"
        android:background="@drawable/cv_shape_rect_corner_20_bg_white"
        android:paddingTop="13dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/ivAvatar"
            android:background="@drawable/cv_ring_bg_1"
            android:padding="2dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/cv_avatar_default"
            android:scaleType="fitXY"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ivMark"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/cv_grab_crown"
            android:scaleType="fitXY"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:singleLine="true"
            android:layout_alignBottom="@+id/ivAvatar"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:layout_toStartOf="@+id/tvTime"
            android:layout_toEndOf="@+id/ivAvatar"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignBottom="@+id/ivAvatar"
            android:layout_alignParentEnd="true"
            style="@style/txt_mi_lg"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llPrize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/ivAvatar">
            <TextView
                android:textSize="@dimen/dp13"
                android:textColor="#666666"
                android:gravity="center_vertical"
                android:id="@+id/tvThePrize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jp_earned"
                android:fontFamily="sans-serif"
                android:paddingEnd="13dp"
                style="@style/txt_me_b"/>
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif-black"
                style="@style/txt_mi_g"/>
        </LinearLayout>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvComments"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/llPrize"
            style="@style/txt_s_b"/>
        <ImageView
            android:id="@+id/ivPic1"
            android:layout_width="93dp"
            android:layout_height="93dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/tvComments"/>
        <ImageView
            android:id="@+id/ivPic2"
            android:layout_width="93dp"
            android:layout_height="93dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/tvComments"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/ivPic1"/>
        <ImageView
            android:id="@+id/ivPic3"
            android:layout_width="93dp"
            android:layout_height="93dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/tvComments"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/ivPic2"/>
    </RelativeLayout>
</FrameLayout>
