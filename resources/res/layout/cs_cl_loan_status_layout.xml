<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp28">
    <TextView
        android:textColor="@color/cv_color_906948"
        android:id="@+id/tvInstallmentAmount"
        android:drawableLeft="@drawable/cs_cl_shape_loan_installment_status_dot"
        android:drawablePadding="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <TextView
        android:textColor="@color/cv_color_906948"
        android:id="@+id/tvRepayTerms"
        android:layout_marginLeft="@dimen/dp10"
        android:drawableLeft="@drawable/cs_cl_shape_loan_installment_status_dot"
        android:drawablePadding="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tvInstallmentAmount"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupValid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvInstallmentAmount,tvRepayTerms"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/ppColorError"
        android:id="@+id/rtvStatus"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_border_color="@color/ppColorError"
        app:rtv_border_width="@dimen/dp1"
        app:rtv_corner_radius="4dp"
        style="@style/Text.202046.10"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvStatusDesc"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rtvStatus"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.9ca2aa.12"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupInvalid"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rtvStatus,tvStatusDesc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
