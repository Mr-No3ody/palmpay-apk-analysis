<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/core_default_repayment_card"/>
    <include
        android:id="@+id/default_card_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp98"
        layout="@layout/main_bank_card_account_item_layout"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/bank_card_or_account_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
