<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/footer_view"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/footer_view_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/footer_view_progressbar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/ppColorPrimary"
            style="?android:attr/progressBarStyleSmallInverse"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/footer_view_loading_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_loading"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/footer_view_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
</RelativeLayout>
