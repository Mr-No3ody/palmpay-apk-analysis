<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp20">
    <ImageView
        android:id="@+id/iv_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/core_ic_clock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/core_bg_browse"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_clock">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/progress_bar_second"
            android:clickable="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/dp68"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:maxHeight="@dimen/dp4"
            android:progressDrawable="@drawable/core_background_progress_style1"
            android:minHeight="@dimen/dp4"
            android:thumb="@null"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            app:layout_constrainedHeight="true"
            app:splitTrack="false"/>
        <TextView
            android:id="@+id/tv_browse_second"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3"
            android:includeFontPadding="false"
            style="@style/Text.6f7b85.10"/>
    </LinearLayout>
</merge>
