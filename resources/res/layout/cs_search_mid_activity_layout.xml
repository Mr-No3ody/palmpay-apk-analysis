<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/cs_input_module"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/ppColorBackgroundDark"
        app:cardCornerRadius="12sp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/cs_cancel_btn"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#858a8f"
            android:layout_gravity="center_vertical"
            android:id="@+id/cs_hint_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="@string/cs_enter_8_numbers_id"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14sp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/cs_input_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="18sp"
                android:id="@+id/cs_cursor"
                android:background="#202046"
                android:layout_width="2dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cs_clear_input"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_circle_gray_cross"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#858a8f"
        android:gravity="center"
        android:id="@+id/cs_cancel_btn"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/cs_str_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cs_input_module"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cab_recent_tx"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16sp"
        android:layout_marginTop="12dp"
        android:text="@string/cs_past_merchants"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_input_module"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cab_recent_shop_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cab_recent_tx"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/cs_scan_merchant_qr_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:text="@string/cs_str_scan_qr_code"
        android:drawablePadding="8dp"
        app:iiv_start_color="@color/ppColorTextPrimary"
        app:iiv_start_icon="pay_Scan"
        app:iiv_start_size="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/cai_keyboard_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
        android:id="@+id/cai_keyboard_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
