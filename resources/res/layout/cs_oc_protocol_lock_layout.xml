<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/oc_lock_sad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:slot_id="@string/oc_lock_ad_slot_id"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:text="@string/cs_oc_proto_repayment_date"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cs_oc_proto_lock_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cs_main_color"
                    android:id="@+id/csTextview68"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/cs_oc_proto_first"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@+id/csGuideline3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cs_main_color"
                    android:id="@+id/csTextview89"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_proto_sixteen"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="@+id/csTextview68"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/csGuideline3"
                    app:layout_constraintTop_toTopOf="@+id/csTextview68"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#858a8f"
                    android:gravity="center"
                    android:id="@+id/csTextview91"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="20dp"
                    android:text="@string/cs_sixteen_to_the_end_of_the_month"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/csGuideline3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview68"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#858a8f"
                    android:gravity="center"
                    android:id="@+id/csTextview99"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/cs_first_to_fifteen_of_the_month"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/csGuideline3"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview89"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/csGuideline3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cs_oc_security_plugin_effect"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cs_oc_proto_lock_bg"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12">
                <ImageView
                    android:id="@+id/csImageview33"
                    android:layout_width="@dimen/dp32"
                    android:layout_height="@dimen/dp32"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="32dp"
                    app:layout_constraintEnd_toStartOf="@+id/csImageview32"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/cs_oc_water_mark_img"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/csTextview15"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cs_water_mark"
                    app:layout_constraintEnd_toEndOf="@+id/csImageview33"
                    app:layout_constraintStart_toStartOf="@+id/csImageview33"
                    app:layout_constraintTop_toBottomOf="@+id/csImageview33"/>
                <ImageView
                    android:id="@+id/csImageview32"
                    android:layout_width="@dimen/dp32"
                    android:layout_height="@dimen/dp32"
                    app:layout_constraintBottom_toBottomOf="@+id/csImageview33"
                    app:layout_constraintEnd_toStartOf="@+id/phone_img"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/csImageview33"
                    app:layout_constraintTop_toTopOf="@+id/csImageview33"
                    app:srcCompat="@drawable/cs_oc_push_img"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/csTextview11"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cs_oc_push"
                    app:layout_constraintEnd_toEndOf="@+id/csImageview32"
                    app:layout_constraintStart_toStartOf="@+id/csImageview32"
                    app:layout_constraintTop_toBottomOf="@+id/csImageview32"/>
                <ImageView
                    android:id="@+id/phone_img"
                    android:layout_width="@dimen/dp32"
                    android:layout_height="@dimen/dp32"
                    android:src="@drawable/cs_oc_phone_call_img"
                    android:layout_marginStart="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/csImageview32"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/csImageview32"
                    app:layout_constraintTop_toTopOf="@+id/csImageview32"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/phone_call_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cs_oc_phone_call"
                    app:layout_constraintEnd_toEndOf="@+id/phone_img"
                    app:layout_constraintStart_toStartOf="@+id/phone_img"
                    app:layout_constraintTop_toBottomOf="@+id/phone_img"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#858a8f"
                    android:id="@+id/effect_bottom_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_the_repayment_reminder"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview15"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:text="@string/cs_oc_reminder_service_effect"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cs_oc_proto_lock_bg"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/notification_content_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_limit_follow_function"
                    android:lineSpacingExtra="@dimen/dp5"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#858a8f"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/cs_develop_mode"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#858a8f"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp7"
                    android:text="@string/cs_factory_default_setting"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/install_tips_ll"
        android:background="#faf0d8"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3"
            android:src="@drawable/cs_cl_install_pt_tips_icon"/>
        <TextView
            android:textColor="@color/ppColorWarning"
            android:id="@+id/install_tips_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_before_apply_flexi"
            android:layout_marginStart="@dimen/dp5"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/csView14"
            android:background="@drawable/cs_oc_proto_bottom_img"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <CheckBox
                    android:id="@+id/oc_proto_cb"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="@drawable/cs_oc_check_ibt_bg"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/oc_proto_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_i_agree_to"
                    android:lineSpacingExtra="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/oc_proto_cb"
                    app:layout_constraintTop_toTopOf="@+id/oc_proto_cb"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/bottom_view"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                style="@style/Widget.AppCompat.Button.Borderless">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/install_again_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textSize="16sp"
                        android:textColor="@color/cs_main_color"
                        android:layout_gravity="center"
                        android:id="@+id/install_again_bt"
                        android:background="@drawable/cs_oc_install_again_bt_bg"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp44"
                        android:text="@string/cs_oc_install_again"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.AppCompat.Button.Borderless"/>
                    <Button
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextBase"
                        android:layout_gravity="center"
                        android:id="@+id/apply_other_way_bt"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp44"
                        android:text="@string/cs_apply_in_other_way"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.AppCompat.Button.Borderless"/>
                </LinearLayout>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center"
                    android:id="@+id/install_bt"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp44"
                    android:text="@string/cs_install_reminder"
                    android:drawablePadding="@dimen/dp8"
                    android:textAllCaps="false"
                    android:drawableEnd="@drawable/cs_oc_install_pt_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/oc_proto_tv"
                    style="@style/Widget.AppCompat.Button.Borderless"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center"
                    android:id="@+id/next_bt"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    android:text="@string/cs_oc_active_overdraft"
                    android:drawablePadding="@dimen/dp8"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/oc_proto_tv"
                    style="@style/Widget.AppCompat.Button.Borderless"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/white_list_cl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center"
                    android:id="@+id/install_pt_tv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                    android:paddingTop="@dimen/dp16"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_oc_quick_access_with_reminder"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#f9fafb"
                    android:id="@+id/limit_label_tv"
                    android:background="@drawable/cs_corner_4_4_4_0_bg_ffaa0c"
                    android:paddingTop="@dimen/dp2"
                    android:paddingBottom="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_higher_limit"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/dp4"
                    android:paddingEnd="@dimen/dp4"
                    app:layout_constraintBottom_toTopOf="@+id/install_pt_tv"
                    app:layout_constraintEnd_toEndOf="@+id/install_pt_tv"
                    app:layout_constraintTop_toTopOf="@+id/install_pt_tv"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/cs_main_color"
                    android:gravity="center"
                    android:id="@+id/install_no_pt_tv"
                    android:background="@drawable/cs_oc_install_again_bt_bg"
                    android:paddingTop="@dimen/dp16"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:layout_marginBottom="@dimen/dp12"
                    android:text="@string/cs_oc_normal_process_without_reminder"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/install_pt_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
