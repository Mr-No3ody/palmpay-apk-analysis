<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="483dp">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/cs_double_cash_retain_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="210dp"
            android:text="@string/cs_time_limited_loan_discount"
            android:fontFamily="sans-serif-black"/>
        <com.transsnet.palmpay.credit.ui.view.TextCountDownView
            android:layout_gravity="center"
            android:id="@+id/countDownView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/btnTv"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp70"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp70"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/core_ok1"
            android:layout_marginHorizontal="@dimen/dp70"
            style="@style/ppRoundFlexiCashButtonStyle"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp110"
        android:layout_marginEnd="@dimen/dp45"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/md_white_1000"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
</RelativeLayout>
