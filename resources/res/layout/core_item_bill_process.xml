<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/cwb_time_line_container"
        android:layout_width="@dimen/dp20"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_alignTop="@+id/ciei_info_area"
        android:layout_alignBottom="@+id/ciei_info_area">
        <View
            android:id="@+id/cib_Line"
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="@dimen/dp1"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/cib_checkiv"
            android:layout_width="@dimen/dp17"
            android:layout_height="@dimen/dp17"
            android:src="@drawable/cv_check_green"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ciei_info_area"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_toRightOf="@+id/cwb_time_line_container">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/cib_ExpressageTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginEnd="@dimen/dp15"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextDisable"
            android:ellipsize="end"
            android:id="@+id/cib_TimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="6"
            android:layout_marginEnd="@dimen/dp15"/>
    </LinearLayout>
</RelativeLayout>
