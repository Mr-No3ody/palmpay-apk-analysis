<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"/>
    <RelativeLayout
        android:id="@+id/bank_content"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="3dp"
        android:layout_marginHorizontal="3dp">
        <ImageView
            android:id="@+id/card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cv_shape_rect_corner_8_bg_gray_padding_lr_12_tb_6"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp6"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp6">
            <ImageView
                android:id="@+id/bank_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextBase"
                android:ellipsize="end"
                android:id="@+id/tvVerified"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp15"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="@dimen/dp14"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:layout_toLeftOf="@+id/tvVerified"
                android:layout_toRightOf="@+id/bank_icon">
                <TextView
                    android:textColor="@color/ppColorTextBase"
                    android:ellipsize="end"
                    android:id="@+id/bank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/txt_me_b_b"/>
                <TextView
                    android:id="@+id/bank_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    style="@style/txt_s_w"/>
                <TextView
                    android:textSize="10dp"
                    android:gravity="center_vertical"
                    android:id="@+id/tvDefaultCard"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_default_text"
                    android:drawableLeft="@drawable/cv_default_card_small"
                    android:drawablePadding="2dp"
                    style="@style/txt_mi_w"/>
                <TextView
                    android:textSize="10dp"
                    android:gravity="center_vertical"
                    android:id="@+id/tvCardType"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/txt_mi_w"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <include
        android:id="@+id/layoutDefault"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="@dimen/dp15"
        layout="@layout/main_layout_bank_card_deail_menu_item"/>
    <include
        android:id="@+id/layoutAuthentication"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="@dimen/dp15"
        layout="@layout/main_layout_bank_card_deail_menu_item"/>
    <include
        android:id="@+id/layoutDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="@dimen/dp15"
        layout="@layout/main_layout_bank_card_deail_menu_item"/>
</LinearLayout>
