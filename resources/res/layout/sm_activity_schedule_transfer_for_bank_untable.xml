<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/cv_shape_rectangle_gradient_disabled_to_transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp410"
        android:scaleType="matrix"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sm_bg_schedule_transfer_for_bank_unstable"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/fl_bottom"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:maxLines="1"
                style="@style/txt_b_b_b"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_top_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                style="@style/Text.202046.12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:id="@+id/tv_recipient_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_recipient_account"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.14"/>
                <EditText
                    android:textColorHint="@color/text_color_gray4"
                    android:gravity="center_vertical"
                    android:id="@+id/et_bank_account"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:hint="@string/sm_enter_10_digit_account_number"
                    android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
                    android:digits="0123456789"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_recipient_account"
                    style="@style/txt_me_b_b"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/iiv_bank_beneficiary"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_Addressbook"
                    app:layout_constraintBottom_toBottomOf="@+id/et_bank_account"
                    app:layout_constraintEnd_toEndOf="@+id/et_bank_account"
                    app:layout_constraintTop_toTopOf="@+id/et_bank_account"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/et_bank_account"/>
                <ImageView
                    android:id="@+id/iv_bank"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/med_account"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_bank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_bank"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/iv_bank"
                    app:layout_constraintTop_toTopOf="@+id/iv_bank"
                    app:layout_constraintWidth_default="wrap"
                    style="@style/Text.medium.202046.16"/>
                <View
                    android:id="@+id/v_divider_bank"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_bank"
                    style="@style/core_divider_horizontal"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/v_divider_bank">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_recipient_loading"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp34"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16">
                        <com.wang.avi.AVLoadingIndicatorView
                            android:layout_gravity="center"
                            android:id="@+id/indicatorView"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            app:indicatorColor="@color/ppColorPrimary"
                            app:indicatorName="BallSpinFadeLoaderIndicator"
                            style="@style/AVLoadingIndicatorView.Large"/>
                        <TextView
                            android:id="@+id/tv_loading_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sm_looking_for_this_user_name"
                            android:layout_marginStart="@dimen/dp8"
                            style="@style/txt_mi_lg"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_recipient_name"
                        android:background="@drawable/cv_shape_halfround_background_dark"
                        android:paddingTop="@dimen/dp7"
                        android:paddingBottom="@dimen/dp7"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp16"
                        android:minHeight="@dimen/dp34"
                        android:paddingStart="@dimen/dp12"
                        android:paddingEnd="@dimen/dp14"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingVertical="@dimen/dp7">
                        <ImageView
                            android:id="@+id/iv_query_status"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"/>
                        <TextView
                            android:id="@+id/tv_recipient_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp8"
                            style="@style/txt_s_b_b"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:id="@+id/tv_transfer_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_transfer_amount"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.14"/>
                <ImageView
                    android:id="@+id/iv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp14"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="@dimen/dp3"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_transfer_amount"
                    app:layout_constraintStart_toEndOf="@+id/tv_transfer_amount"/>
                <TextView
                    android:id="@+id/tv_transfer_amount_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sm_money_will_be_only_deducted_at_actual_transfer_time"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_transfer_amount"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:id="@+id/tv_currency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_currency_char_nig"
                    app:layout_constraintBottom_toBottomOf="@+id/et_amount"
                    app:layout_constraintStart_toStartOf="@+id/tv_transfer_amount_tip"
                    app:layout_constraintTop_toTopOf="@+id/et_amount"
                    style="@style/Text.medium.202046.16"/>
                <com.transsnet.palmpay.custom_view.StateAmountEditText
                    android:textSize="@dimen/dp28"
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_amount"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp56"
                    android:minWidth="20dp"
                    android:includeFontPadding="false"
                    android:maxLength="@integer/sm_amount_edit_text_max_length"
                    android:inputType="numberDecimal"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_currency"
                    app:layout_constraintTop_toBottomOf="@+id/tv_transfer_amount_tip"
                    style="@style/txt_number_me_b_b"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/et_amount"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_payment_method"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/tv_payment_tip"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fl_bottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:gravity="start"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_bottom_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:paddingStart="@dimen/dp2"
            app:drawableStartCompat="@drawable/sm_ic_schedule_transfer_for_bank_unstable_bottom_tip"
            app:drawableTint="@color/ppColorPrimary"
            style="@style/Text.6306b2.12"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_confirm"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/sm_no_available_payment_method"
            android:layout_marginVertical="@dimen/dp12"
            style="@style/txt_b_w"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
