<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/dp24"
    android:paddingRight="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp24">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_24_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:paddingTop="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp24"
            android:paddingEnd="@dimen/dp12">
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/ivClose"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:src="@drawable/cv_close_grey"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp16">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_login_device_inconsistency_title"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/cs_login_device_inconsistency_message"
                android:lineSpacingMultiplier="1.3"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llDeviceInfo"
                android:background="@drawable/cv_shape_rect_corner_12_bg_f6f6fa"
                android:padding="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvDeviceModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvImei"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llWarning"
                android:background="@drawable/cv_shape_rect_corner_8_bg_fff0f0"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp4"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp4">
                <ImageView
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:src="@drawable/cs_cl_ic_warning_fill"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_login_device_inconsistency_warning"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp4"/>
            </LinearLayout>
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/btnGotIt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_got_it"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
