<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="right"
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:src="@drawable/cs_oc_finance_tip_warn_icon_black"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/tvTitle"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_flexi_overdue"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tvContent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_borrow_when_flexi_bill_overdue"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/Text.6f7b85.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvRepay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_repay"
        android:layout_marginHorizontal="@dimen/dp24"
        app:rtv_background_color="@color/ppColorFlexiCashPrimary"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvBottomTips"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_settle_flexi_bill_palmpay"
        style="@style/Text.medium.9ca2aa.16"/>
</LinearLayout>
