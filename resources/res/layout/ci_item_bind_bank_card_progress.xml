<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_progress"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:src="@drawable/cv_check_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_divider_left"
        android:background="@color/ppColorSuccess"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_progress"
        app:layout_constraintEnd_toStartOf="@+id/iv_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_progress"
        style="@style/core_divider_horizontal"/>
    <View
        android:id="@+id/v_divider_right"
        android:background="@color/ppColorSuccess"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_progress"
        app:layout_constraintTop_toTopOf="@+id/iv_progress"
        style="@style/core_divider_horizontal"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_progress"
        android:layout_width="@dimen/dp80"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_progress"
        style="@style/Text.202046.12"/>
    <ImageView
        android:id="@+id/iv_bubble_triangle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:src="@drawable/ci_ic_triangle_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
