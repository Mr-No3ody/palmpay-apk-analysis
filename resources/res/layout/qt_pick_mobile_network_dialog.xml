<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_dialog_top_left_right_corner_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/qp_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        app:layout_constraintTop_toTopOf="parent">
        <com.transsnet.palmpay.custom_view.StateImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp15"
            android:src="@drawable/cv_close_grey"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp15"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/ivTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_select_mobile_network"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/qp_v1"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@+id/qp_rl"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/qpm_network_list"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/qp_v1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
