<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewOrderAmountItem"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp20"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp28"
    android:paddingHorizontal="@dimen/dp12">
    <TextView
        android:gravity="start"
        android:id="@+id/tvAmountKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_amount"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tvAmountLineValue"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/dp4"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/amountUnitLayout"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/tvAmountKey"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.9ca2aa.14"/>
    <com.transsnet.palmpay.core.ui.widget.AmountUnitLayout
        android:id="@+id/amountUnitLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
