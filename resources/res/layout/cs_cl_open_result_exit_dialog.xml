<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cs_cl_open_result_dialog_bg"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp50"
        android:paddingHorizontal="@dimen/dp24">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp53"
            android:text="@string/cs_cl_you_want_to_quite"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/quite_dialog_content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"/>
        <Button
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/borrow_now_bt"
            android:background="@drawable/core_rect_corner_12_bg_00a49a"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_cl_borrow_now"
            android:textAllCaps="false"
            style="@style/Widget.AppCompat.Button.Borderless"/>
        <Button
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/stop_discount"
            android:background="@android:color/transparent"
            android:paddingBottom="@dimen/dp18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:minHeight="0dp"
            android:text="@string/cs_cl_stop_discount"
            android:textAllCaps="false"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_cl_open_result_dialog_top_img"/>
</FrameLayout>
