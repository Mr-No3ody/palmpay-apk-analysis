<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivLabelIcon"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp21"
        app:iiv_color="@color/ppColorFlexiPrimary"
        app:iiv_icon="pay_LoanFill"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintEnd_toStartOf="@+id/tvLabel"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorSecondary"
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivLabelIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivLabelIcon"
        app:layout_constraintTop_toTopOf="@+id/ivLabelIcon"
        style="@style/Text.medium.6306b2.12"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp18"
        android:layout_marginRight="@dimen/dp16"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLabel"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp16"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp14"
        android:gravity="center"
        android:id="@+id/btnAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp22"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubTitle"
        style="@style/ppRoundFlexiCashButtonStyle"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:gravity="center"
        android:id="@+id/tvExpireBadge"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:paddingLeft="@dimen/dp6"
        android:paddingRight="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="-10dp"
        android:includeFontPadding="false"
        android:backgroundTint="@color/ppColorWarning"
        android:paddingHorizontal="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="@+id/btnAction"
        app:layout_constraintTop_toTopOf="@+id/btnAction"
        style="@style/Text.medium.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
