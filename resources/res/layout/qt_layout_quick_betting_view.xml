<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp12">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llTabs"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp28"
        android:layout_marginEnd="@dimen/dp14"
        app:layout_constraintEnd_toStartOf="@+id/ivArrowRight"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ivArrowRight"
        android:background="@drawable/cv_shape_circle_dark_bg"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp5"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="12dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/itemRy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp80"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginBottom="@dimen/dp4"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
