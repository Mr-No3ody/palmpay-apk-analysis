<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layoutLlDowntimeNotice"
    android:background="@drawable/cv_rect_corner_8_bg_f7fffb"
    android:paddingLeft="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp32"
    android:paddingHorizontal="@dimen/dp12">
    <TextView
        android:textColor="@color/ppColorSuccess"
        android:gravity="center_vertical"
        android:id="@+id/tv_downtime_order_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/txt_mi_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_arrow_right"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        app:iiv_color="@color/ppColorSuccess"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp16"/>
</LinearLayout>
