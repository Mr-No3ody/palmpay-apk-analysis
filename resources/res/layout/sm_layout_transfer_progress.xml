<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_result_status_tips"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_progress_tips"
        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
        android:padding="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:id="@+id/tv_early_refund_title"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_2_hours_assurance"
            android:drawablePadding="@dimen/dp4"
            android:drawableStart="@drawable/cv_ic_early_refund"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.12"/>
        <TextView
            android:id="@+id/tv_early_refund_checked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_in_effect"
            android:drawablePadding="@dimen/dp4"
            android:drawableStart="@drawable/cv_check_gray_c0c3c8"
            android:drawableTint="#1bc286"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_early_refund_title"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Text.202046.12"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/g_early_refund"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_early_refund_checked,tv_early_refund_title"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_progress_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/tv_early_refund_title"
            style="@style/Text.6f7b85.10"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
