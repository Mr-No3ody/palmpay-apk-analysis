<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/accountTopModule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_home_page_account_bar_ng"/>
    <View
        android:id="@+id/viewGap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/accountTopModule"/>
    <include
        android:id="@+id/accountBottomModule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewGap"
        layout="@layout/main_home_page_account_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
