<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="true"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorWarning"
        app:iiv_icon="pay_WarningFill"
        app:iiv_size="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon"
        style="@style/txt_bb_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dp16"
        android:lineSpacingExtra="2dp"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_mi_g"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/viewContainer"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvMsg">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/viewInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewGuardianInfo"
            android:background="@drawable/cv_shape_rect_corner_12_bg_white_stroke_dark_line"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp16">
            <ImageView
                android:id="@+id/ivIcon1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/cv_palmpay_icon_gray"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toTopOf="@+id/tv12"
                app:layout_constraintEnd_toStartOf="@+id/tv13"
                app:layout_constraintStart_toEndOf="@+id/ivIcon1"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_b"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv13"
                app:layout_constraintStart_toEndOf="@+id/ivIcon1"
                style="@style/txt_s_g"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:gravity="center_vertical"
                android:id="@+id/tv13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_g"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ac_reauthorize"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnChange"
        style="@style/ppButtonStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="14dp"
        android:gravity="center"
        android:id="@+id/btnChange"
        android:layout_width="0dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ac_change_guardian"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toStartOf="@+id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppSecondaryButtonStyle"/>
    <ViewStub
        android:id="@+id/bottomViewStub"
        android:layout="@layout/cv_layout_login_register_bottom_view"
        android:inflatedId="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
