<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bank_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/add_card_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/add_card_container"
        android:background="@color/cv_color_ffffff"
        android:paddingLeft="24dp"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="24dp"
        android:paddingBottom="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/iv_add_card"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            style="@style/Text.medium.ffffff.16"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_card_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="add_card_container,rv_bank_card"/>
    <FrameLayout
        android:id="@+id/fl_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
