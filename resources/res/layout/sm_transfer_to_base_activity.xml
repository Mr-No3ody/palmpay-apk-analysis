<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/sm_transfer"/>
    <androidx.core.widget.NestedScrollView
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomView"
        android:layout_below="@+id/title_bar">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/viewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/infoView"
                android:background="#f5f5f5"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/animView"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="1dp"
                    android:layout_alignParentEnd="true"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false"/>
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="40dp"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/iv_auth"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/sm_real_name_homepage"
                    android:layout_alignBottom="@+id/avatar"
                    android:layout_alignEnd="@+id/avatar"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxWidth="224dp"
                    android:layout_below="@+id/avatar"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:id="@+id/iv_user_type"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cv_sm_ic_send_merchant_tag"
                    android:layout_toRightOf="@+id/name"
                    android:layout_alignTop="@+id/name"
                    android:layout_alignBottom="@+id/name"
                    android:layout_marginStart="@dimen/dp4"
                    style="@style/txt_s_b"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/tv_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp36"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="@dimen/dp36"
                    android:layout_marginBottom="58dp"
                    android:layout_below="@+id/name"
                    android:layout_centerHorizontal="true"
                    android:layout_marginHorizontal="@dimen/dp36"/>
                <ImageView
                    android:id="@+id/iv_relationship"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp12"
                    android:scaleType="fitXY"
                    android:layout_marginStart="@dimen/dp12"
                    android:layout_marginEnd="@dimen/dp12"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/sm_top_left_right_corner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <TextView
                        android:textSize="30dp"
                        android:textColor="#ff010111"
                        android:id="@+id/currency_tv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.transsnet.palmpay.custom_view.StateAmountEditText
                        android:textSize="30dp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:textColorHint="@color/ppColorTextDisable"
                        android:gravity="center"
                        android:id="@+id/transfer_money_et"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0dp"
                        android:minWidth="20dp"
                        android:maxLength="@integer/sm_amount_edit_text_max_length"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
                <View
                    android:background="#f4f4f6"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="24dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cl_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:minWidth="133dp"
                    android:minHeight="@dimen/dp40"
                    android:layout_marginHorizontal="@dimen/dp24">
                    <EditText
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center_vertical"
                        android:id="@+id/et_note"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp7"
                        android:paddingRight="@dimen/dp10"
                        android:paddingBottom="@dimen/dp7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="133dp"
                        android:minHeight="@dimen/dp40"
                        android:maxLength="200"
                        android:layout_toLeftOf="@+id/tv_note_length"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingHorizontal="@dimen/dp10"
                        android:paddingVertical="@dimen/dp7"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_note_length"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tv_note_length"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sm_note_length"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/g_edit_note"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="et_note"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_note_hint"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:layout_width="133dp"
                        android:layout_height="0dp"
                        android:text="@string/sm_add_a_note"
                        android:drawablePadding="4dp"
                        android:paddingStart="@dimen/dp20"
                        app:iiv_start_color="@color/ppColorTextDisable"
                        app:iiv_start_icon="pay_Edit"
                        app:iiv_start_size="@dimen/dp24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_lg"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomView"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:textSize="12dp"
            android:textColor="#646970"
            android:id="@+id/balance_cb"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:checked="false"
            android:button="@drawable/sm_checkbox_selector"
            android:text="@string/sm_available_balance_one_format"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#646970"
            android:id="@+id/balance_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:text="@string/sm_available_balance"/>
        <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
            android:id="@+id/keyboard_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"/>
    </LinearLayout>
</RelativeLayout>
