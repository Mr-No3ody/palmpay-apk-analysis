<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="156dp"
        android:layout_height="wrap_content"
        android:src="@drawable/main_welcome_back_coupon_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/text1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_b_b"/>
    <TextView
        android:textSize="@dimen/dp32"
        android:textColor="#202046"
        android:gravity="center"
        android:id="@+id/text2"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="10dp"
        android:textFontWeight="700"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toBottomOf="@+id/text1"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/cv_rect_round_corner_bg_ffdb5a"
        android:layout_width="129dp"
        android:layout_height="@dimen/dp28"
        android:layout_marginBottom="@dimen/dp6"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"/>
    <ImageView
        android:id="@+id/iv_hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/main_rewards_hot_2"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="@+id/ivBg"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="7dp"
        app:layout_constraintTop_toBottomOf="@+id/ivBg"/>
    <ImageView
        android:id="@+id/ivFinger"
        android:visibility="invisible"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp6"
        android:src="@drawable/cv_rewards_finger"
        app:layout_constraintEnd_toEndOf="@+id/btn"
        app:layout_constraintTop_toTopOf="@+id/btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
