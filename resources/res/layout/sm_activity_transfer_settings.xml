<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/sm_transfer_settings"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsCard"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp104"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/limitSettingsRow"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="start"
                android:id="@+id/limitSettingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sm_limit_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/limitSettingsArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/limitSettingsArrow"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_ArrowRight"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider"
                android:background="@color/ppColorDividerLine"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/notificationSettingsRow"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/limitSettingsRow">
            <TextView
                android:gravity="start"
                android:id="@+id/notificationSettingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sm_notification_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/notificationSettingsArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/notificationSettingsArrow"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_ArrowRight"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
