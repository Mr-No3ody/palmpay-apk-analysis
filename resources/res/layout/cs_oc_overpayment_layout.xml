<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_oc_overpayment_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/overpayment_mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/cs_oc_overpayment_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_overpayment_amount"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/overpayment_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            style="@style/txt_number_me_b_b"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:gravity="center"
            android:id="@+id/overpayment_content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_refund_automatically_tomorrow"/>
        <View
            android:id="@+id/overpayment_divider_view"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp16"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/overpayment_receive_acc_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_overpayment_receiving_account"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/overpayment_receive_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/overpayment_receive_time_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_expect_received_time"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_within_working_day"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_oc_overpayment_faq"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp16"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_faq_overpayment_amount"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/cs_oc_faq_overpayment_content"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp16"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_oc_faq_overpayment_back"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/cs_oc_faq_overpayment_back_content"/>
    </LinearLayout>
</LinearLayout>
