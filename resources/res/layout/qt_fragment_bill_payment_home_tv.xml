<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_1_iv="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.core.viewmodel.ModelBillNoticeItem
            android:id="@+id/modelBillNoticeItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cv_notice_category_id="2"
            app:cv_notice_slot_id="@string/tv_super_league_text_ad"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llSelectBiller"
            android:background="@drawable/cv_shape_rect_corner_12_bg_white"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toBottomOf="@+id/modelBillNoticeItem">
            <com.transsnet.palmpay.custom_view.ModelItemSelection
                android:id="@+id/tev_select_biller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cv_item_selection_start_icon_visible="true"
                app:cv_item_selection_title_visible="false"
                app:cv_item_selection_value_max_line="2"
                app:cv_item_selection_value_text_size="@dimen/dp16"/>
            <com.transsnet.palmpay.teller.ui.view.ModelBillerTipsInfo
                android:id="@+id/operatorMsgLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"/>
        </LinearLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinatorBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llSelectBiller">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/bundle_app_bar"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    app:layout_scrollFlags="scroll">
                    <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                        android:id="@+id/model_input_customer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cv_hint="@string/qt_enter_tv_customer_id"
                        app:cv_show_error_text="true"
                        app:cv_title="@string/qt_tv_customer_id"
                        app:cv_title_visible="true"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_check_customer"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp6">
                        <ImageView
                            android:id="@+id/iv_check_customer"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp20"
                            android:adjustViewBounds="true"/>
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/tv_check_customer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_marginStart="@dimen/dp5"
                            style="@style/Text.medium.6306b2.12"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_save_to_beneficiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp6">
                        <TextView
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/qt_save_to_beneficiaries_tip"
                            android:layout_weight="1"
                            style="@style/Text.6f7b85.12"/>
                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:layout_gravity="center_vertical"
                            android:id="@+id/cb_save_to_beneficiaries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:button="@drawable/cv_checkbox_selector5"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <com.transsnet.palmpay.teller.ui.view.ModelTvRenewItem
                    android:id="@+id/model_renew_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_scrollFlags="scroll"/>
                <ViewStub
                    android:orientation="vertical"
                    android:id="@+id/qt_tv_coupon"
                    android:layout="@layout/qt_layout_biller_coupon_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_scrollFlags="scroll"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/sav_biller_pocker_banner"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <Space
                        android:id="@+id/space"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/sav_biller_pocker_banner"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_goneMarginBottom="0dp"/>
                    <ImageView
                        android:id="@+id/view_top_tab_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/cv_shape_rect_top_corner_white_12"
                        app:layout_constraintBottom_toBottomOf="@+id/bill_category_tabs"
                        app:layout_constraintTop_toTopOf="@+id/space"/>
                    <com.transsnet.palmpay.core.viewmodel.ModelAvailablePointItem
                        android:id="@+id/model_available_point_item"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginRight="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:layout_marginHorizontal="@dimen/dp10"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintTop_toTopOf="@+id/view_top_tab_bg"/>
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/bill_category_tabs"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/model_available_point_item"
                        app:tabIndicator="@drawable/qt_tab_indicator"
                        app:tabIndicatorColor="@color/ppColorTextPrimary"
                        app:tabIndicatorFullWidth="false"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="@dimen/dp12"
                        app:tabPaddingStart="@dimen/dp12"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabSelectedTextColor="@color/ppColorTextPrimary"
                        app:tabTextAppearance="@style/QTTabLayoutTextAppearance"
                        app:tabTextColor="@color/ppColorTextDisable"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <View
                    android:id="@+id/cpi_biller_loading_bg"
                    android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/dp24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpi_biller_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/ppColorPrimary"
                    app:indicatorSize="@dimen/dp24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.3"
                    app:trackThickness="@dimen/dp2"/>
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_tv_category"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
