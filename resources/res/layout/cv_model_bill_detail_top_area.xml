<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbdta_root"
    android:background="@color/ppColorPrimary"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/mbdta_iv"
        android:background="@drawable/cv_shape_circle_white"
        android:padding="0.5dp"
        android:layout_width="@dimen/dp35"
        android:layout_height="@dimen/dp35"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="@dimen/dp64"
        android:layout_marginRight="@dimen/dp3"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center_horizontal"
        android:id="@+id/mbdta_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp3"
        android:layout_marginTop="@dimen/dp8"
        android:text=""
        android:layout_below="@+id/mbdta_iv"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="2dp"/>
    <TextView
        android:textSize="@dimen/dp30"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/mbdta_trade_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cv_digit_0"
        android:layout_below="@+id/mbdta_title_tv"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dp11"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/mbdta_trade_state_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_below="@+id/mbdta_trade_amount_tv"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dp11"
        android:textColor="#8312ff"
        android:id="@+id/mbdta_check_state_tv"
        android:background="@drawable/cv_check_bill_detail_bg"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_check_status"
        android:layout_below="@+id/mbdta_trade_state_tv"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <ImageView
        android:id="@+id/mbdta_back_iv"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="31dp"
        android:src="@drawable/cv_arrow_back_white"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="@dimen/dp39"
        android:layout_toRightOf="@+id/mbdta_back_iv"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/right_top_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp43"
        android:layout_marginRight="@dimen/dp15"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/mbdta_download_iv"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/cv_download"
            android:scaleType="fitXY"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/mbdta_share_iv"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginRight="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            app:iiv_color="@color/md_white_1000"
            app:iiv_icon="pay_Share"
            app:iiv_size="24dp"/>
    </LinearLayout>
</RelativeLayout>
