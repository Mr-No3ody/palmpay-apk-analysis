<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/lib_ui_rect_bg_ffffff_corner_tl_tr_24"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:gravity="center"
            android:id="@+id/copy_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_copy_link"
            android:drawablePadding="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:gravity="center"
            android:id="@+id/refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_refresh"
            android:drawablePadding="8dp"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:gravity="center"
            android:id="@+id/open_browser_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_open_browser"
            android:drawablePadding="8dp"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/cancel_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/more_cancel_btn"
        style="@style/ppSecondaryButtonStyle"/>
</LinearLayout>
