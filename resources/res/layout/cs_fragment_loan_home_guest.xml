<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/pp_transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_right_iconfont_1="pay_CustomerService"
        app:title_bar_right_iconfont_color_1="@color/ppColorTextPrimary"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title=" "/>
    <ImageView
        android:id="@+id/ivLightning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:src="@drawable/cs_icon_lightning_fill"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_loan_home_guest_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLightning"
        style="@style/txt_bb_b_b"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llPoints"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_SelectedOutline"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_loan_home_guest_point_low_rate"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_SelectedOutline"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_loan_home_guest_point_fast"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_SelectedOutline"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_loan_home_guest_point_flexible"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCard"
        android:background="@drawable/cs_loan_home_guest_bg"
        android:paddingTop="@dimen/dp48"
        android:paddingBottom="@dimen/dp48"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llPoints">
        <TextView
            android:gravity="center"
            android:id="@+id/tvBorrowUpTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_loan_home_guest_borrow_up_to"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_bb_b_b"/>
        <TextView
            android:textSize="@dimen/dp48"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:text="@string/cs_loan_home_guest_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBorrowUpTo"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/cs_overdue_today_txt_color"
            android:gravity="center"
            android:id="@+id/tvRateTip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:text="@string/cs_loan_home_guest_daily_rate_low"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorButtonTextWhite"
            android:id="@+id/btnBorrowNow"
            android:layout_width="0dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dp48"
            android:layout_marginRight="24dp"
            android:text="@string/cs_cl_use_now"
            android:textAllCaps="false"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRateTip"
            style="@style/ppRoundButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
        android:id="@+id/viewLoanHomeBottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:layout_marginVertical="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
