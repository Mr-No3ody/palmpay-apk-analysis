<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="@dimen/ppDialogBgCornerRadius"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="@dimen/ppDialogVerticalMargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ppDialogTitleTextSize"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:paddingLeft="@dimen/ppDialogHorizontalMargin"
                android:paddingRight="@dimen/ppDialogHorizontalMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Info doesn&apos;t match"
                android:paddingStart="@dimen/ppDialogHorizontalMargin"
                android:paddingEnd="@dimen/ppDialogHorizontalMargin"
                android:paddingHorizontal="@dimen/ppDialogHorizontalMargin"
                style="@style/ppTextStyleT6"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center_vertical"
                android:id="@+id/tvMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:lineSpacingExtra="4dp"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"
                style="@style/ppTextStyleT3"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_btn_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ppButtonHeight"
                android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
                android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"
                app:layout_constraintHorizontal_chainStyle="spread">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tvCancel"
                    android:background="@drawable/lib_ui_button_bg_corner_secondary"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Re-scan Face"
                    android:elevation="0dp"
                    app:autoSizeMaxTextSize="@dimen/ppButtonTextSize"
                    app:autoSizeMinTextSize="@dimen/ppButtonMinTextSize"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toStartOf="@+id/view_gap"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_max="400dp"
                    style="@style/ppButtonPositiveStyle"/>
                <View
                    android:id="@+id/view_gap"
                    android:layout_width="@dimen/ppDialogButtonHorizontalGap"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvConfirm"
                    app:layout_constraintStart_toEndOf="@+id/tvCancel"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tvConfirm"
                    android:background="@drawable/lib_ui_button_bg_corner_primary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/ac_re_enter_id"
                    android:elevation="0dp"
                    app:autoSizeMaxTextSize="@dimen/ppButtonTextSize"
                    app:autoSizeMinTextSize="@dimen/ppButtonMinTextSize"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/view_gap"
                    app:layout_constraintWidth_max="400dp"
                    style="@style/ppButtonNegativeStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/ppColorLink"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvFill"
                android:paddingTop="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter personal information to verify"
                style="@style/txt_s_g"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/iv_close"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"/>
    </androidx.cardview.widget.CardView>
</FrameLayout>
