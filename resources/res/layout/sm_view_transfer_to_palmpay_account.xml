<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_root"
    android:background="@color/pp_transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/account_input_container"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingTop="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp82"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_search_palmpay_account"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/sm_recipient_Account"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp12"
            style="@style/Text.202046.12"/>
        <com.transsnet.palmpay.custom_view.input.CustomAutoCompleteTextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/et_bank_account"
            android:background="@color/pp_transparent"
            android:padding="0dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp32"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:hint="@string/sm_enter_10_digits_account_number_or_phone"
            android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
            android:digits="0123456789"
            android:inputType="phone"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp12"
            style="@style/MyAutoCompleteTextView"/>
        <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
            android:id="@+id/med_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:cv_divider_focus_color="@color/ppColorPrimary"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_matched_recipients"
            android:background="@drawable/cv_shape_rect_corner_bl_br_12_bg_dark"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </LinearLayout>
    <com.transsnet.palmpay.send_money.ui.view.ClipboardAccountPromptView
        android:id="@+id/clipboard_account_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account_input_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/clipboard_account_prompt">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp34"
            android:layout_marginTop="@dimen/dp12">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/indicatorView"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:indeterminate="true"
                app:indicatorColor="@color/ppColorTextPrimary"
                app:indicatorSize="@dimen/dp16"
                app:trackThickness="@dimen/dp1"/>
            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_looking_for_this_user_name"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_name"
            android:background="@drawable/cv_shape_rect_corner_8_bg_e4f7f0"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:minHeight="@dimen/dp34"
            android:backgroundTint="@color/ppColorSuccessBackground"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp6">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_recipient_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_SelectedFill"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tv_recipient_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp4"
                style="@style/txt_s_b_b"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_query_status"
            android:background="@drawable/cv_shape_rect_corner_8_bg_error_background"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp6">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_query_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorError"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="start"
                android:id="@+id/tv_query_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tv_next"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_next"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/ll_status"
        style="@style/txt_me_w_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
