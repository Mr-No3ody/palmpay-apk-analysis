<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp62"
        app:iiv_color="@color/ppColorWarning"
        app:iiv_icon="pay_Schedule"
        app:iiv_size="56dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/txt_bb_b_b"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:paddingLeft="12dp"
        android:paddingTop="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:backgroundTint="@color/ppColorBackgroundDark"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivIcon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorSuccess"
            app:iiv_icon="pay_SelectedFill"
            app:iiv_size="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_t3_application_submission_successful"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon1"
            app:layout_constraintStart_toEndOf="@+id/ivIcon1"
            app:layout_constraintTop_toTopOf="@+id/ivIcon1"
            style="@style/txt_s_g"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTime1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/tvTitle1"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle1"
            style="@style/txt_mi_g"/>
        <View
            android:id="@+id/viewLine1"
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="1dp"
            android:layout_height="42dp"
            app:layout_constraintEnd_toEndOf="@+id/ivIcon1"
            app:layout_constraintStart_toStartOf="@+id/ivIcon1"
            app:layout_constraintTop_toBottomOf="@+id/ivIcon1"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivIcon2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorWarning"
            app:iiv_icon="pay_Schedule"
            app:iiv_size="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewLine1"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_manual_review"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon2"
            app:layout_constraintStart_toEndOf="@+id/ivIcon2"
            app:layout_constraintTop_toTopOf="@+id/ivIcon2"
            style="@style/txt_s_b_b"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/tvMessage1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ac_feedback_t3_manual_review"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvTitle2"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle2"
            app:lineHeight="@dimen/dp18"
            style="@style/txt_mi_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTime2"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/tvTitle2"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage1"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPending1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvTime2,tvMessage1"/>
        <View
            android:id="@+id/viewGap1"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@+id/barrierPending1"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/successView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ivIcon3,viewLine2,tvTitle3"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPending2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvTime2,tvMessage1,viewGap1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIcon3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ac_indicator_dot_1"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="@+id/ivIcon2"
            app:layout_constraintStart_toStartOf="@+id/ivIcon2"
            app:layout_constraintTop_toBottomOf="@+id/barrierPending2"/>
        <View
            android:id="@+id/viewLine2"
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="1dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tvTitle3"
            app:layout_constraintEnd_toEndOf="@+id/ivIcon2"
            app:layout_constraintStart_toStartOf="@+id/ivIcon2"
            app:layout_constraintTop_toBottomOf="@+id/ivIcon2"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upgrade Successfully"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="12dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon3"
            app:layout_constraintStart_toEndOf="@+id/ivIcon1"
            app:layout_constraintTop_toTopOf="@+id/ivIcon3"
            style="@style/txt_s_g"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMessage2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ac_feedback_t3_manual_review"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvTitle3"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle3"
            style="@style/txt_mi_b"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/failView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/ppColorErrorBackground"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:contentPaddingBottom="8dp"
            app:contentPaddingLeft="@dimen/dp12"
            app:contentPaddingRight="@dimen/dp12"
            app:contentPaddingTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvMessage2"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage2">
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="center_vertical"
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                style="@style/txt_mi_g"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
