<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ira_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp85">
    <View
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/bgView"
        android:background="@drawable/cv_rect_cornet_12_stroke_f2f2f2_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp85"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/itemNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/itemVauleTv"
        app:layout_constraintEnd_toEndOf="@+id/bgView"
        app:layout_constraintStart_toStartOf="@+id/bgView"
        app:layout_constraintTop_toTopOf="@+id/bgView"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="@+id/itemVauleTv"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/bgView"
        app:layout_constraintStart_toStartOf="@+id/bgView"
        app:layout_constraintTop_toBottomOf="@+id/itemNameTv"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorWarning"
        android:ellipsize="end"
        android:id="@+id/remarkTv"
        android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_12"
        android:paddingLeft="@dimen/dp4"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="@dimen/dp4"
        android:paddingBottom="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp4"
        android:paddingVertical="@dimen/dp2"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046"/>
</androidx.constraintlayout.widget.ConstraintLayout>
