<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_listening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:src="@drawable/mm_icon_listening"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp8"
        app:layout_constraintRight_toLeftOf="@+id/iv_listening"
        app:layout_constraintTop_toBottomOf="@+id/iv_listening"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_top_corner_white_24"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/iv_listening">
        <TextView
            android:id="@+id/tvTitle"
            android:paddingTop="24dp"
            android:paddingBottom="1dp"
            android:text="Why you want to turn off Auto Save?"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.18"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:text="Your feedback helps us improve it!"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/Text.6f7b85.14"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_frame1"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintStart_toStartOf="@+id/tvContent"
            app:layout_constraintTop_toBottomOf="@+id/tvContent">
            <TextView
                android:gravity="left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1.I don’t want all my money moved to CashBox"
                android:lineSpacingMultiplier="1.1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivFirstCheck"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.6f7b85.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivFirstCheck"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_CircleOutline"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_frame2"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintStart_toStartOf="@+id/ll_frame1"
            app:layout_constraintTop_toBottomOf="@+id/ll_frame1">
            <TextView
                android:gravity="left"
                android:id="@+id/tv_sec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2.I don’t understand how Auto Save works"
                android:lineSpacingMultiplier="1.1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivSecCheck"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.6f7b85.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivSecCheck"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_CircleOutline"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_frame3"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintStart_toStartOf="@+id/ll_frame2"
            app:layout_constraintTop_toBottomOf="@+id/ll_frame2">
            <TextView
                android:gravity="left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="3.I don’t want to use CashBox to earn daily"
                android:lineSpacingMultiplier="1.1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivThirdCheck"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.6f7b85.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivThirdCheck"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_CircleOutline"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_frame4"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            app:layout_constraintStart_toStartOf="@+id/ll_frame3"
            app:layout_constraintTop_toBottomOf="@+id/ll_frame3">
            <TextView
                android:gravity="left"
                android:id="@+id/tv_remark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="Other Reasons (Optional)"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.12"/>
            <EditText
                android:gravity="left"
                android:id="@+id/editTextOtherReasons"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:hint="Tell us more..."
                android:maxLength="100"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_remark"
                style="@style/Text.202046.16"/>
            <TextView
                android:id="@+id/textViewCharacterCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp28"
                android:text="0/100"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextOtherReasons"
                style="@style/Text.9ca2aa.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/rtvAgree"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp90"
            android:layout_marginRight="@dimen/dp16"
            android:text="Confirm &amp; Turn off"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_frame4"
            app:rtv_background_color="@color/mm_bg_btn"
            style="@style/ppButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
