<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_reminder"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            style="@style/Text.medium.202046.18"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:includeFontPadding="false"
            style="@style/Text.6f7b85.14"/>
        <FrameLayout
            android:id="@+id/cardRepaymentInfo"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:padding="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:minHeight="@dimen/dp70">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/layoutOverdue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="center"
                    android:id="@+id/tvOverdueLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/dp20"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/tvOverdueAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:divider="@drawable/cv_shape_transparent_h_divider_12"
            android:showDividers="middle">
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:text="@string/core_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                style="@style/ppSecondaryButtonStyle"/>
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/btnRepay"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:text="@string/core_repay"
                android:layout_weight="1"
                android:textAllCaps="false"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
