<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp48"
        android:layout_marginStart="@dimen/dp16"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_ArrowLeft"
        app:iiv_size="@dimen/dp24"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/repayment_status_img"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/status_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/status_content_tv"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/top_acc_ll_one_borrow"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="60dp"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp16">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_loan_amount"
                    android:layout_marginStart="@dimen/dp16"/>
                <TextView
                    android:textSize="32sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/available_amount_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:fontFamily="@font/cv_palmpay_number_bold"
                    android:layout_marginStart="@dimen/dp16"/>
                <com.transsnet.palmpay.credit.ui.view.OneTouchBorrowView
                    android:id="@+id/oneTouchBorrowView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:otb_agreement_show="false"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/cv_flexi_cash_base_color"
                    android:layout_gravity="center"
                    android:id="@+id/borrow_other_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/cs_borrow_other_amount"
                    android:drawableEnd="@drawable/cs_cl_view_right_arrow_icon"
                    android:drawableTint="@color/ppColorFlexiCashPrimary"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/agreement_ll"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp15"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_loan_agreement"
                    android:layout_weight="1"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextDisable"
                    app:iiv_icon="pay_ArrowRight"
                    app:iiv_size="@dimen/dp20"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/top_acc_ll"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/tvSingleCashAvailableAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp40"
                    android:text="@string/cs_loan_amount"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cs_cl_overdue_txt_color"
                    android:id="@+id/forzen_tag_tv"
                    android:background="@drawable/shape_bg_main_tag_forzen"
                    android:padding="@dimen/dp1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp6"
                    app:layout_constraintBottom_toBottomOf="@+id/tvSingleCashAvailableAmount"
                    app:layout_constraintStart_toEndOf="@+id/tvSingleCashAvailableAmount"
                    app:layout_constraintTop_toTopOf="@+id/tvSingleCashAvailableAmount"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvSingleCashAvailableAmount">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/loan_period_title_tv"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_loan_period_up_to"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="32sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/period_days_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:text="180"
                        android:fontFamily="@font/cv_palmpay_number_bold"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintLeft_toLeftOf="@+id/loan_period_title_tv"
                        app:layout_constraintRight_toLeftOf="@+id/tv_title_days"
                        app:layout_constraintTop_toBottomOf="@+id/loan_period_title_tv"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/tv_title_days"
                        android:paddingLeft="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_days"
                        app:layout_constraintBaseline_toBaselineOf="@+id/period_days_tv"
                        app:layout_constraintLeft_toRightOf="@+id/period_days_tv"
                        app:layout_constraintRight_toRightOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="32sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/available_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:fontFamily="@font/cv_palmpay_number_bold"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSingleCashAvailableAmount"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cs_repayment_result_interest_text_color"
                    android:gravity="left"
                    android:id="@+id/top_left_interest_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp32"
                    android:layout_marginBottom="@dimen/dp24"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintBottom_toTopOf="@+id/cl_borrow_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/available_amount_tv"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cs_cl_borrow_txt_color"
                    android:gravity="center"
                    android:id="@+id/cl_borrow_tv"
                    android:background="@drawable/cs_cl_borrow_txt_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp24"
                    android:text="@string/cs_cl_borrow_now"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:id="@+id/repay_complete_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_cl_repay_complete"
                android:textAllCaps="false"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/cl_repayment_result_bottom_sav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="16dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="16dp"
                app:slot_id="@string/cl_repayment_result_single_ad_slot_id"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
