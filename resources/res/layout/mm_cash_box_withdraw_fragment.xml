<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/mtb"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                app:layout_constraintTop_toTopOf="parent"
                app:title_bar_title="@string/mm_cash_box_withdraw_title"
                app:title_bar_title_color="@color/ppColorTextPrimary"/>
            <com.transsnet.palmpay.managemoney.ui.view.CashBoxEstimatedInterestView
                android:id="@+id/viewEstimatedInterest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:esrv_type="WITHDRAW"
                app:layout_constraintTop_toBottomOf="@+id/mtb"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctl_withdraw"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp24"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp24"
                android:paddingBottom="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp24"
                android:paddingVertical="@dimen/dp16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewEstimatedInterest">
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tv_withdraw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Withdraw to"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="500"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_cashbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:src="@drawable/cv_palmpay_logo_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_withdraw"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="PalmPay Balance"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_cashbox"
                    app:layout_constraintStart_toEndOf="@+id/iv_cashbox"
                    app:layout_constraintTop_toTopOf="@+id/iv_cashbox"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutNext"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:enabled="false"
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/rtvNext"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_next"
            app:layout_constraintTop_toBottomOf="@+id/viewEstimatedInterest"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </LinearLayout>
</LinearLayout>
