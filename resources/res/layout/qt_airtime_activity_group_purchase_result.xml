<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title_bar_show_right_1_iv="true"
                app:title_bar_title="@string/core_airtime"/>
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/aaturv_result_progress_view"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_order_info"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp4"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/llViewDetail"
                android:background="@color/ppColorBackgroundLight"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/tv_view_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_view_detail"
                    style="@style/txt_s_b_b"/>
                <ImageView
                    android:id="@+id/iv_view_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cv_purple_arrow_right_bold"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/aaturv2_two_btn_area"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/actur_complete_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
