<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56">
        <com.transsnet.palmpay.custom_view.StateImageView
            android:id="@+id/ivBack"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:src="@drawable/cv_arrow_back_black"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/ivBack"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/ivAvatar">
            <TextView
                android:textSize="16dp"
                android:textColor="#000000"
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/tvNo"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#f3fdff"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="1dp">
        <TextView
            android:textSize="10dp"
            android:textColor="#1ac3ff"
            android:gravity="center"
            android:background="@drawable/ct_free_conner_bg"
            android:layout_width="34dp"
            android:layout_height="16dp"
            android:layout_marginLeft="16dp"
            android:text="@string/ct_free"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#91b9cf"
            android:id="@+id/freeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/ct_free_desc"/>
    </LinearLayout>
    <RelativeLayout
        android:background="#f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.custom_view.ReverseRecyclerView
            android:id="@+id/viewList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/thanksAnimView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"/>
    </RelativeLayout>
</LinearLayout>
