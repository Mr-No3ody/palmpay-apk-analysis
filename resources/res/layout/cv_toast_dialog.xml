<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/toast_dialog_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp30"
        android:layout_marginRight="@dimen/dp30"
        android:layout_marginHorizontal="@dimen/dp30"
        app:cardCornerRadius="@dimen/dp16"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_toast_dialog"
            android:background="@color/ppColorActivityMask"
            android:padding="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tips_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12"
                app:iiv_color="@color/ppColorButtonTextWhite"
                app:iiv_icon="pay_SelectedOutline"
                app:iiv_size="32dp"/>
            <TextView
                android:textSize="@dimen/dp18"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/tips_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp7"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/tips_msg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
