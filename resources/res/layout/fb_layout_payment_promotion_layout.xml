<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/fb_dp16"
    android:paddingBottom="@dimen/fb_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/fb_dp48"
    android:paddingVertical="@dimen/fb_dp16">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fb_ll_promotion_layout"
        android:paddingTop="@dimen/fb_dp6"
        android:paddingBottom="@dimen/fb_dp6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/fb_dp6"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fb_ll_promotion_tips_layout"
        android:paddingLeft="@dimen/fb_dp12"
        android:paddingRight="@dimen/fb_dp12"
        android:paddingBottom="@dimen/fb_dp6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fb_dp12">
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="start|center_vertical"
            android:id="@+id/fb_tv_item_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fb_dp6"
            app:iiv_start_color="@color/ppColorTextAssist"
            app:iiv_start_icon="pay_InformationOutline"
            app:iiv_start_size="@dimen/fb_dp14"
            style="@style/fb_Text.9ca2aa.12"/>
    </LinearLayout>
</merge>
