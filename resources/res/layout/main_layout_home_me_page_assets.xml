<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/layoutUserLevelStub"
        android:layout="@layout/main_layout_home_me_assets_user_level"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp67"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAssets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/cv_shape_rect_corner_12_bg_white"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_str_total_assets"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvAmount2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAmount2"
            style="@style/txt_bb_b"/>
        <androidx.core.widget.ContentLoadingProgressBar
            android:theme="@style/MainContentLoadingProgress"
            android:id="@+id/loadingView"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
            app:layout_constraintStart_toEndOf="@+id/tvAmount"
            app:layout_constraintTop_toTopOf="@+id/tvAmount"
            style="?android:attr/progressBarStyleLarge"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivAmountArrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
            app:layout_constraintStart_toEndOf="@+id/tvAmount"
            app:layout_constraintTop_toTopOf="@+id/tvAmount"/>
        <com.transsnet.palmpay.custom_view.StateImageView
            android:id="@+id/ivEye"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/cv_icon_eye_opened"
            android:layout_marginStart="@dimen/dp6"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toEndOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivTipsBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvNetworkTips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvNetworkTips"
            app:srcCompat="@drawable/main_pop_bg_2"/>
        <TextView
            android:textColor="@color/ppColorWarning"
            android:gravity="center_vertical"
            android:id="@+id/tvNetworkTips"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lines="2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmount"
            style="@style/txt_mi_g"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupNotNetwork"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ivTipsBg, tvNetworkTips"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvAmount, ivTipsBg"/>
        <View
            android:id="@+id/dividerView"
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <TextView
            android:ellipsize="start"
            android:gravity="end|center_vertical"
            android:id="@+id/tvTitle1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"
            app:layout_constraintWidth_percent="0.5"
            style="@style/txt_mi_b"/>
        <com.palmpay.lib.ui.text.ImageTextView
            android:textSize="20dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvAmount2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            app:itv_color="@color/ppColorTextPrimary"
            app:itv_icon="pay_ArrowCenterRight"
            app:itv_img_gravity="right_center"
            app:itv_img_size="@dimen/dp16"
            app:itv_img_top_margin="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle1"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/bottomGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="dividerView, tvTransHistory, ivArrow"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTransHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/main_transaction_history"
            android:layout_marginStart="@dimen/dp12"
            app:layout_constraintEnd_toStartOf="@+id/ivArrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerView"
            style="@style/txt_mi_g"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp12"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/tvTransHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTransHistory"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_monthly_overview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="@+id/tvTransHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTransHistory">
            <include layout="@layout/cv_layout_monthly_overview"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutTransHistory"
            android:paddingTop="@dimen/dp12"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTransHistory">
            <ViewStub
                android:id="@+id/transItem1Stub"
                android:layout="@layout/main_me_page_transaction_history_item_v2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/transItem2Stub"
                android:layout="@layout/main_me_page_transaction_history_item_v2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvTitle1, ivTipsBg, tvTransHistory, layoutTransHistory"/>
        <Space
            android:layout_width="1dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
