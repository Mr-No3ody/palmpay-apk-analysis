<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.input.ModelMobileWithIconInputLayout
        android:id="@+id/modelPhoneNumber"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llRecommend"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_recommend_phone_number"
            style="@style/Text.202046.12"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ryRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvBody"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp16">
            <androidx.constraintlayout.widget.Group
                android:id="@+id/gpAmountList"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="viewBgAmount,tvEvery,tvDate,tvAutoTopUp,ryAmount"/>
            <View
                android:id="@+id/viewBgAmount"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/ryAmount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvEvery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/core_every"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/viewBgAmount"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:id="@+id/tvDate"
                android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="@dimen/dp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                android:paddingHorizontal="@dimen/dp4"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
                app:layout_constraintStart_toEndOf="@+id/tvEvery"
                style="@style/Text.medium.6306b2.14"/>
            <TextView
                android:id="@+id/tvAutoTopUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qt_auto_top_up"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
                app:layout_constraintStart_toEndOf="@+id/tvDate"
                style="@style/Text.medium.202046.14"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryAmount"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/tvEvery"/>
            <TextView
                android:id="@+id/tvAutoTopUpTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ryAmount"
                style="@style/Text.medium.202046.14"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp12">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.mikepenz.iconics.view.IconicsCheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/cbAgreement"
                android:padding="@dimen/dp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_checked_color="@color/ppColorPrimary"
                app:iiv_checked_icon="pay_CheckboxFill"
                app:iiv_checked_size="@dimen/dp16"
                app:iiv_unchecked_color="@color/ppColorTextAssist"
                app:iiv_unchecked_icon="pay_CheckboxOutline"
                app:iiv_unchecked_size="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:id="@+id/tvAgreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvConfirm"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/core_confirm"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.ffffff.16"/>
    </LinearLayout>
</LinearLayout>
