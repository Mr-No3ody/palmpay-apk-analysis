<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_enter_share_pin"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_g"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:cardBackgroundColor="@color/ppColorBackgroundDark"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPadding="0dp">
        <androidx.appcompat.widget.AppCompatEditText
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/editSharePin"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/core_enter_airtime_share_pin"
            android:maxLength="10"
            android:inputType="numberPassword"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="44dp"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/ivHide"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_hide_psw"
            android:scaleType="fitXY"
            android:paddingEnd="8dp"
            android:layout_marginEnd="@dimen/dp8"
            android:paddingVertical="8dp"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_Hide"
            app:iiv_size="@dimen/dp24"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvSetPin"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_have_not_set_airtime_pin"
        android:paddingVertical="@dimen/dp8"
        style="@style/Text.6306b2.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:layout_gravity="center_horizontal"
        android:id="@+id/buttonNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_confirm"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/ppButtonStyle"/>
</LinearLayout>
