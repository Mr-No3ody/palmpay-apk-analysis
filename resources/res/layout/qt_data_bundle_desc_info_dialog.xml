<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivTopBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/qt_airtime_topup_dialog_top_bg"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialogContent"
        android:background="@drawable/cv_rect_corner_24_bg_white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="112dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginTop="@dimen/dp12"
            android:contentDescription="@string/qt_close"
            android:layout_marginEnd="@dimen/dp12"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp36"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.18"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/Text.6f7b85.14"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="@dimen/dp16"
            android:gravity="center"
            android:id="@+id/btnPay"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/core_pay"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescription"
            style="@style/ppButtonStyle"/>
        <TextView
            android:textColor="@color/ppColorWarning"
            android:ellipsize="end"
            android:id="@+id/tvTag"
            android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_br_8"
            android:paddingLeft="@dimen/dp4"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp4"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:translationY="@dimen/dp7"
            android:paddingHorizontal="@dimen/dp4"
            android:paddingVertical="@dimen/dp2"
            app:layout_constraintBottom_toTopOf="@+id/btnPay"
            app:layout_constraintEnd_toEndOf="@+id/btnPay"
            style="@style/Text.medium.202046.10"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
