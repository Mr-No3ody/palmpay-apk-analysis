<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/p2p_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="@string/core_nearby_agent"/>
    <FrameLayout
        android:id="@+id/p2p_location"
        android:background="@color/ppColorBackgroundDark"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:src="@mipmap/p2p_location_logo2"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="44dp"
            android:text="@string/p2p_str_turn_on_location__________"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="16dp"/>
    </FrameLayout>
    <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PPositionSelectorView
        android:id="@+id/p2p_selector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_location"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/p2p_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_selector">
        <FrameLayout
            android:id="@+id/p2p_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="500dp">
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PEmptyView
                android:layout_gravity="center"
                android:id="@+id/p2p_empty_view2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/p2p_next"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_input"/>
        </FrameLayout>
    </com.transsnet.palmpay.custom_view.SwipeRecyclerView>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_booking_info"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/p2p_base"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_missed_symbol"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="-2dp"
                app:cardBackgroundColor="@color/ppColorError"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_base">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/p2p_str_missed"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/p2p_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_missed_symbol"
                app:layout_goneMarginTop="11dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/p2p_booking_code_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="9dp"
                android:text="@string/p2p_str_booking_code"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_time"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/p2p_booking_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_booking_code_tx"
                app:layout_constraintLeft_toRightOf="@+id/p2p_booking_code_tx"
                app:layout_constraintTop_toTopOf="@+id/p2p_booking_code_tx"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_view"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginRight="36dp"
                app:cardBackgroundColor="#38d79f"
                app:cardCornerRadius="13dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:text="@string/p2p_str_view"/>
            </androidx.cardview.widget.CardView>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/p2p_l_close"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_Close"
                app:iiv_size="12dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_pay_info"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#99000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/p2p_payment_request"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="9dp"
                android:text="@string/p2p_str_1_payment_request"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/p2p_payment_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_payment_request"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_payment_btn"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginRight="36dp"
                app:cardBackgroundColor="#38d79f"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_payment_amount"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/p2p_payment_request">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_marginRight="22dp"
                    android:text="@string/core_pay"
                    android:fontFamily="sans-serif-medium"/>
            </androidx.cardview.widget.CardView>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/p2p_l_close2"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_Close"
                app:iiv_size="12dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_change_label"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                app:cardBackgroundColor="#14ffaa0c"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_payment_amount">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp">
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center_vertical"
                        android:id="@+id/p2p_i"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/p2p_str_order_amount_changed_by_the_exchange_point"
                        android:drawablePadding="4dp"
                        app:iiv_start_color="@color/ppColorWarning"
                        app:iiv_start_icon="pay_InformationOutline"
                        app:iiv_start_size="@dimen/dp16"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/p2p_ad_test"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:slot_id="@string/nearby_agent_flot_slot_id"/>
</androidx.constraintlayout.widget.ConstraintLayout>
