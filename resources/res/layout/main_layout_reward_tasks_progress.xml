<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/reward1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp50"
        app:layout_constraintEnd_toStartOf="@+id/arrow1"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_layout_reward_tasks_progress_item"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow1"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp12"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/reward1"
        app:layout_constraintEnd_toStartOf="@+id/reward2"
        app:layout_constraintStart_toEndOf="@+id/reward1"
        app:layout_constraintTop_toTopOf="@+id/reward1"
        app:srcCompat="@drawable/main_ic_reward_progress_arrow_inactive"/>
    <include
        android:id="@+id/reward2"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp50"
        app:layout_constraintEnd_toStartOf="@+id/arrow2"
        app:layout_constraintStart_toEndOf="@+id/arrow1"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_layout_reward_tasks_progress_item"/>
    <ImageView
        android:id="@+id/arrow2"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp12"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/reward1"
        app:layout_constraintEnd_toStartOf="@+id/reward3"
        app:layout_constraintStart_toEndOf="@+id/reward2"
        app:layout_constraintTop_toTopOf="@+id/reward1"
        app:srcCompat="@drawable/main_ic_reward_progress_arrow_inactive"/>
    <include
        android:id="@+id/reward3"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp50"
        app:layout_constraintEnd_toStartOf="@+id/arrow3"
        app:layout_constraintStart_toEndOf="@+id/arrow2"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_layout_reward_tasks_progress_item"/>
    <ImageView
        android:id="@+id/arrow3"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp12"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/reward1"
        app:layout_constraintEnd_toStartOf="@+id/reward4"
        app:layout_constraintStart_toEndOf="@+id/reward3"
        app:layout_constraintTop_toTopOf="@+id/reward1"
        app:srcCompat="@drawable/main_ic_reward_progress_arrow_inactive"/>
    <include
        android:id="@+id/reward4"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/arrow3"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/main_layout_reward_tasks_progress_item"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="arrow1,reward1, reward2, reward3,reward4"/>
    <FrameLayout
        android:id="@+id/flHintBar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier">
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/ivHintAnchor"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/cv_icon_polygon"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvHint"
            android:background="@drawable/cv_shape_rect_corner_4_bg_white"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="2dp"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="2dp"
            style="@style/Text.202046.12"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
