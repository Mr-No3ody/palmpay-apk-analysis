<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_color_cl_bg"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivOcWaiverHeaderBg"
            android:background="@drawable/cs_cl_waiver_header_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.custom_view.StatusBarView
                android:id="@+id/statusBarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layoutOcRepayTitleBar"
                android:background="@color/ppColorBackgroundLight"
                android:paddingBottom="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.custom_view.StateImageView
                    android:id="@+id/repay_back_siv"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_oc_back_icon_black"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/mtb_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_repay_title"
                        android:fontFamily="sans-serif-medium"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/bill_month_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_direct_billing_cycle"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/oc_repay_day_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/dp_4"/>
                    </LinearLayout>
                </LinearLayout>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/server_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp16"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_CustomerService"
                    app:iiv_size="24dp"/>
            </LinearLayout>
            <include
                android:id="@+id/includeOcWaiverHeader"
                layout="@layout/cs_cl_bill_detail_waiver_header"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/repay_coupon_ll"
                android:background="@drawable/cs_oc_repay_zone_bg"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_repayment_coupon"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/coupon_rv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp6"/>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="@dimen/dp12"
                    android:layout_height="@dimen/dp12"
                    android:src="@drawable/cs_oc_coupon_right_arrow"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/ppColorBackgroundLight"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckedTextView
                        android:id="@+id/direct_repayment_ctv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/cs_oc_direct_repay"
                        android:drawablePadding="@dimen/dp4"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/direct_amount_tv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/oc_repay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_repayment_amount"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/direct_input_cl"
                    android:focusable="true"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.transsnet.palmpay.custom_view.AmountEditText
                        android:textSize="28sp"
                        android:textColor="@drawable/cv_selector_text_color_black_gray"
                        android:textColorHint="@color/cv_pin_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/oc_repayment_input_et"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:maxLength="10"
                        android:inputType="number"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingEnd="@dimen/dp38"
                        app:cv_decimalNumber="2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/repay_currency_tv"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_number_s_b_b"/>
                    <ImageView
                        android:id="@+id/clear_input_img"
                        android:padding="@dimen/dp4"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@drawable/cv_circle_gray_cross"
                        app:layout_constraintBottom_toBottomOf="@+id/oc_repayment_input_et"
                        app:layout_constraintEnd_toEndOf="@+id/oc_repayment_input_et"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/oc_repay_all_tv"
                        android:background="@drawable/cs_oc_all_txt_bg"
                        android:paddingTop="@dimen/dp4"
                        android:paddingBottom="@dimen/dp4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cs_oc_all"
                        android:paddingStart="@dimen/dp14"
                        android:paddingEnd="@dimen/dp14"
                        app:layout_constraintStart_toStartOf="@+id/repay_currency_tv"
                        app:layout_constraintTop_toBottomOf="@+id/min_amount_warn_tv"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/repay_min_amount_tv"
                        android:background="@drawable/cs_oc_all_txt_bg"
                        android:paddingTop="@dimen/dp4"
                        android:paddingBottom="@dimen/dp4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_min_100_00"
                        android:paddingStart="@dimen/dp14"
                        android:paddingEnd="@dimen/dp14"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/oc_repay_all_tv"
                        app:layout_constraintStart_toEndOf="@+id/oc_repay_all_tv"
                        app:layout_constraintTop_toTopOf="@+id/oc_repay_all_tv"/>
                    <View
                        android:id="@+id/oc_input_bg_view"
                        android:background="@color/cs_cl_input_divider_normal_color"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp12"
                        app:layout_constraintEnd_toEndOf="@+id/oc_repayment_input_et"
                        app:layout_constraintStart_toStartOf="@+id/repay_currency_tv"
                        app:layout_constraintTop_toBottomOf="@+id/oc_repayment_input_et"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/repay_currency_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/oc_repayment_input_et"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/oc_repayment_input_et"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorError"
                        android:id="@+id/min_amount_warn_tv"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/cs_oc_minimum_repayment"
                        android:drawablePadding="@dimen/dp5"
                        android:drawableStart="@drawable/cs_oc_min_amount_warn_icon"
                        app:layout_constraintEnd_toEndOf="@+id/oc_input_bg_view"
                        app:layout_constraintStart_toStartOf="@+id/repay_currency_tv"
                        app:layout_constraintTop_toBottomOf="@+id/oc_input_bg_view"/>
                    <com.transsnet.palmpay.credit.view.RepayStampDutyView
                        android:id="@+id/repayStampDutyView"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@+id/oc_input_bg_view"
                        app:layout_constraintStart_toStartOf="@+id/repay_currency_tv"
                        app:layout_constraintTop_toBottomOf="@+id/oc_input_bg_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cs_main_color"
                    android:id="@+id/full_immediately_tv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp14"
                    android:text="@string/cs_full_immediately"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/direct_repayment_detail_ll"
                android:background="@color/ppColorBackgroundLight"
                android:padding="@dimen/dp16"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_direct_repay_principal"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/oc_pay_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/overdue_item_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/overdue_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_repay_overdue"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/multi_faq_img"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp14"
                        android:layout_height="@dimen/dp14"
                        android:layout_marginEnd="@dimen/dp_4"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/overdue_day_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/oc_interest_title_ll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_12">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_penalty_interest"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/oc_interest_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/oc_service_fee_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_12">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_service_fee"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/oc_service_fee_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/rowOcWaiverDiscount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp14">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextNormal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_waiver_discount_label"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center"
                        android:id="@+id/tvOcWaiverDiscountAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/extend_ll"
                android:background="@drawable/cs_oc_repay_zone_bg"
                android:paddingTop="@dimen/dp21"
                android:paddingBottom="@dimen/dp21"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/extend_repayment_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckedTextView
                        android:textSize="14sp"
                        android:id="@+id/mini_repayment_ctv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_minimum_repayment_title"
                        android:drawablePadding="@dimen/dp4"
                        android:fontFamily="sans-serif-medium"/>
                    <ImageView
                        android:id="@+id/expend_tips_img"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp18"
                        android:layout_height="@dimen/dp18"
                        android:src="@drawable/cs_oc_spread_repay_tips"
                        android:layout_marginStart="@dimen/dp4"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cs_main_color"
                        android:gravity="end"
                        android:id="@+id/extend_right_amount_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/cs_cl_oc_bill_left_arrow"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/expend_detail_cl"
                    android:background="@drawable/cs_oc_repay_zone_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/currency_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/extend_amount_tv"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/extend_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/currency_tv"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/csTextview142"
                        android:background="@color/ppColorBackgroundDark"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/extend_amount_tv"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:id="@+id/init_payment_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/cs_initial_payment"
                        android:drawablePadding="@dimen/dp6"
                        android:drawableEnd="@drawable/cs_oc_spread_repay_tips"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/csTextview142"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/extend_penalty_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/csTextview143"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/csTextview143"
                        app:layout_constraintTop_toTopOf="@+id/csTextview143"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/extend_interest_group"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="csTextview143,extend_penalty_tv"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:id="@+id/csTextview143"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/cs_expend_overdue_interest"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/init_payment_tv"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/init_payment_content_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/init_payment_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/init_payment_tv"
                        app:layout_constraintTop_toTopOf="@+id/init_payment_tv"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:id="@+id/csTextview145"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/cs_expend_service_fee"
                        app:layout_constraintStart_toStartOf="@+id/csTextview143"
                        app:layout_constraintTop_toBottomOf="@+id/csTextview143"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/extend_fee_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/csTextview145"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/csTextview145"
                        app:layout_constraintTop_toTopOf="@+id/csTextview145"/>
                    <View
                        android:id="@+id/expend_tips_divider_view"
                        android:background="@color/ppColorBackgroundDark"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/csTextview145"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/expend_tips_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/expend_tips_divider_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/spread_method_ll"
                android:background="@drawable/cs_oc_repay_zone_bg"
                android:paddingBottom="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ImageView
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center"
                    android:id="@+id/csTextview113"
                    android:background="@drawable/cs_oc_spread_recommend_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/spread_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_spread_repayment_available"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
