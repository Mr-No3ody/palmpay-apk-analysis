<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        layout="@layout/ac_layout_login_header"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivLogo"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp30"
        android:layout_marginTop="40dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivTitle1"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="@dimen/dp64"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/cv_slogon_text"/>
    <com.transsnet.palmpay.custom_view.async.AsyncViewStub
        android:id="@+id/mobileEditViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
        android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
        android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"
        app:layout="@layout/ac_layout_mobile_edit_view"
        app:mode="1"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/textViewNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
        android:text="@string/core_log_in"
        android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"
        style="@style/ppButtonStyle"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_don_t_have_an_account"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_g"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/dp64"
        android:text="@string/ac_click_here_to_sign_up"
        app:layout_constraintBottom_toBottomOf="@+id/tv1"
        app:layout_constraintStart_toEndOf="@+id/tv1"
        app:layout_constraintTop_toTopOf="@+id/tv1"
        style="@style/txt_s_g"/>
    <ViewStub
        android:id="@+id/bottomViewStub"
        android:layout="@layout/cv_layout_login_register_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
</LinearLayout>
