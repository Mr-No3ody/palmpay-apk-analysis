<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/p2p_input_amount_view_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_txt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/p2p_str_how_much_do_you_need"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="21dp"
        android:text="@string/core_ngn_symbol"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_txt1"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="20sp"
        android:textColor="@color/ppColorTextPrimary"
        android:textColorHint="#c0c3c8"
        android:id="@+id/p2p_edit"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:hint="@string/p2p_str_200_500"
        android:singleLine="true"
        android:imeOptions="actionDone"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_symbol"
        app:layout_constraintLeft_toRightOf="@+id/p2p_symbol"
        app:layout_constraintRight_toLeftOf="@+id/p2p_clear"
        app:layout_constraintTop_toTopOf="@+id/p2p_symbol"
        app:layout_goneMarginRight="16dp"/>
    <ImageView
        android:id="@+id/p2p_clear"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/cv_circle_gray_cross"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_edit"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/p2p_edit"/>
    <View
        android:id="@+id/p2p_line"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_symbol"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorError"
        android:id="@+id/p2p_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_line"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/p2p_money_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_error"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/p2p_amounts"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_line">
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PAmountView
            android:id="@+id/p2p_amount1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/p2p_amount2"
            app:layout_constraintTop_toTopOf="parent"
            app:p2p_text="₦1,000"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PAmountView
            android:id="@+id/p2p_amount2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@+id/p2p_amount1"
            app:layout_constraintRight_toLeftOf="@+id/p2p_amount3"
            app:layout_constraintTop_toTopOf="parent"
            app:p2p_text="₦3,000"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PAmountView
            android:id="@+id/p2p_amount3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@+id/p2p_amount2"
            app:layout_constraintRight_toLeftOf="@+id/p2p_amount4"
            app:layout_constraintTop_toTopOf="parent"
            app:p2p_text="₦5,000"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PAmountView
            android:id="@+id/p2p_amount4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@+id/p2p_amount3"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:p2p_text="₦50,000"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
