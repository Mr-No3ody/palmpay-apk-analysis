<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_white_bg_pop4"
    android:paddingTop="@dimen/dp16"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/dp176"
    android:paddingVertical="@dimen/dp16">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/itemView3"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingHorizontal="@dimen/dp16">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_TransactionHistory"
            app:iiv_size="20dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_history"
            android:layout_marginStart="@dimen/dp8"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <View
        android:id="@+id/line2"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/itemView2"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingHorizontal="@dimen/dp16">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_Share"
            app:iiv_size="20dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_share"
            android:layout_marginStart="@dimen/dp8"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <View
        android:id="@+id/line1"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/itemView1"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingHorizontal="@dimen/dp16">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_Agreements"
            app:iiv_size="20dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_rules"
            android:layout_marginStart="@dimen/dp8"
            style="@style/txt_s_b"/>
    </LinearLayout>
</LinearLayout>
