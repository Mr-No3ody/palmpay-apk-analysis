<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    app:cardBackgroundColor="@color/ppColorDividerLine"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="11dp"
        app:cardElevation="0dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="center_vertical"
            android:id="@+id/p2p_time_quantum_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center_vertical"
            android:id="@+id/p2p_busy_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="93dp"
            app:cardBackgroundColor="#ffdddd"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorError"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="@string/p2p_str_busy"/>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/p2p_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@mipmap/p2p_unselect_img"/>
    </androidx.cardview.widget.CardView>
</androidx.cardview.widget.CardView>
