<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/mci_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_coupon_to_use"
        android:layout_centerVertical="true"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mci_tips_iv"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/mci_title_tv"
        android:layout_centerVertical="true"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="12dp"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mci_arrow_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="16dp"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/mci_msg_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/mci_arrow_iv"/>
    <View
        android:background="@color/ppColorDividerLineDark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</merge>
