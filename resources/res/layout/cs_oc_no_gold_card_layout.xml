<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_16_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp26"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_one_more_step_to_upgrade"
            android:drawableTop="@drawable/cs_oc_gold_disable"
            android:drawablePadding="@dimen/dp16"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp16"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp18"
            android:text="@string/cs_oc_continually_repaying_on_time"
            android:drawablePadding="@dimen/dp12"
            android:drawableStart="@drawable/cs_oc_repay_on_time_icon"
            android:paddingHorizontal="@dimen/dp12"
            android:paddingVertical="@dimen/dp16"/>
    </LinearLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/use_flexi_bt"
        android:background="@drawable/cs_oc_primary_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_use_flexi_now"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
