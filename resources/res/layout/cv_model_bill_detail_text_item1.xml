<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbdti_root"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/mbdti_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp10"
        android:layout_centerVertical="true"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbdti_tips_iv"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/mbdti_title_tv"
        android:layout_centerVertical="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp12"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/mbdti_remark_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/mbdti_title_tv"
        android:layout_centerVertical="true"
        style="@style/txt_mi_lg"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="right"
        android:id="@+id/mbdti_content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/mbdti_content_iv"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/mbdti_content_iv"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/content_divider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
