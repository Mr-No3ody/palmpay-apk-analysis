<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/qt_tab_text_color_purple_black"
        android:gravity="center"
        android:id="@+id/tvWithdraw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_withdraw"
        android:drawablePadding="@dimen/dp6"
        android:drawableStart="@drawable/qt_betting_tab_withdraw"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
