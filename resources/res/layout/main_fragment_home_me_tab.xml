<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56"
        app:layout_constraintTop_toBottomOf="@+id/statusBarView">
        <ViewStub
            android:id="@+id/userInfoStub"
            android:layout="@layout/main_layout_home_me_page_user_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_home_top_bar_height"/>
    </FrameLayout>
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarContainer">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutRoot"
                android:paddingBottom="50dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTopAdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    app:layout="@layout/main_layout_home_top_text_ad"
                    app:mode="0"/>
                <ViewStub
                    android:id="@+id/layoutGuestAssetsStub"
                    android:layout="@layout/main_model_banner_item_palmpay_no_balance_v2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivAssetsHolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/main_home_me_tab_asset_bg"/>
                    <ViewStub
                        android:id="@+id/layoutAssetsStub"
                        android:layout="@layout/main_layout_home_me_page_assets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <ViewStub
                        android:id="@+id/unVerifyUserStub"
                        android:visibility="gone"
                        android:layout="@layout/main_layout_unverify_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <ViewStub
                    android:id="@+id/fhm_kyc_stub"
                    android:layout="@layout/main_layout_me_page_kyc_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/fhm_my_quick_access_stub"
                    android:layout="@layout/main_me_page_quick_access"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginVertical="@dimen/main_home_fragment_vertical_margin"/>
                <ViewStub
                    android:id="@+id/fhm_my_business_stub"
                    android:layout="@layout/main_me_page_my_business_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/viewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:showDividers="middle"/>
                <ViewStub
                    android:id="@+id/logoutStub"
                    android:layout="@layout/main_layout_me_logout_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="6dp"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/securityStub"
                    android:layout="@layout/main_layout_me_page_security_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
    <ViewStub
        android:id="@+id/dragViewStub"
        android:layout="@layout/main_layout_home_me_tab_drag_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
