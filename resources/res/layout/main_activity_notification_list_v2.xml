<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/main_notifications"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="start"
        android:id="@+id/itvNotificationEnable"
        android:background="@color/ppColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_turn_on_system_notifications"
        android:drawablePadding="@dimen/dp8"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="75dp"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_NewsFill"
        app:iiv_start_size="16dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/Text.6f7b85.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="12dp"
        android:gravity="center"
        android:id="@+id/btnTurnOn"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_turn_on"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="@dimen/dp8"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/itvNotificationEnable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itvNotificationEnable"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupNotificationEnable"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btnTurnOn, itvNotificationEnable"/>
    <include
        android:id="@+id/item1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/dp32"
        app:layout_constraintEnd_toStartOf="@+id/item2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itvNotificationEnable"
        layout="@layout/main_layout_notification_list_header_item"/>
    <include
        android:id="@+id/item2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item1"
        app:layout_constraintTop_toTopOf="@+id/item1"
        layout="@layout/main_layout_notification_list_header_item"/>
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
