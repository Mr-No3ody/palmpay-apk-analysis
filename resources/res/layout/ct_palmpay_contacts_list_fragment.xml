<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/viewSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:transitionName="searchTransition">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center_vertical"
            android:id="@+id/editSearch"
            android:background="@drawable/ct_contact_search_bg"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="@string/ct_search"
            android:drawableLeft="@drawable/ct_search_icon"
            android:drawablePadding="6dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.custom_view.SwipeRecyclerView
            android:id="@+id/contact_rv"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@null"/>
        <com.transsnet.palmpay.contacts.ui.view.SideBarView
            android:id="@+id/side_bar"
            android:layout_width="20dp"
            android:layout_height="350dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:ct_press_bg_color="@color/ppColorTextAssist"
            app:ct_selectTextColor="@color/ppColorPrimary"
            app:ct_textColor="@color/ppColorTextPrimary"
            app:ct_with_favourite="true"/>
    </RelativeLayout>
</LinearLayout>
