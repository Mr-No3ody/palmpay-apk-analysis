<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/oc_all_bill_mtb"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="History"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/cs_all_bills"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp15"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_total_outstanding"/>
                <TextView
                    android:textSize="32sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/all_outstanding_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:layout_marginBottom="@dimen/dp6"
                    android:fontFamily="@font/cv_palmpay_number_bold"
                    android:layout_marginVertical="@dimen/dp6"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="center"
                    android:id="@+id/bill_count_tv"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_install_cycle_remain"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#cc333333"
                android:id="@+id/outstanding_bill_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_outstanding_bills"
                android:layout_marginStart="16sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/outstanding_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cc333333"
                android:id="@+id/cur_bill_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/cs_current_bill"
                android:layout_marginStart="16sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/current_bill_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cc333333"
                android:id="@+id/unpaid_bill_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/cs_unpaid_bills"
                android:layout_marginStart="16sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/unpaid_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/all_bill_repay_ll"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/oc_all_pay_bt"
            android:background="@drawable/cs_oc_agree_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/cs_oc_repay"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/dp16"
            android:layout_marginVertical="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/interest_amount_tv"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
</LinearLayout>
