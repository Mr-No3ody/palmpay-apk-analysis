<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp32"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.24"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp20"
        android:text="@string/cs_cl_to_obtain_credit_limit"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.202046.14"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRouteList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
    <include
        android:id="@+id/layoutCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvRouteList"
        layout="@layout/cv_layout_progress_countdown"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutCountdown"/>
</androidx.constraintlayout.widget.ConstraintLayout>
