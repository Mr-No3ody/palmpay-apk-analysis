<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:paddingLeft="@dimen/fb_dp15"
        android:paddingRight="@dimen/fb_dp15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp50">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/fb_mdp_close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/fb_dp15"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/fb_base_colorPrimary"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="@dimen/fb_dp18"
            android:textColor="@color/fb_text_color_purple"
            android:id="@+id/fb_mdp_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/fb_gray_bg_color_f2f3f8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp1"
        android:layout_marginLeft="@dimen/fb_dp15"
        android:layout_marginRight="@dimen/fb_dp15"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/fb_dp15"
        android:paddingRight="@dimen/fb_dp15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp153"
        android:layout_below="@+id/fb_mdp_title_tv">
        <com.flexibank.sdk.customview.wheelview.widget.FlexiBankWheelView
            android:id="@+id/fb_mdp_wheel_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="@dimen/fb_dp15"
            android:layout_height="match_parent"/>
        <com.flexibank.sdk.customview.wheelview.widget.FlexiBankWheelView
            android:id="@+id/fb_mdp_wheel_middle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="@dimen/fb_dp15"
            android:layout_height="match_parent"/>
        <com.flexibank.sdk.customview.wheelview.widget.FlexiBankWheelView
            android:id="@+id/fb_mdp_wheel_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/fb_mdp_confirm_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp50"
        android:text="@string/fb_confirm"
        style="@style/fbButtonStyle"/>
</LinearLayout>
