<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/llSheetPanel"
        android:background="@drawable/cs_cl_dialog_top_left_right_corner_24dp_f6f6fa_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/ivBack"
                android:padding="@dimen/dp14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_ArrowLeft"
                app:iiv_size="@dimen/dp20"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_transfer_by_loan_title"
                style="@style/Text.medium.202046.18"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cs_cl_transfer_by_loan_card_bg"
                    android:padding="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_principal"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/tvPrincipal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lib_ui_number_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_account_number"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/tvAccountNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lib_ui_number_bold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cs_cl_transfer_by_loan_card_bg"
                    android:padding="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_transfer_by_loan_tenure"
                        style="@style/Text.medium.202046.16"/>
                    <HorizontalScrollView
                        android:id="@+id/hsvTenure"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:fillViewport="false"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="true">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/llTenure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </HorizontalScrollView>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp12"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="@string/cs_transfer_by_loan_repayment_plan"
                        style="@style/Text.medium.202046.16"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextAssist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_payment_per_term"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/dp12"
                                android:textColor="@color/ppColorTextPrimary"
                                android:id="@+id/tvPaymentPerTerm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lib_ui_number_bold"/>
                            <TextView
                                android:textSize="@dimen/dp12"
                                android:textColor="@color/ppColorTextAssist"
                                android:id="@+id/tvPaymentPerTermOrigin"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lib_ui_number_bold"
                                android:layout_marginStart="@dimen/dp4"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextAssist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_payment_schedule"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="end"
                            android:id="@+id/tvPaymentSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextAssist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_first_payment_date"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/tvFirstPaymentDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp10"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_transfer_by_loan_total_repayment"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"/>
                        <LinearLayout
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorPrimary"
                                android:id="@+id/tvTotalRepayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lib_ui_number_bold"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextAssist"
                                android:id="@+id/tvTotalRepaymentOrigin"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lib_ui_number_bold"
                                android:layout_marginStart="@dimen/dp4"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llBanner"
            android:background="@color/ppColorAssisBackground"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8">
            <ImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:src="@drawable/cs_cl_ic_warning_f90"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_transfer_by_loan_banner"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llBottomBar"
            android:background="@color/ppColorAssist"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp16">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/LlAgreementTooltip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp5">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorBackgroundLight"
                    android:background="@drawable/cs_cl_transfer_by_loan_tooltip_bg"
                    android:paddingLeft="@dimen/dp8"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp8"
                    android:paddingBottom="@dimen/dp8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_transfer_by_loan_check_agreement"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp8"/>
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="4dp"
                    android:src="@drawable/cs_cl_transfer_by_loan_buttom"
                    android:layout_marginStart="@dimen/dp8"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/cbAgreement"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/cs_cl_checkbox_selector"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tvAgreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp8"/>
            </LinearLayout>
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/btnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/cs_transfer_by_loan_borrow_and_transfer"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressLoading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
