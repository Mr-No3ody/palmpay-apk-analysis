<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsnet.palmpay.core.viewmodel.PayMethodItem
        android:id="@+id/pmlf_use_new_bank_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.transsnet.palmpay.core.viewmodel.PayMethodItem
        android:id="@+id/pmlf_use_new_bank_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.transsnet.palmpay.core.viewmodel.PayMethodItem
        android:id="@+id/pmlf_use_new_bank_card_and_bank_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.transsnet.palmpay.core.viewmodel.PayMethodItem
        android:id="@+id/pmlf_use_ussd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
