<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/qt_tv_pre_check_bg"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ns_tv_pre_check"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp70">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cv_renew_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cv_shape_rect_top_corner_white_12"
                    android:paddingTop="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp40">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iv_biller_icon"
                            android:layout_width="@dimen/dp36"
                            android:layout_height="@dimen/dp36"
                            android:adjustViewBounds="true"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_biller_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:layout_marginStart="@dimen/dp8"
                            android:autoSizeMinTextSize="@dimen/dp16"
                            android:autoSizeMaxTextSize="@dimen/dp18"
                            app:autoSizeTextType="uniform"
                            style="@style/Text.medium.202046.16"/>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/tv_account_name_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:text="@string/qt_account_name"
                        style="@style/txt_mi_g"/>
                    <TextView
                        android:textSize="@dimen/dp22"
                        android:id="@+id/tv_account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        style="@style/txt_s_b_b"/>
                    <TextView
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/tv_number_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:text="@string/qt_tv_customer_id"
                        style="@style/txt_mi_g"/>
                    <TextView
                        android:textSize="@dimen/dp22"
                        android:id="@+id/tv_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        style="@style/txt_s_b_b"/>
                </LinearLayout>
                <ImageView
                    android:background="@drawable/qt_tv_pre_check_card_mid_bg"
                    android:paddingTop="@dimen/dp10"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp22"
                    android:src="@drawable/cv_shape_item_data_bundle_gray_line"
                    android:layerType="software"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="@dimen/dp20"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_renew_expired"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingTop="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp12"
                    android:paddingEnd="@dimen/dp16">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/qt_renew_current_bouquet_pay"
                            android:layout_weight="1"
                            style="@style/txt_s_b_b"/>
                        <CheckBox
                            android:id="@+id/cb_select_renew_bouquet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/cv_checkbox_selector1"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextDisable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp6"
                        android:text="@string/qt_renew_current_bouquet_pay_desc"
                        style="@style/txt_s_g"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_renew_expired"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_error"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        style="@style/txt_s_g"/>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginBottom="@dimen/dp8"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_new_bouquet"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp12">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/dp16">
                        <TextView
                            android:id="@+id/tv_new_bouquet_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/qt_buy_the_new_bouquet_desc"
                            android:layout_weight="1"
                            style="@style/txt_s_b_b"/>
                        <CheckBox
                            android:id="@+id/cb_select_new_bouquet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/cv_checkbox_selector1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/dp6"
                        android:paddingBottom="@dimen/dp6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:paddingVertical="@dimen/dp6">
                        <TextView
                            android:textColor="@color/ppColorTextAssist"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp60"
                            android:text="@string/qt_bouquet"
                            android:singleLine="true"
                            style="@style/txt_s_g"/>
                        <TextView
                            android:textColor="@color/ppColorTextPrimary"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:id="@+id/select_bouquet_name_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:paddingEnd="@dimen/dp16"
                            android:layout_marginStart="@dimen/dp20"
                            style="@style/txt_s_b"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/dp6"
                        android:paddingBottom="@dimen/dp6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/dp6">
                        <TextView
                            android:textColor="@color/ppColorTextAssist"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp60"
                            android:text="@string/qt_amount"
                            android:singleLine="true"
                            style="@style/txt_s_g"/>
                        <TextView
                            android:textColor="@color/ppColorTextPrimary"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:id="@+id/select_bouquet_amount_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:paddingEnd="@dimen/dp16"
                            android:layout_marginStart="@dimen/dp20"
                            style="@style/txt_s_b"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_bundle_view"
                        android:paddingTop="@dimen/dp8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_view"
                        style="@style/Text.medium.202046.14"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_bundle_view"
                        android:paddingTop="@dimen/dp8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iv_view_logo"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp80"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:layout_marginEnd="@dimen/dp8"/>
                        <TextView
                            android:gravity="start"
                            android:id="@+id/tv_view_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingEnd="@dimen/dp16"
                            style="@style/Text.202046.12"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp30"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12">
                    <TextView
                        android:textSize="@dimen/dp16"
                        android:textColor="@color/ppColorButtonTextWhite"
                        android:gravity="center"
                        android:id="@+id/tv_renew_pay"
                        android:background="@drawable/cv_button_bg_purple_corner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        style="@style/txt_me_w_b"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_renew_unexpired"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp18"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp18"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_renew_card">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_current_bouquet_detail"
                        android:layout_weight="1"
                        style="@style/txt_me_b"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/iv_renew_unexpired_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextNormal"
                        app:iiv_icon="pay_Arrowdown"
                        app:iiv_size="20dp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_renew_unexpired"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp18"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:paddingHorizontal="@dimen/dp16"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/tv_pre_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
