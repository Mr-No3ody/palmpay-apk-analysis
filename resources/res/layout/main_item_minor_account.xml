<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="12dp"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_avatar"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="@dimen/dp12"
        android:src="@drawable/cv_avatar_default"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/opLayout"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"
        app:layout_goneMarginLeft="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tvAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tvName"
        app:layout_constraintStart_toStartOf="@+id/tvName"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
    <FrameLayout
        android:id="@+id/opLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvName">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvOperate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="0dp"
            app:iiv_end_color="@color/ppColorTextNormal"
            app:iiv_end_icon="pay_ArrowRight"
            app:iiv_end_padding="@dimen/dp2"
            app:iiv_end_size="@dimen/dp20"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="right"
            android:id="@+id/tvStatus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvAccount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvName"/>
    </FrameLayout>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp11"
        app:layout_constraintTop_toBottomOf="@+id/tvAccount"/>
    <TextView
        android:id="@+id/tvApplicationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:text="Application time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"
        style="@style/Text.9ca2aa.12"/>
    <TextView
        android:id="@+id/tvApplicationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvApplicationTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"
        app:layout_constraintTop_toTopOf="@+id/tvApplicationTitle"
        style="@style/Text.9ca2aa.12"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvApplicationTime"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvApplicationTitle,tvApplicationTime,space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
