<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvTitle"
        android:layout_height="@dimen/dp48"
        android:text="@string/cs_verify_flexi_bank_account"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="@dimen/dp12"
        android:src="@drawable/cs_oc_close_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <ImageView
        android:id="@+id/ivCashLoan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:src="@drawable/cs_cl_cash_loan_card_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ivInstallmentLoan"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <ImageView
        android:id="@+id/ivInstallmentLoan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:src="@drawable/cs_cl_installment_loan_card_icon"
        app:layout_constraintLeft_toRightOf="@+id/ivCashLoan"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCashLoan"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_verify_palmpay_account_content"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ivCashLoan"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvVerifyPalmPayAccountTitle"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp28"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_verify_palmpay_account_by"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        style="@style/Text.medium.202046.14"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVerifyPalmPayAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifyPalmPayAccountTitle"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/ck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp16"
        android:checked="true"
        android:button="@drawable/cs_cl_checkbox_selector"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvVerifyPalmPayAccount"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvPrivacyPolicy"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ck"
        app:layout_constraintTop_toBottomOf="@+id/rvVerifyPalmPayAccount"
        style="@style/Text.6f7b85.10"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnAgree"
        android:background="@drawable/lib_ui_button_bg_corner_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/dp10"
        android:text="@string/core_agree"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvPrivacyPolicy"
        style="@style/ppFlexiCashDialogTheme"/>
</androidx.constraintlayout.widget.ConstraintLayout>
