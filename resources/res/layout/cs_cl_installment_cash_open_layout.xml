<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ivBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_cl_open_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/cl_ins_open_mtb"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="@dimen/dp24"
            app:layout_constraintTop_toTopOf="parent"
            app:title_bar_show_right_2_iv="false"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutContent"
            android:background="@drawable/cs_cl_installment_content_bg"
            android:paddingBottom="@dimen/dp18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="210dp"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutUpContent"
                android:background="@drawable/cs_cl_ins_middle_content_bg"
                android:paddingBottom="@dimen/dp50"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginHorizontal="@dimen/dp10"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textColor="@color/cv_color_b87900"
                    android:id="@+id/tvUpToInstallments"
                    android:background="@drawable/cs_cl_installments_info_bg"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:layout_height="@dimen/dp20"
                    android:paddingHorizontal="@dimen/dp10"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.12"/>
                <TextView
                    android:id="@+id/tvLoanableAmountTitle"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp42"
                    android:text="@string/cs_cl_loan_amount_up_to"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.12"/>
                <TextView
                    android:textSize="@dimen/dp32"
                    android:id="@+id/tvLoanableAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="₦500,000"
                    app:layout_constraintLeft_toLeftOf="@+id/tvLoanableAmountTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:id="@+id/tvLoanPeriodTitle"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp42"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/cs_cl_loan_period_up_to"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.12"/>
                <TextView
                    android:textSize="@dimen/dp32"
                    android:id="@+id/tvLoanPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="180"
                    app:layout_constraintLeft_toLeftOf="@+id/tvLoanPeriodTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvLoanPeriodTitle"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:layout_marginLeft="2dp"
                    android:text="@string/tv_days"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvLoanPeriod"
                    app:layout_constraintLeft_toRightOf="@+id/tvLoanPeriod"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp2"
                    app:layout_constraintStart_toStartOf="@+id/tvLoanPeriod"
                    app:layout_constraintTop_toBottomOf="@+id/tvLoanPeriod"/>
                <TextView
                    android:textColor="@color/ppColorFlexiCashPrimary"
                    android:id="@+id/tvDailyInterestLowRate"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp24"
                    android:text="Daily Interest low to 0.3%"
                    app:layout_constraintLeft_toLeftOf="@+id/tvLoanableAmountTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
                    style="@style/Text.medium.202046.14"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp36"
                    android:text="Borrow ₦1000 with lowest ₦1 interest per day"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintLeft_toLeftOf="@+id/tvLoanableAmountTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvDailyInterestLowRate"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutCurContent"
                android:background="@drawable/cs_cl_installment_cur_content"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp96"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="@dimen/dp14"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginHorizontal="@dimen/dp24"
                app:layout_constraintTop_toBottomOf="@+id/layoutUpContent">
                <TextView
                    android:background="@drawable/cs_cl_current_tag_bg"
                    android:layout_width="@dimen/dp56"
                    android:layout_height="@dimen/dp16"
                    android:text="Current"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.10"/>
                <TextView
                    android:id="@+id/tvCurLoanableAmountTitle"
                    android:layout_marginLeft="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp28"
                    android:text="@string/cs_cl_loan_amount_title"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.10"/>
                <TextView
                    android:textSize="@dimen/dp24"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tvCurLoanableAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    app:layout_constraintLeft_toLeftOf="@+id/tvCurLoanableAmountTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvCurLoanableAmountTitle"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:id="@+id/tvCurLoanPeriodTitle"
                    android:layout_marginTop="@dimen/dp28"
                    android:layout_marginRight="@dimen/dp48"
                    android:text="@string/cs_cl_loan_period"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.10"/>
                <TextView
                    android:textSize="@dimen/dp24"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tvCurLoanPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    app:layout_constraintLeft_toLeftOf="@+id/tvCurLoanPeriodTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvCurLoanPeriodTitle"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:layout_marginLeft="2dp"
                    android:text="@string/tv_days"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvCurLoanPeriod"
                    app:layout_constraintLeft_toRightOf="@+id/tvCurLoanPeriod"
                    style="@style/Text.6f7b85.10"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Space
                android:id="@+id/space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp28"
                app:layout_constraintTop_toBottomOf="@+id/layoutUpContent"/>
            <ImageView
                android:id="@+id/iv_upgradeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_cl_installment_link_icon"
                app:layout_constraintBottom_toTopOf="@+id/space"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:id="@+id/rtvUpgradeNow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp12"
                android:text="@string/core_apply"
                android:layout_marginHorizontal="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/layoutCurContent"
                app:rtv_background_color="@color/ppColorFlexiCashPrimary"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/Text.medium.ffffff.16"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/cs_cl_main_color"
                android:gravity="center_vertical"
                android:id="@+id/tvLearnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14"
                android:text="Learn more about installment"
                android:drawablePadding="4dp"
                app:iiv_end_color="@color/ppColorTextNormal"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp12"
                app:layout_constraintEnd_toEndOf="@+id/rtvUpgradeNow"
                app:layout_constraintStart_toStartOf="@+id/rtvUpgradeNow"
                app:layout_constraintTop_toBottomOf="@+id/rtvUpgradeNow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/cs_bank_aprroved_bottom"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp34"
            android:layout_marginBottom="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
