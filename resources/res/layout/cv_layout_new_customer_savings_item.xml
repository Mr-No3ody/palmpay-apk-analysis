<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_12"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:paddingBottom="@dimen/dp4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rectangle_gradient_944_to_428"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_saving_gift"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTop"
            android:paddingLeft="8dp"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp12"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="left"
                android:id="@+id/tvIntroduction"
                android:layout_width="0dp"
                android:layout_marginRight="108dp"
                android:lineSpacingMultiplier="1.1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.ffffff.16"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBottom"
            android:background="@drawable/cv_rect_corner_12_bg_white"
            android:paddingLeft="@dimen/dp8"
            android:paddingRight="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp6"
            android:layout_marginRight="@dimen/dp6"
            android:layout_marginHorizontal="@dimen/dp6"
            android:paddingHorizontal="@dimen/dp8"
            app:layout_constraintDimensionRatio="82:15"
            app:layout_constraintTop_toBottomOf="@+id/layoutTop">
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvInterestAmount"
                android:layout_marginLeft="@dimen/dp12"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toTopOf="@+id/tvInterestPa"
                app:layout_constraintLeft_toRightOf="@+id/ivIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvPercent"
                android:text="%"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvInterestAmount"
                app:layout_constraintLeft_toRightOf="@+id/tvInterestAmount"
                style="@style/Text.medium.202046.10"/>
            <TextView
                android:id="@+id/tvInterestPa"
                android:text="Interest p.a."
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/tvInterestAmount"
                app:layout_constraintLeft_toRightOf="@+id/ivIcon"
                app:layout_constraintTop_toBottomOf="@+id/tvInterestAmount"
                style="@style/Text.6f7b85.10"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:barrierDirection="right"
                app:constraint_referenced_ids="tvInterestAmount,tvInterestPa"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvDurationNum"
                android:layout_marginLeft="@dimen/dp24"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toTopOf="@+id/tvDuration"
                app:layout_constraintLeft_toRightOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tvDurationDay"
                android:layout_marginLeft="3dp"
                android:text="Days"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvDurationNum"
                app:layout_constraintLeft_toRightOf="@+id/tvDurationNum"
                style="@style/Text.medium.202046.10"/>
            <TextView
                android:id="@+id/tvDuration"
                android:text="Duration"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/tvDurationNum"
                app:layout_constraintTop_toBottomOf="@+id/tvDurationNum"
                style="@style/Text.6f7b85.10"/>
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:id="@+id/rtvInvest"
                android:layout_width="@dimen/dp64"
                android:layout_height="@dimen/dp32"
                android:text="Save"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rtv_background_color="@color/ppColorFlexiCashAssist"
                app:rtv_corner_radius="@dimen/dp16"
                style="@style/Text.medium.ffffff.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
