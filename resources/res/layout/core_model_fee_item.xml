<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/mfi_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        style="@style/txt_s_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mfi_tips_iv"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/mfi_title_tv"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/mfi_tips_iv"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/mfi_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:text="@string/core_digit_0"
            android:layout_weight="1"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="15dp"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#95a1ab"
            android:gravity="end"
            android:id="@+id/origin_amount_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="7dp"/>
        <ImageView
            android:id="@+id/iv_right"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:src="@drawable/cv_success_small"
            android:layout_marginStart="@dimen/dp5"/>
    </LinearLayout>
    <View
        android:background="@color/ppColorDividerLineDark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</merge>
