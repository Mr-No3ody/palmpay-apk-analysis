<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_all_verify_top_bar"
        layout="@layout/cs_oc_router_top_bar"/>
    <ImageView
        android:layout_width="@dimen/dp52"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp24"
        android:src="@drawable/cs_oc_top_bank_icon"/>
    <TextView
        android:textColor="#858a8f"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_oc_add_any_of_bank_info"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/oc_bank_card_tv"
        android:background="@drawable/cv_rect_corner_8_solid_121212"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginTop="@dimen/dp30"
        android:text="@string/cs_oc_bank_card"
        android:drawablePadding="@dimen/dp16"
        android:drawableStart="@drawable/cs_oc_bank_card_icon"
        android:drawableEnd="@drawable/cs_oc_bank_right_arrow_icon"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/oc_bank_account_tv"
        android:background="@drawable/cv_rect_corner_8_solid_121212"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginTop="@dimen/dp30"
        android:text="@string/cs_oc_bank_account"
        android:drawablePadding="@dimen/dp16"
        android:drawableStart="@drawable/cs_oc_bank_account_icon"
        android:drawableEnd="@drawable/cs_oc_bank_right_arrow_icon"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/oc_bvn_tv"
        android:background="@drawable/cv_rect_corner_8_solid_121212"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginTop="@dimen/dp30"
        android:text="@string/cs_oc_bvn"
        android:drawablePadding="@dimen/dp16"
        android:drawableStart="@drawable/cs_oc_bvn_icon"
        android:drawableEnd="@drawable/cs_oc_bank_right_arrow_icon"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
</LinearLayout>
