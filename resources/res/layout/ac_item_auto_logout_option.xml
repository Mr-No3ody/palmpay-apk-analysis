<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ac_selector_auto_logout_option_page"
    android:padding="@dimen/dp12"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp66">
    <com.mikepenz.iconics.view.IconicsCheckBox
        android:id="@+id/cbOption"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        app:iiv_checked_color="@color/ppColorPrimary"
        app:iiv_checked_icon="pay_SelectedFill"
        app:iiv_checked_size="@dimen/dp20"
        app:iiv_unchecked_color="@color/ppColorTextAssist"
        app:iiv_unchecked_icon="pay_CircleOutline"
        app:iiv_unchecked_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toStartOf="@+id/cbOption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="start"
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cbOption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.9ca2aa.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
