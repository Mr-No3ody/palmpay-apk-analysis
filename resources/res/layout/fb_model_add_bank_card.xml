<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fb_mabc_root"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fb_dp70">
    <ImageView
        android:id="@+id/fb_mabc_access_bank_iv"
        android:layout_width="@dimen/fb_dp35"
        android:layout_height="@dimen/fb_dp35"
        android:layout_marginLeft="@dimen/fb_dp15"
        android:src="@drawable/fb_add_circle_purple"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp10"
        android:layout_toRightOf="@+id/fb_mabc_access_bank_iv"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/fb_dp16"
            android:textColor="@color/fb_text_color_black1"
            android:id="@+id/fb_mabc_title_text_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fb_add_bank_card"/>
        <TextView
            android:textSize="@dimen/fb_dp14"
            android:textColor="@color/fb_text_color_black1"
            android:id="@+id/fb_mabc_hint_text_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/fb_unsupported_now"/>
    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/fb_dp15"
        android:src="@drawable/fb_arrow_drop_down"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
