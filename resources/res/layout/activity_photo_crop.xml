<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.photograph.crop.CropView
        android:id="@+id/photograph_crop_view"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/crop_action_layout"
        app:crop_bound_color="@color/photograph_colorPrimaryDark"
        app:crop_bound_width="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/crop_action_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cancelBtn"
            android:background="@color/photograph_colorPrimaryDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/photograph_no"
            android:layout_weight="1"/>
        <View
            android:background="@color/photograph_colorBackground"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/doneBtn"
            android:background="@color/photograph_colorPrimaryDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/photograph_yes"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
