<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="@dimen/dp9"
    android:paddingBottom="@dimen/dp9"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp16">
    <ImageView
        android:id="@+id/payment_img"
        android:layout_width="@dimen/dp38"
        android:layout_height="@dimen/dp38"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.13"
        app:srcCompat="@drawable/cs_data_bundle_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/payment_name_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/payment_num_tv"
        app:layout_constraintEnd_toStartOf="@+id/first_tv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/payment_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/first_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_oc_first"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/payment_num_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/payment_name_tv"
        app:layout_constraintStart_toStartOf="@+id/payment_name_tv"
        app:layout_constraintTop_toBottomOf="@+id/payment_name_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
