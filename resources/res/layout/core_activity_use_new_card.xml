<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/core_faqs"
        app:title_bar_title="Use New Bank Card"/>
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/adView"
        android:background="#f0ecfc"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/cv_notify_icon"
        android:paddingStart="12dp"
        app:slot_id="@string/add_card_txt_slot_id"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:id="@+id/top_tips_tv"
        android:background="#f8f1ff"
        android:paddingTop="@dimen/dp10"
        android:paddingBottom="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:text="@string/core_binding_bank_card"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/core_please_fill_in_the_card_information"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_card_number_title"
        style="@style/AddCardItemTitleStyle"/>
    <EditText
        android:id="@+id/card_num_et"
        android:background="@drawable/core_common_et_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/core_enter_card_number"
        android:maxLength="23"
        android:inputType="number"
        style="@style/AddCardItemContentStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvError1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AddCardItemErrorStyle"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_bank"
        style="@style/AddCardItemTitleStyle"/>
    <com.transsnet.palmpay.core.viewmodel.ModelBankCardItem1
        android:id="@+id/bank_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_valid_thru_title"
        style="@style/AddCardItemTitleStyle"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/valid_date_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/core_select_date"
        app:iiv_end_color="@color/ppColorPrimary"
        app:iiv_end_icon="pay_Arrowdown"
        app:iiv_end_size="@dimen/dp16"
        style="@style/AddCardItemContentStyle"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp8"
        style="@style/AddCardItemContentStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvError2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AddCardItemErrorStyle"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvCvvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_cvv"
        android:drawablePadding="4dp"
        app:iiv_end_color="@color/ppColorTextPrimary"
        app:iiv_end_icon="pay_Question"
        app:iiv_end_size="@dimen/dp16"
        style="@style/AddCardItemTitleStyle"/>
    <EditText
        android:id="@+id/cvv_et"
        android:background="@drawable/core_common_et_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/core_enter_cvv"
        android:inputType="number"
        style="@style/AddCardItemContentStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvError3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/AddCardItemErrorStyle"/>
    <Button
        android:enabled="false"
        android:textSize="@dimen/dp18"
        android:textColor="@color/ppColorTextBase"
        android:layout_gravity="center_horizontal"
        android:id="@+id/next_bt"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_next"
        android:textAllCaps="false"
        android:elevation="@dimen/dp5"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#3c4abc"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_other_method_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginBottom="16dp"
        android:text="@string/core_select_other_method"/>
</LinearLayout>
