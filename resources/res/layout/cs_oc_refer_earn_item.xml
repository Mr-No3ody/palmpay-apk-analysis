<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/parent"
    android:background="@drawable/cs_refer_earn_invite_nomal"
    android:layout_width="match_parent"
    android:layout_height="127dp">
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvPhoneNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp14"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp7"
        android:src="@drawable/cs_refer_earn_okcard"
        android:layout_below="@+id/tvPhoneNum"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvInvite"
        android:background="@drawable/cs_refer_earn_item_bt_bg"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_invite"
        android:layout_below="@+id/ivIcon"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="@dimen/dp12"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvCash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:layout_below="@+id/ivIcon"
        android:layout_centerHorizontal="true"
        android:drawableStart="@drawable/cs_oc_refer_earn_cash"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvStatus"
        android:background="@drawable/cs_refer_earn_invite_bottom_succ"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp24"
        android:layout_alignParentBottom="true"
        android:fontFamily="sans-serif-medium"/>
</RelativeLayout>
