<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/lib_ui_toast_bg_corner"
    android:paddingTop="@dimen/ppToastVerticalMargin"
    android:paddingBottom="@dimen/ppToastVerticalMargin"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/ppToastVerticalMargin">
    <com.palmpay.lib.ui.dialog.loading.LoadingView
        android:layout_width="@dimen/ppToastIconSize"
        android:layout_height="@dimen/ppToastIconSize"
        android:src="@drawable/lib_ui_icon_loading_ffffff_23dp"/>
    <TextView
        android:textSize="@dimen/ppToastTextSize"
        android:textColor="@color/ppColorTextBase"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/loading_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppToastHorizontalMargin"
        android:layout_marginTop="11dp"
        android:layout_marginRight="@dimen/ppToastHorizontalMargin"
        android:maxWidth="@dimen/ppToastBgMaxWidth"
        android:minWidth="@dimen/ppToastBgMinWidth"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/ppToastHorizontalMargin"/>
</LinearLayout>
