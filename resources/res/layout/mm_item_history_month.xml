<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_container_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_temp"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:paddingStart="@dimen/large_margin"
        android:paddingEnd="@dimen/extra_margin">
        <TextView
            android:textSize="@dimen/dp20"
            android:id="@+id/abl_month_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/cv_icon_drop_down"
            android:drawablePadding="3dp"
            android:layout_centerVertical="true"
            style="@style/txt_s_b_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/abl_month_tv">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/money_in_textViewSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:layout_marginStart="@dimen/dp2"
                android:layout_marginEnd="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/money_out_textViewSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:layout_marginEnd="@dimen/extra_margin"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
