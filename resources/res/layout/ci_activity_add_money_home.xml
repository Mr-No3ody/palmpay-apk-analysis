<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_right_iconfont_1="pay_CustomerService"
        app:title_bar_right_iconfont_color_1="@color/ppColorTextPrimary"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/core_add_money"/>
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/viewMarquee"
        android:background="@color/ppColorBackgroundLight"
        android:paddingRight="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:drawablePadding="4dp"
        android:paddingStart="12dp"
        app:slot_id="@string/fund_main_txt_slot_id"/>
    <ViewStub
        android:id="@+id/vs_cashbox_trial_cash"
        android:layout="@layout/cash_layout_cashbox_trial_cash"
        android:inflatedId="@+id/layout_cashbox_trial_cash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/layoutInterBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"
                layout="@layout/ci_layout_add_money_item"/>
            <ViewStub
                android:id="@+id/vsRewardsCommon"
                android:layout="@layout/ci_layout_add_money_rewards_card"
                android:inflatedId="@+id/layoutRewards"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp84"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:text="@string/ci_str_or"
                    style="@style/Text.9ca2aa.14"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenuList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.banner.BannerAdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:slot_id="@string/ad_fund_home_slot_id2"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/ca_bottom_ad"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:slot_id="@string/add_money_page_bottom_ad"/>
</LinearLayout>
