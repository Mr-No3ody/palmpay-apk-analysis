<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp16">
            <TextView
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/ac_guardian_auth_confirm_title"
                style="@style/Text.medium.202046.18"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/ac_guardian_auth_confirm_desc"
                android:lineSpacingMultiplier="1.3"
                style="@style/Text.6f7b85.14"/>
            <FrameLayout
                android:id="@+id/layoutMinorCard"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerKeyValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16">
        <LinearLayout
            android:gravity="start|top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsCheckBox
                android:id="@+id/checkAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:iiv_checked_color="@color/ppColorTextPrimary"
                app:iiv_checked_icon="pay_CheckboxFill"
                app:iiv_checked_size="16dp"
                app:iiv_unchecked_color="@color/ppColorTextPrimary"
                app:iiv_unchecked_icon="pay_CheckboxOutline"
                app:iiv_unchecked_size="16dp"/>
            <TextView
                android:textAppearance="@style/txt_mi_g"
                android:textSize="@dimen/dp12"
                android:gravity="start|top"
                android:id="@+id/tvAgreement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:enabled="true"
            android:gravity="center"
            android:id="@+id/btnAuthorize"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp16"
            android:text="@string/ac_continue"
            android:textAllCaps="false"
            style="@style/ppButtonStyle"/>
        <ViewStub
            android:id="@+id/bottomViewStub"
            android:layout="@layout/cv_layout_login_register_bottom_view"
            android:inflatedId="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
