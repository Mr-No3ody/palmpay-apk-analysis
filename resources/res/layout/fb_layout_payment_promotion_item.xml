<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/fb_dp12"
    android:paddingRight="@dimen/fb_dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/fb_dp32"
    android:paddingHorizontal="@dimen/fb_dp12">
    <TextView
        android:id="@+id/fb_tv_promotion_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fb_barrier_right"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_Text.202046.14"/>
    <TextView
        android:gravity="end"
        android:id="@+id/fb_tv_promotion_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/fb_dp4"
        android:layout_marginEnd="@dimen/fb_dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/fb_iv_promotion_icon"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:textColor="@color/fb_text_color_gray8"
        android:id="@+id/fb_tv_promotion_calc_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/fb_iv_promotion_calc_arrow"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fb_tv_promotion_key"
        style="@style/fb_txt_s_b_b"/>
    <ImageView
        android:id="@+id/fb_iv_promotion_calc_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp3"
        android:layout_marginRight="@dimen/fb_dp3"
        android:src="@drawable/fb_arrow_change"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fb_tv_promotion_calc_amount"
        app:layout_constraintStart_toEndOf="@+id/fb_tv_promotion_calc_value"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorWarning"
        android:id="@+id/fb_tv_promotion_calc_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fb_dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/fb_iv_promotion_icon"
        app:layout_constraintStart_toEndOf="@+id/fb_iv_promotion_calc_arrow"
        style="@style/fb_txt_s_b_b"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/fb_barrier_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="fb_iv_promotion_calc_arrow,fb_tv_promotion_value,fb_tv_promotion_calc_value,fb_tv_promotion_calc_amount"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/fb_group_promotion_calc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="fb_tv_promotion_calc_value,fb_iv_promotion_calc_arrow"/>
    <ImageView
        android:id="@+id/fb_iv_promotion_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/fb_arrow_right_gray2"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
