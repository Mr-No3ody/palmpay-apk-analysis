<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp12"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivSecurity"
        android:background="@drawable/cv_shape_circle_e4f7f0"
        android:padding="@dimen/dp8"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp32"
        app:iiv_color="@color/ppColorSuccess"
        app:iiv_icon="pay_Security"
        app:iiv_size="@dimen/dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_recipient_confirm"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivSecurity"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp16"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clName"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary_stroke_disabled"
        android:padding="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage">
        <TextView
            android:id="@+id/tvNameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_name"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.12"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNameTitle"
            style="@style/Text.medium.6306b2.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llRecipientInfo"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clName">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_recipient_account"
                android:includeFontPadding="false"
                style="@style/Text.202046.12"/>
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvAccountNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/Text.medium.202046.16"/>
        </LinearLayout>
        <View
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvBankTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_bank"
                android:includeFontPadding="false"
                style="@style/Text.202046.12"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp24"
                android:layout_marginTop="@dimen/dp8">
                <ImageView
                    android:id="@+id/ivBank"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tvBankName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp4"
                    style="@style/Text.medium.202046.16"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llRecipientInfo">
        <TextView
            android:gravity="center"
            android:id="@+id/tvRecheck"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="@string/core_recheck"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp12"
            style="@style/Text.medium.6306b2.16"/>
        <TextView
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="@string/core_confirm"
            android:layout_weight="1"
            style="@style/txt_me_w_b"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
