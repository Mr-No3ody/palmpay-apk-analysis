<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/jp_refer_earn_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/jp_resolve"
        app:title_bar_title_color="@color/ppColorBackgroundLight"/>
    <com.transsnet.palmpay.custom_view.ObservableScrollView
        android:id="@+id/scrollView_referEarn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp24">
            <TextView
                android:textSize="@dimen/dp18"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jp_resolve_tip_1"
                android:fontFamily="sans-serif-black"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="#afafaf"
                android:gravity="center"
                android:id="@+id/tvResolveTip2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:text="@string/jp_resolve_tip_2"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/jp_refer_earn_details_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp16"
                        android:textColor="#ffce33"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="@string/jp_authentication_rate_s"
                        android:fontFamily="sans-serif-black"/>
                    <TextView
                        android:textSize="@dimen/dp30"
                        android:textColor="@color/ppColorTextBase"
                        android:gravity="center_horizontal"
                        android:id="@+id/tvResolveRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/seekBarProgress"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginLeft="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp30"
                    android:progressDrawable="@drawable/jp_re_seekbar_style"
                    android:layout_marginHorizontal="@dimen/dp30"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <Button
                    android:enabled="false"
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/jp_cash_invite_btn"
                    android:background="@drawable/jp_shape_orange_bg"
                    android:layout_width="124dp"
                    android:layout_height="@dimen/dp33"
                    android:layout_marginLeft="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp18"
                    android:layout_marginBottom="@dimen/dp14"
                    android:text="@string/jp_withdraw"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginHorizontal="@dimen/dp18"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/jp_cash_invite_expire"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/jp_refer_earn_details_bg"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:paddingVertical="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/jp_invitees"
                    android:fontFamily="sans-serif-black"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvResolve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/ivExpand"
                    android:paddingLeft="@dimen/dp15"
                    android:paddingTop="@dimen/dp20"
                    android:paddingRight="@dimen/dp15"
                    android:paddingBottom="@dimen/dp20"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/jp_cash_expand"
                    android:paddingHorizontal="@dimen/dp15"
                    android:paddingVertical="@dimen/dp20"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llResolveHow"
                android:background="@drawable/jp_refer_earn_details_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp28"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp28"
                    android:text="@string/jp_how_to_complete_real_name"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginHorizontal="@dimen/dp28"/>
            </LinearLayout>
            <View
                android:layout_width="@dimen/dp1"
                android:layout_height="@dimen/dp16"/>
        </LinearLayout>
    </com.transsnet.palmpay.custom_view.ObservableScrollView>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvWithdraw"
        android:background="#6531e7"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:text="@string/jp_withdraw"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
