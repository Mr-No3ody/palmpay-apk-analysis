<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp30"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp12"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintEnd_toStartOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_premium_benefits"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <ImageView
        android:id="@+id/ivLevelIcon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp13"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.202046.10"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/tvMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <com.transsnet.palmpay.ui.view.ModelPremiumScrollNotice
        android:id="@+id/scrollNotice"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toStartOf="@+id/tvMore"
        app:layout_constraintStart_toEndOf="@+id/ivLevelIcon"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:gravity="end"
        android:id="@+id/tvNotice"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toStartOf="@+id/tvMore"
        app:layout_constraintStart_toEndOf="@+id/ivLevelIcon"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/Text.000000.12"/>
    <View
        android:id="@+id/viewClickNotice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="@+id/tvMore"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llPremiumTrial"
        android:background="@drawable/main_reward_premium_trial_bg"
        android:padding="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp8"
        android:layout_marginHorizontal="@dimen/dp12"
        android:layout_marginVertical="@dimen/dp8"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon">
        <ImageView
            android:id="@+id/ivTrialIcon"
            android:layout_width="@dimen/dp22"
            android:layout_height="@dimen/dp22"
            android:adjustViewBounds="true"/>
        <TextView
            android:textColor="@color/main_color_premium"
            android:gravity="start"
            android:id="@+id/tvTrialContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp8"
            style="@style/Text.medium.202046.12"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp24">
            <TextView
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/btnTrial"
                android:paddingLeft="@dimen/dp8"
                android:paddingRight="@dimen/dp8"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp24"
                android:minWidth="@dimen/dp44"
                android:paddingHorizontal="@dimen/dp8"
                style="@style/Text.medium.202046.10"/>
            <com.wang.avi.AVLoadingIndicatorView
                android:layout_gravity="center"
                android:id="@+id/loadingIndicator"
                android:visibility="gone"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:indicatorColor="@color/ppColorButtonTextWhite"
                app:indicatorName="BallSpinFadeLoaderIndicator"
                style="@style/AVLoadingIndicatorView.Large"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/main_reward_premium_benefits_bg"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp8"
        android:layout_marginHorizontal="@dimen/dp12"
        android:layout_marginVertical="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintTop_toBottomOf="@+id/llPremiumTrial">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBenefits"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp102"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIndicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp3"/>
    </LinearLayout>
</merge>
