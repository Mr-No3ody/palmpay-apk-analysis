<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_13_bg_white_stroke_disabled"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp10"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp60"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp10">
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv_time"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.16"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/btn_renewal"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/btn_renewal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/Text.6f7b85.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_renewal"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="@dimen/dp62"
        android:layout_height="@dimen/dp24"
        android:text="@string/qt_renewal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.ffffff.12"/>
</merge>
