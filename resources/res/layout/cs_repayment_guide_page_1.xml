<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCalendarCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:id="@+id/tvFirstRepaymentDateLabel"
            android:layout_marginTop="@dimen/dp48"
            android:text="@string/cs_repayment_guide_first_repayment_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.ffffff.10"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDateM"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFirstRepaymentDateLabel"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDateD"
            android:fontFamily="@font/lib_ui_number_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDateM"
            style="@style/Text.medium.202046.48"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvOutstandingLabel"
            android:layout_marginTop="@dimen/dp22"
            android:text="@string/cs_repayment_guide_first_term_outstanding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDateD"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvRepaymentAmount"
            android:layout_marginTop="@dimen/dp2"
            android:fontFamily="@font/lib_ui_number_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOutstandingLabel"
            style="@style/Text.medium.202046.24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llTransferRepayAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRepaymentAmount">
            <TextView
                android:id="@+id/tvTransferRepayAccountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_repayment_guide_transfer_repay_account_label"
                style="@style/Text.6f7b85.12"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/tvTransferRepayAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lib_ui_number_bold"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.202046.12"/>
            <ImageView
                android:id="@+id/ivTransferRepayCopy"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:src="@drawable/cv_copy_1"
                android:contentDescription="@string/cs_repayment_guide_transfer_repay_copy"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
