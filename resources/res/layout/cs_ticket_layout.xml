<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#e9e5ff"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/cs_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/cs_ticket_icon"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="22sp"
                android:textColor="#8312ff"
                android:id="@+id/cs_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                app:layout_constraintLeft_toRightOf="@+id/cs_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#263138"
                android:id="@+id/cs_ticket_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                app:layout_constraintLeft_toRightOf="@+id/cs_icon"
                app:layout_constraintTop_toBottomOf="@+id/cs_amount"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#263138"
                android:id="@+id/cs_ticket_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                app:layout_constraintLeft_toRightOf="@+id/cs_icon"
                app:layout_constraintTop_toBottomOf="@+id/cs_ticket_name"/>
            <ImageView
                android:id="@+id/cs_selector"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="47dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/cs_ticket_select"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.transsnet.palmpay.credit.view.DashLine
                android:id="@+id/cs_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                app:cs_dash_color="#8312ff"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cs_ticket_condition"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/cs_g1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0"/>
            <androidx.cardview.widget.CardView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:cardBackgroundColor="@color/ppColorBackgroundLight"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/cs_line"
                app:layout_constraintLeft_toLeftOf="@+id/cs_g1"
                app:layout_constraintRight_toRightOf="@+id/cs_g1"
                app:layout_constraintTop_toTopOf="@+id/cs_line"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/cs_g2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:cardBackgroundColor="@color/ppColorBackgroundLight"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/cs_line"
                app:layout_constraintLeft_toLeftOf="@+id/cs_g2"
                app:layout_constraintRight_toRightOf="@+id/cs_g2"
                app:layout_constraintTop_toTopOf="@+id/cs_line"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cs_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cs_line">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/cs_valid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/cs_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="12dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/cs_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/cs_cl_bw_coupon_down_arrow_icon"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cs_line"/>
            <ImageView
                android:id="@+id/cs_ticket_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/cs_ticket_tag"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
