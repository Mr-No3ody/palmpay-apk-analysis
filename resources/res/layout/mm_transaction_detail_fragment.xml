<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ctb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Transaction Detail"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/dp36"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layoutOrderInfo"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp24"
                android:paddingRight="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp12"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tvOrderDesc"
                    style="@style/Text.202046.14"/>
                <TextView
                    android:id="@+id/tvOrderAmount"
                    android:layout_marginTop="@dimen/dp4"
                    style="@style/Text.medium.202046.32"/>
                <TextView
                    android:id="@+id/tvOrderStatus"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp4"
                    android:drawableLeft="@drawable/cv_icon_success_small"
                    android:drawablePadding="@dimen/dp4"
                    style="@style/Text.858a8f.12"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutTransactionInfoExtend"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/layoutOrderInfo"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutTransactionInfo"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/layoutTransactionInfoExtend"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultCustomerServiceModel
                android:id="@+id/viewCustomerService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/layoutTransactionInfo"/>
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/mm_icon_fixed_savings"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.custom_view.model.OrderResultViewReceiptModel
        android:id="@+id/viewReceipt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"/>
</LinearLayout>
