<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/titleBar"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                app:title_bar_show_right_1_iv="true"/>
            <View
                android:id="@+id/titleBarBg"
                android:background="@color/ppColorBackgroundLight"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp56"/>
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/viewHeader"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llOrderInfo"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp4"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/viewDetail"
                android:background="@color/ppColorBackgroundLight"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/tvDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_view_detail"
                    style="@style/txt_s_b_b"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ivDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_ArrowRight"
                    app:iiv_size="16dp"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llBottom"
        android:background="@color/md_white_1000"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/md_white_1000"
            android:gravity="center"
            android:id="@+id/tvComplete"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp40"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
