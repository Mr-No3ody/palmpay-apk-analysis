<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/p2p_state"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/p2p_state_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p2p_str_state"/>
        <ImageView
            android:id="@+id/p2p_state_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/cv_arrow_down_black"
            android:tint="@color/ppColorTextPrimary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/p2p_government_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/p2p_government_area_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p2p_str_government_area"/>
        <ImageView
            android:id="@+id/p2p_lga_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/cv_arrow_down_black"
            android:tint="@color/ppColorTextPrimary"/>
    </LinearLayout>
</LinearLayout>
