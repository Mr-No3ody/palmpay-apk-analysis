<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/bundle_app_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="exitUntilCollapsed|scroll">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?android:attr/actionBarSize"
                app:layout_collapseMode="none">
                <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
                    android:id="@+id/ad_home_text"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp36"
                    android:paddingHorizontal="@dimen/dp16"
                    app:ad_drawable_padding="@dimen/dp8"
                    app:ad_text_color="@color/ppColorTextPrimary"
                    app:ad_text_size="@dimen/dp12"
                    app:slot_id="@string/ad_send_money_bank_recently_text_banner_slot_id"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/avs_transfer_via_ussd"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/sm_layout_transfer_via_ussd"
                    app:mode="2"/>
                <ViewStub
                    android:id="@+id/refundViewStub"
                    android:layout="@layout/sm_layout_to_bank_home_advanced_refund"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/sa_top_horizontal_margin"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:slot_id="@string/ad_transfer_to_bank_home_top_margin_slot_id"/>
                <FrameLayout
                    android:id="@+id/flBenefitsBanner"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp8">
                    <ViewFlipper
                        android:orientation="vertical"
                        android:id="@+id/viewFlipper"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp18"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:flipInterval="3000"
                        android:layout_marginHorizontal="@dimen/dp16"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llTransferAccountCard"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llTransferSafe"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp16">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_Security"
                            app:iiv_size="@dimen/dp16"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorSuccess"
                            android:id="@+id/tvTransferSafeContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp4"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivTransferSafeArrow"
                            android:layout_width="@dimen/dp12"
                            android:layout_height="@dimen/dp12"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_ArrowCenterRight"
                            app:iiv_size="@dimen/dp12"/>
                    </LinearLayout>
                    <com.transsnet.palmpay.send_money.ui.view.TransferToBankAccountView
                        android:id="@+id/fcv_add_bank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.transsnet.palmpay.send_money.ui.view.TransferHomeEntranceView
                    android:id="@+id/transferEntranceView"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="8dp"
                    android:paddingTop="5dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="8dp"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tv_schedule_transfer_entrance"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp48"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/sm_ic_schedule_transfer_for_bank_unstable"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    app:iiv_end_color="@color/ppColorTextAssist"
                    app:iiv_end_icon="pay_ArrowCenterRight"
                    app:iiv_end_size="@dimen/dp16"
                    style="@style/Text.medium.202046.14"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/ad_user_type"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp48"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_s_b"/>
            </LinearLayout>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.palmpay.lib.ui.titlebar.PpTitleBar
                        android:id="@+id/titleBar"
                        android:background="@color/ppColorBackgroundLight"
                        android:layout_width="match_parent"
                        android:layout_height="?android:attr/actionBarSize"
                        app:layout_constraintTop_toTopOf="parent"
                        app:title_bar_right_iconfont_1="pay_Menu"
                        app:title_bar_show_right_1_iv="true"
                        app:title_bar_title="@string/sm_transfer_to_bank"/>
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/cl_tab"
            android:background="@drawable/cv_shape_rect_top_corner_white_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp40"
                app:layout_constraintEnd_toStartOf="@+id/tv_view_full"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/core_tab_indicator_25"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabPaddingEnd="@dimen/dp8"
                app:tabPaddingStart="@dimen/dp8"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/ppColorPrimary"
                app:tabTextAppearance="@style/NormalTextStyle"
                app:tabTextColor="@color/ppColorTextPrimary"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/tv_view_full"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_Search"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="@+id/tabLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tabLayout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_beneficiary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.transsnet.palmpay.core.ui.widget.DragView
        android:layout_gravity="end|bottom"
        android:id="@+id/dv_to_bank_home_ad"
        android:visibility="gone"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="16dp">
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/ad_to_bank_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:slot_id="@string/sm_transfer_to_bank_home_dialog_slot_id"/>
    </com.transsnet.palmpay.core.ui.widget.DragView>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/vsScheduleNextOrder"
        android:layout="@layout/sm_layout_schedule_transfer_next_order"
        android:inflatedId="@+id/clScheduleNextOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
