<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cs_oc_feedback_submit_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/no_permission_closeI_img"
        android:padding="@dimen/extra_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/cv_close_grey"
        android:scaleType="fitXY"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cs_cl_activate_permission_title"
        android:lineSpacingExtra="6dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/no_permission_closeI_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/no_permission_closeI_img"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/no_permission_content_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cs_cl_no_permission_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview19"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/permission_content_rv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_permission_content_tv"/>
    <com.transsnet.palmpay.credit.view.CountdownTextView
        android:textSize="16sp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:id="@+id/no_permission_sure_bt"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp26"
        android:layout_marginBottom="24dp"
        android:textAllCaps="false"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_content_rv"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
