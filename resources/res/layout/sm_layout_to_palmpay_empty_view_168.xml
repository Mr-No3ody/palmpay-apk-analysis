<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_empty_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/ll_empty_content"
        android:paddingTop="@dimen/dp168"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_empty_icon"
            android:layout_width="@dimen/dp80"
            android:layout_height="@dimen/dp80"/>
        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.202046.14"/>
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/tv_empty_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.6f7b85.12"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="@dimen/dp14"
            android:gravity="center"
            android:id="@+id/tv_empty_btn"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp36"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/sm_transfer_to_palmpay"
            android:paddingHorizontal="@dimen/dp16"
            style="@style/ppRoundButtonStyle"/>
    </LinearLayout>
</FrameLayout>
