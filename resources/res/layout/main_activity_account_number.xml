<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/core_account_number"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp16">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_account_number"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/cv_palmpay_logo_small_16dp"
            style="@style/txt_mi_g"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp24"
            android:gravity="center_vertical"
            android:id="@+id/tvAccountNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            app:iiv_end_color="@color/ppColorTextAssist"
            app:iiv_end_icon="pay_Copy"
            app:iiv_end_size="@dimen/dp16"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your PalmaPay Account registration was done using the mobile number below"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_g"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Login Mobile Number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg"
            style="@style/txt_s_b"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center_vertical"
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            app:iiv_end_color="@color/ppColorTextAssist"
            app:iiv_end_icon="pay_ArrowCenterRight"
            app:iiv_end_size="@dimen/dp14"
            app:layout_constraintBottom_toBottomOf="@+id/tv1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
