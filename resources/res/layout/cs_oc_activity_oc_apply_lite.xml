<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingBottom="29dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_oc_lite_back_icon"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivClose"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_close_grey"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="68dp"
            android:layout_marginRight="@dimen/dp16"
            android:src="@drawable/cs_bg_apply_okcard_lite"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="8dp"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/cs_your_credit_limit"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivBg"
            app:layout_constraintStart_toStartOf="@+id/ivBg"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle2"
            app:layout_constraintStart_toEndOf="@+id/tvTitle2"
            app:layout_constraintTop_toTopOf="@+id/tvTitle2"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/cs_msg_zero_interests"
            android:drawableLeft="@drawable/cs_icon_zero_interest"
            android:drawablePadding="@dimen/dp4"
            android:drawableTint="@color/ppColorTextPrimary"
            app:layout_constraintStart_toStartOf="@+id/ivBg"
            app:layout_constraintTop_toBottomOf="@+id/ivBg"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_msg_repayment_date"
            android:drawableLeft="@drawable/cs_icon_repayment_date"
            android:drawablePadding="@dimen/dp4"
            android:drawableTint="@color/ppColorTextPrimary"
            app:layout_constraintStart_toStartOf="@+id/ivBg"
            app:layout_constraintTop_toBottomOf="@+id/tvLine1"
            style="@style/txt_s_b"/>
        <TextView
            android:textColor="@color/cs_oc_main_color"
            android:id="@+id/increase_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_up_to_amount"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvLine2"
            app:layout_constraintStart_toEndOf="@+id/tvLine2"
            app:layout_constraintTop_toTopOf="@+id/tvLine2"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/discount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_msg_discount_payment"
            android:drawableLeft="@drawable/cs_oc_lite_discount_icon"
            android:drawablePadding="@dimen/dp4"
            android:drawableTint="@color/ppColorTextPrimary"
            app:layout_constraintStart_toStartOf="@+id/ivBg"
            app:layout_constraintTop_toBottomOf="@+id/tvLine2"
            style="@style/txt_s_b"/>
        <TextView
            android:textColor="@color/cs_oc_main_color"
            android:id="@+id/discount_payment_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_up_to_amount"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/discount_tv"
            app:layout_constraintStart_toEndOf="@+id/discount_tv"
            app:layout_constraintTop_toTopOf="@+id/discount_tv"
            app:layout_constraintVertical_bias="1"
            style="@style/txt_s_b"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:gravity="top"
            android:id="@+id/checkboxAgreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp38"
            android:layout_marginRight="@dimen/dp16"
            android:checked="false"
            android:button="@drawable/cv_checkbox_selector2"
            android:paddingStart="@dimen/dp8"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/discount_tv"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:gravity="center_vertical"
            android:id="@+id/tvAgreement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkboxAgreement"
            app:layout_constraintTop_toTopOf="@+id/checkboxAgreement"
            style="@style/txt_s_g"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvApply"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="16dp"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_confirm_to_borrow_it"
            android:layout_marginHorizontal="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAgreement"
            style="@style/txt_me_w"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/discount_amount_tv"
            android:background="@drawable/cs_corner_4_4_4_0_bg_ffaa0c"
            android:padding="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp42"
            app:layout_constraintBottom_toTopOf="@+id/tvApply"
            app:layout_constraintEnd_toEndOf="@+id/tvApply"
            app:layout_constraintTop_toTopOf="@+id/tvApply"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/lite_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_powered_by_rockit"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="@+id/csImageview29"
            app:layout_constraintEnd_toEndOf="@+id/ivBg"
            app:layout_constraintStart_toEndOf="@+id/csImageview29"
            app:layout_constraintTop_toTopOf="@+id/csImageview29"/>
        <ImageView
            android:id="@+id/csImageview28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="@+id/ivBg"
            app:layout_constraintTop_toBottomOf="@+id/csImageview29"
            app:srcCompat="@drawable/cs_oc_spend_now"/>
        <ImageView
            android:id="@+id/csImageview29"
            android:layout_width="59dp"
            android:layout_height="@dimen/dp16"
            android:layout_marginTop="32dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="@+id/ivBg"
            app:layout_constraintTop_toTopOf="@+id/ivBg"
            app:srcCompat="@drawable/cs_oc_flexi_logo_txt_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/loadingView"
        android:visibility="gone"
        android:layout_width="144dp"
        android:layout_height="78dp"
        android:layout_marginBottom="84dp"
        app:cardBackgroundColor="@color/transparent_54"
        app:cardCornerRadius="@dimen/dp12"
        app:cardElevation="0dp"
        app:contentPadding="0dp">
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center_horizontal"
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dp14"
            app:indicatorColor="@color/ppColorBackgroundLight"
            app:indicatorName="BallSpinFadeLoaderIndicator"
            style="@style/AVLoadingIndicatorView.Large"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="49dp"
            android:text="@string/cs_oc_apply_is_processing"
            style="@style/txt_s_w"/>
    </androidx.cardview.widget.CardView>
</FrameLayout>
