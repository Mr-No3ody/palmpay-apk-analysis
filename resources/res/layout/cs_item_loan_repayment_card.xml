<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLoanRepaymentCard"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginBottom="@dimen/dp8"
    android:layout_marginHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llCardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ivProductIcon"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:contentDescription="@string/cs_loan_repayment_card_default_product_name"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="start"
                android:id="@+id/tvProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="@+id/ivProductIcon"
                app:layout_constraintEnd_toStartOf="@+id/tvDerateFlag"
                app:layout_constraintStart_toEndOf="@+id/ivProductIcon"
                app:layout_constraintTop_toTopOf="@+id/ivProductIcon"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/cs_color_bg_item"
                android:gravity="center"
                android:id="@+id/tvDerateFlag"
                android:background="@drawable/cs_cl_loan_fully_bj"
                android:visibility="gone"
                android:layout_width="@dimen/dp120"
                android:layout_height="@dimen/dp20"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerHeader"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="@dimen/dp12"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="start"
                android:id="@+id/tvPrimaryAmountLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/dp8"
                app:layout_constraintEnd_toStartOf="@+id/tvRepay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/tvRepay"
                android:background="@drawable/cv_shape_round_corner_primary"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp24"
                android:minWidth="@dimen/dp44"
                android:text="@string/core_repay"
                android:paddingHorizontal="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="@+id/rowAmountClick"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvPrimaryAmountLabel"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rowAmountClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintEnd_toStartOf="@+id/tvRepay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPrimaryAmountLabel">
                <TextView
                    android:textSize="@dimen/dp24"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvMainAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/txt_number_me_b_b"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAmountChevron"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/cs_oc_arrow_right"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/ppColorTextAssist"
                android:gravity="start"
                android:id="@+id/tvSubLine"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rowAmountClick"
                style="@style/Text.202046.14"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/barTotalOutstanding"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp12">
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvTotalOutstandingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_loan_repayment_card_total_outstanding"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rowTotalAmountClick"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rowTotalAmountClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:ellipsize="end"
                    android:id="@+id/tvTotalOutstandingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp170"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/txt_number_me_b_b"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTotalChevron"
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/cs_oc_arrow_right"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDerateFlag"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp4"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp4">
            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:contentDescription="@null"
                app:srcCompat="@drawable/cs_cl_loan_fully_date_bj"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvLimitedOfferPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_waiver_limited_offer_prefix"
                android:layout_marginStart="@dimen/dp8"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:id="@+id/tvLimitedOfferDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorAssist"
                android:gravity="center"
                android:id="@+id/tvLimitedOfferHour"
                android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp16"
                android:layout_marginStart="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:text=":"
                android:layout_marginHorizontal="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorAssist"
                android:gravity="center"
                android:id="@+id/tvLimitedOfferMinute"
                android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:text=":"
                android:layout_marginHorizontal="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textStyle="bold"
                android:textColor="@color/ppColorAssist"
                android:gravity="center"
                android:id="@+id/tvLimitedOfferSecond"
                android:background="@drawable/cs_cl_loan_repayment_derate_time_bg"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
