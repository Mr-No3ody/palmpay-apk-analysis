<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/interest_loan_coupon_dialog"
        android:layout_marginStart="@dimen/dp32"
        android:layout_marginEnd="@dimen/dp20"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp32"
        android:layout_marginRight="@dimen/dp32"
        android:layout_marginHorizontal="@dimen/dp32">
        <TextView
            android:textColor="#000000"
            android:background="@drawable/core_rect_round_corner_stroke_bg_black"
            android:paddingLeft="@dimen/dp13"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp13"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp40"
            android:text="@string/cs_ex_clusive_to_new_users"
            android:layout_marginStart="@dimen/dp26"
            android:paddingHorizontal="@dimen/dp13"
            android:paddingVertical="@dimen/dp2"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp74"
            android:src="@drawable/interest_loan_coupon_dialog_title"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/dp24"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp115"
            android:src="@drawable/cs_zero_interest_top"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp132"
            android:src="@drawable/cs_zero_interest_coupon"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:background="@drawable/cs_dash_line_906948"
            android:layout_width="@dimen/dp180"
            android:layout_height="@dimen/dp2"
            android:layout_marginTop="@dimen/dp150"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dp42"
            android:textColor="#906948"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp153"
            android:text="100%"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-black"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#906948"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="205dp"
            android:text="Interest Discount Coupon"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/md_white_1000"
            android:gravity="center"
            android:id="@+id/tv_borrow_amount"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="260dp"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_cl_borrow"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </RelativeLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/icon_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="360dp"
        android:layout_centerHorizontal="true"
        app:iiv_color="@color/md_white_1000"
        app:iiv_icon="pay_CloseOutline"
        app:iiv_size="@dimen/dp24"/>
</RelativeLayout>
