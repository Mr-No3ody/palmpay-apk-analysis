<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_open_success_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cash_repay_bill_ll"
            android:background="@drawable/cv_shape_rect_corner_12_bg_white"
            android:paddingTop="@dimen/dp6"
            android:paddingBottom="@dimen/dp16"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp13"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_cl_double_open_success"/>
            <TextView
                android:gravity="center"
                android:id="@+id/cl_recactivation_title_tv"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/core_congratulations"
                style="@style/Text.medium.202046.18"/>
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/available_amount_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/cs_cl_double_congratulations_on_getting"/>
            <TextView
                android:textSize="34dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/credit_amount_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
            <com.transsnet.palmpay.credit.ui.view.BorrowCLInfoView
                android:id="@+id/borrow_cl_info_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/cv_flexi_cash_base_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/cl_both_borrow_tips_tv"
                    android:background="@drawable/cs_cl_f0ecfc_12_bg"
                    android:paddingTop="@dimen/dp2"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp62"
                    android:text="Click here to borrow Total Loan Amount"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/cs_cl_borrow_txt_color"
                    android:gravity="center"
                    android:id="@+id/cl_both_borrow_tv"
                    android:background="@drawable/cs_cl_borrow_txt_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp48"
                    android:layout_marginTop="@dimen/dp6"
                    android:text="@string/cs_cl_borrow_take_out_all"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="@color/ppColorFlexiCashPrimary"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/dp10"
                    android:layout_alignParentEnd="true"
                    app:slot_id="@string/cl_open_success_tips_ad_slot_id_cash"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:layout_gravity="center"
                android:id="@+id/cl_open_agreement_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="Click to see Loan Agreement"/>
        </LinearLayout>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/cl_open_result_sav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp16"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:slot_id="@string/cl_open_success_ad_slot_id_cash"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
