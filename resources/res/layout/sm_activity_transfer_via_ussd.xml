<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/sm_transfer_via_ussd"/>
    <TextView
        android:id="@+id/tv_ussd_code"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/Text.202046.12"/>
    <TextView
        android:gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/sm_enter_transfer_details_automatically"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/Text.202046.12"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16">
        <EditText
            android:textColorHint="@color/text_color_gray4"
            android:gravity="center_vertical"
            android:id="@+id/et_bank_account"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:hint="@string/sm_enter_10_digit_account_number"
            android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
            android:digits="0123456789"
            style="@style/Text.medium.202046.16"/>
        <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
            android:id="@+id/med_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="center_vertical"
            android:id="@+id/tv_select_bank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            app:iiv_end_color="@color/ppColorTextNormal"
            app:iiv_end_icon="pay_Arrowdown"
            app:iiv_end_size="@dimen/dp24"
            style="@style/Text.medium.202046.16"/>
        <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
            android:id="@+id/med_bank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.palmpay.lib.ui.edit.PpAmountEditText
            android:id="@+id/et_transfer_money"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:am_edit_show_button="false"
            app:am_edit_show_lock="false"
            app:am_edit_show_title="false"
            app:am_edit_text_size="@dimen/dp22"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tv_next"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_me_w_b"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp20"
            android:src="@drawable/sm_ic_to_bank_home_bottom"/>
    </FrameLayout>
</LinearLayout>
