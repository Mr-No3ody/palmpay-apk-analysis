<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_16_bg_white"
                android:paddingBottom="@dimen/dp12"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16">
                <TextView
                    android:id="@+id/tvMiobileNumberTitle"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/core_mobile_number"
                    android:drawablePadding="@dimen/dp4"
                    style="@style/Text.202046.12"/>
                <com.transsnet.palmpay.core.viewmodel.ModelEnterPhoneNumber1
                    android:id="@+id/model_phone_num_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:core_show_title_hint="false"/>
                <TextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvPhoneNumberError"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/sm_enter_mobile_number"
                    style="@style/Text.ffffff.12"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layoutNickName"
                    android:background="@drawable/cv_shape_rect_corner_20_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp8"
                    android:backgroundTint="@color/ppColorBackgroundDark">
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/tvNickName"
                        android:singleLine="true"
                        style="@style/Text.202046.12"/>
                    <ImageView
                        android:layout_width="@dimen/dp12"
                        android:layout_height="@dimen/dp12"
                        android:layout_marginLeft="@dimen/dp4"
                        android:src="@drawable/cv_icon_success_small"/>
                </LinearLayout>
                <TextView
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/sm_relationship"
                    style="@style/Text.202046.12"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/relationship1_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:dividerDrawable="@drawable/sm_shape_relationship_divider"
                    app:flexWrap="wrap"
                    app:showDivider="middle"/>
                <TextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvRelationshipError"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/sm_select_link_faves"
                    style="@style/Text.ffffff.12"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff95a1ab"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/sm_how_much"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff95a1ab"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/sm_which_day"/>
                <RelativeLayout
                    android:id="@+id/transfer_time_view"
                    android:background="@drawable/cv_input_view_selector_bg"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ff95a1ab"
                        android:id="@+id/transfer_time_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sm_every_month"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/transfer_time_content"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sm_every_month"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#ff263138"
                            android:id="@+id/transfer_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cv_arrow_drop_down"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
            <Button
                android:textColor="@color/sm_confirm_btn_text_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/save"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cv_default_button_height"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp24"
                android:text="@string/sm_save"
                android:textAllCaps="false"
                style="@style/Text.medium.ffffff.16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
