<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbci_root"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp96"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:id="@+id/mbci_iv_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/cv_default_bank_logo"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="30dp"
        android:layout_toEndOf="@+id/mbci_iv_icon">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/mbci_tv_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_add_a_withdrawl_account"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/mbci_tv_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp10"
            app:layout_constraintTop_toBottomOf="@+id/mbci_tv_line1"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/cwb_auth_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_verified_recipient_name"
            android:layout_marginStart="@dimen/dp15"
            app:layout_constraintTop_toBottomOf="@+id/mbci_tv_line2"/>
        <ImageView
            android:textSize="@dimen/dp14"
            android:id="@+id/cwb_authed_iv"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginTop="1dp"
            android:src="@drawable/cv_icon_authed"
            app:layout_constraintStart_toEndOf="@+id/cwb_auth_name"
            app:layout_constraintTop_toBottomOf="@+id/mbci_tv_line2"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/mbci_tv_line3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cwb_authed_iv"
            app:layout_constraintTop_toBottomOf="@+id/mbci_tv_line2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbci_iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorDividerLine"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp20"/>
</RelativeLayout>
