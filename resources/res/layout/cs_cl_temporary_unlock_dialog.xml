<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iivClose"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_margin="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_ic_temporary_unlock_dialog_top"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iivClose"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_unlock_successfully"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTop"
        style="@style/Text.medium.202046.20"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llExpireTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <TextView
            android:id="@+id/tvExpireIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_expires_in"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:id="@+id/tvExpireMinute"
            android:background="@drawable/cv_shape_rect_corner_4_bg_text_primary"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:lines="1"
            android:maxLength="2"
            android:layout_marginStart="@dimen/dp8"
            style="@style/Text.medium.ffffff.18"/>
        <TextView
            android:id="@+id/tvMiddle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginRight="@dimen/dp8"
            android:text=":"
            android:layout_marginHorizontal="@dimen/dp8"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:id="@+id/tvExpireSecond"
            android:background="@drawable/cv_shape_rect_corner_4_bg_text_primary"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:lines="1"
            android:maxLength="2"
            style="@style/Text.medium.ffffff.18"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvExpireTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/llExpireTime"
        style="@style/Text.6f7b85.14"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_confirm"
        android:backgroundTint="@color/cs_main_color"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvExpireTips"/>
    <TextView
        android:id="@+id/tvUnlockTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/btnConfirm"
        style="@style/Text.6306b2.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
