<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/core_data"/>
    <com.transsnet.palmpay.core.viewmodel.ModelBillNoticeItem
        android:id="@+id/billNoticeItem"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cv_notice_category_id="6"
        app:cv_notice_slot_id="@string/ad_bundle_home_txt_slot_id"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/flBody"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/billNoticeItem">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llAppBarHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llNetworkError"
                android:background="@color/ppColorBackgroundDark"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginStart="@dimen/dp16"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Unlink"
                    app:iiv_size="@dimen/dp20"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:layout_gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/qt_network_error"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp3"
                    style="@style/txt_s_b"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextAssist"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="@dimen/dp20"/>
            </LinearLayout>
            <com.transsnet.palmpay.custom_view.input.ModelMobileWithIconInputLayout
                android:id="@+id/bundle_phone_num_input"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:cv_list_item_full_screen="false"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llNetworkError"/>
            <com.transsnet.palmpay.databundle.ui.view.ModelDataBundleHighlyRecommendItem
                android:id="@+id/data_bundle_highly_recommend_item"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp95"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bundle_phone_num_input"/>
            <ViewStub
                android:id="@+id/qt_data_bundle_flash_sale"
                android:layout="@layout/qt_data_bundle_flash_sale_layout"
                android:inflatedId="@+id/qt_data_bundle_flash_sale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/data_bundle_highly_recommend_item"
                app:layout_goneMarginTop="@dimen/dp12"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/bundleTabsTopBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="bundle_phone_num_input,data_bundle_highly_recommend_item,qt_data_bundle_flash_sale"/>
            <Space
                android:id="@+id/midSpace"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/bundleTabsTopBarrier"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/sav_data_bundle_pocker_banner"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/midSpace"
                app:slot_id="@string/ad_data_bundle_homepage_pocker_banner_slot_id"/>
            <Space
                android:id="@+id/space_ad_mid_bill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="@+id/sav_data_bundle_pocker_banner"
                app:layout_constraintEnd_toEndOf="@+id/sav_data_bundle_pocker_banner"
                app:layout_constraintStart_toStartOf="@+id/sav_data_bundle_pocker_banner"
                app:layout_goneMarginBottom="0dp"
                app:layout_goneMarginTop="@dimen/dp12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llTabs"
                android:background="@drawable/cv_rect_corner_tl_tr_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/space_ad_mid_bill">
                <TextView
                    android:id="@+id/tvTabTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qt_data_plans"
                    android:layout_marginStart="@dimen/dp12"
                    app:layout_constraintBottom_toBottomOf="@+id/dataBundleGridModeIv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/dataBundleGridModeIv"
                    style="@style/Text.medium.202046.16"/>
                <ImageView
                    android:id="@+id/dataBundleGridModeIv"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:scaleType="center"
                    android:contentDescription="@string/qt_data_bundle_simple_mode"
                    android:layout_marginEnd="@dimen/dp8"
                    app:layout_constraintEnd_toStartOf="@+id/dataBundleDetailsModeIv"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/qt_data_bundle_grid_unselected"/>
                <ImageView
                    android:id="@+id/dataBundleDetailsModeIv"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:scaleType="center"
                    android:contentDescription="@string/qt_data_bundle_detail_mode"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/qt_data_bundle_details_selected"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/bundle_tabs"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp32"
                    android:layout_marginTop="@dimen/dp6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dataBundleGridModeIv"
                    app:tabIndicator="@drawable/qt_tab_indicator"
                    app:tabIndicatorColor="@color/ppColorPrimary"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="@dimen/dp12"
                    app:tabPaddingStart="@dimen/dp12"
                    app:tabRippleColor="@color/ppColorBackgroundLight"
                    app:tabSelectedTextAppearance="@style/QTTabLayoutTextAppearance2.Selected"
                    app:tabSelectedTextColor="@color/ppColorPrimary"
                    app:tabTextAppearance="@style/QTTabLayoutTextAppearance2"
                    app:tabTextColor="@color/ppColorTextPrimary"/>
                <View
                    android:background="@color/ppColorBackgroundLight"
                    android:layout_width="@dimen/dp12"
                    android:layout_height="@dimen/dp32"
                    app:layout_constraintBottom_toBottomOf="@+id/bundle_tabs"
                    app:layout_constraintStart_toStartOf="@+id/bundle_tabs"/>
                <View
                    android:background="@color/ppColorBackgroundLight"
                    android:layout_width="@dimen/dp12"
                    android:layout_height="@dimen/dp32"
                    app:layout_constraintBottom_toBottomOf="@+id/bundle_tabs"
                    app:layout_constraintEnd_toEndOf="@+id/bundle_tabs"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bundleVpContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llTabs"
                app:layout_constraintVertical_bias="0">
                <View
                    android:id="@+id/cpi_bundle_loading_bg"
                    android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/dp24"
                    app:layout_constraintHeight_percent="0.7"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpi_bundle_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/ppColorPrimary"
                    app:indicatorSize="@dimen/dp24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.3"
                    app:trackThickness="@dimen/dp2"/>
                <com.transsnet.palmpay.teller.ui.view.WrapContentViewPager2
                    android:id="@+id/bundle_vp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/bottomMenuView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.transsnet.palmpay.teller.ui.view.ModelBillerBottomMenu
                    android:id="@+id/bottomMenuView"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:padding="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintBottom_toTopOf="@+id/bannerWithCouponStub"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bundle_vp"/>
                <ViewStub
                    android:id="@+id/bannerWithCouponStub"
                    android:layout="@layout/qt_layout_banner_coupon_item"
                    android:inflatedId="@+id/bannerWithCouponStub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintBottom_toTopOf="@+id/tvServiceProviderDisclaimer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bottomMenuView"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvServiceProviderDisclaimer"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bannerWithCouponStub"
                    style="@style/Text.6f7b85.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
