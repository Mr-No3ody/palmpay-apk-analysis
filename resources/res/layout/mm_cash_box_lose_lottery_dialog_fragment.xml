<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_16_bg_white"
        android:paddingTop="@dimen/dp42"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp75"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:text="@string/mm_cash_box_lose_lottery"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:id="@+id/rtvOkay"
            android:background="@drawable/mm_bg_lose_lottery_okay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp32"
            android:layout_marginLeft="@dimen/dp32"
            android:layout_marginTop="@dimen/dp22"
            android:layout_marginRight="@dimen/dp35"
            android:text="@string/mm_action_okay"
            style="@style/Text.medium.ffffff.12"/>
    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_icon_sorry"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
