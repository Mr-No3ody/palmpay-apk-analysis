<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/smsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/large_margin"
        android:layout_marginBottom="14dp"
        android:layout_centerHorizontal="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <com.transsnet.palmpay.custom_view.PinEntryView
            android:id="@+id/smsCodeView"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            app:accentType="character"
            app:accentWidth="0dp"
            app:digitBackground="@color/transparent"
            app:digitHeight="60dp"
            app:digitRadius="4dp"
            app:digitSelectStrokeColor="@color/ppColorPrimary"
            app:digitSpacing="9dp"
            app:digitStrokeColor="@color/ppColorTextDisable"
            app:digitStrokeWidth="0.5dp"
            app:digitTextColor="@color/ppColorTextPrimary"
            app:digitTextSize="36dp"
            app:digitWidth="50dp"
            app:mask=""
            app:numDigits="4"
            app:pinInputType="number"
            app:showHideButton="false"/>
    </FrameLayout>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/txt_s_g"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/buttonContainer"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tvTime"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:enabled="true"
            android:gravity="center_horizontal"
            android:id="@+id/textViewSendSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_send_sms"
            android:drawableLeft="@drawable/cv_message_blue"
            android:drawablePadding="8dp"
            style="@style/txt_s_g"/>
        <RelativeLayout
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp14"
            android:paddingTop="@dimen/dp14"
            android:paddingRight="@dimen/dp14"
            android:paddingBottom="@dimen/dp25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="@dimen/dp14">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_other_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <View
                    android:background="#c0c3c8"
                    android:layout_width="@dimen/dp21"
                    android:layout_height="1dp"/>
                <TextView
                    android:paddingLeft="@dimen/dp7"
                    android:paddingRight="@dimen/dp7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_other_methods2"
                    android:paddingHorizontal="@dimen/dp7"/>
                <View
                    android:background="#c0c3c8"
                    android:layout_width="@dimen/dp21"
                    android:layout_height="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14"
                android:layout_below="@+id/ll_other_method"
                android:layout_centerHorizontal="true">
                <TextView
                    android:enabled="true"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvWhatsapp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_whatsapp"
                    android:drawableLeft="@drawable/cv_whatsapp"
                    android:drawablePadding="8dp"
                    android:layout_marginEnd="@dimen/dp10"
                    style="@style/txt_s_g"/>
                <TextView
                    android:enabled="true"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvUSSD"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_ussd"
                    android:drawableLeft="@drawable/cv_ussd"
                    android:drawablePadding="8dp"
                    android:layout_marginEnd="@dimen/dp10"
                    style="@style/txt_s_g"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvVoiceCall"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_voice_call"
                    android:drawableLeft="@drawable/core_voice_call"
                    android:drawablePadding="8dp"
                    android:layout_marginEnd="@dimen/dp10"
                    style="@style/txt_s_g"/>
                <TextView
                    android:enabled="true"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/core_email"
                    android:drawableLeft="@drawable/cv_email_blue"
                    android:drawablePadding="8dp"
                    android:layout_weight="1"
                    style="@style/txt_s_g"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</merge>
