<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewBillTop"
        android:background="@drawable/cs_shape_bg_phone_installment_bill_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:layout_marginHorizontal="@dimen/dp10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRepayOnTimeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/ppColorSuccessBackground"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="@dimen/dp12"
                android:layout_height="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp4"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_Security"
                app:iiv_size="@dimen/dp12"/>
            <TextView
                android:gravity="left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_mi_repay_on_time_banner"
                android:layout_weight="1"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDeviceInfo"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingTop="@dimen/dp9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutDeviceActiveTime"
            android:paddingBottom="@dimen/dp25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tvDeviceActiveTitle"
                        android:text="@string/cs_cl_device_active_until"
                        style="@style/Text.6f7b85.12"/>
                    <ImageView
                        android:id="@+id/ivBrand"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvBrand"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvBrand"/>
                    <TextView
                        android:id="@+id/tvBrand"
                        android:background="@drawable/cs_corner_16_bg_null_c0c3c8"
                        android:paddingLeft="@dimen/dp5"
                        android:paddingTop="@dimen/dp3"
                        android:paddingRight="@dimen/dp5"
                        android:paddingBottom="@dimen/dp3"
                        android:layout_marginStart="@dimen/dp3"
                        android:paddingHorizontal="@dimen/dp5"
                        android:paddingVertical="@dimen/dp3"
                        app:layout_constraintStart_toEndOf="@+id/ivBrand"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/Text.6f7b85.10"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/llDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4">
                    <ImageView
                        android:id="@+id/ivLock"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_marginEnd="@dimen/dp4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/barrier"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvDeviceActiveTime"
                        android:drawablePadding="2dp"
                        android:layout_marginEnd="@dimen/dp4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivRefreshLockTime"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@+id/ivLock"
                        app:layout_constraintTop_toBottomOf="@+id/tvDeviceActiveTitle"
                        style="@style/Text.medium.202046.16"/>
                    <ImageView
                        android:id="@+id/ivRefreshLockTime"
                        android:layout_width="@dimen/dp12"
                        android:layout_height="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/tvDeviceActiveTime"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvDeviceActiveTime"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llUnlockInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:divider="@drawable/cv_shape_transparent_h_divider_12"
                    android:showDividers="middle">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/llUnlockCountdownDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp18"
                            android:textStyle="bold"
                            android:textColor="@color/cs_oc_flexi_limit_card_disable_color"
                            android:gravity="center"
                            android:id="@+id/tvUnlockCountdownDays"
                            android:background="@drawable/cs_corner_5_bg_ff9900"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/cs_overdue_today_txt_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:text="@string/cs_mi_unlock_countdown_days"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp18"
                            android:textStyle="bold"
                            android:textColor="@color/cs_oc_flexi_limit_card_disable_color"
                            android:gravity="center"
                            android:id="@+id/tvUnlockCountdownHours"
                            android:background="@drawable/cs_corner_5_bg_ff9900"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/cs_overdue_today_txt_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:text="@string/cs_mi_unlock_countdown_hrs"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp18"
                            android:textStyle="bold"
                            android:textColor="@color/cs_oc_flexi_limit_card_disable_color"
                            android:gravity="center"
                            android:id="@+id/tvUnlockCountdownMinutes"
                            android:background="@drawable/cs_corner_5_bg_ff9900"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/cs_overdue_today_txt_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:text="@string/cs_mi_unlock_countdown_mins"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp18"
                            android:textStyle="bold"
                            android:textColor="@color/cs_oc_flexi_limit_card_disable_color"
                            android:gravity="center"
                            android:id="@+id/tvUnlockCountdownSeconds"
                            android:background="@drawable/cs_corner_5_bg_ff9900"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/cs_overdue_today_txt_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:text="@string/cs_mi_unlock_countdown_secs"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivLockV2"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp4"/>
                <TextView
                    android:id="@+id/tvLockV2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The phone has been locked due to overdue payment"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivBrandIcon"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="55dp"
            android:layout_marginBottom="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView
            android:id="@+id/ivBrandIcon2"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="83dp"
            android:layout_marginBottom="@dimen/dp18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/clMobileInstallment"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingBottom="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="-20dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/llCurrentOutstandingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp30"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tvCurrentOutstandingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_current_outstanding_with_unit"
                style="@style/Text.202046.12"/>
            <ImageView
                android:textStyle="bold"
                android:id="@+id/ivExemptionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_exemption_badge"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/cs_mi_current_outstanding_text_size"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvCurrentOutstandingAmount"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp16"
            android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="@+id/llCurrentOutstandingTitle"
            app:layout_constraintStart_toStartOf="@+id/llCurrentOutstandingTitle"
            app:layout_constraintTop_toBottomOf="@+id/llCurrentOutstandingTitle"
            style="@style/Text.medium.202046.26"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/ppColorWarning"
                android:id="@+id/tvPhoneInstallmentTips"
                android:background="@drawable/cv_shape_rect_bg_fff7e7_corner_4"
                android:paddingLeft="@dimen/dp_8"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="@dimen/dp_8"
                android:paddingBottom="@dimen/dp16"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp_8"
                app:autoSizeMaxTextSize="12dp"
                app:autoSizeMinTextSize="8dp"
                app:autoSizeStepGranularity="1dp"
                app:autoSizeTextType="uniform"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentOutstandingAmount"
                style="@style/Text.202046.12"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/llPhoneInstallmentExemption"
                android:background="@drawable/cv_shape_rect_bg_fff0f0_corner_4"
                android:paddingLeft="@dimen/dp5"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="@dimen/dp5"
                android:paddingBottom="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp5"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPhoneInstallmentTips">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvPhoneInstallmentTips2"
                    android:layout_width="wrap_content"
                    app:autoSizeMaxTextSize="12dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.12"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@color/ppColorError"
                    android:gravity="center"
                    android:id="@+id/tvExemptionYearsOld"
                    android:background="@drawable/cv_shape_rect_bg_fe5455_corner_4"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingTop="@dimen/dp3"
                    android:paddingRight="@dimen/dp4"
                    android:paddingBottom="@dimen/dp3"
                    android:text="00"
                    android:layout_marginStart="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp4"
                    android:paddingVertical="@dimen/dp3"
                    app:autoSizeMaxTextSize="10dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.10"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@color/ppColorError"
                    android:gravity="center"
                    android:id="@+id/tvExemptionColon1"
                    android:layout_marginLeft="@dimen/dp4"
                    android:layout_marginRight="@dimen/dp4"
                    android:text=":"
                    android:layout_marginHorizontal="@dimen/dp4"
                    app:autoSizeMaxTextSize="10dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.10"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@color/ppColorError"
                    android:gravity="center"
                    android:id="@+id/tvExemptionMinutes"
                    android:background="@drawable/cv_shape_rect_bg_fe5455_corner_4"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingTop="@dimen/dp3"
                    android:paddingRight="@dimen/dp4"
                    android:paddingBottom="@dimen/dp3"
                    android:text="00"
                    android:paddingHorizontal="@dimen/dp4"
                    android:paddingVertical="@dimen/dp3"
                    app:autoSizeMaxTextSize="10dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.10"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@color/ppColorError"
                    android:gravity="center"
                    android:id="@+id/tvExemptionColon2"
                    android:layout_marginLeft="@dimen/dp4"
                    android:layout_marginRight="@dimen/dp4"
                    android:text=":"
                    android:layout_marginHorizontal="@dimen/dp4"
                    app:autoSizeMaxTextSize="12dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.10"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textStyle="bold"
                    android:textColor="@color/ppColorError"
                    android:gravity="center"
                    android:id="@+id/tvExemptionSecond"
                    android:background="@drawable/cv_shape_rect_bg_fe5455_corner_4"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingTop="@dimen/dp3"
                    android:paddingRight="@dimen/dp4"
                    android:paddingBottom="@dimen/dp3"
                    android:text="00"
                    android:paddingHorizontal="@dimen/dp4"
                    android:paddingVertical="@dimen/dp3"
                    app:autoSizeMaxTextSize="12dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.10"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rlPhoneInstallmentTips3"
                android:background="@drawable/cv_shape_rect_bg_fff0f0_corner_4"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp5"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp5"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPhoneInstallmentTips">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvPhoneInstallmentTips3"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="wrap_content"
                    android:layout_centerHorizontal="true"
                    app:autoSizeMaxTextSize="12dp"
                    app:autoSizeMinTextSize="8dp"
                    app:autoSizeStepGranularity="1dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.202046.12"/>
                <ImageView
                    android:id="@+id/ivPhoneInstallmentTips3"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:rotation="3"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/btnRepay"
            android:background="@drawable/lib_ui_button_bg_corner_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="-10dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_goneMarginTop="24dp"
            style="@style/Text.medium.ffffff.16"/>
        <TextView
            android:id="@+id/btnUnlock"
            android:background="@drawable/lib_ui_button_bg_corner_secondary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_temporary_unlock"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/btnRepay"
            app:layout_goneMarginTop="24dp"
            style="@style/Text.medium.6306b2.16"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btnExpireTime"
            android:background="@drawable/cs_rect_stroke_dad0f7_corner_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnUnlock">
            <TextView
                android:id="@+id/tvExpireIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_expires_in"
                style="@style/Text.6306b2.16"/>
            <TextView
                android:id="@+id/tvExpireMinute"
                android:background="@drawable/cv_rect_corner_4_bg_202046"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:lines="1"
                android:maxLength="2"
                android:layout_marginStart="@dimen/dp8"
                style="@style/Text.medium.ffffff.12"/>
            <TextView
                android:id="@+id/tvExpireColon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:text=":"
                android:layout_marginHorizontal="@dimen/dp4"
                style="@style/Text.medium.202046.12"/>
            <TextView
                android:id="@+id/tvExpireSecond"
                android:background="@drawable/cv_rect_corner_4_bg_202046"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:lines="1"
                android:maxLength="2"
                style="@style/Text.medium.ffffff.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/llTotalOutstanding"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintTop_toBottomOf="@+id/btnExpireTime">
            <TextView
                android:gravity="start"
                android:id="@+id/tvTotalOutstandingTitle"
                android:text="@string/cs_cl_total_outstanding"
                android:layout_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutDeviceInfo"
                style="@style/Text.202046.14"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvTotalOutstandingAmount"
                android:fontFamily="@font/lib_ui_number_bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvTotalOutstandingTitle"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTotalOutstandingTitle"
                style="@style/Text.202046.14"/>
