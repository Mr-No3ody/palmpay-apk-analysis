                android:paddingLeft="@dimen/dp8"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp8"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp4"
                android:paddingHorizontal="@dimen/dp8">
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/tvWeeklyPaymentAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@font/lib_ui_number_bold"
                    style="@style/Text.medium.202046.14"/>
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/tvWeeklyPaymentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:text="@string/cs_mi_repayment_cycle_weekly_label"
                    style="@style/Text.6f7b85.12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/llMonthlyPayment"
                android:background="@drawable/cv_rect_corner_8_bg_f6f6fa"
                android:paddingLeft="@dimen/dp8"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp8"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp4"
                android:paddingHorizontal="@dimen/dp8">
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/tvMonthlyPaymentAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@font/lib_ui_number_bold"
