<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/main_my_profile"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/userInfoStub"
                android:layout="@layout/main_layout_personal_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ViewStub
                    android:id="@+id/accountMobileItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/emailItemStub"
                    android:layout="@layout/main_personal_info_item1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/nickNameItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"
                    layout="@layout/main_layout_personal_kyc_level_row"/>
                <ViewStub
                    android:id="@+id/fullNameItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/genderItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/birthdayItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/mobileItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/addressItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
                <ViewStub
                    android:id="@+id/professionItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ViewStub
                    android:id="@+id/accountMgrItemStub"
                    android:layout="@layout/main_personal_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ViewStub
                    android:id="@+id/friendItemStub"
                    android:layout="@layout/main_personal_info_item2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
