<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingBottom="70dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_preview_dialog_title_height"
            layout="@layout/cv_layout_preview_dialog_title"/>
        <com.transsnet.palmpay.custom_view.ReboundScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer
                android:orientation="vertical"
                android:id="@+id/itemContainer"
                android:paddingTop="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.core.viewmodel.PreviewTitleView
                    android:id="@+id/withdraw_preview_title_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acap_verify_name_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_title="@string/aw_verify_bank_name"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acap_amount_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_amount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acap_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_fee"/>
                <com.transsnet.palmpay.core.viewmodel.ModelUsePointsWithSwitch
                    android:id="@+id/acap_point_used_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acap_point_earned_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_amount_sign="₦"
                    app:cv_bm_text_color="@color/ppColorError"
                    app:cv_bm_title="Cashback to earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acap_total_pay_item"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_total"/>
                <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
                    android:id="@+id/acap_bank_card_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer>
        </com.transsnet.palmpay.custom_view.ReboundScrollView>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp18"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/awcap_complete_btn"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginBottom="12dp"
        android:text="@string/ci_withdraw"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/cv_preview_item_margin"
        android:layout_marginEnd="@dimen/cv_preview_item_margin"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
