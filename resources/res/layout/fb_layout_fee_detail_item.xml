<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/fb_total_fee"
        android:layout_marginVertical="10dp"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentEnd="true"
        android:layout_marginVertical="10dp"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_tvDetail"
        android:background="@drawable/fb_shape_rect_corner_8_bg_dark"
        android:padding="@dimen/fb_dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/fb_tvName"
        android:lineSpacingExtra="4dp"
        style="@style/fb_txt_mi_g"/>
</RelativeLayout>
