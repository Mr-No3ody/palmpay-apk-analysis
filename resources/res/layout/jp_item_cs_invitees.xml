<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="16dp">
    <ImageView
        android:id="@+id/jpInviteHead"
        android:padding="@dimen/dp1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/cv_avatar_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/jp_invitees_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp5"
        app:layout_constraintBottom_toBottomOf="@+id/jpInviteHead"
        app:layout_constraintStart_toEndOf="@+id/jpInviteHead"
        app:layout_constraintTop_toTopOf="@+id/jpInviteHead"
        style="@style/txt_s_w_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/jp_invitees_status"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:text="@string/jp_refer_remind"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp4"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/jp_invitees_phone"
        app:layout_constraintStart_toEndOf="@+id/jp_invitees_phone"
        app:layout_constraintTop_toTopOf="@+id/jp_invitees_phone"
        app:loading_size="@dimen/dp10"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorFlexiCashAssist"
        android:id="@+id/jpInviteMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/jp_invitees_phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_invitees_phone"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llInviteSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_invitees_phone">
        <ImageView
            android:id="@+id/ivInviteSignUp"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:src="@drawable/jp_invitees_selected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvInviteTaskName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/tvInviteTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jp_signed_up"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/ivInviteSignUp"
            app:layout_constraintStart_toEndOf="@+id/ivInviteSignUp"
            app:layout_constraintTop_toTopOf="@+id/ivInviteSignUp"/>
        <TextView
            android:textSize="@dimen/dp8"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvInviteSignUpAmt"
            android:background="@drawable/jp_re_invite_amount_bg"
            android:paddingLeft="@dimen/dp2"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:layout_marginStart="@dimen/dp2"
            android:paddingHorizontal="@dimen/dp2"
            android:paddingVertical="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/tvInviteTaskName"
            app:layout_constraintStart_toEndOf="@+id/tvInviteTaskName"
            app:layout_constraintTop_toTopOf="@+id/tvInviteTaskName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/centerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llInviteTopUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/dp20"
        app:layout_constraintStart_toEndOf="@+id/centerGuideline"
        app:layout_constraintTop_toBottomOf="@+id/jp_invitees_phone">
        <ImageView
            android:id="@+id/ivInviteTopUp"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:src="@drawable/jp_invitees_selected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/tvInviteTopUpTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jp_top_up_airtime"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/ivInviteTopUp"
            app:layout_constraintStart_toEndOf="@+id/ivInviteTopUp"
            app:layout_constraintTop_toTopOf="@+id/ivInviteTopUp"/>
        <TextView
            android:textSize="@dimen/dp8"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvInviteTopUpAmt"
            android:background="@drawable/jp_re_invite_amount_bg"
            android:paddingLeft="@dimen/dp2"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:layout_marginStart="@dimen/dp2"
            android:paddingHorizontal="@dimen/dp2"
            android:paddingVertical="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/ivInviteTopUp"
            app:layout_constraintStart_toEndOf="@+id/tvInviteTopUpTaskName"
            app:layout_constraintTop_toTopOf="@+id/ivInviteTopUp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvInviteRemark"
        android:paddingTop="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_invitees_phone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
