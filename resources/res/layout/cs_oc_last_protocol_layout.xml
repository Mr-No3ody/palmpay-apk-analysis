<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/cs_application_result"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cs_main_color"
                android:id="@+id/csTextview151"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_pay_on_time"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/csImageview44"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview167"
                app:layout_constraintStart_toStartOf="@+id/csTextview151"
                app:layout_constraintTop_toTopOf="@+id/csTextview166"
                app:srcCompat="@drawable/cs_cl_higher_credit_limit_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview166"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_higher_credit_limit"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview44"
                app:layout_constraintTop_toBottomOf="@+id/csTextview151"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview167"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_up_to_amount"
                app:layout_constraintStart_toStartOf="@+id/csTextview166"
                app:layout_constraintTop_toBottomOf="@+id/csTextview166"/>
            <ImageView
                android:id="@+id/csImageview45"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview169"
                app:layout_constraintStart_toStartOf="@+id/csImageview44"
                app:layout_constraintTop_toTopOf="@+id/csTextview168"
                app:srcCompat="@drawable/cs_cl_longer_loan_term_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview168"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_oc_installments"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview45"
                app:layout_constraintTop_toBottomOf="@+id/csTextview167"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview169"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_up_to_months"
                app:layout_constraintStart_toStartOf="@+id/csTextview168"
                app:layout_constraintTop_toBottomOf="@+id/csTextview168"/>
            <ImageView
                android:id="@+id/csImageview46"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview171"
                app:layout_constraintStart_toStartOf="@+id/csImageview45"
                app:layout_constraintTop_toTopOf="@+id/csTextview170"
                app:srcCompat="@drawable/cs_guide_open_discount_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview170"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_protocol_discounts"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview46"
                app:layout_constraintTop_toBottomOf="@+id/csTextview169"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview171"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_protocol_payment_discounts"
                app:layout_constraintStart_toStartOf="@+id/csTextview170"
                app:layout_constraintTop_toBottomOf="@+id/csTextview170"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorError"
                android:id="@+id/csTextview172"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cs_protocol_you_pay_later"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="@+id/csTextview151"
                app:layout_constraintTop_toBottomOf="@+id/csTextview171"/>
            <ImageView
                android:id="@+id/csImageview47"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview174"
                app:layout_constraintStart_toStartOf="@+id/csTextview172"
                app:layout_constraintTop_toTopOf="@+id/csTextview173"
                app:srcCompat="@drawable/cs_oc_automatic_debit_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview173"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_protocol_automatic_debit"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview47"
                app:layout_constraintTop_toBottomOf="@+id/csTextview172"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview174"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_protocol_balance_bank_account"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/csTextview173"
                app:layout_constraintTop_toBottomOf="@+id/csTextview173"/>
            <ImageView
                android:id="@+id/csImageview48"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview176"
                app:layout_constraintStart_toStartOf="@+id/csImageview47"
                app:layout_constraintTop_toTopOf="@+id/csTextview176"
                app:srcCompat="@drawable/cs_oc_late_fees_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview176"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_protocol_late_fees"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview48"
                app:layout_constraintTop_toBottomOf="@+id/csTextview174"/>
            <ImageView
                android:id="@+id/csImageview49"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview179"
                app:layout_constraintStart_toStartOf="@+id/csImageview48"
                app:layout_constraintTop_toTopOf="@+id/csTextview178"
                app:srcCompat="@drawable/cs_oc_flexi_credit_penalties_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview178"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_protocol_flexi_credit_penalties"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview49"
                app:layout_constraintTop_toBottomOf="@+id/csTextview176"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview179"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_protocol_freezing_or_lower_limit"
                app:layout_constraintStart_toStartOf="@+id/csTextview178"
                app:layout_constraintTop_toBottomOf="@+id/csTextview178"/>
            <ImageView
                android:id="@+id/csImageview50"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview181"
                app:layout_constraintStart_toStartOf="@+id/csImageview49"
                app:layout_constraintTop_toTopOf="@+id/csTextview180"
                app:srcCompat="@drawable/cs_oc_credit_bureau_report_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview180"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_protocol_credit_bureau_report"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview50"
                app:layout_constraintTop_toBottomOf="@+id/csTextview179"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/csTextview181"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_protocol_reported_to_credit_bureau"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/csTextview180"
                app:layout_constraintTop_toBottomOf="@+id/csTextview180"/>
            <CheckBox
                android:id="@+id/proto_cb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@drawable/cs_cl_checkbox_selector"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/proto_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/proto_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:lineSpacingExtra="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/proto_cb"
                app:layout_constraintTop_toBottomOf="@+id/csTextview181"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/protocol_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="csTextview181, proto_cb, proto_tv"/>
            <Button
                android:textColor="@color/ppColorButtonTextWhite"
                android:id="@+id/confirm_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:text="@string/core_confirm"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/proto_tv"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
                android:id="@+id/csTextview183"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/confirm_bt"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
