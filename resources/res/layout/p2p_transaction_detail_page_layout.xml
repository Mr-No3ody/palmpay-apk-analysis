<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/p2p_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:cv_title_bar_title="@string/core_transaction_details"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_head"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="12dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/p2p_transaction_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="12dp"/>
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/p2p_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:id="@+id/p2p_status_logo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cv_success_small"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#858a8f"
                    android:id="@+id/p2p_status_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginBottom="0.5dp"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <ImageView
            android:id="@+id/p2p_logo_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/p2p_exchange_cash_logo"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_head">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/p2p_data_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
                android:id="@+id/p2p_booked_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
                android:id="@+id/p2p_booked_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
                android:id="@+id/p2p_booked_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
                android:id="@+id/p2p_booked_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PItemView
                android:id="@+id/p2p_booked_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <com.transsnet.palmpay.custom_view.model.OrderResultCustomerServiceModel
        android:id="@+id/p2p_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/p2p_body"/>
</androidx.constraintlayout.widget.ConstraintLayout>
