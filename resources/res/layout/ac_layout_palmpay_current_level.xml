<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:srcCompat="@drawable/ac_bg_tier_1"/>
    <ImageView
        android:id="@+id/ivTier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_tier_1"
        android:scaleType="fitXY"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupTier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="space, ivTier, tvAmount1, tvAmount2, tvDailyLimit, tvMaxBalance"/>
    <TextView
        android:textSize="@dimen/dp22"
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvTier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_unverified"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="@+id/ivBg"
        style="@style/txt_me_w_b"/>
    <TextView
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvDailyLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/ac_daily_transaction_limit_2"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toBottomOf="@+id/tvTier"
        style="@style/txt_mi_w"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivDailyLimitTips"
        android:padding="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ac_color_current_tier_text"
        app:iiv_icon="pay_WarningOutline"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDailyLimit"
        app:layout_constraintStart_toEndOf="@+id/tvDailyLimit"
        app:layout_constraintTop_toTopOf="@+id/tvDailyLimit"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount1"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toBottomOf="@+id/tvDailyLimit"
        style="@style/txt_b_w_b"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvMaxBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ac_maximum_balance"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvTier"
        style="@style/txt_mi_w"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount2"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
        app:layout_constraintStart_toStartOf="@+id/tvMaxBalance"
        app:layout_constraintTop_toBottomOf="@+id/tvMaxBalance"
        style="@style/txt_b_w_b"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivStateBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/tvState"
        app:layout_constraintEnd_toEndOf="@+id/tvState"
        app:layout_constraintStart_toStartOf="@+id/tvState"
        app:layout_constraintTop_toTopOf="@+id/tvState"
        app:srcCompat="@drawable/ac_bg_kyc_invalid_state"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp11"
        android:gravity="top"
        android:id="@+id/tvState"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Your transaction has been limited due to lack of verification , please upgrade your KYC level."
        android:lines="2"
        android:drawablePadding="4dp"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp8"
        app:iiv_start_color="@color/cv_color_ffffff"
        app:iiv_start_icon="pay_WarningOutline"
        app:iiv_start_size="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTier"
        style="@style/txt_mi_w"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvQuota"
        android:background="@drawable/cv_shape_rect_corner_16_bg_white"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:text="Manage Transaction Limits"
        android:includeFontPadding="false"
        android:drawablePadding="4dp"
        android:layout_marginStart="@dimen/dp12"
        android:backgroundTint="@color/transparent_white_20"
        android:paddingHorizontal="@dimen/dp8"
        app:iiv_start_color="@color/ac_color_current_tier_text"
        app:iiv_start_icon="pay_Setup"
        app:iiv_start_size="@dimen/dp24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount1"
        style="@style/txt_mi_w"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutState"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvState, ivStateBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
