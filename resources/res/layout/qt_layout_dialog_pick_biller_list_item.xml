<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_list_item_bg"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp60"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_biller_icon"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/text_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp11"
            android:layout_marginBottom="@dimen/dp11"
            android:layout_marginEnd="@dimen/dp20">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tv_biller_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                style="@style/txt_me_b"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/qlp_ll1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/tv_biller_name">
                <ImageView
                    android:id="@+id/iv_coupon_star"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp2"
                    android:src="@drawable/cv_coupon_star"
                    android:layout_marginStart="@dimen/dp10"/>
                <ImageView
                    android:id="@+id/iv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="@dimen/dp10"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center"
                    android:id="@+id/iv_cashback"
                    android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp2"
                    android:maxWidth="100dp"
                    android:paddingStart="@dimen/dp7"
                    android:paddingEnd="@dimen/dp7"
                    android:layout_marginStart="@dimen/dp10"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/tv_biller_name"/>
</LinearLayout>
