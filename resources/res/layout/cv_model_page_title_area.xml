<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cmpta_root"
    android:background="@drawable/cv_gradient_purple_horizontal"
    android:layout_width="match_parent"
    android:layout_height="158dp">
    <ImageView
        android:id="@+id/cmpta_back_iv"
        android:padding="@dimen/dp15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:src="@drawable/cv_arrow_back_white"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/cmpta_right_top_text"
        android:padding="@dimen/dp15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/cmpta_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_above="@+id/cmpta_content"
        android:layout_marginStart="@dimen/dp15"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/cmpta_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp15"/>
</RelativeLayout>
