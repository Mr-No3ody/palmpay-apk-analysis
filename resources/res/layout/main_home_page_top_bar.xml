<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/main_home_top_bar_height"
    android:paddingStart="@dimen/dp16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:maxLength="15"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivBell"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp12"
        android:layout_marginEnd="4dp"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_News"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvMsgCount"
        android:background="@drawable/main_bg_message_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintStart_toStartOf="@+id/ivBell"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivCustomerService"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp16"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_CustomerService"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/topBarEndBarrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarEndBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ivBell,ivSecurityCenter"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivSecurityCenter"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="4dp"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_SecurityOutline"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivBell"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSecurityCenterDot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/cv_red_point"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/ivSecurityCenter"
        app:layout_constraintTop_toTopOf="@+id/ivSecurityCenter"/>
</androidx.constraintlayout.widget.ConstraintLayout>
