<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_start_icon"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:layout_marginLeft="@dimen/ppEditTextMarginLeft"
        android:contentDescription="icon"
        app:layout_constraintBottom_toBottomOf="@+id/tv_country_code"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_country_code"/>
    <View
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="0.1dp"
        android:layout_height="10dp"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        app:layout_constraintLeft_toRightOf="@+id/iv_start_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginLeft"/>
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_label"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginRight="@dimen/ppEditTextMarginRight"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/iv_start_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginLeft"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:enabled="false"
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_country_code"
        android:background="@null"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:cursorVisible="false"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintLeft_toRightOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextDisable"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="@+id/et_input"
        app:layout_constraintStart_toStartOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextPrimary"
        android:textColorHint="@color/ppColorTextDisable"
        android:gravity="center_vertical"
        android:id="@+id/et_input"
        android:background="@null"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_8"
        android:layout_marginRight="@dimen/ppEditTextMarginIconLeft"
        android:maxLines="1"
        android:inputType="phone"
        android:paddingVertical="1dp"
        android:autofillHints=""
        app:hintTextColor="@color/ppColorTextDisable"
        app:layout_constraintLeft_toRightOf="@+id/tv_country_code"
        app:layout_constraintRight_toLeftOf="@+id/leftBarrier"
        app:layout_constraintTop_toBottomOf="@+id/tv_label"
        app:layout_goneMarginLeft="0dp"
        app:layout_goneMarginRight="@dimen/ppEditTextMarginHalfRight"
        app:layout_goneMarginTop="@dimen/ppEditTextMarginTop_18"/>
    <ImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:src="@drawable/lib_ui_icon_edit_clear_24dp"
        android:contentDescription="clearIcon"
        android:layout_marginEnd="@dimen/ppEditTextMarginHalfRight"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/iv_end_icon"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginEnd="16dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/leftBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_clear,iv_end_icon"/>
    <ImageView
        android:id="@+id/iv_end_icon"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:contentDescription="endIcon"
        android:layout_marginEnd="@dimen/ppEditTextMarginRight"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginRight="8dp"/>
    <View
        android:id="@+id/iv_line"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_12"
        android:layout_marginRight="@dimen/ppEditTextMarginRight"
        app:layout_constraintLeft_toRightOf="@+id/iv_start_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginLeft"/>
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_bottom_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_2"
        android:layout_marginRight="@dimen/ppEditTextMarginRight"
        android:layout_marginBottom="@dimen/ppEditTextMarginTop_4"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_start_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_line"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginLeft"/>
</merge>
