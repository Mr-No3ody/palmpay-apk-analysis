<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fb_mbci_root"
    android:background="@drawable/fb_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fb_dp50"
    android:paddingStart="@dimen/fb_dp15"
    android:paddingEnd="@dimen/fb_dp15">
    <ImageView
        android:id="@+id/fb_mbci_access_bank_iv"
        android:layout_width="@dimen/fb_dp25"
        android:layout_height="@dimen/fb_dp25"
        android:layout_marginTop="@dimen/fb_dp13"
        android:src="@drawable/fb_bank_loading_icon"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/fb_mbci_bank_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp10"
        android:layout_marginTop="@dimen/fb_dp15"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/fb_mbci_right_iv"
        android:layout_toRightOf="@+id/fb_mbci_access_bank_iv"
        android:layout_marginStart="@dimen/fb_dp10"
        android:layout_toStartOf="@+id/fb_mbci_right_iv"
        android:layout_toEndOf="@+id/fb_mbci_access_bank_iv"
        style="@style/fb_txt_me_b"/>
    <ImageView
        android:id="@+id/fb_mbci_right_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_small_margin"
        android:src="@drawable/fb_arrow_drop_down"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/fb_small_margin"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/fb_mbci_bottom_line"
        android:background="@color/fb_divider_color_gray"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="@dimen/fb_dp14"
        android:textColor="@color/fb_text_color_gray2"
        android:id="@+id/fb_mbci_hint_text_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp10"
        android:layout_toRightOf="@+id/fb_mbci_access_bank_iv"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/fb_cmbii_view_default_card"
        android:visibility="gone"
        android:layout_width="@dimen/fb_dp79"
        android:layout_height="@dimen/fb_dp14"
        android:layout_marginLeft="@dimen/fb_dp10"
        android:layout_marginTop="@dimen/fb_dp7"
        android:src="@drawable/fb_default_card"
        android:layout_toRightOf="@+id/fb_mbci_access_bank_iv"
        android:layout_below="@+id/fb_mbci_bank_name_tv"/>
</RelativeLayout>
