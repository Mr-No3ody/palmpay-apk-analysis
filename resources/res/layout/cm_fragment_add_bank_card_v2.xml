<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="start"
                android:id="@+id/tvTopTips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/core_please_enter_your_card_details"
                style="@style/Text.medium.202046.12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_16_bg_white"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="left"
                    android:id="@+id/tv_card_no_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/core_card_number"
                    android:drawablePadding="@dimen/dp4"
                    app:iiv_end_color="@color/ppColorTextNormal"
                    app:iiv_end_icon="pay_WarningOutline"
                    app:iiv_end_size="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.12"/>
                <EditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center_vertical"
                    android:id="@+id/et_bank_card_no"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    android:maxLines="1"
                    android:digits="0123456789 "
                    android:inputType="number"
                    app:layout_constraintTop_toBottomOf="@+id/tv_card_no_title"
                    style="@style/Text.medium.202046.16"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_card_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/et_bank_card_no"/>
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_valid_thru_title"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/core_valid_thru_title"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="@+id/med_valid_thru"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/med_valid_thru"
                    app:layout_constraintTop_toBottomOf="@+id/med_card_no"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_valid_thru"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp44"
                    android:digits="0123456789"
                    app:layout_constraintEnd_toEndOf="@+id/med_valid_thru"
                    app:layout_constraintStart_toStartOf="@+id/med_valid_thru"
                    app:layout_constraintTop_toBottomOf="@+id/tv_valid_thru_title"
                    style="@style/Text.medium.202046.16"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_valid_thru"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toStartOf="@+id/med_cvv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_valid_thru"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_cvv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/core_cvv"
                    android:drawablePadding="@dimen/dp4"
                    app:iiv_end_color="@color/ppColorTextNormal"
                    app:iiv_end_icon="pay_WarningOutline"
                    app:iiv_end_size="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_valid_thru_title"
                    app:layout_constraintEnd_toEndOf="@+id/med_cvv"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/med_cvv"
                    app:layout_constraintTop_toTopOf="@+id/tv_valid_thru_title"
                    style="@style/Text.6f7b85.12"/>
                <EditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center_vertical"
                    android:id="@+id/et_cvv"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp44"
                    android:inputType="number"
                    app:layout_constraintEnd_toEndOf="@+id/med_cvv"
                    app:layout_constraintStart_toStartOf="@+id/med_cvv"
                    app:layout_constraintTop_toBottomOf="@+id/tv_cvv_title"
                    style="@style/Text.medium.202046.16"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_cvv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/med_valid_thru"
                    app:layout_constraintTop_toBottomOf="@+id/et_cvv"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="left"
                    android:id="@+id/tv_card_pin_title"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/core_card_pin"
                    android:drawablePadding="@dimen/dp4"
                    app:iiv_end_color="@color/transparent"
                    app:iiv_end_icon="pay_WarningOutline"
                    app:iiv_end_size="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/med_valid_thru"
                    style="@style/Text.6f7b85.12"/>
                <EditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center_vertical"
                    android:id="@+id/et_card_pin"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    android:maxLines="1"
                    android:maxLength="4"
                    android:digits="0123456789"
                    android:inputType="numberPassword"
                    app:layout_constraintTop_toBottomOf="@+id/tv_card_pin_title"
                    style="@style/Text.medium.202046.16"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/iiv_card_pin_show"
                    android:padding="@dimen/dp2"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp44"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_Hide"
                    app:iiv_size="@dimen/dp24"
                    app:layout_constraintBottom_toBottomOf="@+id/et_card_pin"
                    app:layout_constraintEnd_toEndOf="@+id/et_card_pin"
                    app:layout_constraintTop_toTopOf="@+id/et_card_pin"/>
                <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
                    android:id="@+id/med_card_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/et_card_pin"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/tv_add_card_tips"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                style="@style/Text.9ca2aa.12"/>
            <com.palmpay.lib.ui.button.PpButton
                android:enabled="false"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/next_bt"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginBottom="@dimen/dp8"
                android:text="@string/core_next"
                android:layout_marginVertical="@dimen/dp8"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:id="@+id/select_other_method_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginBottom="16dp"
        android:text="@string/cm_palmpay_security_center"
        android:drawablePadding="@dimen/dp4"
        android:drawableStart="@drawable/cv_palmpay_logo_small"
        style="@style/Text.medium.202046.14"/>
</LinearLayout>
