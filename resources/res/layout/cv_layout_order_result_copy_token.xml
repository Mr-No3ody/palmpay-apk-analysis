<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp60"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp8">
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_item_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_token"
        style="@style/txt_mi_g"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_item_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_item_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/txt_me_b"/>
        <ImageView
            android:id="@+id/iv_item_copy_icon"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:src="@drawable/cv_gray_copy_icon_16"
            android:layout_marginStart="@dimen/dp4"/>
    </LinearLayout>
</LinearLayout>
