<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ViewStub
                android:id="@+id/vs_header"
                android:layout="@layout/main_layout_coupon_package_result_header"
                android:inflatedId="@+id/v_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llOrderInfo"
                android:background="@color/md_white_1000"
                android:paddingTop="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                android:id="@+id/asyncSingleAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout="@layout/main_layout_single_ad"
                app:mode="2"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/result_two_btn_view"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <Button
            android:textSize="16dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_left_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="16dp"
            android:textColor="@color/md_white_1000"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_right_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/main_view_coupon"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp12"/>
    </LinearLayout>
</LinearLayout>
