<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutWaiverHeaderRoot"
    android:paddingTop="@dimen/dp16"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16">
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="left"
        android:id="@+id/tvWaiverHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/ivWaiverCardArt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <ImageView
        android:id="@+id/ivWaiverCardArt"
        android:layout_width="@dimen/dp80"
        android:layout_height="@dimen/dp80"
        android:layout_marginTop="@dimen/dp10"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_cl_loan_repayment_fully_date_bj_item1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutWaiverSummaryBubble"
        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp6"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWaiverHeaderTitle">
        <ImageView
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:contentDescription="@null"
            app:srcCompat="@drawable/cs_cl_loan_fully_date_bj3"
            app:tint="@color/ppColorWarning"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorWarning"
            android:id="@+id/tvWaiverHeaderSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp6"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
