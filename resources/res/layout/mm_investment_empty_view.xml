<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_icon_investment_empty"
        app:layout_constraintBottom_toTopOf="@+id/tvTotalPaybackKey"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.33"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/tvTotalPaybackKey"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/mm_total_interest"
        app:layout_constraintBottom_toTopOf="@+id/tvTotalPaybackAmount"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv"
        style="@style/Text.979797.12"/>
    <TextView
        android:id="@+id/tvTotalPaybackAmount"
        android:layout_marginTop="@dimen/dp8"
        android:text="₦0.00"
        app:layout_constraintBottom_toTopOf="@+id/tvMaturedTips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalPaybackKey"
        style="@style/Text.202046.26"/>
    <TextView
        android:id="@+id/tvMaturedTips"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp40"
        android:text="@string/mm_all_matured_tips"
        android:lineHeight="@dimen/dp22"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalPaybackAmount"
        style="@style/Text.medium.202046.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
