<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivItemBg"
        android:layout_width="wrap_content"
        android:layout_height="130dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ac_sign_up_coupon_bg_2"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/text1"
        android:background="@drawable/ac_sign_up_coupon_header_bg"
        android:paddingLeft="12dp"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="12dp"
        android:paddingBottom="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:maxLength="18"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/dp2"
        app:layout_constraintEnd_toEndOf="@+id/ivItemBg"
        app:layout_constraintStart_toStartOf="@+id/ivItemBg"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp28"
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:id="@+id/text2"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="@+id/ivItemBg"
        app:layout_constraintStart_toStartOf="@+id/ivItemBg"
        app:layout_constraintTop_toBottomOf="@+id/text1"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvExpireTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/ivItemBg"
        app:layout_constraintStart_toStartOf="@+id/ivItemBg"
        app:layout_constraintTop_toBottomOf="@+id/text2"
        style="@style/txt_mi_b_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
