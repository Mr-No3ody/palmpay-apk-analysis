<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
        android:id="@+id/tv_limit_time_offer"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        android:drawableLeft="@drawable/cv_notify_icon"
        android:drawablePadding="4dp"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        app:ad_text_color="@color/ppColorTextPrimary"
        app:ad_text_size="@dimen/dp12"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_channel_notice"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        android:paddingHorizontal="@dimen/dp16">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_notify_icon"/>
        <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeTextView
            android:id="@+id/tv_channel_notice"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp4"
            app:mv_text_color="@color/ppColorTextPrimary"
            app:mv_text_size="@dimen/dp12"/>
    </LinearLayout>
</merge>
