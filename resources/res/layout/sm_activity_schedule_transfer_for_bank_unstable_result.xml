<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/sm_book_transfer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/Text.medium.202046.24"/>
    <View
        android:background="@drawable/cv_shape_rect_corner_16_bg_dark"
        android:layout_width="match_parent"
        android:layout_height="83dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_title"/>
    <ImageView
        android:id="@+id/iv_step_1"
        android:layout_width="@dimen/dp30"
        android:layout_height="@dimen/dp30"
        android:layout_marginTop="@dimen/dp40"
        android:src="@drawable/sm_ic_request_step_1"
        android:layout_marginStart="@dimen/dp35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_top_title"/>
    <TextView
        android:id="@+id/tv_step_1_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sm_successfully_booked_transfer"
        android:layout_marginStart="@dimen/dp15"
        app:layout_constraintStart_toEndOf="@+id/iv_step_1"
        app:layout_constraintTop_toTopOf="@+id/iv_step_1"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:id="@+id/tv_create_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintStart_toStartOf="@+id/tv_step_1_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_step_1_title"
        style="@style/Text.6f7b85.14"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_step_2"
        android:background="@drawable/cv_shape_rect_corner_16_bg_dark"
        android:paddingTop="@dimen/dp20"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/ad_dp_52"
        android:layout_marginRight="@dimen/dp16"
        android:paddingStart="@dimen/dp64"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp20"
        app:layout_constraintTop_toBottomOf="@+id/iv_step_1">
        <TextView
            android:id="@+id/tv_step_1_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sm_waiting_for_service_restore"
            app:layout_constraintStart_toEndOf="@+id/iv_step_1"
            app:layout_constraintTop_toTopOf="@+id/iv_step_1"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tv_waiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp16"
            android:lineHeight="@dimen/dp21"
            app:layout_constraintStart_toStartOf="@+id/tv_step_1_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_step_1_title"
            style="@style/Text.6f7b85.14"/>
    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/core_ic_request_dash_line_1"
        app:layout_constraintEnd_toEndOf="@+id/iv_step_1"
        app:layout_constraintStart_toStartOf="@+id/iv_step_1"
        app:layout_constraintTop_toBottomOf="@+id/iv_step_1"/>
    <ImageView
        android:id="@+id/iv_step_2"
        android:layout_width="@dimen/dp30"
        android:layout_height="@dimen/dp30"
        android:layout_marginTop="73dp"
        android:src="@drawable/sm_ic_request_step_2"
        android:layout_marginStart="@dimen/dp35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_step_1"/>
    <TextView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tv_step_3_title"
        android:background="@drawable/cv_shape_rect_corner_16_bg_dark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/sm_transfer_submitted"
        android:paddingStart="@dimen/dp64"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ll_step_2"
        style="@style/Text.medium.202046.16"/>
    <View
        android:id="@+id/v_dash_line_step_2"
        android:background="@drawable/cv_dash_line_6306b2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.3"
        android:layerType="software"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/iv_step_3"
        app:layout_constraintEnd_toEndOf="@+id/iv_step_2"
        app:layout_constraintStart_toStartOf="@+id/iv_step_2"
        app:layout_constraintTop_toBottomOf="@+id/iv_step_2"/>
    <ImageView
        android:id="@+id/iv_step_3"
        android:layout_width="@dimen/dp30"
        android:layout_height="@dimen/dp30"
        android:src="@drawable/sm_ic_request_step_3"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_step_3_title"
        app:layout_constraintStart_toStartOf="@+id/tv_step_3_title"
        app:layout_constraintTop_toTopOf="@+id/tv_step_3_title"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tv_step_3_title">
        <Button
            android:textSize="16dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_left_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:text="@string/sm_complete_text"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="16dp"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_right_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:text="@string/cv_view_detail"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp12"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
