<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="0dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/fb_imageViewBack"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/fb_actionbar_back_white"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"/>
    <TextView
        android:textSize="18dp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/fb_textViewTitle"
        android:paddingRight="@dimen/fb_extra_margin"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_toRightOf="@+id/fb_imageViewBack"
        android:fontFamily="sans-serif-medium"
        android:paddingEnd="@dimen/fb_extra_margin"
        android:layout_toEndOf="@+id/fb_imageViewBack"/>
    <View
        android:id="@+id/fb_viewDivider"
        android:background="@color/fb_divider_color_gray"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15dp"/>
</RelativeLayout>
