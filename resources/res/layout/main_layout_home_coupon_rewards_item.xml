<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="109dp"
    android:layout_height="110dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_bg_palmzone_coupon"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="@+id/ivBg"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_number_me_b_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/btnClaim"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp8"
        android:minWidth="@dimen/dp40"
        android:text="@string/core_claim"
        android:backgroundTint="@color/ppColorTextPrimary"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:loading_size="@dimen/dp10"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/btnUse"
        android:background="@drawable/main_btn_bg_rewards_coupon_use"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp8"
        android:minWidth="@dimen/dp46"
        android:text="@string/core_use"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        style="@style/ppStrokeButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
