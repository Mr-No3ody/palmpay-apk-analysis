<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_right_text="@string/qt_history"
        app:title_bar_title="@string/qt_jamb"/>
    <com.transsnet.palmpay.core.viewmodel.ModelBillNoticeItem
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cv_notice_category_id="23"
        app:cv_notice_slot_id="@string/ad_payment_jamb_top_text_slot_id"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/clBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.banner.BannerAdView
                android:id="@+id/adBanner"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp20"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:ad_rounded_corners="@dimen/dp8"
                app:layout_constraintTop_toTopOf="parent"
                app:slot_id="@string/jamb_home_page_banner_slot_id"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp20"
                android:paddingRight="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:layout_constraintTop_toBottomOf="@+id/adBanner">
                <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorPrimary"
                    android:ellipsize="marquee"
                    android:gravity="center_vertical"
                    android:id="@+id/adNotice"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginTop="0dp"
                    android:drawableLeft="@drawable/qt_icon_colorful_gift"
                    android:drawablePadding="4dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.transsnet.palmpay.custom_view.ModelItemSelection
                        android:id="@+id/inputPaymentItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cv_item_selection_title="@string/qt_exam_item"
                        app:cv_item_selection_title_text_size="@dimen/dp12"
                        app:cv_item_selection_title_visible="true"
                        app:cv_item_selection_value_text_size="@dimen/dp16"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp80"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/qab_coupon_iv"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp18"
                            android:layout_marginTop="@dimen/dp2"
                            android:src="@drawable/cv_coupon_star"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/ppColorTextBase"
                            android:gravity="center"
                            android:id="@+id/qab_cashback_iv"
                            android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp18"
                            android:layout_marginTop="@dimen/dp2"
                            android:paddingStart="@dimen/dp7"
                            android:paddingEnd="@dimen/dp7"
                            android:layout_marginStart="@dimen/dp10"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                    android:id="@+id/modelProfileCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:cv_arrow_icon_visible="false"
                    app:cv_hint="@string/qt_enter_account_number"
                    app:cv_show_error_text="true"
                    app:cv_title="@string/qt_profile_code"
                    app:cv_title_visible="true"/>
                <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                    android:id="@+id/modelMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    app:cv_arrow_icon_visible="false"
                    app:cv_hint="@string/core_enter_mobile_number"
                    app:cv_show_error_text="true"
                    app:cv_title="@string/core_mobile_number"
                    app:cv_title_visible="true"/>
                <com.palmpay.lib.ui.edit.PpAmountEditText
                    android:id="@+id/editTextPayAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:am_edit_hint="@string/core_enter_amount"
                    app:am_edit_show_button="false"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/tvDiscount"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:drawableLeft="@drawable/cv_icon_descount_percent"
                    android:drawablePadding="3dp"/>
                <TextView
                    android:enabled="false"
                    android:textAppearance="@style/txt_me_w"
                    android:textColor="@color/cv_button_white_text_selector"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/textViewNext"
                    android:background="@drawable/cv_button_bg_purple_corner"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="@dimen/dp6"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="@dimen/dp6"
                    android:layout_marginBottom="15dp"
                    android:text="@string/core_next"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:elevation="@dimen/core_default_elevation"
                    android:layout_marginHorizontal="@dimen/dp6"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
