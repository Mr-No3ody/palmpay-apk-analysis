<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@color/ppColorBackgroundLight"
            android:paddingTop="@dimen/dp10"
            android:paddingBottom="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.custom_view.StateImageView
                android:id="@+id/repay_ins_back_siv"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_oc_back_icon_black"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/ins_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_repay_title"
                    android:fontFamily="sans-serif-medium"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/bill_month_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_ins_bill_cycle"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/oc_bill_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
            </LinearLayout>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/server_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp16"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_CustomerService"
                app:iiv_size="24dp"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cs_oc_repay_zone_bg"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/oc_ins_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_spread_repayment"
                        android:drawablePadding="@dimen/dp_4"
                        android:drawableEnd="@drawable/cs_oc_spread_repay_tips"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/oc_ins_symbol_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/oc_ins_input_amount_et"
                        app:layout_constraintStart_toStartOf="@+id/oc_ins_title_tv"
                        app:layout_constraintTop_toTopOf="@+id/oc_ins_input_amount_et"/>
                    <com.transsnet.palmpay.custom_view.AmountEditText
                        android:enabled="false"
                        android:textSize="36sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:textColorHint="#c0c3c8"
                        android:gravity="center_vertical"
                        android:id="@+id/oc_ins_input_amount_et"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp45"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintEnd_toStartOf="@+id/oc_ins_clear_img"
                        app:layout_constraintStart_toEndOf="@+id/oc_ins_symbol_tv"
                        app:layout_constraintTop_toBottomOf="@+id/oc_ins_title_tv"
                        style="@style/txt_number_s_b_b"/>
                    <ImageView
                        android:id="@+id/oc_ins_clear_img"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/cs_cl_repay_clear_icon"
                        app:layout_constraintBottom_toBottomOf="@+id/oc_ins_input_amount_et"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/oc_ins_input_amount_et"/>
                    <View
                        android:id="@+id/oc_ins_input_divider_view"
                        android:background="@color/cs_cl_input_divider_normal_color"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@+id/oc_ins_clear_img"
                        app:layout_constraintStart_toStartOf="@+id/oc_ins_symbol_tv"
                        app:layout_constraintTop_toBottomOf="@+id/oc_ins_symbol_tv"/>
                    <com.transsnet.palmpay.credit.view.RepayStampDutyView
                        android:id="@+id/repayStampDutyView"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="@+id/oc_ins_input_divider_view"
                        app:layout_constraintStart_toStartOf="@+id/oc_ins_input_divider_view"
                        app:layout_constraintTop_toBottomOf="@+id/oc_ins_input_divider_view"/>
                    <TextView
                        android:textColor="@color/cs_cl_max_amount_tips_txt_color"
                        android:id="@+id/oc_ins_amount_tips_tv"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/oc_ins_input_divider_view"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="@+id/oc_ins_input_divider_view"
                        app:layout_constraintTop_toBottomOf="@+id/oc_ins_input_divider_view"
                        app:layout_constraintVertical_bias="0"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/oc_ins_detail_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_spread_repayment_plan"
                            android:layout_weight="1"
                            style="@style/csOcInsItemTitleTextStyle"/>
                        <TextView
                            android:textColor="@color/cs_main_color"
                            android:id="@+id/selected_pay_in_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/cs_oc_ins_down_arrow"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/oc_ins_count_rv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/coupon_day_tv"
                        style="@style/csOcInsItemDividerStyle"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/repayment_plan_cl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16">
                        <TextView
                            android:id="@+id/csTextview22"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_repayment_schedule"
                            android:layout_weight="1"
                            app:layout_constraintEnd_toStartOf="@+id/cur_plan_content_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/csOcInsItemTitleTextStyle"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cs_main_color"
                            android:id="@+id/cur_plan_content_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/cs_oc_ins_right_arrow"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextDisable"
                            android:gravity="start"
                            android:id="@+id/cur_plan_interest_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/cur_plan_content_tv"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/repayment_date_divider_view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/coupon_day_tv"
                        style="@style/csOcInsItemDividerStyle"/>
                    <LinearLayout
                        android:id="@+id/overdue_item_ll"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_overdue_interest"
                            android:layout_weight="1"
                            style="@style/csOcInsItemTitleTextStyle"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cs_main_color"
                            android:id="@+id/overdue_interest_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/csOcInsItemDividerStyle"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16">
                        <TextView
                            android:id="@+id/csTextview69"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_current_repayment"
                            android:layout_weight="1"
                            style="@style/csOcInsItemTitleTextStyle"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cs_main_color"
                            android:id="@+id/oc_ins_cur_repay_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/oc_ins_proto_cb"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@drawable/cs_oc_ins_check_ibt_bg"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/spread_proto_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_i_agree_to"
                    android:lineSpacingExtra="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/oc_proto_cb"
                    app:layout_constraintTop_toTopOf="@+id/oc_proto_cb"/>
            </LinearLayout>
            <FrameLayout
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp13">
                <Button
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/cs_spread_txt_color"
                    android:id="@+id/oc_ins_next_bt"
                    android:background="@drawable/cs_oc_repay_bt_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp52"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp12"
                    android:text="@string/cs_confirm_spread"
                    android:textAllCaps="false"
                    android:layout_marginStart="@dimen/dp24"
                    android:layout_marginEnd="@dimen/dp24"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
