<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/cs_oc_contact"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tabBackground="@color/transparent"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/cs_main_color"
        app:tabTextAppearance="@style/NormalTextStyle"
        app:tabTextColor="@color/ppColorTextPrimary"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:background="@drawable/cv_shape_rect_top_corner_white_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="none"/>
</LinearLayout>
