<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ctb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/core_receipt"
        app:title_bar_title=""/>
    <androidx.core.widget.NestedScrollView
        android:gravity="center_horizontal"
        android:id="@+id/nsv"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="@dimen/dp48"
                android:layout_height="@dimen/dp48"
                android:layout_marginTop="@dimen/dp16"
                android:src="@drawable/cv_fixed_saving"/>
            <TextView
                android:id="@+id/tvName"
                android:layout_marginTop="@dimen/dp8"
                style="@style/Text.000000.14"/>
            <TextView
                android:textColor="@color/transparent_80"
                android:id="@+id/tvAmount"
                android:layout_marginTop="@dimen/dp8"
                style="@style/Text.medium.6306b2.30"/>
            <TextView
                android:id="@+id/tvStatus"
                android:layout_marginTop="@dimen/dp8"
                android:drawableLeft="@drawable/cv_icon_success_small"
                android:drawablePadding="@dimen/dp6"
                style="@style/Text.858a8f.12"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/mm_color_f6f6fa"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp16"
                android:divider="@drawable/mm_bg_order_detail_item_divider"
                android:layout_weight="1"
                android:showDividers="middle|beginning">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutBillOrderInfo"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/mm_bg_order_info_divider"
                    android:showDividers="middle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutOrderInfo"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/mm_bg_order_info_divider"
                    android:showDividers="middle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dp20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/mm_bg_order_info_divider"
                    android:showDividers="middle">
                    <TextView
                        android:textColor="@color/mm_color_263138"
                        android:gravity="center"
                        android:id="@+id/tvShareReceipt"
                        android:background="@color/ppColorBackgroundLight"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:text="@string/core_share_receipt"
                        android:drawableRight="@drawable/mm_micro_more_icon"
                        style="@style/Text.000000.14"/>
                    <TextView
                        android:textColor="@color/mm_color_263138"
                        android:gravity="center"
                        android:id="@+id/tvCustomerService"
                        android:background="@color/ppColorBackgroundLight"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:text="@string/mm_contact_customer_service"
                        android:drawableRight="@drawable/mm_micro_more_icon"
                        style="@style/Text.000000.14"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutComplete"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp24"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp24"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp68">
                <com.transsnet.palmpay.custom_view.RoundedTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Complete"
                    app:rtv_background_color="@color/mm_color_6306b2"
                    app:rtv_corner_radius="@dimen/dp12"
                    style="@style/Text.medium.ffffff.16"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layoutCancelAndTry"
                android:paddingLeft="@dimen/dp24"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp24"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp68"
                android:divider="@drawable/mm_bg_transparent_h_divider_16"
                android:showDividers="middle">
                <com.transsnet.palmpay.custom_view.RoundedTextView
                    android:id="@+id/rtvCancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/core_cancel"
                    android:layout_weight="1"
                    app:rtv_background_color="@color/mm_color_f0ecfc"
                    app:rtv_corner_radius="@dimen/dp12"
                    style="@style/Text.medium.6306b2.16"/>
                <com.transsnet.palmpay.custom_view.RoundedTextView
                    android:id="@+id/rtvTryAgain"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/core_try_again1"
                    android:layout_weight="1"
                    app:rtv_background_color="@color/mm_color_6306b2"
                    app:rtv_corner_radius="@dimen/dp12"
                    style="@style/Text.medium.ffffff.16"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
