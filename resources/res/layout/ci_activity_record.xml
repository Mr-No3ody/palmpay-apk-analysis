<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ar_title_bar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="Fund History"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/ar_record_rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
