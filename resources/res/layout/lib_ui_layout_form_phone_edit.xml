<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_label"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_hint"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/viewContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_hint">
        <ImageView
            android:id="@+id/iv_start_icon"
            android:visibility="gone"
            android:layout_width="@dimen/ppEditTextHeight"
            android:layout_height="@dimen/ppEditTextHeight"
            android:contentDescription="icon"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:enabled="false"
            android:textSize="@dimen/ppEditTextSize_16"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tv_country_code"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:clickable="false"
            android:longClickable="false"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:cursorVisible="false"
            android:fontFamily="@font/lib_ui_roboto_lite_regular"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_arrow_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowFill"
            app:iiv_size="24dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextDisable"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:fontFamily="@font/lib_ui_roboto_lite_regular"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/leftBarrier"
        app:layout_constraintStart_toEndOf="@+id/viewContainer"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextPrimary"
        android:textColorHint="@color/ppColorTextDisable"
        android:layout_gravity="center_vertical"
        android:id="@+id/et_input"
        android:background="@null"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:maxLines="1"
        android:inputType="phone"
        android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
        android:paddingVertical="1dp"
        android:autofillHints=""
        app:hintTextColor="@color/ppColorTextDisable"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hint"
        app:layout_constraintEnd_toEndOf="@+id/tv_hint"
        app:layout_constraintStart_toStartOf="@+id/tv_hint"
        app:layout_constraintTop_toTopOf="@+id/tv_hint"/>
    <ImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:src="@drawable/lib_ui_icon_edit_clear_24dp"
        android:contentDescription="clearIcon"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hint"
        app:layout_constraintEnd_toStartOf="@+id/iv_end_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_hint"
        app:layout_goneMarginEnd="16dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/leftBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_clear,iv_end_icon"/>
    <ImageView
        android:id="@+id/iv_end_icon"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:contentDescription="endIcon"
        android:layout_marginEnd="@dimen/ppEditTextMarginRight"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_hint"
        app:layout_goneMarginRight="8dp"/>
    <View
        android:id="@+id/iv_line"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint"/>
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_bottom_message"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_line"/>
</merge>
