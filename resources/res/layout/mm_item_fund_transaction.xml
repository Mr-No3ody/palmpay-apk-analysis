<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_icon_cash_box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvTransactionName"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp12"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toRightOf="@+id/ivIcon"
        app:layout_constraintRight_toLeftOf="@+id/tvTransactionAmount"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="#858a8f"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvFundName"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp12"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvTransactionTime"
        app:layout_constraintLeft_toRightOf="@+id/ivIcon"
        app:layout_constraintRight_toLeftOf="@+id/tvTransactionAmount"
        app:layout_constraintTop_toBottomOf="@+id/tvTransactionName"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.858a8f.14"/>
    <TextView
        android:textColor="#9ca2aa"
        android:id="@+id/tvTransactionTime"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvTransactionName"
        app:layout_constraintTop_toBottomOf="@+id/tvFundName"
        style="@style/Text.858a8f.12"/>
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_marginTop="@dimen/dp14"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:textColor="@color/ppColorSuccess"
        android:id="@+id/tvTransactionStatus"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTransactionAmount"
        style="@style/Text.858a8f.12"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
