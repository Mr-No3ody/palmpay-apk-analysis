<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fb_payment_flexi_bg"
    android:paddingLeft="@dimen/fb_dp16"
    android:paddingTop="@dimen/fb_dp20"
    android:paddingRight="@dimen/fb_dp16"
    android:paddingBottom="@dimen/fb_dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/fb_dp52"
    android:paddingHorizontal="@dimen/fb_dp16">
    <ImageView
        android:id="@+id/fb_iv_payment_flexi_icon"
        android:layout_width="@dimen/fb_dp24"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/fb_flexi_icon"/>
    <TextView
        android:textSize="@dimen/fb_dp12"
        android:textColor="@color/fb_color_19b8ea"
        android:id="@+id/fb_tv_payment_flexi_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fb_payment_flexi_title"
        android:layout_marginStart="@dimen/fb_dp12"
        android:layout_marginEnd="@dimen/fb_dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/fb_flexbox_payment_flexi_tag_layout"
        app:layout_constraintStart_toEndOf="@+id/fb_iv_payment_flexi_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_s_b_b"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/fb_flexbox_payment_flexi_tag_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp2"
        app:alignItems="flex_start"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/fb_tv_payment_flexi_title"
        app:layout_constraintTop_toBottomOf="@+id/fb_tv_payment_flexi_title"
        app:layout_constraintWidth_percent="0.6"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_iv_flexi_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/fb_text_color_black1"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/fb_tv_payment_flexi_get_now"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fb_get_now"
        android:layout_marginStart="@dimen/fb_dp12"
        android:layout_marginEnd="@dimen/fb_dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fb_iv_flexi_arrow"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_s_b_b"/>
</merge>
