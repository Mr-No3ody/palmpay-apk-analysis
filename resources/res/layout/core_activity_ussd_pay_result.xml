<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/dp10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ciImageview"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="70dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cv_result_pending"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263138"
            android:id="@+id/ciTextview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/core_pending"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ciImageview"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#6f7b85"
            android:gravity="center"
            android:id="@+id/ciTextview2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/core_ussd_pay_result_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ciTextview"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#263138"
            android:id="@+id/ussd_phone_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ciTextview2"/>
        <View
            android:id="@+id/ciView2"
            android:background="#f2f3f8"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ussd_phone_num_tv"/>
        <TextView
            android:id="@+id/core_ussd_step_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="10dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ciView2"/>
        <TextView
            android:id="@+id/core_ussd_tip_tv"
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/core_ussd_step_rv"/>
        <Button
            android:textSize="18sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/core_ussd_call_bt"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="330dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="@string/core_tap_to_call"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/core_ussd_tip_tv"/>
        <Button
            android:textSize="18sp"
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/core_ussd_complete_bt"
            android:background="@drawable/cv_button_bg_light_purple_corner"
            android:layout_width="330dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="@string/core_back_fun_page"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="@+id/core_ussd_call_bt"
            app:layout_constraintStart_toStartOf="@+id/core_ussd_call_bt"
            app:layout_constraintTop_toBottomOf="@+id/core_ussd_call_bt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
