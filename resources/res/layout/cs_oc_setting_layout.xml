<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/setting_mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="Settings"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/increase_limit_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_increase_limit"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_increase_limit_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/overpayment_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_overpayment"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_overpayment_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/bill_history_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_setting_bill_history"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_bill_history_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/preferred_pay_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_setting_preferred_flexi_pay"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_preferred_pay_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/repayment_info_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_repayment_information"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_repayment_info"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/auto_repay_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_setting_auto_repay"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_auto_repay_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/condition_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_terms_and_conditions"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_server_condition_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/privacy_tv"
                    android:padding="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_privacy_policy"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_privacy_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/faq_tv"
                    android:padding="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_help"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_setting_help_icon"
                    android:drawableEnd="@drawable/cs_oc_setting_arrow_right_icon"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
