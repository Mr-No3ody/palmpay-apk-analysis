<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/core_oc_refer_earn_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/core_history"
        app:title_bar_style="light"
        app:title_bar_title="@string/cs_flexi_refer_earn"/>
    <com.transsnet.palmpay.custom_view.ObservableScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/topBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp26"
                android:layout_marginRight="@dimen/dp26"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:minHeight="@dimen/dp120"
                android:layout_marginHorizontal="@dimen/dp26"/>
            <com.transsnet.palmpay.custom_view.marqueeview.MarqueeView
                android:layout_gravity="bottom"
                android:id="@+id/marquee"
                android:background="@drawable/cs_oc_refer_earn_notification_bg"
                android:paddingLeft="@dimen/dp20"
                android:paddingRight="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginHorizontal="@dimen/dp24"
                android:paddingHorizontal="@dimen/dp20"
                app:mvSingleLine="true"
                app:mvTextColor="@color/ppColorTextBase"
                app:mvTextSize="@dimen/dp12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/viewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/tvMyCashReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/cs_my_cash_reward"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/cv_text_color_white"
                    android:id="@+id/tvWithdraw"
                    android:background="@drawable/cs_re_withdraw_bg"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp4"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_withdraw"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="@dimen/dp19"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp4"
                    app:layout_constraintBottom_toBottomOf="@+id/tvMyCashReward"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvMyCashReward"/>
                <TextView
                    android:textSize="@dimen/dp20"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/tvCashSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    app:layout_constraintStart_toStartOf="@+id/tvMyCashReward"
                    app:layout_constraintTop_toBottomOf="@+id/tvMyCashReward"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="#8a8cb2"
                    android:id="@+id/tvMoreInvite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/cs_friends_invite_ok_card"
                    android:fontFamily="sans-serif"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvCashSchedule"
                    app:layout_constraintTop_toBottomOf="@+id/tvCashSchedule"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="@+id/tvMore"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMoreInvite"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center"
                    android:id="@+id/tvMore"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp12"
                    android:text="@string/cs_more"
                    android:drawableRight="@drawable/cs_refer_earn_arrow_down"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="@dimen/dp10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/invite_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp14"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp20"
                android:layout_marginHorizontal="@dimen/dp16"
                layout="@layout/cs_layout_re_homepage_webview"/>
            <View
                android:layout_width="1dp"
                android:layout_height="100dp"/>
        </LinearLayout>
    </com.transsnet.palmpay.custom_view.ObservableScrollView>
    <RelativeLayout
        android:id="@+id/inviteAll"
        android:background="@drawable/cs_refer_earn_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_margin="@dimen/dp24"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_invite_all"
            android:drawablePadding="@dimen/dp9"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
</RelativeLayout>
