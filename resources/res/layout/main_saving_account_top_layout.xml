<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMyFortune"
    android:background="@drawable/main_rect_bg_7b43fa_corner_12"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16"
    android:minHeight="@dimen/dp78"
    app:layout_constraintTop_toTopOf="parent">
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvTotalAssets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp10"
        android:text="@string/main_str_total_assets"
        android:includeFontPadding="false"
        android:drawablePadding="4dp"
        app:iiv_start_color="@color/ppColorSuccess"
        app:iiv_start_icon="pay_Security"
        app:iiv_start_size="@dimen/dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <ImageView
        android:id="@+id/ivToggleShowBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:src="@drawable/main_bg_white_eye"
        app:layout_constraintBottom_toBottomOf="@+id/tvTotalAssets"
        app:layout_constraintLeft_toRightOf="@+id/tvTotalAssets"
        app:layout_constraintTop_toTopOf="@+id/tvTotalAssets"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvTotalAssetsAmount"
        android:layout_marginTop="@dimen/dp6"
        android:text="₦0.00"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/tvTotalAssets"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalAssets"
        style="@style/Text"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvYesterdayReturn"
        android:layout_marginRight="@dimen/dp12"
        android:text="@string/main_str_yesterday_earnings"
        app:layout_constraintBottom_toBottomOf="@+id/tvTotalAssets"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTotalAssets"
        style="@style/Text"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvYesterdayReturnAmount"
        android:layout_marginRight="@dimen/dp16"
        android:text="₦0.00"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/tvTotalAssetsAmount"
        app:layout_constraintRight_toRightOf="@+id/ivYesterDayArrow"
        app:layout_constraintTop_toTopOf="@+id/tvTotalAssetsAmount"
        style="@style/Text.medium.202046.20"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivYesterDayArrow"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp12"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvYesterdayReturnAmount"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvYesterdayReturnAmount"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewNext"
        android:paddingLeft="@dimen/dp20"
        android:paddingTop="@dimen/dp20"
        android:paddingRight="@dimen/dp20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp2"
        android:paddingHorizontal="@dimen/dp20"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Arrowdown"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
