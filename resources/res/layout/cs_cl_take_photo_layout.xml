<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/cs_cl_take_photo_bg_img"/>
    <FrameLayout
        android:id="@+id/camera_preview_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="175dp"/>
    <View
        android:id="@+id/focus_img"
        android:background="@drawable/cs_photo_cover_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/dp36"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/oc_take_photo_top_bar"
            layout="@layout/cs_oc_router_top_bar"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/first_tips_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_in_bright"
            android:layout_marginStart="@dimen/dp28"
            android:layout_marginEnd="@dimen/dp28"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/second_tips_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/cs_cl_only_one"
            android:layout_marginStart="@dimen/dp28"
            android:layout_marginEnd="@dimen/dp28"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/photo_img"
        android:visibility="gone"
        android:layout_width="320dp"
        android:layout_height="449dp"
        android:layout_marginTop="@dimen/dp175"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/take_photo_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp25"
        android:src="@drawable/cs_cl_take_photo_bt_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/review_photo_cl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cs_main_color"
            android:gravity="center"
            android:id="@+id/try_again_tv"
            android:background="@drawable/cs_cl_try_again_bt_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_marginBottom="@dimen/dp60"
            android:text="@string/cs_cl_try_again"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/done_tv"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/done_tv"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="@string/core_done"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/try_again_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/try_again_tv"
            app:layout_constraintTop_toTopOf="@+id/try_again_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
