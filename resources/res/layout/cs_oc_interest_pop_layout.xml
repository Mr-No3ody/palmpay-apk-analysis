<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/ivClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dp16"
            android:src="@drawable/cs_oc_close_icon"
            android:layout_marginStart="197.5dp"
            android:layout_marginEnd="@dimen/dp16"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/csTextview49"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_note_that"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/item_one_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:layout_constraintEnd_toStartOf="@+id/more_tv"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/more_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_interest_more"
                        android:drawablePadding="@dimen/dp5"
                        android:drawableEnd="@drawable/cs_oc_interest_down_arrow_icon"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/item_one_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/item_one_tv"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/interest_ll"
                        android:background="@drawable/cs_oc_interest_detail_bg"
                        android:paddingTop="@dimen/dp10"
                        android:paddingBottom="@dimen/dp10"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:paddingStart="@dimen/dp14"
                        android:paddingEnd="@dimen/dp14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/item_one_tv">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_interest_charging_rule"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/interest_detail_ll"
                            android:background="@drawable/cs_oc_interest_list_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp11">
                            <LinearLayout
                                android:paddingTop="@dimen/dp11"
                                android:paddingBottom="@dimen/dp11"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/dp15"
                                android:paddingEnd="@dimen/dp15">
                                <TextView
                                    android:textSize="10sp"
                                    android:textColor="@color/ppColorTextPrimary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="Outstanding principal"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textSize="10sp"
                                    android:textColor="@color/ppColorTextPrimary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Daily interest"/>
                            </LinearLayout>
                            <View
                                android:background="#cacaca"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/interest_rv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/item_two_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="2. Interest should be repaid preferentially when you repay bills."
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/interest_ll"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
            <Button
                android:textSize="16sp"
                android:textColor="@color/cv_color_ffffff"
                android:id="@+id/interest_pop_ok_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:layout_marginTop="@dimen/dp18"
                android:layout_marginBottom="@dimen/dp24"
                android:text="@string/core_ok"
                android:textAllCaps="false"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
