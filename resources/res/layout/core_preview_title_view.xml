<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingRight="15dp"
    android:paddingBottom="@dimen/dp18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp">
    <ImageView
        android:id="@+id/cptv_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="13dp"
        android:gravity="center_vertical"
        android:id="@+id/amount_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_total"
        style="@style/txt_s_lg"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/txt_s_g"/>
    <TextView
        android:textSize="@dimen/dp13"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/cptv_tv1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="@dimen/dp13"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/cptv_tv2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="@dimen/dp13"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cptv_tv3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
