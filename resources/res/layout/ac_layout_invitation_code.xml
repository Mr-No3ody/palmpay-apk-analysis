<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_vertical"
        android:id="@+id/tvInvitationName"
        android:padding="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_invitation_code"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="bottom"
        android:id="@+id/iv_arrow"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Arrowdown"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvInvitationName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvInvitationName"
        app:layout_constraintTop_toTopOf="@+id/tvInvitationName"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:gravity="center"
        android:id="@+id/inputInvitationCode"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="8dp"
        android:hint="@string/ac_enter_an_invitation_code_optional"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tvInvitationName"
        style="@style/txt_me_b"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvInvitationError"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inputInvitationCode"
        style="@style/txt_mi_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
