<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/receive_money_container"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/receive_money_qrcode"
                    android:background="@drawable/main_rm_qrcode_img_bg"
                    android:padding="25dp"
                    android:layout_width="225dp"
                    android:layout_height="225dp"
                    android:layout_marginTop="6dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/spma_refresh_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/core_refresh_qr_code"
                    android:drawableLeft="@drawable/cv_refresh_purple"
                    android:drawablePadding="@dimen/dp5"/>
            </LinearLayout>
            <View
                android:background="#ffe2e8ed"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/set_money"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/main_set_amount_text"
                    android:layout_weight="1"/>
                <View
                    android:background="#ffe2e8ed"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/save_qrcode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/main_save_qrcode_text"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
            android:id="@+id/spma_pay_method"
            android:background="@drawable/cv_shape_rect_bl_br_corner_white_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/receive_money_container"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/spma_auth_area"
            android:background="@drawable/cv_shape_rect_corner_4_bg_white"
            android:paddingLeft="@dimen/dp30"
            android:paddingRight="@dimen/dp30"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="410dp"
            android:paddingHorizontal="@dimen/dp30"> ‰ 
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp50"
                app:iiv_color="@color/ppColorWarning"
                app:iiv_icon="pay_AutoSave"
                app:iiv_size="@dimen/dp80"/>
            <TextView
                android:textSize="@dimen/dp22"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp26"
                android:text="@string/core_open_payment"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2"
                android:text="@string/core_open_payment_hint"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_auto_refresh_periodically"
                    android:drawableLeft="@drawable/cv_shape_circle_gray_95a1a8_5dp"
                    android:drawablePadding="@dimen/dp5"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp2"
                    android:text="@string/core_expires_after_each_use"
                    android:drawableLeft="@drawable/cv_shape_circle_gray_95a1a8_5dp"
                    android:drawablePadding="@dimen/dp5"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp18"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/spma_enable_tv"
                android:background="@drawable/cv_shape_halfround_purple"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:layout_marginTop="@dimen/dp30"
                android:text="@string/core_enable_now"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
