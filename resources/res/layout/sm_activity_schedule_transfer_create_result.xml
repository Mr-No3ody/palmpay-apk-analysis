<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/fl_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_success"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginTop="72dp"
                android:src="@drawable/sm_ic_schedule_created"
                android:contentDescription="@string/sm_schedule_created"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="16dp"
                android:text="@string/sm_schedule_created"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/itvNextOrder"
                android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/dp16"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp10"
                style="@style/Text.medium.202046.14"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_f6f6fa"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="18dp">
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:text="@string/sm_recipient"
                        android:includeFontPadding="false"
                        style="@style/Text.6f7b85.12"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:text="@string/sm_recipient_Account"
                        android:includeFontPadding="false"
                        style="@style/Text.6f7b85.12"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_account"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:text="@string/sm_recipient_bank"
                        android:includeFontPadding="false"
                        style="@style/Text.6f7b85.12"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_bank"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:text="@string/cv_amount"
                        android:includeFontPadding="false"
                        style="@style/Text.6f7b85.12"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_amount"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:text="@string/sm_frequency"
                        android:includeFontPadding="false"
                        style="@style/Text.6f7b85.12"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textColor="@color/ppColorTextPrimary"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_schedule_name"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            style="@style/Text.202046.12"/>
                        <TextView
                            android:textColor="@color/ppColorTextAssist"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:id="@+id/tv_schedule_type"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            style="@style/Text.6f7b85.12"/>
                    </LinearLayout>
                </LinearLayout>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/ppColorTextAssist"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_view_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cv_view_detail"
                    android:includeFontPadding="false"
                    app:iiv_end_color="@color/ppColorTextAssist"
                    app:iiv_end_icon="pay_ArrowRight"
                    app:iiv_end_size="12dp"
                    style="@style/Text.9ca2aa.12"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_bottom"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_complete"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/core_complete"
            android:layout_marginHorizontal="16dp"
            style="@style/txt_me_w_b"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
