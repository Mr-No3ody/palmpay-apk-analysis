<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/topGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvName,ivLogo"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ivLogo,tvName, parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cs_oc_available_amount"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvCardState"
        android:background="@drawable/cs_btn_card_state_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle1"
        app:layout_constraintStart_toEndOf="@+id/tvTitle1"
        app:layout_constraintTop_toTopOf="@+id/tvTitle1"
        style="@style/txt_mi_g"/>
    <TextView
        android:textSize="28sp"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle1"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalCredit"
        android:paddingTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount1"
        style="@style/txt_mi_g"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalCredit"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/activateGroup"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvAmount2,tvTitle2, viewDivider"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/discount_tv"
        android:background="@drawable/cs_oc_discount_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:text="@string/cs_oc_discount"
        android:paddingStart="@dimen/dp5"
        android:paddingEnd="@dimen/dp5"
        app:layout_constraintBottom_toTopOf="@+id/tvAction"
        app:layout_constraintEnd_toEndOf="@+id/tvAction"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/main_installment_label_tv"
        android:background="@drawable/cs_oc_installment_txt_bg"
        android:paddingBottom="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:text="@string/cs_oc_installment_repayment_available"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvAction"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvAction"
        android:background="@drawable/cs_oc_model_repay_bt_bg"
        android:layout_width="@dimen/dp80"
        android:layout_height="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/cs_oc_repay"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvAmount2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAmount2"
        style="@style/txt_mi_w"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/cs_current_outstanding"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/cs_oc_flex_base_color"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="0dp"
        android:drawableRight="@drawable/cs_oc_main_card_right_icon"
        android:drawablePadding="4dp"
        android:layout_marginStart="@dimen/dp16"
        android:drawableTint="#858a8f"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle2"
        style="@style/txt_s_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvState"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="4dp"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount2"
        style="@style/txt_mi_g"/>
    <ImageView
        android:id="@+id/ivInfo"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/oc_finance_faq_icon"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/tvState"
        app:layout_constraintStart_toEndOf="@+id/tvState"
        app:layout_constraintTop_toTopOf="@+id/tvState"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvState,tvAmount2"/>
    <View
        android:id="@+id/viewBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
</merge>
