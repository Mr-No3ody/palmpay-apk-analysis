<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16">
    <View
        android:id="@+id/top_divider_view"
        android:background="#d9fae1"
        android:layout_width="2dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="@+id/plan_progress_pb"
        app:layout_constraintStart_toStartOf="@+id/plan_progress_pb"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_divider_view"
        android:background="#d9fae1"
        android:layout_width="2dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/plan_progress_pb"
        app:layout_constraintStart_toStartOf="@+id/plan_progress_pb"
        app:layout_constraintTop_toBottomOf="@+id/plan_progress_pb"/>
    <ProgressBar
        android:id="@+id/plan_progress_pb"
        android:layout_width="@dimen/dp28"
        android:layout_height="@dimen/dp28"
        android:max="100"
        android:progress="25"
        android:indeterminate="false"
        android:progressDrawable="@drawable/cs_oc_installment_index_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_divider_view"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/index_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/plan_progress_pb"
        app:layout_constraintEnd_toEndOf="@+id/plan_progress_pb"
        app:layout_constraintStart_toStartOf="@+id/plan_progress_pb"
        app:layout_constraintTop_toTopOf="@+id/plan_progress_pb"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_pb"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/due_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
