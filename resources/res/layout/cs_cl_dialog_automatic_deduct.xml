<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_close_icon"
        android:layout_marginEnd="@dimen/dp24"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/extend_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="Automatic Debit"
        android:drawablePadding="@dimen/dp12"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/extend_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="The repayment date will be automatically deducted from the PalmPay Balance/Cashbox/Bank card, or the repayment can be made proactively"
        android:drawablePadding="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/tvConfirm"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_ok"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/cs_main_color"
        android:layout_marginHorizontal="@dimen/dp24"/>
</LinearLayout>
