<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/lite_ard_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:visibility="gone"
                layout="@layout/core_layout_hint_text_in_detail_page"/>
            <com.transsnet.palmpay.custom_view.model.ModelAmountList
                android:id="@+id/lite_ard_amount_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_detail_page_error_reason"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lite_ard_remark_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:id="@+id/lite_ard_remark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp15"/>
                <View
                    android:id="@+id/ard_remark_divider"
                    android:background="#ffe2e8ed"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp15"/>
            </LinearLayout>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/lite_ard_bill_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_show_img="false"
                app:ctai_title="Payment Type"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/lite_ard_item_payment_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_title="Payment Method"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/payment_plan_cl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#6f7b85"
                    android:id="@+id/payment_plan_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/cs_payment_plan"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#263138"
                    android:id="@+id/payment_plan_content_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cs_order_detail_pay_in"
                    app:layout_constraintStart_toStartOf="@+id/payment_plan_title_tv"
                    app:layout_constraintTop_toBottomOf="@+id/payment_plan_title_tv"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#8312ff"
                    android:id="@+id/installment_plan_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_instalment_plan"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/payment_plan_content_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/payment_plan_content_tv"/>
                <View
                    android:background="#e2e8ed"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/payment_plan_content_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/lite_ard_order_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/lite_palmpay_order_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/lite_ard_posted_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/lite_ard_create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp25"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorError"
                android:id="@+id/ard_hint_tv"
                android:paddingLeft="@dimen/dp15"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp11"
                android:text=""/>
            <include
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_contact_service"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layoutViewFlexiBills"
        android:background="@color/cv_color_ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52">
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_view_flexi_bills"
            android:drawablePadding="@dimen/dp8"
            app:iiv_start_color="@color/cs_main_color"
            app:iiv_start_icon="pay_Receipt"
            app:iiv_start_size="@dimen/dp18"
            style="@style/Text.6306b2.16"/>
    </LinearLayout>
</LinearLayout>
