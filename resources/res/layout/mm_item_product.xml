<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp18"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_fixed_saving"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvInterestAmount"
        android:layout_marginLeft="@dimen/dp12"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/tvInterestPa"
        app:layout_constraintLeft_toRightOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:id="@+id/tvPercent"
        android:text="%"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvInterestAmount"
        app:layout_constraintLeft_toRightOf="@+id/tvInterestAmount"
        style="@style/Text.medium.202046.10"/>
    <TextView
        android:id="@+id/tvInterestPa"
        android:text="Interest p.a."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvInterestAmount"
        app:layout_constraintTop_toBottomOf="@+id/tvInterestAmount"
        style="@style/Text.6f7b85.10"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:barrierDirection="right"
        app:constraint_referenced_ids="tvInterestAmount,tvInterestPa"/>
    <TextView
        android:id="@+id/tvDurationNum"
        android:layout_marginLeft="@dimen/dp24"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/tvDuration"
        app:layout_constraintLeft_toRightOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:id="@+id/tvDurationDay"
        android:layout_marginLeft="@dimen/dp3"
        android:text="Days"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvDurationNum"
        app:layout_constraintLeft_toRightOf="@+id/tvDurationNum"
        style="@style/Text.medium.202046.10"/>
    <TextView
        android:id="@+id/tvDuration"
        android:text="Duration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvDurationNum"
        app:layout_constraintTop_toBottomOf="@+id/tvDurationNum"
        style="@style/Text.6f7b85.10"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/md_white_1000"
        android:id="@+id/rtvInvest"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp32"
        android:text="@string/core_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/mm_bg_invest_btn"
        app:rtv_corner_radius="@dimen/dp16"
        style="@style/Text.medium.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
