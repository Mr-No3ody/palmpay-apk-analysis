<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/imageViewShare"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Share"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="@dimen/dp22"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/actur_result_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp2"
            android:text="@string/core_failed_upper"
            android:layout_below="@+id/actur_iv"
            android:layout_centerHorizontal="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/actur_iv"
            android:layout_width="@dimen/cv_result_success_img_size"
            android:layout_height="@dimen/cv_result_success_img_size"
            android:layout_marginTop="@dimen/dp56"
            android:layout_marginBottom="20dp"
            android:src="@drawable/cv_result_success"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/cv_result_success"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/actur_done_tv"
            android:padding="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_done"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/actur_hint_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp25"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp25"
        android:text=""
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/aatu_order_data_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30">
        <include
            android:id="@+id/mam_booker_item"
            layout="@layout/cv_layout_payment_result_data_item"/>
        <include
            android:id="@+id/aatu_amount_item"
            layout="@layout/cv_layout_payment_result_data_item"/>
        <include
            android:id="@+id/aatu_points_earnd_item"
            layout="@layout/cv_layout_payment_result_data_item"/>
        <include
            android:id="@+id/aatu_payment_method_item"
            layout="@layout/cv_layout_payment_result_data_item"/>
    </LinearLayout>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/actur_ad"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp25"
        android:layout_marginTop="30dp"
        android:layout_marginRight="@dimen/dp25"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/actur_complete_btn"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp45"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginRight="@dimen/dp45"
        android:text="@string/core_complete"
        style="@style/ppButtonStyle"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ussd_guide_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/core_how_to_use_ussd"
        android:includeFontPadding="false"
        android:drawablePadding="5dp"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_InformationOutline"
        app:iiv_start_size="@dimen/dp14"/>
</LinearLayout>
