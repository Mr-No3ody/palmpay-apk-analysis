<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="true"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:gravity="left"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="20dp"
        android:text="Want to Earn Interest on Your Available Balance?"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_b_b_b"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv1"
        android:background="@drawable/ac_rect_corner_8_6534f9_foecfc"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="15dp"
        android:text="Yes"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.medium.202046.16"/>
    <ImageView
        android:id="@+id/ivChooseYes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ac_icon_checked"
        app:layout_constraintEnd_toEndOf="@+id/tv1"
        app:layout_constraintTop_toTopOf="@+id/tv1"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv2"
        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp20"
        android:text="No"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv1"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.medium.202046.14"/>
    <ImageView
        android:id="@+id/ivChooseNo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ac_icon_checked"
        app:layout_constraintEnd_toEndOf="@+id/tv2"
        app:layout_constraintTop_toTopOf="@+id/tv2"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvCashbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        android:text="Use CashBox as an available balance that pays you interest daily! (up to 20% p.a.)"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/Text.202046.14"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cslEarn"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="4dp"
        android:paddingTop="12dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@+id/tvCashbox">
        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/tv_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:text=" Earn Daily"
            android:includeFontPadding="false"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/tv_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Transfer"
            android:includeFontPadding="false"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toStartOf="@+id/tv_right"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/tv_left"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/tv_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:text=" Pay Bills"
            android:includeFontPadding="false"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.12"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/cv_rect_corner_12_bg_white"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_right">
            <TextView
                android:id="@+id/tvEarnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If you have ₦10,000, you will earn:"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layoutEstimatedInterestReturnList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:divider="@drawable/ac_earn_interest_divider"
                android:showDividers="middle"
                app:layout_constraintTop_toBottomOf="@+id/tvEarnTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvAgreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirm"
        style="@style/Text.6f7b85.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="20dp"
        android:text="@string/core_continue"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/viewBottom"
        style="@style/ppButtonStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvSkip"
        android:padding="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnConfirm"
        style="@style/txt_s_g"/>
    <include
        android:id="@+id/viewBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
