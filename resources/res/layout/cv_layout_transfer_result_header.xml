<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_transfer_result"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_order_status"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@+id/iv_transfer_result"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_me_b_b"/>
    <TextView
        android:textSize="@dimen/dp32"
        android:gravity="center"
        android:id="@+id/tv_order_result_amount"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_status"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/tv_order_result_status_tips"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_result_amount"
        style="@style/txt_s_lg"/>
</merge>
