<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="19dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/p2p_z"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/p2p_z"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:id="@+id/p2p_booking_code_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/p2p_str_booking_code"/>
            <RelativeLayout
                android:id="@+id/p2p_booking_code_module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_gravity="bottom"
                    android:id="@+id/p2p_copy"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/p2p_code"
                    android:layout_alignBottom="@+id/p2p_code"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_icon="pay_Copy"
                    app:iiv_size="14dp"/>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/p2p_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/p2p_str_please_provide_this_code_at_______"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/p2p_base1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/p2p_base2"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/p2p_base1"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_missed_symbol"
        android:paddingTop="2dp"
        android:visibility="gone"
        android:layout_width="41dp"
        android:layout_height="17dp"
        android:layout_marginLeft="12dp"
        app:cardBackgroundColor="#fe5455"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_base2">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ppColorTextBase"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p2p_str_missed"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
