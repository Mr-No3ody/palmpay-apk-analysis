<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        layout="@layout/ac_layout_login_header"/>
    <TextView
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ac_msg_answer_verify_account_question"
        android:paddingHorizontal="@dimen/dp24"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitleMsg"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp24"
        style="@style/txt_me_b_b"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itemList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp24"
        android:layout_marginVertical="@dimen/dp12"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/cv_warning"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/txt_s_g"/>
    <TextView
        android:textColor="@color/ppColorSuccess"
        android:gravity="center_vertical"
        android:id="@+id/tvSuccess"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/cv_success_small"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/txt_s_g"/>
    <TextView
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_confirm"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/txt_me_w"/>
</LinearLayout>
