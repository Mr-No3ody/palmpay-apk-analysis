<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/fb_toast_dialog_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp30"
        android:layout_marginRight="@dimen/fb_dp30"
        android:layout_marginHorizontal="@dimen/fb_dp30"
        app:cardCornerRadius="@dimen/fb_dp16"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/fb_transparent_54"
            android:padding="@dimen/fb_dp16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/fb_tips_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="@dimen/fb_dp12"
                android:src="@drawable/fb_circle_check_gray"
                android:scaleType="fitXY"
                app:tint="@color/ppColorTextBase"/>
            <TextView
                android:textSize="@dimen/fb_dp18"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/fb_tips_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fb_dp7"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/fb_dp14"
                android:textColor="#fbfbfb"
                android:gravity="center"
                android:id="@+id/fb_tips_msg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
