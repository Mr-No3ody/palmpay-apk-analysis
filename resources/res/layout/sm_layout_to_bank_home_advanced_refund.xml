<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sm_bg_fast_transfer_safeguard"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivRefundIcon"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvRefundTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="@+id/ivRefundIcon"
        app:layout_constraintStart_toEndOf="@+id/ivRefundIcon"
        app:layout_constraintTop_toTopOf="@+id/ivRefundIcon"
        style="@style/Text.202046.10"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvRefundDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRefundIcon"
        style="@style/Text.medium.202046.14"/>
    <com.transsnet.palmpay.custom_view.DashedLineView
        android:id="@+id/vDashLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp8"
        app:dashColor="@color/ppColorDividerLineDark"
        app:dashLength="@dimen/dp3"
        app:dashWidth="1dp"
        app:gapLength="@dimen/dp3"
        app:layout_constraintTop_toBottomOf="@+id/tvRefundDesc"/>
    <View
        android:id="@+id/vPoint1"
        android:background="@drawable/cv_shape_rect_corner_8_bg_disable"
        android:layout_width="@dimen/dp8"
        android:layout_height="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tvSendTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSendTitle"/>
    <View
        android:id="@+id/vVerticalLine"
        android:background="@drawable/cv_shape_rect_corner_8_bg_disable"
        android:layout_width="@dimen/dp1"
        android:layout_height="@dimen/dp12"
        android:layout_marginTop="@dimen/dp3"
        app:layout_constraintEnd_toEndOf="@+id/vPoint1"
        app:layout_constraintStart_toStartOf="@+id/vPoint1"
        app:layout_constraintTop_toBottomOf="@+id/vPoint1"/>
    <View
        android:id="@+id/vPoint2"
        android:background="@drawable/cv_shape_rect_corner_8_bg_primary"
        android:layout_width="@dimen/dp8"
        android:layout_height="@dimen/dp8"
        android:layout_marginTop="@dimen/dp3"
        app:layout_constraintEnd_toEndOf="@+id/vPoint1"
        app:layout_constraintStart_toStartOf="@+id/vPoint1"
        app:layout_constraintTop_toBottomOf="@+id/vVerticalLine"/>
    <TextView
        android:id="@+id/tvSendTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintStart_toEndOf="@+id/vPoint1"
        app:layout_constraintTop_toBottomOf="@+id/vDashLine"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:id="@+id/tvSendTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/vPoint2"
        app:layout_constraintStart_toStartOf="@+id/tvSendTitle"
        app:layout_constraintTop_toTopOf="@+id/vPoint2"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:id="@+id/btnView"
        android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_view"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Text.medium.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
