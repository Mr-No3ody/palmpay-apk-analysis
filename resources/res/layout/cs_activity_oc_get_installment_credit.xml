<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/cs_ok_card_instant_credit"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/topBg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp210"
        android:layout_marginTop="@dimen/dp26"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp22"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/cs_apply_installments_title"
        style="@style/txt_b_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp36"
        android:text="@string/cs_apply_installments_msg_1"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/cs_oc_icon_1"
        android:layout_marginStart="@dimen/dp36"
        style="@style/txt_me_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp22"
        android:text="@string/cs_apply_installments_msg_2"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/cs_oc_icon_2"
        android:layout_marginStart="@dimen/dp36"
        style="@style/txt_me_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp22"
        android:text="@string/cs_apply_installments_msg_3"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/cs_oc_icon_3"
        android:layout_marginStart="@dimen/dp36"
        style="@style/txt_me_g"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp13">
        <CheckBox
            android:id="@+id/checkboxAgreement"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/cs_oc_check_ibt_bg"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/csView14"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/tvAgreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_i_agree_to_2"
            android:lineSpacingExtra="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"/>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="@dimen/dp40"
        android:text="@string/cs_apply_ok_card_installments"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        style="@style/txt_me_w"/>
</LinearLayout>
