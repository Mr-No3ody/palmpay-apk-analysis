<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@drawable/cs_multi_loan_privilege_sheet_bg"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivHeader"
        android:layout_width="0dp"
        android:layout_height="173dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp15"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContentCard"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp88"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutProductTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/viewTitleDividerStart"
                android:background="@drawable/cs_multi_loan_privilege_divider"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivProductIcon"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:src="@drawable/cs_cl_loan_claim_borrow_dialog_sd"
                android:layout_marginStart="@dimen/dp12"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvProductHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_multi_loan_dialog_product_title"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.medium.202046.18"/>
            <View
                android:id="@+id/viewTitleDividerEnd"
                android:background="@drawable/cs_multi_loan_privilege_divider"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp2"
                android:layout_marginStart="@dimen/dp12"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/tvSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutProductTitle"
            style="@style/Text.202046.14"/>
        <FrameLayout
            android:id="@+id/layoutFeatureRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSummary">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/layoutFeatureLeft"
                    android:background="@drawable/cs_multi_loan_privilege_feature_bg"
                    android:paddingTop="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/dp12">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/viewIconCircleLeft"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:src="@drawable/cs_cl_loan_claim_borrow_dialog_date"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvFeatureLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp6"
                        android:text="@string/cs_multi_loan_dialog_feature_repayment"
                        style="@style/Text.202046.14"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/layoutFeatureRight"
                    android:background="@drawable/cs_multi_loan_privilege_feature_bg"
                    android:paddingTop="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp12"
                    android:paddingVertical="@dimen/dp12">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/viewIconCircleRight"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:src="@drawable/cs_cl_loan_claim_borrow_dialog_n"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvFeatureRight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp6"
                        android:text="@string/cs_multi_loan_dialog_feature_borrow"
                        style="@style/Text.202046.14"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/layoutFeaturePlus"
                android:background="@drawable/cs_multi_loan_privilege_plus_bg"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivFeaturePlus"
                    android:layout_width="@dimen/dp26"
                    android:layout_height="@dimen/dp26"
                    android:src="@drawable/cs_cl_loan_claim_borrow_dialog_add"/>
            </FrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/btnCta"
        android:background="@drawable/core_rect_corner_12_bg_00a49a"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutContentCard"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
