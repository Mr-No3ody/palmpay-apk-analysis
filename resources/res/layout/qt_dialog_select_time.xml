<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="217dp">
    <FrameLayout
        android:id="@+id/cds_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="center"
            android:id="@+id/cds_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_select_date"
            style="@style/Text.medium.202046.18"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cds_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp16"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cds_tab_area"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        app:layout_constraintTop_toBottomOf="@+id/cds_title">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/cds_by_week_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_by_week"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <View
            android:id="@+id/cds_inditor_week"
            android:background="@drawable/cv_shape_round_corner_primary"
            android:layout_width="@dimen/dp26"
            android:layout_height="@dimen/dp2"
            android:layout_marginTop="@dimen/dp5"
            app:layout_constraintEnd_toEndOf="@+id/cds_by_week_tv"
            app:layout_constraintStart_toStartOf="@+id/cds_by_week_tv"
            app:layout_constraintTop_toBottomOf="@+id/cds_by_week_tv"/>
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/cds_by_month_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_by_month"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/dp50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <View
            android:id="@+id/cds_inditor_month"
            android:background="@drawable/cv_shape_round_corner_primary"
            android:visibility="gone"
            android:layout_width="@dimen/dp26"
            android:layout_height="@dimen/dp2"
            android:layout_marginTop="@dimen/dp5"
            app:layout_constraintEnd_toEndOf="@+id/cds_by_month_tv"
            app:layout_constraintStart_toStartOf="@+id/cds_by_month_tv"
            app:layout_constraintTop_toBottomOf="@+id/cds_by_month_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/cds_viewpager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp250"
        android:layout_marginTop="@dimen/dp10"
        app:layout_constraintTop_toBottomOf="@+id/cds_tab_area">
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wheel_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cds_date_rcv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center"
        android:id="@+id/cds_hint_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cds_viewpager"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cds_confirm_tv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp15"
        android:layout_marginBottom="@dimen/dp12"
        android:text="@string/core_confirm"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/cds_hint_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
