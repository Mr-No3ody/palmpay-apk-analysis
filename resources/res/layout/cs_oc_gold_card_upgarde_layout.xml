<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_gold_card_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/cl_gold_card_upgrade_mtb"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="@dimen/dp40"
            app:title_bar_show_right_2_iv="false"
            app:title_bar_style="light"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/upgrade_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/dp40"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/selected_img"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp26"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp26"
            android:src="@drawable/cs_oc_repayment_information"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="@dimen/dp26"/>
        <ViewStub
            android:id="@+id/no_gold_card_vs"
            android:layout="@layout/cs_oc_no_gold_card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/gold_card_selected_vs"
            android:layout="@layout/cs_oc_gold_card_selected_date_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/gold_card_unselected_vs"
            android:layout="@layout/cs_oc_gold_card_unselect_date_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
