<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/framelayout"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="@dimen/dp24"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title=" "/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/dp22"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tv_upgrade_succ_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="Congratulations on enjoying\10installment loans！"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_installment_star_icon_new"
                    android:layout_marginStart="@dimen/dp6"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_installment_succ_interest"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/daily_interest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp6"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="#9ca2aa"
                    android:id="@+id/daily_interest2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0.8%)"
                    android:fontFamily="sans-serif-black"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_main"
                    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
                    android:paddingBottom="@dimen/dp24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp5"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="#ff9900"
                        android:gravity="center"
                        android:id="@+id/terms_tips"
                        android:background="@drawable/cs_bg_install_top"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp26"
                        android:text="Get money at once, repay in 3 terms"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp40">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp26">
                            <TextView
                                android:textSize="@dimen/dp12"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loanable Amount (up to) "
                                android:fontFamily="sans-serif-medium"/>
                            <View
                                android:layout_width="@dimen/dp1"
                                android:layout_height="@dimen/dp16"/>
                            <TextView
                                android:textSize="@dimen/dp32"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/ccuial_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="@dimen/dp150"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp50">
                            <TextView
                                android:textSize="@dimen/dp12"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loan Period"
                                android:fontFamily="sans-serif-medium"/>
                            <View
                                android:layout_width="@dimen/dp1"
                                android:layout_height="@dimen/dp16"/>
                            <TextView
                                android:textSize="@dimen/dp32"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/ccuial_term"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp50">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/cs_installment_period"/>
                            <TextView
                                android:textColor="@color/ppColorTextNormal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp8"
                                android:text="Loan Period"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/cs_main_color"
                                android:gravity="center"
                                android:id="@+id/ccuial_loan_period"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp2"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/cs_installment_installments"/>
                            <TextView
                                android:textColor="@color/ppColorTextNormal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp8"
                                android:text="Installments"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/cs_main_color"
                                android:gravity="center"
                                android:id="@+id/ccuial_installments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp2"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/cs_installment_dayterm"/>
                            <TextView
                                android:textColor="@color/ppColorTextNormal"
                                android:id="@+id/ccuial_day_term_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp8"
                                android:text="Days/ term"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/cs_main_color"
                                android:gravity="center"
                                android:id="@+id/ccuial_day_term"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp2"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/ppColorTextBase"
                        android:gravity="center"
                        android:id="@+id/ccuial_borrow"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp44"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp40"
                        android:layout_marginRight="@dimen/dp16"
                        android:text="@string/cs_borrow_all"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginHorizontal="@dimen/dp16"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ccuial_learn_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Learn more about installment"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp2"
                            app:iiv_color="@color/ppColorTextPrimary"
                            app:iiv_icon="pay_ArrowCenterRight"
                            app:iiv_size="@dimen/dp20"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rl_more_loan_service"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:padding="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_below="@+id/ll_main"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <ImageView
                        android:id="@+id/iv_bottom_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cs_cl_install_upgrade_succ_dollar_icon"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="More Loan Services"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp8"
                        android:layout_toEndOf="@+id/iv_bottom_icon"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/tv_more_loan_service_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_below="@+id/iv_bottom_icon"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/cv_color_ffffff"
                        android:id="@+id/tv_more_loan_service_btn"
                        android:background="@drawable/cs_corner_16_bg_6a35ff"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/dp8"
                        android:paddingEnd="@dimen/dp8"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_installment_star_icon2"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/dp10"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dp16"
        android:src="@drawable/cs_bank_aprroved_bottom"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
