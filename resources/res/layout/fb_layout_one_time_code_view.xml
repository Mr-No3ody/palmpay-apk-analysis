<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <com.flexibank.sdk.customview.FlexiBankPinEntryView
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_smsCodeView"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/fb_large_margin"
        app:fb_accentType="character"
        app:fb_accentWidth="0dp"
        app:fb_digitBackground="@color/fb_transparent"
        app:fb_digitHeight="45dp"
        app:fb_digitRadius="4dp"
        app:fb_digitSelectStrokeColor="@color/fb_text_color_purple"
        app:fb_digitSpacing="0dp"
        app:fb_digitStrokeColor="@color/fb_text_color_gray3"
        app:fb_digitStrokeWidth="0.5dp"
        app:fb_digitTextSize="22dp"
        app:fb_digitWidth="50dp"
        app:fb_mask=""
        app:fb_numDigits="6"
        app:fb_pinInputType="number"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fb_viewError"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fb_warning"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/fb_base_color_fail"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/fb_textViewError"
            android:paddingLeft="4dp"
            android:paddingTop="0dp"
            android:paddingRight="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            style="@style/fb_txt_mi_g"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_textViewSendSms"
        android:layout_width="270dp"
        android:layout_marginTop="14dp"
        android:text="@string/fb_send_code"
        style="@style/fbButtonStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fb_textViewMessage"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="invisible"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/fb_msg_send_voice_code_default"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        style="@style/fb_txt_mi_g"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/fb_viewSendVoiceCode"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fb_voice_call"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/fb_base_colorPrimary"
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fb_try_voice_call"
            android:paddingStart="5dp"
            style="@style/fb_txt_s_g"/>
    </LinearLayout>
</merge>
