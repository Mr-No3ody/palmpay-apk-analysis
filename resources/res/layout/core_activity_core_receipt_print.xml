<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/viewRoot"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:paddingTop="43dp"
            android:paddingBottom="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="25dp"
            android:paddingEnd="25dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/palmpay_logo_text_vertical"
                android:scaleType="fitXY"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="30dp"
                app:cv_bm_title="@string/core_receipt_transaction_id"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payee"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item3"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payee_nif"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item4"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_date"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item5"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_transaction_type"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item6"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_show_amount_sign="true"
                app:cv_bm_title="@string/core_receipt_transaction_amount"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item7"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payment_method"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item8"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payer_name"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item9"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payer_nif"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item10"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_payer_account_no"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item11"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_cashback_used"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item12"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_show_amount_sign="true"
                app:cv_bm_title="@string/core_receipt_fees"/>
            <TextView
                android:gravity="center_vertical"
                android:paddingTop="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_receipt_narration"
                style="@style/txt_s_g"/>
            <TextView
                android:id="@+id/item13"
                android:paddingTop="5dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/txt_mi_b"/>
            <View
                android:background="@color/ppColorDividerLineDark"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                android:id="@+id/item14"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:cv_bm_title="@string/core_receipt_status"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/cv_palmpay_text_and_logo_purple"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
