<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/ppColorBackgroundDark"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/bundle_app_bar"
        android:background="@color/pp_transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="exitUntilCollapsed|scroll">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?android:attr/actionBarSize"
                app:layout_collapseMode="none">
                <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
                    android:id="@+id/ad_home_text"
                    android:background="@color/ppColorBackgroundLight"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp36"
                    android:paddingHorizontal="@dimen/dp16"
                    app:ad_drawable_padding="@dimen/dp8"
                    app:ad_text_color="@color/ppColorTextPrimary"
                    app:ad_text_size="@dimen/dp12"
                    app:slot_id="@string/sm_transfer_to_palmpay_home_text_slot_id"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/sa_top_horizontal_full"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:slot_id="@string/ad_transfer_to_palmpay_home_top_full_slot_id"/>
                <ViewStub
                    android:id="@+id/vs_cashbox_trial_cash"
                    android:layout="@layout/sm_layout_cashbox_trial_cash"
                    android:inflatedId="@+id/layout_cashbox_trial_cash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/sa_top_horizontal_margin"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:slot_id="@string/ad_transfer_to_palmpay_home_top_margin_slot_id"/>
                <FrameLayout
                    android:id="@+id/fl_benefits_banner"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp8">
                    <ViewFlipper
                        android:orientation="vertical"
                        android:id="@+id/view_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp18"
                        android:flipInterval="3000"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_transfer_account_card"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_transfer_safe"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp16">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_Security"
                            app:iiv_size="@dimen/dp16"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorSuccess"
                            android:id="@+id/tv_transfer_safe_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp4"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/iv_transfer_safe_arrow"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp12"
                            android:layout_height="@dimen/dp12"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_ArrowCenterRight"
                            app:iiv_size="@dimen/dp12"/>
                    </LinearLayout>
                    <com.transsnet.palmpay.send_money.ui.view.TransferToPalmPayAccountView
                        android:id="@+id/palmpay_account_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.transsnet.palmpay.send_money.ui.view.TransferHomeEntranceView
                    android:id="@+id/transfer_entrance_view"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:padding="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
            </LinearLayout>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">
                <com.palmpay.lib.ui.titlebar.PpTitleBar
                    android:id="@+id/titleBar"
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    app:title_bar_right_iconfont_1="pay_TransactionHistory"
                    app:title_bar_show_right_1_iv="true"
                    app:title_bar_title="@string/sm_transfer_to_palmpay"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_tab"
            android:background="@drawable/cv_shape_rect_top_corner_white_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp44"
                android:paddingStart="@dimen/dp8"
                app:layout_constraintEnd_toStartOf="@+id/tv_view_full"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/core_tab_indicator_25"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabPaddingEnd="@dimen/dp8"
                app:tabPaddingStart="@dimen/dp8"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/ppColorPrimary"
                app:tabTextAppearance="@style/NormalTextStyle"
                app:tabTextColor="@color/ppColorTextPrimary"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/tv_view_full"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Search"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_beneficiary"
        android:background="@drawable/cv_shape_rect_bottom_corner_white_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.transsnet.palmpay.core.ui.widget.DragView
        android:layout_gravity="end|bottom"
        android:id="@+id/dv_cashback_ad"
        android:visibility="gone"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:layout_marginBottom="@dimen/dp14"
        android:layout_marginEnd="@dimen/dp16">
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/ad_cashback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:slot_id="@string/ad_transfer_to_palmpay_home_drag_slot_id"/>
    </com.transsnet.palmpay.core.ui.widget.DragView>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/vsScheduleNextOrder"
        android:layout="@layout/sm_layout_schedule_transfer_next_order"
        android:inflatedId="@+id/clScheduleNextOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
