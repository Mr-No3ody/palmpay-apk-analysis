<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:layout_gravity="end"
        android:id="@+id/textViewSkip"
        android:paddingLeft="@dimen/extra_margin"
        android:paddingTop="21dp"
        android:paddingRight="@dimen/large_margin"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_skip"
        android:paddingStart="@dimen/extra_margin"
        android:paddingEnd="@dimen/large_margin"
        style="@style/txt_s_g"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="@string/ac_enable_touch_id"
        style="@style/txt_b_b"/>
    <FrameLayout
        android:paddingLeft="30dp"
        android:paddingTop="10dp"
        android:paddingRight="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="30dp"
        android:paddingEnd="30dp">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/textViewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_confirm_touch_id"
            style="@style/txt_mi_g"/>
        <TextView
            android:textColor="@color/ac_color_fail"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/textViewError"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_msg_error_touch_id"
            style="@style/txt_mi_g"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="117dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="55dp"
        app:cardElevation="2dp">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_TouchSensor"
            app:iiv_size="56dp"/>
    </androidx.cardview.widget.CardView>
    <View
        android:layout_width="@dimen/dp12"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/acsti_use_pattern_tv"
        android:padding="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp40"
        android:layout_marginBottom="@dimen/dp15"
        android:text="@string/ac_use_pattern"/>
</LinearLayout>
