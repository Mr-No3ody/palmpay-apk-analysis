<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.credit.ui.view.NotifyInfoView
        android:id="@+id/viewNotifyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivShop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/adView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/ad_phone_default_slot_id"/>
            <ImageView
                android:id="@+id/ivShopCopyWriting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp12">
        <com.palmpay.lib.ui.button.PpButton
            android:layout_gravity="center"
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/ppButtonStyle"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_mi_standalone_service_phone"
            app:iiv_start_color="@color/lib_ui_button_white_text_color"
            app:iiv_start_icon="pay_Phone"
            app:iiv_start_size="@dimen/dp24"
            style="@style/Text.medium.ffffff.16"/>
    </FrameLayout>
    <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
        android:id="@+id/viewLoanHomeBottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:layout_marginVertical="@dimen/dp16"/>
</LinearLayout>
