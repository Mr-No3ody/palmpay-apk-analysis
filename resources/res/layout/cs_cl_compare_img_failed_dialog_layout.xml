<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:padding="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_oc_close_icon"/>
    <ImageView
        android:id="@+id/csImageview31"
        android:layout_width="@dimen/dp70"
        android:layout_height="@dimen/dp70"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_operation_fail_icon"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csImageview31"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/content_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/try_again_bt"
        android:background="@drawable/cs_cl_compare_try_again_bt_bg"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="33dp"
        android:text="@string/core_try_again1"
        android:textAllCaps="false"
        android:layout_marginEnd="5dp"
        android:backgroundTint="@color/ppColorFlexiCashSecondary"
        app:layout_constraintEnd_toStartOf="@+id/skip_bt"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_tv"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/skip_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="33dp"
        android:text="@string/core_skip"
        android:textAllCaps="false"
        android:layout_marginStart="5dp"
        android:backgroundTint="@color/cs_main_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/try_again_bt"
        app:layout_constraintTop_toBottomOf="@+id/content_tv"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/bottom_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skip_bt"/>
</androidx.constraintlayout.widget.ConstraintLayout>
