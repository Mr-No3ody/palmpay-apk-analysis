<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_set_psw"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_set_psw"
            app:st_showDivider="false"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_change_psw"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_change_psw"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_reset_psw"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_reset_psw"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_auto_logout_setting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_lock_pin_setting"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_touchId_for_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_touch_id_for_login"
            android:summary=""
            android:defaultValue="false"
            app:st_checkStyle="true"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_device"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_manage_device"
            app:st_showDivider="false"/>
    </LinearLayout>
</LinearLayout>
