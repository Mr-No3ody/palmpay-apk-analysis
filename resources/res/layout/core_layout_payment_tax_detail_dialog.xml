<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:text="@string/core_taxes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_b_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp12"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_total_tax"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_b"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp24"
        android:layout_alignParentEnd="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvTotalName"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/txt_number_s_b_b"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feeList"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalName"
        app:layout_goneMarginTop="0dp"/>
    <TextView
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvConfirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_got_it"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feeList"
        style="@style/txt_me_w_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
