<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp32"
    android:paddingHorizontal="@dimen/dp12">
    <TextView
        android:id="@+id/tv_promotion_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier_right"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_promotion_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/iv_promotion_icon"
        style="@style/txt_s_b"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tv_promotion_calc_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/iv_promotion_calc_arrow"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_promotion_key"
        style="@style/txt_number_s_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_promotion_calc_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp3"
        android:layout_marginRight="@dimen/dp3"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Exchange"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_promotion_calc_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_promotion_calc_value"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorWarning"
        android:id="@+id/tv_promotion_calc_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_promotion_key"
        app:layout_constraintEnd_toStartOf="@+id/iv_promotion_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_promotion_calc_arrow"
        style="@style/txt_number_s_b_b"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_promotion_calc_arrow,tv_promotion_value,tv_promotion_calc_value,tv_promotion_calc_amount"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_promotion_calc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_promotion_calc_value,iv_promotion_calc_arrow"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_promotion_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
