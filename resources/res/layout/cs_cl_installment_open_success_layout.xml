<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_open_success_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cash_repay_bill_ll"
        android:background="@color/transparent"
        android:paddingTop="@dimen/dp6"
        android:paddingBottom="@dimen/dp16"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp13"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_cl_double_open_success"/>
        <TextView
            android:gravity="center"
            android:id="@+id/cl_recactivation_title_tv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/core_congratulations"
            style="@style/Text.medium.202046.18"/>
        <TextView
            android:id="@+id/tvContent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="You can enjoy installment STRESS-FREE \10loans!"
            style="@style/Text.202046.14"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tv_loanAbleAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:drawablePadding="@dimen/dp8"
            android:drawableStart="@drawable/cv_selected_circle_icon"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/tv_borrowingTerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:drawablePadding="@dimen/dp8"
            android:drawableStart="@drawable/cv_selected_circle_icon"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/cv_shape_rect_corner_16_bg_white"
            android:paddingBottom="@dimen/dp22"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8">
            <TextView
                android:id="@+id/tvSingleCashAvailableAmount"
                android:layout_marginTop="@dimen/dp36"
                android:text="@string/cs_loan_amount"
                android:layout_marginStart="@dimen/dp20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.12"/>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/available_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSingleCashAvailableAmount"/>
            <TextView
                android:id="@+id/loan_period_title_tv"
                android:text="@string/cs_cl_loan_period"
                app:layout_constraintLeft_toLeftOf="@+id/period_days_tv"
                app:layout_constraintTop_toTopOf="@+id/tvSingleCashAvailableAmount"
                style="@style/Text.medium.202046.12"/>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/cs_oc_negative_txt_color"
                android:id="@+id/period_days_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="180"
                android:fontFamily="@font/cv_palmpay_number_bold"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintRight_toLeftOf="@+id/tv_title_days"
                app:layout_constraintTop_toBottomOf="@+id/loan_period_title_tv"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvPeriodResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                app:layout_constraintStart_toStartOf="@+id/period_days_tv"
                app:layout_constraintTop_toBottomOf="@+id/period_days_tv"/>
            <TextView
                android:textColor="@color/cs_oc_negative_txt_color"
                android:id="@+id/tv_title_days"
                android:paddingLeft="@dimen/dp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp36"
                android:text="@string/tv_days"
                app:layout_constraintBaseline_toBaselineOf="@+id/period_days_tv"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:id="@+id/tvDailyInterestLowRate"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp24"
                android:text="Daily Interest only 0.7%"
                app:layout_constraintLeft_toLeftOf="@+id/available_amount_tv"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_days"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvTips"
                android:layout_marginTop="@dimen/dp36"
                android:text="Borrow ₦1000,Daily interest only ₦7"
                app:layout_constraintLeft_toLeftOf="@+id/available_amount_tv"
                app:layout_constraintTop_toBottomOf="@+id/tvDailyInterestLowRate"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/cs_cl_borrow_txt_color"
                android:gravity="center"
                android:id="@+id/cl_both_borrow_tv"
                android:background="@drawable/cs_cl_borrow_txt_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp28"
                android:layout_marginRight="@dimen/dp20"
                android:text="Borrow"
                android:layout_alignParentBottom="true"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="@color/ppColorFlexiCashPrimary"
                android:layout_marginHorizontal="@dimen/dp20"
                app:layout_constraintTop_toBottomOf="@+id/tvTips"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvLearnMoreOpenResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Learn more about installment"
                android:drawablePadding="4dp"
                app:iiv_end_color="@color/cs_cl_main_color_new"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="@+id/cl_both_borrow_tv"
                app:layout_constraintStart_toStartOf="@+id/cl_both_borrow_tv"
                app:layout_constraintTop_toBottomOf="@+id/cl_both_borrow_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
