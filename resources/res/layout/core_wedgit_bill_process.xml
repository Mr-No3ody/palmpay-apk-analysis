<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cwb_title_process_rcv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/cwb_line"
        android:background="@color/ppColorDividerLineDark"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/dp27"
        android:layout_marginEnd="@dimen/dp27"
        app:layout_constraintTop_toBottomOf="@+id/cwb_title_process_rcv"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        app:layout_constraintTop_toBottomOf="@+id/cwb_line">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cwb_process_rcv"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/cwb_more_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/cwb_more_tv"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="@string/core_more"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cwb_arrow_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Arrowdown"
                app:iiv_size="16dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
