<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvTitle"
        android:paddingTop="@dimen/dp32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iivClose"
        android:padding="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp20"
        app:layout_constraintStart_toStartOf="@+id/tvTips"
        app:layout_constraintTop_toBottomOf="@+id/tvTips"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/tvInfo"
        app:layout_constraintEnd_toEndOf="@+id/tvTips"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintEnd_toEndOf="@+id/tvTips"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btnNo"
        android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="@dimen/dp36"
        android:text="@string/core_no"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btnRemove"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:text="@string/core_remove"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/btnNo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnNo"
        app:layout_constraintTop_toTopOf="@+id/btnNo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
