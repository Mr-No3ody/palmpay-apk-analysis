<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/pp_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_back_icon="@drawable/lib_web_icon_back_202046_24dp"
        app:title_bar_left_icon="@drawable/lib_web_icon_close_202046_24dp"
        app:title_bar_right_icon_1="@drawable/lib_web_icon_more_202046_24dp"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_text_arrow_down="false"/>
</LinearLayout>
