<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp12">
    <TextView
        android:textSize="@dimen/dp25"
        android:textColor="#fd960c"
        android:id="@+id/tvNum"
        android:paddingLeft="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp2"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toRightOf="@+id/tvNum"
        app:layout_constraintRight_toLeftOf="@+id/rtvGet"
        app:layout_constraintTop_toBottomOf="@+id/tvTag"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvSecTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.202046.12"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvRemark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="@dimen/dp2"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/tvChangePercent"
        app:layout_constraintLeft_toRightOf="@+id/tvChangePercent"
        style="@style/Text.202046.12"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:id="@+id/tvChangePercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="12dp"
        android:textColor="@color/cv_color_ffffff"
        android:id="@+id/rtvGet"
        android:paddingBottom="@dimen/dp1"
        android:layout_width="57dp"
        android:layout_height="24dp"
        android:text="Invest"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        style="@style/Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
