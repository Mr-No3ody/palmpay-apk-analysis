<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/p2p_refreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/p2p_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/p2p_bottom"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@mipmap/p2p_booking_detai_bg"
                    app:layout_constraintDimensionRatio="1080:966"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.transsnet.palmpay.custom_view.StatusBarView
                    android:id="@+id/p2p_status_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.palmpay.lib.ui.titlebar.PpTitleBar
                    android:id="@+id/p2p_title"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_status_bar"
                    app:title_bar_show_right_2_iv="false"
                    app:title_bar_title="Booking Details"/>
                <com.transsnet.palmpay.p2pcash.ui.atm.view.TimeCountView
                    android:id="@+id/p2p_time_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_title"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="29dp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_time_count"
                    app:layout_goneMarginTop="8dp"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/p2p_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/p2p_status"
                    app:layout_constraintLeft_toRightOf="@+id/p2p_status"
                    app:layout_constraintTop_toTopOf="@+id/p2p_status"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#99202046"
                    android:id="@+id/p2p_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_status"/>
                <com.transsnet.palmpay.p2pcash.ui.atm.view.AppointDetailView
                    android:id="@+id/p2p_appointment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_info"/>
                <com.transsnet.palmpay.p2pcash.ui.atm.view.AgentItemView
                    android:id="@+id/p2p_agent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_appointment"/>
                <com.transsnet.palmpay.p2pcash.ui.atm.view.BookingDetailView
                    android:id="@+id/p2p_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_agent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/p2p_bottom"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PButton
            android:id="@+id/p2p_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/p2p_pay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginRight="16dp"
            app:p2p_btn_name="@string/core_cancel"
            app:p2p_btn_style="light"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PButton
            android:id="@+id/p2p_pay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/p2p_cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginLeft="16dp"
            app:p2p_btn_name="@string/core_pay"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
