<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_pay_amount"
    android:background="@drawable/cv_rect_corner_tl_tr_24_bg_f6f6fa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constrainedHeight="true"
    app:layout_constraintBottom_toTopOf="@+id/ll_cashier_confirm_to_pay"
    app:layout_constraintTop_toBottomOf="@+id/view_top_transparent_bg"
    app:layout_constraintVertical_bias="1"
    app:layout_constraintVertical_chainStyle="packed">
    <FrameLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_payment"
            style="@style/Text.medium.202046.18"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp16"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp28"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_pay_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/tv_save_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        style="@style/txt_number_s_b_b"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_payment_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp12"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_payment_info_body"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingBottom="@dimen/dp6"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <ViewStub
                    android:id="@+id/previewOrderAmountItemStub"
                    android:layout="@layout/core_layout_cashier_preview_order_amount_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/previewFeeAmountItemStub"
                    android:layout="@layout/core_layout_cashier_preview_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/previewTaxesAmountItemStub"
                    android:layout="@layout/core_layout_cashier_preview_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_payment_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/previewEarlyRefundItemStub"
                    android:layout="@layout/core_layout_cashier_preview_early_refund_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutMiddle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/vs_extra_layout"
                    android:inflatedId="@+id/vs_extra_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <ViewStub
                    android:id="@+id/previewPromotionItemStub"
                    android:layout="@layout/core_layout_cashier_preview_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
            </LinearLayout>
            <include
                android:id="@+id/layoutPaymentMethodHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                layout="@layout/core_layout_preview_page_payment_method_header"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ry_payment_method"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Space
                    android:id="@+id/space_ry_payment_method_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp12"
                    app:layout_constraintBottom_toBottomOf="@+id/ry_payment_method"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.transsnet.palmpay.custom_view.model.ModelPaymentEarnLayout
                android:id="@+id/model_payment_earn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.core.ui.widget.ModelPaymentManualGetLayout
                android:id="@+id/model_payment_manual_get_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
