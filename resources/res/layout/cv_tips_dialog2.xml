<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ctd_close_iv"
            android:padding="@dimen/dp10"
            android:layout_width="@dimen/dp44"
            android:layout_height="@dimen/dp44"
            android:src="@drawable/cv_close_grey"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tips_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/tips_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/oppose_tv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                    android:layout_width="@dimen/dp130"
                    android:layout_height="@dimen/dp45"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>
                <View
                    android:layout_width="@dimen/dp12"
                    android:layout_height="@dimen/dp1"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/cv_text_color_white"
                    android:gravity="center"
                    android:id="@+id/confirm_tv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                    android:layout_width="@dimen/dp130"
                    android:layout_height="@dimen/dp45"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/cv_got_it"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
