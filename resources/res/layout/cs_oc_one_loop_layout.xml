<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_mtn_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cs_oc_router_top_bar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cs_mobile_number_verification_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:text="OTP Verification"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/router_progress_view"/>
    <com.transsnet.palmpay.credit.view.OpenAccountRouterProgressViewV2
        android:id="@+id/router_progress_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oc_mtn_top_bar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/cs_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:text="@string/cs_oc_one_loop_top_content2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_mobile_number_verification_label"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/phone_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:text="Phone number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_tips"/>
    <com.transsnet.palmpay.custom_view.input.ModelMobileWithIconInputLayout
        android:id="@+id/one_loop_phone_num_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cv_contacts_icon_visible="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_num"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cs_verification_code_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:text="@string/core_otp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/one_loop_phone_num_input"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cs_verification_code_input"
        android:background="@null"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="9dp"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="9dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/cs_str_hint_enter_verification_code"
        android:inputType="number"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_verification_code_label"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/cs_resend_code"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/cs_str_resend_code"
        app:layout_constraintBottom_toBottomOf="@+id/cs_verification_code_input"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cs_verification_code_input"/>
    <View
        android:id="@+id/cs_underline"
        android:background="@color/cs_oc_one_loop_divider_color"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_verification_code_input"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ec2424"
        android:id="@+id/cs_error_info"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_underline"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/protocol_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cs_error_info"/>
    <FrameLayout
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/protocol_tv">
        <com.palmpay.lib.ui.button.PpButton
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/cs_login"
            android:background="@drawable/cs_cl_borrow_txt_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:text="@string/cs_link"
            android:textAllCaps="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/csView21"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="#9ca2aa"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp60"
            android:text="PalmPay prioritize the security of your data"
            android:drawablePadding="@dimen/dp4"
            android:drawableStart="@drawable/cs_cl_save"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
