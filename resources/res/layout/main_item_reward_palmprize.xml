<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp88"
    android:layout_height="128dp">
    <ImageView
        android:id="@+id/ivPalmPrize"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp88"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvPalmPrize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivPalmPrize"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvPalmPrizeAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivPalmPrizeTag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/txt_number_s_b_b"/>
    <ImageView
        android:id="@+id/ivPalmPrizeTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/main_icon_premium"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvPalmPrizeAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvPalmPrizeAmount"
        app:layout_constraintTop_toTopOf="@+id/tvPalmPrizeAmount"
        app:layout_constraintWidth_max="@dimen/dp48"
        app:layout_constraintWidth_min="@dimen/dp6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
