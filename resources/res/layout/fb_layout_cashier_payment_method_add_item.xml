<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fb_model_payment_add_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flexibank.sdk.cashier.viewmodel.FlexiBankCashierPayMethodItem
        android:id="@+id/fb_model_payment_add_bank_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.flexibank.sdk.cashier.viewmodel.FlexiBankCashierPayMethodItem
        android:id="@+id/fb_model_payment_add_bank_account"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.flexibank.sdk.cashier.viewmodel.FlexiBankCashierPayMethodItem
        android:id="@+id/fb_model_payment_add_bank_card_and_bank_account"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
