<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_12"
    android:paddingTop="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTitle"
        android:text="@string/cs_cl_how_long_to_keep"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="@dimen/dp12"
        android:src="@drawable/cv_close_grey"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutRepayment"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp34"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <TextView
            android:textStyle="bold"
            android:id="@+id/tvRepaymentType"
            style="@style/Text.202046.14"/>
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/tvRepaymentPeriod"
            android:visibility="gone"
            style="@style/Text.6f7b85.14"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeriods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintHeight_max="320dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutRepayment"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/rvPeriods"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56"
        android:divider="@drawable/cv_shape_divider_h_1_bg_divider_line_dark"
        android:showDividers="middle"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider">
        <TextView
            android:id="@+id/tvCancel"
            android:layout_height="match_parent"
            android:text="@string/core_cancel"
            android:layout_weight="1"
            style="@style/Text.medium.9ca2aa.16"/>
        <TextView
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:id="@+id/tvConfirm"
            android:layout_height="match_parent"
            android:text="@string/core_confirm"
            android:layout_weight="1"
            style="@style/Text.medium.9ca2aa.16"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
