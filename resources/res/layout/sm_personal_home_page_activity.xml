<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/ivHead"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp60"
        android:layout_marginTop="@dimen/dp42"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/ivHead"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8">
        <View
            android:id="@+id/v_divider_verify"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/core_divider_horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/sm_ic_request_step_1"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/dp24"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp46"
                android:layout_marginStart="4dp"
                style="@style/Text.202046.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:layout_marginStart="@dimen/dp4"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Copy"
                app:iiv_size="@dimen/dp16"/>
        </LinearLayout>
        <View
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/core_divider_horizontal"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp46"
            android:drawablePadding="@dimen/dp4"
            android:drawableStart="@drawable/sm_personal_page_account"
            android:layout_marginStart="@dimen/dp24"
            style="@style/Text.202046.14"/>
        <View
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/core_divider_horizontal"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llMoneyAction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp22"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:id="@+id/tvSend"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_send_money"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvRequest"
            android:background="@drawable/cv_shape_rect_corner_12_stroke_purple"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginTop="12dp"
            android:text="@string/core_request_money"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
