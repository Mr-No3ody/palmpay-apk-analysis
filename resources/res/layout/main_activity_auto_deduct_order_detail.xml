<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/detailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.core.ui.widget.BillDetailProcessDataWedgit
                android:id="@+id/atu_bill_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemAmount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp45"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemFee"
                android:paddingTop="@dimen/dp7"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp33"
                android:layout_marginLeft="@dimen/dp40"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp15"
                app:cv_tt_show_bottom_line="false"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemVAT"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp40"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp15"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemPointUsed"
                android:paddingTop="@dimen/dp7"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp33"
                android:layout_marginLeft="@dimen/dp40"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp15"
                app:cv_tt_show_bottom_line="false"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemPointEarned"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp40"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp15"/>
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
                android:id="@+id/itemTotal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp40"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp15"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/itemBillType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp65"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"
                app:ctai_show_img="false"
                app:ctai_title="@string/core_payment_type"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/itemPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp65"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginStart="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"
                app:ctai_show_img="true"
                app:ctai_title="@string/core_pay_method"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewOriginOrder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                style="@style/txt_mi_lg"/>
            <com.transsnet.palmpay.custom_view.model.ModelCopyableText
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewRefNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/dp15"
                app:mctMessageTextSize="@dimen/micro_text"
                app:mctTitle="@string/core_reference_no_2"
                app:mctTitleTextSize="@dimen/micro_text"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewTransactionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp25"
                android:layout_marginStart="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
