<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/qt_airtime_edit_tag"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvPhone"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="15dp"
                android:textColor="@color/ppColorTextPrimary"
                android:textColorHint="#c0c3c8"
                android:gravity="center_vertical"
                android:id="@+id/editNameEt"
                android:background="@drawable/cv_input_view_selector_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/qt_enter_the_tag_for_number"
                android:singleLine="true"
                android:maxLength="20"
                android:imeOptions="actionDone"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center_vertical"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/maxLengthTv"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tag1"
                android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                android:layout_width="46dp"
                android:layout_height="24dp"
                android:text="@string/qt_me"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tag2"
                android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                android:layout_width="46dp"
                android:layout_height="24dp"
                android:text="@string/qt_dad"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tag3"
                android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                android:layout_width="46dp"
                android:layout_height="24dp"
                android:text="@string/qt_mom"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tag4"
                android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                android:visibility="invisible"
                android:layout_width="76dp"
                android:layout_height="24dp"
                android:text="@string/qt_girlfriend"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tag5"
                android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                android:visibility="invisible"
                android:layout_width="76dp"
                android:layout_height="24dp"
                android:text="@string/qt_girlfriend"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ivClose"
        android:paddingTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_close_grey"
        android:scaleType="fitXY"
        android:paddingEnd="20dp"/>
</FrameLayout>
