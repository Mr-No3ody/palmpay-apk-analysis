<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/share_bt"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginRight="5dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Share"
            app:iiv_size="24dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/result_img"
                android:layout_width="@dimen/cv_result_success_img_size"
                android:layout_height="@dimen/cv_result_success_img_size"
                android:layout_marginTop="56dp"
                android:src="@drawable/cv_result_success"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/cv_result_success"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#ff263138"
                android:id="@+id/result_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/core_failed_upper"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff95a1ab"
                android:gravity="center_horizontal"
                android:id="@+id/result_desc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/result_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:paddingStart="25dp"
                android:paddingEnd="25dp">
                <LinearLayout
                    android:id="@+id/amount_content"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff6f7b85"
                        android:id="@+id/amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_amount"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff263138"
                        android:gravity="end"
                        android:id="@+id/amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:id="@+id/payment_method_content"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff6f7b85"
                        android:id="@+id/payment_method_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_pay_method"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff263138"
                        android:gravity="end"
                        android:id="@+id/payment_method"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:id="@+id/reference_num_content"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff6f7b85"
                        android:id="@+id/reference_num_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_reference_no"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ff263138"
                        android:gravity="end"
                        android:id="@+id/reference_num"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/actur_ad"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:layout_marginBottom="30dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/complete_bt"
                android:layout_width="270dp"
                android:text="@string/core_complete"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/ussd_guide_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="@string/core_how_to_use_ussd"
            android:includeFontPadding="false"
            android:drawablePadding="5dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_InformationOutline"
            app:iiv_start_size="@dimen/dp14"/>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
