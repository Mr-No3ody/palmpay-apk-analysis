<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_ivClose"
        android:paddingLeft="@dimen/fb_dp16"
        android:paddingRight="@dimen/fb_dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fb_dp16"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/fb_text_color_black1"
        android:gravity="center"
        android:paddingTop="38dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fb_title_attention"
        style="@style/fb_txt_l_b"/>
    <TextView
        android:textColor="@color/fb_text_color_gray2"
        android:gravity="center"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fb_msg_verify_otp_for_bank_account"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"/>
    <com.flexibank.sdk.customview.model.FlexiBankModelSendSms
        android:id="@+id/fb_send_opt_mss"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:fb_te_title="@string/fb_otp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_input_bank_account_tev"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/fb_base_red_color"
        android:id="@+id/fb_invalidate_otp_tip_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fb_invalidate_otp_tips"
        android:drawableEnd="@drawable/fb_warning"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_textViewContinue"
        android:layout_width="270dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="45dp"
        android:text="@string/fb_core_continue"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        style="@style/fbButtonStyle"/>
</LinearLayout>
