<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/oc_feedback_mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/cs_feedback_history"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/cs_oc_feedback"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp8"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/line1"
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp8"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview61"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_enter_phone_number"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/line1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/holo_red_light"
                android:id="@+id/csTextview56"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_required_symbol"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview61"
                app:layout_constraintStart_toEndOf="@+id/csTextview61"
                app:layout_constraintTop_toTopOf="@+id/csTextview61"/>
            <EditText
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextPrimary"
                android:textColorHint="#c0c3c8"
                android:id="@+id/feedback_phone_et"
                android:background="@drawable/cs_oc_add_feedback_et_bg"
                android:padding="@dimen/dp16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/cs_oc_feedback_phone_hint"
                android:maxLength="15"
                android:inputType="number"
                app:layout_constraintEnd_toEndOf="@+id/feedback_et"
                app:layout_constraintStart_toStartOf="@+id/feedback_et"
                app:layout_constraintTop_toBottomOf="@+id/csTextview61"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview53"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_send_feedback"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/feedback_phone_et"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/holo_red_light"
                android:id="@+id/csTextview57"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_required_symbol"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview53"
                app:layout_constraintStart_toEndOf="@+id/csTextview53"
                app:layout_constraintTop_toTopOf="@+id/csTextview53"/>
            <EditText
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextPrimary"
                android:textColorHint="#c0c3c8"
                android:gravity="top"
                android:id="@+id/feedback_et"
                android:background="@drawable/cs_oc_add_feedback_et_bg"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/dp160"
                android:hint="@string/cs_oc_feedback_hint"
                android:maxLength="500"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview53"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/max_input_tip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_max_letters"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview53"
                app:layout_constraintEnd_toEndOf="@+id/feedback_et"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextviewScreenShot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_add_screenshot_optional"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/feedback_et"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/max_screen_tip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_max_screen"
                app:layout_constraintBottom_toBottomOf="@+id/csTextviewScreenShot"
                app:layout_constraintEnd_toEndOf="@+id/feedback_et"/>
            <FrameLayout
                android:background="@drawable/cs_oc_feedback_img_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextviewScreenShot">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/selected_img_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:enabled="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:layout_gravity="bottom"
        android:id="@+id/feedback_submit_bt"
        android:background="@drawable/cs_cl_bw_next_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/cs_feedback_submit"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
</LinearLayout>
