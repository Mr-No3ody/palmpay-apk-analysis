<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/cl_only_once"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@+id/barrier_date">
    <TextView
        android:id="@+id/tv_transfer_time_once"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp46"
        android:text="@string/sm_transfer_time"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.14"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="end|center_vertical"
        android:id="@+id/tv_only_once_end_time"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp46"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_end_color="@color/cv_color_858a8f"
        app:iiv_end_icon="pay_Arrowdown"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_transfer_time_once"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_transfer_time_once"
        app:layout_constraintTop_toTopOf="@+id/tv_transfer_time_once"
        style="@style/Text.medium.202046.14"/>
    <View
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_transfer_time_once"
        style="@style/core_divider_horizontal"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_once_tips"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_only_once_end_time"
        style="@style/Text.6f7b85.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
