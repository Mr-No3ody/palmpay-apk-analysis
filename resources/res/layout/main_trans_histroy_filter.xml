<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/viewContainer"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp51">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50">
        <FrameLayout
            android:id="@+id/flFilterIO"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/cv_color_858a8f"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvFilterIO"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/core_all"
                android:singleLine="true"
                android:drawablePadding="4dp"
                style="@style/txt_s_b"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/flFilter"
            android:paddingLeft="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/dp10">
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvFilterActive"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/core_all_categories"
                android:singleLine="true"
                android:drawablePadding="@dimen/dp_4"
                style="@style/txt_s_b"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/flFilterAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvFilterAll"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/core_all_status"
                android:singleLine="true"
                android:drawablePadding="4dp"
                style="@style/txt_s_b"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
