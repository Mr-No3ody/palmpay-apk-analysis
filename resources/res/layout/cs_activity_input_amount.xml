<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/core_payment"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/keyboard_view"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/viewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivRecentlyBank"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="@dimen/dp60"
                    android:layout_marginTop="@dimen/dp36"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tvReceiptName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivRecentlyBank"
                    style="@style/txt_me_b_b"/>
                <TextView
                    android:id="@+id/tvRecentlyBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp70"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvReceiptName"
                    app:layout_goneMarginBottom="@dimen/dp45"
                    style="@style/txt_s_lgn"/>
                <ImageView
                    android:id="@+id/iv_discount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp28"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cs_top_left_right_corner_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-16dp">
                <com.transsnet.palmpay.custom_view.StateAmountEditText
                    android:textSize="30dp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/transfer_money_et"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:minWidth="20dp"
                    android:maxLength="12"
                    android:inputType="numberDecimal"/>
                <View
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp14"
                    android:layout_marginRight="@dimen/dp24"
                    android:layout_marginHorizontal="@dimen/dp24"
                    style="@style/core_divider_horizontal"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tvTips"
                    android:background="@drawable/cv_shape_halfround_background_dark"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp8"
                    app:layout_constraintTop_toBottomOf="@+id/et_transfer_money"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/text_color_gray14_646970"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cl_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp18"
                    android:layout_marginRight="@dimen/dp24"
                    android:minWidth="133dp"
                    android:minHeight="@dimen/dp40"
                    android:layout_marginHorizontal="@dimen/dp24">
                    <EditText
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center_vertical"
                        android:id="@+id/et_note"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp7"
                        android:paddingRight="@dimen/dp10"
                        android:paddingBottom="@dimen/dp7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="133dp"
                        android:minHeight="@dimen/dp40"
                        android:maxLength="200"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingHorizontal="@dimen/dp10"
                        android:paddingVertical="@dimen/dp7"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_b"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_note_hint"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:layout_width="133dp"
                        android:layout_height="0dp"
                        android:text="Add a note"
                        android:paddingStart="@dimen/dp20"
                        app:iiv_start_color="@color/ppColorTextDisable"
                        app:iiv_start_icon="pay_Edit"
                        app:iiv_start_size="@dimen/dp24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_lg"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
        android:id="@+id/keyboard_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
