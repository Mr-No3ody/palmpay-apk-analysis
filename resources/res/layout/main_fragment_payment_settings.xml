<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_change_pin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_change_pin"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_reset_pin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_reset_pin"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_touchId_for_palmpay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_touch_id_for_pay"
            android:summary=""
            android:defaultValue="false"
            app:st_checkStyle="true"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_one_step_pay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_pay_without_pin"
            app:st_checkStyle="true"/>
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_threshold"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_payment_limits"
            android:defaultValue="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_payMethod"
            android:layout="@layout/main_pref_layout_double_text_left_right_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_preferred_payment_method"
            app:st_showDivider="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16">
        <com.transsnet.palmpay.ui.view.SettingItem
            android:id="@+id/key_automatic_payments"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_setting_item_height"
            android:title="@string/main_automatic_payments"
            app:st_showDivider="false"/>
    </LinearLayout>
</LinearLayout>
