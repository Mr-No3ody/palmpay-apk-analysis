<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title_bar_show_right_1_iv="true"
                app:title_bar_title="@string/core_airtime"/>
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/aaturv_result_progress_view"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/result_info_card"
                layout="@layout/qt_low_balance_result_card"/>
            <ViewStub
                android:id="@+id/vs_payment_rewards"
                android:layout="@layout/core_layout_order_result_rewords_view_stub"
                android:inflatedId="@+id/vReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/actur_ad"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="30dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.transsnet.palmpay.core.viewmodel.FailResultPageAdView
                android:id="@+id/fail_okcard_ad"
                android:paddingTop="30dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/aaturv2_two_btn_area"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/actur_topup_again_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
