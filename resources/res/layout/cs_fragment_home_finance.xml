<?xml version="1.0" encoding="utf-8"?>
<com.transsnet.palmpay.custom_view.ReboundScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_rsv_sub"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/viewContainer"
        android:paddingTop="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.credit.ui.view.NotifyInfoView
            android:id="@+id/viewNotifyInfo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/adViewTop"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <com.transsnet.palmpay.credit.view.TotalOutstandingView
            android:id="@+id/viewTotalOutstanding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp12"/>
        <com.transsnet.palmpay.credit.view.ProductContentListView
            android:id="@+id/viewProductContentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <ViewStub
            android:id="@+id/otherLoansStub"
            android:layout="@layout/cs_layout_home_other_loans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.adsdk.widgets.banner.BannerAdView
            android:id="@+id/adviewBottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="@dimen/dp16"
            app:bvp_page_margin="5dp"/>
        <com.transsnet.palmpay.credit.view.KingKongContentInfoView
            android:id="@+id/viewKingKongContentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
            android:id="@+id/viewLoanHomeBottomInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:layout_marginVertical="@dimen/dp16"/>
    </LinearLayout>
</com.transsnet.palmpay.custom_view.ReboundScrollView>
