<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/ac_layout_verify_fragment_header"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:enabled="false"
        android:id="@+id/pinView"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/dp16"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/ppColorBackgroundDark"
        app:digitHeight="@dimen/dp48"
        app:digitRadius="@dimen/dp8"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/dp12"
        app:digitStrokeColor="@color/ppColorBackgroundDark"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="@dimen/dp24"
        app:digitWidth="@dimen/dp48"
        app:mask="●"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorError"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp50"
        android:layout_marginTop="@dimen/dp15"
        android:layout_marginRight="@dimen/dp50"
        android:layout_marginHorizontal="@dimen/dp50"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/viewBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp24">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvForgotPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_s_b"/>
        <View
            android:id="@+id/viewLine1"
            android:background="@color/ppColorDividerLine"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp12"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvVerify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/viewLine1"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/bottomViewStub"
        android:background="@color/ppColorDividerLine"
        android:layout="@layout/core_number_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
