<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mbci_root"
        android:paddingLeft="@dimen/dp15"
        android:paddingRight="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60">
        <ImageView
            android:id="@+id/mbci_access_bank_iv"
            android:layout_width="@dimen/dp25"
            android:layout_height="@dimen/dp25"
            android:src="@drawable/cv_default_bank_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/mbci_access_bank_iv"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="44dp"
                app:layout_goneMarginBottom="@dimen/dp16">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/mbci_bankname_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/mbci_bank_card_number_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    style="@style/txt_s_b_b"/>
            </LinearLayout>
            <TextView
                android:id="@+id/mbci_hint1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/mbci_access_bank_iv"
                style="@style/txt_mi_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="#63c778"
                android:id="@+id/mbci_hint2"
                android:background="@drawable/cv_rect_corner_4_bg_d9fae1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="4dp"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp5"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/mbci_right_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cii_apply_tv"
            android:background="@drawable/core_active_pay_method_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20sp"
            android:text="@string/core_activate_pay_method"
            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mbci_right_iv"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/mbci_bottom_line"
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
</LinearLayout>
