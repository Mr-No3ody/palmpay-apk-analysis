<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/bw_status_img"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginTop="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/status_title_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bw_status_img"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#6f7b85"
                android:gravity="center"
                android:id="@+id/status_content_tv"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cs_cl_borrow_result_pending_txt"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/status_title_tv"/>
            <View
                android:id="@+id/csView18"
                android:background="@drawable/cs_cl_borrow_result_content_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview140"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toTopOf="@+id/csTextview88"
                app:layout_constraintVertical_bias="0"/>
            <TextView
                android:id="@+id/csTextview88"
                android:paddingTop="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_borrowed_funds"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/status_content_tv"
                style="@style/csClBorrowStatusTitleStyle"/>
            <TextView
                android:id="@+id/bw_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toBottomOf="@+id/csTextview88"
                style="@style/csClBorrowStatusContentStyle"/>
            <View
                android:id="@+id/csTextview97"
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toBottomOf="@+id/bw_amount_tv"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/repayment_plan_title_tv"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_cl_upcoming_payment"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toBottomOf="@+id/csTextview97"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/repayment_plan_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toBottomOf="@+id/repayment_plan_title_tv"/>
            <View
                android:id="@+id/csView24"
                android:background="@color/ppColorDividerLine"
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintStart_toStartOf="@+id/csTextview88"
                app:layout_constraintTop_toBottomOf="@+id/repayment_plan_rv"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/plan_detail_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="repayment_plan_title_tv,repayment_plan_rv,csView24"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#6f7b85"
                android:id="@+id/tvReceiveAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_receive_amount"
                app:layout_constraintStart_toStartOf="@+id/csTextview97"
                app:layout_constraintTop_toBottomOf="@+id/csView24"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#202046"
                android:id="@+id/receive_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp6"
                android:drawablePadding="@dimen/dp6"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="@+id/csTextview98"
                app:layout_constraintTop_toBottomOf="@+id/tvReceiveAmount"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupReceiveAmount"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvReceiveAmount,receive_amount_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/csTextview98"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_accounts_receivable"
                app:layout_constraintStart_toStartOf="@+id/csTextview97"
                app:layout_constraintTop_toBottomOf="@+id/receive_amount_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/receive_account_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp6"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview98"
                app:layout_constraintEnd_toEndOf="@+id/csTextview97"
                app:layout_constraintTop_toTopOf="@+id/csTextview98"/>
            <TextView
                android:id="@+id/csTextview101"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_bw_repayment_date"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview88"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/csClBorrowStatusTitleStyle"/>
            <TextView
                android:id="@+id/bw_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/csTextview101"
                app:layout_constraintTop_toBottomOf="@+id/csTextview101"
                style="@style/csClBorrowStatusContentStyle"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/csTextview140"
                android:paddingBottom="@dimen/dp14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_loan_details"
                app:layout_constraintStart_toStartOf="@+id/csTextview98"
                app:layout_constraintTop_toBottomOf="@+id/csTextview98"
                style="@style/csClBorrowStatusTitleStyle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/repayment_detail_tv"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_repay_view"
                android:drawableEnd="@drawable/cs_cl_view_right_arrow_icon"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview140"
                app:layout_constraintEnd_toEndOf="@+id/receive_account_tv"
                app:layout_constraintTop_toTopOf="@+id/csTextview140"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/borrow_detail_gp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="bw_amount_tv,receive_account_tv, bw_date_tv,csTextview88,         csTextview98,csTextview101, csTextview97, csView18,csTextview140, repayment_detail_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/view_fund_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_view_funds"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/cl_borrow_result_bottom_sav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="16dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="16dp"
        app:slot_id="@string/cl_borrow_result_single_ad_slot_id"/>
</LinearLayout>
