<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="true"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_add_guardian_information"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_bb_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Your NIN info indicates that you are under the age of18.In line with CBN regulations, users under 18 need a guardian&apos;s consent to use PalmPay."
        android:lineSpacingExtra="2dp"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_mi_g"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutContainer"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMsg">
        <com.palmpay.lib.ui.form.PpFormVertical
            android:enabled="false"
            android:id="@+id/inputRelationship"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:form_edit_enable="false"
            app:form_edit_input_type="text"
            app:form_hide_text="@string/ac_please_select"
            app:form_label_text="Relationship with Guardian"/>
        <com.palmpay.lib.ui.form.PpFormVertical
            android:id="@+id/inputMobile"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:form_country_code_text="+234"
            app:form_edit_input_type="number"
            app:form_edit_max_length="11"
            app:form_hide_text="@string/ac_msg_phone_hint"
            app:form_label_text="Guardian’s Phone Number"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="16dp"
        android:text="@string/ac_confirm"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <ViewStub
        android:id="@+id/bottomViewStub"
        android:layout="@layout/cv_layout_login_register_bottom_view"
        android:inflatedId="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
