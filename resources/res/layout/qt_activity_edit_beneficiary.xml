<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/textViewSave"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <com.transsnet.palmpay.custom_view.ModelItemSelection
                    android:id="@+id/inputBiller"
                    android:paddingTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cv_item_selection_hint="@string/qt_select_biller"
                    app:cv_item_selection_start_icon_size="20dp"
                    app:cv_item_selection_title="@string/qt_biller"
                    app:cv_item_selection_title_text_size="12dp"
                    app:cv_item_selection_value_text_size="14dp"/>
                <com.transsnet.palmpay.custom_view.ModelItemSelection
                    android:id="@+id/inputPaymentItem"
                    android:paddingTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cv_item_selection_hint="@string/qt_select_payment_item"
                    app:cv_item_selection_title="@string/qt_payment_item"
                    app:cv_item_selection_title_text_size="12dp"
                    app:cv_item_selection_value_text_size="14dp"/>
                <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                    android:id="@+id/viewCustomerId"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cv_arrow_icon_visible="false"
                    app:cv_contacts_icon_visible="gone_forever"
                    app:cv_hint="@string/qt_enter_account_number"
                    app:cv_input_text_size="14dp"
                    app:cv_show_error_text="true"
                    app:cv_title="@string/core_customer_id"
                    app:cv_title_visible="true"/>
            </LinearLayout>
            <include
                android:id="@+id/qaeb_time_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                layout="@layout/qt_layout_beneficiary_reminder"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/textViewSave"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:text="@string/core_save"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
