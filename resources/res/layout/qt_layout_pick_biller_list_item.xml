<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_list_item_bg"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qlp_header_item"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/qlp_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:text=""
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp60"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/company_img"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/text_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp11"
            android:layout_marginBottom="@dimen/dp11"
            android:layout_toRightOf="@+id/company_img"
            android:layout_marginEnd="@dimen/dp20"
            android:layout_alignParentEnd="true">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/textViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                app:layout_constraintEnd_toStartOf="@+id/qlp_ll1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_me_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextAssist"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/qlp_desc_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:layout_constraintTop_toBottomOf="@+id/textViewText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/qlp_ll1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/textViewText"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/qlp_coupon_iv"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp2"
                    android:src="@drawable/cv_coupon_star"
                    android:layout_marginStart="@dimen/dp10"
                    app:layout_constraintStart_toEndOf="@+id/textViewText"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextBase"
                    android:gravity="center"
                    android:id="@+id/qlp_cashback_iv"
                    android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:layout_marginTop="@dimen/dp2"
                    android:maxWidth="100dp"
                    android:paddingStart="@dimen/dp7"
                    android:paddingEnd="@dimen/dp7"
                    android:layout_marginStart="@dimen/dp10"
                    app:layout_constraintStart_toEndOf="@+id/qlp_coupon_iv"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/textViewText"/>
</LinearLayout>
