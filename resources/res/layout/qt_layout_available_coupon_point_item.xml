<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp36">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llCoupon"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp36"
        android:paddingStart="@dimen/dp10"
        app:layout_constraintEnd_toStartOf="@+id/llPoint"
        app:layout_constraintHorizontal_weight="12"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivCoupon"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/ryCoupon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/viewLoadingIndicator"
            app:layout_constraintStart_toEndOf="@+id/ivCoupon"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center"
            android:id="@+id/viewLoadingIndicator"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:indicatorColor="@color/ppColorPrimary"
            app:indicatorName="BallSpinFadeLoaderIndicator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/clEnd"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AVLoadingIndicatorView.Large"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iivArrowRight"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivCouponDot"
                android:layout_width="@dimen/dp6"
                android:layout_height="@dimen/dp6"
                android:src="@drawable/cv_red_point"
                android:layout_marginEnd="@dimen/dp2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvNumber"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvNumber"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.9ca2aa.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iivArrowRight"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp2"
            app:iiv_color="@color/ppColorTextDisable"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llPoint"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp36"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="5"
        app:layout_constraintStart_toEndOf="@+id/llCoupon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            android:src="@drawable/cv_palmpay_icon_yellow"
            android:layout_marginStart="@dimen/dp10"/>
        <TextView
            android:textColor="@color/ppColorWarning"
            android:gravity="start|center_vertical"
            android:id="@+id/tvPoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp2"
            style="@style/Text.202046.12"/>
        <ImageView
            android:id="@+id/ivPointDot"
            android:layout_width="@dimen/dp6"
            android:layout_height="@dimen/dp6"
            android:src="@drawable/cv_red_point"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp2"
            app:iiv_color="@color/ppColorTextDisable"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"/>
    </LinearLayout>
</merge>
