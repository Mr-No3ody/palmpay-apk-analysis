<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:id="@+id/p2p_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/p2p_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/p2p_distance"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/p2p_distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/p2p_name"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/p2p_labels"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_name">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    app:cardBackgroundColor="#f0ecfc"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/p2p_theme_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/p2p_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="28dp"
                android:lineSpacingMultiplier="1.2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/p2p_phone"
                app:layout_constraintTop_toBottomOf="@+id/p2p_labels"
                app:layout_goneMarginRight="16dp"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/p2p_phone"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Phone"
                app:iiv_size="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_address"
                app:layout_constraintRight_toLeftOf="@+id/p2p_navigation"
                app:layout_constraintTop_toTopOf="@+id/p2p_address"/>
            <ImageView
                android:id="@+id/p2p_navigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:src="@mipmap/p2p_navigation"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_address"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/p2p_address"/>
            <View
                android:id="@+id/p2p_divider"
                android:background="@color/ppColorDividerLine"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/p2p_phone"
                app:layout_constraintLeft_toRightOf="@+id/p2p_phone"
                app:layout_constraintRight_toLeftOf="@+id/p2p_navigation"
                app:layout_constraintTop_toTopOf="@+id/p2p_phone"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
