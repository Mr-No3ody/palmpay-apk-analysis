<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:gravity="center"
            android:id="@+id/textViewMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_msg_reset_pin_verification_bankinfo"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            style="@style/txt_s_g"/>
        <com.transsnet.adsdk.widgets.banner.bannerview.BannerViewPager
            android:id="@+id/bannerView"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="26dp"
            app:bvp_page_style="multi_page_scale"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputBank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:cv_max_length="23"
            app:cv_te_inputType="bankcode"
            app:cv_te_title="@string/ac_bank_card_number"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/textViewNext"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="270dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginTop="35dp"
            android:text="@string/core_next"
            style="@style/txt_b_w"/>
    </LinearLayout>
    <TextView
        android:textColor="#9200ff"
        android:gravity="center_vertical"
        android:id="@+id/tvContactUs"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/ac_contact_us"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/txt_s_g"/>
</RelativeLayout>
