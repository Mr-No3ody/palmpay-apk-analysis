<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/ac_preview_pdf_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/pdfScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pdfPageContainer"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tipBanner"
            android:background="@drawable/cv_shape_rect_corner_tl_tr_8_bg_secondary"
            android:paddingTop="@dimen/dp6"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:minHeight="@dimen/dp32"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivTipWarning"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_WarningFill"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/tvTip"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTip"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_preview_pdf_screenshot_tip"
                android:layout_marginStart="@dimen/dp4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivTipWarning"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/btnTakeScreenshot"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="@string/ac_preview_pdf_take_screenshots_upload"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ppButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
