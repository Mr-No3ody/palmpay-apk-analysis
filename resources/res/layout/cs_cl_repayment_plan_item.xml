<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16">
    <View
        android:id="@+id/top_divider_view"
        android:background="@drawable/cs_cl_preview_progress_divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/status_img"
        app:layout_constraintEnd_toEndOf="@+id/status_img"
        app:layout_constraintStart_toStartOf="@+id/status_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/status_img"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/plan_progress_pb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/plan_progress_pb"
        app:srcCompat="@drawable/cs_oc_bill_installment_uncompleted_icon"/>
    <View
        android:id="@+id/bottom_divider_view"
        android:background="@drawable/cs_cl_preview_progress_divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/status_img"
        app:layout_constraintStart_toStartOf="@+id/status_img"
        app:layout_constraintTop_toBottomOf="@+id/status_img"/>
    <ProgressBar
        android:id="@+id/plan_progress_pb"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:max="100"
        android:progress="25"
        android:indeterminate="false"
        android:progressDrawable="@drawable/cs_oc_preview_index_progress"
        app:layout_constraintBottom_toBottomOf="@+id/index_tv"
        app:layout_constraintEnd_toEndOf="@+id/index_tv"
        app:layout_constraintStart_toStartOf="@+id/index_tv"
        app:layout_constraintTop_toTopOf="@+id/index_tv"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/index_tv"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/status_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/plan_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cur_plan_tv"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_pb"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/cur_plan_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/csView17"
        app:layout_constraintStart_toStartOf="@+id/plan_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/plan_title_tv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/due_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/plan_amount_tv"
        app:layout_constraintEnd_toEndOf="@+id/plan_amount_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#9ca2aa"
        android:id="@+id/plan_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp5"
        app:layout_constraintBottom_toTopOf="@+id/service_fee_amount_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/due_date_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#9ca2aa"
        android:id="@+id/service_fee_amount_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp5"
        app:layout_constraintBottom_toTopOf="@+id/csView17"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plan_amount_tv"/>
    <View
        android:id="@+id/csView17"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/plan_amount_tv"
        app:layout_constraintStart_toStartOf="@+id/cur_plan_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
