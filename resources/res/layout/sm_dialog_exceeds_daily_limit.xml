<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp24"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp10"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="@string/sm_exceeds_daily_limit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Text.6f7b85.14"/>
    <ImageView
        android:id="@+id/ivMiddle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="124dp"
        android:layout_marginTop="@dimen/dp12"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ivMiddle">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvCancel"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/core_cancel"
            android:layout_weight="1"
            style="@style/txt_me_w_b"/>
        <TextView
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:text="@string/sm_upgrade_kyc"
            android:layout_weight="1"
            style="@style/txt_me_w_b"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
