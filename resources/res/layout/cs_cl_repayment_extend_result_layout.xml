<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/repayment_status_img"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/status_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/repayment_status_img"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/status_content_tv"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_title_tv"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/csLinearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_content_tv">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/failed_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="16sp"
                android:textColor="@color/ppColorButtonTextWhite"
                android:id="@+id/view_extension_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp52"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/cs_cl_view_extension"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/cs_main_color"
                android:id="@+id/repay_left_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp52"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_cl_repay_complete"
                android:textAllCaps="false"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorButtonTextWhite"
            android:id="@+id/repay_complete_bt"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_cl_repay_complete"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/cl_extend_result_sav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dp16"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csLinearlayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
