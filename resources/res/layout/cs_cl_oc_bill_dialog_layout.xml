<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cs_oc_proto_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_oc_close_icon"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview105"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/cs_cl_you_have_an_outstanding_ok_card"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose"/>
    <View
        android:background="@drawable/cs_cl_oc_bill_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_oc_date_tv"
        app:layout_constraintEnd_toEndOf="@+id/cl_oc_amount_tv"
        app:layout_constraintStart_toStartOf="@+id/csTextview137"
        app:layout_constraintTop_toTopOf="@+id/csTextview137"/>
    <TextView
        android:textColor="#858a8f"
        android:id="@+id/csTextview137"
        android:paddingTop="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cs_cl_outstanding_bill"
        android:paddingStart="@dimen/dp16"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview105"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cl_oc_date_tv"
        android:paddingBottom="@dimen/dp27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="@+id/csTextview137"
        app:layout_constraintTop_toBottomOf="@+id/csTextview137"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/cl_oc_amount_tv"
        android:paddingBottom="@dimen/dp27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp6"
        android:drawableStart="@drawable/cs_cl_oc_icon"
        android:drawableEnd="@drawable/cs_cl_oc_bill_left_arrow"
        android:paddingEnd="@dimen/dp10"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_oc_date_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview137"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/cl_oc_repay_bt"
        android:background="@drawable/cs_cl_repay_bt_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="16dp"
        android:text="@string/cs_cl_oc_repay"
        android:textAllCaps="false"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_oc_date_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
