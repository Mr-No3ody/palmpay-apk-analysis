<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/core_transaction_details"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp40"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.custom_view.model.OrderResultHeaderModel
                android:id="@+id/orlm_heaer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_container_middle"
                android:background="@drawable/cv_shape_rect_bottom_corner_white_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultCustomerServiceModel
                android:id="@+id/model_order_result_customer_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
