<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cs_corner_16_16_0_0_bg_ffffff"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/csTextview4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cs_oc_new_repayment_date"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close_dialog_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_oc_close_icon"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/csLinearlayout2"
        android:background="@drawable/cs_oc_repayment_date_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview4">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/cs_main_color"
            android:id="@+id/select_repayment_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cs_main_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_oc_of_each_month"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/ppColorWarning"
        android:id="@+id/next_repayment_date_tv"
        android:background="@drawable/core_rect_corner_8_bg_fff4e5"
        android:paddingLeft="9dp"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="9dp"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cs_oc_recent_repayment_date"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="9dp"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csLinearlayout2"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/next_change_date_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/cs_oc_next_repayment_date"
        app:layout_constraintEnd_toEndOf="@+id/next_repayment_date_tv"
        app:layout_constraintStart_toStartOf="@+id/next_repayment_date_tv"
        app:layout_constraintTop_toBottomOf="@+id/next_repayment_date_tv"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/confirm_upgrade_ll"
        android:background="@drawable/cs_oc_primary_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/next_change_date_tv">
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center"
            android:id="@+id/confirm_loading_alv"
            android:visibility="gone"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp5"
            app:indicatorColor="@color/md_white_1000"
            app:indicatorName="BallSpinFadeLoaderIndicator"
            style="@style/AVLoadingIndicatorView.Large"/>
        <Button
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/confirm_upgrade_bt"
            android:padding="0dp"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/core_confirm"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/next_change_date_tv"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
