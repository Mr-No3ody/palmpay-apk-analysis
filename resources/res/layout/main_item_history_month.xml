<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_container_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:paddingStart="@dimen/large_margin"
        android:paddingEnd="@dimen/extra_margin">
        <TextView
            android:textSize="@dimen/dp20"
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/cv_icon_drop_down"
            android:drawablePadding="3dp"
            android:layout_centerVertical="true"
            style="@style/txt_s_b_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tvMonth">
            <TextView
                android:textSize="@dimen/dp12"
                android:id="@+id/moneyInTextViewSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:drawablePadding="2dp"
                android:layout_marginStart="@dimen/dp2"
                android:layout_marginEnd="@dimen/dp15"
                style="@style/txt_number_s_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:id="@+id/moneyOutTextViewSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:drawablePadding="2dp"
                android:layout_marginEnd="@dimen/extra_margin"
                style="@style/txt_number_s_b"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_monthly_overview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tvMonth"
            android:layout_alignBottom="@+id/tvMonth"
            android:layout_alignParentRight="true">
            <include layout="@layout/cv_layout_monthly_overview"/>
        </LinearLayout>
    </RelativeLayout>
    <View style="@style/core_divider_horizontal"/>
</LinearLayout>
