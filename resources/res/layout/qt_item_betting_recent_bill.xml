<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp80">
    <ImageView
        android:id="@+id/ivRecentBill"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/tvRecentBill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRecentBill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp6"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="@dimen/dp6"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRecentBill"/>
    <ImageView
        android:id="@+id/ivRemark"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
