<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:id="@+id/smsCodeView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginStart="@dimen/dp16"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/ppColorBackgroundLight"
        app:digitHeight="@dimen/dp48"
        app:digitRadius="@dimen/dp8"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/dp12"
        app:digitStrokeColor="@color/ppColorBackgroundLight"
        app:digitStrokeWidth="@dimen/dp1"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="24dp"
        app:digitWidth="@dimen/dp48"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_goneMarginTop="@dimen/dp12"
        app:mask=""
        app:numDigits="4"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTimeTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_didn_treceive_the_otp"
        app:layout_constraintStart_toStartOf="@+id/smsCodeView"
        app:layout_constraintTop_toBottomOf="@+id/smsCodeView"
        style="@style/txt_mi_g"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp2"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvTimeTips"
        app:layout_constraintStart_toEndOf="@+id/tvTimeTips"
        style="@style/txt_mi_g"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_horizontal"
        android:id="@+id/tvInputError"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/smsCodeView"
        app:layout_constraintTop_toBottomOf="@+id/tvTimeTips"
        style="@style/txt_s_g"/>
    <TextView
        android:enabled="true"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewSendSms"
        android:background="@drawable/cv_shape_rect_corner_16_stroke_purple"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/core_send_sms"
        android:layout_marginStart="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintStart_toEndOf="@+id/tvTimeTips"
        app:layout_constraintTop_toBottomOf="@+id/smsCodeView"
        style="@style/Text.medium.6306b2.12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/dp12"
        app:constraint_referenced_ids="tvTitle,smsCodeView,tvTimeTips,tvInputError,textViewSendSms"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tvTitle,smsCodeView,tvTimeTips,tvInputError,textViewSendSms"/>
    <View
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp1"
        app:layout_constraintStart_toEndOf="@+id/barrierEnd"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/llOthers"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_get_code_via_other_methods"
        android:includeFontPadding="false"
        app:iiv_end_color="@color/ppColorPrimary"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/Text.medium.6306b2.14"/>
</merge>
