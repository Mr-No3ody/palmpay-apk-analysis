<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/extra_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/viewHeader"
                android:paddingBottom="@dimen/dp24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/imageViewAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    app:srcCompat="@drawable/main_about_logo"/>
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/textViewName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="0dp"
                    style="@style/txt_s_b"/>
            </LinearLayout>
            <View
                android:background="@color/ppColorDividerLine"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp1"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16">
                <com.transsnet.palmpay.ui.view.SettingItem
                    android:id="@+id/key_to_score"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_setting_item_height"
                    android:title="@string/main_to_store"/>
                <com.transsnet.palmpay.ui.view.SettingItem
                    android:id="@+id/key_legal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_setting_item_height"
                    android:title="@string/main_terms_and_conditions"/>
                <com.transsnet.palmpay.ui.view.SettingItem
                    android:id="@+id/key_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_setting_item_height"
                    android:title="@string/main_privacy_policy"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/key_palmpay_official"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_setting_item_height">
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_contact_us"
                        app:layout_constraintBottom_toTopOf="@+id/tvSummery"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/ppColorTextAssist"
                        android:id="@+id/tvSummery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follow us on social media"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                        style="@style/txt_s_lg"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/viewDivider"
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="0dp"
                        android:layout_height="0.5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.transsnet.palmpay.ui.view.SettingItem
                    android:id="@+id/key_rate_us"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/main_setting_item_height"
                    android:title="@string/main_rate_us"
                    app:st_showDivider="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
