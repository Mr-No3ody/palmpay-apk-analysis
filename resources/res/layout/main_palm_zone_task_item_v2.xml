<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/tvDesc"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_mi_b_b"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvTimes"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvTimes"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/tvDesc"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/tvDesc"
        app:layout_constraintTop_toTopOf="@+id/tvDesc"
        style="@style/txt_mi_g"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorSuccess"
        android:gravity="center_vertical"
        android:id="@+id/tvCorner"
        android:background="@drawable/main_bg_task_item_corner"
        android:paddingLeft="@dimen/dp4"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="@dimen/dp4"
        android:paddingBottom="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:includeFontPadding="false"
        android:backgroundTint="@color/ppColorSuccessBackground"
        android:paddingHorizontal="@dimen/dp4"
        android:paddingVertical="@dimen/dp2"
        app:layout_constraintStart_toStartOf="@+id/tvDesc"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp10"
        android:gravity="center"
        android:id="@+id/btnRight"
        android:paddingLeft="@dimen/dp2"
        android:paddingRight="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:minWidth="@dimen/dp46"
        android:layout_marginStart="@dimen/extra_margin"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="@dimen/dp2"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/tvDesc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Lock"
        app:iiv_size="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnRight"
        app:layout_constraintEnd_toEndOf="@+id/btnRight"
        app:layout_constraintStart_toStartOf="@+id/btnRight"
        app:layout_constraintTop_toTopOf="@+id/btnRight"/>
</androidx.constraintlayout.widget.ConstraintLayout>
