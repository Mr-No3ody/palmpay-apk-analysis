<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="60dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp24"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="Confirm Your ID Info"
                style="@style/txt_bb_b_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please confirm that these details are yours and correct. Once submitted, they cannot be modified."
                android:lineSpacingExtra="2dp"
                style="@style/txt_s_g"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvName0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_id_type"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvLine0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvName0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName0"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/ac_id_number"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvName0"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvName1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName1"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/ac_legal_first_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvName1"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/tvName2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName2"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/ac_legal_last_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvName2"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvLine3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/tvName3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName3"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvName4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/ac_date_of_birth"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvName3"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvLine4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/tvName4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvName4"
                    style="@style/txt_s_b_b"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutBirthDay"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="16dp"
                    android:text="Please select your Date of Birth as registered with your BVN to ensure the security of your account"
                    android:layout_marginHorizontal="16dp"
                    style="@style/txt_mi_g"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputBirthday"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="@string/ac_please_select"
                    app:form_icon_edit_right="@drawable/cv_arrow_down_black"
                    app:form_layout_background="@color/transparent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/AcPpFormStyle"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvNotMe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Not My Info"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppSecondaryButtonStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/textViewNext"
        android:layout_width="match_parent"
        android:layout_marginBottom="16dp"
        android:text="ID Details Correct"
        app:layout_constraintBottom_toTopOf="@+id/tvNotMe"
        style="@style/ppButtonStyle"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
