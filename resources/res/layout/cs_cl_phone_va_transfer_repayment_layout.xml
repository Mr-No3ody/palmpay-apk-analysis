<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tvVaTransferTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_va_transfer_repayment_title"
            android:layout_weight="1"
            style="@style/Text.medium.202046.14"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llVaGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvVaGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_va_transfer_guide"
                style="@style/Text.9ca2aa.12"/>
            <ImageView
                android:id="@+id/ivVaGuideArrow"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:src="@drawable/cs_select_arrow_right"
                android:contentDescription="@string/cs_va_transfer_guide"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:gravity="start"
        android:id="@+id/tvVaTransferDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text="@string/cs_va_transfer_repayment_desc"
        android:lineSpacingMultiplier="1.3"
        style="@style/Text.6f7b85.12"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvVaAccountNumberLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_va_transfer_account_number"
                    android:layout_weight="1"
                    style="@style/Text.202046.12"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tvVaAccountNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="170dp"
                        android:singleLine="true"
                        android:fontFamily="@font/lib_ui_number_bold"
                        style="@style/Text.6306b2.12"/>
                    <ImageView
                        android:id="@+id/ivVaAccountCopy"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:src="@drawable/cv_copy_1"
                        android:contentDescription="@string/cs_va_transfer_copy"
                        android:layout_marginStart="@dimen/dp4"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@drawable/cv_dash_line_gray"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvVaAccountNameLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_va_transfer_account_name"
                    android:layout_weight="1"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvVaAccountName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="170dp"
                    android:singleLine="true"
                    style="@style/Text.medium.202046.12"/>
            </LinearLayout>
            <View
                android:background="@drawable/cv_dash_line_gray"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvVaBankNameLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_va_transfer_bank_name"
                    android:layout_weight="1"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvVaBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="170dp"
                    android:singleLine="true"
                    style="@style/Text.medium.202046.12"/>
            </LinearLayout>
            <View
                android:background="@drawable/cv_dash_line_gray"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp8"/>
        </LinearLayout>
    </LinearLayout>
</merge>
