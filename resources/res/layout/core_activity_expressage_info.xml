<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/gaea_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/core_shipping_status"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.custom_view.model.ModelEmptyView
            android:id="@+id/cae_empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cae_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp15"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:paddingEnd="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/cptv_tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_shipping_company"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/gaeiCompanyTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:background="@color/ppColorDividerLineDark"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"/>
            <RelativeLayout
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp15"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:paddingEnd="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_shipping_order_no"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/gaeiOrderNoTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:background="@color/ppColorDividerLineDark"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"/>
            <LinearLayout
                android:id="@+id/shippingToView"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp15"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp48"
                android:paddingEnd="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_shipping_to"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="right"
                    android:id="@+id/shippingToTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:background="@color/ppColorDividerLineDark"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gaeiRcv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
