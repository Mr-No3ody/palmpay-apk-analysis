<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/mm_bg_common_dialog"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp58"
        android:paddingRight="@dimen/dp24"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp90"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textStyle="bold"
            android:visibility="invisible"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:text="Congratulations!"
            style="@style/Text.medium.6306b2.26"/>
        <TextView
            android:id="@+id/tvPayoutTips"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/mm_fixed_saving_payout_tips"
            style="@style/Text.202046.14"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"/>
        <TextView
            android:id="@+id/tvProductName"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvTotalBackAmount"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp12"
            style="@style/Text.medium.6306b2.12"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvMaturedOrderNum"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp20"
            android:visibility="gone"
            style="@style/Text.000000.12"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp18">
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/rtvViewAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp44"
                android:text="View all"
                android:layout_weight="1"
                app:rtv_background_color="@color/ppColorSecondary"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/Text.medium.6306b2.12"/>
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:textColor="@color/md_white_1000"
                android:id="@+id/rtvCreateNew"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp44"
                android:layout_marginLeft="@dimen/dp16"
                android:text="Create new"
                android:layout_weight="1"
                app:rtv_background_color="@color/mm_color_6306b2"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/Text.medium.ffffff.12"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_icon_congratulations"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:layout_marginTop="148dp"
        android:text="Congratulations!"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.26"/>
</androidx.constraintlayout.widget.ConstraintLayout>
