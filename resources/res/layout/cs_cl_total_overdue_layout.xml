<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_common_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/cl_upgrade_service_mtb"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="Upgrade Service"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:src="@drawable/cs_cl_premium_card_img"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/service_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp36"
                android:text="@string/cs_cl_repay_to_upgrade"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/cs_cl_upgrade_only_apply"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/oc_bill_view"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ImageView
                    android:id="@+id/occsImageview6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/cs_cl_flex_bill_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/occsTextview71"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_flexi_bill"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/occsImageview6"
                    app:layout_constraintStart_toEndOf="@+id/occsImageview6"
                    app:layout_constraintTop_toTopOf="@+id/occsImageview6"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#b2333333"
                    android:id="@+id/oc_due_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/oc_overdue_days_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/occsTextview71"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cs_oc_overdue_txt_color"
                    android:id="@+id/oc_overdue_days_tv"
                    android:background="@drawable/cs_oc_all_bill_overdue_txt_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp3"
                    android:paddingEnd="@dimen/dp3"
                    app:layout_constraintBottom_toBottomOf="@+id/occsTextview71"
                    app:layout_constraintEnd_toEndOf="@+id/oc_due_date_tv"
                    app:layout_constraintTop_toBottomOf="@+id/oc_due_date_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:id="@+id/occsTextview106"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:text="@string/cs_cl_overdue_outstanding_amount"
                    app:layout_constraintStart_toStartOf="@+id/occsImageview6"
                    app:layout_constraintTop_toBottomOf="@+id/occsImageview6"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/oc_outstanding_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/occsTextview106"
                    app:layout_constraintTop_toBottomOf="@+id/occsTextview106"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/oc_repay_bt"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp28"
                    android:text="@string/cs_cl_overdue_repay"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="@+id/oc_outstanding_amount_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/occsTextview106"
                    style="@style/Widget.AppCompat.Button.Borderless"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_bill_view"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <ImageView
                    android:id="@+id/csImageview6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/cs_cl_flexi_cash_icon"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/csTextview71"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_flexi_cash_bill"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/csImageview6"
                    app:layout_constraintStart_toEndOf="@+id/csImageview6"
                    app:layout_constraintTop_toTopOf="@+id/csImageview6"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#b2333333"
                    android:id="@+id/cl_due_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/cl_overdue_days_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/csTextview71"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cs_oc_overdue_txt_color"
                    android:id="@+id/cl_overdue_days_tv"
                    android:background="@drawable/cs_oc_all_bill_overdue_txt_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp3"
                    android:paddingEnd="@dimen/dp3"
                    app:layout_constraintBottom_toBottomOf="@+id/csTextview71"
                    app:layout_constraintEnd_toEndOf="@+id/cl_due_date_tv"
                    app:layout_constraintTop_toBottomOf="@+id/cl_due_date_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:id="@+id/csTextview106"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:text="@string/cs_cl_overdue_outstanding_amount"
                    app:layout_constraintStart_toStartOf="@+id/csImageview6"
                    app:layout_constraintTop_toBottomOf="@+id/csImageview6"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/cl_outstanding_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/csTextview106"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview106"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/cl_repay_bt"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp28"
                    android:text="@string/cs_cl_overdue_repay"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="@+id/cl_outstanding_amount_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/csTextview106"
                    style="@style/Widget.AppCompat.Button.Borderless"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
