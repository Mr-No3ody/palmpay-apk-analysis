<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp12"
        android:src="@drawable/cs_cl_automatic_debit_dialog_close"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:gravity="bottom|center_horizontal"
        android:id="@+id/ll_bg"
        android:background="@drawable/cs_cl_automatic_debit_dialog_inner_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp96"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp60"
        android:layout_marginRight="@dimen/dp24">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp16">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_due_date_prefix"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorWarning"
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp7"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_cl_direct_debit_hint_content"
        android:layout_below="@+id/ll_bg"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btnTv"
        android:background="@drawable/cs_cl_borrow_txt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/cs_cl_direct_debit_hint"
        android:layout_below="@+id/tvHint"/>
    <ImageView
        android:id="@+id/ivCalendar"
        android:layout_width="94dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/dp26"
        android:src="@drawable/cs_cl_automatic_debit_dialog_icon"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
