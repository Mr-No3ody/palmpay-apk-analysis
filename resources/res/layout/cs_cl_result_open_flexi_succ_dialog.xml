<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:src="@drawable/cs_cl_double_open_success"
            android:layout_centerHorizontal="true"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/close"
            android:padding="@dimen/dp12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:iiv_color="#9ca2aa"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"/>
    </RelativeLayout>
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_congratulations"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/text1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_you_get_flexi_loan_amount"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="44sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/amountTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_due_to_your_high_credit_evaluation"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btnTv"
        android:background="@drawable/cs_cl_borrow_txt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_borrow_now"
        android:backgroundTint="@color/ppColorFlexiCashPrimary"
        android:layout_marginHorizontal="@dimen/dp24"/>
</LinearLayout>
