<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingTop="@dimen/dp20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_select_date"
        style="@style/Text.medium.202046.18"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wvMonth"
            android:paddingLeft="@dimen/dp64"
            android:paddingBottom="@dimen/dp18"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wvYear"
            android:paddingRight="@dimen/dp64"
            android:paddingBottom="@dimen/dp18"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp54"
        android:divider="@drawable/cv_shape_select_state_divider"
        android:showDividers="middle">
        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cv_action_cancel"
            android:layout_weight="1"
            style="@style/Text.medium.9ca2aa.16"/>
        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cv_action_confirm"
            android:layout_weight="1"
            style="@style/Text.medium.6306b2.16"/>
    </LinearLayout>
</LinearLayout>
