<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:paddingHorizontal="@dimen/dp16">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOperatorIcon"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            app:srcCompat="@drawable/cv_default_palmpay_icon_gray"/>
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvPhoneNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16"
            style="@style/Text.medium.202046.22"/>
    </LinearLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp16">
            <View
                android:id="@+id/viewBgAmount"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/spaceBottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvEvery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/core_every"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/viewBgAmount"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:id="@+id/tvDate"
                android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="@dimen/dp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                android:paddingHorizontal="@dimen/dp4"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
                app:layout_constraintStart_toEndOf="@+id/tvEvery"
                style="@style/Text.medium.6306b2.14"/>
            <TextView
                android:id="@+id/tvAutoTopUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qt_auto_top_up"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvEvery"
                app:layout_constraintStart_toEndOf="@+id/tvDate"
                style="@style/Text.medium.202046.14"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ryAmount"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp8"
                app:layout_constraintTop_toBottomOf="@+id/tvEvery"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/gpAmountList"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="viewBgAmount,tvEvery,tvDate,tvAutoTopUp,ryAmount"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tvAmountTips"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="@+id/viewBgAmount"
                app:layout_constraintStart_toStartOf="@+id/viewBgAmount"
                app:layout_constraintTop_toBottomOf="@+id/ryAmount"
                style="@style/Text.9ca2aa.12"/>
            <Space
                android:id="@+id/spaceBottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp4"
                app:layout_constraintTop_toBottomOf="@+id/tvAmountTips"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp10"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp10"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp10"
        android:paddingVertical="@dimen/dp12">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvTurnOff"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp6"
            android:layout_marginRight="@dimen/dp6"
            android:text="@string/core_turn_off"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp6"
            style="@style/Text.medium.ffffff.16"/>
        <TextView
            android:id="@+id/tvConfirm"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp6"
            android:layout_marginRight="@dimen/dp6"
            android:text="@string/core_confirm"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp6"
            style="@style/Text.medium.ffffff.16"/>
    </LinearLayout>
</LinearLayout>
