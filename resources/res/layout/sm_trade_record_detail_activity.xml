<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/core_transaction_details"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp40"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ViewStub
                android:id="@+id/vs_header"
                android:layout="@layout/sm_trade_record_detail_header"
                android:inflatedId="@+id/orlm_heaer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_transfer_result_extend"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp24"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
            </FrameLayout>
            <ViewStub
                android:id="@+id/vs_to_pp_progress"
                android:layout="@layout/sm_trade_record_detail_to_palmpay_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/vs_to_bank_progress"
                android:layout="@layout/sm_trade_record_detail_to_bank_progress"
                android:inflatedId="@+id/v_progress_to_bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_fee_detail"
                android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
                android:paddingTop="@dimen/dp8"
                android:paddingBottom="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp10"
                android:paddingVertical="@dimen/dp8"/>
            <ViewStub
                android:id="@+id/vs_transfer_to_bank_fast_refund_progress"
                android:layout="@layout/sm_layout_transfer_to_bank_fast_refund_safeguard_viewstub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp10"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_container_middle"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp4"
                android:paddingBottom="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp4"/>
            <com.transsnet.palmpay.core.ui.widget.FixedSavingsLayout
                android:id="@+id/layout_fixed_savings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
            <ViewStub
                android:id="@+id/vs_question"
                android:layout="@layout/sm_trade_record_detail_question"
                android:inflatedId="@+id/model_transfer_question_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
            <Button
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/record_cancel_btn"
                android:background="@drawable/cv_button_bg_purple_corner_with_border"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ppButtonHeight"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/sm_bill_detail_cancel_action"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.send_money.ui.view.TransferDetailBottomModel
        android:id="@+id/model_transfer_detail_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</LinearLayout>
