<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_gift_card_body_top"
        android:background="@drawable/qt_shape_gift_card_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp34"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_gift_card_body_content"
        android:background="@drawable/cv_shape_rect_corner_bl_br_12_bg_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_gift_card_body_top"/>
    <ImageView
        android:id="@+id/iv_gift_card_operator_icon"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/v_gift_card_body_top"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_top"
        app:layout_constraintTop_toTopOf="@+id/v_gift_card_body_top"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_gift_card_operator_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp20"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_gift_card_body_top"
        app:layout_constraintEnd_toStartOf="@+id/tv_gift_card_country_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_gift_card_operator_icon"
        app:layout_constraintTop_toTopOf="@+id/v_gift_card_body_top"
        style="@style/Text.ffffff.12"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_gift_card_country_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_gift_card_body_top"
        app:layout_constraintEnd_toEndOf="@+id/v_gift_card_body_top"
        app:layout_constraintTop_toTopOf="@+id/v_gift_card_body_top"
        style="@style/Text.ffffff.12"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_gift_card_operator_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/v_gift_card_body_top"
        app:layout_constraintWidth_max="@dimen/dp200"
        style="@style/Text.medium.6306b2.16"/>
    <TextView
        android:id="@+id/tv_gift_card_code_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/qt_gift_card_code_title"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/v_gift_card_body_top"
        style="@style/Text.6f7b85.10"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_gift_card_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_gift_card_copy"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_gift_card_code_title"
        style="@style/Text.medium.202046.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_gift_card_copy"
        android:visibility="gone"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Copy"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_gift_card_code"
        app:layout_constraintEnd_toStartOf="@+id/tv_gift_card_operator_price"
        app:layout_constraintStart_toEndOf="@+id/tv_gift_card_code"
        app:layout_constraintTop_toTopOf="@+id/tv_gift_card_code"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_gift_card_code,iv_gift_card_copy"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexbox_gift_card_pin_expire"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:alignContent="flex_start"
        app:alignItems="flex_start"
        app:dividerDrawableHorizontal="@drawable/qt_shape_gift_card_flex_row_spacing"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="space_between"
        app:layout_constraintEnd_toStartOf="@+id/tv_gift_card_operator_price"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/barrier_code"
        app:showDividerHorizontal="middle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_gift_card_pin"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_gift_card_pin_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qt_pin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.6f7b85.10"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_gift_card_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:maxLines="2"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/iv_gift_card_pin_copy"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_gift_card_pin_title"
                style="@style/Text.medium.202046.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_gift_card_pin_copy"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:contentDescription="@string/core_copy"
                android:layout_marginStart="@dimen/dp4"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Copy"
                app:iiv_size="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="@+id/tv_gift_card_pin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_gift_card_pin"
                app:layout_constraintTop_toTopOf="@+id/tv_gift_card_pin"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_gift_card_expire"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_gift_card_expire_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_valid_to"
                style="@style/Text.6f7b85.10"/>
            <TextView
                android:id="@+id/tv_gift_card_expire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:maxLines="1"
                style="@style/Text.medium.202046.14"/>
        </LinearLayout>
    </com.google.android.flexbox.FlexboxLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_primary_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="flexbox_gift_card_pin_expire,tv_gift_card_operator_price"/>
    <View
        android:id="@+id/v_gift_card_divider"
        android:background="@color/ppColorDividerLineDark"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="@+id/v_gift_card_body_content"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/barrier_primary_info"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_gift_card_secondary_info"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="@+id/v_gift_card_body_content"
        app:layout_constraintStart_toStartOf="@+id/v_gift_card_body_content"
        app:layout_constraintTop_toBottomOf="@+id/v_gift_card_divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_gift_card_instructions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tv_gift_card_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp14"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_gift_card_instructions_copy"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.9ca2aa.10"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_gift_card_instructions_copy"
                android:layout_width="@dimen/dp12"
                android:layout_height="@dimen/dp12"
                android:contentDescription="@string/core_copy"
                android:layout_marginStart="@dimen/dp2"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Copy"
                app:iiv_size="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="@+id/tv_gift_card_instructions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_gift_card_instructions"
                app:layout_constraintTop_toTopOf="@+id/tv_gift_card_instructions"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:gravity="start|center_vertical"
            android:linksClickable="true"
            android:id="@+id/tv_gift_card_redemption_url"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp14"
            android:includeFontPadding="false"
            style="@style/Text.9ca2aa.10"/>
        <TextView
            android:id="@+id/tv_gift_card_used_note"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/dp2"
            style="@style/Text.9ca2aa.10"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/dp12"
        app:constraint_referenced_ids="barrier_primary_info,v_gift_card_divider,layout_gift_card_secondary_info"/>
</merge>
