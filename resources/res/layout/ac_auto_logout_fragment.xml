<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="start"
        android:id="@+id/tvVerifyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ac_verification_methods"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="start"
        android:id="@+id/tvVerifySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text="@string/ac_verification_methods_subtitle"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifyTitle"
        style="@style/Text.6f7b85.12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clFingerprint"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp12"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifySubtitle">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tvFingerprint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ac_login_with_fingerprint"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivFingerSwitch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.14"/>
        <ImageView
            android:id="@+id/ivFingerSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cv_checkbox_selector5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/clPatternGroup"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clFingerprint">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_pattern"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_login_with_pattern"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_pattern_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <ImageView
                android:id="@+id/iv_pattern_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/cv_checkbox_selector5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_pattern_change"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12">
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_change_pattern"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iivChangeArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iivChangeArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_pattern_forgot"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp52"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12">
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_forgot_pattern"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iivForgotArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iivForgotArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
