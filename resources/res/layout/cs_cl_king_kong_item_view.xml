<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rootFlexiView"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="152dp">
    <TextView
        android:gravity="left"
        android:id="@+id/tvTitle"
        android:paddingRight="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvContent"
        android:paddingRight="@dimen/dp16"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.12"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:id="@+id/btnBottom"
        android:background="@drawable/cs_cl_repay_txt_bg"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="0dp"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="0dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="12dp"
        android:text="Go"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/ivBottomIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
