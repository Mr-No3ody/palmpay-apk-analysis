<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_top_corner_white_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_large_title"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_b_b_b"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/ivClose"
            android:padding="@dimen/dp16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_close_grey"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llRemark"
        android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivTag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            app:iiv_color="@color/ppColorWarning"
            app:iiv_icon="pay_WarningFill"
            app:iiv_size="16dp"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivTag1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_WarningFill"
            app:iiv_size="16dp"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.transsnet.palmpay.core.ui.widget.AmountUnitLayout
        android:layout_gravity="center"
        android:id="@+id/amountLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:layout_marginBottom="@dimen/dp4"
        app:amountTextBold="true"
        app:amountTextColor="@color/ppColorPrimary"
        app:amountTextSize="28dp"
        app:currencySymbolSize="28dp"
        app:showCurrencySymbol="true"
        app:unitGravity="left"
        app:unitTextColor="@color/ppColorTextBase"
        app:unitTextSize="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/layoutName"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_name"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            style="@style/txt_s_b"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:gravity="center_vertical"
            android:id="@+id/iv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp1"
            android:layout_marginRight="@dimen/dp2"
            app:iiv_color="@color/ppColorSuccess"
            app:iiv_icon="pay_Security"
            app:iiv_size="@dimen/dp16"
            style="@style/Text.202046.16"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp4"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:paddingVertical="8dp">
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_account_number"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:paddingVertical="8dp">
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tv_name_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_bank"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_s_b"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_s_b_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/cslAmount"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:paddingVertical="8dp">
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvAmountTile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_transfer_amount"
            android:includeFontPadding="false"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_s_b"/>
        <com.transsnet.palmpay.core.ui.widget.AmountUnitLayout
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:amountTextBold="true"
            app:amountTextColor="@color/ppColorTextPrimary"
            app:amountTextSize="14sp"
            app:autoSetParentClipChildren="true"
            app:currencySymbolSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:parentClipChildrenLevels="3"
            app:showCurrencySymbol="true"
            app:unitGravity="right"
            app:unitTextColor="@color/ppColorTextBase"
            app:unitTextSize="10sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp15"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp15">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvRecheck"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/core_recheck"
            android:layout_weight="1"
            style="@style/txt_me_w_b"/>
        <TextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:text="@string/core_confirm"
            android:layout_weight="1"
            style="@style/txt_me_w_b"/>
    </LinearLayout>
</LinearLayout>
