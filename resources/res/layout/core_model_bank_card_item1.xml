<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbci_root"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp56">
    <ImageView
        android:id="@+id/mbci_access_bank_iv"
        android:layout_width="@dimen/dp25"
        android:layout_height="@dimen/dp25"
        android:src="@drawable/cv_default_bank_logo"
        android:layout_centerVertical="true"/>
    <TextView
        android:textColorHint="#9ea4aa"
        android:ellipsize="end"
        android:id="@+id/mbci_bankname_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:hint="@string/core_select_a_bank"
        android:singleLine="true"
        android:layout_toRightOf="@+id/mbci_access_bank_iv"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/mbci_access_bank_iv"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="bottom"
        android:id="@+id/mbci_bank_card_number_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_toLeftOf="@+id/mbci_right_iv"
        android:layout_toRightOf="@+id/mbci_bankname_tv"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/mbci_right_iv"
        android:layout_toEndOf="@+id/mbci_bankname_tv"
        style="@style/txt_s_lg"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbci_right_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="16dp"/>
    <View
        android:id="@+id/mbci_bottom_line"
        android:background="@color/ppColorDividerLineDark"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
