<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/bottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_home_account_bar_bg"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/main_available_balance"
        android:includeFontPadding="false"
        android:drawablePadding="4dp"
        android:layout_marginStart="@dimen/dp16"
        app:iiv_start_color="@color/ppColorSuccess"
        app:iiv_start_icon="pay_Security"
        app:iiv_start_size="@dimen/dp12"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_mi_b"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="-"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_me_b"/>
    <ViewStub
        android:id="@+id/loadingViewStub"
        android:layout="@layout/main_layout_loading_view"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
        app:layout_constraintStart_toEndOf="@+id/tvAmount"
        app:layout_constraintTop_toTopOf="@+id/tvAmount"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEye"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp22"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:paddingEnd="6dp"
        android:layout_marginStart="@dimen/dp4"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintLeft_toRightOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:tint="@color/ppColorTextPrimary"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tvFund"
        android:background="@drawable/main_bg_home_account_bar_fund_button"
        android:paddingLeft="@dimen/dp6"
        android:paddingRight="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="5dp"
        android:text="@string/core_add_money"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAmount"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvTransHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_transaction_history"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_end_color="@color/ppColorTextPrimary"
        app:iiv_end_icon="pay_ArrowCenterRight"
        app:iiv_end_size="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/txt_mi_b"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTipsBg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvNetworkTips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvNetworkTips"
        app:srcCompat="@drawable/main_pop_bg"/>
    <TextView
        android:textColor="@color/main_pop_text_color"
        android:gravity="center_vertical"
        android:id="@+id/tvNetworkTips"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lines="2"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"
        style="@style/txt_mi_g"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupNotNetwork"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivTipsBg, tvNetworkTips"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ivTipsBg, tvAmount"/>
    <Space
        android:id="@+id/bottomSpace"
        android:layout_width="1dp"
        android:layout_height="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
