<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/ac_device_detail"/>
    <include
        android:id="@+id/line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        layout="@layout/ac_layout_device_detail_item"/>
    <include
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ac_detail_item_height"
        android:layout_marginTop="12dp"
        layout="@layout/ac_layout_device_detail_item"/>
    <include
        android:id="@+id/line3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ac_detail_item_height"
        android:layout_marginTop="0dp"
        layout="@layout/ac_layout_device_detail_item"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <include
        android:id="@+id/line4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ac_detail_item_height"
        android:layout_marginTop="0dp"
        layout="@layout/ac_layout_device_detail_item"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="#858a8f"
        android:id="@+id/tvRemark"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp15"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp15"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ac_not_aperate_yourself"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp15"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:id="@+id/textViewComplete"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/ac_remove"
        style="@style/txt_s_w"/>
</LinearLayout>
