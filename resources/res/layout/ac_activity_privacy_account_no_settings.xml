<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="Privacy Account No. Setting"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="Both PalmPay Accounts can be used to receive transfers."
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_mi_lg"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="@dimen/dp16"
            android:layout_marginVertical="12dp">
            <TextView
                android:textSize="@dimen/dp24"
                android:gravity="center_vertical"
                android:id="@+id/tvNo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_b_b_b"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Generated based on your bound phone number."
                app:layout_constraintTop_toBottomOf="@+id/tvNo1"
                style="@style/txt_mi_lg"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/check1"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/cv_checkbox_selector6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/layout2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="12dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="@dimen/dp16"
            android:layout_marginVertical="12dp">
            <TextView
                android:textSize="@dimen/dp24"
                android:gravity="center_vertical"
                android:id="@+id/tvNo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_b_b_b"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Fixed account generated for personal privacy protection."
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintEnd_toStartOf="@+id/check2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNo2"
                style="@style/txt_mi_lg"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/check2"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/cv_checkbox_selector6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textSize="@dimen/dp10"
                android:textColor="#1bc286"
                android:id="@+id/tvPrefer2"
                android:background="@drawable/cv_shape_rect_corner_4_bg_e4f7f0"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefer"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp4"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="4dp"
                app:iiv_start_color="#1bc286"
                app:iiv_start_icon="pay_Security"
                app:iiv_start_size="@dimen/dp10"
                app:layout_constraintBottom_toBottomOf="@+id/tvNo2"
                app:layout_constraintStart_toEndOf="@+id/tvNo2"
                app:layout_constraintTop_toTopOf="@+id/tvNo2"
                style="@style/txt_mi_lg"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="28dp"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_confirm"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/ppButtonStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:text="When you switch the Account Number display, the following changes will occur :\10\10 • The account in the app will display the number you have selected, such as the My profile page or Me page;\10\10 • When transferring money to others, they will see the number you have selected;"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_mi_lg"/>
</LinearLayout>
