<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cs_oc_proto_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/csTextview58"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/cs_bill_inst_dialog_title"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/csTextview103"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/cs_ins_plan_bill_amount"
        app:layout_constraintEnd_toStartOf="@+id/csTextview107"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview58"
        style="@style/csClRepaymentPlanTitleTextStyle"/>
    <TextView
        android:id="@+id/csTextview107"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_bill_ins_plan_title"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview103"
        app:layout_constraintEnd_toStartOf="@+id/csTextview109"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/csTextview103"
        app:layout_constraintTop_toTopOf="@+id/csTextview103"
        style="@style/csClRepaymentPlanTitleTextStyle"/>
    <TextView
        android:id="@+id/csTextview109"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_bill_ins_otal_interest_title"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview107"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/csTextview107"
        app:layout_constraintTop_toTopOf="@+id/csTextview107"
        style="@style/csClRepaymentPlanTitleTextStyle"/>
    <TextView
        android:id="@+id/total_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/csTextview103"
        app:layout_constraintStart_toStartOf="@+id/csTextview103"
        app:layout_constraintTop_toBottomOf="@+id/csTextview103"
        style="@style/csClRepaymentPlanContentTextStyle"/>
    <TextView
        android:id="@+id/borrow_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/csTextview107"
        app:layout_constraintStart_toStartOf="@+id/csTextview107"
        app:layout_constraintTop_toBottomOf="@+id/csTextview107"
        style="@style/csClRepaymentPlanContentTextStyle"/>
    <TextView
        android:id="@+id/total_interest_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/csTextview109"
        app:layout_constraintStart_toStartOf="@+id/csTextview109"
        app:layout_constraintTop_toBottomOf="@+id/csTextview109"
        style="@style/csClRepaymentPlanContentTextStyle"/>
    <View
        android:id="@+id/csView23"
        android:background="#d8d8d8"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="22dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/total_amount_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/repayment_plan_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/confirm_bt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csView23"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/confirm_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/core_confirm"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
