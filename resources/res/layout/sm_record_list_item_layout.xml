<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/sm_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <ImageView
        android:id="@+id/record_photo"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/record_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="@style/Text.202046.14"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/record_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextAssist"
                android:id="@+id/record_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorError"
                android:id="@+id/record_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
