<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mbci_root"
        android:paddingLeft="@dimen/dp15"
        android:paddingTop="10dp"
        android:paddingRight="@dimen/dp15"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mbci_access_bank_iv"
            android:layout_width="@dimen/dp25"
            android:layout_height="@dimen/dp25"
            android:src="@drawable/cv_default_bank_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/mbci_access_bank_iv"
            app:layout_constraintRight_toLeftOf="@+id/cii_apply_tv"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                app:layout_goneMarginBottom="@dimen/dp16">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/mbci_bankname_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp180"
                    android:singleLine="true"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/mbci_bank_card_number_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    style="@style/txt_s_b_b"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/mbci_recent"
                    android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
                    android:paddingLeft="@dimen/dp8"
                    android:paddingTop="@dimen/dp1"
                    android:paddingRight="@dimen/dp8"
                    android:paddingBottom="@dimen/dp1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_recent"
                    android:layout_marginStart="@dimen/dp5"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp1"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextBase"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/mbci_discount_amount_tv"
                    android:background="@drawable/cv_button_bg_yellow_corner_2"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingTop="@dimen/dp1"
                    android:paddingRight="@dimen/dp4"
                    android:paddingBottom="@dimen/dp1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp5"
                    android:paddingHorizontal="@dimen/dp4"
                    android:paddingVertical="@dimen/dp1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/mbci_hint1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/mbci_access_bank_iv"
                    style="@style/txt_mi_b"/>
                <TextView
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/mbci_expire"
                    android:background="@drawable/core_background_storke_9ca2aa_4"
                    android:paddingLeft="@dimen/dp8"
                    android:paddingTop="@dimen/dp1"
                    android:paddingRight="@dimen/dp8"
                    android:paddingBottom="@dimen/dp1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_expired"
                    android:layout_marginStart="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp1"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="#63c778"
                android:id="@+id/mbci_hint2"
                android:background="@drawable/cv_rect_tl_tr_br_corner_4_bg_d9fae1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp2"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp5"
                app:layout_constraintLeft_toRightOf="@+id/cii_access_bank_iv"
                app:layout_constraintTop_toBottomOf="@+id/cii_hint2"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/mbci_right_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cii_apply_tv"
            android:background="@drawable/cv_shape_halfround_purple"
            android:paddingLeft="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30sp"
            android:text="@string/core_activate_pay_method"
            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mbci_right_iv"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/mbci_mantle"
            android:background="#66ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/mbci_bottom_line"
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
</LinearLayout>
