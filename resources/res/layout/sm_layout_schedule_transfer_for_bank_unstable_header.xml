<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start"
        android:id="@+id/tv_active_booking_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/sm_active_bookings"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_active_booking_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/tv_active_booking_title"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_completed_booking_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/sm_completed_bookings"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@+id/rv_active_booking_list"
        app:layout_goneMarginTop="@dimen/dp12"
        style="@style/Text.medium.202046.16"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/tv_date"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_end_color="@color/ppColorTextPrimary"
        app:iiv_end_icon="pay_Arrowdown"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_completed_booking_title"
        app:layout_constraintEnd_toEndOf="@+id/tv_completed_booking_title"
        app:layout_constraintTop_toTopOf="@+id/tv_completed_booking_title"
        style="@style/Text.202046.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
