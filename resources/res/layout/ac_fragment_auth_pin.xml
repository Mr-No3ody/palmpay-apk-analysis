<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorMask"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/imageViewClose"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:paddingEnd="10dp"
                android:layout_alignParentEnd="true"
                android:paddingVertical="@dimen/dp16"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Close"
                app:iiv_size="24dp"/>
            <TextView
                android:id="@+id/textViewTitle"
                android:paddingTop="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_pin_verification"
                android:layout_centerHorizontal="true"
                style="@style/txt_l_b"/>
        </RelativeLayout>
        <com.transsnet.palmpay.custom_view.PinEntryView
            android:enabled="false"
            android:id="@+id/pinView"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            app:accentType="character"
            app:accentWidth="0dp"
            app:digitBackground="@color/ppColorTextBase"
            app:digitHeight="45dp"
            app:digitRadius="4dp"
            app:digitSelectStrokeColor="@color/ppColorPrimary"
            app:digitSpacing="10dp"
            app:digitStrokeColor="@color/ppColorTextDisable"
            app:digitStrokeWidth="1dp"
            app:digitTextColor="@color/ppColorTextPrimary"
            app:digitTextSize="@dimen/large_text"
            app:digitWidth="45dp"
            app:mask="●"
            app:pinInputType="number"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/textViewMessage"
                android:paddingLeft="@dimen/large_margin"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:paddingStart="@dimen/large_margin"
                android:paddingEnd="@dimen/large_margin"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="center"
                android:id="@+id/textViewFailMessage"
                android:paddingBottom="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                style="@style/txt_s_g"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_forget_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_str_forget_pin"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>
        <include
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            layout="@layout/core_number_keyboard_layout"/>
    </LinearLayout>
</RelativeLayout>
