<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/mtb"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                app:layout_constraintTop_toTopOf="parent"
                app:title_bar_title="@string/mm_cash_box_add_money"
                app:title_bar_title_color="@color/ppColorTextPrimary"/>
            <com.transsnet.palmpay.managemoney.ui.view.CashBoxEstimatedInterestView
                android:id="@+id/viewEstimatedInterest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:esrv_type="DEPOSIT"
                app:layout_constraintTop_toBottomOf="@+id/mtb"/>
            <Space
                android:id="@+id/space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp20"
                app:layout_constraintBottom_toBottomOf="@+id/viewEstimatedInterest"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutAutoTransfer"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/space">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_AutoSave"
                    app:iiv_size="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAutoSaveDesc"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvAutoSave"/>
                <TextView
                    android:id="@+id/tvAutoSave"
                    android:layout_marginLeft="@dimen/dp8"
                    android:text="@string/mm_auto_save_to_cashbox"
                    app:layout_constraintLeft_toRightOf="@+id/ivRefresh"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/tvAutoSaveDesc"
                    android:layout_width="0dp"
                    android:layout_marginRight="@dimen/dp10"
                    android:text="@string/mm_cashbox_auto_save_tips"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintLeft_toLeftOf="@+id/tvAutoSave"
                    app:layout_constraintRight_toLeftOf="@+id/switchWidget"
                    app:layout_constraintTop_toBottomOf="@+id/tvAutoSave"
                    style="@style/Text.9ca2aa.10"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switchWidget"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp20"
                    android:thumb="@drawable/mm_shape_switch_common_thumb"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAutoSaveDesc"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvAutoSave"
                    app:switchMinWidth="@dimen/dp36"
                    app:track="@drawable/mm_shape_switch_common_track"/>
                <TextView
                    android:id="@+id/tvTransferAgreement"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/mm_cashbox_auto_save_transfer_agreement"
                    app:layout_constraintLeft_toLeftOf="@+id/tvAutoSave"
                    app:layout_constraintTop_toBottomOf="@+id/tvAutoSaveDesc"
                    style="@style/Text.202046.10"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutInterestInfo"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/layoutAutoTransfer">
                <ImageView
                    android:id="@+id/ivInterest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mm_icon_interest"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvInterest"
                    android:layout_marginLeft="@dimen/dp8"
                    android:text="Riba-Free Mode"
                    app:layout_constraintBottom_toTopOf="@+id/tvInterestSec"
                    app:layout_constraintLeft_toRightOf="@+id/ivInterest"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/tvInterestSec"
                    android:visibility="gone"
                    android:text="You will not earn interest on your savings and CashBox account"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/switchWidgetInterest"
                    app:layout_constraintStart_toStartOf="@+id/tvInterest"
                    app:layout_constraintTop_toBottomOf="@+id/tvInterest"
                    style="@style/Text.6f7b85.12"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switchWidgetInterest"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp20"
                    android:thumb="@drawable/mm_shape_switch_common_thumb"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:switchMinWidth="@dimen/dp36"
                    app:track="@drawable/mm_shape_switch_common_track"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/ppColorBackgroundLight"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <CheckBox
            android:gravity="center"
            android:id="@+id/ckProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:checked="true"
            android:button="@drawable/cv_checkbox_selector2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="left"
            android:id="@+id/tvProtocol"
            android:layout_width="0dp"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/mm_cash_box_protocol"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/ckProtocol"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ckProtocol"
            style="@style/Text.858a8f.10"/>
        <View
            android:id="@+id/viewDivider"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/tvProtocol"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:enabled="false"
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/rtvNext"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_next"
            app:layout_constraintTop_toBottomOf="@+id/viewDivider"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ckProtocol,tvProtocol,viewDivider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
