<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srlRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.transsnet.palmpay.custom_view.ReboundScrollView
            android:id="@+id/contentRsvMain"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp80"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/adViewTop"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp12"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.palmpay.credit.view.LoanOutstandingSummaryView
                    android:id="@+id/viewOutstandingSummary"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
                <com.transsnet.palmpay.credit.view.ProductContentListView
                    android:id="@+id/viewProductContentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
                <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
                    android:id="@+id/viewLoanHomeBottomInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:layout_marginVertical="@dimen/dp16"/>
            </LinearLayout>
        </com.transsnet.palmpay.custom_view.ReboundScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ViewStub
        android:id="@+id/emptyViewStub"
        android:layout="@layout/cs_layout_home_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp80"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
