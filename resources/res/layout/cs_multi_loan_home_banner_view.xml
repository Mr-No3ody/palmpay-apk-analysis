<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBanner"
    android:background="@drawable/cs_multi_loan_banner_info_bg"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp8">
    <ImageView
        android:id="@+id/ivIcon"
        android:visibility="gone"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:fontFamily="@font/lib_ui_roboto_lite_medium"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        style="@style/Text.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
