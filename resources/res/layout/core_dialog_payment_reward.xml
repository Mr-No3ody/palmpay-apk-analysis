<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cdpr_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_dont_miss_out"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/cdpr_content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginTop="@dimen/dp15"
        android:layout_marginRight="@dimen/dp40"
        android:text="@string/core_try_again_to_pay"
        android:layout_marginHorizontal="@dimen/dp40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cdpr_title_tv"/>
    <ImageView
        android:id="@+id/cdpr_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cdpr_content_tv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/contentBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cdpr_iv,cdpr_content_tv"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/cdpr_cancel_tv"
        android:background="@drawable/cv_button_bg_light_purple_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="23dp"
        android:text="@string/core_leave"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintEnd_toStartOf="@+id/cdpr_confirm_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contentBarrier"/>
    <TextView
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:id="@+id/cdpr_confirm_tv"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:text="@string/core_continue"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cdpr_cancel_tv"
        app:layout_constraintTop_toTopOf="@+id/cdpr_cancel_tv"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvReward"
        android:background="@drawable/cv_button_bg_yellow_corner_2"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp18"
        android:layout_marginBottom="35dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/cdpr_confirm_tv"
        app:layout_constraintEnd_toEndOf="@+id/cdpr_confirm_tv"
        style="@style/txt_mi_w"/>
</androidx.constraintlayout.widget.ConstraintLayout>
