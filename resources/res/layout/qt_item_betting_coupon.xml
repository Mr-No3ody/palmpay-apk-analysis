<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
    android:paddingLeft="@dimen/dp8"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp8"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="234dp"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp8"
    android:paddingVertical="@dimen/dp8">
    <ImageView
        android:id="@+id/ivCouponIcon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/qt_ic_betting_coupon"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvCouponTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnAction"
        app:layout_constraintStart_toEndOf="@+id/ivCouponIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.14"/>
    <TextView
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/btnAction"
        android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:layout_marginStart="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
