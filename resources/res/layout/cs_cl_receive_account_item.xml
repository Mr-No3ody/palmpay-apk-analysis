<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16">
    <ImageView
        android:id="@+id/receive_account_img"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp11"
        android:layout_marginBottom="@dimen/dp11"
        android:src="@drawable/cv_palmpay_icon_circle_purple"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/receive_account_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp10"/>
    <ImageView
        android:id="@+id/selected_img"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginStart="@dimen/dp10"/>
</LinearLayout>
