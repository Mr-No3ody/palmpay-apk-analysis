<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbci_root"
    android:background="@drawable/cv_payment_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="26dp"
    android:paddingEnd="26dp">
    <ImageView
        android:id="@+id/mbci_iv_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/cv_default_bank_logo"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/mbci_iv_icon"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/mbci_tv_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_select_payment_method_title"
                android:singleLine="true"
                style="@style/txt_s_b_b"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/mbci_discount_amount_tv"
                android:background="@drawable/cv_button_bg_yellow_corner_2"
                android:paddingLeft="@dimen/dp4"
                android:paddingTop="@dimen/dp1"
                android:paddingRight="@dimen/dp4"
                android:paddingBottom="@dimen/dp1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp5"
                android:paddingHorizontal="@dimen/dp4"
                android:paddingVertical="@dimen/dp1"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/mbci_tv_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/txt_s_b"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="#38d79f"
            android:id="@+id/mbci_tv_line3"
            android:background="@drawable/cv_shape_rect_corner_4_bg_1a00c2ff"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbci_iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"/>
</RelativeLayout>
