<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/dp3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start|bottom"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp33"
        android:text="@string/core_faqs"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:layout_gravity="end|bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_all"
        android:layout_marginEnd="@dimen/dp12"
        style="@style/Text.202046.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/ivArrowRight"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp20"/>
</FrameLayout>
