<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mllb_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="59dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mllb_content_root"
        android:background="@drawable/core_shape_rect_corner_12_bg_white_stroke"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp11"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/mllb_icon_iv"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:layout_marginStart="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mllb_icon_iv"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/mllb_menu_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:paddingEnd="@dimen/dp5"
                style="@style/txt_mi_b_b"/>
            <TextView
                android:ellipsize="marquee"
                android:id="@+id/mllb_desc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:paddingEnd="@dimen/dp5"
                style="@style/txt_mi_g"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/mllb_corner_icon_iv"
        android:layout_width="@dimen/dp22"
        android:layout_height="@dimen/dp22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
