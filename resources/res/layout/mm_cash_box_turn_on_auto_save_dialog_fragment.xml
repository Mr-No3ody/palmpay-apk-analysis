<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/mm_icon_save_open"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/mm_rect_corner_12_bg_single_fff"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginRight="@dimen/dp22"
        android:layout_marginBottom="17dp"
        android:paddingVertical="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/rtvCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="#202046"
            android:id="@+id/tvInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Daily Earnings Effortless"
            app:iiv_color="#202046"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_padding="4dp"
            app:iiv_start_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="#202046"
            android:id="@+id/tvWithdrawals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:text="Free Withdrawals Anytime"
            android:layout_marginVertical="@dimen/dp12"
            app:iiv_color="#202046"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_padding="4dp"
            app:iiv_start_size="@dimen/dp20"
            app:layout_constraintStart_toStartOf="@+id/tvInterest"
            app:layout_constraintTop_toBottomOf="@+id/tvInterest"
            style="@style/Text.202046.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="#202046"
            android:id="@+id/tvPay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:text="Make Payments Freely"
            android:layout_marginVertical="@dimen/dp12"
            app:iiv_color="#202046"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_padding="4dp"
            app:iiv_start_size="@dimen/dp20"
            app:layout_constraintStart_toStartOf="@+id/tvInterest"
            app:layout_constraintTop_toBottomOf="@+id/tvWithdrawals"
            style="@style/Text.202046.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp9"
        android:textColor="#202046"
        android:id="@+id/tvProtocol"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp32"
        android:text="@string/mm_cashbox_auto_save_transfer_agreement"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/Text.202046.8"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="#6a35ff"
        android:id="@+id/rtvCancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_cancel"
        app:layout_constraintBottom_toTopOf="@+id/tvProtocol"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rtvTurnOn"
        app:rtv_background_color="@color/cv_color_ffffff"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.6306b2.12"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/md_white_1000"
        android:id="@+id/rtvTurnOn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp22"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_enable"
        app:layout_constraintBottom_toTopOf="@+id/tvProtocol"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/rtvCancel"
        app:layout_constraintRight_toRightOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
