<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:visibility="gone"
                layout="@layout/core_layout_hint_text_in_detail_page"/>
            <com.transsnet.palmpay.custom_view.model.ModelAmountList
                android:id="@+id/amountList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/viewBillType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_show_img="false"
                app:ctai_title="Payment Type"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/viewPayMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_title="Payment Method"/>
            <com.transsnet.palmpay.custom_view.model.ModelCopyableText
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/viewTradeNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp15"
                app:mctTitle="@string/core_reference_no_2"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/viewPostDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/viewOrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp25"/>
            <include
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_contact_service"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
