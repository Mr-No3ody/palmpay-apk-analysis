<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/ard_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:visibility="gone"
                layout="@layout/core_layout_hint_text_in_detail_page"/>
            <com.transsnet.palmpay.custom_view.model.ModelAmountList
                android:id="@+id/ard_amount_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_detail_page_error_reason"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ard_remark_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:id="@+id/ard_remark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp15"/>
                <View
                    android:id="@+id/ard_remark_divider"
                    android:background="#ffe2e8ed"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp15"/>
            </LinearLayout>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/ard_bill_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_show_img="false"
                app:ctai_title="Payment Type"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/ard_item_payment_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_title="Payment Method"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ard_order_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ard_posted_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/ard_create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp25"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorError"
                android:id="@+id/ard_hint_tv"
                android:paddingLeft="@dimen/dp15"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp11"
                android:text=""/>
            <LinearLayout
                android:id="@+id/itemReport"
                android:background="@color/ppColorBackgroundLight"
                android:paddingTop="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.core.viewmodel.ReportTransactionItem
                    android:id="@+id/common_report_item"
                    android:background="@color/ppColorBackgroundLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <include
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_contact_service"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
