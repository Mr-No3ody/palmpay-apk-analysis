<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:paddingLeft="@dimen/dp8"
    android:paddingTop="@dimen/dp6"
    android:paddingRight="@dimen/dp8"
    android:paddingBottom="@dimen/dp6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp8"
    android:paddingVertical="@dimen/dp6">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/period_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_loan_period"
            style="@style/Text.6f7b85.10"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cv_flexi_cash_base_color"
            android:id="@+id/loan_period_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/fee_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_service_fee"
            style="@style/Text.6f7b85.10"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cv_flexi_cash_base_color"
            android:id="@+id/service_fee_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/interest_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_interest"
            style="@style/Text.6f7b85.10"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/interest_sub_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cv_flexi_cash_base_color"
                android:id="@+id/interest_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="@dimen/dp2"/>
            <TextView
                android:id="@+id/interest_text_before"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.6f7b85.10"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/stamp_duty_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/tv_stamp_duty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_stamp_duty_title"
            android:drawablePadding="@dimen/dp1"
            android:drawableEnd="@drawable/cs_cl_info_icon"
            style="@style/Text.6f7b85.10"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cv_flexi_cash_base_color"
            android:id="@+id/stamp_duty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
