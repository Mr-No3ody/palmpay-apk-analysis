<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/ct_add_new_fave"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:paddingBottom="@dimen/dp12"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16">
                <TextView
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/ct_nickname"
                    style="@style/Text.202046.12"/>
                <EditText
                    android:textSize="@dimen/dp16"
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:id="@+id/editName"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:hint="@string/ct_unique_nickname"
                    style="@style/Text.202046.14"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp5"/>
                <com.transsnet.palmpay.core.viewmodel.ModelEnterPhoneNumber1
                    android:id="@+id/inputMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/ct_link_faves"
                    style="@style/Text.202046.12"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/viewRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:dividerDrawable="@drawable/ct_shape_relationship_divider"
                    app:flexWrap="wrap"
                    app:showDivider="middle"/>
                <TextView
                    android:layout_marginTop="@dimen/dp32"
                    android:text="@string/ct_add_note_optional"
                    style="@style/Text.202046.12"/>
                <EditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:id="@+id/editRemark"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:hint="@string/ct_add_note_hint"
                    style="@style/Text.202046.14"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/tvSubmit"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cv_default_button_height"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/core_submit"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
