<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_operator"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp60"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_select_operator_icon"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:src="@drawable/cv_coupon_icon_gray"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_select_operator_arrow"
            android:layout_width="@dimen/dp10"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp8"
            app:srcCompat="@drawable/cv_arrow_drop_down_black_8"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
        android:textSize="@dimen/dp22"
        android:textColorHint="@color/ppColorTextDisable"
        android:gravity="center_vertical"
        android:id="@+id/et_phone_number"
        android:background="@color/transparent"
        android:paddingBottom="@dimen/dp2"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp60"
        android:hint="@string/cv_msg_enter_mobile_number"
        android:includeFontPadding="false"
        android:dropDownSelector="@color/transparent"
        android:inputType="number"
        android:textCursorDrawable="@drawable/cv_editor_cursor_purple"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp8"
        android:popupElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier_end"
        app:layout_constraintStart_toEndOf="@+id/ll_operator"
        app:layout_goneMarginStart="0dp"
        style="@style/txt_s_b_b"/>
    <ImageView
        android:id="@+id/iv_clear"
        android:layout_width="@dimen/dp18"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/et_phone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_phone_number"
        app:srcCompat="@drawable/cv_round_clear_gray"/>
    <ImageView
        android:id="@+id/iv_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Addressbook"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_phone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_phone_number"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_contacts,iv_clear"/>
    <ImageView
        android:id="@+id/iv_divider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        app:layout_constraintBottom_toBottomOf="@+id/et_phone_number"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorError"
        android:gravity="start"
        android:id="@+id/tv_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/iv_divider"
        style="@style/Text.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
