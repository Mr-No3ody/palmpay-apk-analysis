<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/flProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.transsnet.palmpay.custom_view.CircleProgressView
            android:id="@+id/progressBar"
            android:layout_width="112dp"
            android:layout_height="112dp"
            app:circleColor="@color/ppColorDividerLine"
            app:currentProgress="0"
            app:maxProgress="3"
            app:progressColor="@color/ppColorPrimary"
            app:progressStrokeWidth="@dimen/dp6"/>
        <TextView
            android:textSize="@dimen/dp28"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp18"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_tier3_pending_title"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flProgress"
        style="@style/Text.medium.202046"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center"
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_tier3_pending_subtitle"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llStepContainer"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">
        <include
            android:id="@+id/stepUpload"
            android:layout_height="@dimen/dp52"
            layout="@layout/ac_item_tier3_loading_step"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <include
            android:id="@+id/stepVerify"
            android:layout_height="@dimen/dp52"
            layout="@layout/ac_item_tier3_loading_step"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <include
            android:id="@+id/stepComplete"
            android:layout_height="@dimen/dp52"
            layout="@layout/ac_item_tier3_loading_step"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
