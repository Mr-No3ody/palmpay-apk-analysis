<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.custom_view.StatusBarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:title_bar_show_right_text_arrow_down="false"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="38dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_title_attention"
            style="@style/txt_l_b"/>
        <TextView
            android:gravity="center"
            android:paddingLeft="0dp"
            android:paddingTop="6dp"
            android:paddingRight="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp25"
            android:layout_marginRight="@dimen/dp25"
            android:text="@string/core_msg_verify_otp_for_risk_control"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginHorizontal="@dimen/dp25"
            style="@style/txt_s_g"/>
        <com.transsnet.palmpay.core.viewmodel.OneTimeCodeView
            android:layout_gravity="center_horizontal"
            android:id="@+id/viewOtc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/securityKeyBoard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_number_keyboard_layout"/>
</FrameLayout>
