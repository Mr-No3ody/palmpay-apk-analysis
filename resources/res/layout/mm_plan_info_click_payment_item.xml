<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matures Into Your"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.9ca2aa.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iconImageInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tvName"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/mm_color_6306b2"
        android:gravity="center"
        android:id="@+id/tvPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ivArrowRight"
        app:layout_constraintEnd_toStartOf="@+id/ivArrowRight"
        app:layout_constraintTop_toTopOf="@+id/ivArrowRight"
        style="@style/Text.858a8f.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivArrowRight"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:iiv_color="@color/mm_color_6306b2"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
