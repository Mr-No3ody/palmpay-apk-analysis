<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="12dp"
        android:src="@drawable/cs_oc_close_icon"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/cs_temporary_amount_bg"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        android:paddingVertical="@dimen/dp12">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#804d00"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Temporary Amount:"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:textColor="#804d00"
            android:id="@+id/temp_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:fontFamily="sans-serif-black"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#ff9900"
            android:gravity="center"
            android:id="@+id/temp_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/cs_icon_temp_amount"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp26"
        android:text="If you use the temporary amount and repay on time, there is a chance"
        android:layout_marginHorizontal="@dimen/dp26"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/cs_main_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginRight="@dimen/dp26"
        android:text="for the amount to double"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp26"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp26"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_confirm"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/cs_main_color"
        android:layout_marginHorizontal="@dimen/dp26"/>
</LinearLayout>
