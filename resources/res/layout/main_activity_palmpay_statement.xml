<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/main_balance_statement"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ppColorDividerLine"
        android:paddingTop="6dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_available_balance"
                style="@style/txt_mi_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/cv_arrow_drop_down"
                android:drawablePadding="2dp"
                android:layout_alignParentEnd="true"
                style="@style/txt_mi_b"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layoutLine2"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_reserved_balance"
                style="@style/txt_mi_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvReserved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                style="@style/txt_mi_b"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layoutLine3"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_frozen_balance"
                style="@style/txt_mi_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvFrozen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                style="@style/txt_mi_b"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layoutLine4"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_current_balance"
                android:fontFamily="sans-serif-medium"
                style="@style/txt_s_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_alignParentEnd="true"
                style="@style/txt_s_b"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:paddingStart="@dimen/large_margin"
        android:paddingEnd="@dimen/extra_margin">
        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:drawableRight="@drawable/cv_arrow_drop_down"
            android:drawablePadding="2dp"
            android:layout_centerVertical="true"
            style="@style/txt_s_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/textViewIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/main_money_in"
                android:drawablePadding="2dp"
                android:layout_marginStart="@dimen/dp2"
                android:layout_marginEnd="@dimen/extra_margin"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/textViewOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/main_money_out"
                android:drawablePadding="2dp"
                android:layout_marginStart="@dimen/dp2"
                android:layout_marginEnd="@dimen/extra_margin"/>
        </LinearLayout>
    </RelativeLayout>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/billList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
