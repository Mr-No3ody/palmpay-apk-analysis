<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            layout="@layout/ac_layout_login_header"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivLogo"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp30"
            android:layout_marginTop="40dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivTitle1"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="@dimen/dp64"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/cv_slogon_text"/>
        <ViewStub
            android:id="@+id/mobileEditViewStub"
            android:layout="@layout/ac_layout_signup_mobile_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"/>
        <FrameLayout
            android:id="@+id/buttonContainer"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin">
            <com.palmpay.lib.ui.button.PpButton
                android:enabled="false"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ac_sign_up"
                style="@style/ppButtonStyle"/>
            <ViewStub
                android:layout_gravity="end|top"
                android:id="@+id/adViewStub"
                android:layout="@layout/ac_layout_common_single_ad_view"
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
        </FrameLayout>
        <ViewStub
            android:id="@+id/invitationStub"
            android:layout="@layout/ac_layout_invitation_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="40dp"
            android:layout_weight="1"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/loginStub"
            android:layout="@layout/ac_layout_sign_up_click_log_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp36"/>
        <ViewStub
            android:gravity="center_vertical"
            android:id="@+id/viewAgreementStub"
            android:layout="@layout/ac_layout_signup_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"/>
        <ViewStub
            android:id="@+id/viewPrivacyStub"
            android:layout="@layout/ac_layout_signup_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="@dimen/dp20"
            android:layout_marginEnd="12dp"
            android:layout_marginHorizontal="24dp"/>
        <ViewStub
            android:layout_gravity="center_horizontal"
            android:id="@+id/viewAllAgreementStub"
            android:layout="@layout/ac_layout_signup_agreement_and_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="@dimen/dp20"
            android:layout_marginHorizontal="32dp"/>
        <ViewStub
            android:id="@+id/bottomStub"
            android:layout="@layout/cv_layout_login_register_bottom_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/securityKeyBoard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_number_keyboard_layout"/>
</FrameLayout>
