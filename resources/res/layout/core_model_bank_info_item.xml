<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbci_root"
    android:background="@drawable/core_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp50"
    android:paddingStart="@dimen/dp15"
    android:paddingEnd="@dimen/dp15">
    <ImageView
        android:id="@+id/mbci_access_bank_iv"
        android:layout_width="@dimen/dp25"
        android:layout_height="@dimen/dp25"
        android:layout_marginTop="@dimen/dp13"
        android:src="@drawable/core_bank_loading_icon"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/mbci_bank_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp15"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/mbci_right_iv"
        android:layout_toRightOf="@+id/mbci_access_bank_iv"
        android:layout_marginStart="@dimen/dp10"
        android:layout_toStartOf="@+id/mbci_right_iv"
        android:layout_toEndOf="@+id/mbci_access_bank_iv"
        style="@style/txt_me_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbci_right_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/small_margin"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Arrowdown"
        app:iiv_size="16dp"/>
    <View
        android:id="@+id/mbci_bottom_line"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/mbci_hint_text_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_toRightOf="@+id/mbci_access_bank_iv"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/cmbii_view_default_card"
        android:visibility="gone"
        android:layout_width="@dimen/dp79"
        android:layout_height="@dimen/dp14"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginTop="@dimen/dp7"
        android:src="@drawable/cv_default_card"
        android:layout_toRightOf="@+id/mbci_access_bank_iv"
        android:layout_below="@+id/mbci_bank_name_tv"/>
</RelativeLayout>
