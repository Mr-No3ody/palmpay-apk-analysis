<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutDeviceHeader"
        android:background="@drawable/cs_mi_daily_card_bg"
        android:padding="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:id="@+id/ivPhoneThumb"
            android:layout_width="24dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp8">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tvDeviceModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/llStatusTag"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_default="wrap"
                    style="@style/Text.202046.12"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llStatusTag"
                    android:background="@drawable/cs_mi_daily_tag_active_bg"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingTop="1dp"
                    android:paddingRight="@dimen/dp4"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="16dp"
                    android:layout_marginStart="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp4"
                    android:paddingVertical="1dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDeviceModel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvDeviceModel"
                    app:layout_constraintTop_toTopOf="@+id/tvDeviceModel">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivStatusTag"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:iiv_color="@color/ppColorSuccess"
                        app:iiv_icon="pay_SelectedFill"
                        app:iiv_size="12dp"/>
                    <TextView
                        android:textColor="@color/ppColorSuccess"
                        android:id="@+id/tvStatusTag"
                        android:text="@string/cs_daily_repay_tag_active"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="2dp"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvActiveUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:maxLines="1"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/llCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tvCdDays"
                    android:background="@drawable/cs_mi_daily_countdown_box"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    style="@style/Text.medium.ffffff.14"/>
                <TextView
                    android:layout_marginTop="2dp"
                    android:text="@string/cs_daily_repay_cd_days"
                    style="@style/Text.202046.10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8">
                <TextView
                    android:id="@+id/tvCdHrs"
                    android:background="@drawable/cs_mi_daily_countdown_box"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    style="@style/Text.medium.ffffff.14"/>
                <TextView
                    android:layout_marginTop="2dp"
                    android:text="@string/cs_daily_repay_cd_hrs"
                    style="@style/Text.202046.10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8">
                <TextView
                    android:id="@+id/tvCdMins"
                    android:background="@drawable/cs_mi_daily_countdown_box"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    style="@style/Text.medium.ffffff.14"/>
                <TextView
                    android:layout_marginTop="2dp"
                    android:text="@string/cs_daily_repay_cd_mins"
                    style="@style/Text.202046.10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8">
                <TextView
                    android:id="@+id/tvCdSecs"
                    android:background="@drawable/cs_mi_daily_countdown_box"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    style="@style/Text.medium.ffffff.14"/>
                <TextView
                    android:layout_marginTop="2dp"
                    android:text="@string/cs_daily_repay_cd_secs"
                    style="@style/Text.202046.10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/llLockedDays"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/ppColorError"
                android:id="@+id/tvLockedDays"
                style="@style/Text.medium.9ca2aa.16"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:id="@+id/tvLockedDaysSubtitle"
                android:text="@string/cs_daily_repay_tag_locked"
                style="@style/Text.202046.12"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layoutPaymentCard"
        android:background="@drawable/cs_mi_daily_card_bg"
        android:padding="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/dotPaymentTitle"
                android:background="@drawable/cs_mi_daily_repay_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvNextPaymentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_daily_repay_next_payment"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.202046.14"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/tvNextPaymentAmount"
            android:layout_marginTop="@dimen/dp4"
            android:fontFamily="@font/lib_ui_number_bold"
            style="@style/Text.medium.202046.36"/>
        <ProgressBar
            android:id="@+id/pbPaidProgress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/dp16"
            android:max="100"
            android:progress="30"
            android:secondaryProgress="45"
            android:progressDrawable="@drawable/cs_mi_daily_repay_progress"
            style="?android:attr/progressBarStyleHorizontal"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8">
            <View
                android:id="@+id/dotTotalPaid"
                android:background="@drawable/cs_mi_daily_repay_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:backgroundTint="@color/ppColorPrimary"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tvTotalPaid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.9ca2aa.12"/>
            <View
                android:id="@+id/dotBalance"
                android:background="@drawable/cs_mi_daily_repay_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:backgroundTint="@color/ppColorSecondary"/>
            <TextView
                android:id="@+id/tvBalance"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.9ca2aa.12"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/flTipAndRepay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llUnlockTip"
                android:background="@drawable/cs_mi_daily_tip_banner_bg"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp12">
                <TextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvUnlockTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.medium.202046.12"/>
                <ImageView
                    android:id="@+id/ivUnlockTip"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/cs_phone_unlock_fill"
                    android:alpha="0.45"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/cv_color_ffffff"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:id="@+id/btnDailyRepay"
                android:background="@drawable/lib_ui_button_bg_corner_primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/cs_daily_repay_repay_now"
                style="@style/Text.medium.ffffff.16"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDailyRepaymentHistory"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:paddingVertical="@dimen/dp2">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvDailyRepaymentHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_daily_repay_history_entry"
                style="@style/Text.6306b2.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDailyRepaymentHistoryArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="16dp"/>
        </LinearLayout>
    </LinearLayout>
</merge>
