<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/receive_money_container"
        android:background="@drawable/cv_shape_rect_bl_br_corner_white_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="30dp"
                android:textColor="#ff263138"
                android:id="@+id/receive_money_num"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ff6f7b85"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/receive_money_remark"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/receive_money_qrcode"
                android:background="@drawable/main_rm_qrcode_img_bg"
                android:padding="25dp"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_marginTop="6dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ff95a1ab"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:text="@string/main_qrcode_collect_desc_text"/>
        </LinearLayout>
        <View
            android:background="#ffe2e8ed"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/set_money"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/main_set_amount_text"
                android:layout_weight="1"/>
            <View
                android:background="#ffe2e8ed"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/save_qrcode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/main_save_qrcode_text"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
