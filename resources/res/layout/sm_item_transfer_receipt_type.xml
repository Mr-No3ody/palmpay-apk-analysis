<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_receipt_type"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp60"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_check"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sm_ic_receipt_check"
        android:layout_alignTop="@+id/iv_receipt_type"
        android:layout_alignBottom="@+id/iv_receipt_type"
        android:layout_alignStart="@+id/iv_receipt_type"
        android:layout_alignEnd="@+id/iv_receipt_type"/>
</RelativeLayout>
