<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/p2p_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/p2p_str_booking_notes"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_agent_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ppColorBackgroundLight"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/p2p_agent_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/p2p_theme_color"
                        android:id="@+id/p2p_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:text="@string/p2p_str_change"
                        app:layout_constraintBottom_toBottomOf="@+id/p2p_agent_name"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/p2p_agent_name"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/p2p_agent_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="48dp"
                        android:lineSpacingMultiplier="1.2"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/p2p_agent_name"/>
                    <TextView
                        android:id="@+id/p2p_agent_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/p2p_agent_address"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PInputAmountView
                android:id="@+id/p2p_input"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_appointment_container"
                app:layout_goneMarginTop="0dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/p2p_note_switch_module"
                android:background="@color/ppColorBackgroundLight"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/p2p_switch"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:thumb="@drawable/cv_switch_thumb"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginRight="16dp"
                    app:switchMinWidth="36dp"
                    app:track="@drawable/cv_switch_track"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/p2p_str_i_want_to_book_new_notes"
                    app:layout_constraintBottom_toBottomOf="@+id/p2p_switch"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/p2p_switch"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/p2p_switch_info"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/p2p_str_switch_info_"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_switch"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PButton
                android:id="@+id/p2p_next"
                android:paddingLeft="16dp"
                android:paddingTop="24dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:p2p_btn_name="@string/p2p_book_now"
                app:p2p_btn_status="disable"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/p2p_about_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/p2p_str_about"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/p2p_about_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="3dp"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_icon="pay_InformationOutline"
                    app:iiv_size="14dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#6f7b85"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/p2p_str_about_string"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
