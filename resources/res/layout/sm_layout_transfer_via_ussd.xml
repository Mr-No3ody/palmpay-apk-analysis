<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp58"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_transfer_via_ussd"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/sm_ic_transfer_via_ussd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_transfer_via_ussd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sm_transfer_via_ussd"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintStart_toEndOf="@+id/iv_transfer_via_ussd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:id="@+id/tv_transfer_via_ussd_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sm_currently_no_network"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintStart_toEndOf="@+id/iv_transfer_via_ussd"
        app:layout_constraintTop_toBottomOf="@+id/tv_transfer_via_ussd"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:id="@+id/tv_dial"
        android:background="@drawable/cv_shape_round_corner_primary"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_dial"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
