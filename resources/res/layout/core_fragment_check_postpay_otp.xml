<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.core.viewmodel.ModelPageTitleAreaInPayVerifyPage
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cta_back_iv_iconfont="pay_Close"
        app:cta_content_text="@string/core_confirm_post_otp"
        app:cta_title="@string/core_verification"/>
    <com.transsnet.palmpay.custom_view.model.ModelSendSms
        android:id="@+id/tvSendSms"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_te_title="@string/core_otp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_bank_account_tev"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_otp_will_send_2"
        android:drawablePadding="4dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:iiv_end_color="@color/ppColorTextNormal"
        app:iiv_end_icon="pay_InformationOutline"
        app:iiv_end_size="@dimen/dp12"
        style="@style/txt_mi_lg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorError"
        android:id="@+id/tvError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_invalidate_otp_tips"
        android:drawableEnd="@drawable/cv_warning"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"/>
    <TextView
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:text="@string/core_next"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/txt_b_w"/>
</LinearLayout>
