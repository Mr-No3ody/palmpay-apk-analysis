<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/contact_action_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:columnCount="4"
    app:rowCount="1">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/send_money_tv"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_columnWeight="1">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_send_money_icon"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ct_send_money"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/request_money_tv"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        app:layout_columnWeight="1">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_request_money_icon"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/ct_request_money"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/airtime_tv"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        app:layout_columnWeight="1">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_top_up_airtime"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/ct_top_up_airtime"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/data_bundles_tv"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        app:layout_columnWeight="1">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_buy_bundle"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/ct_buy_data_bundles"/>
    </LinearLayout>
</GridLayout>
