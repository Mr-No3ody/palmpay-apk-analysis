<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/selected_date_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp16">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_16_bg_white"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp16">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_choose_your_repayment_date"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="@dimen/dp26">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/first_date_ll"
                        android:background="@drawable/cs_oc_repayment_date_unselect_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp20">
                        <TextView
                            android:textSize="28sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/first_repayment_date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/first_month_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_of_each_month"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/ppColorTextBase"
                        android:layout_gravity="end"
                        android:id="@+id/first_recommend_tv"
                        android:background="@drawable/cs_oc_recommend_label_bg"
                        android:padding="@dimen/dp2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:text="@string/cs_oc_recommend"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_or"
                    android:layout_marginEnd="@dimen/dp20"/>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/second_date_ll"
                        android:background="@drawable/cs_oc_repayment_date_unselect_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp26">
                        <TextView
                            android:textSize="28sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/second_repayment_date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/second_month_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_of_each_month"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/ppColorTextBase"
                        android:layout_gravity="end"
                        android:id="@+id/second_recommend_tv"
                        android:background="@drawable/cs_oc_recommend_label_bg"
                        android:padding="@dimen/dp2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:text="@string/cs_oc_recommend"
                        android:layout_marginEnd="@dimen/dp8"/>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#6f7b85"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_oc_once_confirmed_date"
                android:layout_marginHorizontal="@dimen/dp16"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_oc_imperial_crown"
            android:layout_marginEnd="@dimen/dp2"/>
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/bottom_change_date_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cs_oc_changed_once_a_year"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/change_date_bt"
        android:background="@drawable/cs_oc_primary_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/cs_oc_upgrade_change_now"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
