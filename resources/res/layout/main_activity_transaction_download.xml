<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/main_download_statement"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp24">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp18"
            android:text="@string/main_enter_your_email"
            style="@style/txt_b_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/main_down_load_remark"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="@dimen/dp24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/cv_shape_rect_corner_8_bg_white"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp12">
            <EditText
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:textColorHint="@color/ppColorTextAssist"
                android:id="@+id/editMail"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:hint="@string/main_enter_your_email"
                android:layout_weight="1"
                android:inputType="textEmailAddress"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDelete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="20dp"/>
        </LinearLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_submit"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
</LinearLayout>
