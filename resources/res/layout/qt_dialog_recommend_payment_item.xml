<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/ivClose"
                android:paddingTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cv_close_grey"/>
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qt_recommendation"/>
            <TextView
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qt_msg_recommend_similar_plan"
                style="@style/txt_s_g"/>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ppColorBackgroundDark"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                style="@style/CardView">
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="19dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_biller_name_with_colon"/>
                    <TextView
                        android:textSize="15dp"
                        android:gravity="center_vertical"
                        android:id="@+id/tvBillerName"
                        android:paddingTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center_vertical"
                        android:paddingTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_plan_with_colon"/>
                    <TextView
                        android:textSize="15dp"
                        android:gravity="center_vertical"
                        android:id="@+id/tvPaymentName"
                        android:paddingTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center_vertical"
                        android:paddingTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qt_amount_with_colon"/>
                    <TextView
                        android:textSize="15dp"
                        android:gravity="center_vertical"
                        android:id="@+id/tvAmount"
                        android:paddingTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/txt_s_b"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvConfirm"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:layout_width="200dp"
                android:layout_height="45dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:text="@string/core_confirm"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
