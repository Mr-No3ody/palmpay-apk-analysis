<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/acr_root"
    android:background="@color/transparent_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsnet.palmpay.custom_view.CoinRainNewView
        android:id="@+id/viewCoinRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp90"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/md_white_1000"
        android:id="@+id/acr_time_remain"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTitle"/>
    <TextView
        android:textSize="@dimen/dp100"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:id="@+id/tvCountDown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivFinger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/main_coin_rain_finger_icon"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCountDown"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/acr_countDownArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivPreview,tvCountDown,ivFinger"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/md_white_1000"
        android:gravity="center_vertical"
        android:id="@+id/tvCount"
        android:background="@drawable/cv_shape_halfround_77000000"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/main_cake_number_0"
        android:layout_marginStart="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:id="@+id/tvSkip"
        android:background="@drawable/cv_shape_halfround_77000000"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/core_skip"
        android:layout_marginEnd="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
