<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp45">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ciar_amount_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_amount"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ciar_fee_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
