<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/sm_pay_me"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/sm_receive_money_via_transfer"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_b_b_b"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_transaction_history"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:text="@string/core_transaction_history"
                    android:drawablePadding="@dimen/dp10"
                    android:paddingHorizontal="12dp"
                    app:iiv_end_color="@color/ppColorTextPrimary"
                    app:iiv_end_icon="pay_ArrowRight"
                    app:iiv_end_size="@dimen/dp16"
                    app:iiv_start_color="@color/ppColorTextPrimary"
                    app:iiv_start_icon="pay_TransactionHistory"
                    app:iiv_start_size="@dimen/dp26"
                    style="@style/txt_s_b"/>
                <View
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/core_divider_horizontal"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_merchant_service"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_merchant_service"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp50"
                        android:text="@string/sm_merchant_service"
                        android:drawablePadding="@dimen/dp10"
                        android:drawableStart="@drawable/sm_pay_me_merchant_service"
                        android:drawableTint="@color/ppColorTextPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_b"/>
                    <ImageView
                        android:id="@+id/iv_cash_back"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp24"
                        android:layout_marginStart="6dp"
                        app:iiv_end_color="@color/ppColorTextPrimary"
                        app:iiv_end_icon="pay_ArrowRight"
                        app:iiv_end_size="@dimen/dp16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/core_divider_horizontal"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_voice_notify"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50">
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/sm_voice_notify"
                        android:drawablePadding="@dimen/dp10"
                        android:layout_weight="1"
                        android:paddingHorizontal="12dp"
                        app:iiv_start_color="@color/ppColorTextPrimary"
                        app:iiv_start_icon="pay_NotificationOutline"
                        app:iiv_start_size="@dimen/dp24"
                        style="@style/txt_s_b"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sm_checkbox_unselect"
                        android:layout_marginEnd="@dimen/dp10"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/ad_merchant"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:slot_id="@string/pay_me_home_bottom_banner"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
