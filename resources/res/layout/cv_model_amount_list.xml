<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_amount"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp45"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_fee"
        android:paddingTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp45"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"
        app:cv_tt_show_bottom_line="true"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_vat"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_discount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp45"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"
        app:cv_tt_show_bottom_line="true"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_coupon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp45"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"
        app:cv_tt_show_bottom_line="true"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_point_used"
        android:paddingTop="@dimen/dp7"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp33"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"
        app:cv_tt_show_bottom_line="false"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_point_earn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_data_bonus_used"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_data_bonus_earn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_cash_back"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_pay_shop_coupon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem1
        android:id="@+id/cmal_total"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp45"
        android:layout_marginLeft="@dimen/dp40"
        android:layout_marginRight="@dimen/dp15"
        app:cv_tt_show_bottom_line="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/extra_item_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="@dimen/dp15">
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:id="@+id/entidade_tv"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:id="@+id/referencia_tv"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:id="@+id/montante_tv"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:id="@+id/data_limite_tv"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/cmal_bottom_divider"
        android:background="#ffe2e8ed"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginRight="@dimen/dp15"/>
</LinearLayout>
