<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/ac_set_pin"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv2"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:padding="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
        android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
        android:text="@string/ac_msg_set_your_pin"
        android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/ac_set_pin"
        android:layout_marginStart="20dp"
        style="@style/txt_s_b"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="start"
        android:id="@+id/pinView1"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="0dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="44dp"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="10dp"
        app:digitStrokeColor="@color/ac_pay_grey_1"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="24dp"
        app:digitWidth="44dp"
        app:leftMargin="0dp"
        app:mask="●"
        app:pinInputType="number"
        app:showHideButton="true"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/ac_confirm_pin"
        android:layout_marginStart="20dp"
        style="@style/txt_s_b"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="start"
        android:id="@+id/pinView2"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="0dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="44dp"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="10dp"
        app:digitStrokeColor="@color/ac_pay_grey_1"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="24dp"
        app:digitWidth="44dp"
        app:leftMargin="0dp"
        app:mask="●"
        app:pinInputType="number"
        app:showHideButton="true"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="20dp"
        android:text="No repeated numbers (1111,1122)\10No consecutive numbers (1234,4321)\10No consecutive repeated numbers (1212)"
        android:layout_marginHorizontal="20dp"
        style="@style/txt_mi_g"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="20dp"
        android:text="@string/ac_next"
        android:layout_marginHorizontal="20dp"
        style="@style/ppButtonStyle"/>
</LinearLayout>
