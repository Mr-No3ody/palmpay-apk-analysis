<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
    android:paddingLeft="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64">
    <ImageView
        android:id="@+id/ivProductIcon"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:src="@drawable/cv_fixed_saving"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvProductName"
        android:layout_marginLeft="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/tvProductIncreaseUp"
        app:layout_constraintLeft_toRightOf="@+id/ivProductIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:id="@+id/tvProductIncreaseUp"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tvProductName"
        app:layout_constraintTop_toBottomOf="@+id/tvProductName"
        style="@style/Text.858a8f.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvSave"
        android:layout_width="@dimen/dp54"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        app:rtv_corner_radius="@dimen/dp20"
        style="@style/Text.medium.ffffff.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
