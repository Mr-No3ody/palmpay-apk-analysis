<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/viewNotice"
        android:background="@color/ppColorSecondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/cv_notify_icon"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintTop_toTopOf="parent"
        app:slot_id="@string/ad_withdraw_from_agent_text_slot_id"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_search"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/viewNotice">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ci_to_get_cash"
            style="@style/txt_mi_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingTop="@dimen/dp5"
            android:paddingBottom="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginBottom="@dimen/dp8"
            android:layout_marginVertical="@dimen/dp8"
            android:paddingVertical="@dimen/dp5">
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/tv_account_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ci_digit_enter_number"
                android:layout_weight="1"
                style="@style/txt_b_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Scan"
                app:iiv_size="20dp"/>
        </LinearLayout>
        <View
            android:id="@+id/v_line"
            android:visibility="gone"
            style="@style/core_divider_horizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/ll_nearest"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ci_nearest"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.14"/>
            <TextView
                android:id="@+id/tvMore"
                android:text="@string/core_more"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTitle"
                style="@style/Text.202046.12"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_nearest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_recently"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ci_recently"
                style="@style/Text.medium.202046.14"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentLyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ll_search">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMenuList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_location_permission"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp54"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp18"
        android:backgroundTint="@color/transparent_46"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/tv_remark1"
            android:paddingTop="@dimen/dp7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ci_no_location_detected"
            style="@style/txt_s_w"/>
        <TextView
            android:textColor="@color/cv_color_ffffff"
            android:paddingTop="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ci_turn_on_to_access"
            app:layout_constraintTop_toBottomOf="@+id/tv_remark1"
            style="@style/txt_mi_w"/>
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp36"
            app:cardBackgroundColor="@color/ppColorSuccess"
            app:cardCornerRadius="@dimen/dp28"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:id="@+id/iv_turn_on"
                android:layout_width="@dimen/dp67"
                android:layout_height="26dp"
                android:text="Turn On"
                style="@style/txt_mi_w_b"/>
        </androidx.cardview.widget.CardView>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_close"
            android:paddingLeft="@dimen/dp10"
            android:paddingTop="@dimen/dp3"
            android:paddingRight="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp10"
            app:iiv_color="@color/ppColorTextBase"
            app:iiv_icon="pay_Close"
            app:iiv_size="18dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
