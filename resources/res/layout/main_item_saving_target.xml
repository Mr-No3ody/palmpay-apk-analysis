<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:padding="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp10">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        app:layout_constraintLeft_toRightOf="@+id/ivPic"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintBottom_toBottomOf="@+id/ivPic"
        app:layout_constraintEnd_toEndOf="@+id/rtvGet"
        app:layout_constraintLeft_toRightOf="@+id/ivPic"
        app:layout_constraintRight_toLeftOf="@+id/rtvGet"
        app:layout_constraintStart_toEndOf="@+id/ivPic"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.9ca2aa.12"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="12dp"
        android:textColor="@color/cv_color_ffffff"
        android:gravity="center"
        android:id="@+id/rtvGet"
        android:layout_width="50dp"
        android:layout_height="@dimen/dp24"
        android:text="Create"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        style="@style/Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
