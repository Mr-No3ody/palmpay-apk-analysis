<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv1"
        android:text="Savings services are provided by"
        android:drawablePadding="@dimen/dp4"
        app:layout_constraintEnd_toStartOf="@+id/tv2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.979797.10"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="right"
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:text="Flexi MFB"
        android:drawablePadding="@dimen/dp2"
        android:layout_marginHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv3"
        app:layout_constraintStart_toEndOf="@+id/tv1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.979797.10"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv3"
        android:visibility="gone"
        android:text="Ltd"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toRightOf="@+id/tv2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.979797.10"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/fundGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:barrierDirection="right"
        app:constraint_referenced_ids="tvFund1,tvFund2"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tvFund1"
        android:text="Mutual Funds services are provided by"
        app:layout_constraintBottom_toBottomOf="@+id/tvFund2"
        app:layout_constraintEnd_toStartOf="@+id/tvFund2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFund2"
        style="@style/Text.979797.10"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="right"
        android:id="@+id/tvFund2"
        android:layout_width="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:text="TAML"
        android:layout_marginHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvFund3"
        app:layout_constraintStart_toEndOf="@+id/tvFund1"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/Text.979797.10"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tvFund3"
        android:visibility="gone"
        android:text="Ltd"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvFund2"
        app:layout_constraintLeft_toRightOf="@+id/tvFund2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFund2"
        style="@style/Text.979797.10"/>
    <View
        android:background="@color/ppColorTextDisable"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv1"
        app:layout_constraintRight_toRightOf="@+id/tv2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
