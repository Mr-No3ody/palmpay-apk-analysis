<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Flexi Cash application"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp77"
        android:src="@drawable/cs_cl_oc_bill_img"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="Sorry, Flexi Cash is temporarily unavailable."
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp54"
        android:text="Repay and unlock Flexi Cash now"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/oc_bill_view"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <ImageView
            android:id="@+id/csImageview12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/cs_cl_oc_bill_item_logo"/>
        <ImageView
            android:id="@+id/csImageview6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cs_oc_small_icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/csTextview71"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_overdraft"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/csImageview6"
            app:layout_constraintStart_toEndOf="@+id/csImageview6"
            app:layout_constraintTop_toTopOf="@+id/csImageview6"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#858a8f"
            android:id="@+id/oc_due_date_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due on 16 Feb"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview71"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/csTextview71"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cs_oc_overdue_txt_color"
            android:id="@+id/oc_overdue_days_tv"
            android:background="@drawable/cs_oc_all_bill_overdue_txt_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="3 days overdue"
            android:paddingStart="@dimen/dp3"
            android:paddingEnd="@dimen/dp3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/oc_outstanding_amount_tv"
            app:layout_constraintTop_toBottomOf="@+id/oc_outstanding_amount_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/csTextview106"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Outstanding amount"
            app:layout_constraintStart_toStartOf="@+id/csImageview6"
            app:layout_constraintTop_toBottomOf="@+id/csImageview6"/>
        <TextView
            android:textSize="@dimen/dp24"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/oc_outstanding_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="@+id/csTextview106"
            app:layout_constraintTop_toBottomOf="@+id/csTextview106"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/oc_repay_bt"
            android:background="@drawable/cv_shape_rect_corner_8_bg_primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp28"
            android:text="Repay"
            android:textAllCaps="false"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/oc_outstanding_amount_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/oc_outstanding_amount_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
