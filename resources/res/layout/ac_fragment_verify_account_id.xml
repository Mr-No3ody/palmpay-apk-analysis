<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/ac_identity_verification"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:paddingLeft="@dimen/large_margin"
        android:paddingRight="@dimen/large_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To confirm this is your account, kindly fill in your NIN Number"
        android:paddingHorizontal="@dimen/large_margin"
        style="@style/txt_s_g"/>
    <FrameLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cv_default_horizontal_margin"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/cv_default_horizontal_margin"
        android:layout_marginHorizontal="@dimen/cv_default_horizontal_margin">
        <com.palmpay.lib.ui.form.PpFormVertical
            android:id="@+id/inputIdNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:form_edit_input_type="number"
            app:form_edit_max_length="11"
            app:form_layout_background="@color/transparent"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvForgotBvn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        style="@style/txt_mi_g"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/cv_default_horizontal_margin"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/cv_default_horizontal_margin"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/cv_default_horizontal_margin"
        style="@style/ppButtonStyle"/>
</LinearLayout>
