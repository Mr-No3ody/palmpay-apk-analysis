<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/cs_oc_repayment_information"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Repayment Dates"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp32"
        android:paddingTop="@dimen/dp22"
        android:paddingRight="@dimen/dp32"
        android:paddingBottom="@dimen/dp22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp32"
        android:paddingVertical="@dimen/dp22">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/cs_oc_repayment_date_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/cs_main_color"
                android:id="@+id/first_repayment_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cs_main_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_of_each_month"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextDisable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/cs_oc_and"
            android:layout_marginHorizontal="@dimen/dp12"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/cs_oc_repayment_date_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/cs_main_color"
                android:id="@+id/second_repayment_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cs_main_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_of_each_month"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Billing period"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_up_to_start"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" 16 days"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:text="Two billing periods in each month.\10The first period would be 1st - 15th of the month and the second period would be 16th - the end of the month."/>
    </LinearLayout>
</LinearLayout>
