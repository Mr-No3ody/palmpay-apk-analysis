<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_photo_guide_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cs_oc_router_top_bar"/>
    <ImageView
        android:id="@+id/csImageview34"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/router_progress_view"
        app:srcCompat="@drawable/cs_cl_take_photo_img"/>
    <com.transsnet.palmpay.credit.view.OpenAccountRouterProgressViewV2
        android:id="@+id/router_progress_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oc_photo_guide_top_bar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/csTextview116"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_cl_photo_guide"
        android:layout_marginStart="@dimen/dp30"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csTextview126"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/csTextview122"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/cs_cl_take_photo_ring"
        android:layout_marginStart="@dimen/dp48"
        app:layout_constraintEnd_toStartOf="@+id/csTextview124"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/csTextview124"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#646970"
        android:id="@+id/csTextview124"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_cl_front_photo"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/csTextview122"
        app:layout_constraintTop_toBottomOf="@+id/take_photo_guide_img"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/cs_main_color"
        android:id="@+id/csTextview125"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="5dp"
        android:text="@string/cs_cl_take_photo_ring"
        app:layout_constraintStart_toStartOf="@+id/csTextview122"
        app:layout_constraintTop_toTopOf="@+id/csTextview126"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#646970"
        android:id="@+id/csTextview126"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cs_cl_can_not_wear_glasses"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="@+id/csTextview124"
        app:layout_constraintStart_toEndOf="@+id/csTextview125"
        app:layout_constraintTop_toBottomOf="@+id/csTextview124"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cs_cl_take_photo_proto_txt_color"
        android:id="@+id/take_photo_proto_tv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/take_photo_guide_img"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_take_selfie_now"
        android:textAllCaps="false"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csImageview34"
        app:srcCompat="@drawable/cs_cl_take_photo_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/bottom_txt_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/cs_oc_common_bottom_txt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
