<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/ac_main_manage_device"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ac_device_remark"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deviceList"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/textViewEdit"
            android:layout_width="match_parent"
            android:text="@string/ac_edit"
            style="@style/ppButtonStyle"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/textViewComplete"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:text="@string/ac_complete"
            style="@style/ppSecondaryButtonStyle"/>
    </FrameLayout>
</LinearLayout>
