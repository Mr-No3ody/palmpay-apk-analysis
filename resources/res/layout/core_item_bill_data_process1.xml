<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cib_root"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cib_check_iv"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp4"
        android:src="@drawable/cv_check_purple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cib_line_left"
        android:background="@color/ppColorPrimary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/cib_check_iv"
        app:layout_constraintEnd_toStartOf="@+id/cib_check_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cib_check_iv"/>
    <View
        android:id="@+id/cib_line_right"
        android:background="@color/ppColorPrimary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/cib_check_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cib_check_iv"
        app:layout_constraintTop_toTopOf="@+id/cib_check_iv"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_horizontal"
        android:id="@+id/cib_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cib_check_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
