<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iiv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:text="@string/sm_bill_detail_cybersecurity_fee"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_based_on_cbn_s_cybercrimes_act"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Text.6f7b85.14"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_bg_info,cl_info"/>
    <View
        android:id="@+id/iv_bg_info"
        android:background="@drawable/cv_shape_rectangle_gradient_transparent_disabled_transparent"
        android:layout_width="328dp"
        android:layout_height="@dimen/dp94"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_info"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_info">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:src="@drawable/cv_palmpay_icon_circle_purple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp180"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.14"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tv_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            style="@style/Text.medium.202046.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_send_to_palmpay_account"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/iv_bg_info"
        style="@style/Text.medium.ffffff.16"/>
    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_send_via_bank_transfers_anyway"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_confirm"
        style="@style/Text.6f7b85.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
