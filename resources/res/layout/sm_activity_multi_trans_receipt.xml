<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/fl_share_receipt_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_below="@+id/title_bar"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/sm_transfer_ticket"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rv_receipt_type"
        android:layout_below="@+id/title_bar">
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/fl_receipt_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp16"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_receipt_type"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginTop="@dimen/dp18"
        android:layout_marginBottom="@dimen/dp18"
        android:layout_above="@+id/bottomView"
        android:layout_marginVertical="@dimen/dp18"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bottomView"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_alignParentBottom="true">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="14dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/shareTv"
            android:paddingLeft="@dimen/dp20"
            android:paddingRight="@dimen/dp20"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sm_share_as_image"
            android:drawablePadding="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp20"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_Share"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toStartOf="@+id/saveTv"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="14dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/saveTv"
            android:paddingLeft="@dimen/dp20"
            android:paddingRight="@dimen/dp20"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sm_save_as_pdf"
            android:drawablePadding="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp20"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_download"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/shareTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
