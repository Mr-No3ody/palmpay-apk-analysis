<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/layoutContent"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/viewBottompAd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/topSpace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivInstallmentLoan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvInstallmentLoan"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInstallmentLoan"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvInstallmentLoan"
            android:layout_marginLeft="@dimen/dp6"
            android:text="@string/cs_cl_installment_loan"
            app:layout_constraintLeft_toRightOf="@+id/ivInstallmentLoan"
            app:layout_constraintTop_toBottomOf="@+id/topSpace"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvRightTag"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="@+id/tvInstallmentLoan"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInstallmentLoan"
            style="@style/Text.202046.12"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmountTitle"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_loan_amount"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInstallmentLoan"
            style="@style/Text.202046.12"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="@color/ppColorError"
            android:id="@+id/rtvFrozen"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:layout_marginLeft="@dimen/dp4"
            android:text="@string/cs_frozen"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"
            app:rtv_background_color="@color/transparent"
            app:rtv_border_color="@color/ppColorError"
            app:rtv_border_width="@dimen/dp1"
            app:rtv_corner_radius="@dimen/dp4"
            style="@style/Text.ffffff.10"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodTitle"
            android:layout_marginRight="@dimen/dp36"
            android:text="@string/cs_loan_period"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"
            style="@style/Text.202046.12"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="@+id/tvLoanPeriodTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodDays"
            android:layout_marginLeft="@dimen/dp3"
            android:layout_marginTop="@dimen/dp6"
            android:text="Days"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvLoanPeriod"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanPeriod"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/cv_color_906948"
            android:id="@+id/tvDailyInterest"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.medium.202046.12"/>
        <TextView
            android:id="@+id/tvFrozenReason"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.202046.12"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupOpened"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvLoanableAmountTitle,tvLoanableAmount,tvLoanPeriodTitle,tvLoanPeriod,tvLoanPeriodDays,tvDailyInterest"/>
        <TextView
            android:id="@+id/tvUnOpenedLoanableAmountTitle"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInstallmentLoan"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:textSize="@dimen/dp28"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvUnOpenedLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUnOpenedLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:id="@+id/tvUnOpenedRight"
            android:layout_marginLeft="@dimen/dp1"
            app:layout_constraintLeft_toRightOf="@+id/tvUnOpenedLoanableAmount"
            app:layout_constraintTop_toTopOf="@+id/tvUnOpenedLoanableAmount"
            style="@style/Text.202046.10"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnOpened"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/tvUnOpenedLoanableAmount"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupUnOpened"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvUnOpenedLoanableAmountTitle,tvUnOpenedLoanableAmount,tvUnOpenedRight,rvUnOpened"/>
        <TextView
            android:id="@+id/tvConfinementPeriodContent"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUnOpenedLoanableAmount"
            style="@style/Text.202046.14"/>
        <TextView
            android:id="@+id/tvConfinementPeriodSubContent"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvConfinementPeriodContent"
            style="@style/Text.202046.14"/>
        <ImageView
            android:id="@+id/ivCalendar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dp4"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tvReapplyDate"
            app:layout_constraintTop_toBottomOf="@+id/tvConfinementPeriodSubContent"/>
        <TextView
            android:textColor="@color/ppColorWarning"
            android:id="@+id/tvReapplyDate"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCalendar"
            app:layout_constraintLeft_toRightOf="@+id/ivCalendar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCalendar"
            style="@style/Text.medium.202046.20"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupConfinementPeriod"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvConfinementPeriodContent,tvConfinementPeriodSubContent,ivCalendar,tvReapplyDate"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvDailyInterest,rvUnOpened"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/viewTopAd"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <View
            android:id="@+id/viewEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/viewTopAd"
            app:layout_constraintTop_toTopOf="@+id/rtvBorrow"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textColor="@color/cs_borrow_text_color"
            android:id="@+id/rtvBorrow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp27"
            android:text="@string/cs_cl_borrow"
            app:layout_constraintTop_toTopOf="@+id/viewTopAd"
            app:layout_constraintVertical_bias="0.1"
            app:layout_goneMarginTop="@dimen/dp12"
            app:rtv_background_color="@color/cs_cash_main_borrow_background_color"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/ppButtonStyle"/>
        <com.mikepenz.iconics.view.IconicsCheckBox
            android:id="@+id/checkAgreement"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:checked="true"
            app:iiv_checked_color="@color/cs_main_color"
            app:iiv_checked_icon="pay_CheckboxFill"
            app:iiv_checked_size="16dp"
            app:iiv_unchecked_color="@color/cs_main_color"
            app:iiv_unchecked_icon="pay_CheckboxOutline"
            app:iiv_unchecked_size="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rtvBorrow"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvApplicationAgreement"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkAgreement"
            app:layout_constraintTop_toBottomOf="@+id/rtvBorrow"
            style="@style/Text.202046.12"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutBottom"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/rvUnOpened">
            <ImageView
                android:id="@+id/ivLeftIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/ppColorWarning"
                android:gravity="left"
                android:id="@+id/tvMiddleContent"
                android:layout_width="0dp"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_weight="1"
                style="@style/Text.202046.14"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivArrowRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="@dimen/dp16"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp13"
        android:textColor="@color/cs_cl_installment_loan_terms_text_color"
        android:id="@+id/tvLoanTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
