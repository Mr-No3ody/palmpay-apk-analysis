<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/core_payment"/>
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/titleBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewContainer"
            android:paddingBottom="@dimen/dp68"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_transfer_safe"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    app:iiv_color="@color/ppColorSuccess"
                    app:iiv_icon="pay_Security"
                    app:iiv_size="@dimen/dp16"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorSuccess"
                    android:id="@+id/tv_transfer_safe_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp4"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/iv_transfer_safe_arrow"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp12"
                    android:layout_height="@dimen/dp12"
                    app:iiv_color="@color/ppColorSuccess"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="@dimen/dp12"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_input"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp14"
                android:paddingBottom="@dimen/dp14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp14"
                app:layout_constraintTop_toBottomOf="@+id/ll_transfer_safe"
                app:layout_goneMarginTop="@dimen/dp16">
                <ImageView
                    android:id="@+id/ivRecentlyBank"
                    android:layout_width="@dimen/dp40"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="@+id/recipient_info_bottom_barrier"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvReceiptName"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tvReceiptName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp4"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/ivTag"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.16"/>
                <ImageView
                    android:id="@+id/ivTag"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp16"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="@+id/tvReceiptName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvReceiptName"
                    app:layout_constraintTop_toTopOf="@+id/tvReceiptName"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tvRecentlyShopName"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp10"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tvRecentlyBankName"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
                    app:layout_constraintTop_toBottomOf="@+id/tvReceiptName"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tvRecentlyBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp2"
                    android:layout_marginEnd="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvRecentlyShopName"
                    app:layout_constraintTop_toTopOf="@+id/tvRecentlyShopName"
                    style="@style/Text.6f7b85.12"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/recipient_info_bottom_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="ivRecentlyBank,tvReceiptName,tvRecentlyShopName,tvRecentlyBankName"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_amount_input"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recipient_info_bottom_barrier">
                    <TextView
                        android:id="@+id/tvAmountTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp12"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp12"
                        android:text="@string/core_amount"
                        android:layout_marginHorizontal="@dimen/dp12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.202046.12"/>
                    <com.palmpay.lib.ui.edit.PpAmountEditText
                        android:id="@+id/etAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp12"
                        android:inputType="numberDecimal"
                        android:layout_marginHorizontal="@dimen/dp12"
                        app:am_edit_hint_text_size="@dimen/dp28"
                        app:am_edit_show_amount_tip="true"
                        app:am_edit_show_button="false"
                        app:am_edit_show_lock="false"
                        app:am_edit_show_title="false"
                        app:am_edit_text_size="@dimen/dp28"
                        app:am_edit_vertical_margin="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvAmountTitle"/>
                    <View
                        android:id="@+id/etAmountErrorSpace"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etAmount"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:id="@+id/tvTips"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_amount_input"
                    style="@style/Text.202046.12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMoneyList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTips"/>
                <TextView
                    android:textColor="@color/ppColorTextAssist"
                    android:gravity="start"
                    android:id="@+id/balance_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/rvMoneyList"
                    style="@style/Text.202046.12"/>
                <ImageView
                    android:id="@+id/iv_discount"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/balance_tv"
                    app:layout_goneMarginTop="0dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clNote"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/cl_input">
                <TextView
                    android:id="@+id/tvNoteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_note"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.12"/>
                <EditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_note"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp8"
                    android:maxLines="1"
                    android:maxLength="200"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/cv_editor_cursor_purple"
                    android:paddingEnd="@dimen/dp28"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvNoteTitle"
                    style="@style/Text.202046.16"/>
                <View
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_note"
                    style="@style/core_divider_horizontal"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/iiv_clear"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    app:iiv_color="@color/ppColorTextDisable"
                    app:iiv_icon="pay_CloseFill"
                    app:iiv_size="@dimen/dp20"
                    app:layout_constraintBottom_toBottomOf="@+id/et_note"
                    app:layout_constraintEnd_toEndOf="@+id/et_note"
                    app:layout_constraintTop_toTopOf="@+id/et_note"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:layout_alignParentBottom="true">
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_next"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_next"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/txt_me_w_b"/>
    </FrameLayout>
    <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
