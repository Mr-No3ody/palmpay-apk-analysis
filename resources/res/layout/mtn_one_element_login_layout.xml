<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#202046"
        android:id="@+id/mtn_str1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mtn_str_get_started"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#202046"
        android:gravity="center"
        android:id="@+id/mtn_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/mtn_str_mobile_tips_"/>
    <com.transsnet.mtn.sdk.ui.view.InputView
        android:id="@+id/mtn_account_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_str1"
        app:mtn_input_view_hint="@string/mtn_str_hint_account_use_id"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#e41c1c"
        android:id="@+id/mtn_error_msg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <com.transsnet.mtn.sdk.ui.view.MTNButton
        android:id="@+id/mtn_login_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_password_input"
        app:mtn_button_status="disable"
        app:mtn_button_text="@string/mtn_str_log_in"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#3c4abc"
        android:id="@+id/mtn_handle_txt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/mtn_str_new_device_"/>
</LinearLayout>
