<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flexibank.sdk.cashier.ui.view.FlexiBankModelPageTitleAreaInPayVerifyPage
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fb_cta_content_text="Please enter your birthday to continue."
        app:fb_cta_title="Confirm Birthday"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/fb_shape_rect_corner_lt_rt_8_bg_white"
        android:paddingTop="@dimen/fb_dp8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/fb_dp172"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <com.flexibank.sdk.customview.model.FlexiBankTitleTextView1
            android:id="@+id/fb_acb_birthday_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_dp50"
            app:fb_te_title="DD/YY/MM"/>
        <TextView
            android:textColor="@color/fb_base_color_fail"
            android:gravity="center_vertical"
            android:id="@+id/fb_tvError"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/fb_warning"
            android:drawablePadding="6dp"
            style="@style/fb_txt_s_g"/>
        <com.palmpay.lib.ui.button.PpButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_acb_next_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fb_default_button_height"
            android:layout_marginLeft="@dimen/fb_dp45"
            android:layout_marginTop="@dimen/fb_dp40"
            android:layout_marginRight="@dimen/fb_dp45"
            android:text="@string/fb_core_next"
            style="@style/fbButtonStyle"/>
    </LinearLayout>
</RelativeLayout>
