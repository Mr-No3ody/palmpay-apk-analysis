<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:textSize="24dp"
        android:gravity="center_vertical"
        android:id="@+id/tvLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/ac_proof_of_address"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvLine2"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/tvLine1"
        style="@style/txt_s_g"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="@dimen/dp120"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLine2"
        app:layout_constraintVertical_bias="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/receiptView"
            android:background="@drawable/cv_receipt_bg_2"
            android:paddingTop="@dimen/dp20"
            android:paddingBottom="@dimen/dp20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp8"
                android:src="@drawable/core_receipt_palmpay_logo"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="26dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"/>
            <TextView
                android:ellipsize="none"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/core_successful_transaction"
                android:maxLines="1"
                style="@style/txt_s_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:gravity="center"
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/txt_me_lg"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/cv_shape_item_data_bundle_gray_line"
                android:layerType="software"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/cv_shape_item_data_bundle_gray_line"
                android:layerType="software"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/textViewConfirm"
        app:slot_id="C2E1513B50054D898B9950EB72C67862"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/textViewConfirm"
        android:layout_width="match_parent"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="12dp"
        android:text="@string/core_next"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
