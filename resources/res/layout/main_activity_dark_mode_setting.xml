<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_right_text="@string/core_done"
        app:title_bar_title="@string/main_dark_mode"/>
    <TextView
        android:id="@+id/tvSelectManually"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp14"
        android:text="@string/main_select_manually"
        android:layout_marginStart="@dimen/dp16"
        style="@style/Text.6f7b85.14"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llSelectManually"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp16">
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="start|center_vertical"
            android:id="@+id/itvNormalMode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/main_normal_mode"
            app:iiv_end_color="@color/ppColorTextAssist"
            app:iiv_end_icon="pay_CircleOutline"
            app:iiv_end_size="@dimen/dp20"
            style="@style/Text.202046.14"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="start|center_vertical"
            android:id="@+id/itvDarkMode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/main_dark_mode"
            app:iiv_end_color="@color/ppColorTextAssist"
            app:iiv_end_icon="pay_CircleOutline"
            app:iiv_end_size="@dimen/dp20"
            style="@style/Text.202046.14"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAutomaticDarkMode"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp84"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:id="@+id/tvAutoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_automatic"
            app:layout_constraintBottom_toTopOf="@+id/tvAutoDescribe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tvAutoDescribe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp2"
            android:text="@string/main_automatic_dark_mode"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivAutomaticCheck"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAutoTitle"
            style="@style/Text.9ca2aa.12"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivAutomaticCheck"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_CircleOutline"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
