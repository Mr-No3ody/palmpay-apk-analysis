<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_payment_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_payment_method"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_payment_method_arrow"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_payment_method"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_payment_method"/>
    <TextView
        android:id="@+id/tv_payment_method_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_all"
        android:paddingEnd="@dimen/dp3"
        android:layout_marginEnd="@dimen/dp32"
        app:layout_constrainedHeight="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_payment_method"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/txt_s_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
