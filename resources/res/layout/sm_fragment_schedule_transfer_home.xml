<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.PpSwipeRefreshLayout
        android:id="@+id/srl_refresh"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/btn_add_schedule_payment"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_schedule_transfer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.transsnet.palmpay.custom_view.PpSwipeRefreshLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/btn_add_schedule_payment"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginRight="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp20"
        android:contentDescription="@string/sm_schedule_a_payment"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/sm_schedule_empty_add"
            android:contentDescription="@null"/>
        <TextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sm_schedule_a_payment"
            android:layout_marginStart="4dp"
            style="@style/txt_me_w_b"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
