<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp20"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center_vertical"
        android:id="@+id/tt_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp32"
        android:text="@string/cv_otc"
        android:layout_below="@+id/v1"/>
    <EditText
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:textColorHint="@color/text_color_gray4"
        android:gravity="center_vertical"
        android:id="@+id/tt_et"
        android:background="@drawable/cv_et_underline_selector"
        android:paddingRight="@dimen/dp100"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp36"
        android:layout_below="@+id/v1"
        android:inputType="number"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextBase"
        android:textColorHint="@color/text_color_gray4"
        android:gravity="center"
        android:id="@+id/tt_send_sms_text"
        android:background="@drawable/cv_shape_halfround_purple"
        android:layout_width="@dimen/dp85"
        android:layout_height="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp5"
        android:text="@string/cv_send_code"
        android:layout_below="@+id/v1"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
