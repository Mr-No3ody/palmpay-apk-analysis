<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lib_ui_rect_bg_ffffff_corner_tl_tr_24"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get Method"
        android:paddingVertical="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_b_b_b"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout1"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivIcon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_background_color="@color/ppColorSecondary"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_corner_radius="32dp"
            app:iiv_icon="pay_USSDFill"
            app:iiv_padding="6dp"
            app:iiv_size="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv11"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv12"
            android:paddingTop="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Please use the mobile number linked to your BVN to make the call"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/ivArrow1"
            app:layout_constraintStart_toEndOf="@+id/ivIcon1"
            app:layout_constraintTop_toBottomOf="@+id/tv11"
            style="@style/txt_mi_lg"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivArrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout2"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/layout1">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivIcon2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_background_color="@color/ppColorSecondary"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_corner_radius="32dp"
            app:iiv_icon="pay_BankCardFill"
            app:iiv_padding="6dp"
            app:iiv_size="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv21"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Via Bank Account"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_s_b_b"/>
        <TextView
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enter the bank account number to retrieve BVN Number"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/ivArrow2"
            app:layout_constraintStart_toEndOf="@+id/ivIcon2"
            app:layout_constraintTop_toBottomOf="@+id/tv21"
            style="@style/txt_mi_lg"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivArrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/layout2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
