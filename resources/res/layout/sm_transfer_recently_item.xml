<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_recently_item"
    android:background="@color/ppColorBackgroundLight"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp12">
    <TextView
        android:id="@+id/tvTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp4"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/tvRecentlyBankName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.6f7b85.14"/>
    <ImageView
        android:id="@+id/ivRecentlyBank"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvLastTransferTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvRecentlyBankName"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvRecentlyBankName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/llBankinfo"
        app:layout_constraintEnd_toStartOf="@+id/iv_tag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
        app:layout_constraintTop_toBottomOf="@+id/tvTag"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginTop="@dimen/dp16"
        style="@style/Text.202046.14"/>
    <ImageView
        android:id="@+id/iv_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tvRecentlyBankName"
        app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
        app:layout_constraintStart_toEndOf="@+id/tvRecentlyBankName"
        app:layout_constraintTop_toTopOf="@+id/tvRecentlyBankName"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llBankinfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
        app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
        app:layout_constraintTop_toBottomOf="@+id/tvRecentlyBankName"
        app:layout_goneMarginBottom="@dimen/dp16">
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tvReceiptName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_toRightOf="@+id/iv_1"
            style="@style/Text.9ca2aa.12"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivFavorite"
        android:paddingTop="@dimen/dp10"
        android:paddingBottom="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp4"
        android:paddingVertical="@dimen/dp10"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_LikeOutline"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/tvLastTransferTime"
        app:layout_constraintEnd_toStartOf="@+id/ivMore"
        app:layout_constraintTop_toTopOf="@+id/tvRecentlyBankName"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivMore"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp10"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp10"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Menu"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/tvLastTransferTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvRecentlyBankName"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvLastTransferTime"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        app:layout_constraintStart_toStartOf="@+id/llBankinfo"
        app:layout_constraintTop_toBottomOf="@+id/llBankinfo"
        style="@style/Text.9ca2aa.12"/>
    <ViewStub
        android:id="@+id/vs_favorit_set_up"
        android:layout="@layout/sm_layout_transfer_to_palmpay_recently_favorit_set_up"
        android:inflatedId="@+id/cl_favorit_set_up"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp4"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLastTransferTime"/>
</androidx.constraintlayout.widget.ConstraintLayout>
