<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_match_bank"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="@string/sm_matched_bank"
        android:paddingStart="@dimen/dp16"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6f7b85.14"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_match_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_marginVertical="@dimen/dp10"
        app:layout_constraintTop_toBottomOf="@+id/tv_match_bank"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_match_bank"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_match_bank,rv_match_bank"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_frequently_used_bank"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="@string/sm_frequently_used_bank"
        android:paddingStart="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/rv_match_bank"
        style="@style/Text.6f7b85.14"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_frequently_used_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp10"
        android:layout_marginVertical="@dimen/dp10"
        app:layout_constraintTop_toBottomOf="@+id/tv_frequently_used_bank"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_frequently_used_bank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_frequently_used_bank,rv_frequently_used_bank"/>
</androidx.constraintlayout.widget.ConstraintLayout>
