<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fb_transparent_38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fb_viewContainer"
        android:background="@drawable/fb_background_white_with_corner2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <TextView
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fb_str_input_pin_to_pay"
                android:layout_centerVertical="true"
                style="@style/fb_txt_b_b_b"/>
            <ImageView
                android:id="@+id/fb_ivClose"
                android:padding="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fb_close_grey"
                android:scaleType="fitXY"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/fb_dp20"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/fb_txt_me_b_b"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/fb_paymentInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fb_dp16"
            android:layout_marginRight="@dimen/fb_dp16"
            android:layout_marginBottom="@dimen/fb_dp16"
            android:layout_marginHorizontal="@dimen/fb_dp16"/>
        <com.flexibank.sdk.customview.FlexiBankPinEntryView
            android:enabled="false"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_pinView"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            app:fb_accentType="character"
            app:fb_accentWidth="0dp"
            app:fb_digitBackground="@color/ppColorTextBase"
            app:fb_digitHeight="45dp"
            app:fb_digitRadius="4dp"
            app:fb_digitSelectStrokeColor="@color/fb_base_colorAccent"
            app:fb_digitSpacing="10dp"
            app:fb_digitStrokeColor="#c0c3c8"
            app:fb_digitStrokeWidth="0.5dp"
            app:fb_digitTextColor="@color/ppColorTextPrimary"
            app:fb_digitTextSize="@dimen/fb_large_text"
            app:fb_digitWidth="45dp"
            app:fb_mask="●"
            app:fb_pinInputType="number"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
        <include
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/fb_number_keyboard_layout"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
