<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/error_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="160dp"
        android:src="@drawable/lib_web_icon_error_unknown"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#202046"
        android:gravity="center"
        android:id="@+id/error_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="280dp"
        android:text="@string/web_error_network_msg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:id="@+id/error_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/web_error_network_tips"/>
    <com.palmpay.lib.ui.button.PpButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/opt_btn"
        android:layout_width="158dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/web_error_try"
        style="@style/ppSecondaryButtonStyle"/>
</LinearLayout>
