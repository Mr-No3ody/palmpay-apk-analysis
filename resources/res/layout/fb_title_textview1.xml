<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/fb_v1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp20"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/fb_text_color_gray2"
        android:gravity="center_vertical"
        android:id="@+id/fb_tt_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fb_dp32"
        android:text="@string/fb_otc"
        android:layout_below="@+id/fb_v1"/>
    <TextView
        android:textSize="@dimen/fb_dp14"
        android:textColor="@color/fb_text_color_black1"
        android:textColorHint="@color/fb_text_color_gray4"
        android:gravity="center_vertical"
        android:id="@+id/fb_tt_text"
        android:background="@drawable/fb_et_underline_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp36"
        android:drawableRight="@drawable/fb_arrow_drop_down"
        android:layout_below="@+id/fb_v1"/>
</RelativeLayout>
