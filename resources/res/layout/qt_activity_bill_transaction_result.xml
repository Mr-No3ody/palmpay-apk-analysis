<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.palmpay.lib.ui.titlebar.PpTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title_bar_show_right_1_iv="true"/>
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/model_trhv_result_header_view"
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:background="@color/ppColorBackgroundLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/stub_result_special_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/result_info_card"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="16dp"
                android:clipToOutline="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_order_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/view_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorTextAssist"
                        android:id="@+id/tv_view_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cv_view_detail"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/iv_view_detail"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="2dp"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="14dp"/>
                </LinearLayout>
            </LinearLayout>
            <ViewStub
                android:id="@+id/vs_payment_rewards"
                android:layout="@layout/core_layout_order_result_rewords_view_stub"
                android:inflatedId="@+id/vReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ad_act"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="30dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.transsnet.palmpay.core.viewmodel.FailResultPageAdView
                android:id="@+id/ad_fail_okcard"
                android:paddingTop="30dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llBottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp20"
        android:paddingEnd="@dimen/dp20">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tv_complete_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:id="@+id/spaceView"
            android:layout_width="@dimen/dp20"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/tv_btn_again"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/qt_airtime_topup_again"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/tv_btn_view_receipt"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp40"
            android:text="@string/core_view_receipt"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
