<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/cecca_title_bar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        app:title_bar_title="@string/core_beneficiaries"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.core.viewmodel.ModelEnterPhoneNumber1
                android:id="@+id/cecca_input_phone_num_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"/>
            <com.transsnet.palmpay.custom_view.TitleEditView
                android:id="@+id/cecca_tag_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginRight="@dimen/dp20"
                app:cv_max_length="10"
                app:cv_te_inputType="text"
                app:cv_te_no_focus_title_color="@color/ppColorTextNormal"
                app:cv_te_text_color="@color/ppColorTextPrimary"
                app:cv_te_title="@string/core_tag_upper"
                app:cv_te_title_color="@color/ppColorTextNormal"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cecca_tag_rcv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/dp20"/>
            <include
                android:id="@+id/cecc_time_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp20"
                android:layout_marginEnd="@dimen/dp20"
                layout="@layout/core_layout_time_remind"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/ce_add_remind"
                android:background="@drawable/cv_shape_halfround_background_dark"
                android:layout_width="132dp"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dp20">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:id="@+id/aec_add_remind_iv"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@drawable/cv_icon_add_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextDisable"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp40"
                        android:text="@string/ct_add_reminder"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp5"
                        app:layout_constraintStart_toEndOf="@+id/aec_add_remind_iv"
                        app:layout_constraintTop_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/cecc_time_remind2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginStart="@dimen/dp20"
                android:layout_marginEnd="@dimen/dp20"
                layout="@layout/core_layout_time_remind"/>
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginRight="@dimen/dp25"
                android:layout_marginBottom="@dimen/dp40"
                android:layout_below="@+id/cecca_iv">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text_color_white"
                    android:gravity="center"
                    android:id="@+id/cecca_save_tv"
                    android:background="@drawable/core_selector_rect_corner_12_purple_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:text="@string/core_save"
                    android:layout_weight="1"/>
                <View
                    android:id="@+id/cecca_space_view"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp1"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/cecca_delete_tv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:text="@string/core_delete"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
