<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutParent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp36">
    <TextView
        android:id="@+id/tvInfoTitle"
        android:visibility="gone"
        android:drawablePadding="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.858a8f.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iconImageInfo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tvInfoTitle"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="right"
        android:id="@+id/tvInfoValue"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvInfoSubValue"
        app:layout_constraintLeft_toRightOf="@+id/tvInfoTitle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.202046.14"/>
    <TextView
        android:id="@+id/tvInfoSubValue"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvInfoValue"
        style="@style/Text.858a8f.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
