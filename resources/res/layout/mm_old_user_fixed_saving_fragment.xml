<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/viewMarquee"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        android:drawableLeft="@drawable/mm_icon_notification"
        android:drawablePadding="4dp"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintTop_toTopOf="parent"
        app:slot_id="@string/fixed_savings_new_user_text_slot_id"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clsDetail"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewMarquee">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tvTotalSavingsBalanceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_total_savings"
                style="@style/Text.202046.12"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivToggleShowBalance"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp16"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="1dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
                app:layout_constraintLeft_toRightOf="@+id/tvTitle"
                app:layout_constraintTop_toTopOf="@+id/tvTitle"
                app:tint="@color/ppColorTextPrimary"/>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="center"
            android:id="@+id/tvBalanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:text="₦0.00"
            android:lines="1"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="24sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:iiv_end_color="@color/ppColorTextPrimary"
            app:iiv_end_icon="pay_ArrowCenterRight"
            app:iiv_end_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llTitle"
            style="@style/Text.medium.202046.24"/>
        <TextView
            android:id="@+id/tvHoldAmount"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp4"
            android:includeFontPadding="false"
            android:drawableLeft="@drawable/mm_icon_warn"
            android:drawablePadding="@dimen/dp2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBalanceAmount"
            style="@style/Text.858a8f.12"/>
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvTotalInterestAmount"
            android:layout_marginTop="@dimen/dp5"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBalanceAmount"
            style="@style/Text.858a8f.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clsDetail">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginHorizontal="@dimen/dp10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabGravity="start"
            app:tabIndicator="@drawable/mm_bg_tab_indicator"
            app:tabIndicatorFullWidth="false"
            app:tabPaddingEnd="@dimen/dp8"
            app:tabPaddingStart="@dimen/dp8"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/ppColorPrimary"
            app:tabTextAppearance="@style/NormalTextStyle"
            app:tabTextColor="@color/ppColorTextNormal"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/llCreatePlan"
            app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
        <LinearLayout
            android:id="@+id/llCreatePlan"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:textColor="@color/md_white_1000"
                android:id="@+id/rtvCreatePlan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginRight="@dimen/dp24"
                android:text="@string/mm_create_plan"
                app:rtv_background_color="@color/mm_color_6306b2"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/Text.medium.ffffff.16"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
