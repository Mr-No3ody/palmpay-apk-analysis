<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fb_layout_root"
    android:paddingLeft="@dimen/fb_dp16"
    android:paddingTop="@dimen/fb_dp6"
    android:paddingRight="@dimen/fb_dp16"
    android:paddingBottom="@dimen/fb_dp6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/fb_dp28"
    android:paddingHorizontal="@dimen/fb_dp16"
    android:paddingVertical="@dimen/fb_dp6">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fb_ll_item_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/fb_space_item"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/fb_dp100"
        style="@style/fb_txt_s_b">
        <TextView
            android:gravity="start"
            android:id="@+id/fb_tv_item_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/fb_iv_item_key_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/fb_Text.202046.14"/>
        <ImageView
            android:id="@+id/fb_iv_item_key_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/fb_dp5"
            android:layout_marginEnd="@dimen/fb_dp7"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/fb_tv_item_key"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fb_tv_item_key"
            app:layout_constraintTop_toTopOf="@+id/fb_tv_item_key"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/fb_space_item"
        android:layout_width="0dp"
        android:layout_height="@dimen/fb_dp1"
        app:layout_constraintEnd_toStartOf="@+id/fb_ll_item_value"
        app:layout_constraintStart_toEndOf="@+id/fb_ll_item_key"
        app:layout_constraintWidth_min="@dimen/fb_dp20"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fb_ll_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/fb_dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/fb_space_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/fb_dp100"
        style="@style/fb_txt_s_b_b">
        <ImageView
            android:id="@+id/fb_iv_item_value_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/fb_dp7"
            android:layout_marginEnd="@dimen/fb_dp4"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/fb_tv_item_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/fb_dp4"
            android:layout_marginStart="@dimen/fb_dp4"
            android:layout_marginEnd="@dimen/fb_dp4"
            style="@style/fb_Text.medium.202046.14"/>
        <TextView
            android:textSize="@dimen/fb_dp14"
            android:textColor="@color/ppColorTextDisable"
            android:gravity="end"
            android:id="@+id/fb_tv_item_line_value"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="@dimen/fb_dp4"
            android:layout_marginEnd="@dimen/fb_dp4"
            style="@style/fb_Text.medium.9ca2aa.16"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/fb_barrier_content_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="fb_ll_item_key,fb_ll_item_value"/>
    <TextView
        android:textSize="@dimen/fb_dp12"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/fb_tv_item_key_hint"
        android:paddingTop="@dimen/fb_dp5"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/fb_dp20"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_barrier_content_bottom"
        style="@style/fb_txt_s_g"/>
</merge>
