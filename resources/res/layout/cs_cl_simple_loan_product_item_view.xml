<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:paddingHorizontal="@dimen/dp12">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        style="@style/Text.202046.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/ppColorFlexiCashPrimary"
        android:gravity="center"
        android:id="@+id/rtvStatus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp17"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:rtv_background_color="@color/transparent"
        app:rtv_border_color="@color/ppColorFlexiCashPrimary"
        app:rtv_border_width="@dimen/dp1"
        app:rtv_corner_radius="@dimen/dp4"
        style="@style/Text.ffffff.10"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/rtvFrozen"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginTop="2dp"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintEnd_toStartOf="@+id/tvSuffix"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/transparent"
        app:rtv_border_color="@color/ppColorTextDisable"
        app:rtv_border_width="@dimen/dp1"
        app:rtv_corner_radius="@dimen/dp4"
        style="@style/Text.ffffff.10"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvSuffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toStartOf="@+id/ivArrowRight"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        style="@style/Text.202046.14"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivArrowRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp2"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
