<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/mtn_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#1c1c1c"
            android:id="@+id/mtn_retain_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:text="@string/mtn_str_your_account_haven_"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#7c7878"
            android:id="@+id/mtn_retain_qa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:text="@string/mtn_str_are_you_sure_to_exit"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mtn_retain_info"
            app:layout_goneMarginTop="6dp"/>
        <View
            android:id="@+id/mtn_line"
            android:background="#e1e1e4"
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mtn_retain_qa"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#bbbbbb"
            android:gravity="center"
            android:id="@+id/mtn_yes_exit"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:text="@string/mtn_str_yes_exit"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/mtn_line_v"
            app:layout_constraintTop_toBottomOf="@+id/mtn_line"/>
        <View
            android:id="@+id/mtn_line_v"
            android:background="#e1e1e4"
            android:layout_width="1px"
            android:layout_height="53dp"
            app:layout_constraintLeft_toRightOf="@+id/mtn_yes_exit"
            app:layout_constraintRight_toLeftOf="@+id/mtn_no_continue"
            app:layout_constraintTop_toBottomOf="@+id/mtn_line"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#1887ee"
            android:gravity="center"
            android:id="@+id/mtn_no_continue"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:text="@string/mtn_str_no_continue"
            app:layout_constraintLeft_toRightOf="@+id/mtn_line_v"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mtn_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
