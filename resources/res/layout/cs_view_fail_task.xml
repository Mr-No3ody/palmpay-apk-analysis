<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/all_task_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginTop="@dimen/ad_dp_32"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/do_task_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/md_black_1000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tips"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/do_task_tips_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:text="@string/cs_fail_task_tips_desc_flexi"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/do_task_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/completed_task_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/md_black_1000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed tasks"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/completed_task_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:text="@string/cs_fail_task_completed_desc_flexi"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/completed_task_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"/>
    </LinearLayout>
</LinearLayout>
