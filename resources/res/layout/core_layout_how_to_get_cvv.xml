<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp24"
    android:paddingTop="20dp"
    android:paddingRight="@dimen/dp24"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp24">
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_how_to_view_cvv"
        style="@style/txt_b_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/core_msg_how_to_view_cvv"
        style="@style/txt_mi_b"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginBottom="@dimen/dp20"
        android:src="@drawable/cv_how_to_get_cvv"
        android:scaleType="fitXY"
        android:layout_marginVertical="@dimen/dp20"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvOk"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="0dp"
        android:text="@string/core_ok"
        style="@style/txt_me_w"/>
</LinearLayout>
