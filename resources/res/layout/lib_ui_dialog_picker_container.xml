<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/lib_ui_bg_top_corner_15_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ly_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/lib_ui_layout_title"/>
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/ly_title"/>
    <include
        android:id="@+id/ly_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppPickerButtonHeight"
        app:layout_constraintTop_toBottomOf="@+id/fl_container"
        layout="@layout/lib_ui_dialog_picker_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
