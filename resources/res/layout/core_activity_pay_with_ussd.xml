<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp18"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ciap_result_hint_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/core_msg_transaction_submitted"
            android:layout_below="@+id/ciap_img"
            android:layout_centerHorizontal="true"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ciap_img"
            android:layout_width="@dimen/cv_result_success_img_size"
            android:layout_height="@dimen/cv_result_success_img_size"
            android:layout_marginTop="@dimen/dp70"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/cv_result_success"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/aatur_done_tv"
            android:padding="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_done"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/atubd_hint_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp15"
        android:text="@string/core_continue_with_ussd"
        android:lineSpacingExtra="@dimen/dp8"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/ciap_complete_btn"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp45"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="@dimen/dp45"
        android:text="@string/core_complete"
        style="@style/ppButtonStyle"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ussd_guide_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/core_how_to_use_ussd"
        android:includeFontPadding="false"
        android:drawablePadding="5dp"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_InformationOutline"
        app:iiv_start_size="@dimen/dp14"/>
</LinearLayout>
