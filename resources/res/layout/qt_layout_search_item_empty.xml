<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mls_search_empty_root"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/mls_tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp22"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp22"
        android:text="@string/qt_sorry_this_biller_s_is_currently"
        android:layout_marginHorizontal="@dimen/dp22"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/mls_tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp22"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp22"
        android:text="@string/qt_kindly_be_patient_with_us_while_we_add_them_to_our_list"
        android:layout_marginHorizontal="@dimen/dp22"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mls_ok"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="@dimen/dp115"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp26"
        android:layout_marginBottom="@dimen/dp26"
        android:text="@string/core_ok1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginVertical="@dimen/dp26"/>
</LinearLayout>
