<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp60"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/iv_flexi_guide_icon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_ok_card_icon"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_flexi_guide_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_flexi_guide_benefit"
        app:layout_constraintEnd_toStartOf="@+id/iv_flexi_guide_selected"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_flexi_guide_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_flexi_guide_subtitle"
        android:background="@drawable/cv_shape_rect_corner_16_bg_secondary"
        android:paddingLeft="@dimen/dp6"
        android:paddingRight="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginLeft="@dimen/dp4"
        android:layout_marginRight="@dimen/dp4"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/dp4"
        android:layout_marginHorizontal="@dimen/dp4"
        android:paddingHorizontal="@dimen/dp6"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_flexi_guide_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_flexi_guide_selected"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_flexi_guide_name"
        app:layout_constraintTop_toTopOf="@+id/tv_flexi_guide_name"
        style="@style/txt_s_b"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tv_flexi_guide_benefit"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_flexi_guide_selected"
        app:layout_constraintStart_toStartOf="@+id/tv_flexi_guide_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_flexi_guide_name"/>
    <ImageView
        android:id="@+id/iv_flexi_guide_selected"
        android:visibility="gone"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
