<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp19"
        android:text="@string/core_complete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_g"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivCongratulations"
        android:layout_width="wrap_content"
        android:layout_height="109dp"
        android:layout_marginTop="@dimen/dp88"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp28"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp28"
        android:text="@string/ac_tier3_success_title"
        android:layout_marginHorizontal="@dimen/dp28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCongratulations"
        style="@style/Text.medium.202046.20"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text="@string/ac_tier3_success_subtitle"
        android:lineSpacingExtra="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBanner"
        app:slot_id="6F69507A312F4486AF1A3FD97D61EFF9"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/tvOk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/ac_tier3_success_start_growing"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppButtonStyle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/cornerAd"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="@dimen/dp32"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvOk"
        app:layout_constraintEnd_toEndOf="@+id/tvOk"
        app:slot_id="40FDC9DEFB8A41398DDE1CBE5F9B2AD6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
