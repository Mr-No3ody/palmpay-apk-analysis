<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/ac_palmpay_levels"/>
    <ScrollView
        android:id="@+id/viewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewStub
                android:id="@+id/layoutCurrentLevelStub"
                android:layout="@layout/ac_layout_palmpay_current_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutTier3Review"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/ac_bg_kyc_t3_state_color"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/ppColorError"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvT3Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_msg_tier3_fail_info"
                    app:iiv_end_color="@color/ppColorError"
                    app:iiv_end_icon="pay_ArrowRight"
                    app:iiv_end_size="@dimen/dp16"
                    app:iiv_start_color="@color/ppColorError"
                    app:iiv_start_icon="pay_CloseFill"
                    app:iiv_start_padding="4dp"
                    app:iiv_start_size="@dimen/dp24"
                    style="@style/txt_mi_g"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvT3PendingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_msg_tier3_review_info"
                    app:iiv_end_color="@color/ppColorPrimary"
                    app:iiv_end_icon="pay_ArrowRight"
                    app:iiv_end_size="@dimen/dp16"
                    app:iiv_start_color="@color/ppColorPrimary"
                    app:iiv_start_icon="pay_Schedule"
                    app:iiv_start_padding="4dp"
                    app:iiv_start_size="@dimen/dp24"
                    style="@style/txt_mi_g"/>
            </androidx.cardview.widget.CardView>
            <ViewStub
                android:id="@+id/layoutLinkIdStub"
                android:layout="@layout/ac_layout_palmpay_link_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/layoutLevelBenefitStub"
                android:layout="@layout/ac_layout_palmpay_level_benefit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/bottomAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="@dimen/dp16"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="16dp"
                app:slot_id="9F78FD6E31B6456BB87F01C4013E5DD1"/>
        </LinearLayout>
    </ScrollView>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/bottomAd2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvUpgrade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:slot_id="C2E1513B50054D898B9950EB72C67862"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/tvUpgrade"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/ac_verity_to_upgrade"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/cornerAd"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="32dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvUpgrade"
        app:layout_constraintEnd_toEndOf="@+id/tvUpgrade"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
