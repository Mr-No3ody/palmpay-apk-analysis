<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp">
    <com.transsnet.adsdk.widgets.banner.BannerAdView
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintTop_toTopOf="parent"
        app:slot_id="@string/fixed_savings_home_slot_id"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clsContainer"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/viewPager">
        <TextView
            android:id="@+id/tvBeforeInvestingTitle"
            android:text="What is Fixed Savings?"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDesc"
            android:background="@color/ppColorBackgroundDark"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="Securely save your funds for your preferred\10duration and enjoy high interest rates.\10The longer you save, the more you earn!"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBeforeInvestingTitle"
            style="@style/Text.6f7b85.12"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llLeft"
            android:background="@drawable/cv_rect_corner_8_bg_f6f6fa"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@+id/llRight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Security"
                app:iiv_size="24dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Capital Protected"
                style="@style/Text.202046.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llRight"
            android:background="@drawable/cv_rect_corner_8_bg_f6f6fa"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/llLeft"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_AssetsFill"
                app:iiv_size="24dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="High Returns"
                style="@style/Text.202046.12"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
        android:id="@+id/cashBoxIntroductionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clsContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
