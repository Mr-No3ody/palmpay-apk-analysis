<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/tf_money_result_img"
                    android:layout_width="@dimen/cv_result_success_img_size"
                    android:layout_height="@dimen/cv_result_success_img_size"
                    android:layout_marginTop="56dp"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/cv_result_success"/>
                <TextView
                    android:textSize="@dimen/dp15"
                    android:textStyle="bold"
                    android:textColor="#ff263138"
                    android:gravity="center"
                    android:id="@+id/tf_money_result_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginRight="30dp"
                    android:text="@string/core_success"
                    android:textAllCaps="true"/>
                <TextView
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/qecode_pay_title_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="30dp"
                    android:text="@string/core_0"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/result_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp">
                    <LinearLayout
                        android:id="@+id/qecode_pay_amount_content"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:id="@+id/qecode_pay_amount_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_amount"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:id="@+id/qecode_pay_fee_content"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:id="@+id/qecode_pay_fee_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_fee"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_fee"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:id="@+id/qecode_vat_content"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:id="@+id/qecode_vat_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_vat"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_vat_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_cashback_earned"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_points_earned_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_promotions"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_promotions_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_coupon_to_use"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_coupon_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_actual_payment"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/actual_payment_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_store_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_store_name_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff6f7b85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_order_number"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff263138"
                            android:gravity="end"
                            android:id="@+id/qecode_pay_order_number"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/result_one_btn"
            android:background="@null"
            android:padding="@dimen/dp15"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_ok"
            android:layout_alignParentRight="true"
            android:textAllCaps="false"/>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
