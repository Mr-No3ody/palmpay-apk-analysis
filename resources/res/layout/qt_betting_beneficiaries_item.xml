<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbri_root"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16">
    <ImageView
        android:id="@+id/mbri_iv"
        android:padding="0.5dp"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginRight="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mbri_more_iv"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Menu"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/mbri_title_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/mbri_time_tv"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintLeft_toRightOf="@+id/mbri_iv"
        app:layout_constraintRight_toLeftOf="@+id/mbri_more_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/mbri_time_tv"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/qbbi_time_tv"
        app:layout_constraintEnd_toStartOf="@+id/mbri_more_iv"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toEndOf="@+id/mbri_iv"
        app:layout_constraintTop_toBottomOf="@+id/mbri_title_tv"
        style="@style/txt_mi_lg"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/qbbi_clock_iv"
        android:layout_width="@dimen/dp18"
        android:layout_height="@dimen/dp18"
        android:layout_marginLeft="@dimen/dp12"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Calendar"
        app:iiv_size="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="@+id/qbbi_time_tv"
        app:layout_constraintLeft_toRightOf="@+id/mbri_iv"
        app:layout_constraintTop_toBottomOf="@+id/mbri_time_tv"
        app:layout_constraintTop_toTopOf="@+id/qbbi_time_tv"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/qbbi_time_tv"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp14"
        android:layout_marginTop="@dimen/dp6"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/qbbi_clock_iv"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/qbbi_clock_iv"
        app:layout_constraintRight_toLeftOf="@+id/mbri_more_iv"
        app:layout_constraintTop_toBottomOf="@+id/mbri_time_tv"
        style="@style/txt_mi_lg"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/qbbi_remind_time_item"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="qbbi_clock_iv,qbbi_time_tv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/dp10"
        app:constraint_referenced_ids="mbri_iv,qbbi_time_tv,qbbi_clock_iv"/>
    <View
        android:id="@+id/mbri_divide_view"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_bottom"
        app:layout_goneMarginTop="@dimen/dp20"/>
</androidx.constraintlayout.widget.ConstraintLayout>
