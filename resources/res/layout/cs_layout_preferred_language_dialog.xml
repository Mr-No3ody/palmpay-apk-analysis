<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"
        app:iiv_color="#9ca2aa"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <TextView
        android:textSize="@dimen/dp18"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="Preferred Language"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/text1"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="Select your preferred language to unlock a better expirence"
            android:drawablePadding="@dimen/dp12"
            android:drawableStart="@drawable/cs_preferred_language"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_language"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp160"
            android:layout_marginTop="@dimen/dp4"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <TextView
                android:enabled="false"
                android:textSize="@dimen/dp14"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_apply"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cv_default_button_height"
                android:text="@string/core_confirm"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
