<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/mm_color_f6f6fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ctb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/mm_preview_plan_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:visibility="gone"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/mm_details_of_your_plan"
                style="@style/Text.medium.202046.18"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutMasterInfo"
                android:background="@drawable/mm_bg_plan_info"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tvProductName"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.14"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginVertical="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutExtroInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginVertical="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutAutoRenewalExtroInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/layoutStrick"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:divider="@drawable/mm_bg_transparent_v_divider_8"
                android:showDividers="middle"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable Strict Savings Mode"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.14"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock savings until maturity date"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv1"
                    style="@style/Text.9ca2aa.12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:enabled="true"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/switchStrictWidget"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp20"
                    android:src="@drawable/cv_switch_close_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutProtocol"
        android:background="@color/ppColorBackgroundLight"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:id="@+id/ckProtocol"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:button="@drawable/cv_checkbox_selector2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="left"
            android:id="@+id/tvPreviewPlanProtocol"
            android:layout_width="0dp"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginRight="@dimen/dp16"
            android:text="I agreed to the Fixed "
            android:lineSpacingMultiplier="1.4"
            android:lineHeight="@dimen/dp16"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/ckProtocol"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.858a8f.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="16dp"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="16dp"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:paddingHorizontal="16dp">
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:id="@+id/rtvConfirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/core_confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
