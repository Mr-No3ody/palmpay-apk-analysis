<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/jp_refer_earn_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/jp_history"
        app:title_bar_title_color="@color/ppColorBackgroundLight"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/jp_refer_earn_details_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp20"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp20">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp45"
            app:tabBackground="@color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/jp_re_tab_indicator"
            app:tabIndicatorColor="@color/ppColorWarning"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/ppColorWarning"
            app:tabTextAppearance="@style/ReTabTextStyle"
            app:tabTextColor="@color/ppColorTextBase"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/jp_history_viewpager"
            android:padding="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/jp_rl_invite"
        android:background="#6531e7"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginTop="@dimen/dp18">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/jp_invite_line"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jp_share_invite"
            android:drawablePadding="@dimen/dp9"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            app:iiv_start_color="@color/ppColorTextBase"
            app:iiv_start_icon="pay_Share"
            app:iiv_start_size="@dimen/dp30"/>
    </RelativeLayout>
</LinearLayout>
