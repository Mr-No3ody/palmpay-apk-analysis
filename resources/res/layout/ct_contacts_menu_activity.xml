<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/ct_edit_contact"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/delete_btn"
        android:layout_below="@+id/titleBar">
        <RelativeLayout
            android:id="@+id/set_remake_name"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#272a2d"
                android:id="@+id/label_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/ct_profile"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="end"
                android:id="@+id/remake_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/right_iv"
                android:layout_toRightOf="@+id/label_tv"
                android:layout_centerVertical="true"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/right_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="19dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="16dp"/>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/delete_btn"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/ct_delete"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/ppButtonStyle"/>
</RelativeLayout>
