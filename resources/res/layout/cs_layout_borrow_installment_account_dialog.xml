<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"
        app:iiv_color="#9ca2aa"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <TextView
        android:textSize="@dimen/dp32"
        android:textStyle="bold"
        android:textColor="#463920"
        android:id="@+id/clbiad_text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp33"
        android:layout_marginRight="@dimen/dp16"
        android:text="Installment\10Loans"
        android:fontFamily="sans-serif-black"
        android:layout_marginHorizontal="@dimen/dp16"
        android:lineHeight="@dimen/dp30"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:src="@drawable/cs_installment_star_icon"
        android:layout_marginEnd="@dimen/dp50"
        android:layout_alignParentEnd="true"
        app:tint="#ffc56f"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp60"
        android:src="@drawable/cs_installment_star_icon3"
        android:layout_marginStart="@dimen/dp120"
        app:tint="#ffc56f"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/clbiad_ll"
        android:background="@drawable/cs_borrow_dialog_bg"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/clbiad_loan_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp40"
            android:text="Installment Loan"
            android:drawablePadding="@dimen/dp6"
            android:drawableStart="@drawable/cs_installment_succ_interest"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loanable Amount"/>
                <TextView
                    android:textSize="@dimen/dp26"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/clbiad_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:fontFamily="sans-serif-black"/>
                <TextView
                    android:textColor="#906948"
                    android:id="@+id/clbiad_interest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp60">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/clbiad_loan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loan Period"/>
                <TextView
                    android:textSize="@dimen/dp26"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/clbiad_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:fontFamily="sans-serif-black"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/apply"
                android:background="@drawable/cv_shape_rect_corner_12_bg_text_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:text="@string/cs_cl_borrow"
                android:fontFamily="sans-serif-medium"/>
            <ImageView
                android:id="@+id/clbiad_hand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_hand"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textColor="#906948"
        android:gravity="center"
        android:id="@+id/clbiad_repay_title"
        android:background="@drawable/cs_install_borrow_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="98dp"
        android:text="Repay in 3 terms, 15 days/ term"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:id="@+id/clbiad_repay_line"
        android:background="@drawable/cs_cl_line_green"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="120dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dp16"/>
</RelativeLayout>
