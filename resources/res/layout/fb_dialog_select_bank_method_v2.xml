<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fb_viewRoot"
    android:background="@drawable/fb_dialog_top_left_right_corner_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp50">
        <com.flexibank.sdk.customview.FlexiBankStateImageView
            android:id="@+id/fb_cdspm_close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/fb_dp15"
            android:src="@drawable/fb_close_grey"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/fb_dp15"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/fb_dp16"
            android:textStyle="bold"
            android:textColor="@color/fb_text_color_black1"
            android:id="@+id/fb_cdspm_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fb_select_bank_text"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/fb_bg_color_gray_3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fb_cdspm_rcv"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/fb_dp20"/>
        <com.flexibank.sdk.customview.FlexiBankSideBarView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/fb_cdspm_side_bar"
            android:visibility="gone"
            android:layout_width="@dimen/fb_dp20"
            android:layout_height="wrap_content"
            app:fb_sidebar_item_padding="@dimen/fb_dp2"
            app:fb_sidebar_normal_background_color="@color/fb_transparent"
            app:fb_sidebar_pressed_background_color="@color/fb_bg_color_gray_3"
            app:fb_sidebar_selected_text_color="@color/fb_text_color_purple"
            app:fb_sidebar_selected_text_size="@dimen/fb_dp15"
            app:fb_sidebar_text_color="@color/fb_text_color_gray2"
            app:fb_sidebar_text_size="@dimen/fb_dp12"/>
    </FrameLayout>
</LinearLayout>
