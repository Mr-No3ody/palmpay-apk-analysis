<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"
        app:iiv_color="#9ca2aa"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp33"
        android:layout_marginRight="@dimen/dp16"
        android:text="Congratulations on\10applying for installment\10products"
        android:fontFamily="sans-serif-black"
        android:layout_marginHorizontal="@dimen/dp16"
        android:lineHeight="@dimen/dp30"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp28"
        android:src="@drawable/cs_installment_star_icon"
        android:layout_marginEnd="@dimen/dp50"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_below="@+id/text1"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_upto_repayin"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#ff9900"
            android:gravity="center"
            android:id="@+id/tvUptoRepay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up to ₦500,000, repay in 6 terms"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp4"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp16"
        android:layout_below="@+id/ll1"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_daily_interest"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#ff9900"
            android:gravity="center"
            android:id="@+id/tvDailyInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily interest 0.1%"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp4"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/apply"
        android:background="@drawable/cv_shape_rect_corner_12_bg_text_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp150"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_apply"
        android:layout_below="@+id/ll2"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:src="@drawable/cs_apply_installment_account"
        android:layout_below="@+id/ll2"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:src="@drawable/cs_hand"
        android:layout_below="@+id/ll2"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/learn_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:layout_below="@+id/apply"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn more about installmet"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp2"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp20"/>
    </LinearLayout>
</RelativeLayout>
