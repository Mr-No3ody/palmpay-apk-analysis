<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mtn_btn"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    app:cardBackgroundColor="#6306b2"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/mtn_white"
        android:layout_gravity="center"
        android:id="@+id/mtn_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mtn_str_i_agree"/>
    <com.transsnet.mtn.sdk.ui.view.avloading.AVLoadingIndicatorView
        android:layout_gravity="center"
        android:id="@+id/mtn_avi"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorName="com.transsnet.mtn.sdk.ui.view.avloading.BallSpinFadeLoaderIndicator"
        style="@style/AVLoadingIndicatorView.Small"/>
</androidx.cardview.widget.CardView>
