<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp12"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivAvatar"
            android:visibility="gone"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"
            android:importantForAccessibility="no"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/main_home_clipboard_transfer_generic_title"
            android:maxLines="2"
            android:includeFontPadding="false"
            style="@style/Text.medium.202046.18"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutAccountInfo"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvAccountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:text="@string/main_home_clipboard_recipient_account"
                    android:includeFontPadding="false"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:textSize="@dimen/dp28"
                    android:textColor="@color/ppColorTextPrimary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tvAccountNo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginTop="@dimen/dp4"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <View
                android:id="@+id/viewBankDivider"
                android:background="@color/ppColorDividerLineDark"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp1"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layoutBank"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp12">
                <TextView
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp18"
                    android:text="@string/main_home_clipboard_bank"
                    android:includeFontPadding="false"
                    style="@style/Text.6f7b85.12"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingRight="@dimen/dp12"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp4"
                    android:paddingHorizontal="@dimen/dp12">
                    <ImageView
                        android:id="@+id/ivBank"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/tvBankName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp8"
                        style="@style/Text.medium.202046.16"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:minHeight="@dimen/dp32"
            android:text="@string/main_home_clipboard_default_tip"
            android:includeFontPadding="false"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/btnTransfer"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/main_home_clipboard_transfer_now"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
