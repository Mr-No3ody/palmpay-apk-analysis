<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/fb_viewRoot"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/fb_ll_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="86dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fb_cl_expand"
                android:background="@drawable/fb_shape_rect_corner_8_bg_dark"
                android:paddingTop="@dimen/fb_dp24"
                android:paddingBottom="@dimen/fb_dp8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/fb_dp12"
                    android:textColor="@color/fb_text_color_gray2"
                    android:id="@+id/fb_icil_text_tv2"
                    android:paddingLeft="@dimen/fb_dp16"
                    android:paddingRight="@dimen/fb_dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/fb_dp16"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/fb_dp12"
                    android:textColor="@color/fb_base_color_fail"
                    android:id="@+id/fb_tvUnavailableReason"
                    android:paddingLeft="@dimen/fb_dp16"
                    android:paddingRight="@dimen/fb_dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/fb_dp16"
                    app:layout_constraintTop_toBottomOf="@+id/fb_icil_text_tv2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/fb_ll_top"
            android:layout_width="match_parent"
            android:layout_height="106dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/fb_rl_left"
                android:background="@drawable/fb_coupon_frame_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_dp8">
                    <ImageView
                        android:id="@+id/fb_icii_coupon_icon"
                        android:layout_width="@dimen/fb_dp24"
                        android:layout_height="@dimen/fb_dp24"
                        android:layout_marginLeft="@dimen/fb_dp12"
                        android:src="@drawable/fb_bill_default_icon"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/fb_ll_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/fb_dp5"
                        android:layout_marginRight="@dimen/fb_dp14"
                        android:layout_toRightOf="@+id/fb_icii_coupon_icon">
                        <TextView
                            android:textSize="@dimen/fb_dp22"
                            android:textColor="@color/fb_base_colorPrimary"
                            android:id="@+id/fb_icil_amount_tv"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/fb_dp6"/>
                        <TextView
                            android:textSize="@dimen/fb_dp14"
                            android:textColor="@color/fb_text_color_black1"
                            android:ellipsize="end"
                            android:id="@+id/fb_icil_title_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="@dimen/fb_dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/fb_icil_text_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/fb_dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="left"
                    android:id="@+id/fb_icil_text_tv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/fb_dp15"
                    android:layout_marginRight="@dimen/fb_dp5"
                    android:layout_marginBottom="@dimen/fb_dp8"
                    android:layout_toLeftOf="@+id/fb_llDetailArrow"
                    android:layout_alignParentBottom="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/fb_llDetailArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/fb_dp12"
                    android:layout_marginBottom="@dimen/fb_dp8"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:textSize="@dimen/fb_dp10"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/fb_tvDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fb_detail"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:textSize="@dimen/fb_dp12"
                        android:id="@+id/fb_icii_iv_expand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/fb_arrow_down"
                        android:text="@string/fb_detail"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/fb_ll_right"
                android:background="@drawable/fb_coupon_frame_right"
                android:layout_width="@dimen/fb_dp100"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fb_dp24"
                    android:textColor="@color/ppColorButtonTextWhite"
                    android:gravity="center"
                    android:id="@+id/fb_icil_coupon_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="@dimen/fb_dp14"
                    android:textColor="@color/ppColorFlexiCashPrimary"
                    android:gravity="center"
                    android:id="@+id/fb_icil_use_tv"
                    android:background="@drawable/fb_shape_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="@dimen/fb_dp64"
                    android:layout_height="@dimen/fb_dp24"
                    android:layout_marginTop="@dimen/fb_dp8"
                    android:text="@string/fb_use"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/fb_imageViewCheck"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:src="@drawable/fb_coupon_uncheck"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:paddingStart="8dp"
        android:layout_alignParentEnd="true"/>
</LinearLayout>
