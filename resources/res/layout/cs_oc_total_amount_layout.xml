<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_total_amount_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:title_bar_show_right_2_iv="false"
            app:title_bar_title="Flexi Limit Increase Tasks"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/oc_total_amount_nsv"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/csTextview3"
                    android:layout_marginTop="44dp"
                    android:text="@string/cs_total_overdraft"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.16"/>
                <TextView
                    android:textSize="44dp"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/oc_total_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    app:layout_constraintStart_toStartOf="@+id/csTextview3"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview3"
                    style="@style/txt_number_s_b_b"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/init_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp26"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/increase_amount_tv"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_number_s_b_b"/>
                    <TextView
                        android:id="@+id/init_amount_date_tv"
                        android:text="@string/cs_initial_limit"
                        app:layout_constraintLeft_toLeftOf="@+id/init_amount_tv"
                        app:layout_constraintRight_toRightOf="@+id/init_amount_tv"
                        app:layout_constraintTop_toBottomOf="@+id/init_amount_tv"
                        style="@style/Text.202046.12"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/increase_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="@+id/init_amount_tv"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintLeft_toRightOf="@+id/init_amount_tv"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/init_amount_tv"
                        style="@style/txt_number_s_b_b"/>
                    <TextView
                        android:id="@+id/increase_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_total_limit_increased"
                        app:layout_constraintLeft_toLeftOf="@+id/increase_amount_tv"
                        app:layout_constraintRight_toRightOf="@+id/increase_amount_tv"
                        app:layout_constraintTop_toBottomOf="@+id/increase_amount_tv"
                        style="@style/Text.202046.12"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/oc_increase_content_ll"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingRight="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp26"
                    android:paddingHorizontal="@dimen/dp12">
                    <TextView
                        android:layout_marginTop="@dimen/dp16"
                        android:text="@string/cs_limit_increase_tasks"
                        style="@style/Text.medium.202046.16"/>
                    <TextView
                        android:id="@+id/more_task_second_title_tv"
                        android:layout_marginTop="@dimen/dp4"
                        android:text="@string/cs_oc_task_second_title"
                        style="@style/Text.6f7b85.12"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/increase_rv"
                        android:paddingTop="@dimen/dp8"
                        android:paddingBottom="@dimen/dp8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/dp8"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/complete_all_ll"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp26"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp12">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_overdraft_increase"
                        android:fontFamily="sans-serif-medium"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <ImageView
                            android:layout_width="@dimen/dp28"
                            android:layout_height="@dimen/dp28"
                            android:src="@drawable/cs_oc_complete_increase_icon"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp10">
                            <TextView
                                android:textColor="@color/ppColorTextPrimary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="More tasks are coming"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#858a8f"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Paying more with Flexi and repay on time can also increase credit limit."/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/record_ll"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp12">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/oc_amount_record_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_oc_increased_record"
                        android:drawableEnd="@drawable/cs_oc_record_increase_arrow"
                        android:fontFamily="sans-serif-medium"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/cs_oc_record_item_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/ppColorTextPrimary"
                                android:id="@+id/increase_name_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_oc_upgrade_mount"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#858a8f"
                                android:id="@+id/increase_date_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp3"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/record_increase_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
