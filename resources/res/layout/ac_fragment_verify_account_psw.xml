<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="@string/ac_psw_verification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/textViewMessage"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/ac_msg_input_psw"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_g"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:enabled="false"
        android:id="@+id/pinView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ac_psw_digit_height"
        android:layout_marginTop="36dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/ppColorTextBase"
        app:digitHeight="@dimen/ac_psw_digit_height"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/ac_psw_digit_space"
        app:digitStrokeColor="@color/ppColorTextDisable"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="@dimen/ac_psw_digit_text_size"
        app:digitWidth="@dimen/ac_psw_digit_width"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewMessage"
        app:mask="●"
        app:numDigits="6"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvForgotPsw"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_forget_psw"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/bottomView"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/core_number_keyboard_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
