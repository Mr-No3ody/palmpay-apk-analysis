<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mtn_root"
    android:background="@drawable/mtn_agreement_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/web_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>
    <ImageView
        android:id="@+id/mtn_close"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/mtn_close"
        android:layout_alignParentRight="true"/>
    <com.transsnet.mtn.sdk.ui.view.avloading.AVLoadingIndicatorView
        android:id="@+id/mtn_avi"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:indicatorName="com.transsnet.mtn.sdk.ui.view.avloading.BallSpinFadeLoaderIndicator"
        style="@style/AVLoadingIndicatorView"/>
</RelativeLayout>
