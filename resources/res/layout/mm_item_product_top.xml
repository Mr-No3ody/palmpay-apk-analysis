<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/cv_saving_futurn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/ppColorSuccess"
        android:id="@+id/tvSecurity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text=" Security Guaranteed"
        app:iiv_end_color="@color/ppColorSuccess"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp12"
        app:iiv_start_color="@color/ppColorSuccess"
        app:iiv_start_icon="pay_Security"
        app:iiv_start_size="@dimen/dp14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_title"
        style="@style/Text.6306b2.12"/>
    <ImageView
        android:id="@+id/iv_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_saving_plan_left"
        app:layout_constraintBottom_toBottomOf="@+id/tvSecurity"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSecurity"/>
    <com.transsnet.palmpay.main.export.ui.view.ModelNewCustomerSavings
        android:id="@+id/modelNewCustomerSavings"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
