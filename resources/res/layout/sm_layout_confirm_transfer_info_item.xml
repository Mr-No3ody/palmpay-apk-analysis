<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp48"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp8">
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_item_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cvGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.14"/>
    <ImageView
        android:id="@+id/iv_item_value_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_value"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_item_key"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsnet.palmpay.custom_view.AdjustTextView
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_item_value_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.14"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/cvGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
