<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/csl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp12">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp8"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:gravity="center_vertical"
            android:id="@+id/tvLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            app:layout_constraintLeft_toRightOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_me_b"/>
        <TextView
            android:id="@+id/tvLine2"
            android:paddingRight="60dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp2"
            android:paddingStart="10dp"
            android:paddingEnd="20dp"
            app:layout_constraintLeft_toRightOf="@+id/ivIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvLine1"
            style="@style/Text.9ca2aa.12"/>
        <View
            android:background="@drawable/cv_dash_line_gray_4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/tvLine2"/>
        <ImageView
            android:id="@+id/ivCorner"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp15"
            android:layout_marginTop="@dimen/dp3"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp6"
            app:layout_constraintStart_toEndOf="@+id/tvLine1"
            app:layout_constraintTop_toTopOf="@+id/tvLine1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_account_info"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/csl_top">
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center"
            android:id="@+id/tv_top_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/ci_msg_receive_money_from_bank"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_lgn"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvLevel"
            android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:includeFontPadding="false"
            android:drawablePadding="0dp"
            android:paddingStart="@dimen/dp6"
            android:paddingEnd="@dimen/dp4"
            android:layout_marginStart="@dimen/dp8"
            app:iiv_end_color="@color/ppColorPrimary"
            app:iiv_end_icon="pay_ArrowCenterRight"
            app:iiv_end_size="@dimen/dp10"
            app:layout_constraintBottom_toBottomOf="@+id/tv_top_tip"
            app:layout_constraintStart_toEndOf="@+id/tv_top_tip"
            app:layout_constraintTop_toTopOf="@+id/tv_top_tip"/>
        <ImageView
            android:id="@+id/ivLevel"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/tvLevel"
            app:layout_constraintStart_toStartOf="@+id/tvLevel"
            app:layout_constraintTop_toTopOf="@+id/tvLevel"/>
        <TextView
            android:textSize="@dimen/dp28"
            android:gravity="center_vertical"
            android:id="@+id/tvAccountNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_top_tip"
            style="@style/txt_number_s_b_b"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/rtvShare"
            android:layout_width="0dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="@dimen/dp12"
            android:text="Share Detail"
            app:layout_constraintLeft_toRightOf="@+id/rtvCopy"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAccountNo"
            style="@style/ppButtonStyle"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/rtvCopy"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/dp12"
            android:text="Copy Number"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/rtvShare"
            app:layout_constraintTop_toBottomOf="@+id/tvAccountNo"
            style="@style/ppSecondaryButtonStyle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llSourceView"
            android:background="@drawable/ci_rect_corner_100_bg_f6f6fa"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/rtvShare">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:gravity="left"
                android:id="@+id/tvContent"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                style="@style/Text.202046.12"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_ArrowCenterRight"
                app:iiv_size="@dimen/dp20"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/ivExchange"
        android:background="@drawable/cv_rect_bg_secondary_primary_corner_tl_bl_24"
        android:paddingLeft="@dimen/dp6"
        android:paddingRight="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp11"
        android:text="@string/ci_privacy_account_no"
        android:paddingHorizontal="@dimen/dp6"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_Exchange"
        app:iiv_start_size="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_account_info"
        style="@style/Text.6306b2.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
