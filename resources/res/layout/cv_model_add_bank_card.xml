<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mabc_root"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp70">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/mabc_access_bank_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_centerVertical="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_AddOutline"
        app:iiv_size="@dimen/dp35"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_toRightOf="@+id/mabc_access_bank_iv"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/mabc_title_text_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_add_bank_card"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/mabc_hint_text_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cv_unsupported_now"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp15"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Arrowdown"
        app:iiv_size="16dp"/>
</RelativeLayout>
