<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootOutstandingSummary"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp12"
    android:paddingEnd="@dimen/dp12">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutWaiver"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/cs_color_bg_item"
                android:gravity="center"
                android:id="@+id/tvWaiverBadge"
                android:background="@drawable/cs_cl_loan_fully_bj"
                android:layout_width="@dimen/dp120"
                android:layout_height="@dimen/dp20"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/cs_cl_installment_amount_text_color"
                    android:id="@+id/tvCountdownDayHour"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/llCountdownHms"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/cs_cl_installment_amount_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_waiver_countdown_ends_in"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorAssist"
                        android:gravity="center"
                        android:id="@+id/tvCountdownHour"
                        android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:layout_marginStart="@dimen/dp4"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp3"
                        android:layout_marginRight="@dimen/dp3"
                        android:text=":"
                        android:layout_marginHorizontal="@dimen/dp3"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorAssist"
                        android:gravity="center"
                        android:id="@+id/tvCountdownMinute"
                        android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp3"
                        android:layout_marginRight="@dimen/dp3"
                        android:text=":"
                        android:layout_marginHorizontal="@dimen/dp3"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorAssist"
                        android:gravity="center"
                        android:id="@+id/tvCountdownSecond"
                        android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvWaiverAmountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp4"
                    android:layout_marginVertical="@dimen/dp4">
                    <TextView
                        android:textSize="@dimen/dp20"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/tvWaiverCurrentAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/tvWaiverOriginalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp4"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvWaiverSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorAssist"
                android:id="@+id/tvSettleNow"
                android:background="@drawable/cs_cl_loan_settle_now_bg"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp2"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_waiver_settle_now"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp2"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLegacy"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintEnd_toStartOf="@+id/tvRepay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/cs_overdue_today_txt_color"
            android:ellipsize="end"
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintEnd_toStartOf="@+id/tvRepay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <TextView
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:id="@+id/tvRepay"
            android:background="@drawable/cs_corner_16_bg_00a49a"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp24"
            android:minWidth="@dimen/dp44"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
