<?xml version="1.0" encoding="utf-8"?>
<androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/digital_keyboard_view"
    android:background="@color/ppColorBackgroundDark"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="@dimen/core_digit_keyboard_height"
    android:useDefaultMargins="false"
    app:columnCount="4"
    app:rowCount="4">
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit1"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="7dp"
        android:text="@string/core_digit_1"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit2"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="7dp"
        android:text="@string/core_digit_2"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit3"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="7dp"
        android:text="@string/core_digit_3"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <FrameLayout
        android:id="@+id/delete"
        android:background="@drawable/cv_keyboard_delete_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="4dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_Backspace"
            app:iiv_size="24dp"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit4"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_4"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit5"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_5"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit6"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_6"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:id="@+id/keyboard_action"
        android:background="@drawable/cv_keyboard_transfer_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/core_next"
        app:layout_columnWeight="1"
        app:layout_rowSpan="3"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit7"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_7"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit8"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_8"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit9"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/core_digit_9"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit00"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/digit0"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:text="@string/core_digit_0"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/point"
        android:background="@drawable/cv_keyboard_digital_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:text="@string/core_digit_dot"
        android:fontFamily="sans-serif"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
</androidx.gridlayout.widget.GridLayout>
