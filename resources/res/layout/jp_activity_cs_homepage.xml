<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#5730c3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toBottomOf="@+id/statusBarView"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="@string/jp_refer_earn"
        app:title_bar_title_color="@color/ppColorBackgroundLight"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewNotify"
        android:background="@drawable/jp_notification_bg1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivNotify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp14"
            app:iiv_color="@color/ppColorTextBase"
            app:iiv_icon="pay_Notification"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewSwitcher
            android:id="@+id/jp_my_cash_switcher"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp24"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvRank"
            app:layout_constraintStart_toEndOf="@+id/ivNotify"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jp_ranking"
            android:layout_marginEnd="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_w_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.custom_view.ObservableScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewNotify">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/viewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintTop_toTopOf="parent"/>
                <include
                    android:id="@+id/jp_my_cash_reward_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="125dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/jp_layout_cs_homepage_progress"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAmountBg"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintBottom_toTopOf="@+id/jp_my_cash_reward_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ViewStub
                android:id="@+id/jp_invite_list_layout"
                android:layout="@layout/jp_layout_cs_homepage_invite_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/jp_who_invite_list_layout"
                android:layout="@layout/jp_layout_cs_homepage_who_invite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
        </LinearLayout>
    </com.transsnet.palmpay.custom_view.ObservableScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
