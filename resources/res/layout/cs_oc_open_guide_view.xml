<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="@dimen/dp36"
        app:title_bar_back_icon="@drawable/cs_oc_back_bg"
        app:title_bar_title="@string/core_loan"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/cv_shape_rect_corner_tl_tr_8_bg_secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp28"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_buy_now_pay_later_icon"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_bottom_corner_white_12"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="14dp"
                    android:id="@+id/tvTitle"
                    android:text="Flexi Credit Limit"
                    android:drawableLeft="@drawable/cv_flexi_icon"
                    android:drawablePadding="@dimen/dp4"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.16"/>
                <TextView
                    android:textSize="@dimen/dp40"
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:text="₦500,000"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                    style="@style/txt_number_me_b_b"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp4"
                    android:text="up to"
                    app:layout_constraintLeft_toRightOf="@+id/tvAmount"
                    app:layout_constraintTop_toTopOf="@+id/tvAmount"
                    style="@style/Text.6f7b85.10"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layoutLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAmount">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cs_checked_gray_icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:text="Available for all bill payments in PalmPay"
                        style="@style/Text.6f7b85.14"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layoutMiddle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutLeft">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cs_checked_gray_icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:text="Available for all bill payments in PalmPay"
                        style="@style/Text.6f7b85.14"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layoutRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutMiddle">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cs_checked_gray_icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:text="Available for all bill payments in PalmPay"
                        style="@style/Text.6f7b85.14"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/layoutRight">
                    <TextView
                        android:textColor="@color/cv_color_ffffff"
                        android:gravity="center"
                        android:id="@+id/open_flexi_tv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:text="@string/cs_oc_get_money_now"
                        android:fontFamily="sans-serif-medium"
                        style="@style/ppButtonStyle"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/cv_finger2"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="@dimen/dp48"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.transsnet.palmpay.credit.view.FlexiUserEvaluationView
                android:id="@+id/flexiUserEvalutionView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:businessType="flexi_both_cash"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
                android:id="@+id/viewLoanHomeBottomInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:layout_marginVertical="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
