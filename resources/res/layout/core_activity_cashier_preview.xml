<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/groupPreview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_top_transparent_bg"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.12"
        app:layout_constraintTop_toTopOf="parent"/>
    <include layout="@layout/core_activity_cashier_preview_sub_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_cashier_confirm_to_pay"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:id="@+id/tv_confirm_to_pay"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:text="@string/core_confirm_to_pay"
            style="@style/txt_me_w"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_cashier_activate_flexi_pay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12">
                <ImageView
                    android:id="@+id/iv_flexi_pay_agreement"
                    android:layout_width="@dimen/dp18"
                    android:layout_height="@dimen/dp18"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tv_flexi_pay_agreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/core_flexi_pay_agreement"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp8"/>
            </LinearLayout>
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/tv_activate_flexi_pay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ppButtonHeight"
                android:text="@string/core_flexi_pay_activate_and_pay"
                android:textAllCaps="false"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
