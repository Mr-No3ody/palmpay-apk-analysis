<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/cv_logo_with_circle"
            android:scaleType="fitXY"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvLine1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_msg_request_submitted"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <View
        android:id="@+id/viewLine1"
        android:background="#b571ff"
        android:layout_width="@dimen/dp1"
        android:layout_height="26dp"
        android:layout_marginLeft="15dp"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:background="#b571ff"
                android:layout_width="@dimen/dp1"
                android:layout_height="8dp"
                android:layout_marginLeft="15dp"
                android:layout_alignParentTop="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:src="@drawable/cv_pending_purple"
                android:scaleType="fitXY"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/core_msg_transaction_processing"
                style="@style/txt_s_b"/>
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvLine21"
                android:paddingTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/core_msg_expected_to_arrive_in_30_mins"
                style="@style/txt_mi_b"/>
        </LinearLayout>
    </LinearLayout>
    <com.transsnet.palmpay.custom_view.model.DividerView
        android:id="@+id/viewLine2"
        android:layout_width="@dimen/dp1"
        android:layout_height="26dp"
        android:layout_marginLeft="15dp"
        app:dvDashGap="1dp"
        app:dvDashLength="2dp"
        app:dvDashThickness="1dp"
        app:dvLineColor="#c1ccd5"
        app:dvOrientation="vertical"/>
    <com.transsnet.palmpay.custom_view.model.DividerView
        android:id="@+id/viewLine3"
        android:visibility="gone"
        android:layout_width="@dimen/dp1"
        android:layout_height="26dp"
        android:layout_marginLeft="15dp"
        app:dvDashGap="0dp"
        app:dvDashLength="0dp"
        app:dvDashThickness="1dp"
        app:dvLineColor="#b571ff"
        app:dvOrientation="vertical"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/cv_pay_success_gray"
            android:scaleType="fitXY"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:layout_toRightOf="@+id/ivResult"
            android:layout_toEndOf="@+id/ivResult">
            <TextView
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:id="@+id/tvLine31"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/txt_s_b"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvLine32"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/core_msg_wait_for_notification"
                style="@style/txt_s_g"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
