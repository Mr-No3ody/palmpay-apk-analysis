<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="CashBox"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtb">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
                android:id="@+id/adView"
                android:paddingLeft="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:layout_marginBottom="12dp"
                android:drawablePadding="@dimen/dp5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:slot_id="@string/ad_cashbox_top_banner"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeader"
                android:background="@drawable/mm_shape_rect_corner_lt_rt_12_bg_202046"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/adView">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/mm_cashbox_header_vector"/>
                <ImageView
                    android:id="@+id/tvCashBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/mm_icon_cash_box_main_title"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutSecurityGuaranteed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:layout_marginRight="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCashBoxTitle">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivSecurityGuaranteed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        app:iiv_color="@color/ppColorSuccess"
                        app:iiv_icon="pay_Security"
                        app:iiv_size="@dimen/dp16"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintRight_toLeftOf="@+id/tvSecurityGuaranteed"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textColor="@color/ppColorSuccess"
                        android:gravity="center_vertical"
                        android:id="@+id/tvSecurityGuaranteed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mm_security_guaranteed"
                        app:iiv_end_color="@color/ppColorSuccess"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.6306b2.12"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/barrier"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/layoutHeader"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_basic_container"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/barrier">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutBalanceInfo"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/mm_color_balance_eye"
                            android:id="@+id/tvBalance"
                            android:text="@string/core_palmpay_payment_balance"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Text.9ca2aa.14"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivToggleShowBalance"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="@dimen/dp4"
                            app:iiv_color="@color/mm_color_balance_eye"
                            app:layout_constraintBottom_toBottomOf="@+id/tvBalance"
                            app:layout_constraintLeft_toRightOf="@+id/tvBalance"
                            app:layout_constraintTop_toTopOf="@+id/tvBalance"/>
                        <com.transsnet.palmpay.custom_view.RoundedTextView
                            android:textColor="@color/ppColorError"
                            android:id="@+id/rtvAccountStatus"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp42"
                            android:layout_height="16dp"
                            android:layout_marginLeft="@dimen/dp4"
                            android:text="Frozen"
                            app:layout_constraintBottom_toBottomOf="@+id/ivToggleShowBalance"
                            app:layout_constraintLeft_toRightOf="@+id/ivToggleShowBalance"
                            app:layout_constraintTop_toTopOf="@+id/ivToggleShowBalance"
                            app:rtv_background_color="@color/cv_color_ffffff"
                            app:rtv_border_color="@color/ppColorError"
                            app:rtv_border_width="@dimen/dp1"
                            app:rtv_corner_radius="@dimen/dp4"
                            style="@style/Text.979797.10"/>
                    </LinearLayout>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvBalanceAmount"
                        android:layout_marginTop="@dimen/dp6"
                        android:layout_marginBottom="@dimen/dp2"
                        android:text="--"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_container"
                        style="@style/Text.medium.202046.32"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivWarn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp4"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_InformationOutline"
                        app:iiv_size="@dimen/dp16"
                        app:layout_constraintBottom_toBottomOf="@+id/tvBalanceAmount"
                        app:layout_constraintLeft_toRightOf="@+id/tvBalanceAmount"
                        app:layout_constraintTop_toTopOf="@+id/tvBalanceAmount"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/frozenLayout"
                        android:paddingBottom="@dimen/dp3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvBalanceAmount">
                        <TextView
                            android:id="@+id/tvFrozenText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.9ca2aa.12"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivFrozonWarn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            app:iiv_color="@color/ppColorTextAssist"
                            app:iiv_icon="pay_InformationOutline"
                            app:iiv_size="@dimen/dp16"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/iv_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/mm_icon_arrow_up_interest"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/frozenLayout"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutInterestInfo"
                        android:background="@drawable/mm_rect_corner_24_bg_f6f6fa"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp16"
                        android:paddingBottom="@dimen/dp4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="220dp"
                        android:paddingVertical="@dimen/dp4"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_arrow">
                        <TextView
                            android:textColor="@color/ppColorTextAssist"
                            android:id="@+id/tvYesterdayReturn"
                            android:text="@string/mm_yesterday_return"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Text.202046.12"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp4"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvYesterdayReturn">
                            <TextView
                                android:textColor="@color/ppColorSuccess"
                                android:id="@+id/tvYesterdayReturnAmount"
                                android:text="--"
                                android:textFontWeight="500"
                                style="@style/Text.medium.ffffff.14"/>
                            <View
                                android:id="@+id/v_trial_line"
                                android:background="#c0c3c8"
                                android:visibility="gone"
                                android:layout_width="@dimen/dp1"
                                android:layout_height="@dimen/dp8"
                                android:layout_marginLeft="@dimen/dp4"
                                android:layout_marginRight="@dimen/dp4"
                                android:layout_marginHorizontal="@dimen/dp4"/>
                            <com.mikepenz.iconics.view.IconicsTextView
                                android:textColor="@color/ppColorSuccess"
                                android:gravity="center_vertical"
                                android:id="@+id/tvTrialCashYesterdayReturnAmount"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:drawablePadding="2dp"
                                app:iiv_end_color="@color/ppColorSuccess"
                                app:iiv_end_icon="pay_ArrowCenterRight"
                                app:iiv_end_size="@dimen/dp12"
                                style="@style/Text.medium.ffffff.14"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutTotalInterestInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/layoutRateInfo"
                        app:layout_constraintTop_toBottomOf="@+id/layoutInterestInfo">
                        <TextView
                            android:textColor="#9ca2aa"
                            android:id="@+id/tv_total_interest"
                            android:text="Total Interest"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Text.6f7b85.12"/>
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/tvTotalReturnAmount"
                            android:layout_height="22dp"
                            android:layout_marginTop="@dimen/dp3"
                            android:text="--"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_total_interest"
                            style="@style/Text.medium.202046.16"/>
                        <com.transsnet.palmpay.custom_view.RoundedTextView
                            android:id="@+id/rtvWithdraw"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp48"
                            android:layout_marginTop="@dimen/dp16"
                            android:text="@string/mm_withdraw_title"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvTotalReturnAmount"
                            app:rtv_background_color="@color/ppColorSecondary"
                            app:rtv_border_width="0dp"
                            app:rtv_corner_radius="@dimen/dp12"
                            style="@style/Text.medium.6306b2.16"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutRateInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="@dimen/dp16"
                        app:layout_constraintLeft_toRightOf="@+id/layoutTotalInterestInfo"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layoutInterestInfo">
                        <TextView
                            android:textColor="#9ca2aa"
                            android:id="@+id/tv_rate_name"
                            android:text="Interest Rate"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Text.6f7b85.12"/>
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/rtvInterestRate"
                            android:layout_height="22dp"
                            android:layout_marginTop="@dimen/dp3"
                            android:text="--"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_rate_name"
                            style="@style/Text.medium.202046.16"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivRateWarn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dp8"
                            app:iiv_color="@color/ppColorTextPrimary"
                            app:iiv_icon="pay_ArrowRight"
                            app:iiv_size="@dimen/dp16"
                            app:layout_constraintBottom_toBottomOf="@+id/rtvInterestRate"
                            app:layout_constraintLeft_toRightOf="@+id/rtvInterestRate"
                            app:layout_constraintTop_toTopOf="@+id/rtvInterestRate"/>
                        <com.transsnet.palmpay.custom_view.RoundedTextView
                            android:textColor="@color/md_white_1000"
                            android:id="@+id/rtvSave"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp48"
                            android:layout_marginTop="@dimen/dp16"
                            android:text="@string/core_add_money"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rtvInterestRate"
                            app:rtv_background_color="@color/ppColorPrimary"
                            app:rtv_corner_radius="@dimen/dp12"
                            style="@style/Text.medium.ffffff.16"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorWarning"
                        android:gravity="center"
                        android:id="@+id/tvDailyIncome"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layoutTotalInterestInfo"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layoutAutoSave"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp8"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_AutoSave"
                        app:iiv_size="@dimen/dp20"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:gravity="left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mm_auto_save_to_cashbox"
                            style="@style/Text.202046.12"/>
                        <TextView
                            android:textColor="@color/ppColorTextNormal"
                            android:gravity="left"
                            android:id="@+id/tvAutoSaveSec"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turn it on to earn money daily!"
                            style="@style/Text.202046.12"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="@color/ppColorError"
                        android:id="@+id/tvAutoSave"
                        android:paddingLeft="@dimen/dp6"
                        android:paddingRight="@dimen/dp6"
                        android:layout_height="@dimen/dp18"
                        style="@style/Text.medium.202046.12"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowCenterRight"
                        app:iiv_size="@dimen/dp20"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trialCashModule"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/ll_basic_container">
                <ImageView
                    android:id="@+id/iv_trial_cash_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clTrialCash"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    android:paddingHorizontal="@dimen/dp16">
                    <ImageView
                        android:id="@+id/iv_trial_cash"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/cv_trial_cash_logo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/tvExperienceGoldBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/iv_trial_cash"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorPrimary"
                        android:id="@+id/tvExperienceGoldUnclaimed"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp24"
                        android:minWidth="@dimen/dp52"
                        android:text="Start"
                        android:paddingHorizontal="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.medium.ffffff.12"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.banner.BannerAdView
                android:id="@+id/viewAd"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:ad_rounded_corners="@dimen/dp8"
                app:layout_constraintTop_toBottomOf="@+id/trialCashModule"
                app:slot_id="@string/savings_cashbox_homepage_mid_banner"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutSad"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="16dp"
                android:divider="@drawable/mm_bg_transparent_v_divider_8"
                android:showDividers="middle"
                app:layout_constraintTop_toBottomOf="@+id/viewAd"
                app:layout_goneMarginTop="@dimen/dp12">
                <TextView
                    android:textStyle="bold"
                    android:id="@+id/tvMiddleAdTitle"
                    android:layout_marginLeft="16dp"
                    android:text="Want Higher Returns?"
                    style="@style/Text.202046.14"/>
                <ImageView
                    android:id="@+id/iv_middlePicUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/cv_shape_rect_corner_bl_br_12_bg_dark"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/ppColorSecondary">
                    <TextView
                        android:gravity="left"
                        android:id="@+id/tvMiddleAdContent"
                        android:layout_width="0dp"
                        android:text="Upgrade to fixed savings to earn more "
                        android:layout_weight="1"
                        style="@style/Text.medium.6306b2.12"/>
                    <TextView
                        android:id="@+id/rtvGo"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp24"
                        android:text="Go"
                        style="@style/Text.medium.ffffff.12"/>
                </LinearLayout>
            </LinearLayout>
            <com.github.xiaofeidev.shadow.ShadowFrameLayout
                android:id="@+id/layoutTransactionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:layout_constraintTop_toBottomOf="@+id/layoutSad"
                app:shadow_blur_radius="@dimen/dp12"
                app:shadow_color="@color/cv_color_1e1e1e_4"
                app:shadow_corner_radius="@dimen/dp12">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constrainedHeight="true">
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvRecentTransaction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp22"
                        android:layout_marginRight="@dimen/dp22"
                        android:text="@string/mm_recent_transaction"
                        android:includeFontPadding="false"
                        android:drawablePadding="4dp"
                        app:iiv_end_color="@color/ppColorTextPrimary"
                        app:iiv_end_size="@dimen/dp16"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.medium.202046.16"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp22"
                        android:text="@string/core_more"
                        android:includeFontPadding="false"
                        android:drawablePadding="4dp"
                        app:iiv_end_color="@color/ppColorTextAssist"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/tvRecentTransaction"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvRecentTransaction"
                        style="@style/Text.9ca2aa.12"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/tvIncomeAmount"
                        android:visibility="gone"
                        android:layout_marginLeft="@dimen/dp22"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp22"
                        android:lines="1"
                        android:drawableLeft="@drawable/cv_icon_income"
                        android:drawablePadding="@dimen/dp4"
                        app:autoSizeMaxTextSize="12dp"
                        app:autoSizeMinTextSize="@dimen/dp4"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvRecentTransaction"
                        style="@style/Text.202046.12"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:gravity="center"
                        android:id="@+id/tvExpenditureAmount"
                        android:visibility="gone"
                        android:layout_marginLeft="22dp"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp22"
                        android:lines="1"
                        android:drawableLeft="@drawable/cv_icon_expenditure"
                        android:drawablePadding="@dimen/dp4"
                        app:autoSizeMaxTextSize="12dp"
                        app:autoSizeMinTextSize="@dimen/dp4"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintLeft_toRightOf="@+id/tvIncomeAmount"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvRecentTransaction"
                        style="@style/Text.202046.12"/>
                    <View
                        android:id="@+id/vDivider"
                        android:background="@color/ppColorDividerLine"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/dp22"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginRight="@dimen/dp22"
                        app:layout_constraintTop_toBottomOf="@+id/tvIncomeAmount"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTransactionList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp6"
                        android:layout_marginRight="@dimen/dp6"
                        app:layout_constraintTop_toBottomOf="@+id/vDivider"/>
                    <com.transsnet.palmpay.custom_view.EmptyView
                        android:id="@+id/emptyView"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="202dp"
                        app:cv_ev_tips="@string/mm_no_transaction_record"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/vDivider"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.github.xiaofeidev.shadow.ShadowFrameLayout>
            <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutTransactionHistory"
                app:layout_constraintVertical_bias="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
