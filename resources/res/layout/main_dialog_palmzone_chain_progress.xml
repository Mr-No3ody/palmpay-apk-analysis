<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_top_bg_rewards"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCard"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-32dp"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHeader">
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end"
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:lineSpacingMultiplier="1.3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTomorrowBadge"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp4"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp4"
            android:paddingBottom="@dimen/dp8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp4"
            android:paddingVertical="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/tvTomorrowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/main_chain_progress_tomorrow_reward_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llTomorrowReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTomorrowLabel">
                <ImageView
                    android:id="@+id/ivTomorrowIcon"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    app:srcCompat="@drawable/cv_palmpay_icon_yellow"/>
                <TextView
                    android:textSize="@dimen/dp18"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/tvTomorrowReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp4"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="clTomorrowBadge, tvMessage"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/btnOk"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_ok1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"
            style="@style/ppButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
