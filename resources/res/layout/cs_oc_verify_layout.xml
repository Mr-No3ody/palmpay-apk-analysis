<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_media_top_bar"
        layout="@layout/cs_oc_router_top_bar"/>
    <com.transsnet.palmpay.credit.view.OpenAccountRouterProgressViewV2
        android:id="@+id/router_progress_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp18"
        android:text="@string/cs_oc_input_otp_title"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:id="@+id/phone_number_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.transsnet.palmpay.core.viewmodel.OneTimeCodeV2View
        android:layout_gravity="center_horizontal"
        android:id="@+id/otp_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textColor="#9200ff"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/contact_us_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp20"
        android:text="@string/cs_oc_otp_contact_us"
        style="@style/txt_s_g"/>
</LinearLayout>
