<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/viewRoot"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="86dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_expand"
                android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp36"
                    android:scaleType="fitXY"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/core_coupon_middle"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/icil_text_tv2"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/iv_shadow"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tvUnavailableReason"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/icil_text_tv2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="106dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/rl_left"
                android:background="@drawable/core_coupon_frame_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <ImageView
                        android:id="@+id/icii_coupon_icon"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:layout_marginLeft="@dimen/dp12"
                        android:src="@drawable/cv_coupon_icon"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp14"
                        android:layout_toRightOf="@+id/icii_coupon_icon">
                        <TextView
                            android:textSize="@dimen/dp22"
                            android:textColor="@color/ppColorPrimary"
                            android:id="@+id/icil_amount_tv"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp6"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:ellipsize="end"
                            android:id="@+id/icil_title_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/icil_text_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textFontWeight="400"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="left"
                    android:id="@+id/icil_text_tv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp15"
                    android:layout_marginRight="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp8"
                    android:includeFontPadding="false"
                    android:layout_toLeftOf="@+id/llDetailArrow"
                    android:layout_alignParentBottom="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/llDetailArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/tvDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cv_detail"
                        android:includeFontPadding="false"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/icii_iv_expand"
                        android:layout_width="@dimen/dp12"
                        android:layout_height="@dimen/dp12"
                        app:iiv_color="@color/ppColorTextNormal"
                        app:iiv_icon="pay_Arrowdown"
                        app:iiv_size="@dimen/dp12"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_right"
                android:background="@drawable/core_coupon_frame_right"
                android:layout_width="@dimen/dp100"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/dp24"
                    android:textColor="@color/ppColorButtonTextWhite"
                    android:gravity="center"
                    android:id="@+id/icil_coupon_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/icil_use_tv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp64"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/core_use"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/imageViewCheck"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:src="@drawable/core_coupon_uncheck_black"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:paddingStart="8dp"
        android:layout_alignParentEnd="true"/>
</LinearLayout>
