<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:textSize="24dp"
        android:gravity="center_vertical"
        android:id="@+id/tvLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/ac_proof_of_address"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_vertical"
        android:id="@+id/tvSubtitle"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/tvLine1"
        app:lineHeight="@dimen/dp20"
        style="@style/txt_s_g"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivPhotoFrame"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:src="@drawable/ac_default_photo_frame"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.transsnet.palmpay.custom_view.image.RoundImageView
                android:id="@+id/ivImage"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:scaleType="fitCenter"
                app:cvBackgroundColor="@color/ppColorBackgroundDark"
                app:cvRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/viewReupload"
                android:background="@drawable/cv_rect_bg_mask_corner_bl_br_12"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivImage"
                app:layout_constraintEnd_toEndOf="@+id/ivImage"
                app:layout_constraintStart_toStartOf="@+id/ivImage">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/md_white_1000"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/tvReupload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reupload"
                    android:drawablePadding="4dp"
                    app:iiv_start_color="@color/md_white_1000"
                    app:iiv_start_icon="pay_CameraFill"
                    app:iiv_start_size="@dimen/dp20"/>
            </FrameLayout>
            <com.mikepenz.iconics.view.IconicsTextView
                android:gravity="center"
                android:id="@+id/tvAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_upload_utility_bill_title"
                android:drawablePadding="8dp"
                android:lineSpacingExtra="2dp"
                app:iiv_top_color="@color/ppColorTextPrimary"
                app:iiv_top_icon="pay_CameraOutline"
                app:iiv_top_size="@dimen/dp44"
                app:layout_constraintBottom_toBottomOf="@+id/ivPhotoFrame"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivPhotoFrame"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDelete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:iiv_color="@color/transparent_70"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="24dp"
                app:layout_constraintEnd_toEndOf="@+id/ivPhotoFrame"
                app:layout_constraintTop_toTopOf="@+id/ivPhotoFrame"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/msgBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="ivPhotoFrame, viewReupload"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="center_vertical"
                android:id="@+id/tvBillError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@+id/msgBarrier"
                style="@style/txt_mi_g"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ac_view_utility_bill_sample"
            style="@style/txt_s_g"/>
    </LinearLayout>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/textNext"
        app:slot_id="C2E1513B50054D898B9950EB72C67862"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/textNext"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/core_next"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
