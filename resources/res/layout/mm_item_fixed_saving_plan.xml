<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_contain"
        android:background="@drawable/mm_bg_product_info"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:src="@drawable/cv_fixed_saving"
            app:layout_constraintBottom_toBottomOf="@+id/tvProductRatio"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvProductName"/>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginRight="@dimen/dp40"
            android:singleLine="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/ivIcon"
            app:layout_constraintRight_toLeftOf="@+id/tvPlanStatus"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/tvProductRatio"
            app:layout_constraintLeft_toLeftOf="@+id/tvProductName"
            app:layout_constraintTop_toBottomOf="@+id/tvProductName"
            style="@style/Text.9ca2aa.12"/>
        <View
            android:id="@+id/vLine"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="12dp"
            app:layout_constraintLeft_toLeftOf="@+id/ivIcon"
            app:layout_constraintTop_toBottomOf="@+id/ivIcon"/>
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/tvAmountTitle"
            android:layout_marginTop="@dimen/dp12"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="@+id/ivIcon"
            app:layout_constraintTop_toBottomOf="@+id/vLine"
            style="@style/Text.9ca2aa.10"/>
        <TextView
            android:id="@+id/tvPrincipalAmount"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="@+id/tvAmountTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvAmountTitle"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:id="@+id/tvPlanStatus"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.6306b2.12"/>
        <TextView
            android:id="@+id/tvAutoRenel"
            android:background="@drawable/mm_shape_rect_corner_4_bg_white_stroke_purple"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:text="Auto-Renewal Enabled"
            android:textAlignment="center"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvProductRatio"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvProductRatio"
            style="@style/Text.6306b2.10"/>
        <TextView
            android:id="@+id/tvInterestAmountTitle"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/tvAmountTitle"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAmountTitle"
            style="@style/Text.9ca2aa.10"/>
        <TextView
            android:id="@+id/tvInterestAmount"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrincipalAmount"
            app:layout_constraintRight_toLeftOf="@+id/imageViewNext"
            app:layout_constraintTop_toTopOf="@+id/tvPrincipalAmount"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/imageViewNext"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrincipalAmount"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvPrincipalAmount"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clsAdvance"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="-14dp"
        android:translationZ="-9dp"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/cls_contain">
        <TextView
            android:id="@+id/tvAdvanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Text.202046.12"/>
        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Text.202046.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
