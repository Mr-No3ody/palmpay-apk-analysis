<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbri_root"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp15"
    android:paddingTop="@dimen/dp16"
    android:paddingRight="@dimen/dp15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_history_icon"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_history_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:fontFamily="sans-serif-medium"
        android:paddingEnd="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/dp5"
        app:layout_constraintLeft_toRightOf="@+id/iv_history_icon"
        app:layout_constraintRight_toLeftOf="@+id/barrier_history_item_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="bottom|right"
        android:id="@+id/tv_history_pay_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_history_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="12sp"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/rtv_history_buy_again"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dp5"
        android:text="@string/qt_buy_again"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_history_pay_amount"
        app:rtv_background_color="@color/color_foecfc"
        app:rtv_corner_radius="8dp"
        style="@style/txt_mi_w"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tv_history_order_status_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_history_pay_amount"
        style="@style/Text.medium.6306b2.12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_history_item_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="rtv_history_buy_again,tv_history_pay_amount,tv_history_order_status_desc"/>
    <TextView
        android:id="@+id/tv_history_order_time"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/tv_history_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_history_content"
        style="@style/txt_mi_lg"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_history_item_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_history_icon,tv_history_order_time,tv_history_order_status_desc,rtv_history_buy_again"/>
    <View
        android:id="@+id/view_history_item_divider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/barrier_history_item_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
