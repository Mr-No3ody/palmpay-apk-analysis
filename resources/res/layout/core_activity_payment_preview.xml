<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingTop="0dp"
        android:paddingBottom="70dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_preview_dialog_title_height"
            layout="@layout/cv_layout_preview_dialog_title"/>
        <com.transsnet.palmpay.custom_view.ReboundScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer
                android:orientation="vertical"
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemAmount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_amount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemFee"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_fee"/>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextDisable"
                    android:gravity="left"
                    android:id="@+id/itemFeeRemark"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemCoins"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_text_color="@color/ppColorError"
                    app:cv_bm_title="@string/core_coins_to_use"/>
                <com.transsnet.palmpay.core.viewmodel.ModelUsePointsWithSwitch
                    android:id="@+id/itemPointToUse"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelDiscountItem
                    android:id="@+id/itemDiscount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelCouponItem
                    android:id="@+id/itemCoupon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_tips_text="@string/core_msg_coupon_rules"
                    app:cv_bm_title="@string/core_coupon_to_use"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemDataBonusEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_title="@string/core_data_bonus_earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemPointToEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_amount_sign="₦"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_tips_text="@string/core_msg_points_rules"
                    app:cv_bm_title="@string/core_points_to_earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemCommissionToEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_title="@string/core_commission_to_earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
                    android:id="@+id/itemPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <com.transsnet.palmpay.core.viewmodel.ModelApplyOkCard
                    android:id="@+id/viewApplyOkCard"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="@dimen/dp15"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
            </com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer>
        </com.transsnet.palmpay.custom_view.ReboundScrollView>
    </LinearLayout>
    <TextView
        android:enabled="true"
        android:textAppearance="@style/txt_b_w"
        android:textColor="@color/cv_text_color_white"
        android:gravity="center"
        android:id="@+id/textViewNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/core_pay"
        android:layout_alignParentBottom="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="@dimen/core_default_elevation"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
