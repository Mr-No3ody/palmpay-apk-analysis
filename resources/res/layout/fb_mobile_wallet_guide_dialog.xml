<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/fb_dp8"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/fb_base_gray_1_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/fb_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/fb_base_gray_2_color"
                android:id="@+id/fb_mobile_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/fb_base_gray_2_color"
                android:id="@+id/fb_guide_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="30dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/fb_confirm_tv"
                android:background="@drawable/fb_next_btn_selector_bg"
                android:layout_width="200dp"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="30dp"
                android:text="@string/fb_confirm"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
