<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_1_iv="true"/>
    <FrameLayout
        android:id="@+id/flBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.core.viewmodel.ModelBillNoticeItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cv_notice_category_id="1"
                    app:cv_notice_slot_id="@string/billpayment_ele_text_ad"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12">
                    <com.transsnet.palmpay.custom_view.ModelItemSelection
                        android:id="@+id/tev_select_biller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cv_item_selection_start_icon_visible="true"
                        app:cv_item_selection_title_visible="false"
                        app:cv_item_selection_value_max_line="2"
                        app:cv_item_selection_value_text_size="@dimen/dp16"/>
                    <com.transsnet.palmpay.teller.ui.view.ModelBillerTipsInfo
                        android:id="@+id/operatorMsgLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <TextView
                        android:textColor="@color/ppColorWarning"
                        android:gravity="top|center_horizontal"
                        android:id="@+id/tvOutstanding"
                        android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_12"
                        android:paddingTop="@dimen/dp3"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp34"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.202046.12"/>
                    <Space
                        android:id="@+id/space_outstanding_layout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/tvOutstanding"
                        app:layout_goneMarginBottom="0dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_select_payment_item"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingTop="@dimen/dp12"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp16"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintTop_toBottomOf="@+id/space_outstanding_layout">
                        <com.transsnet.palmpay.custom_view.ModelItemSelection
                            android:id="@+id/tev_select_payment_item"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cv_item_selection_title="@string/qt_payment_item"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textColor="@color/ppColorTextBase"
                            android:gravity="center"
                            android:id="@+id/tv_payment_item_cashback"
                            android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp18"
                            android:layout_marginTop="@dimen/dp2"
                            android:paddingStart="@dimen/dp7"
                            android:paddingEnd="@dimen/dp7"
                            android:layout_marginStart="@dimen/dp90"
                            app:layout_constraintStart_toStartOf="@+id/tev_select_payment_item"
                            app:layout_constraintTop_toTopOf="@+id/tev_select_payment_item"/>
                        <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                            android:id="@+id/model_input_customer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp14"
                            app:cv_hint="@string/qt_enter_account_number"
                            app:cv_show_error_text="true"
                            app:cv_title="@string/qt_meter_number"
                            app:cv_title_visible="true"
                            app:layout_constrainedHeight="true"
                            app:layout_constraintTop_toBottomOf="@+id/tev_select_payment_item"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_check_customer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp6"
                            app:layout_constraintTop_toBottomOf="@+id/model_input_customer">
                            <ImageView
                                android:id="@+id/iv_check_customer"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp20"
                                android:adjustViewBounds="true"/>
                            <TextView
                                android:ellipsize="end"
                                android:id="@+id/tv_check_customer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginStart="@dimen/dp5"
                                style="@style/Text.medium.6306b2.12"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_save_to_beneficiary"
                            android:paddingBottom="@dimen/dp12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            app:layout_constraintTop_toBottomOf="@+id/ll_check_customer">
                            <TextView
                                android:gravity="start"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/qt_save_to_beneficiaries_tip"
                                android:layout_weight="1"
                                style="@style/Text.6f7b85.12"/>
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:layout_gravity="center_vertical"
                                android:id="@+id/cb_save_to_beneficiaries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:button="@drawable/cv_checkbox_selector5"
                                android:paddingEnd="4dp"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ViewStub
                    android:orientation="vertical"
                    android:id="@+id/vsb_bill_home_coupon"
                    android:layout="@layout/qt_layout_biller_coupon_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/ad_mid_bill"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <Space
                        android:id="@+id/space_ad_mid_bill"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/ad_mid_bill"
                        app:layout_goneMarginBottom="0dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_amount_label"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingTop="@dimen/dp12"
                        android:paddingRight="@dimen/dp16"
                        android:paddingBottom="@dimen/dp12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp16"
                        android:paddingVertical="@dimen/dp12"
                        app:layout_constraintTop_toBottomOf="@+id/space_ad_mid_bill">
                        <TextView
                            android:id="@+id/tv_amount_label_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qt_select_amount"
                            style="@style/txt_s_b"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:orientation="horizontal"
                            android:id="@+id/rv_payment_item_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp10"/>
                        <com.palmpay.lib.ui.edit.PpAmountEditText
                            android:id="@+id/inputAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp6"
                            android:inputType="numberDecimal"
                            app:am_edit_hint="@string/core_enter_amount"
                            app:am_edit_show_lock="false"
                            app:am_edit_show_title="false"
                            app:am_edit_text_size="@dimen/dp22"/>
                        <com.transsnet.palmpay.core.viewmodel.ModelAvailablePointItem
                            android:id="@+id/model_available_point_item"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp10"
                            app:layout_constrainedHeight="true"
                            app:layout_constraintTop_toTopOf="@+id/view_top_tab_bg"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.transsnet.palmpay.core.viewmodel.ModelBillQuickAccessItem
                    android:id="@+id/model_quick_access_item_native"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/ad_bottom_bill_1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/ad_bottom_bill_2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
