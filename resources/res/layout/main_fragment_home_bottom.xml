<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp56"
    app:layout_constraintBottom_toBottomOf="parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fh_iv_home"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/main_home_bottom_tab_horizontal_margin"
        app:layout_constraintBottom_toTopOf="@+id/fh_tv_home"
        app:layout_constraintEnd_toStartOf="@+id/fh_iv_finance"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/fh_tv_home"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="wrap_content"
        android:text="@string/core_home"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fh_iv_home"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_home"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fh_iv_finance"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/fh_tv_home"
        app:layout_constraintEnd_toStartOf="@+id/fh_ivInvest"
        app:layout_constraintStart_toEndOf="@+id/fh_iv_home"/>
    <ViewStub
        android:id="@+id/fhFinanceAdStub"
        android:layout="@layout/core_layout_common_single_ad_view"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp12"
        android:layout_marginBottom="15dp"
        android:maxWidth="@dimen/dp44"
        android:layout_marginStart="@dimen/main_home_bottom_tab_left_margin"
        app:layout_constraintBottom_toBottomOf="@+id/fh_iv_finance"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_finance"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/fh_tv_finance"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="wrap_content"
        android:text="@string/core_loan"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fh_iv_finance"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_finance"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fh_ivInvest"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/fh_tv_home"
        app:layout_constraintEnd_toStartOf="@+id/fh_iv_zone"
        app:layout_constraintStart_toEndOf="@+id/fh_iv_finance"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/fh_tvInvest"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="wrap_content"
        android:text="@string/core_wealth"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fh_ivInvest"
        app:layout_constraintStart_toStartOf="@+id/fh_ivInvest"
        app:layout_constraintTop_toBottomOf="@+id/fh_ivInvest"/>
    <ViewStub
        android:id="@+id/fhInvestAdStub"
        android:layout="@layout/core_layout_common_single_ad_view"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp12"
        android:layout_marginBottom="15dp"
        android:maxWidth="@dimen/dp44"
        android:layout_marginStart="@dimen/main_home_bottom_tab_left_margin"
        app:layout_constraintBottom_toBottomOf="@+id/fh_ivInvest"
        app:layout_constraintStart_toStartOf="@+id/fh_ivInvest"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fh_iv_zone"
        android:visibility="gone"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/fh_tv_home"
        app:layout_constraintEnd_toStartOf="@+id/fh_iv_me"
        app:layout_constraintStart_toEndOf="@+id/fh_ivInvest"/>
    <ViewStub
        android:id="@+id/fhRewardsAdStub"
        android:layout="@layout/core_layout_common_single_ad_view"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp12"
        android:layout_marginBottom="15dp"
        android:maxWidth="@dimen/dp44"
        android:layout_marginStart="@dimen/main_home_bottom_tab_left_margin"
        app:layout_constraintBottom_toBottomOf="@+id/fh_iv_zone"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_zone"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/fh_tv_zone"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="wrap_content"
        android:text="@string/core_reward"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fh_iv_zone"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_zone"
        app:layout_constraintTop_toBottomOf="@+id/fh_iv_zone"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fh_iv_me"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="@dimen/dp24"
        android:layout_marginBottom="2dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/main_home_bottom_tab_horizontal_margin"
        app:layout_constraintBottom_toTopOf="@+id/fh_tv_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fh_iv_zone"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/fh_tv_me"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="@dimen/main_home_bottom_tab_width"
        android:layout_height="wrap_content"
        android:text="@string/core_me"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fh_iv_me"
        app:layout_constraintStart_toStartOf="@+id/fh_iv_me"/>
</androidx.constraintlayout.widget.ConstraintLayout>
