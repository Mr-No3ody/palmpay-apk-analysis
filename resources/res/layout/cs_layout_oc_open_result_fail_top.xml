<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginBottom="@dimen/dp16">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flexi Credit Limit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:gravity="center_vertical"
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₦150,000"
        android:fontFamily="@font/cv_palmpay_number_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/txt_b_b"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/cs_oc_recommend_label_bg"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Up To"
        android:layout_marginStart="2dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toEndOf="@+id/tv2"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/txt_mi_w_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Credit Limit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv2"
        style="@style/txt_mi_g"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tv41"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Available for all bill payments in PalmPay"
        android:drawablePadding="4dp"
        app:iiv_start_color="@color/ppColorFlexiCashPrimary"
        app:iiv_start_icon="pay_SelectedFill"
        app:iiv_start_size="@dimen/dp14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv3"
        style="@style/txt_mi_g"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tv42"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No interest for timely repayments"
        android:drawablePadding="4dp"
        app:iiv_start_color="@color/ppColorFlexiCashPrimary"
        app:iiv_start_icon="pay_SelectedFill"
        app:iiv_start_size="@dimen/dp14"
        app:layout_constraintStart_toStartOf="@+id/tv41"
        app:layout_constraintTop_toBottomOf="@+id/tv41"
        style="@style/txt_mi_g"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tv43"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discounts for Flexi payments"
        android:drawablePadding="4dp"
        app:iiv_start_color="@color/ppColorFlexiCashPrimary"
        app:iiv_start_icon="pay_SelectedFill"
        app:iiv_start_size="@dimen/dp14"
        app:layout_constraintStart_toStartOf="@+id/tv41"
        app:layout_constraintTop_toBottomOf="@+id/tv42"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
