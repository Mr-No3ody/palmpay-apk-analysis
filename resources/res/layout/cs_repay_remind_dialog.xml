<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_root"
    android:background="@color/transparent"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp36">
        <ImageView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_loan_amount_increase_dialog_top_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <RelativeLayout
            android:id="@+id/content_bg"
            android:background="@drawable/cs_cl_24_24_0_0_ebfdfc_ff_bg"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:src="@drawable/cs_cl_icon_repay_reming_dialog_right"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/dp40"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iiv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_below="@+id/iiv_close"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorWarning"
            android:id="@+id/tv_cash_expired_day"
            android:background="@drawable/cs_shape_bg_expired_days"
            android:paddingLeft="@dimen/dp20"
            android:paddingTop="2dp"
            android:paddingRight="@dimen/dp20"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp120"
            android:text="Only valid in today"
            android:layout_below="@+id/iiv_close"
            android:layout_centerHorizontal="true"
            android:paddingHorizontal="@dimen/dp20"
            android:paddingVertical="2dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:layout_below="@+id/tv_content">
            <ImageView
                android:id="@+id/tv_coupon_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:src="@drawable/cs_action_bg"
                android:layout_marginStart="@dimen/dp40"
                android:layout_marginEnd="@dimen/dp24"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="#b87900"
                android:gravity="center_vertical"
                android:id="@+id/tv_coupon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:paddingStart="@dimen/dp6"
                android:layout_marginStart="@dimen/dp6"
                android:layout_toEndOf="@+id/iv_coupon_icon"/>
            <ImageView
                android:id="@+id/iv_coupon_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_repay_coupon"
                android:layout_marginStart="@dimen/dp24"/>
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/md_white_1000"
                android:gravity="center"
                android:id="@+id/tv_action"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp24"
                android:text="@string/cs_repay_now"
                android:layout_below="@+id/tv_coupon"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="@color/ppColorFlexiCashPrimary"
                android:layout_marginHorizontal="@dimen/dp24"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tv_coupon_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:layout_toRightOf="@+id/tv_coupon"
                android:layout_alignBottom="@+id/tv_coupon"
                android:layout_marginStart="@dimen/dp24">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/cv_color_b87900"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Countdown"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/md_white_1000"
                    android:id="@+id/hour"
                    android:background="@drawable/cs_timenum_bg"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp6"
                    android:paddingHorizontal="@dimen/dp2"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/cv_color_b87900"
                    android:gravity="center"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp2"
                    android:layout_width="@dimen/dp10"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="@dimen/dp2"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/md_white_1000"
                    android:id="@+id/mins"
                    android:background="@drawable/cs_timenum_bg"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="@dimen/dp2"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/cv_color_b87900"
                    android:gravity="center"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp2"
                    android:layout_width="@dimen/dp10"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="@dimen/dp2"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/md_white_1000"
                    android:id="@+id/second"
                    android:background="@drawable/cs_timenum_bg"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="@dimen/dp2"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_top_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_repay_remind_dialog_top"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
