<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/menu_container"
    android:background="@drawable/cs_menu_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_flexi_payment"
        android:layout_marginStart="@dimen/dp12"
        style="@style/Text.medium.202046"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/cs_flexi_payment_desc"
        android:layout_marginStart="@dimen/dp12"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <include
                android:id="@+id/menu_airtime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
            <include
                android:id="@+id/menu_data"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
            <include
                android:id="@+id/menu_betting"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <include
                android:id="@+id/menu_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
            <include
                android:id="@+id/menu_electricity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
            <include
                android:id="@+id/menu_internet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                layout="@layout/cs_view_flexi_payment_menu_item"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
