<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivFixedSavings"
        android:layout_width="@dimen/dp38"
        android:layout_height="@dimen/dp38"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tvFixedSavingsTitle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp44"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/tvFixedSavingsContent"
        app:layout_constraintEnd_toStartOf="@+id/btnSave"
        app:layout_constraintStart_toStartOf="@+id/ivFixedSavings"
        app:layout_constraintTop_toTopOf="@+id/ivFixedSavings"
        style="@style/Text.202046.14"/>
    <TextView
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tvFixedSavingsContent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp44"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/ivFixedSavings"
        app:layout_constraintEnd_toStartOf="@+id/btnSave"
        app:layout_constraintStart_toStartOf="@+id/ivFixedSavings"
        app:layout_constraintTop_toBottomOf="@+id/tvFixedSavingsTitle"
        style="@style/Text.9ca2aa.12"/>
    <TextView
        android:id="@+id/btnSave"
        android:background="@drawable/cv_shape_round_corner_primary"
        android:layout_width="@dimen/dp50"
        android:layout_height="@dimen/dp26"
        android:text="@string/core_save"
        app:layout_constraintBottom_toBottomOf="@+id/ivFixedSavings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivFixedSavings"
        style="@style/Text.ffffff.12"/>
</merge>
