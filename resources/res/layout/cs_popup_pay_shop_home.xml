<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cs_bg_popup_pay_shop_home"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/cs_payshop_pop_divider_bg"
        android:minWidth="@dimen/dp120"
        android:showDividers="middle"
        android:dividerPadding="@dimen/dp16">
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tv_help"
            android:padding="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_help"
            style="@style/txt_s_w"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tv_nearby"
            android:padding="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_str_nearby_shop"
            style="@style/txt_s_w"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tv_merchant"
            android:padding="@dimen/dp16"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cs_newbie_guide"
            android:paddingHorizontal="@dimen/dp12"
            style="@style/txt_s_w"/>
    </LinearLayout>
</FrameLayout>
