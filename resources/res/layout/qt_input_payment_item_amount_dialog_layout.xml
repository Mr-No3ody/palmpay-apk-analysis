<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:paddingTop="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp10"
        android:paddingEnd="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tv_tips_enter_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_enter_amount"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_name"
        style="@style/Text.6f7b85.12"/>
    <TextView
        android:id="@+id/tv_cashback"
        android:background="@drawable/core_shape_rect_corner_4_bg_38d79f"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp1"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_tips_enter_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_tips_enter_amount"
        style="@style/Text.ffffff.10"/>
    <com.palmpay.lib.ui.edit.PpAmountEditText
        android:id="@+id/et_amount_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        app:am_edit_hint="@string/core_please_enter_amount"
        app:am_edit_show_button="false"
        app:am_edit_show_lock="false"
        app:am_edit_show_title="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_enter_amount"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexbox_payment_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:alignItems="flex_start"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_amount_input"/>
    <Button
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/bt_confirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/core_pay"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/et_amount_input"
        app:layout_constraintStart_toStartOf="@+id/et_amount_input"
        app:layout_constraintTop_toBottomOf="@+id/flexbox_payment_amount"
        app:layout_goneMarginTop="@dimen/dp14"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</androidx.constraintlayout.widget.ConstraintLayout>
