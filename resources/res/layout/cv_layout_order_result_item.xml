<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp48"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp8">
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_item_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cvGuidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/cvGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        style="@style/txt_mi_g"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_item_key_right_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp7"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_key"
        app:layout_constraintStart_toEndOf="@+id/tv_item_key"
        app:layout_constraintTop_toTopOf="@+id/tv_item_key"/>
    <ImageView
        android:id="@+id/iv_item_value_left_icon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_value"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_value"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iv_item_key_right_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_item_value"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cvGuidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/iv_item_right_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_item_value_left_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/dp10"
        style="@style/txt_mi_b"/>
    <ImageView
        android:id="@+id/iv_item_right_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_item_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_item_value"
        app:layout_constraintTop_toTopOf="@+id/tv_item_value"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/cvGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/cvGuidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_item_key, tv_item_value"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tvBottomDesc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        app:layout_constraintTop_toBottomOf="@+id/cvGuidelineBottom"
        style="@style/Text.9ca2aa.12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cvSubInfoBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_item_key,tv_item_value,iv_item_value_left_icon,iv_item_right_icon,iv_item_key_right_icon,tvBottomDesc"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSubInfo"
        android:background="@drawable/cv_bg_order_result_sub_info"
        android:paddingTop="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp4"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvSubInfoBarrier">
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tvSubKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSubValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvSubValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivSubArrow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="wrap"
            app:layout_constraintWidth_percent="0.4"
            style="@style/Text.202046.12"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivSubArrow"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:importantForAccessibility="no"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
