<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/apply_result_bg_img"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp26">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/apply_result_mtb"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:title_bar_right_text="View Account"
            app:title_bar_show_right_2_iv="false"
            app:title_bar_title="@string/cs_application_result"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/apply_failed_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                            android:paddingTop="@dimen/dp6"
                            android:paddingBottom="@dimen/dp6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp12"
                            android:layout_marginTop="@dimen/dp12"
                            android:layout_marginRight="@dimen/dp12"
                            android:layout_marginHorizontal="@dimen/dp12"
                            android:paddingVertical="@dimen/dp6">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.mikepenz.iconics.view.IconicsImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:iiv_color="#fe5455"
                                    app:iiv_icon="pay_WarningFill"
                                    app:iiv_size="@dimen/dp18"/>
                                <TextView
                                    android:textSize="@dimen/dp14"
                                    android:textColor="@color/ppColorTextPrimary"
                                    android:id="@+id/text1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Application failed"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextAssist"
                                android:id="@+id/oc_apply_failed_content_tv"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp6"/>
                        </LinearLayout>
                        <include layout="@layout/cs_layout_oc_open_result_fail_top"/>
                    </LinearLayout>
                    <com.palmpay.lib.ui.button.PpButton
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:id="@+id/apply_back_bt"
                        android:background="@drawable/cs_oc_back_bt_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginTop="@dimen/dp60"
                        android:text="@string/cs_oc_back"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"/>
                    <com.transsnet.palmpay.credit.view.OpenResultTaskView
                        android:id="@+id/apply_result_task_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:o_businessType="flexi"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/apply_success_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp40"
                        android:src="@drawable/cs_success_icon"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp7"
                        android:text="@string/cs_oc_flexi_limit"/>
                    <TextView
                        android:textSize="32sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/apply_credit_amount_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        style="@style/txt_number_s_b_b"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:gravity="center"
                        android:id="@+id/installment_content_tv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="@string/cs_continue_to_pay_enjoy"
                        android:layout_marginStart="@dimen/dp24"
                        android:layout_marginEnd="@dimen/dp24"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:id="@+id/layoutBtn"
                        android:padding="@dimen/dp16"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/cs_main_color"
                            android:gravity="center"
                            android:id="@+id/tvBackHome"
                            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp48"
                            android:text="Back Home"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginEnd="@dimen/dp6"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/cv_color_ffffff"
                            android:gravity="center"
                            android:id="@+id/tvViewAccount"
                            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/dp48"
                            android:text="View Account"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/dp6"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/success_ad_ll"
                        android:background="@drawable/cv_shape_rect_corner_16_bg_white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp22">
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/apply_result_sav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="@dimen/dp16"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            android:layout_marginHorizontal="@dimen/dp16"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="@drawable/cs_corner_16_color_fbfbfb_stroke_f2f2f2"
                            android:paddingLeft="@dimen/dp12"
                            android:paddingTop="@dimen/dp16"
                            android:paddingRight="@dimen/dp12"
                            android:paddingBottom="@dimen/dp16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginRight="@dimen/dp16"
                            android:layout_marginHorizontal="@dimen/dp16"
                            android:paddingHorizontal="@dimen/dp12"
                            android:paddingVertical="@dimen/dp16">
                            <com.transsnet.adsdk.widgets.SingleAdView
                                android:id="@+id/success_left_sav"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"
                                android:adjustViewBounds="true"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/dp6"/>
                            <com.transsnet.adsdk.widgets.SingleAdView
                                android:id="@+id/success_middle_sav"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"
                                android:adjustViewBounds="true"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/dp6"
                                android:layout_marginEnd="@dimen/dp6"/>
                            <com.transsnet.adsdk.widgets.SingleAdView
                                android:id="@+id/success_right_sav"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:scaleType="fitXY"
                                android:adjustViewBounds="true"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/dp6"/>
                        </LinearLayout>
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/apply_result_bottom_sav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginTop="@dimen/dp16"
                            android:layout_marginRight="@dimen/dp16"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"/>
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/apply_result_bottom_two_sav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginTop="@dimen/dp16"
                            android:layout_marginRight="@dimen/dp16"
                            android:layout_marginBottom="@dimen/dp16"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/close_tips_tv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:layout_marginBottom="@dimen/dp12">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#858a8f"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_return_to_counter_in"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/counter_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <Button
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:id="@+id/use_coupon_bt"
                        android:background="@drawable/cs_oc_back_bt_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginTop="@dimen/dp5"
                        android:text="@string/cs_use_coupon"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/apply_pending_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp14">
                        <ImageView
                            android:id="@+id/apply_pending_iv"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/cs_oc_open_count_down_bg_icon"/>
                        <TextView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/cs_oc_main_color"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/countdown_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/cs_oc_main_color"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:text="@string/cs_application_processing"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/countdown_tips_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="@string/cs_oc_calculated_seconds"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp48">
                        <ImageView
                            android:id="@+id/pending_first_start_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_loading_small_icon"/>
                        <ImageView
                            android:id="@+id/pending_first_end_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_completed_small_icon"/>
                        <TextView
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/pending_first_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp2"
                            android:text="@string/cs_oc_checking_your_personal_information"
                            android:layout_marginHorizontal="@dimen/dp2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20">
                        <ImageView
                            android:id="@+id/pending_second_start_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_loading_small_icon"/>
                        <ImageView
                            android:id="@+id/pending_second_end_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_completed_small_icon"/>
                        <TextView
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/pending_second_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp2"
                            android:text="@string/cs_oc_gathering_your_credit_history_data"
                            android:layout_marginHorizontal="@dimen/dp2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20">
                        <ImageView
                            android:id="@+id/pending_third_start_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_loading_small_icon"/>
                        <ImageView
                            android:id="@+id/pending_third_end_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_completed_small_icon"/>
                        <TextView
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/pending_third_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp2"
                            android:text="@string/cs_oc_building_your_credit_profile"
                            android:layout_marginHorizontal="@dimen/dp2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20">
                        <ImageView
                            android:id="@+id/pending_four_start_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_loading_small_icon"/>
                        <ImageView
                            android:id="@+id/pending_four_end_iv"
                            android:visibility="invisible"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cs_oc_pending_completed_small_icon"/>
                        <TextView
                            android:textColor="@color/ppColorTextDisable"
                            android:id="@+id/pending_four_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp2"
                            android:text="@string/cs_oc_finalising_your_credit_limit_decision"
                            android:layout_marginHorizontal="@dimen/dp2"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp16"/>
    </LinearLayout>
</FrameLayout>
