<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_open_flexi_retain_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are you sure want to exit?"
            style="@style/Text.202046.18"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="when you complete application can get"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:textColor="@color/cs_cl_main_color_new"
            android:id="@+id/loanAmountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/cs_open_retain_text_flexi"
            style="@style/Text.medium.202046.14"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24">
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/exitTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Exit"
                android:layout_weight="1"
                style="@style/ppSecondaryButtonStyle"/>
            <View
                android:layout_width="@dimen/dp12"
                android:layout_height="@dimen/dp1"/>
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/continueTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Continue"
                android:layout_weight="1"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/closeIv"
        android:padding="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
</RelativeLayout>
