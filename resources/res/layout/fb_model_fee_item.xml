<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/fb_mfi_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        style="@style/fb_txt_s_b"/>
    <ImageView
        android:id="@+id/fb_mfi_tips_iv"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/fb_info_icon_grey"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/fb_mfi_title_tv"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/fb_mfi_tips_iv"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/fb_dp14"
            android:textColor="@color/fb_text_color_black1"
            android:gravity="end"
            android:id="@+id/fb_mfi_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fb_dp5"
            android:text="@string/fb_digit_0"
            android:layout_weight="1"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="15dp"/>
        <TextView
            android:textSize="@dimen/fb_dp14"
            android:textColor="#95a1ab"
            android:gravity="end"
            android:id="@+id/fb_origin_amount_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="7dp"/>
        <ImageView
            android:id="@+id/fb_iv_right"
            android:visibility="gone"
            android:layout_width="@dimen/fb_dp16"
            android:layout_height="@dimen/fb_dp16"
            android:src="@drawable/fb_success_small"
            android:layout_marginStart="@dimen/fb_dp5"/>
    </LinearLayout>
    <View
        android:background="@color/fb_bg_color_gray_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</merge>
