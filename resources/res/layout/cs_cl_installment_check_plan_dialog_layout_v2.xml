<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_marginTop="@dimen/dp28"
        android:text="@string/core_congratulations"
        style="@style/Text.medium.202046.24"/>
    <TextView
        android:gravity="center"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp20"
        android:text="@string/cs_check_your_repayment_plan_now"
        android:layout_marginHorizontal="@dimen/dp20"
        style="@style/Text.202046.14"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/icon_confirm_repayment_bj"
        android:layout_width="320dp"
        android:layout_height="@dimen/dp150"
        android:layout_marginTop="@dimen/dp16">
        <TextView
            android:gravity="center"
            android:layout_marginTop="@dimen/dp20"
            android:text="First repayment date"
            style="@style/Text.ffffff.12"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDateM"
            android:layout_marginTop="@dimen/dp17"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDateD"
            android:layout_marginTop="-5dp"
            android:fontFamily="@font/lib_ui_number_bold"
            style="@style/Text.medium.202046.56"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:layout_marginTop="@dimen/dp20"
        android:text="1 st term outstanding"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:textColor="@color/cv_flexi_cash_base_color"
        android:gravity="center"
        android:id="@+id/tvRepaymentAmount"
        android:layout_marginTop="@dimen/dp4"
        android:fontFamily="@font/lib_ui_number_bold"
        style="@style/Text.medium.6306b2.32"/>
    <TextView
        android:id="@+id/btnRepay"
        android:background="@drawable/lib_ui_button_bg_corner_primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp10"
        android:text="@string/cs_homepage"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_goneMarginTop="24dp"
        style="@style/Text.medium.ffffff.16"/>
</LinearLayout>
