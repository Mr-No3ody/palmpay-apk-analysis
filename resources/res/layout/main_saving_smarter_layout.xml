<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        style="@style/Text.medium.202046.16"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/layoutFlexibleSavings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp158"
        android:layout_marginTop="@dimen/dp8">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCashBoxModule"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvCashBoxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_cash_box"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="left"
                android:id="@+id/tvCashBoxRemark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp40"
                android:minHeight="@dimen/dp48"
                android:text="@string/core_cash_box"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCashBoxTitle"/>
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:textSize="12dp"
                android:textColor="@color/cv_color_ffffff"
                android:id="@+id/rtvSave"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="52dp"
                android:layout_height="@dimen/dp24"
                android:layout_marginTop="@dimen/dp8"
                android:text="Save"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCashBoxRemark"
                app:rtv_background_color="@color/ppColorPrimary"
                style="@style/Text"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/main_cash_box_shadow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSecModule"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp10"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginLeft="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/layoutCashBoxModule"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvSecTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_spend_save"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="left"
                android:id="@+id/tvSecRemark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="Every spend adds to\10your savings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSecTitle"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="@drawable/main_smarter_corner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutThirdModule"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp10"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/layoutCashBoxModule"
            app:layout_constraintTop_toBottomOf="@+id/layoutSecModule">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvThirdTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_target_saving"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="left"
                android:id="@+id/tvThirdRemark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="Turn your Goals into\10Reality!"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvThirdTitle"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="@drawable/main_smarter_corner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/layoutFlexibleSavingsAD"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp158"
        android:layout_marginTop="@dimen/dp16">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ivFirstPart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ivSecPart"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginLeft="@dimen/dp8"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivFirstPart"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ivThirdPart"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginTop="@dimen/dp8"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivFirstPart"
            app:layout_constraintTop_toBottomOf="@+id/ivSecPart"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
