<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_view"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginBottom="@dimen/dp8"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginVertical="@dimen/dp8">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/search_iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/cv_search_icon"
                android:layout_marginEnd="4dp"
                app:iiv_color="@color/cv_color_858a8f"
                app:iiv_icon="pay_Search"/>
            <com.transsnet.palmpay.custom_view.CompatStateEditText
                android:textSize="14dp"
                android:textColorHint="@color/ppColorTextDisable"
                android:gravity="center_vertical"
                android:id="@+id/search_et"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/sm_search_mobile_number_name"
                android:layout_weight="1"
                style="@style/Text.202046.14"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.transsnet.palmpay.send_money.ui.view.SideBarView
            android:id="@+id/side_bar"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp48"
            android:layout_marginBottom="@dimen/dp48"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginVertical="@dimen/dp48"
            app:sm_press_bg_color="@color/ppColorBackgroundDark"
            app:sm_selectTextColor="@color/ppColorPrimary"
            app:sm_textColor="@color/ppColorTextPrimary"/>
    </RelativeLayout>
</LinearLayout>
