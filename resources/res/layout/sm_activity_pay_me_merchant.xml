<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/sm_pay_me"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp14"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/sm_genterate_a_payme_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/txt_mi_b"/>
                <ImageView
                    android:id="@+id/iv_account"
                    android:layout_width="@dimen/dp250"
                    android:layout_height="367dp"
                    android:layout_marginTop="@dimen/dp12"/>
                <com.transsnet.palmpay.custom_view.RoundedTextView
                    android:id="@+id/btn_download"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ppButtonHeight"
                    android:layout_marginLeft="@dimen/dp26"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp26"
                    android:text="@string/core_download"
                    android:layout_marginHorizontal="@dimen/dp26"
                    app:rtv_background_color="@color/ppColorPrimary"
                    app:rtv_corner_radius="@dimen/dp50"
                    style="@style/Text.medium.ffffff.16"/>
                <com.transsnet.palmpay.custom_view.RoundedTextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/btn_copy_info"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ppButtonHeight"
                    android:layout_marginLeft="@dimen/dp26"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp26"
                    android:layout_marginBottom="@dimen/dp16"
                    android:text="@string/sm_copy_account_no"
                    android:layout_marginHorizontal="@dimen/dp26"
                    android:layout_marginVertical="@dimen/dp16"
                    app:rtv_background_color="@color/ppColorSecondary"
                    app:rtv_corner_radius="@dimen/dp50"
                    style="@style/Text.medium.ffffff.16"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_what_is"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="12dp"
                style="@style/txt_s_b"/>
            <TextView
                android:id="@+id/tv_how_to_use"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="26dp"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="12dp"
                style="@style/txt_s_b"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
