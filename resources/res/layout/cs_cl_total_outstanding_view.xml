<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/topLine"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginLeft="@dimen/dp14"
        android:layout_marginRight="@dimen/dp14"
        android:layout_marginHorizontal="@dimen/dp14"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootOutstandingView"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="-2dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutWaiver"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/cs_color_bg_item"
                    android:gravity="center"
                    android:id="@+id/tvWaiverBadge"
                    android:background="@drawable/cs_cl_loan_fully_bj"
                    android:layout_width="@dimen/dp120"
                    android:layout_height="@dimen/dp20"/>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/cs_cl_installment_amount_text_color"
                        android:id="@+id/tvCountdownDayHour"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/llCountdownHms"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/cs_cl_installment_amount_text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_waiver_countdown_ends_in"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvCountdownHour"
                            android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            android:layout_marginStart="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorWarning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp3"
                            android:layout_marginRight="@dimen/dp3"
                            android:text=":"
                            android:layout_marginHorizontal="@dimen/dp3"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvCountdownMinute"
                            android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorWarning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp3"
                            android:layout_marginRight="@dimen/dp3"
                            android:text=":"
                            android:layout_marginHorizontal="@dimen/dp3"/>
                        <TextView
                            android:textSize="@dimen/dp10"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorAssist"
                            android:gravity="center"
                            android:id="@+id/tvCountdownSecond"
                            android:background="@drawable/cs_cl_remaining_time_countdown_txt_bg"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvWaiverAmountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layoutWaiverAmountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp20"
                    android:id="@+id/tvWaiverCurrentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/txt_number_me_b_b"/>
                <ImageView
                    android:id="@+id/ivWaiverAmountIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp4"
                    app:srcCompat="@drawable/cs_oc_arrow_right_icon"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/repayBtnContainer2"
                    android:paddingTop="@dimen/dp6"
                    android:paddingBottom="@dimen/dp6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp12"
                    android:paddingVertical="@dimen/dp6">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/md_white_1000"
                        android:gravity="center"
                        android:id="@+id/repayBtn2"
                        android:background="@drawable/lib_ui_button_bg_corner_primary_5"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingRight="@dimen/dp8"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp24"
                        android:minWidth="@dimen/dp72"
                        android:paddingHorizontal="@dimen/dp8"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvWaiverSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvTitle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <ImageView
            android:id="@+id/ivTitleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintLeft_toRightOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
        <TextView
            android:id="@+id/tvCouponAmount"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:layout_marginLeft="@dimen/dp4"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintLeft_toRightOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"
            style="@style/Text.ffffff.10"/>
        <ImageView
            android:id="@+id/ivArrowRight"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvCouponAmount"
            app:layout_constraintLeft_toRightOf="@+id/tvCouponAmount"
            app:layout_constraintTop_toTopOf="@+id/tvCouponAmount"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:id="@+id/tvOutstandingAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/txt_number_me_b_b"/>
        <Space
            android:id="@+id/space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvOutstandingAmount"
            app:layout_constraintRight_toRightOf="@+id/tvOutstandingAmount"
            app:layout_constraintTop_toTopOf="@+id/tvOutstandingAmount"/>
        <ImageView
            android:id="@+id/ivAmountIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_oc_arrow_right_icon"
            app:layout_constraintBottom_toBottomOf="@+id/tvOutstandingAmount"
            app:layout_constraintLeft_toLeftOf="@+id/space"
            app:layout_constraintLeft_toRightOf="@+id/tvOutstandingAmount"
            app:layout_constraintTop_toTopOf="@+id/tvOutstandingAmount"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/repayBtnContainer"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingVertical="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="@+id/tvOutstandingAmount"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvOutstandingAmount">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/md_white_1000"
                android:gravity="center"
                android:id="@+id/repayBtn"
                android:background="@drawable/lib_ui_button_bg_corner_primary_5"
                android:layout_width="@dimen/dp72"
                android:layout_height="@dimen/dp24"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/tvRepaymentIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvRepaymentDate"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvRepaymentDate"/>
        <TextView
            android:id="@+id/tvRepaymentDate"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/tvRepaymentIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvOutstandingAmount"
            app:layout_goneMarginStart="0dp"
            style="@style/Text.202046.12"/>
        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Text.6f7b85.12"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="layoutWaiver,tvSubtitle,tvRepaymentDate"/>
        <com.transsnet.palmpay.credit.view.DashLine
            android:id="@+id/divideLine"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="@dimen/dp8"
            app:cs_dash_color="@color/ppColorDividerLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOutstandingDetail"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divideLine"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
