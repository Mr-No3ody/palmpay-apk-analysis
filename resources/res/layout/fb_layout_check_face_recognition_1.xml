<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fb_faceGuideView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp12"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_ivTopIcon"
            android:layout_width="@dimen/fb_dp88"
            android:layout_height="@dimen/fb_dp88"
            android:src="@drawable/fb_face_top_icon"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/fb_dp24"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_dp20"
            android:text="@string/fb_photo_capture"
            android:textFontWeight="700"
            style="@style/fb_txt_b_b_b"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_tvSubtitle"
            android:paddingTop="@dimen/fb_dp4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fb_dp16"
            android:layout_marginRight="@dimen/fb_dp16"
            android:text="@string/fb_msg_face_recognition"
            android:layout_marginHorizontal="@dimen/fb_dp16"
            style="@style/fb_txt_s_g"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/fb_layoutGuideCard"
            android:background="@drawable/fb_shape_rect_corner_12_bg_dark"
            android:paddingLeft="@dimen/fb_dp4"
            android:paddingTop="@dimen/fb_dp12"
            android:paddingRight="@dimen/fb_dp4"
            android:paddingBottom="@dimen/fb_dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fb_dp24"
            android:layout_marginTop="@dimen/fb_dp24"
            android:layout_marginRight="@dimen/fb_dp24"
            android:layout_marginHorizontal="@dimen/fb_dp24"
            android:paddingHorizontal="@dimen/fb_dp4"
            android:paddingVertical="@dimen/fb_dp12">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/fb_tvGuideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fb_please_ensure_the_following"
                style="@style/fb_txt_s_b_b"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fb_layoutItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_dp12">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingLeft="@dimen/fb_dp12"
                    android:paddingTop="@dimen/fb_dp8"
                    android:paddingRight="@dimen/fb_dp12"
                    android:paddingBottom="@dimen/fb_dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/fb_dp12"
                    android:paddingVertical="@dimen/fb_dp8">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/fb_ivGuideIcon1"
                        android:layout_width="@dimen/fb_dp24"
                        android:layout_height="@dimen/fb_dp24"
                        android:src="@drawable/fb_face_capture_guide_1"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/fb_tvGuideText1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/fb_msg_face_capture_1"
                        android:layout_marginStart="@dimen/fb_dp12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/fb_ivGuideIcon1"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/fb_txt_mi_g"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingLeft="@dimen/fb_dp12"
                    android:paddingTop="@dimen/fb_dp8"
                    android:paddingRight="@dimen/fb_dp12"
                    android:paddingBottom="@dimen/fb_dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/fb_dp12"
                    android:paddingVertical="@dimen/fb_dp8">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/fb_ivGuideIcon2"
                        android:layout_width="@dimen/fb_dp24"
                        android:layout_height="@dimen/fb_dp24"
                        android:src="@drawable/fb_face_capture_guide_2"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/fb_tvGuideText2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/fb_msg_face_capture_2"
                        android:layout_marginStart="@dimen/fb_dp12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/fb_ivGuideIcon2"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/fb_txt_mi_g"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingLeft="@dimen/fb_dp12"
                    android:paddingTop="@dimen/fb_dp8"
                    android:paddingRight="@dimen/fb_dp12"
                    android:paddingBottom="@dimen/fb_dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/fb_dp12"
                    android:paddingVertical="@dimen/fb_dp8">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/fb_ivGuideIcon3"
                        android:layout_width="@dimen/fb_dp24"
                        android:layout_height="@dimen/fb_dp24"
                        android:src="@drawable/fb_face_capture_guide_3"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/fb_tvGuideText3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/fb_msg_face_capture_3"
                        android:layout_marginStart="@dimen/fb_dp12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/fb_ivGuideIcon3"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/fb_txt_mi_g"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fb_layoutScanFaceBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp24"
        android:layout_marginRight="@dimen/fb_dp24"
        android:layout_marginBottom="@dimen/fb_dp16"
        android:layout_marginHorizontal="@dimen/fb_dp24"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.mikepenz.iconics.view.IconicsTextView
            android:layout_gravity="top"
            android:background="@drawable/fb_shape_rect_top_corner_white_12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fb_dp44"
            android:backgroundTint="@color/ppColorSuccessBackground"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/fb_micro_text"
            android:textColor="@color/ppColorSuccess"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_tvFaceScanSecurityTips"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fb_dp32"
            android:text="@string/fb_face_scan_security_tips"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/fb_dp4"
            app:iiv_start_color="@color/ppColorSuccess"
            app:iiv_start_icon="pay_Security"
            app:iiv_start_size="@dimen/fb_dp16"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/fb_btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_dp32"
            android:text="@string/fb_face_recognition"
            android:textAllCaps="false"
            style="@style/fbButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
