<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/sm_limit_settings"/>
    <TextView
        android:gravity="start"
        android:id="@+id/kycLimitDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:lineSpacingExtra="@dimen/dp2"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/Text.202046.14"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/limitCard"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kycLimitDescription"
        app:layout_goneMarginTop="@dimen/dp8">
        <TextView
            android:id="@+id/dailyLimitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sm_daily_transfer_limit"
            app:layout_constraintBottom_toBottomOf="@+id/dailyLimitInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dailyLimitInput"
            style="@style/Text.202046.14"/>
        <EditText
            android:gravity="end|center_vertical"
            android:id="@+id/dailyLimitInput"
            android:background="@null"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp52"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:inputType="number"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintEnd_toStartOf="@+id/dailyLimitEditIcon"
            app:layout_constraintStart_toEndOf="@+id/dailyLimitLabel"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/dailyLimitEditIcon"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Edit"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/dailyLimitInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dailyLimitInput"/>
        <View
            android:id="@+id/dailyLimitDivider"
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dailyLimitInput"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorError"
            android:id="@+id/dailyLimitError"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dailyLimitDivider"/>
        <TextView
            android:id="@+id/singleLimitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sm_single_transfer_limit"
            app:layout_constraintBottom_toBottomOf="@+id/singleLimitInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/singleLimitInput"
            style="@style/Text.202046.14"/>
        <EditText
            android:gravity="end|center_vertical"
            android:id="@+id/singleLimitInput"
            android:background="@null"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp52"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:inputType="number"
            android:layout_marginEnd="@dimen/dp8"
            app:layout_constraintEnd_toStartOf="@+id/singleLimitEditIcon"
            app:layout_constraintStart_toEndOf="@+id/singleLimitLabel"
            app:layout_constraintTop_toBottomOf="@+id/dailyLimitError"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/singleLimitEditIcon"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Edit"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/singleLimitInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/singleLimitInput"/>
        <View
            android:id="@+id/singleLimitDivider"
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/singleLimitInput"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorError"
            android:id="@+id/singleLimitError"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/singleLimitDivider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:id="@+id/saveChangesButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp20"
        android:text="@string/sm_save_changes"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/limitCard"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
