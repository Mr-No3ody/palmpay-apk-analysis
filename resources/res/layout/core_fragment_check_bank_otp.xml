<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorBackgroundLight"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:src="@drawable/cv_default_bank_logo"
        android:scaleType="fitXY"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvBankName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp30"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/dp30"
        android:text="@string/core_confirm_otc"
        android:layout_marginHorizontal="@dimen/dp30"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp34"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_one_time_code"
        android:drawableTint="@color/ppColorTextPrimary"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_b"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/medium_text"
        android:gravity="center_vertical"
        android:id="@+id/editCardOtp"
        android:background="@drawable/cv_title_input_underline"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:hint="@string/core_enter_verification_code"
        android:maxLength="20"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvCountDown"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        style="@style/txt_me_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/buttonNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/ppButtonStyle"/>
</LinearLayout>
