<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/main_rewards_top_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivTopIcon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp86"
        android:src="@drawable/main_rewards_top_icon"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftView"
        android:paddingTop="0dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minWidth="@dimen/dp90"
        android:paddingStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivPoints"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cv_palmpay_icon_yellow"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.palmpay.lib.ui.text.ImageTextView
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center_vertical"
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="@string/core_points"
            android:layout_marginStart="4dp"
            app:itv_color="@color/ppColorTextNormal"
            app:itv_icon="pay_ArrowCenterRight"
            app:itv_img_gravity="right_center"
            app:itv_img_size="@dimen/dp16"
            app:itv_img_top_margin="2dp"
            app:layout_constraintTop_toBottomOf="@+id/ivPoints"
            style="@style/txt_mi_b_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvClaimed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="Claimed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPoints"
            style="@style/txt_mi_g"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="1"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="@dimen/dp1"
            android:layout_height="@dimen/dp24"
            app:layout_constraintBottom_toBottomOf="@+id/tvPointAmount"
            app:layout_constraintStart_toEndOf="@+id/guideLine"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvPointAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="-"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/tvClaimed"
            app:layout_constraintTop_toBottomOf="@+id/tvClaimed"
            app:layout_constraintVertical_bias="0"
            style="@style/txt_b_b_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvToBeClaimed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="To Be Claimed"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/guideLine"
            app:layout_constraintTop_toBottomOf="@+id/tvPoints"
            app:layout_constraintVertical_bias="0"
            style="@style/txt_mi_g"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvPointAmount2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="-"
            app:layout_constraintStart_toStartOf="@+id/tvToBeClaimed"
            app:layout_constraintTop_toBottomOf="@+id/tvToBeClaimed"
            style="@style/txt_b_b_b"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="12dp"
            android:gravity="center"
            android:id="@+id/tvPointClaim"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:text="@string/core_claim"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvPointAmount2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvPointAmount2"
            style="@style/ppSmallButtonNoPaddingStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightView"
        android:paddingTop="0dp"
        android:paddingBottom="16dp"
        android:layout_width="120dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/leftView"
        app:layout_constraintStart_toEndOf="@+id/leftView"
        app:layout_constraintTop_toTopOf="@+id/leftView">
        <ImageView
            android:id="@+id/ivTrialCash"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cv_palmpay_trial_cash_logo"
            android:scaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.palmpay.lib.ui.text.ImageTextView
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center_vertical"
            android:id="@+id/tvTrialCash"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text="Trial Cash"
            android:layout_marginStart="4dp"
            app:itv_color="@color/ppColorTextNormal"
            app:itv_icon="pay_ArrowCenterRight"
            app:itv_img_gravity="right_center"
            app:itv_img_size="@dimen/dp16"
            app:itv_img_top_margin="2dp"
            app:layout_constraintTop_toBottomOf="@+id/ivTrialCash"
            style="@style/txt_mi_b_b"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvTrialCashAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="-"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/tvTrialCash"
            app:layout_constraintTop_toBottomOf="@+id/tvTrialCash"
            style="@style/txt_b_b_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/rightGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.72"/>
    <FrameLayout
        android:id="@+id/viewTrialCashToClaimed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/rightGuideline"
        app:layout_constraintTop_toTopOf="@+id/rightView">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/cv_trial_cash_logo"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorWarning"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTrialCashToClaimed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp26"
            android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
            app:layout_constraintEnd_toStartOf="@+id/rightGuideline"
            app:layout_constraintTop_toBottomOf="@+id/ivTrialCash"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/couponView"
        android:background="@drawable/cv_shape_rect_bottom_corner_white_12"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBg">
        <ImageView
            android:id="@+id/ivCoupon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:src="@drawable/cv_palmpay_coupon"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            android:layout_marginVertical="@dimen/dp12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.palmpay.lib.ui.text.ImageTextView
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center_vertical"
            android:id="@+id/tvCoupon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_coupons"
            android:layout_marginStart="4dp"
            app:itv_color="@color/ppColorTextNormal"
            app:layout_constraintBottom_toBottomOf="@+id/ivCoupon"
            app:layout_constraintStart_toEndOf="@+id/ivCoupon"
            app:layout_constraintTop_toTopOf="@+id/ivCoupon"
            style="@style/txt_mi_b_b"/>
        <com.palmpay.lib.ui.text.ImageTextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvCouponAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            app:itv_color="@color/ppColorTextNormal"
            app:itv_icon="pay_ArrowCenterRight"
            app:itv_img_gravity="right_center"
            app:itv_img_size="@dimen/dp16"
            app:itv_img_top_margin="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCoupon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivCoupon"
            style="@style/txt_b_b_b"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:src="@drawable/cv_dash_line_dark_gray"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rewardsList"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivCoupon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
