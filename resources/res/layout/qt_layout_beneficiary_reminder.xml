<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/cltr_switch">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:text="@string/qt_beneficiary_set_reminder"
                android:includeFontPadding="false"
                style="@style/ppTextStyleT3"/>
            <TextView
                android:textColor="@color/ppColorTextAssist"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="3dp"
                android:text="@string/qt_beneficiary_reminder_hint"
                android:includeFontPadding="false"
                style="@style/ppTextStyleT2"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/cltr_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp20"
            android:thumb="@drawable/core_switch_thumb"
            android:layout_centerVertical="true"
            android:contentDescription="@string/qt_beneficiary_set_reminder"
            android:layout_alignParentEnd="true"
            app:showText="false"
            app:splitTrack="false"
            app:switchMinWidth="36dp"
            app:track="@drawable/core_switch_blue_gray"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cltr_area2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/qt_reminder_frequency_row"
            android:layout_width="match_parent"
            android:layout_height="69dp">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:text="@string/core_reminder_period"
                android:includeFontPadding="false"
                style="@style/ppTextStyleT2"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/cltr_remind_period_tv"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                style="@style/ppTextStyleT3"/>
        </LinearLayout>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/qt_reminder_time_row"
            android:layout_width="match_parent"
            android:layout_height="69dp">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/cltr_title2"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:text="@string/core_day"
                android:includeFontPadding="false"
                style="@style/ppTextStyleT2"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/cltr_remind_time_tv"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                style="@style/ppTextStyleT3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
