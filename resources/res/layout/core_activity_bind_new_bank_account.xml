<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_back_icon="@drawable/core_actionbar_back_white"
        app:title_bar_show_right_2_iv="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_bind_bank_account_title"
            style="@style/txt_b_w"/>
        <TextView
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_msg_select_bank_account"
            style="@style/txt_mi_w"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_8"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">
        <com.transsnet.palmpay.core.viewmodel.ModelBankInfoItem
            android:id="@+id/itemBankInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center"
                android:id="@+id/bank_account_prefix_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_ao_bank_account_prefix"
                android:layout_marginEnd="10dp"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/itemAccountNo"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="number"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvNote"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_bank_account_can_receiving_money_only"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            style="@style/txt_s_g"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/textViewNext"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginTop="30dp"
            android:text="@string/core_next"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            style="@style/txt_b_w"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#3c4abc"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/select_other_method_tv"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_select_other_method"/>
</LinearLayout>
