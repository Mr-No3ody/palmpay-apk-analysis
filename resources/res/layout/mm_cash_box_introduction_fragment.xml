<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivTopBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_bg_intro_banner_top"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title_color="@color/ppColorTextPrimary"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:paddingBottom="@dimen/dp16"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/mtb">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <ImageView
                android:id="@+id/ivheaderBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/mm_bg_intro_header"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/ivBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/mm_bg_intro_banner"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
        android:id="@+id/cbIntrol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutBottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clsAgreement"
            android:background="@color/ppColorBackgroundLight"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <CheckBox
                android:gravity="center"
                android:id="@+id/ckProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@drawable/cv_checkbox_selector2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="left"
                android:id="@+id/tvAgreementContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp8"
                android:layout_marginRight="@dimen/dp16"
                android:text="I agree to Terms &amp; Conditions and Privacy Policy to open a CashBox account. I also agree to the CashBox Auto Save Agreement to enable Auto Save."
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toRightOf="@+id/ckProtocol"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ckProtocol"
                style="@style/Text.202046.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="@color/md_white_1000"
            android:layout_gravity="center"
            android:id="@+id/rtvSaveNow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Agree &amp; Start"
            app:rtv_background_color="@color/mm_bg_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCheckAgreement"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginBottom="-4dp"
        android:src="@drawable/mm_bg_agreement"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
