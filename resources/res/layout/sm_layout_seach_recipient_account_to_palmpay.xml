<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:paddingBottom="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_recipient_account"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_b_b"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <EditText
            android:textColorHint="@color/text_color_gray4"
            android:gravity="center_vertical"
            android:id="@+id/etPhoneAccount"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:hint="@string/sm_enter_10_digit_account_number"
            android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
            android:digits="0123456789"
            style="@style/txt_me_b_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iivContacts"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_AddressbookFill"
            app:iiv_size="@dimen/dp24"/>
    </FrameLayout>
    <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
        android:id="@+id/med_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <RelativeLayout
        android:id="@+id/rlSelectBank"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:id="@+id/account_bank_icon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/cv_bank_account"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/account_select_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_toEndOf="@+id/account_bank_icon"
            android:layout_alignParentEnd="true"
            style="@style/txt_me_b"/>
    </RelativeLayout>
    <View
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/core_divider_horizontal"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_status"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp34"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.wang.avi.AVLoadingIndicatorView
                android:layout_gravity="center"
                android:id="@+id/indicatorView"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:indicatorColor="@color/ppColorPrimary"
                app:indicatorName="BallSpinFadeLoaderIndicator"
                style="@style/AVLoadingIndicatorView.Large"/>
            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_looking_for_this_user_name"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_name"
            android:background="@drawable/cv_shape_halfround_background_dark"
            android:paddingTop="@dimen/dp7"
            android:paddingBottom="@dimen/dp7"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:minHeight="@dimen/dp34"
            android:paddingStart="@dimen/dp12"
            android:paddingEnd="@dimen/dp14"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp7">
            <ImageView
                android:id="@+id/iv_query_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"/>
            <TextView
                android:id="@+id/tv_recipient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_s_b_b"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
