<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/oc_bill_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/oc_bill_amount_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/oc_bill_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/oc_bill_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/oc_bill_title_tv"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cs_oc_positive_txt_grey_color"
        android:id="@+id/oc_bill_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableEnd="@drawable/cs_oc_bill_right_arrow_grey_icon"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/oc_bill_date_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/oc_bill_title_tv"/>
    <View
        android:id="@+id/csView3"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/oc_bill_amount_tv"
        app:layout_constraintStart_toStartOf="@+id/oc_bill_date_tv"
        app:layout_constraintTop_toBottomOf="@+id/oc_bill_date_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
