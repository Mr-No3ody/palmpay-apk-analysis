<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="360dp">
    <ImageView
        android:id="@+id/ivIncreaseDialogBg"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_color_black_immutable"
        android:id="@+id/tvIncreaseDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp72"
        android:text="Loan Amount"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/text_color_black_immutable"
        android:id="@+id/tvIncreaseDialogAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIncreaseDialogTitle"
        style="@style/txt_number_s_b_b"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutIncreaseAmountTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIncreaseDialogAmount">
        <ImageView
            android:id="@+id/ivIncreaseDialogArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cs_cl_amount_increase_arrow_up"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_color_black_immutable"
            android:gravity="center_vertical"
            android:id="@+id/tvIncreaseAmountTips"
            android:background="@drawable/cs_cl_bg_increase_amount_dialog_desc_bg"
            android:paddingLeft="@dimen/dp8"
            android:paddingRight="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:drawablePadding="@dimen/dp4"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivIncreaseDialogArrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/text_color_black_immutable"
        android:id="@+id/tvIncreaseAmountTips2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:fontFamily="sans-serif-medium"
        android:lineHeight="@dimen/dp14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIncreaseDialogAmount"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvIncreaseAmountBtn"
        android:layout_width="234dp"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/dp80"
        android:text="@string/cs_cl_borrow"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivIncreaseAmountClose"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/cs_cl_closed_white_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
