<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clInviteTip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp32">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:src="@drawable/cv_icon_polygon"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ppColorBackgroundLight"/>
    <org.sufficientlysecure.htmltextview.HtmlTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvInviteTip"
        android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="58dp"
        android:backgroundTint="@color/ppColorBackgroundLight"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivArrow"
        style="@style/txt_mi_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp10"
        android:gravity="center"
        android:id="@+id/btnInvite"
        android:layout_width="49dp"
        android:layout_height="@dimen/dp20"
        android:text="@string/core_invite"
        android:layout_marginEnd="@dimen/dp4"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="@+id/tvInviteTip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvInviteTip"
        style="@style/ppSmallButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
