<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/close"
        android:padding="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp6"
        android:layout_alignParentRight="true"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/header"
            android:layout_width="@dimen/dp44"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp24"
            android:src="@drawable/cv_avatar_default"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp24"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="PalmPay Account Number"/>
            <TextView
                android:textSize="@dimen/dp28"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginBottom="@dimen/dp8"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            android:paddingHorizontal="@dimen/dp12"
            android:paddingVertical="@dimen/dp8">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorWarning"
                app:iiv_icon="pay_InformationOutline"
                app:iiv_size="14dp"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please verify the account information, as successful transfers cannot be reversed."
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/text3"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/core_confirm"
            android:fontFamily="sans-serif-black"
            android:layout_marginHorizontal="@dimen/dp24"/>
    </LinearLayout>
</RelativeLayout>
