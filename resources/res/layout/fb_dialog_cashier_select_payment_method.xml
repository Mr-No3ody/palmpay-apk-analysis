<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fb_viewRoot"
    android:background="@drawable/fb_shape_rect_corner_lt_rt_8_bg_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp50">
        <ImageView
            android:id="@+id/fb_cdspm_close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fb_close_grey"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/fb_dp15"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/fb_dp16"
            android:textStyle="bold"
            android:textColor="@color/fb_text_color_black1"
            android:id="@+id/fb_cdspm_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fb_select_payment_method"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fb_cdspm_rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.flexibank.sdk.customview.model.FlexiBankModelAddBankCard
        android:id="@+id/fb_cdspm_add_bank_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
