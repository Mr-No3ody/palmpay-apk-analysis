<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@drawable/cv_dialog_top_left_right_corner_white_bg"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTitle"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_account_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutInfo"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutNinVerified"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvNinLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_nin"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:gravity="center_vertical"
                android:background="@drawable/ac_bg_nin_state"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="Verified"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp2"
                android:drawableStart="@drawable/ac_nin_verified"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp6"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/ppColorSuccessBackground"
                android:drawableTint="@color/ppColorSuccess"
                style="@style/txt_mi_w"/>
            <TextView
                android:id="@+id/tvNinValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivNinCopy"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:layout_marginStart="@dimen/dp8"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Copy"
                app:iiv_size="@dimen/dp20"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutNinUnVerified"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_nin"
                android:layout_weight="1"/>
            <TextView
                android:enabled="false"
                android:textColor="@color/ppColorWarning"
                android:gravity="center_vertical"
                android:background="@drawable/ac_bg_nin_state"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="Unverified"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp2"
                android:drawableStart="@drawable/ac_nin_not_verified"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp6"
                android:backgroundTint="@color/ppColorAssisBackground"
                android:drawableTint="@color/ppColorWarning"
                style="@style/txt_mi_w"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_verify"
                android:drawablePadding="4dp"
                app:iiv_end_color="@color/ppColorTextAssist"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp16"
                style="@style/txt_s_b"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerNin"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutBvnVerified"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvBvnLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_bvn"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:gravity="center_vertical"
                android:background="@drawable/ac_bg_nin_state"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="Verified"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp2"
                android:drawableStart="@drawable/ac_nin_verified"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp6"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/ppColorSuccessBackground"
                android:drawableTint="@color/ppColorSuccess"
                style="@style/txt_mi_w"/>
            <TextView
                android:id="@+id/tvBvnValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivBvnCopy"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:layout_marginStart="@dimen/dp8"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Copy"
                app:iiv_size="@dimen/dp20"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutBvnUnVerified"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ac_bvn"
                android:layout_weight="1"/>
            <TextView
                android:enabled="false"
                android:textColor="@color/ppColorWarning"
                android:gravity="center_vertical"
                android:background="@drawable/ac_bg_nin_state"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="Unverified"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/dp2"
                android:drawableStart="@drawable/ac_nin_not_verified"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp6"
                android:backgroundTint="@color/ppColorAssisBackground"
                android:drawableTint="@color/ppColorWarning"
                style="@style/txt_mi_w"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_verify"
                android:drawablePadding="4dp"
                app:iiv_end_color="@color/ppColorTextAssist"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp16"
                style="@style/txt_s_b"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerBvn"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp50">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tv11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ac_full_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="end"
                android:id="@+id/tv12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv11"
                app:layout_constraintTop_toTopOf="@+id/tv11"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dividerName"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tv21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_gender"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="end"
                android:id="@+id/tv22"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerGender"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tv31"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_date_of_birth"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="end"
                android:id="@+id/tv32"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerDob"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tv51"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_face_photo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.mikepenz.iconics.view.IconicsTextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="end"
                android:id="@+id/tv52"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_view"
                app:iiv_end_color="@color/ppColorTextAssist"
                app:iiv_end_icon="pay_ArrowCenterRight"
                app:iiv_end_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/dividerFacePhoto"
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
    </LinearLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/btnUpdateInfo"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_update_information"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutInfo"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
