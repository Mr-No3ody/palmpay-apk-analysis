<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="328dp"
        android:layout_height="100dp">
        <ImageView
            android:layout_width="328dp"
            android:layout_height="100dp"
            android:src="@drawable/cs_cl_calc_return_send_coupon_top_bg_v2"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp7"
            android:text="Limited Time BenefIts"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cs_cl_limited_time_benefits_bg"
        android:paddingTop="@dimen/dp20"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <TextView
            android:id="@+id/tvTitle"
            android:text="@string/cs_cl_loan_amount_title"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:textSize="@dimen/dp44"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            style="@style/txt_number_s_b_b"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutIncreaseTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6">
            <ImageView
                android:layout_gravity="right"
                android:layout_width="10dp"
                android:layout_height="7dp"
                android:layout_marginRight="@dimen/dp14"
                android:src="@drawable/cs_cl_icon_triangle"
                app:tint="@color/ppColorAssisBackground"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/cs_cl_amount_increase_tips_bg"
                android:paddingLeft="@dimen/dp6"
                android:paddingTop="@dimen/dp3"
                android:paddingRight="@dimen/dp6"
                android:paddingBottom="@dimen/dp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-3dp"
                android:paddingHorizontal="@dimen/dp6"
                android:paddingVertical="@dimen/dp3">
                <TextView
                    android:id="@+id/tvIncreaseTips"
                    style="@style/Text.medium.202046.10"/>
            </LinearLayout>
        </LinearLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/clickEvent_limitedTimeBenefits_borrowAgain_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_cl_borrow_again"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/ppButtonStyle"/>
        <TextView
            android:layout_gravity="right"
            android:id="@+id/tvSavedAmount"
            android:background="@drawable/cs_cl_borrow_discount_bg"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp6"
            android:visibility="gone"
            android:layout_height="@dimen/dp16"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="-52dp"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/Text.medium.ffffff.10"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/clickEvent_limitedTimeBenefits_close_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:src="@drawable/cs_cl_closed_white_icon"/>
</LinearLayout>
