<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/main_str_total_assets"/>
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16">
                    <ImageView
                        android:id="@+id/ivShield"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/main_one_million_shield"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/ivLogo"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp24"
                        android:src="@drawable/main_palm_safe_logo"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/layoutSecurityGuaranteed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent">
                        <ViewStub
                            android:id="@+id/layoutSecurityGuaranteedStub"
                            android:layout="@layout/main_layout_my_assets_top_bar"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp24"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvTotalAssets"
                        android:layout_marginTop="16dp"
                        android:text="@string/main_str_total_assets"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layoutSecurityGuaranteed"
                        style="@style/Text.202046.14"/>
                    <ImageView
                        android:id="@+id/ivToggleShowBalance"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:src="@drawable/cv_shape_eye"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvTotalAssets"
                        app:layout_constraintLeft_toRightOf="@+id/tvTotalAssets"
                        app:layout_constraintTop_toTopOf="@+id/tvTotalAssets"/>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/tvTotalAssetsAmount"
                        android:layout_marginTop="@dimen/dp6"
                        android:includeFontPadding="false"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalAssets"
                        style="@style/Text.202046.32"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivNetworkTips"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cv_arrow_up_dark"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toTopOf="@+id/tvNetworkTips"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <com.transsnet.palmpay.custom_view.RoundedTextView
                        android:gravity="center"
                        android:id="@+id/tvNetworkTips"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp8"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp8"
                        android:paddingVertical="@dimen/dp4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalAssetsAmount"
                        app:rtv_background_color="@color/ppColorBackgroundDark"
                        app:rtv_corner_radius="8dp"
                        style="@style/txt_mi_g"/>
                    <androidx.core.widget.ContentLoadingProgressBar
                        android:theme="@style/MainContentLoadingProgress"
                        android:id="@+id/loadingView"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvTotalAssetsAmount"
                        app:layout_constraintStart_toEndOf="@+id/tvTotalAssetsAmount"
                        app:layout_constraintTop_toTopOf="@+id/tvTotalAssetsAmount"
                        style="?android:attr/progressBarStyleLarge"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvYesterdayReturn"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:drawablePadding="2dp"
                        android:paddingHorizontal="8dp"
                        app:iiv_end_color="@color/ppColorTextNormal"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalAssetsAmount"
                        style="@style/txt_mi_g"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/csl_saving_report"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <TextView
                        android:textColor="@color/ppColorTextNormal"
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.202046.12"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvEarningsAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        app:iiv_end_color="@color/ppColorTextNormal"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_mi_g"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/itemContainer"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:paddingBottom="@dimen/dp16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/itemPointsStub"
                    android:layout="@layout/main_layout_total_asset_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/itemContainer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/adViewStub"
                    android:layout="@layout/core_layout_common_single_ad_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/vsAdCompliance"
                    android:layout="@layout/core_layout_common_single_ad_view"
                    android:inflatedId="@+id/adCompliance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aivCompliance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/bottomStub"
                    android:layout="@layout/cv_layout_login_register_bottom_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/adView"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
</LinearLayout>
