<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/airtimeHomeTopUpAmountLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16">
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/sav_airtime_pocker_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space_ad_mid_bill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/sav_airtime_pocker_banner"
        app:layout_goneMarginBottom="0dp"/>
    <View
        android:id="@+id/view_topup_bg"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_pay"
        app:layout_constraintTop_toBottomOf="@+id/space_ad_mid_bill"/>
    <TextView
        android:id="@+id/tv_airtime_pocker_banner_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/qt_sell_amount"
        android:drawablePadding="@dimen/dp4"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_topup_bg"
        style="@style/txt_me_b_b"/>
    <TextView
        android:id="@+id/tv_airtime_balance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Airtime balance: N0.00"
        android:drawablePadding="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_airtime_pocker_banner_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_airtime_pocker_banner_title"
        style="@style/Text.9ca2aa.12"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/atuaPickAmountRcv"
        android:paddingBottom="@dimen/dp5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@+id/tv_airtime_pocker_banner_title"/>
    <com.palmpay.lib.ui.edit.PpAmountEditText
        android:id="@+id/inputAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp16"
        android:inputType="numberDecimal"
        android:layout_marginHorizontal="@dimen/dp16"
        app:am_edit_show_lock="false"
        app:am_edit_show_title="false"
        app:am_edit_text_size="@dimen/dp22"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/atuaPickAmountRcv"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#858a8f"
        android:gravity="start"
        android:id="@+id/airtime_agree_tx"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginRight="16dp"
        android:text="@string/qt_airtime_str_recharge2cash_agree1"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inputAmount"
        style="@style/Text.6f7b85.12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="@dimen/dp12"
        app:constraint_referenced_ids="airtime_agree_tx"/>
</androidx.constraintlayout.widget.ConstraintLayout>
