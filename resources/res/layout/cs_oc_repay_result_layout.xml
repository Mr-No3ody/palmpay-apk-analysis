<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="70dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.core.viewmodel.ModelPaymentResultProgress
                android:id="@+id/lite_repayment_result_progress_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemOrderNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/core_reference_no_2"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/core_payment_method"/>
            <com.transsnet.palmpay.custom_view.model.ModelPreviewItem
                android:id="@+id/itemTransType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cv_te_title="@string/core_receipt_transaction_type"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/repayment_plan_title_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp90"
                android:text="@string/cs_your_repayment_plan"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/upcoming_payment_cl"
                android:background="@drawable/cs_oc_repay_result_plan_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/csTextview92"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_upcoming_payment"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cs_main_color"
                    android:id="@+id/coming_due_date_tv"
                    android:background="@drawable/cs_oc_repay_result_due_txt_bg"
                    android:paddingTop="@dimen/dp2"
                    android:paddingBottom="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/cs_coming_due_on"
                    android:paddingStart="@dimen/dp4"
                    android:paddingEnd="@dimen/dp4"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/coming_payment_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="@+id/csTextview92"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview92"/>
                <View
                    android:id="@+id/csTextview120"
                    android:background="@color/ppColorBackgroundLight"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/coming_payment_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextBase"
                    android:id="@+id/repayment_plan_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/cs_coming_repayment_plan"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview120"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/oc_repay_result_top_sav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/oc_repay_result_middle_first_sav"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_weight="1"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/oc_repay_result_middle_second_sav"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_weight="1"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/oc_repay_result_middle_third_sav"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_weight="1"/>
                </LinearLayout>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/oc_repay_result_bottom_sav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="18sp"
            android:textColor="@color/cs_main_color"
            android:id="@+id/lite_result_complete_bt"
            android:background="@drawable/cv_button_bg_light_purple_corner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:text="@string/core_complete"
            android:textAllCaps="false"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lite_result_again_bt"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button
            android:textSize="18sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/lite_result_again_bt"
            android:background="@drawable/cs_renew_tv_bg"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:text="@string/core_pay_again"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lite_result_complete_bt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
