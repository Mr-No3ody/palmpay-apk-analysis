<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="116dp">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_recommended_data_offers"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <View
        android:id="@+id/quick_buy_item"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorWarning"
        android:ellipsize="end"
        android:id="@+id/tvTag"
        android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_br_8"
        android:paddingLeft="@dimen/dp4"
        android:paddingTop="@dimen/dp2"
        android:paddingRight="@dimen/dp4"
        android:paddingBottom="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp4"
        android:paddingVertical="@dimen/dp2"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="@+id/quick_buy_item"
        app:layout_constraintTop_toTopOf="@+id/quick_buy_item"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/tvBuy"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ppMiniButtonHeight"
        android:text="@string/core_pay"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvBusinessPrice"
        app:layout_constraintEnd_toEndOf="@+id/quick_buy_item"
        app:layout_constraintTop_toTopOf="@+id/quick_buy_item"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/ppSmallStrokeButtonNoPaddingStyle"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/tvBusinessPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:includeFontPadding="false"
        android:fontFamily="@font/lib_ui_number_normal"
        app:layout_constraintBottom_toBottomOf="@+id/quick_buy_item"
        app:layout_constraintEnd_toEndOf="@+id/tvBuy"
        app:layout_constraintStart_toStartOf="@+id/tvBuy"
        app:layout_constraintTop_toBottomOf="@+id/tvBuy"
        style="@style/txt_number_s_b"/>
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/quick_buy_item"
        app:layout_constraintStart_toStartOf="@+id/quick_buy_item"
        app:layout_constraintTop_toTopOf="@+id/quick_buy_item"/>
    <TextView
        android:textSize="@dimen/dp22"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintEnd_toStartOf="@+id/tvBuy"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/quick_buy_item"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/quick_buy_item"
        app:layout_constraintEnd_toEndOf="@+id/quick_buy_item"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/Text.202046.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_info"
        android:visibility="gone"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp12"
        android:layout_marginStart="@dimen/dp2"
        android:layout_marginEnd="@dimen/dp2"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_content"
        app:layout_constraintEnd_toStartOf="@+id/tvBuy"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_content"
        app:layout_constraintTop_toTopOf="@+id/tv_content"/>
</merge>
