<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:paddingTop="@dimen/fb_status_bar_height"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/fb_titleBar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_text_arrow_down="false"/>
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="38dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fb_title_attention"
        style="@style/fb_txt_l_b"/>
    <TextView
        android:gravity="center"
        android:paddingLeft="0dp"
        android:paddingTop="6dp"
        android:paddingRight="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp25"
        android:layout_marginRight="@dimen/fb_dp25"
        android:text="@string/fb_msg_verify_otp_for_risk_control"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginHorizontal="@dimen/fb_dp25"
        style="@style/fb_txt_s_g"/>
    <com.flexibank.sdk.core.viewmodel.FlexiBankOneTimeCodeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_viewOtc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</LinearLayout>
