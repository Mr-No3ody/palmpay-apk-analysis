<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/core_card_pin_title"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextDisable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_please_enter_your_card_pin"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_card_pin"
        style="@style/AddCardItemTitleStyle"/>
    <EditText
        android:id="@+id/input_card_pin_et"
        android:background="@drawable/core_common_et_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/core_enter_card_pin"
        android:maxLength="4"
        android:inputType="number"
        style="@style/AddCardItemContentStyle"/>
    <Button
        android:enabled="false"
        android:textSize="@dimen/dp18"
        android:textColor="@color/ppColorTextBase"
        android:layout_gravity="center_horizontal"
        android:id="@+id/pin_next_bt"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_next"
        android:maxEms="4"
        android:textAllCaps="false"
        android:elevation="@dimen/dp5"/>
</LinearLayout>
