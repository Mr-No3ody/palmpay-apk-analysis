<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/select_bank_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_view"
        android:background="@drawable/cv_shape_halfround_background_dark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_below="@+id/select_bank_title_bar"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <ImageView
            android:id="@+id/search_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_search_icon"
            android:layout_marginEnd="@dimen/dp4"
            app:tint="@color/ppColorTextDisable"/>
        <com.transsnet.palmpay.custom_view.CompatStateEditText
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/search_et"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/sm_search"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bank_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/search_view"/>
    <com.transsnet.palmpay.send_money.ui.view.SideBarView
        android:id="@+id/side_bar"
        android:layout_width="20dp"
        android:layout_height="480dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:sm_press_bg_color="@color/ppColorBackgroundDark"
        app:sm_selectTextColor="@color/ppColorPrimary"
        app:sm_textColor="@color/ppColorTextPrimary"/>
</RelativeLayout>
