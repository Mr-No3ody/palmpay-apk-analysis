<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llExpand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="86dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clExpand"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:paddingTop="@dimen/dp4"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/core_coupon_middle"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvCouponDesc"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/ivShadow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llTop"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/rlLeft"
            android:background="@drawable/core_coupon_frame_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8">
                <ImageView
                    android:id="@+id/ivCouponIcon"
                    android:layout_width="@dimen/dp24"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginLeft="@dimen/dp12"
                    android:src="@drawable/cv_coupon_icon"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp14"
                    android:layout_toRightOf="@+id/icii_coupon_icon">
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:id="@+id/tvCouponName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="500"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/couponLimitTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="400"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="left"
                android:id="@+id/dateCouponTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp8"
                android:layout_toLeftOf="@+id/llDetailArrow"
                android:layout_alignParentBottom="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llDetailArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp8"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tvDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cv_detail"
                    android:includeFontPadding="false"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivExpandArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextNormal"
                    app:iiv_icon="pay_Arrowdown"
                    app:iiv_size="16dp"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llRight"
            android:background="@drawable/core_coupon_frame_right"
            android:layout_width="@dimen/dp100"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/dp24"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/icilCouponAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                style="@style/txt_number_s_b_b"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/icilUseTv"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="@dimen/dp64"
                android:layout_height="@dimen/dp24"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/core_use"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
