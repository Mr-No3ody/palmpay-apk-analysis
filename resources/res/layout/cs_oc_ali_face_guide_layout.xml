<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/oc_photo_guide_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cs_oc_router_top_bar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.credit.view.OpenAccountRouterProgressViewV2
                android:id="@+id/router_progress_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="left"
                android:id="@+id/tvDeclinedMsg"
                android:background="@drawable/cv_shape_rect_corner_12_bg_error_background"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_marginLeft="@dimen/dp24"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/dp24"
                android:layout_marginHorizontal="@dimen/dp24"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/router_progress_view"
                style="@style/Text.202046.14"/>
            <ImageView
                android:id="@+id/csImageview34"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview175"
                app:srcCompat="@drawable/cs_cl_take_photo_img"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cs_cl_take_photo_proto_txt_color"
                android:id="@+id/take_photo_proto_tv"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview117"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Face Recognition"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeclinedMsg"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/csTextview175"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp48"
                android:layout_marginTop="6dp"
                android:layout_marginRight="@dimen/dp48"
                android:text="@string/cs_oc_we_require"
                android:layout_marginHorizontal="@dimen/dp48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview117"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview177"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cs_oc_before_taking"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csImageview34"/>
            <ImageView
                android:id="@+id/csImageview51"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp44"
                android:layout_marginStart="50dp"
                app:layout_constraintEnd_toStartOf="@+id/csImageview52"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview177"
                app:srcCompat="@drawable/cs_oc_glasses"/>
            <ImageView
                android:id="@+id/csImageview52"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/csImageview51"
                app:layout_constraintEnd_toStartOf="@+id/csImageview53"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/csImageview51"
                app:layout_constraintTop_toTopOf="@+id/csImageview51"
                app:srcCompat="@drawable/cs_oc_avatar"/>
            <ImageView
                android:id="@+id/csImageview53"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="50dp"
                app:layout_constraintBottom_toBottomOf="@+id/csImageview52"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/csImageview52"
                app:layout_constraintTop_toTopOf="@+id/csImageview52"
                app:srcCompat="@drawable/cs_oc_light"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/csTextview184"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_you_are_not_wearing_glasses"
                app:layout_constraintEnd_toEndOf="@+id/csImageview51"
                app:layout_constraintStart_toStartOf="@+id/csImageview51"
                app:layout_constraintTop_toBottomOf="@+id/csImageview51"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/csTextview185"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_your_face_is_inside_the_frame"
                app:layout_constraintEnd_toEndOf="@+id/csImageview52"
                app:layout_constraintStart_toStartOf="@+id/csImageview52"
                app:layout_constraintTop_toBottomOf="@+id/csImageview52"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/csTextview186"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_there_good_lighting"
                app:layout_constraintEnd_toEndOf="@+id/csImageview53"
                app:layout_constraintStart_toStartOf="@+id/csImageview53"
                app:layout_constraintTop_toBottomOf="@+id/csImageview53"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10"
        android:text="PalmPay prioritize the security of your data"
        android:drawablePadding="4dp"
        app:iiv_start_color="@color/ppColorSuccess"
        app:iiv_start_icon="pay_Security"
        app:iiv_start_size="@dimen/dp16"
        style="@style/txt_mi_lg"/>
    <Button
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/take_photo_guide_img"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginBottom="12dp"
        android:text="@string/cs_take_selfie_now"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/cs_cl_take_photo_icon"/>
</LinearLayout>
