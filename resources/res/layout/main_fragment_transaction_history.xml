<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/core_download"
        app:title_bar_title="@string/main_transaction_history"/>
    <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
        android:id="@+id/topTextAd"
        android:paddingLeft="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        android:drawablePadding="@dimen/dp5"
        app:slot_id="@string/ad_transaction_history_top_slot_id"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:slot_id="@string/main_ad_transaction_history_slot_id"/>
    <com.transsnet.palmpay.ui.view.TransHistoryFilterLayout
        android:id="@+id/filterFloatLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:orientation="vertical"
            android:id="@+id/srlBillList"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBillList"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@null"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <include
            android:id="@+id/includeLayout"
            layout="@layout/main_item_history_month"/>
    </FrameLayout>
</LinearLayout>
