<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/mm_color_f6f6fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="@string/mm_plan_detail_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llAdvanceModule"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="12dp"
                android:paddingTop="12dp"
                android:paddingRight="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tvAdvanceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Savings Advance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.medium.202046.16"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llAdvanceChildModule"
                    android:background="@drawable/cv_rect_corner_8_bg_f6f6fa"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvAdvanceTitle">
                    <TextView
                        android:id="@+id/tvRepayableAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/itv_total_amount"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/itv_total_amount"
                        style="@style/Text.202046.12"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorTextNormal"
                        android:gravity="center_vertical"
                        android:id="@+id/itv_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Repayable Amount"
                        app:iiv_end_color="@color/ppColorTextNormal"
                        app:iiv_end_icon="pay_InformationOutline"
                        app:iiv_end_padding="2dp"
                        app:iiv_end_size="@dimen/dp18"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorTextNormal"
                        android:gravity="center_vertical"
                        android:id="@+id/itv_due_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Due Date"
                        app:iiv_end_color="@color/ppColorTextNormal"
                        app:iiv_end_icon="pay_InformationOutline"
                        app:iiv_end_padding="2dp"
                        app:iiv_end_size="@dimen/dp18"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/itv_total_amount"/>
                    <TextView
                        android:id="@+id/tvDueDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/itv_due_date"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/itv_due_date"
                        style="@style/Text.202046.12"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorTextNormal"
                        android:gravity="center_vertical"
                        android:id="@+id/itv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Advance Status"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/itv_due_date"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="12dp"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center_vertical"
                        android:id="@+id/itv_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/itv_due_date"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.palmpay.lib.ui.button.PpButton
                    android:gravity="center"
                    android:id="@+id/btnRepay"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Repay"
                    app:layout_constraintTop_toBottomOf="@+id/llAdvanceChildModule"
                    style="@style/ppButtonStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/layoutPlanDetailInfo"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"
                android:layout_marginVertical="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/llAdvanceModule">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="left"
                        android:id="@+id/tvPlanTitle"
                        android:layout_width="0dp"
                        android:layout_marginRight="@dimen/dp40"
                        android:singleLine="true"
                        android:layout_weight="1"
                        style="@style/Text.medium.202046.16"/>
                    <TextView
                        android:id="@+id/tvPlanStatus"
                        style="@style/Text.medium.ffffff.14"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutPlanInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_marginVertical="@dimen/dp8"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutSecInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/vAutoRenewalLine"
                    android:background="@color/ppColorDividerLine"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginVertical="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutAutoRenewalExtroInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/btnPlanBreak"
                    android:background="@drawable/mm_shape_rect_corner_12_bg_white_stroke_purple"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="Break This Plan"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="center"
                    android:layout_marginVertical="12dp"
                    app:autoSizeMaxTextSize="@dimen/dp16"
                    app:autoSizeMinTextSize="4dp"
                    app:autoSizeTextType="uniform"
                    style="@style/Text.6f7b85.16"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutStrick"
                android:background="@drawable/cv_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:divider="@drawable/mm_bg_transparent_v_divider_8"
                android:showDividers="middle"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/layoutPlanDetailInfo">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:id="@+id/itvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Strict Savings Mode "
                    app:iiv_end_color="@color/ppColorTextAssist"
                    app:iiv_end_icon="pay_InformationOutline"
                    app:iiv_end_size="@dimen/dp14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.14"/>
                <TextView
                    android:id="@+id/tvLockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock savings until maturity date"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/itvTitle"
                    style="@style/Text.9ca2aa.12"/>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enabled"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.9ca2aa.14"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layoutPlanExtroInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/layoutStrick">
                <TextView
                    android:gravity="left"
                    android:id="@+id/tvPlanStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/Text.858a8f.12"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/mm_color_bbbbbb"
                android:layout_gravity="center_horizontal"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp24"
                android:visibility="gone"
                android:text="Licensed by the Central Bank of Nigeria"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintVertical_bias="1"
                style="@style/Text.ffffff.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
