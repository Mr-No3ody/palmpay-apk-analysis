<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp12">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="14dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:paddingEnd="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="#9b5d00"
        android:gravity="center_vertical"
        android:id="@+id/tvKycTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btnKyc"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_g"/>
    <TextView
        android:textColor="#9b5d00"
        android:gravity="center_vertical"
        android:id="@+id/tvKycMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnKyc"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvKycTitle"
        style="@style/txt_mi_g"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="12dp"
        android:textColor="#9b5d00"
        android:gravity="center"
        android:id="@+id/btnKyc"
        android:background="@drawable/main_btn_card_state_2"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:minWidth="@dimen/dp40"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_marginVertical="12dp"
        android:paddingHorizontal="4dp"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppStrokeButtonNoPaddingStyle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="48dp"
        app:ad_use_coroutine="true"
        app:layout_constraintBottom_toBottomOf="@+id/btnKyc"
        app:layout_constraintStart_toStartOf="@+id/btnKyc"
        app:slot_id="@string/main_ad_home_me_kyc_slot_id"/>
</androidx.constraintlayout.widget.ConstraintLayout>
