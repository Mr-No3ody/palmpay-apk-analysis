<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textViewText"
        android:paddingLeft="@dimen/dp42"
        android:paddingRight="@dimen/dp42"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dp42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_b_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/textViewText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textViewText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
