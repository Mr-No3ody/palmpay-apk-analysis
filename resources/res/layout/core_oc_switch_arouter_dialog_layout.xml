<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:padding="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_other_methods"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/core_no_worries_choose"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bvn_ll"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp8">
            <ImageView
                android:layout_width="@dimen/dp50"
                android:layout_height="@dimen/dp50"
                android:src="@drawable/core_bvn_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp9"
                android:text="@string/core_switch_bvn_verification"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bank_account_ll"
            android:background="@drawable/core_oc_router_switch_selected_bg"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8">
            <ImageView
                android:id="@+id/account_img"
                android:layout_width="@dimen/dp50"
                android:layout_height="@dimen/dp50"
                android:src="@drawable/core_bank_account_icon"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/account_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp9"
                android:text="@string/core_switch_bank_account"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/confirm_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_confirm"
        android:textAllCaps="false"/>
</LinearLayout>
