<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cv_preview_item_height">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/cmup_money_num_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_points_to_use"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/cmup_tips_iv"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/cmup_money_num_title_tv"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="12dp"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cmup_point_used_ll"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorWarning"
            android:id="@+id/cmup_point_sign_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_digit_p_upper"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorWarning"
            android:id="@+id/cmup_point_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_digit_0"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_marginRight="@dimen/dp5"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Exchange"
            app:iiv_size="16dp"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/cmup_money_sign_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/cmup_money_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/core_digit_0"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:id="@+id/cmup_point_unused_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/txt_s_b_b"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/cmup_switch"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:checked="false"
        android:thumb="@drawable/cv_switch_thumb"
        android:layout_marginStart="10dp"
        app:switchMinWidth="36dp"
        app:track="@drawable/cv_switch_track"/>
</LinearLayout>
