<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="@string/core_fund"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp90"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="@color/cv_color_ffffff"
                android:paddingLeft="@dimen/dp15"
                android:paddingRight="@dimen/dp15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp22"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ciar_result_hint_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ciar_iv"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextNormal"
                    android:gravity="center_horizontal"
                    android:id="@+id/ciar_result_hint_text_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp25"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp25"
                    android:text="@string/ci_fund_success_hint_text"
                    android:layout_below="@+id/ciar_result_hint_tv"
                    android:layout_centerHorizontal="true"
                    android:lineSpacingExtra="3dp"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ciar_iv"
                    android:layout_width="@dimen/cv_result_success_img_size"
                    android:layout_height="@dimen/cv_result_success_img_size"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_centerHorizontal="true"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/cv_result_success"/>
            </RelativeLayout>
            <com.transsnet.palmpay.cash_in.ui.view.ModelFundPaymentResultProgress
                android:id="@+id/payProgress"
                android:background="@color/cv_color_ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_order_info"
                android:background="@color/cv_color_ffffff"
                android:paddingTop="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/cia_success_ad1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/ad_fund_result_success1"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/actur_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <com.transsnet.palmpay.core.viewmodel.FailResultPageAdView
                android:id="@+id/cia_fail_okcard_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/dp25"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/cv_color_ffffff"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/ciar_complete_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"
            style="@style/Text.medium.6306b2.16"/>
        <TextView
            android:gravity="center"
            android:id="@+id/ciar_fund_again_btn"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/core_add_again"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </LinearLayout>
</LinearLayout>
