<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/jp_refer_earn_dialog_bg"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/jp_rich_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        app:iiv_color="@color/ppColorTextBase"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp20"
        app:layout_constraintBottom_toTopOf="@+id/jp_rich_dialog_confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_rich_dialog_close">
        <TextView
            android:textSize="@dimen/dp22"
            android:textColor="#ffce33"
            android:gravity="center"
            android:id="@+id/jp_rich_dialog_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:fontFamily="sans-serif-black"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/jp_rich_dialog_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/jp_rich_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/cv_text_color_white"
            android:gravity="center"
            android:id="@+id/jp_rich_dialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp16"
        android:textColor="@color/cv_text_color_white"
        android:id="@+id/jp_rich_dialog_cancel"
        android:background="@drawable/jp_shape_gray_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp20"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/jp_rich_dialog_content2"
        app:layout_constraintEnd_toStartOf="@+id/jp_rich_dialog_confirm"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/jp_rich_dialog_confirm"
        android:background="@drawable/jp_shape_orange_r30_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp20"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/jp_rich_dialog_content2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/jp_rich_dialog_cancel"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/cv_text_color_white"
        android:gravity="center"
        android:id="@+id/jp_rich_dialog_content2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp20"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
