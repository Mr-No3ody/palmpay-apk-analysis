<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/viewContainer"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24">
        <TextView
            android:textSize="@dimen/dp25"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/main_discover_new_version"
            android:layout_marginStart="24dp"
            android:textFontWeight="700"
            app:layout_constrainedWidth="true"
            app:layout_constraintRight_toLeftOf="@+id/imageViewHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/textViewMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintStart_toStartOf="@+id/textViewTitle"
            app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="start|top"
            android:id="@+id/textViewNote"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="@dimen/large_margin"
            android:maxHeight="200dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewMessage"
            style="@style/txt_mi_g"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp25"
            android:layout_marginBottom="30dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewNote">
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/textViewCancel"
                android:visibility="visible"
                android:layout_width="0dp"
                android:maxWidth="@dimen/dp200"
                android:text="@string/main_ignore"
                android:layout_weight="1"
                style="@style/ppSecondaryButtonStyle"/>
            <View
                android:id="@+id/viewGap"
                android:layout_width="15dp"
                android:layout_height="match_parent"/>
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/textViewOk"
                android:visibility="visible"
                android:layout_width="0dp"
                android:maxWidth="@dimen/dp200"
                android:text="@string/main_update_now"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:autoSizeText="true"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/update_remark_tv"
            android:background="@drawable/main_update_mark_bg_2"
            android:paddingLeft="@dimen/dp2"
            android:paddingRight="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:layout_marginTop="@dimen/dp18"
            android:layout_marginEnd="@dimen/dp2"
            android:paddingHorizontal="@dimen/dp2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewNote"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/imageViewHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp23"
            android:scaleType="fitXY"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvDownload"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonContainer"
            style="@style/txt_s_g"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
