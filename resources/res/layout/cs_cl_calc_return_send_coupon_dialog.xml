<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="328dp"
        android:layout_height="100dp">
        <ImageView
            android:layout_width="328dp"
            android:layout_height="100dp"
            android:src="@drawable/cs_cl_calc_return_send_coupon_top_bg_v2"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp7"
            android:text="Limited Time BenefIts"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@drawable/cs_cl_bg_calc_return_send_coupon_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tvCouponHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:fontFamily="sans-serif-medium"/>
        <RelativeLayout
            android:id="@+id/rlContent"
            android:background="@drawable/cs_cl_calc_return_send_coupon_content_bg"
            android:padding="@dimen/dp10"
            android:layout_width="@dimen/dp208"
            android:layout_height="@dimen/dp72"
            android:layout_marginTop="@dimen/dp16"
            android:layout_below="@+id/tvCouponHint"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="32sp"
                    android:textColor="#9f6000"
                    android:id="@+id/tvCouponDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#9f6000"
                    android:id="@+id/tvCouponDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp2"
                    android:text="Interest discount"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#9f6000"
                android:gravity="center_horizontal"
                android:id="@+id/tvCouponValid"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_white_1000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvBorrow"
            android:background="@drawable/cs_cl_borrow_txt_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp24"
            android:text="@string/cs_cl_borrow"
            android:layout_below="@+id/rlContent"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:src="@drawable/cs_cl_closed_white_icon"/>
</LinearLayout>
