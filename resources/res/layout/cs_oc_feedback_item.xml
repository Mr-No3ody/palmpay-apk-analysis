<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginStart="@dimen/dp16"
    android:layout_marginEnd="@dimen/dp16">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/feedback_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="@dimen/dp280"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#38d79f"
        android:gravity="center"
        android:id="@+id/feedback_status_tv"
        android:background="@drawable/cs_oc_feedback_status_tv_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp18"
        android:drawablePadding="@dimen/dp11"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_title_tv"
        app:layout_constraintStart_toEndOf="@+id/feedback_title_tv"
        app:layout_constraintTop_toTopOf="@+id/feedback_title_tv"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#858a8f"
        android:ellipsize="end"
        android:id="@+id/feedback_no_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="@dimen/dp260"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/feedback_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/feedback_title_tv"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/copy_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_Copy"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_no_tv"
        app:layout_constraintStart_toEndOf="@+id/feedback_no_tv"
        app:layout_constraintTop_toTopOf="@+id/feedback_no_tv"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/feedback_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/feedback_no_tv"
        app:layout_constraintTop_toBottomOf="@+id/feedback_no_tv"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp20"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
