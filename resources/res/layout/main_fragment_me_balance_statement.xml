<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:paddingStart="@dimen/dp24"
        android:paddingEnd="@dimen/extra_margin">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp20"
            android:gravity="center_vertical"
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            app:iiv_end_color="@color/ppColorPrimary"
            app:iiv_end_icon="pay_Arrowdown"
            app:iiv_end_size="@dimen/dp16"
            style="@style/txt_me_b_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/summaryContainer"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tvMonth">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_in"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_out"
                android:layout_marginStart="@dimen/dp24"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/tvOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                android:layout_marginEnd="@dimen/extra_margin"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/billList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
