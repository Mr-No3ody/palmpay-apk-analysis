<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_label"
        android:visibility="visible"
        android:layout_width="@dimen/ppEditTextLabelWidth"
        android:layout_height="@dimen/ppEditTextLabelHeight"
        android:layout_marginLeft="@dimen/ppEditTextMarginLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_4"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_country_code"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <TextView
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tv_country_code"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppEditTextCountryHeight"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_1"
        app:layout_constraintLeft_toRightOf="@+id/tv_label"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/ppEditTextSize_16"
        android:textColorHint="@color/ppColorTextDisable"
        android:id="@+id/et_input"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppEditTextHeight"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_18"
        android:layout_marginRight="@dimen/ppEditTextMarginIconLeft"
        android:maxLines="1"
        android:inputType="phone"
        android:fontFamily="sans-serif-medium"
        android:autofillHints=""
        app:hintTextColor="@color/ppColorTextDisable"
        app:layout_constraintLeft_toRightOf="@+id/tv_country_code"
        app:layout_constraintRight_toLeftOf="@+id/iv_end_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginIconLeft"
        app:layout_goneMarginRight="@dimen/ppEditTextMarginRight_48"/>
    <ImageView
        android:id="@+id/iv_end_icon"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:layout_centerVertical="true"
        android:contentDescription="endIcon"
        android:layout_marginEnd="@dimen/ppEditTextMarginRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <ImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="@dimen/ppEditTextHeight"
        android:layout_height="@dimen/ppEditTextHeight"
        android:src="@drawable/lib_ui_icon_edit_clear_24dp"
        android:layout_centerVertical="true"
        android:contentDescription="clearIcon"
        android:layout_marginEnd="@dimen/ppEditTextMarginRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <TextView
        android:textSize="@dimen/ppEditTextSize_12"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_error_message"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppEditTextLabelHeight"
        android:layout_marginLeft="@dimen/ppEditTextMarginIconLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_2"
        android:layout_marginRight="@dimen/ppEditTextMarginRight"
        android:maxLines="2"
        app:layout_constraintLeft_toRightOf="@+id/tv_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input"
        app:layout_goneMarginLeft="@dimen/ppEditTextMarginLeft"/>
    <View
        android:id="@+id/iv_line"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/ppEditTextMarginLeft"
        android:layout_marginTop="@dimen/ppEditTextMarginTop_2"
        android:layout_marginRight="@dimen/ppEditTextMarginRight"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_message"
        app:layout_goneMarginTop="@dimen/ppEditTextMarginTop_18"/>
</androidx.constraintlayout.widget.ConstraintLayout>
