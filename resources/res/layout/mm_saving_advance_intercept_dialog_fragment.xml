<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp24"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTitle"
        android:layout_marginTop="@dimen/dp16"
        android:text="A Better Way than Breaking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.16"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="174dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <ImageView
            android:id="@+id/ivBreakPanelBg"
            android:layout_width="171dp"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/mm_bg_advance_intercept_break_panel"
            android:scaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivAdvancePanelBg"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginLeft="-38dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/mm_bg_advance_intercept_advance_panel"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBreakPanelBg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvRecommendBadge"
            android:background="@drawable/mm_bg_advance_intercept_recommend_badge"
            android:paddingLeft="5dp"
            android:paddingTop="1dp"
            android:paddingRight="5dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Recommend"
            android:includeFontPadding="false"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.ffffff.10"/>
        <ImageView
            android:id="@+id/flVsBadge"
            android:background="@drawable/mm_vs"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginLeft="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="@+id/ivBreakPanelBg"
            app:layout_constraintStart_toStartOf="@+id/ivAdvancePanelBg"
            app:layout_constraintTop_toTopOf="@+id/ivBreakPanelBg"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llBreakContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvBreakTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Break Now"
                android:includeFontPadding="false"
                style="@style/Text.medium.202046.16"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <FrameLayout
                    android:background="@drawable/mm_bg_advance_intercept_icon_circle_gray"
                    android:layout_width="20dp"
                    android:layout_height="20dp">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_CloseFill"
                        app:iiv_size="13dp"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/tvLoseInterest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lose All Interest"
                    android:includeFontPadding="false"
                    android:layout_marginStart="8dp"
                    style="@style/Text.9ca2aa.12"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llAdvanceContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="55dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ivAdvancePanelBg"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvAdvanceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings Advance"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                style="@style/Text.medium.202046.16"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/mm_agent_card"/>
                <TextView
                    android:id="@+id/tvRepayAnytime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repay Anytime"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_marginStart="8dp"
                    style="@style/Text.202046.12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/mm_cash_inout"/>
                <TextView
                    android:id="@+id/tvDailyFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.2% Daily Fee"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_marginStart="8dp"
                    style="@style/Text.202046.12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/mm_interest"/>
                <TextView
                    android:id="@+id/tvKeepInterest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep All Interest"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_marginStart="8dp"
                    style="@style/Text.202046.12"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/rtvAdvance"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Get Extra Funds Now"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llContent"
        style="@style/ppButtonStyle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/rtvSetBreak"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Still Break"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rtvAdvance"
        style="@style/ppSecondaryButtonStyle"/>
    <TextView
        android:id="@+id/tvAggainNot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="Don&apos;t remind again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rtvSetBreak"
        style="@style/Text.9ca2aa.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
