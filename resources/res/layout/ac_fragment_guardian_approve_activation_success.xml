<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="true"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/btnStartPalmPay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivSuccessIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorSuccess"
                    app:iiv_icon="pay_SelectedFill"
                    app:iiv_size="48dp"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/ac_guardian_activation_success_title"
                    style="@style/Text.medium.202046.18"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:text="@string/ac_guardian_activation_success_subtitle"
                    style="@style/Text.6f7b85.14"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/layoutAccountHighlight"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp6"
                    android:paddingBottom="@dimen/dp6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/dp6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tvAccountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ac_guardian_minor_account_number_label"
                        style="@style/Text.202046.12"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:textSize="@dimen/dp22"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/tvAccountNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cv_palmpay_number_bold"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivCopy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp4"
                            app:iiv_color="@color/ppColorTextPrimary"
                            app:iiv_icon="pay_Copy"
                            app:iiv_size="20dp"/>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/layoutKeyValueList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutAccountHighlight">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerKeyValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:gravity="start"
                android:id="@+id/tvYouMayChoose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:text="@string/ac_guardian_you_may_choose"
                style="@style/Text.medium.202046.14"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowMinorManagement"
                    android:background="?attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ac_guardian_minor_account_management"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/Text.202046.14"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="20dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/dividerList"
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginLeft="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp12"
                    android:layout_marginHorizontal="@dimen/dp12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowMinorManagement"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rowTransferToMinor"
                    android:background="?attr/selectableItemBackground"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerList">
                    <TextView
                        android:ellipsize="end"
                        android:gravity="start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ac_guardian_transfer_to_minor"
                        android:maxLines="1"
                        android:layout_weight="1"
                        style="@style/Text.202046.14"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="20dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/btnStartPalmPay"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/ac_guardian_start_palmpay"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ppButtonStyle"/>
    <ViewStub
        android:id="@+id/bottomViewStub"
        android:layout="@layout/cv_layout_login_register_bottom_view"
        android:inflatedId="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
