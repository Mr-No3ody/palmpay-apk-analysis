<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/textViewConfirm"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginHorizontal="@dimen/dp20">
            <TextView
                android:textSize="24dp"
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ac_enter_your_address"
                style="@style/txt_bb_b_b"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="@dimen/dp24"
                android:text="Please provide your complete residential address."
                style="@style/txt_s_g"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:id="@+id/inputAddressLevel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:importantForAutofill="noExcludeDescendants"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level1_name"
                style="@style/AcPpFormStyle2"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:enabled="false"
                android:id="@+id/inputAddressLevel2"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="noExcludeDescendants"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level2_name"
                style="@style/AcPpFormStyle2"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:enabled="false"
                android:id="@+id/inputAddressLevel3"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="noExcludeDescendants"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level3_name"
                style="@style/AcPpFormStyle2"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:id="@+id/inputStreet"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="noExcludeDescendants"
                app:form_edit_focusable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="Including house number and street"
                app:form_label_text="@string/ac_street_address"
                style="@style/AcPpFormStyle2"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="center_vertical"
                android:id="@+id/tvAddressError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_mi_g"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/textViewConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_next"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarrier"
        app:layout_goneMarginBottom="@dimen/dp16"
        style="@style/ppButtonStyle"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:layout_gravity="end|top"
        android:id="@+id/cornerAd"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="-14dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="@+id/textViewConfirm"
        app:layout_constraintTop_toTopOf="@+id/textViewConfirm"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tvSkip, bottomView"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvSkip"
        android:padding="@dimen/dp15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_skip"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/txt_s_g"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
