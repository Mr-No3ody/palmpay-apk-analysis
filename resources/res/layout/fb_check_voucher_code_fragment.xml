<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flexibank.sdk.cashier.ui.view.FlexiBankModelPageTitleAreaInPayVerifyPage
        android:id="@+id/fb_cmf_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fb_cta_content_text="@string/fb_vodafone_voucher_desc"
        app:fb_cta_title="@string/fb_vodafone_voucher_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/fb_shape_rect_corner_lt_rt_8_bg_white"
        android:paddingTop="@dimen/fb_dp8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/fb_dp172">
        <com.flexibank.sdk.customview.FlexiBankTitleEditView
            android:id="@+id/fb_cmf_mobile_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fb_dp15"
            android:layout_marginTop="@dimen/fb_dp30"
            android:layout_marginRight="@dimen/fb_dp15"
            app:fb_te_inputType="number"
            app:fb_te_title="@string/fb_voucher_code_text"/>
        <com.palmpay.lib.ui.button.PpButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/fb_cmf_next_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fb_dp50"
            android:layout_marginLeft="@dimen/fb_dp45"
            android:layout_marginTop="@dimen/fb_dp30"
            android:layout_marginRight="@dimen/fb_dp45"
            android:text="@string/fb_core_next"
            style="@style/fbButtonStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/fb_base_colorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/fb_voucher_guide_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/fb_how_to_create_a_voucher"
        android:drawableLeft="@drawable/fb_point_rate_icon"
        android:drawablePadding="5dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
