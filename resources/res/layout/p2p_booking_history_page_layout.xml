<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/p2p_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/p2p_str_booking_history"/>
    <FrameLayout
        android:id="@+id/p2p_entadasfdsaf"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextDisable"
            android:layout_gravity="center"
            android:id="@+id/p2p_asdfklaj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="33dp"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="13dp"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"/>
    </FrameLayout>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/p2p_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_entadasfdsaf">
        <FrameLayout
            android:id="@+id/p2p_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="500dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/p2p_empty_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/cv_empty_no_transaction_history"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/p2p_str_no_booking_yet"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/p2p_book_now"
                    android:layout_width="158dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#f0ecfc"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/p2p_theme_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/p2p_str_book_now"/>
                </androidx.cardview.widget.CardView>
                <FrameLayout
                    android:id="@+id/p2p_entadasfdsaf2"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    app:layout_constraintTop_toBottomOf="@+id/p2p_title">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextDisable"
                        android:layout_gravity="center"
                        android:id="@+id/p2p_asdfklaj2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="18dp"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_ArrowCenterRight"
                        app:iiv_size="@dimen/dp16"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </com.transsnet.palmpay.custom_view.SwipeRecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>
