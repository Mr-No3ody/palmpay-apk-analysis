<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewRoot"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_container_installment"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container_common"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/cl_open_result_mtb"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title_bar_title="@string/cs_application_result"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_open_result_mtb">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ViewStub
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/open_failed_stub"
                    android:layout="@layout/cs_cl_open_failed_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ViewStub
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/open_pending_stub"
                    android:layout="@layout/cs_cl_open_pending_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ViewStub
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/open_success_stub"
                    android:layout="@layout/cs_cl_open_success_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ViewStub
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/open_installment_success_stub"
                    android:layout="@layout/cs_cl_installment_open_success_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ViewStub
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/open_double_open_success_stub"
                    android:layout="@layout/cs_cl_double_open_success_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp40"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
