<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/oc_extend_mbt"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_iconfont_2="pay_CustomerService"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="Minimum Repayment"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cs_oc_repay_zone_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/currency_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/extend_amount_tv"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/extend_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/currency_tv"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_number_s_b_b"/>
        <View
            android:id="@+id/csTextview142"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/extend_amount_tv"/>
        <com.transsnet.palmpay.credit.view.RepayStampDutyView
            android:id="@+id/repayStampDutyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/csTextview142"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/init_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_initial_payment"
            android:drawablePadding="@dimen/dp6"
            android:drawableEnd="@drawable/cs_oc_spread_repay_tips"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/repayStampDutyView"
            app:layout_goneMarginTop="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/init_payment_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/init_payment_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/init_payment_title"
            app:layout_constraintTop_toTopOf="@+id/init_payment_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/csTextview143"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/cs_expend_overdue_interest"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/init_payment_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/extend_penalty_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview143"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview143"
            app:layout_constraintTop_toTopOf="@+id/csTextview143"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/csTextview145"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_expend_service_fee"
            app:layout_constraintStart_toStartOf="@+id/csTextview143"
            app:layout_constraintTop_toBottomOf="@+id/csTextview143"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/extend_fee_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview145"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview145"
            app:layout_constraintTop_toTopOf="@+id/csTextview145"/>
        <View
            android:id="@+id/expend_tips_divider_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/extend_fee_tv"
            app:layout_constraintStart_toStartOf="@+id/csTextview145"
            app:layout_constraintTop_toBottomOf="@+id/csTextview145"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/bottom_tips_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="16dp"
            android:text="@string/cs_oc_mini_repayment_explain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/extend_fee_tv"
            app:layout_constraintStart_toStartOf="@+id/csTextview145"
            app:layout_constraintTop_toBottomOf="@+id/expend_tips_divider_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/oc_extend_bt"
        android:background="@drawable/cs_oc_repay_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
