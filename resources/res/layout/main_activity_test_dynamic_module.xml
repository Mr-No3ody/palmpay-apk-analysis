<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="Text Dynamic Module"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/et_module_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp50"
                android:text="qrcard"
                android:hint="输入Module Name"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnInstall"
                    android:background="@drawable/cv_button_bg_purple_corner"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="10dp"
                    android:text="点击安装"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_s_w_b"/>
                <Button
                    android:id="@+id/btnIsInstalled"
                    android:background="@drawable/cv_button_bg_purple_corner"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="10dp"
                    android:text="是否已安装"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_s_w_b"/>
            </LinearLayout>
            <EditText
                android:id="@+id/et_sub_activity_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:minHeight="@dimen/dp50"
                android:text="com.transsnet.palmpay.qrcard.ui.activity.QRCardModuleInitActivity"
                android:hint="输入BaseDynamicInitModuleActivity的子类名"/>
            <Button
                android:id="@+id/btnGoToInitModuleActivity"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="10dp"
                android:text="跳转模块初始化界面"
                android:paddingHorizontal="@dimen/dp16"
                style="@style/txt_s_w_b"/>
            <EditText
                android:id="@+id/et_arouter_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:minHeight="@dimen/dp50"
                android:text="/qr_card/home_activity"
                android:hint="输入 ARouter Path"/>
            <Button
                android:id="@+id/btnGoToARouterActivity"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="10dp"
                android:text="跳转输入的ARouter模块界面"
                android:paddingHorizontal="@dimen/dp16"
                style="@style/txt_s_w_b"/>
            <Button
                android:id="@+id/btnGoByOneKey"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="10dp"
                android:text="一键安装并跳转"
                android:paddingHorizontal="@dimen/dp16"
                style="@style/txt_s_w_b"/>
            <EditText
                android:id="@+id/etSoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:minHeight="@dimen/dp50"
                android:text="/data/user/0/com.transsnet.palmpay/files/splitcompat/603271112/native-libraries/lib_dynamic_so.config.arm64_v8a"
                android:hint="输入 so 的文件名,不包含后缀"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btnCheckSoExist"
                    android:background="@drawable/cv_button_bg_purple_corner"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="10dp"
                    android:text="按加载顺序打印So路径下的文件"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_s_w_b"/>
                <Button
                    android:id="@+id/btnCheckSoPath"
                    android:background="@drawable/cv_button_bg_purple_corner"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingRight="@dimen/dp16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="10dp"
                    android:text="打印所有So路径"
                    android:paddingHorizontal="@dimen/dp16"
                    style="@style/txt_s_w_b"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnCopySoFile"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="10dp"
                android:text="按顺序加载So"
                android:paddingHorizontal="@dimen/dp16"
                style="@style/txt_s_w_b"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
