<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_bg_unverify_user"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/dp12"
        app:cardBackgroundColor="@color/transparent_white_20"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/white"
        app:iiv_icon="pay_WarningFill"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="@+id/cardView"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="@+id/cardView"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activate your account"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/tv2"
        app:layout_constraintStart_toEndOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Add your ID to verify account"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardView"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/txt_mi_g"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="12dp"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/btnVerify"
        android:background="@drawable/lib_ui_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp26"
        android:text="GO"
        android:layout_marginEnd="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppSmallButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
