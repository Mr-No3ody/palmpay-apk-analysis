<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/cv_shape_rect_top_corner_white_12"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:paddingTop="@dimen/dp16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ci_ussd_funding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/txt_b_b_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:padding="@dimen/dp16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:gravity="center_vertical"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/txt_b_b_b"/>
        <com.transsnet.palmpay.core.viewmodel.ModelItemFee
            android:id="@+id/itemAmount"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/dp26"
            android:layout_marginRight="@dimen/dp26"
            android:layout_marginHorizontal="@dimen/dp26"
            app:cv_bm_title="@string/ci_fund_amount"
            app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
        <com.transsnet.palmpay.core.viewmodel.ModelItemFee
            android:id="@+id/itemFee"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/dp26"
            android:layout_marginRight="@dimen/dp26"
            android:layout_marginHorizontal="@dimen/dp26"
            app:cv_bm_title="@string/core_fee"
            app:layout_constraintTop_toBottomOf="@+id/itemAmount"/>
        <com.transsnet.palmpay.core.viewmodel.ModelItemFee
            android:id="@+id/itemPoints"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/dp26"
            android:layout_marginRight="@dimen/dp26"
            android:layout_marginHorizontal="@dimen/dp26"
            app:cv_bm_title="@string/core_points_used"
            app:layout_constraintTop_toBottomOf="@+id/itemFee"/>
        <com.transsnet.palmpay.cash_in.ui.view.ModelUssdInfo
            android:id="@+id/ussdInfo"
            android:padding="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintTop_toBottomOf="@+id/itemPoints"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
