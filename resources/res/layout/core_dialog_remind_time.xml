<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="217dp">
    <RelativeLayout
        android:id="@+id/cdrt_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50">
        <TextView
            android:textSize="@dimen/dp22"
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/cltr_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/cdtr_close"
            android:padding="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
        <View
            android:background="@drawable/cv_shape_rect_corner_12_bg_disable"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp15"
            android:layout_marginEnd="@dimen/dp15"/>
    </RelativeLayout>
    <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
        android:id="@+id/wheel_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cdrt_confirm_tv"
        app:layout_constraintTop_toBottomOf="@+id/cdrt_title"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cdrt_confirm_tv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp12"
        android:text="@string/core_confirm"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
