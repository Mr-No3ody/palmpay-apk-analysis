<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
    android:paddingRight="15dp"
    android:paddingBottom="30dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="15dp">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end"
        android:id="@+id/imageViewClose"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/imageViewPic"
        android:layout_width="wrap_content"
        android:layout_height="128dp"
        android:layout_marginTop="0dp"
        android:scaleType="centerInside"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_msg_save_receipt_to_album"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewShare"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="200dp"
        android:layout_height="45dp"
        android:text="@string/core_share"
        style="@style/txt_me_w"/>
</LinearLayout>
