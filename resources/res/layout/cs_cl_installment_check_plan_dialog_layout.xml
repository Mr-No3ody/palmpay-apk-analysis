<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivTopContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp22"
        android:layout_marginRight="@dimen/dp22"
        android:src="@drawable/cs_cl_ic_installment_check_plan"
        android:layout_marginHorizontal="@dimen/dp22"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/cs_ic_check_plan_dialog_info_bg"/>
        <TextView
            android:textColor="@color/lib_ui_button_white_text_color"
            android:layout_gravity="center"
            android:id="@+id/tvTopContent"
            android:paddingLeft="@dimen/dp20"
            android:paddingRight="@dimen/dp20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp20"
            style="@style/Text.ffffff.16"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp24"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp24">
        <TextView
            android:gravity="start"
            android:id="@+id/tvBindBankCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_bind_bank_card_account_for_automatic_repayment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.14"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBindBankCard"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark_stroke_divider_line_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/tvBindBankCardTitle">
            <ImageView
                android:id="@+id/ivBindBankIcon"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                android:src="@drawable/core_bank_card_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_add_bank_account"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="@+id/ivBindBankIcon"
                app:layout_constraintStart_toEndOf="@+id/ivBindBankIcon"
                app:layout_constraintTop_toTopOf="@+id/ivBindBankIcon"
                style="@style/Text.202046.14"/>
            <TextView
                android:textColor="@color/lib_ui_button_white_text_color"
                android:id="@+id/btnAdd"
                android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
                android:layout_width="@dimen/dp62"
                android:layout_height="@dimen/dp24"
                android:text="@string/core_add"
                app:layout_constraintBottom_toBottomOf="@+id/ivBindBankIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivBindBankIcon"
                style="@style/Text.ffffff.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/ivBindBankCardRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:src="@drawable/cs_ic_check_plan_bind_card_recommend"
            app:layout_constraintEnd_toEndOf="@+id/clBindBankCard"
            app:layout_constraintTop_toBottomOf="@+id/tvBindBankCardTitle"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tvBindBankCardContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clBindBankCard"
            style="@style/Text.medium.202046.14"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBindBankCardContent"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark_stroke_divider_line_dark"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12"
            app:layout_constraintTop_toBottomOf="@+id/tvBindBankCardContent">
            <ImageView
                android:id="@+id/ivBankIcon"
                android:layout_width="@dimen/dp32"
                android:layout_height="@dimen/dp32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvBankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="@+id/ivBankIcon"
                app:layout_constraintStart_toEndOf="@+id/ivBankIcon"
                app:layout_constraintTop_toTopOf="@+id/ivBankIcon"
                style="@style/Text.202046.14"/>
            <TextView
                android:textColor="@color/lib_ui_button_white_text_color"
                android:id="@+id/btnTopUp"
                android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
                android:visibility="gone"
                android:layout_width="@dimen/dp62"
                android:layout_height="@dimen/dp24"
                android:text="@string/core_top_up"
                app:layout_constraintBottom_toBottomOf="@+id/ivBankIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivBankIcon"
                style="@style/Text.ffffff.12"/>
            <ImageView
                android:id="@+id/ivVerify"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_ic_check_plan_dialog_verify"
                app:layout_constraintBottom_toBottomOf="@+id/ivBankIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivBankIcon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/tvHomepage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/cs_homepage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clBindBankCardContent"
            style="@style/Text.6306b2.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
