<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="OTP Verify"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:paddingTop="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_enter_otp"
        style="@style/txt_bb_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMessage"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/txt_s_g"/>
    <com.transsnet.palmpay.core.viewmodel.OneTimeCodeSimpleView
        android:layout_gravity="center_horizontal"
        android:id="@+id/viewOTC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
</LinearLayout>
