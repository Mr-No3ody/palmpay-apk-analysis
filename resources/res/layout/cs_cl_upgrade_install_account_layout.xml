<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_upgrade_root_fl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="@dimen/dp36"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title=" "/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="225dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp16">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_install_account_select"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="#906948"
                android:gravity="center"
                android:id="@+id/ccuial_tips1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3"
            android:layout_marginStart="@dimen/dp16">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_install_account_select"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="#906948"
                android:gravity="center"
                android:id="@+id/ccuial_tips2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/cs_bg_install_account"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp65"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loanable Amount (up to) "
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/dp36"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/ccuial_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp16">
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="loan Period(up to) "
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/dp32"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/ccuial_term"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"/>
                    <TextView
                        android:textSize="@dimen/dp10"
                        android:textColor="#ff9900"
                        android:gravity="center"
                        android:id="@+id/ccuial_term_due"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 Terms, 1 month/term"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/layoutApply"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp36">
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/ccuial_apply_after"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_error_background"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Please reapply for installment limit after February 29, 2024"
                    android:paddingHorizontal="@dimen/dp16"
                    android:paddingVertical="@dimen/dp8"/>
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/ccuial_apply"
                    android:background="@drawable/cv_selector_rect_norner_12_bg_black_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp48"
                    android:layout_marginTop="@dimen/dp36"
                    android:text="@string/cs_cl_apply_now"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:id="@+id/clbiad_hand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cs_hand"
                    android:layout_alignTop="@+id/ccuial_apply"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ccuial_learn_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learn more about installmet"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp2"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="@dimen/dp20"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.transsnet.palmpay.credit.view.LoanHomeBottomInfoView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
