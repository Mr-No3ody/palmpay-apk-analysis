<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_marginLeft="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivImage"
        app:layout_constraintBottom_toTopOf="@+id/tvSubTitle"
        app:layout_constraintLeft_toRightOf="@+id/ivImage"
        app:layout_constraintTop_toTopOf="@+id/ivImage"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <ImageView
        android:id="@+id/ivTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintLeft_toRightOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvLocate"
        android:layout_width="62dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvSubTitle"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/Text.medium.ffffff.12"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvSubTitle"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginRight="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tvLocate"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
