<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp56">
            <TextView
                android:textSize="@dimen/dp20"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/actur_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp25"
                android:text="@string/core_pay_to_palmpaybusiness"
                android:layout_centerVertical="true"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/imageViewShare"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Share"
                app:iiv_size="24dp"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/actur_done_tv"
                android:padding="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_done"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.transsnet.palmpay.core.viewmodel.ModelPaymentResultProgress
            android:id="@+id/aaturv_result_progress_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp25"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginRight="@dimen/dp25"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/aatu_order_data_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp30">
            <include
                android:id="@+id/mam_booker_item"
                layout="@layout/cv_layout_payment_result_data_item"/>
            <include
                android:id="@+id/aatu_amount_item"
                layout="@layout/cv_layout_payment_result_data_item"/>
            <com.transsnet.palmpay.core.viewmodel.ModelPaymentMethodItem
                android:id="@+id/aatu_payment_method_item"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"/>
            <include
                android:id="@+id/aatu_reference_number_item"
                layout="@layout/cv_layout_payment_result_data_item"/>
        </LinearLayout>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/actur_ad"
            android:paddingTop="30dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp25"
            android:layout_marginRight="@dimen/dp25"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginLeft="@dimen/dp40"
            android:layout_marginTop="@dimen/dp30"
            android:layout_marginRight="@dimen/dp40">
            <Button
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/actur_complete_btn"
                android:background="@drawable/cv_shape_halfround_purple"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:text="@string/core_try_again"
                android:textAllCaps="false"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</ScrollView>
