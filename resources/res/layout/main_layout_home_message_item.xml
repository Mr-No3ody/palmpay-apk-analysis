<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp8"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp8">
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvLine1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvTag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvLine2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/horizontalBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLine1"
        style="@style/txt_mi_g"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/horizontalBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="ivIcon,tvView,tvTime,tvDate"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvView"
        android:background="@drawable/lib_ui_button_bg_corner_primary_3"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="@dimen/dp48"
        android:text="@string/core_view"
        android:paddingHorizontal="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_w"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:id="@+id/tvTag"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp10"
        android:minHeight="@dimen/dp10"
        android:layout_marginStart="4dp"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/tvLine1"
        app:layout_constraintEnd_toStartOf="@+id/horizontalBarrier"
        app:layout_constraintStart_toEndOf="@+id/tvLine1"
        app:layout_constraintTop_toTopOf="@+id/tvLine1"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tvDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvDate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTime"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
