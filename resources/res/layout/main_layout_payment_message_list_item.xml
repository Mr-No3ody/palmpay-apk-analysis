<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/cv_palmpay_logo_5"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"/>
    <TextView
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/ivIcon"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/textViewState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/core_amount"
        android:layout_below="@+id/textViewTitle"
        android:layout_centerHorizontal="true"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewState"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/viewLine1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/textViewAmount"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:id="@+id/textViewLine10"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:paddingEnd="16dp"
            style="@style/txt_s_lg"/>
        <TextView
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:id="@+id/textViewLine11"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_below="@+id/viewLine1"
        android:layerType="software"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/textViewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp26"
        android:layout_below="@+id/viewLine1"
        android:paddingStart="16dp"
        style="@style/txt_mi_b"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="end|center_vertical"
        android:id="@+id/textViewNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/main_view"
        android:drawablePadding="2dp"
        android:layout_below="@+id/viewLine1"
        android:paddingStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:iiv_end_color="@color/ppColorTextAssist"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp16"
        style="@style/txt_mi_b"/>
</RelativeLayout>
