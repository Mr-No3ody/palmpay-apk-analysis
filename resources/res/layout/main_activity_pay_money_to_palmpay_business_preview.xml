<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingBottom="70dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_preview_dialog_title_height"
            layout="@layout/cv_layout_preview_dialog_title"/>
        <com.transsnet.palmpay.custom_view.ReboundScrollView
            android:paddingBottom="@dimen/dp54"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/acap_title_bar">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_lt_rt_8_bg_white"
                android:paddingTop="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.core.viewmodel.PreviewTitleView
                    android:id="@+id/acap_title_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/cv_preview_payee_info_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin">
                    <ImageView
                        android:id="@+id/acapbo_payee_icon"
                        android:background="@drawable/cv_preview_icon_bg"
                        android:padding="5dp"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:scaleType="centerCrop"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginStart="15dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/ppColorPrimary"
                            android:id="@+id/acapbo_payee_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acapbo_amount_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="Amount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acapbo_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="Fee"/>
                <com.transsnet.palmpay.core.viewmodel.ModelCouponItem
                    android:id="@+id/itemCoupon"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_tips="false"
                    app:cv_bm_tips_text="@string/core_msg_coupon_rules"
                    app:cv_bm_title="@string/core_coupon_to_use"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemDiscount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_text_color="@color/ppColorError"
                    app:cv_bm_title="@string/core_discount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelUsePointsWithSwitch
                    android:id="@+id/acapbo_point_used_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/acapbo_point_earned_item"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_amount_sign="₦"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_title="Cashback to earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
                    android:id="@+id/acapbo_bank_card_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </com.transsnet.palmpay.custom_view.ReboundScrollView>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp18"
        android:textColor="@color/ppColorTextBase"
        android:layout_gravity="center_horizontal"
        android:id="@+id/acapbo_next_btn"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginBottom="10dp"
        android:text="@string/core_pay"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/cv_preview_item_height"
        android:layout_marginEnd="@dimen/cv_preview_item_height"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
