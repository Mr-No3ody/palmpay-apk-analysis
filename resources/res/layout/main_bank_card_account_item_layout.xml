<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mbcail_root"
    android:background="@color/ppColorBackgroundLight"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="102dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/bank_content"
            android:layout_width="match_parent"
            android:layout_height="112dp">
            <ImageView
                android:id="@+id/card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cv_shape_rect_corner_8_bg_gray_padding_lr_12_tb_6"
                android:scaleType="fitXY"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp6"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp6">
                <ImageView
                    android:id="@+id/bank_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ppColorTextBase"
                    android:ellipsize="end"
                    android:id="@+id/tvVerified"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp15"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/ivExpired"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:src="@drawable/main_bank_card_expired"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/dp12"
                    android:layout_alignParentEnd="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="@dimen/dp14"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:layout_toLeftOf="@+id/tvVerified"
                    android:layout_toRightOf="@+id/bank_icon">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/ppColorTextBase"
                        android:ellipsize="end"
                        android:id="@+id/bank_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/ppColorTextBase"
                        android:id="@+id/bank_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:gravity="center_vertical"
                        android:id="@+id/tvDefaultCard"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/main_default_text"
                        android:drawableLeft="@drawable/cv_default_card_small"
                        android:drawablePadding="2dp"
                        style="@style/txt_mi_w"/>
                    <TextView
                        android:textSize="10dp"
                        android:gravity="center_vertical"
                        android:id="@+id/tvCardType"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/txt_mi_w"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/unlink_container"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginBottom="6dp">
            <ImageView
                android:id="@+id/unlink_iv"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:src="@drawable/cv_unlink_gray"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center"
                android:id="@+id/unlink_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/unlink_iv"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_ArrowRight"
                app:iiv_size="16dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/remove_container"
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingLeft="@dimen/dp12"
            android:paddingRight="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="0dp"
            android:layout_marginRight="@dimen/dp12">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/remove_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_Delete"
                app:iiv_size="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center"
                android:id="@+id/remove_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp5"
                android:text="@string/main_remove_text"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/remove_iv"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_ArrowRight"
                app:iiv_size="16dp"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@drawable/cv_grident_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp10"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
