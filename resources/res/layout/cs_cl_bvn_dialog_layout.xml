<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:src="@drawable/cs_cl_bvn_dialog_top_img"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_cl_add_bvn_certification"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:id="@+id/bvn_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:id="@+id/countdown_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:text="@string/cs_cl_go_to_bvn"/>
</LinearLayout>
