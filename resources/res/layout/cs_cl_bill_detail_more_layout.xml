<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Loan Amount Details"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/cs_cl_loan_details"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/csClBillDetailMoreItemTitleStyle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_loan_amount"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/bill_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:id="@+id/interest_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_interest"
                        android:drawableEnd="@drawable/cs_cl_info_icon"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/interest_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:id="@+id/service_fee_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_service_fee"
                        android:drawableEnd="@drawable/cs_cl_info_icon"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/service_amount_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_penalty"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/penalty_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/coupon_ll"
                    android:paddingTop="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:id="@+id/tvDiscountTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_coupon"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:textColor="@color/ppColorWarning"
                        android:id="@+id/coupon_content_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/extend_fee_ll"
                    android:paddingTop="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_extension_fee"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/extend_fee_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp18"
                    android:paddingBottom="@dimen/dp18"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_total_amount_title"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/total_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="Basic Information"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp16"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_accounts_receivable"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/receive_account_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutManagementFee"
                    android:paddingTop="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_management_fee"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/management_fee_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutReceiveAmount"
                    android:paddingTop="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_receive_amount"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/receive_amount_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_start_and_end_time"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/bill_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_more_loan_period"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/period_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_day_interest"
                        android:layout_weight="1"
                        style="@style/csClBillDetailMoreItemTitleStyle"/>
                    <TextView
                        android:id="@+id/daily_interest_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/csClBillDetailMoreItemContentStyle"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/init_loan_ll"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp18"
                android:paddingBottom="@dimen/dp18"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_initial_loan_overview"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cs_cl_main_color"
                    android:id="@+id/init_loan_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_bill_proto_view"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp18"
                    android:paddingBottom="@dimen/dp18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp16"
                    android:paddingEnd="@dimen/dp16">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_contracts_and_agreements"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cs_cl_main_color"
                        android:id="@+id/proto_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_bill_proto_view"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
