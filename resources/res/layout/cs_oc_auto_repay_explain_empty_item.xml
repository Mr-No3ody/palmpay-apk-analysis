<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bank_card_empty_root_cl"
    android:background="@drawable/cs_oc_auto_payment_item_bg"
    android:paddingTop="@dimen/dp14"
    android:paddingBottom="@dimen/dp14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp16">
    <ImageView
        android:id="@+id/payment_img"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.13"
        app:srcCompat="@drawable/cs_oc_add_bank_card"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:id="@+id/add_bank_card_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cs_oc_add_bank_card"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/payment_img"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
