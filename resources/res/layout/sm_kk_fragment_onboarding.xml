<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vKkOnboardingHeaderBg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/sm_keke_splash_4"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBarKkOnboarding"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_back_icon="@drawable/core_actionbar_back_black"/>
    <View
        android:id="@+id/spaceView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp28"
        app:layout_constraintTop_toTopOf="@+id/bodyCl"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vKkOnboardingHeaderIv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/spaceView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvKkOnboardingRideWith"
        app:layout_constraintVertical_bias="1"
        app:srcCompat="@drawable/sm_keke_splash_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vKkOnboardingHeaderIv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/spaceView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvKkOnboardingRideWith"
        app:layout_constraintVertical_bias="1"
        app:srcCompat="@drawable/sm_keke_splash_2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center_horizontal"
        android:id="@+id/tvKkOnboardingRideWith"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleBarKkOnboarding"
        app:srcCompat="@drawable/sm_keke_splash_3"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bodyCl"
        android:background="@drawable/cv_shape_rect_top_corner_white_24"
        android:paddingTop="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:id="@+id/tvKkOnboardingWhyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginBottom="@dimen/dp16"
            android:text="@string/sm_kk_auth_why_title"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toTopOf="@+id/clKkOnboardingFeatureCashless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Text.medium.202046.16"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clKkOnboardingFeatureCashless"
            android:background="@drawable/sm_kk_shape_onboarding_feature_cell"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp80"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp6"
            app:layout_constraintBottom_toTopOf="@+id/clKkOnboardingFeatureFastRide"
            app:layout_constraintEnd_toStartOf="@+id/clKkOnboardingFeatureZeroFee"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivKkOnboardingFeatureCashless"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/sm_kk_ic_onboarding_cashless"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/sm_kk_auth_why_cashless"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivKkOnboardingFeatureCashless"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clKkOnboardingFeatureZeroFee"
            android:background="@drawable/sm_kk_shape_onboarding_feature_cell"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp80"
            android:layout_marginStart="@dimen/dp6"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/clKkOnboardingFeatureCashless"
            app:layout_constraintTop_toTopOf="@+id/clKkOnboardingFeatureCashless">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivKkOnboardingFeatureZeroFee"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/sm_kk_ic_onboarding_zero_fee"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/sm_kk_auth_why_zero"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivKkOnboardingFeatureZeroFee"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clKkOnboardingFeatureFastRide"
            android:background="@drawable/sm_kk_shape_onboarding_feature_cell"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp80"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp6"
            app:layout_constraintBottom_toTopOf="@+id/llKkOnboardingPromotion"
            app:layout_constraintEnd_toStartOf="@+id/clKkOnboardingFeatureSecure"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="@dimen/dp28">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivKkOnboardingFeatureFastRide"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/sm_kk_ic_onboarding_fast_ride"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/sm_kk_auth_why_fast"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivKkOnboardingFeatureFastRide"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clKkOnboardingFeatureSecure"
            android:background="@drawable/sm_kk_shape_onboarding_feature_cell"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp80"
            android:layout_marginBottom="@dimen/dp18"
            android:layout_marginStart="@dimen/dp6"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toTopOf="@+id/llKkOnboardingPromotion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/clKkOnboardingFeatureFastRide"
            app:layout_goneMarginBottom="@dimen/dp28">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivKkOnboardingFeatureSecure"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/sm_kk_ic_onboarding_secure"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/sm_kk_auth_why_secure"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivKkOnboardingFeatureSecure"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/llKkOnboardingPromotion"
            android:background="@drawable/sm_kk_bg_promotion_banner"
            android:paddingTop="@dimen/dp8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp46"
            android:layout_marginTop="@dimen/dp24"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/spaceKkOnboardingOverlap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp18"
                android:layout_height="@dimen/dp18"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/sm_kk_ic_promotion"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextBase"
                android:id="@+id/tvKkOnboardingPromotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp2"
                style="@style/Text.medium.202046.14"/>
        </LinearLayout>
        <Space
            android:id="@+id/spaceKkOnboardingOverlap"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnKkOnboardingGetStarted"
            app:layout_goneMarginBottom="0dp"/>
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/btnKkOnboardingGetStarted"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_marginBottom="@dimen/dp8"
            android:text="@string/sm_kk_auth_btn"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toTopOf="@+id/llKkOnboardingAgreement"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ppButtonStyle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llKkOnboardingAgreement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvKkOnboardingAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_kk_auth_agreement_label"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
