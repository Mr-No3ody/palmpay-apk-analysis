<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:padding="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp12">
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvLinkedIdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_kyc_details_title"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/tvAccountDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/tvAccountDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvLinkedIdTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLinkedIdTitle"/>
    <TextView
        android:enabled="false"
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvNin"
        android:background="@drawable/ac_bg_nin_state"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/ac_nin"
        android:includeFontPadding="false"
        android:drawablePadding="@dimen/dp2"
        android:drawableStart="@drawable/ac_nin_not_verified"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="@+id/tvBvn"
        app:layout_constraintStart_toStartOf="@+id/tvBvn"
        app:layout_constraintTop_toBottomOf="@+id/tvAccountDetails"
        style="@style/txt_mi_w"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvNinNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_verify_nin"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tvNin"
        app:layout_constraintStart_toEndOf="@+id/tvNin"
        app:layout_constraintTop_toTopOf="@+id/tvNin"
        style="@style/txt_s_w_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivNinHide"
        android:visibility="gone"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="@dimen/dp4"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Hide"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvNin"
        app:layout_constraintStart_toEndOf="@+id/tvNinNo"
        app:layout_constraintTop_toTopOf="@+id/tvNin"/>
    <TextView
        android:enabled="false"
        android:textColor="@color/ac_color_current_tier_text"
        android:gravity="center_vertical"
        android:id="@+id/tvBvn"
        android:background="@drawable/ac_bg_nin_state"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/ac_bvn"
        android:includeFontPadding="false"
        android:drawablePadding="@dimen/dp2"
        android:drawableStart="@drawable/ac_nin_not_verified"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNin"
        style="@style/txt_mi_w"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvBvnNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_verify_bvn"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tvBvn"
        app:layout_constraintStart_toEndOf="@+id/tvBvn"
        app:layout_constraintTop_toTopOf="@+id/tvBvn"
        style="@style/txt_s_w_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivBvnHide"
        android:visibility="gone"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginStart="@dimen/dp4"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Hide"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvBvn"
        app:layout_constraintStart_toEndOf="@+id/tvBvnNo"
        app:layout_constraintTop_toTopOf="@+id/tvBvn"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvBvnVerify"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_verify"
        android:includeFontPadding="false"
        app:iiv_end_color="@color/ppColorPrimary"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvBvn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvBvn"
        style="@style/txt_s_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
