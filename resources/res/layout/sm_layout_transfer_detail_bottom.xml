<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        app:layout_constraintTop_toTopOf="parent"
        style="@style/core_divider_horizontal"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_view_receipt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/ll_feedback_now"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_view_receipt"
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            app:srcCompat="@drawable/cv_ic_order_result_view_receipt"
            app:tint="@color/ppColorPrimary"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_view_receipt"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/cv_view_receipt"
            android:layout_marginStart="@dimen/dp6"
            style="@style/txt_me_g"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_feedback_now"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_view_receipt">
        <ImageView
            android:id="@+id/iv_feedback_now"
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            app:srcCompat="@drawable/cv_ic_feedback_now"
            app:tint="@color/ppColorPrimary"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_feedback_now"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/cv_feedback_now"
            android:layout_marginStart="@dimen/dp6"
            style="@style/txt_me_g"/>
    </LinearLayout>
</merge>
