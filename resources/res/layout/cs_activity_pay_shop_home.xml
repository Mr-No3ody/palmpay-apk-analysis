<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_bg_pay_shop_home_top"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_style="light"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@+id/viewNotice"
                android:background="@color/ppColorMask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/cv_notify_icon_white"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/dp12"
                app:layout_constraintTop_toTopOf="parent"
                app:slot_id="@string/ad_pay_shop_home_text_slot_id"/>
            <ImageView
                android:id="@+id/iv_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:src="@drawable/cs_ic_pay_shop_home_top"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewNotice"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ad_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginBottom="12dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toBottomOf="@+id/iv_top"
                app:slot_id="@string/pay_shop_home_top_banner"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutTop"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/ad_top">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_enter_merchant_account"
                        android:drawablePadding="@dimen/dp8"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/cs_merchant_icon"
                        style="@style/txt_me_b_b"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/iv_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:iiv_color="@color/ppColorTextPrimary"
                        app:iiv_icon="pay_Scan"
                        app:iiv_size="24dp"/>
                </LinearLayout>
                <EditText
                    android:id="@+id/et_account"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:hint="@string/cs_8_or_10_digits_account_number"
                    android:maxLength="12"
                    android:inputType="number"/>
                <View style="@style/core_divider_horizontal"/>
                <TextView
                    android:textColor="@color/ppColorError"
                    android:id="@+id/tv_error"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    style="@style/txt_mi_b"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_merchant_name"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_merchant_name_title"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="@string/cs_query_result"
                        android:lineSpacingExtra="@dimen/dp6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Text.202046.12"/>
                    <TextView
                        android:ellipsize="middle"
                        android:gravity="left"
                        android:id="@+id/tv_merchant_name"
                        android:paddingBottom="@dimen/dp5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:lineSpacingExtra="@dimen/dp6"
                        android:layout_marginEnd="@dimen/dp4"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_merchant_name_title"
                        app:layout_constraintWidth_default="wrap"
                        style="@style/Text.medium.202046.14"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_default_button_height"
                    android:layout_marginTop="@dimen/dp16">
                    <com.wang.avi.AVLoadingIndicatorView
                        android:layout_gravity="center"
                        android:id="@+id/indicatorView"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        app:indicatorColor="@color/md_white_1000"
                        app:indicatorName="BallSpinFadeLoaderIndicator"
                        style="@style/AVLoadingIndicatorView.Large"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tv_next"
                        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cv_default_button_height"
                        android:text="@string/core_next"
                        style="@style/txt_me_w"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layoutCouponAndPoint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <ImageView
                        android:id="@+id/ivPicture"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <TextView
                        android:gravity="left"
                        android:id="@+id/tvCopyWriting"
                        android:layout_marginLeft="@dimen/dp3"
                        style="@style/Text.202046.12"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutBottom"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/layoutTop">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_past_shop"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_past_shops"
                        android:layout_weight="1"
                        style="@style/txt_s_b_b"/>
                    <TextView
                        android:id="@+id/tv_more"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_more"
                        android:paddingStart="@dimen/dp16"
                        style="@style/txt_mi_b"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_past_shop"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ad_bottom_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp20"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutBottom"
                app:layout_constraintVertical_bias="0"
                app:slot_id="@string/pay_shop_home_bottom_banner"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.core.ui.widget.DragView
        android:id="@+id/dv_cashback_ad"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:layout_marginBottom="156dp"
        android:layout_marginEnd="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/ad_cashback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:slot_id="@string/pay_shop_home_drag_banner"/>
    </com.transsnet.palmpay.core.ui.widget.DragView>
</androidx.constraintlayout.widget.ConstraintLayout>
