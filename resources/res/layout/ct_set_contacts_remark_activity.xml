<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="@string/ct_save"
        app:title_bar_title="@string/ct_edit_contact"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"/>
    <RelativeLayout
        android:background="#ffffff"
        android:paddingLeft="25dp"
        android:paddingTop="15dp"
        android:paddingRight="25dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/remake_name_til"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ct_name"
            app:contentInsetStart="0dp"
            app:contentPaddingRight="0dp"
            app:errorEnabled="false">
            <EditText
                android:theme="@style/CT_EditText"
                android:textSize="14sp"
                android:textColor="#ff272a2d"
                android:id="@+id/remake_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="40"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivDelete"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_alignParentRight="true"
            app:iiv_color="@color/ppColorTextDisable"
            app:iiv_icon="pay_CloseFill"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#fff44e4e"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/name_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/cv_warning"
            android:drawablePadding="5dp"
            android:layout_below="@+id/remake_name_til"/>
    </RelativeLayout>
</LinearLayout>
