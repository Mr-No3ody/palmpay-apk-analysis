<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f2f3f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_background="@color/ppColorBackgroundLight"
        app:title_bar_title="@string/core_transaction_receipt"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomView"
        android:layout_below="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/receiptView"
            android:background="@drawable/cv_receipt_bg_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp16">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp30"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:srcCompat="@drawable/cv_palmpay_text_and_logo_purple"/>
            <TextView
                android:textSize="@dimen/dp26"
                android:textColor="@color/ppColorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/str_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_number_me_b_b"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/core_success"
                android:textAllCaps="true"
                style="@style/txt_s_b"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_recipient_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                style="@style/txt_mi_lg"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                style="@style/txt_mi_lg"/>
            <View
                android:background="@drawable/ci_receipt_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layerType="software"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_recipient_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/ci_receipt_with_colon"
                    android:layout_marginStart="@dimen/dp16"
                    style="@style/txt_s_b"/>
                <TextView
                    android:textSize="14dp"
                    android:gravity="right"
                    android:id="@+id/tv_recipient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_toRightOf="@+id/tv_recipient_title"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_mi_b_b"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_recipient_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_toRightOf="@+id/tv_recipient_title"
                    android:layout_below="@+id/tv_recipient_name"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_mi_lg"/>
            </RelativeLayout>
            <View
                android:background="@drawable/ci_receipt_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layerType="software"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <RelativeLayout
                android:id="@+id/rl_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_sender_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/ci_sender_with_colon"
                    android:layout_marginStart="@dimen/dp16"
                    style="@style/txt_s_b"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_sender_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_toRightOf="@+id/tv_sender_title"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_mi_b_b"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_sender_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_toRightOf="@+id/tv_sender_title"
                    android:layout_below="@+id/tv_sender_name"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_mi_lg"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutMidInfo"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/ci_bank_name_with_colon"
                        style="@style/Text.202046.14"/>
                    <TextView
                        android:gravity="right"
                        android:id="@+id/tvBankName"
                        android:layout_weight="1"
                        style="@style/Text.202046.14"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <TextView
                        android:id="@+id/tvCardNumberTitle"
                        android:text="@string/ci_account_number_with_colon"
                        style="@style/Text.202046.14"/>
                    <TextView
                        android:gravity="right"
                        android:id="@+id/tvCardNumber"
                        android:layout_weight="1"
                        style="@style/Text.202046.14"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layoutFundMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8">
                    <TextView
                        android:text="@string/ci_fund_method_with_colon"
                        style="@style/Text.202046.14"/>
                    <TextView
                        android:gravity="right"
                        android:id="@+id/tvFundMethod"
                        android:layout_weight="1"
                        style="@style/Text.202046.14"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@drawable/ci_receipt_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layerType="software"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <TextView
                android:id="@+id/tv_transaction_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ci_transaction_info"
                android:layout_marginStart="@dimen/dp16"
                style="@style/txt_s_b"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:id="@+id/tv_remark_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_whats_it_for"
                    android:layout_below="@+id/tv_transaction_type"
                    style="@style/txt_mi_lg"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_remark"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tv_transaction_type_title"
                    android:layout_below="@+id/tv_transaction_type"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_alignParentEnd="true"
                    style="@style/txt_mi_b"/>
                <TextView
                    android:id="@+id/tv_transaction_id_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/core_receipt_transaction_id"
                    android:layout_below="@+id/tv_remark"
                    style="@style/txt_mi_lg"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_transaction_id"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_toRightOf="@+id/tv_transaction_type_title"
                    android:layout_below="@+id/tv_remark"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_alignParentEnd="true"
                    style="@style/txt_mi_b"/>
                <TextView
                    android:id="@+id/tv_session_id_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/core_session_id_desc_1"
                    android:layout_below="@+id/tv_transaction_id"
                    style="@style/txt_mi_lg"/>
                <TextView
                    android:gravity="right"
                    android:id="@+id/tv_session_id"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_toRightOf="@+id/tv_transaction_type_title"
                    android:layout_below="@+id/tv_transaction_id"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_alignParentEnd="true"
                    style="@style/txt_mi_b"/>
            </RelativeLayout>
            <View
                android:background="@drawable/ci_receipt_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layerType="software"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <TextView
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvSupport"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/ci_support"
                style="@style/Text.202046.12"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvSupportEmail"
                android:visibility="gone"
                android:layout_marginTop="@dimen/dp6"
                android:text="@string/core_palmpay_email"
                style="@style/Text.6306b2.14"/>
            <TextView
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/tvBottomTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp25"
                android:text="@string/ci_transaction_receipt_bottom_tip"
                android:lineSpacingExtra="@dimen/dp2"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bottomView"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_alignParentBottom="true">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="14dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/shareTv"
            android:paddingLeft="@dimen/dp50"
            android:paddingRight="@dimen/dp50"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/core_share"
            android:drawablePadding="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp50"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_Share"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toStartOf="@+id/saveTv"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="14dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/saveTv"
            android:paddingLeft="@dimen/dp50"
            android:paddingRight="@dimen/dp50"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/core_save_as_pdf"
            android:drawablePadding="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp50"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_download"
            app:iiv_start_size="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
