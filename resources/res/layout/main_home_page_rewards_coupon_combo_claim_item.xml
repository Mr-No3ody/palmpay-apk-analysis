<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/main_reward_coupon_combo_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp90"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivCouponBg"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp6"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/main_reward_coupon_combo_claim_image"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:background="@drawable/main_bg_reward_coupon_combo_title"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp12"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="@+id/ivCouponBg"
        app:layout_constraintStart_toStartOf="@+id/ivCouponBg"
        app:layout_constraintTop_toTopOf="@+id/ivCouponBg"
        style="@style/Text.medium.6306b2.10"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:id="@+id/tvCouponAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="@+id/ivCouponBg"
        app:layout_constraintStart_toStartOf="@+id/ivCouponBg"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_number_s_b_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp14"
        android:gravity="center"
        android:id="@+id/btnRight"
        android:layout_width="@dimen/dp120"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_claim"
        app:layout_constraintBottom_toBottomOf="@+id/ivCouponBg"
        app:layout_constraintEnd_toEndOf="@+id/ivCouponBg"
        app:layout_constraintStart_toStartOf="@+id/ivCouponBg"
        app:loading_size="10dp"
        style="@style/ppSmallButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
