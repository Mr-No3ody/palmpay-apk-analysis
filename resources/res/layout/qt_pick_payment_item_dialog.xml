<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_dialog_top_left_right_corner_24dp_white_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp15"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp15"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp24"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_select_biller"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tabView"
        android:background="@drawable/cv_rect_corner_24_bg_f6f6fa"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:enabled="true"
            android:textColor="@color/qt_tab_text_color_2"
            android:gravity="center"
            android:id="@+id/tvNormal"
            android:background="@drawable/qt_button_bg_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/qt_item"
            android:layout_weight="1"
            style="@style/txt_s_g"/>
        <TextView
            android:textColor="@color/qt_tab_text_color_2"
            android:gravity="center"
            android:id="@+id/tvFav"
            android:background="@drawable/qt_button_bg_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/qt_favorite"
            android:layout_weight="1"
            style="@style/txt_s_g"/>
    </LinearLayout>
    <include
        android:id="@+id/qp_search_item"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp35"
        android:layout_marginTop="15dp"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qp_v1"
        layout="@layout/qt_layout_search_item"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="15dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/paymentList"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <include
            android:id="@+id/qt_layout_search_item_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:layout_marginTop="@dimen/dp30"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/qt_layout_search_item_empty"/>
        <com.transsnet.palmpay.teller.ui.view.SideBarView
            android:id="@+id/sideBar"
            android:visibility="gone"
            android:layout_width="@dimen/dp20"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/paymentList"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/paymentList"
            app:layout_wrapBehaviorInParent="skipped"
            app:sm_padding="@dimen/dp4"
            app:sm_press_bg_color="@color/ppColorBackgroundDark"
            app:sm_selectTextColor="@color/ppColorTextPrimary"
            app:sm_selectTextSize="@dimen/dp18"
            app:sm_textColor="@color/ppColorTextAssist"
            app:sm_textSize="@dimen/dp12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
