<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:paddingBottom="@dimen/dp66"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_toast_dialog"
        android:background="@drawable/cv_shape_rect_corner_12_bg_assist_background"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tips_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/cv_network_bad"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorWarning"
            android:gravity="center_vertical"
            android:id="@+id/tips_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cv_network_is_not_available"
            android:layout_weight="1"
            android:paddingStart="8dp"/>
        <TextView
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/btnDial"
            android:background="@drawable/cv_shape_round_corner_warning"
            android:layout_width="@dimen/dp45"
            android:layout_height="@dimen/dp24"
            android:text="@string/cv_dial"
            android:layout_marginStart="@dimen/dp4"
            style="@style/Text.medium.6306b2.12"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp4"
        app:iiv_color="@color/ppColorWarning"
        app:iiv_icon="pay_Close"
        app:iiv_size="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
