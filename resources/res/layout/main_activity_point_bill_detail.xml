<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem
                android:id="@+id/itemPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                app:cv_tt_title="@string/core_type"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/itemTransType"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/apbd_origin_trading_number_tv"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/itemOrderNo"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/apbd_expired_date_tv"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/itemOrderDate"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultItemModel
                android:id="@+id/itemPostDate"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp6"/>
        </LinearLayout>
    </ScrollView>
    <com.transsnet.palmpay.custom_view.model.OrderResultViewReceiptModel
        android:id="@+id/viewReceipt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
