<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <TextView
        android:id="@+id/tvTroubleUnlockingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Having trouble unlocking?"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <ImageView
        android:id="@+id/ivAboutPhoneLock"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTroubleUnlockingTitle"
        style="@style/Text.6306b2.12"/>
    <TextView
        android:id="@+id/tvAboutPhoneLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About Phone lock"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivAboutPhoneLock"
        app:layout_constraintStart_toEndOf="@+id/ivAboutPhoneLock"
        app:layout_constraintTop_toTopOf="@+id/ivAboutPhoneLock"
        style="@style/Text.6306b2.12"/>
    <ImageView
        android:id="@+id/ivAboutTemporaryUnlock"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivAboutPhoneLock"
        app:layout_constraintEnd_toStartOf="@+id/tvAboutTemporaryUnlock"
        app:layout_constraintTop_toTopOf="@+id/ivAboutPhoneLock"
        style="@style/Text.6306b2.12"/>
    <TextView
        android:id="@+id/tvAboutTemporaryUnlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About Temporary Unlock"
        app:layout_constraintBottom_toBottomOf="@+id/ivAboutPhoneLock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivAboutPhoneLock"
        style="@style/Text.6306b2.12"/>
</merge>
