<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/auto_repayment_mtb"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            app:title_bar_title="Automatically Repayment"/>
        <TextView
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_oc_auto_debit"
            style="@style/Text.medium.202046.16"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_8_bg_white"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <TextView
                android:id="@+id/tvDueDateTitle"
                android:visibility="gone"
                android:text="@string/cs_due_date_title"
                style="@style/Text.202046.14"/>
            <TextView
                android:textColor="@color/ppColorFlexiCashPrimary"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tvRepaymentDate"
                android:background="@drawable/cs_calendar_icon"
                android:paddingBottom="@dimen/dp22"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="@dimen/dp6"
                style="@style/Text.medium.202046.20"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivNoOutstanding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/cv_empty_no_transaction_history"/>
            <TextView
                android:id="@+id/tvNoOutstanding"
                android:text="@string/cs_no_outstanding"
                style="@style/Text.202046.16"/>
            <com.palmpay.lib.ui.button.PpButton
                android:id="@+id/btnBorrow"
                android:background="@drawable/lib_ui_button_bg_corner_flexi_cash_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_borrow_loan_amount"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/ppButtonStyle"/>
            <com.palmpay.lib.ui.button.PpButton
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/btnPayWithFlexi"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white_stroke_text_primary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/cs_pay_with_flexi"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/ppButtonStyle"/>
            <TextView
                android:gravity="left"
                android:id="@+id/btnBottomTips"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
        <TextView
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/cs_oc_auto_debit_account_list"
            android:layout_marginStart="@dimen/dp16"
            style="@style/Text.medium.202046.16"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/cv_shape_rect_corner_8_bg_white"
            android:padding="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_your_palmpay_balance"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/balance_cl"
                android:background="@drawable/cs_oc_auto_payment_item_bg"
                android:paddingTop="@dimen/dp14"
                android:paddingBottom="@dimen/dp14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8">
                <ImageView
                    android:id="@+id/payment_img"
                    android:layout_width="@dimen/dp32"
                    android:layout_height="@dimen/dp32"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.13"
                    app:srcCompat="@drawable/cs_oc_palmpay_logo"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/payment_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_plampay_balance"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/payment_num_tv"
                    app:layout_constraintEnd_toStartOf="@+id/first_tv"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/payment_img"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/first_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_first"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/payment_num_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/payment_name_tv"
                    app:layout_constraintStart_toStartOf="@+id/payment_name_tv"
                    app:layout_constraintTop_toBottomOf="@+id/payment_name_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/bank_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_oc_your_bound_bank_cards"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bank_card_method_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
