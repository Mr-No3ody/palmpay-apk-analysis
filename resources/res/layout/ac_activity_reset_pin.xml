<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/ac_reset_pin"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewMessage"
        android:paddingLeft="15dp"
        android:paddingTop="32dp"
        android:paddingRight="15dp"
        android:paddingBottom="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        style="@style/txt_s_g"/>
    <com.transsnet.palmpay.core.viewmodel.OneTimeCodeV3View
        android:layout_gravity="center_horizontal"
        android:id="@+id/viewOTC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvChangeMobile"
        android:visibility="gone"
        android:layout_width="188dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="25dp"
        android:text="@string/ac_modify_login_phone_number"
        android:layout_centerHorizontal="true"
        style="@style/txt_mi_w"/>
</LinearLayout>
