<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp60"
            android:layout_marginBottom="@dimen/dp8"
            android:text="@string/sm_add_from_contacts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.18"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/nsvContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btnAddNow"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llSearch"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp8"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintBottom_toTopOf="@+id/tabLayout">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/cv_search_icon"
                    android:layout_marginEnd="4dp"
                    app:iiv_color="@color/cv_color_858a8f"
                    app:iiv_icon="pay_Search"/>
                <com.transsnet.palmpay.custom_view.CompatStateEditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center_vertical"
                    android:id="@+id/etSearch"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/sm_search"
                    android:layout_weight="1"
                    style="@style/Text.202046.14"/>
            </LinearLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                app:layout_constraintBottom_toTopOf="@+id/rvRecent"
                app:tabGravity="center"
                app:tabIndicator="@drawable/core_tab_indicator_60"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabPaddingEnd="@dimen/dp16"
                app:tabPaddingStart="@dimen/dp16"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/ppColorPrimary"
                app:tabTextAppearance="@style/NormalTextStyle"
                app:tabTextColor="@color/ppColorTextPrimary"/>
            <View
                android:layout_width="match_parent"
                app:layout_constraintBottom_toTopOf="@+id/rvRecent"
                style="@style/core_divider_horizontal"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp350"
                android:nestedScrollingEnabled="true"
                app:layout_constraintBottom_toTopOf="@+id/rvPhoneContacts"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPhoneContacts"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp350"
                android:nestedScrollingEnabled="true"
                app:layout_constraintBottom_toTopOf="@+id/btnAddNow"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/dp16"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btnAddNow"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/sm_add_now"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
