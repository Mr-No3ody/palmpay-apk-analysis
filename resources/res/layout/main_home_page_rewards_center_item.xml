<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        android:layout_marginBottom="@dimen/dp20"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTaskTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvTaskDesc"
        app:layout_constraintEnd_toStartOf="@+id/tvTaskLabel"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        style="@style/txt_s_b_b"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/main_color_home_text_label"
        android:ellipsize="end"
        android:id="@+id/tvTaskLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvTaskTitle"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/tvTaskTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTaskTitle"
        app:rtv_background_color="@color/main_color_home_text_label_bg"
        app:rtv_corner_radius="@dimen/dp16"
        style="@style/txt_mi_b_b"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvTaskDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTaskTitle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/btnRight"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/dp55"
        android:layout_marginStart="@dimen/extra_margin"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:loading_size="8dp"
        style="@style/ppSmallButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
