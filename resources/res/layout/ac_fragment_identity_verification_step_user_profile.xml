<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp24"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Occupation and Income"
                android:layout_marginStart="16dp"
                style="@style/txt_bb_b_b"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/dp16"
                android:text="Provide your PEP, occupation and income details."
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_s_g"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="24dp"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.palmpay.lib.ui.form.PpFormVertical
                        android:enabled="false"
                        android:id="@+id/inputSourceFunds"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:form_edit_enable="false"
                        app:form_edit_input_type="text"
                        app:form_hide_text="Please select"
                        app:form_label_text="@string/ac_source_of_funds"
                        app:form_layout_background="@color/transparent"
                        style="@style/AcPpFormStyle2"/>
                    <com.palmpay.lib.ui.form.PpFormVertical
                        android:enabled="false"
                        android:id="@+id/inputIncome"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:form_edit_enable="false"
                        app:form_edit_input_type="text"
                        app:form_hide_text="Please select"
                        app:form_label_text="@string/ac_annual_income"
                        app:form_layout_background="@color/transparent"
                        style="@style/AcPpFormStyle2"/>
                    <com.palmpay.lib.ui.form.PpFormVertical
                        android:enabled="false"
                        android:id="@+id/inputOccupation"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:form_edit_enable="false"
                        app:form_edit_input_type="text"
                        app:form_hide_text="Please select"
                        app:form_label_text="@string/ac_occupation"
                        app:form_layout_background="@color/transparent"
                        style="@style/AcPpFormStyle2"/>
                </LinearLayout>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:enabled="false"
                    android:id="@+id/inputNationality"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="Please select"
                    app:form_label_text="@string/ac_nationality"
                    app:form_layout_background="@color/transparent"
                    style="@style/AcPpFormStyle2"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp12"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:animateLayoutChanges="true"
                    app:layout_constraintTop_toBottomOf="@+id/tv2">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:text="Are you or any of your relatives a Politically Exposed Person?"
                        android:layout_marginHorizontal="@dimen/dp16"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_mi_b"/>
                    <com.mikepenz.iconics.view.IconicsCheckBox
                        android:id="@+id/check11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:checked="false"
                        android:layout_marginStart="@dimen/dp16"
                        app:iiv_checked_color="@color/ppColorPrimary"
                        app:iiv_checked_icon="pay_CircleFill"
                        app:iiv_checked_size="20dp"
                        app:iiv_unchecked_color="@color/ppColorTextAssist"
                        app:iiv_unchecked_icon="pay_CircleOutline"
                        app:iiv_unchecked_size="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv11"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes, I am"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/check11"
                        app:layout_constraintStart_toEndOf="@+id/check11"
                        app:layout_constraintTop_toTopOf="@+id/check11"
                        style="@style/txt_me_b_b"/>
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/centerGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintGuide_percent="0.5"/>
                    <com.mikepenz.iconics.view.IconicsCheckBox
                        android:id="@+id/check12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:checked="true"
                        app:iiv_checked_color="@color/ppColorPrimary"
                        app:iiv_checked_icon="pay_CircleFill"
                        app:iiv_checked_size="20dp"
                        app:iiv_unchecked_color="@color/ppColorTextAssist"
                        app:iiv_unchecked_icon="pay_CircleOutline"
                        app:iiv_unchecked_size="20dp"
                        app:layout_constraintStart_toEndOf="@+id/centerGuide"
                        app:layout_constraintTop_toBottomOf="@+id/tv11"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No, I’m not"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/check12"
                        app:layout_constraintStart_toEndOf="@+id/check12"
                        app:layout_constraintTop_toTopOf="@+id/check12"
                        style="@style/txt_me_b_b"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/view2"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/check12">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv21"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When were you or any of your relatives a Politically Exposed Person?"
                        android:paddingHorizontal="@dimen/dp16"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_mi_b"/>
                    <com.mikepenz.iconics.view.IconicsCheckBox
                        android:id="@+id/check21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:checked="false"
                        android:layout_marginStart="@dimen/dp16"
                        app:iiv_checked_color="@color/ppColorPrimary"
                        app:iiv_checked_icon="pay_CircleFill"
                        app:iiv_checked_size="20dp"
                        app:iiv_unchecked_color="@color/ppColorTextAssist"
                        app:iiv_unchecked_icon="pay_CircleOutline"
                        app:iiv_unchecked_size="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv21"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/check21"
                        app:layout_constraintStart_toEndOf="@+id/check21"
                        app:layout_constraintTop_toTopOf="@+id/check21"
                        style="@style/txt_me_b_b"/>
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/centerGuide2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintGuide_percent="0.5"/>
                    <com.mikepenz.iconics.view.IconicsCheckBox
                        android:id="@+id/check22"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:checked="false"
                        app:iiv_checked_color="@color/ppColorPrimary"
                        app:iiv_checked_icon="pay_CircleFill"
                        app:iiv_checked_size="20dp"
                        app:iiv_unchecked_color="@color/ppColorTextAssist"
                        app:iiv_unchecked_icon="pay_CircleOutline"
                        app:iiv_unchecked_size="20dp"
                        app:layout_constraintStart_toEndOf="@+id/centerGuide2"
                        app:layout_constraintTop_toBottomOf="@+id/tv21"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Past"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/check22"
                        app:layout_constraintStart_toEndOf="@+id/check22"
                        app:layout_constraintTop_toTopOf="@+id/check22"
                        style="@style/txt_me_b_b"/>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        app:layout_constraintTop_toBottomOf="@+id/check21"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:enabled="false"
                    android:id="@+id/inputOfficialPosition"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="Please select"
                    app:form_label_text="@string/ac_position_held"
                    app:form_layout_background="@color/transparent"
                    app:layout_constraintTop_toBottomOf="@+id/check21"
                    style="@style/AcPpFormStyle2"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/textViewConfirm"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="@string/core_confirm"
            style="@style/ppButtonStyle"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:layout_gravity="end|top"
            android:id="@+id/cornerAd"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvSkip"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_skip"
        android:paddingHorizontal="@dimen/dp16"
        style="@style/txt_s_g"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/bottomStub"
        android:layout="@layout/cv_layout_login_register_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>
</LinearLayout>
