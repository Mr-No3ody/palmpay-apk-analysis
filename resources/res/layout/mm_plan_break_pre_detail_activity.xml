<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/mm_plan_status_break_op"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.github.xiaofeidev.shadow.ShadowFrameLayout
                android:id="@+id/layoutPlanCommonInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintTop_toTopOf="parent"
                app:shadow_blur_radius="@dimen/dp16"
                app:shadow_color="@color/mm_color_1e1e1e_4"
                app:shadow_corner_radius="@dimen/dp12">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/layoutPlanDetailInfo"
                    android:paddingLeft="@dimen/dp32"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp32"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_marginVertical="@dimen/dp12"
                    android:paddingHorizontal="@dimen/dp32"
                    android:paddingVertical="@dimen/dp16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layoutPlanInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <View
                        android:background="@color/ppColorBackgroundDark"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layoutExtroInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.github.xiaofeidev.shadow.ShadowFrameLayout>
            <Space
                android:id="@+id/space"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/dp24"
                app:layout_constraintBottom_toBottomOf="@+id/layoutPlanCommonInfo"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layoutPlanExtroInfo"
                android:background="@drawable/cv_shape_rect_corner_12_bg_assist_background"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="8dp"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp24"
                android:layout_marginHorizontal="@dimen/dp16"
                android:layout_marginVertical="@dimen/dp24"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@+id/space">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_gravity="top|right"
                    android:id="@+id/ivClose"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_marginRight="@dimen/dp4"
                    app:iiv_color="@color/ppColorWarning"
                    app:iiv_icon="pay_InformationOutline"
                    app:iiv_size="16dp"/>
                <TextView
                    android:textColor="@color/ppColorWarning"
                    android:gravity="left"
                    android:id="@+id/tvPlanStatusDesc"
                    android:text="@string/mm_break_remark"
                    android:lineSpacingMultiplier="1.1"
                    style="@style/Text.9ca2aa.12"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <com.palmpay.lib.ui.button.PpButton
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/btnPlanContinue"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/core_back_to_checkout"
                    android:layout_weight="1"
                    style="@style/ppButtonStyle"/>
                <com.palmpay.lib.ui.button.PpButton
                    android:gravity="center"
                    android:id="@+id/btnPlanGoBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp12"
                    android:text="@string/core_continue"
                    android:layout_weight="1"
                    style="@style/ppButtonStyle"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/mm_color_bbbbbb"
                android:layout_gravity="center_horizontal"
                android:paddingTop="@dimen/dp16"
                android:paddingBottom="@dimen/dp24"
                android:visibility="gone"
                android:text="Licensed by the Central Bank of Nigeria"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutPlanExtroInfo"
                app:layout_constraintVertical_bias="1"
                style="@style/Text.ffffff.12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
