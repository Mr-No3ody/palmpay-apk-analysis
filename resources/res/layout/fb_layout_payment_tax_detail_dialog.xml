<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fb_viewRoot"
    android:background="@drawable/fb_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp32"
        android:text="@string/fb_taxes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_b_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_ivClose"
        android:padding="@dimen/fb_dp12"
        android:paddingLeft="@dimen/fb_dp12"
        android:paddingRight="@dimen/fb_dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fb_dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/fb_text_color_purple"
        android:gravity="center_vertical"
        android:id="@+id/fb_tvTotalName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp12"
        android:text="@string/fb_total_tax"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/fb_dp24"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_tvTitle"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:textColor="@color/fb_text_color_purple"
        android:gravity="center_vertical"
        android:id="@+id/fb_tvTotalAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/fb_dp24"
        android:layout_alignParentEnd="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tvTotalName"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/fb_txt_number_s_b_b"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fb_feeList"
        android:paddingLeft="@dimen/fb_dp24"
        android:paddingRight="@dimen/fb_dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp6"
        android:paddingHorizontal="@dimen/fb_dp24"
        app:layout_constraintTop_toBottomOf="@+id/fb_tvTotalName"
        app:layout_goneMarginTop="0dp"/>
    <com.palmpay.lib.ui.button.PpButton
        android:layout_gravity="center"
        android:id="@+id/fb_tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_default_button_height"
        android:layout_marginLeft="@dimen/fb_dp24"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/fb_dp24"
        android:layout_marginBottom="@dimen/fb_dp24"
        android:text="@string/fb_got_it"
        android:layout_marginHorizontal="@dimen/fb_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_feeList"
        style="@style/fbButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
