<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/mm_color_f6f6fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ctb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title=""/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layoutOrderInfo"
        android:background="@drawable/mm_bg_paid_order_info"
        android:paddingTop="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp12"
        android:divider="@drawable/mm_bg_transparent_v_divider_4"
        android:showDividers="middle"
        app:layout_constraintTop_toBottomOf="@+id/ctb">
        <TextView
            android:id="@+id/tvOrderName"
            style="@style/Text.202046.14"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tvOrderAmount"
            android:layout_marginTop="@dimen/dp4"
            style="@style/Text.medium.202046.32"/>
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_marginTop="@dimen/dp4"
            android:drawableLeft="@drawable/cv_icon_success_small"
            android:drawablePadding="@dimen/dp4"
            style="@style/Text.858a8f.12"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutOrderDetailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp12"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutOriginalTransaction"
        android:background="@drawable/mm_bg_paid_order_info"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp46"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/layoutOrderInfo">
        <TextView
            android:text="Original Transaction"
            style="@style/Text.202046.14"/>
        <TextView
            android:gravity="right"
            android:layout_width="0dp"
            android:text="View"
            android:drawableRight="@drawable/mm_icon_right_gray"
            android:drawablePadding="@dimen/dp8"
            android:layout_weight="1"
            style="@style/Text.858a8f.14"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_fixed_saving"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ctb"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCustomerService"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mm_customer_service"
            android:drawablePadding="4dp"
            app:iiv_end_color="@color/ppColorPrimary"
            app:iiv_end_icon="pay_CustomerService"
            app:iiv_end_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.14"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/viewEmpty"
        android:background="@color/mm_color_f6f6fa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ctb"/>
</androidx.constraintlayout.widget.ConstraintLayout>
