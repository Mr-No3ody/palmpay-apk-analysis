<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llKkQrPromotion"
        android:background="@drawable/sm_kk_bg_promotion_banner"
        android:paddingBottom="@dimen/dp12"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp46"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp18"
            android:layout_height="@dimen/dp18"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/sm_kk_ic_promotion"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/tvKkQrPromotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enjoy 0 fees on every ride"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp2"
            style="@style/Text.medium.202046.14"/>
    </LinearLayout>
    <Space
        android:id="@+id/spaceKkQrOverlap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/llKkQrPromotion"
        app:layout_goneMarginBottom="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flKkQrCard"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spaceKkQrOverlap">
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_horizontal"
            android:id="@+id/tvKkQrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sm_kk_qr_title"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center_horizontal"
            android:id="@+id/tvKkQrDesc"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:text="@string/sm_kk_paused_tips"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvKkQrTitle"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierKkQrBelowHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvKkQrTitle,tvKkQrDesc"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llKkQrBadges"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierKkQrBelowHeader"/>
        <FrameLayout
            android:id="@+id/flKkQrContainer"
            android:background="@color/ppColorPopupWhiteBg"
            android:layout_width="@dimen/dp184"
            android:layout_height="@dimen/dp184"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llKkQrBadges"
            app:layout_goneMarginTop="@dimen/dp36">
            <ImageView
                android:id="@+id/ivKkQrCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/sm_kk_qr_title"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/pbKkQrLoading"
                android:background="@drawable/cv_shape_circle_white"
                android:visibility="gone"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:indeterminate="true"
                app:indicatorColor="@color/ppColorPrimary"
                app:indicatorSize="@dimen/dp18"
                app:trackThickness="@dimen/dp2"/>
            <FrameLayout
                android:id="@+id/flKkQrMask"
                android:background="@drawable/lib_ui_rect_corner_12_bg_dark"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivKkQrMaskIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:iiv_color="@color/ppColorTextAssist"
                        app:iiv_icon="pay_Refresh"
                        app:iiv_size="@dimen/dp32"/>
                    <TextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvKkQrMaskSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        android:includeFontPadding="false"
                        style="@style/Text.medium.202046.14"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextAssist"
                        android:gravity="center"
                        android:id="@+id/tvKkQrSubHint"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <ViewStub
            android:id="@+id/stubKkQrFrozen"
            android:layout="@layout/sm_kk_view_frozen_card"
            android:inflatedId="@+id/flKkQrFrozenContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llKkQrBadges"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center_horizontal"
            android:id="@+id/tvKkQrHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/sm_kk_qr_tap_to_refresh"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/flKkQrContainer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
