<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/mm_bg_select_state"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_marginTop="20dp"
        android:text="@string/core_select_date"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tv_interval"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp4"
        android:text="@string/core_select_date"
        style="@style/Text.6f7b85.14"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp180">
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wvMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wvDay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/wvYear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:background="@color/mm_color_f3f3f3"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp54"
        android:divider="@drawable/mm_select_state_divider"
        android:showDividers="middle">
        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cv_action_cancel"
            android:layout_weight="1"
            style="@style/Text.medium.9ca2aa.16"/>
        <TextView
            android:id="@+id/tvConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cv_action_confirm"
            android:layout_weight="1"
            style="@style/Text.medium.6306b2.16"/>
    </LinearLayout>
</LinearLayout>
