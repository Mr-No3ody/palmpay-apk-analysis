<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/previewView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:paddingBottom="70dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/cv_preview_dialog_percent">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_preview_dialog_title_height"
            layout="@layout/cv_layout_preview_dialog_title"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer
                android:orientation="vertical"
                android:id="@+id/itemContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsnet.palmpay.core.viewmodel.PreviewTitleView
                    android:id="@+id/previewTitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemAccountNo"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_title="@string/core_account_number"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemAccountName"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_title="@string/core_name"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemAmount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_amount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemFee"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_title="@string/core_fee"/>
                <TextView
                    android:textColor="#38d79f"
                    android:gravity="center_vertical"
                    android:id="@+id/tvZeroFeeTips"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    style="@style/txt_s_g"/>
                <com.transsnet.palmpay.core.viewmodel.ModelFreeFeeItem
                    android:id="@+id/itemFreeFee"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_tips_text="@string/cs_use_free_transfers_tips"
                    app:cv_bm_title="@string/cs_use_free_transfers"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemCoins"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_text_color="@color/ppColorError"
                    app:cv_bm_title="@string/core_coins_to_use"/>
                <com.transsnet.palmpay.core.viewmodel.ModelUsePointsWithSwitch
                    android:id="@+id/itemPointToUse"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelCouponItem
                    android:id="@+id/itemCoupon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_tips_text="@string/core_msg_coupon_rules"
                    app:cv_bm_title="@string/core_coupon_to_use"/>
                <com.transsnet.palmpay.core.viewmodel.ModelDiscountItem
                    android:id="@+id/itemDiscount"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_text_color="@color/ppColorError"
                    app:cv_bm_title="@string/core_discount"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemDataBonusEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_title="@string/core_data_bonus_earn"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemPointToEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="false"
                    app:cv_bm_text_color="@color/ppColorWarning"
                    app:cv_bm_title="@string/cs_confirm_point_earned"/>
                <com.transsnet.palmpay.core.viewmodel.ModelItemFee
                    android:id="@+id/itemCommissionToEarn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cv_preview_item_height"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"
                    app:cv_bm_show_amount_sign="true"
                    app:cv_bm_show_tips="true"
                    app:cv_bm_title="@string/core_commission_to_earn"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ff6f7b85"
                    android:id="@+id/payeeFeeDescTv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
                <com.transsnet.palmpay.core.viewmodel.ModelNewEarlyRefundItem
                    android:id="@+id/itemEarlyRefund"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
                <com.transsnet.palmpay.core.viewmodel.ModelPreviewPaymentMethodItem
                    android:id="@+id/itemPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.transsnet.palmpay.core.viewmodel.ModelApplyOkCard
                    android:id="@+id/viewApplyOkCard"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="@dimen/dp15"
                    android:layout_marginStart="@dimen/cv_preview_item_margin"
                    android:layout_marginEnd="@dimen/cv_preview_item_margin"/>
            </com.transsnet.palmpay.core.viewmodel.PreviewPageItemContainer>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <Button
        android:textSize="16dp"
        android:textColor="@color/cv_color_ffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:text="@string/core_pay"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
