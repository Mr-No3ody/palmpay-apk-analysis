<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cs_cl_total_outstanding_bg"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingVertical="@dimen/dp12">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:paddingHorizontal="@dimen/dp16">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/repay_tv_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/bill_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_total_outstanding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cs_oc_paid_off_txt_color"
                android:id="@+id/paid_off_tv"
                android:background="@drawable/cs_corner_4_bg_d9fae1"
                android:paddingTop="@dimen/dp2"
                android:paddingBottom="@dimen/dp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_current_paid_off"
                android:paddingStart="4dp"
                android:paddingEnd="@dimen/dp4"
                android:layout_marginStart="@dimen/dp4"
                app:layout_constraintBottom_toBottomOf="@+id/bill_title_tv"
                app:layout_constraintStart_toEndOf="@+id/bill_title_tv"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp18"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/bill_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp6"
                android:drawablePadding="@dimen/dp4"
                android:layout_weight="1"
                android:drawableEnd="@drawable/cs_cl_cornor_right_green_arrow"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bill_title_tv"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintTop_toBottomOf="@+id/bill_amount_tv">
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/cs_oc_overdue_txt_color"
                    android:id="@+id/repayment_date_tv"
                    android:background="@drawable/cs_overdue_txt_bg"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingRight="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:paddingHorizontal="@dimen/dp4"/>
                <TextView
                    android:textColor="@color/ppColorDividerLine"
                    android:id="@+id/label_divider_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:layout_marginStart="@dimen/dp4"/>
                <TextView
                    android:textColor="@color/cs_cl_main_color"
                    android:id="@+id/cl_extend_label_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_extendable"
                    android:layout_marginStart="@dimen/dp4"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/repay_tv"
                android:background="@drawable/cs_corner_16_bg_00a49a"
                android:visibility="gone"
                android:layout_width="@dimen/dp74"
                android:layout_height="@dimen/dp24"
                android:text="@string/cs_cl_bill_repay"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="@+id/bill_amount_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bill_amount_tv"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/total_label_sad"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp20"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="@+id/repay_tv"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cs_total_bill_view_text_color"
                android:gravity="bottom"
                android:id="@+id/view_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_oc_view"
                android:drawableEnd="@drawable/cs_oc_view_right_arrow"
                app:layout_constraintBottom_toBottomOf="@+id/bill_amount_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bill_amount_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/bill_detail_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/cs_bill_details"
            android:drawableEnd="@drawable/cs_cl_bill_detail_right_arrow"/>
    </LinearLayout>
</LinearLayout>
