<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_20"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/imageViewClose"
        android:paddingTop="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_close_grey"
        android:scaleType="fitXY"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_disclosure_of_user_data_collection"
        android:paddingVertical="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_web"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp400"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"/>
    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/loadingView"
        android:visibility="gone"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        app:indicatorColor="@color/ppColorPrimary"
        app:indicatorName="BallSpinFadeLoaderIndicator"
        app:layout_constraintBottom_toBottomOf="@+id/ll_web"
        app:layout_constraintEnd_toEndOf="@+id/ll_web"
        app:layout_constraintStart_toStartOf="@+id/ll_web"
        app:layout_constraintTop_toTopOf="@+id/ll_web"
        style="@style/AVLoadingIndicatorView.Large"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/clad_btn_container"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ll_web">
        <TextView
            android:textSize="@dimen/medium_text"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvNo"
            android:background="@drawable/cv_button_bg_light_purple_corner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/core_not_now"
            android:layout_weight="1"
            android:elevation="0dp"/>
        <View
            android:layout_width="@dimen/dp16"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/medium_text"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:id="@+id/tvYes"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/core_agree"
            android:layout_weight="1"
            android:elevation="0dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
