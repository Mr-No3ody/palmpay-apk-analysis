<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/seekBarProgress"
        android:padding="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/large_margin"
        android:layout_marginRight="@dimen/dp20"
        android:max="100"
        android:progressDrawable="@drawable/jp_re_seekbar_style"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginHorizontal="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="@dimen/dp20"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/ivCashLevel1"
        android:background="@drawable/jp_re_level_bg"
        android:layout_width="@dimen/dp52"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:layout_marginStart="@dimen/dp50"
        app:layout_constraintBottom_toBottomOf="@+id/seekBarProgress"
        app:layout_constraintStart_toStartOf="@+id/seekBarProgress"
        app:layout_constraintTop_toTopOf="@+id/seekBarProgress"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/ivCashLevel2"
        android:background="@drawable/jp_re_level_bg"
        android:layout_width="@dimen/dp52"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:layout_marginStart="@dimen/dp140"
        app:layout_constraintBottom_toBottomOf="@+id/seekBarProgress"
        app:layout_constraintStart_toStartOf="@+id/seekBarProgress"
        app:layout_constraintTop_toTopOf="@+id/seekBarProgress"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/ivCashLevel3"
        android:background="@drawable/jp_re_level_bg"
        android:layout_width="@dimen/dp52"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toBottomOf="@+id/seekBarProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/seekBarProgress"
        app:layout_constraintTop_toTopOf="@+id/seekBarProgress"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:id="@+id/tvCashLevel1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_1_user"
        app:layout_constraintEnd_toEndOf="@+id/ivCashLevel1"
        app:layout_constraintStart_toStartOf="@+id/ivCashLevel1"
        app:layout_constraintTop_toTopOf="@+id/tvCashLevel3"
        style="@style/txt_mi_w_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:id="@+id/tvCashLevel2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_2_user"
        app:layout_constraintEnd_toEndOf="@+id/ivCashLevel2"
        app:layout_constraintStart_toStartOf="@+id/ivCashLevel2"
        app:layout_constraintTop_toTopOf="@+id/tvCashLevel3"
        style="@style/txt_mi_w_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:id="@+id/tvCashLevel3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_3_user"
        app:layout_constraintEnd_toEndOf="@+id/ivCashLevel3"
        app:layout_constraintStart_toStartOf="@+id/ivCashLevel3"
        app:layout_constraintTop_toBottomOf="@+id/ivCashLevel3"
        style="@style/txt_mi_w_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
