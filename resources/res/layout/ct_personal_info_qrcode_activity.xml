<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorPrimary"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/core_scan_qr_code"
        app:title_bar_title_color="@color/ppColorTextBase"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/ct_personal_info_4dp_corner_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/personal_qrcode_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:paddingStart="30dp"
                android:paddingEnd="30dp">
                <ImageView
                    android:id="@+id/personal_avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="40dp"/>
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ff263138"
                    android:id="@+id/personal_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ff6f7b85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ct_scan_desc"/>
                <ImageView
                    android:id="@+id/personal_qrcode_iv"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="25dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/cv_palmpay_text_and_logo"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffc1ccd5"
                    android:id="@+id/copy_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:text="@string/ct_palmpay_provided_by_transsnet"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/save_bt"
                android:background="@drawable/ct_save_qr_code_bg"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textSize="16dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ct_save_qr_code"
                    android:drawablePadding="4dp"
                    app:iiv_start_color="@color/ppColorPrimary"
                    app:iiv_start_icon="pay_download"
                    app:iiv_start_size="@dimen/dp24"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
