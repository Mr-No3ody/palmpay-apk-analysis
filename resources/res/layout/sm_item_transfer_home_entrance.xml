<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEntranceIcon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="7dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEntranceCorner"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="-8dp"
        app:layout_constraintStart_toEndOf="@+id/ivEntranceIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/tvEntranceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="2"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="@dimen/dp12"
        app:autoSizeMinTextSize="@dimen/dp8"
        app:autoSizeStepGranularity="@dimen/dp1"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivEntranceIcon"
        style="@style/Text.6f7b85.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
