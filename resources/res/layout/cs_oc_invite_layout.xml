<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Invitation code"/>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textColor="#646970"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_oc_was_ok_card_recommend"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:id="@+id/invite_code_pev"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/dp32"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="60dp"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/cs_main_color"
        app:digitSpacing="9dp"
        app:digitStrokeColor="@color/ppColorTextDisable"
        app:digitStrokeWidth="0.5dp"
        app:digitTextColor="@color/cs_main_color"
        app:digitTextSize="36dp"
        app:digitWidth="44dp"
        app:mask=""
        app:numDigits="4"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <Button
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/cs_oc_contact_next_txt_color"
        android:layout_gravity="bottom"
        android:id="@+id/invite_bt"
        android:background="@drawable/cs_oc_contact_next_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginTop="@dimen/dp50"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/cs_oc_get_ok_card"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
