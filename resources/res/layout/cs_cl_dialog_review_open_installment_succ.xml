<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_benefits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_open_loan_congratulations_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_benefits">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end"
            android:id="@+id/iiv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:iiv_color="#906948"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"/>
        <RelativeLayout
            android:background="@drawable/cs_dash_line_cash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:backgroundTint="@color/ppColorTextNormal">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:gravity="center"
                android:id="@+id/interest"
                android:background="@color/md_white_1000"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="@dimen/dp10"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loanable Amount"/>
                <TextView
                    android:textSize="@dimen/dp26"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:id="@+id/tvLoanableAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    style="@style/txt_number_s_b_b"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loan Period"/>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6">
                    <TextView
                        android:textSize="@dimen/dp26"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center"
                        android:id="@+id/tvLoanableTerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/txt_number_s_b_b"/>
                    <TextView
                        android:id="@+id/tvDays"
                        android:layout_marginRight="@dimen/dp36"
                        android:text="Days"
                        android:layout_marginStart="@dimen/dp3"
                        style="@style/Text.medium.202046.16"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="#ff9900"
                    android:gravity="center"
                    android:id="@+id/tvPeriodDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:fontFamily="sans-serif-black"/>
            </LinearLayout>
        </LinearLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:layout_gravity="center"
            android:id="@+id/iv_borrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginBottom="@dimen/dp22"
            android:text="@string/cs_cl_borrow"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="#aa9153"
        android:gravity="center"
        android:background="@drawable/cs_dialog_benefits_title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginRight="@dimen/dp26"
        android:text="Installment Loans"
        android:fontFamily="sans-serif-black"
        android:layout_marginHorizontal="@dimen/dp26"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_benefits"/>
</androidx.constraintlayout.widget.ConstraintLayout>
