<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/tbLoanHome"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusBarView"
        app:title_bar_right_iconfont_1="pay_Menu"
        app:title_bar_right_iconfont_2="pay_CustomerService"
        app:title_bar_right_iconfont_color_1="@color/ppColorTextPrimary"
        app:title_bar_right_iconfont_color_2="@color/ppColorTextPrimary"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_2_iv="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProductLogo"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp48"
        app:layout_constraintBottom_toBottomOf="@+id/tbLoanHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tbLoanHome"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpLoanHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbLoanHome"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlLoanHome"
        android:background="@drawable/cv_shape_round_corner_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp56"
        android:layout_marginBottom="@dimen/dp24"
        android:backgroundTint="@color/cs_loan_home_tab_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.7"
        app:tabBackground="@color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/transparent"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="@dimen/dp4"
        app:tabPaddingEnd="@dimen/dp4"
        app:tabPaddingStart="@dimen/dp4"
        app:tabPaddingTop="4dp"
        app:tabRippleColor="@color/transparent"
        app:tabSelectedTextColor="@color/ppColorFlexiCashPrimary"
        app:tabTextColor="@color/ppColorTextPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
