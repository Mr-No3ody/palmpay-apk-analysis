<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_top_corner_white_20"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp16"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/cdsc_title_tv"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/core_select_coupon"
        android:layout_alignParentTop="true"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/cdsc_close_iv"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="15dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/dp15"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_below="@+id/cdsc_title_tv"/>
    <com.transsnet.palmpay.custom_view.SwipeRecyclerView
        android:id="@+id/cdsc_rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="60dp"
        android:layout_below="@+id/cdsc_title_tv"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:id="@+id/cdsc_confirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_w"/>
    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/loadingView"
        android:visibility="gone"
        android:layout_width="@dimen/dp36"
        android:layout_height="@dimen/dp36"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        app:indicatorColor="@color/ppColorPrimary"
        app:indicatorName="BallSpinFadeLoaderIndicator"
        style="@style/AVLoadingIndicatorView.Large"/>
</RelativeLayout>
