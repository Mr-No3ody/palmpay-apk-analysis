<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="232dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_bg"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp65"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/dp200"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_info"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.202046.16"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_info"
        android:visibility="gone"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_status"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <TextView
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/tv_status"
        android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        style="@style/Text.medium.ffffff.12"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/lpi_progress_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:maxHeight="@dimen/dp3"
        android:progressDrawable="@drawable/core_background_progress_style1"
        android:minHeight="@dimen/dp3"
        android:thumb="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:splitTrack="false"
        android:layout_marginHorizontal="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:splitTrack="false"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="lpi_progress_bar"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/iv_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/Text.202046.12"/>
    <View
        android:id="@+id/divider"
        android:background="@color/ppColorTextDisable"
        android:layout_width="@dimen/dp1"
        android:layout_height="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_content"
        app:layout_constraintEnd_toStartOf="@+id/tv_cashback"
        app:layout_constraintStart_toEndOf="@+id/tv_content"
        app:layout_constraintTop_toTopOf="@+id/tv_content"
        style="@style/core_divider_vertical"/>
    <TextView
        android:id="@+id/tv_cashback"
        android:paddingLeft="@dimen/dp2"
        android:paddingRight="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp4"
        android:paddingHorizontal="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tv_content"
        style="@style/Text.6306b2.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
