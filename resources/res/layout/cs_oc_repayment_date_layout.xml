<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="Due Date Introduction"/>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp18"
        android:text="@string/cs_oc_overdraft_due_date"
        android:drawablePadding="@dimen/dp8"
        android:drawableStart="@drawable/cs_oc_card_icon"
        android:layout_marginStart="@dimen/dp16"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cs_each_months"
        android:layout_marginStart="@dimen/dp41"/>
    <LinearLayout
        android:background="@drawable/cs_repayment_date_item_bg"
        android:padding="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp24"
            android:textStyle="bold"
            android:textColor="@color/cs_main_color"
            android:gravity="center"
            android:background="@drawable/cs_oc_start_repayment_txt_bg"
            android:padding="@dimen/dp24"
            android:layout_width="@dimen/dp98"
            android:layout_height="wrap_content"
            android:text="@string/cs_1th"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16">
            <TextView
                android:textColor="#6f7b87"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_use_card_from"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_1st_15th"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/cs_repayment_date_item_bg"
        android:padding="0.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/cs_main_color"
            android:gravity="center"
            android:background="@drawable/cs_oc_start_repayment_txt_bg"
            android:padding="@dimen/dp24"
            android:layout_width="@dimen/dp98"
            android:layout_height="wrap_content"
            android:text="@string/cs_16th"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16">
            <TextView
                android:textColor="#6f7b87"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_use_card_from"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cs_16th_30th"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
