<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp62">
    <TextView
        android:id="@+id/tvTime"
        app:layout_constraintBottom_toTopOf="@+id/tvDate"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:textColor="@color/cs_cl_repay_terms_date_text_color"
        android:id="@+id/tvDate"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTime"
        style="@style/Text.858a8f.14"/>
    <TextView
        android:id="@+id/tvUnlocked"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp8"
        android:text="To be unlocked"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ckKeepTime"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6f7b85.12"/>
    <CheckBox
        android:id="@+id/ckKeepTime"
        android:background="@drawable/cs_cl_keep_time_selector"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
