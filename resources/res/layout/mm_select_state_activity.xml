<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/mtb"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/mm_my_state"/>
    <TextView
        android:id="@+id/tvTaxInformation"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/mm_tax_information_required"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtb"
        style="@style/Text.medium.6306b2.18"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvTaxInformationContent"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="In compliance with Nigeria Tax regulation, a withholding tax of 10% applies to the interest earned on your savings and we will tax to the state you live in on your behalf."
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="@+id/tvTaxInformation"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTaxInformation"
        style="@style/Text.6f7b85.12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tvTaxInformationContent">
        <TextView
            android:id="@+id/tvMyState"
            android:text="@string/mm_my_state"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="left"
            android:id="@+id/tvState"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/dp16"
            app:iiv_end_color="@color/ppColorPrimary"
            app:iiv_end_icon="pay_ArrowRight"
            app:iiv_end_size="@dimen/dp16"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMyState"
            style="@style/Text.202046.14"/>
        <View
            android:id="@+id/viewDivider"
            android:background="@color/ppColorDividerLineDark"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toBottomOf="@+id/tvState"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:enabled="false"
            android:id="@+id/rtvConfirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/core_confirm"
            app:layout_constraintTop_toBottomOf="@+id/viewDivider"
            app:rtv_background_color="@color/mm_bg_confirm_btn"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.custom_view.CashBoxIntroductionView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
