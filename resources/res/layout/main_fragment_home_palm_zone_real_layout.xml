<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewZone"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTopBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toBottomOf="@+id/statusView"
        app:title_bar_back_icon="@null"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_show_right_text_arrow_down="false"
        app:title_bar_title="@string/core_reward"
        app:title_bar_title_color="@color/ppColorTextPrimary"/>
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <com.transsnet.palmpay.ui.view.HomeScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/viewContainer"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/rewardsStub"
                    android:layout="@layout/main_layout_rewards_points_and_coupon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
                <ViewStub
                    android:id="@+id/premiumBenefitsStub"
                    android:layout="@layout/main_home_rewards_tab_premium_benefits_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/palmPrizeStub"
                    android:layout="@layout/main_home_rewards_tab_palmprize_stub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/tasksStub"
                    android:layout="@layout/main_layout_palmzone_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
            </LinearLayout>
        </com.transsnet.palmpay.ui.view.HomeScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
    <ViewStub
        android:id="@+id/guestStub"
        android:layout="@layout/main_layout_home_reward_guest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <ViewStub
        android:id="@+id/dragViewStub"
        android:layout="@layout/main_layout_home_tab_drag_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="45dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
