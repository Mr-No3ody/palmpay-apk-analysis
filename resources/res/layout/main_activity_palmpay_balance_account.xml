<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/main_balance_account"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mapbaTopView"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <ImageView
                    android:id="@+id/ivLogo"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp14"
                    android:layout_marginRight="@dimen/dp16"
                    android:src="@drawable/main_palm_safe_logo"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="right"
                        android:id="@+id/ivShield"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/main_one_million_shield"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutSecurityGuaranteed"
                        android:background="@drawable/cv_shape_rect_corner_tl_tr_12_bg_success_background"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp24">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivSecurityGuaranteed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_Security"
                            app:iiv_size="@dimen/dp16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toLeftOf="@+id/tvSecurityGuaranteed"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textColor="#4ac097"
                            android:id="@+id/tvSecurityGuaranteed"
                            android:layout_marginLeft="4dp"
                            android:text="@string/main_str_security_guaranteed"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/ivSecurityGuaranteed"
                            app:layout_constraintRight_toLeftOf="@+id/ivArrowRight"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Text.6306b2.12"/>
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/ivArrowRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            app:iiv_color="@color/ppColorSuccess"
                            app:iiv_icon="pay_ArrowCenterRight"
                            app:iiv_size="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/tvSecurityGuaranteed"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp14">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/tvTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_available_balance"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/mapbaEye"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/cv_shape_eye"
                            android:layout_marginStart="@dimen/dp8"
                            app:layout_constraintBottom_toBottomOf="@+id/tvTitle2"
                            app:layout_constraintStart_toEndOf="@+id/tvTitle2"
                            app:layout_constraintTop_toTopOf="@+id/tvTitle2"/>
                        <TextView
                            android:textSize="@dimen/dp30"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/mapbaAvaliableBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="@dimen/dp8"
                            android:fontFamily="sans-serif-black"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvTitle2"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/mapbaFrozenArea"
                        android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                        android:paddingLeft="@dimen/dp20"
                        android:paddingTop="@dimen/dp12"
                        android:paddingRight="@dimen/dp20"
                        android:paddingBottom="@dimen/dp12"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp20"
                        android:paddingVertical="@dimen/dp12">
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextAssist"
                            android:id="@+id/tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frozen Amount:"
                            app:layout_constraintEnd_toStartOf="@+id/mapbaFrozenAmount"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/mapbaFrozenAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/dp4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv1"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/dp12"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/mapbaFrozenTips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp8"
                            android:lineHeight="@dimen/dp18"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv1"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/ivPolygon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/cv_icon_polygon"
                        android:scaleType="fitXY"
                        app:tint="@color/ppColorBackgroundDark"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center_vertical"
                        android:id="@+id/mapbaUpgradeKYC"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                        android:paddingLeft="8dp"
                        android:paddingTop="4dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        app:iiv_end_color="@color/ppColorTextNormal"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp16"
                        app:iiv_start_color="@color/ppColorPrimary"
                        app:iiv_start_icon="pay_UpdateFill"
                        app:iiv_start_size="@dimen/dp16"/>
                    <TextView
                        android:textColor="@color/ppColorSuccess"
                        android:gravity="center"
                        android:id="@+id/tvCashBoxAutoSave"
                        android:background="@drawable/cv_shape_rect_corner_8_bg_38d79f"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingRight="@dimen/dp8"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp28"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp4"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/dp8"
                        android:autoSizeMaxTextSize="@dimen/dp12"
                        style="@style/Text.202046.12"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivNetworkTips"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/cv_arrow_up_dark"
                        android:scaleType="fitXY"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalAssetsAmount"/>
                    <com.transsnet.palmpay.custom_view.RoundedTextView
                        android:gravity="center"
                        android:id="@+id/tvNetworkTips"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp8"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16"
                        android:paddingHorizontal="@dimen/dp8"
                        android:paddingVertical="@dimen/dp4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivNetworkTips"
                        app:rtv_background_color="@color/ppColorBackgroundDark"
                        app:rtv_corner_radius="12dp"
                        style="@style/txt_mi_g"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ppButtonHeight"
                        android:layout_marginLeft="@dimen/dp16"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_marginBottom="@dimen/dp16"
                        android:layout_marginHorizontal="@dimen/dp16">
                        <com.palmpay.lib.ui.button.PpButton
                            android:gravity="center"
                            android:id="@+id/mapbaWithdraw"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/core_withdraw"
                            android:layout_weight="1"
                            style="@style/ppSecondaryButtonStyle"/>
                        <View
                            android:id="@+id/space"
                            android:layout_width="12dp"
                            android:layout_height="@dimen/dp1"/>
                        <com.palmpay.lib.ui.button.PpButton
                            android:gravity="center"
                            android:id="@+id/mapbaFund"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/core_add_money"
                            android:layout_weight="1"
                            style="@style/ppButtonStyle"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/viewTopMarquee"
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:paddingLeft="@dimen/dp8"
                android:paddingRight="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                app:mvShowIconImg="true"
                app:mvTextColor="@color/ppColorPrimary"
                app:mvTextSize="12dp"
                app:slot_id="@string/balance_account_top_marquee_slot_id"/>
            <com.transsnet.adsdk.widgets.banner.BannerAdView
                android:id="@+id/viewAd"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                app:ad_rounded_corners="@dimen/dp8"
                app:bvp_page_margin="5dp"
                app:bvp_reveal_width="10dp"
                app:slot_id="@string/balance_account_middle_banner_slot_id"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/mapbaBalanceView"
                android:background="@color/ppColorBackgroundLight"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp20"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <TextView
                        android:textSize="@dimen/dp16"
                        android:textColor="@color/ppColorTextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_balance_statement_just"
                        android:fontFamily="sans-serif-medium"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp1"
                        android:layout_weight="1"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="center_vertical"
                        android:id="@+id/mapbaViewAll2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_all"
                        android:drawablePadding="4dp"
                        app:iiv_end_color="@color/ppColorTextPrimary"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp16"/>
                </LinearLayout>
                <View
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="@dimen/dp12"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp350">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/mapbaRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <com.transsnet.palmpay.custom_view.EmptyView
                        android:id="@+id/emptyView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp350"
                        app:cv_ev_tips="No Records"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/ppColorPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tvAll"
                    android:paddingTop="@dimen/dp10"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_view_all"
                    android:paddingVertical="@dimen/dp10"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
