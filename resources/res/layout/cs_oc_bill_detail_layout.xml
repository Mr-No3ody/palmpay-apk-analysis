<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/oc_bill_detail_mtb"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_text="Contract"
        app:title_bar_title="My Bill"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/csTextview118"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_bill_detail_repaid_amount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/oc_bill_repaid_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/csTextview118"
            app:layout_constraintTop_toBottomOf="@+id/csTextview118"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#63c778"
            android:id="@+id/oc_status_tv"
            android:background="@drawable/cv_rect_corner_4_bg_d9fae1"
            android:padding="@dimen/dp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_bill_paid_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/csTextview123"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/oc_bill_repaid_amount_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/csTextview134"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_oc_principal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/csTextview123"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/principal_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview134"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/csTextview134"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/service_fee_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cs_oc_penalty"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/csTextview134"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/penalty_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/service_fee_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/service_fee_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/csTextview20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_oc_bill_detail"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/dp16"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/oc_bill_rv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oc_bill_type_tv"/>
</LinearLayout>
