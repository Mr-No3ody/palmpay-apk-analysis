<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp16"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_payment_name_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp4"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:id="@+id/tv_fund"
        android:background="@drawable/cv_btn_base_bg_white_round_stroke_6306b2"
        android:visibility="gone"
        android:layout_width="@dimen/dp67"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_add_money"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6306b2.10"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_check"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_check"
        app:tint="@color/ppColorSuccess"/>
</androidx.constraintlayout.widget.ConstraintLayout>
