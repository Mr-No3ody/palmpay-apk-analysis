<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewDivider"
        android:background="@drawable/cv_shadow"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp30"
        app:layout_constraintTop_toTopOf="@+id/layoutDeleteAll"
        app:layout_goneMarginTop="0dp"/>
    <View
        android:id="@+id/view_bg"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        app:layout_constraintTop_toBottomOf="@+id/view_top_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_item_logo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintStart_toEndOf="@+id/iv_item_logo"
        app:layout_constraintTop_toTopOf="@+id/view_bg"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_item_tag"
        android:background="@drawable/cv_shape_rect_corner_4_bg_secondary"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp10"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_hint"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_item_name"
        app:layout_constraintTop_toTopOf="@+id/view_bg"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tv_item_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toStartOf="@+id/ivDelete"
        app:layout_constraintTop_toTopOf="@+id/view_bg"
        app:layout_goneMarginEnd="@dimen/dp16"
        style="@style/txt_s_g"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivDelete"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp12"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layoutDeleteAll"
        android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        app:layout_constraintTop_toBottomOf="@+id/view_bg">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Delete"
            app:iiv_size="16dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_delete_all"
            android:layout_marginStart="@dimen/dp3"
            style="@style/txt_s_g"/>
    </LinearLayout>
    <View
        android:id="@+id/view_top_bg"
        android:background="@color/ppColorBackgroundLight"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_top_b2"
        android:background="@color/ppColorBackgroundLight"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/dp12"
        android:layout_height="@dimen/dp14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dividerView"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
