<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:paddingLeft="@dimen/dp2"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp2"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="@dimen/dp80"
    android:layout_height="128dp"
    android:layout_marginRight="@dimen/dp8"
    android:paddingHorizontal="@dimen/dp2"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp21"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivPic"
        style="@style/Text.202046.14"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/main_color_d05151"
        android:gravity="center"
        android:id="@+id/tvChangePercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/main_stock_down"
        android:drawablePadding="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
