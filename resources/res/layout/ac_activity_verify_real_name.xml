<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_back_icon="@drawable/core_actionbar_back_white"
        app:title_bar_show_right_2_iv="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_edit_your_name"
            style="@style/txt_b_w"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMessage"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_msg_edit_your_name"
            style="@style/txt_mi_w"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_8"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/ac_legal_first_name"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputMiddleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/ac_legal_middle_name_opt"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/ac_legal_surname"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/textViewNext"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/core_submit"
            style="@style/txt_b_w"/>
    </LinearLayout>
</LinearLayout>
