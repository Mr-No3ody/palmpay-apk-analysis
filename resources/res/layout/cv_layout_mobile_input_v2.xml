<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.202046.12"/>
    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
        android:textSize="@dimen/dp22"
        android:textColorHint="@color/ppColorTextDisable"
        android:gravity="center_vertical"
        android:id="@+id/et_phone_number"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp50"
        android:hint="@string/cv_msg_enter_mobile_number"
        android:maxLines="1"
        android:textCursorDrawable="@drawable/lib_ui_editor_cursor_1"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toStartOf="@+id/barrier_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/txt_s_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_clear"
        android:layout_width="@dimen/dp18"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_CloseFill"
        app:iiv_size="@dimen/dp18"
        app:layout_constraintBottom_toBottomOf="@+id/et_phone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_phone_number"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_IdFill"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_phone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_phone_number"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="iv_contacts,iv_clear"/>
    <ImageView
        android:id="@+id/iv_divider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        app:layout_constraintTop_toBottomOf="@+id/et_phone_number"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorError"
        android:id="@+id/tv_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/iv_divider"
        style="@style/txt_s_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
