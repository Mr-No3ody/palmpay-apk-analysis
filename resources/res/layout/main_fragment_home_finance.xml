<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="false"
        app:title_bar_title=""
        app:title_bar_title_color="@color/ppColorTextPrimary"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/bgView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/headerBottomBarrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivMenu"
                android:visibility="gone"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:layout_marginEnd="@dimen/dp16"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Menu"
                app:iiv_size="@dimen/dp24"
                app:layout_constraintBottom_toBottomOf="@+id/tabLoan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tabLoan"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCustomerService"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:layout_marginEnd="@dimen/dp16"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_CustomerService"
                app:iiv_size="@dimen/dp24"
                app:layout_constraintBottom_toBottomOf="@+id/tabLoan"
                app:layout_constraintEnd_toStartOf="@+id/ivMenu"
                app:layout_constraintTop_toTopOf="@+id/tabLoan"
                app:layout_goneMarginEnd="@dimen/dp16"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/tabLoan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/core_loan"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_b_b"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tvAppTopMainConfig"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabLoan"
                style="@style/Text.6f7b85.10"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/headerBottomBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:barrierMargin="@dimen/dp8"
                app:constraint_referenced_ids="tabLoan,tvAppTopMainConfig"/>
            <View
                android:id="@+id/indicatorLoan"
                android:background="@color/ppColorPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="@+id/tabLoan"
                app:layout_constraintStart_toStartOf="@+id/tabLoan"
                app:layout_constraintTop_toBottomOf="@+id/tabLoan"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tabMobileInstallment"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_mobile_installment"
                android:layout_marginStart="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="@+id/bgView"
                app:layout_constraintStart_toEndOf="@+id/tabLoan"
                app:layout_constraintTop_toTopOf="@+id/bgView"
                style="@style/Text.202046.18"/>
            <View
                android:id="@+id/indicatorMobileInstallment"
                android:background="@color/ppColorPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="0dp"
                android:layout_marginHorizontal="0dp"
                app:layout_constraintEnd_toEndOf="@+id/tabMobileInstallment"
                app:layout_constraintStart_toStartOf="@+id/tabMobileInstallment"
                app:layout_constraintTop_toBottomOf="@+id/tabMobileInstallment"/>
            <FrameLayout
                android:id="@+id/fin_fl"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bgView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ViewStub
        android:id="@+id/viewNotNetworkStub"
        android:layout="@layout/main_layout_not_network_home_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
