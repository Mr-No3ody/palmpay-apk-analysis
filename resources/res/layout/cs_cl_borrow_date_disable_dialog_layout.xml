<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:paddingTop="@dimen/dp24"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp24">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/keep_repaying_close_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_oc_close_icon"
        android:layout_marginEnd="@dimen/dp24"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/extend_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:drawableTop="@drawable/cs_cl_repay_on_time_img"
        android:drawablePadding="@dimen/dp12"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/continue_loan_tv"
        android:background="@drawable/cs_corner_12_bg_00a59a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_cl_i_get_it"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"/>
</LinearLayout>
