<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvPaidCashBoxAccount"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose"
        style="@style/Text.medium.202046.20"/>
    <TextView
        android:id="@+id/tvWithdrawEarnInterest"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/mm_withdraw_earn_interest"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPaidCashBoxAccount"
        style="@style/Text.6f7b85.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:enabled="false"
        android:id="@+id/rtvConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tvWithdrawEarnInterest"
        app:rtv_background_color="@color/mm_bg_btn"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
    <CheckBox
        android:gravity="center"
        android:id="@+id/ckProtocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:button="@drawable/cv_checkbox_selector2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rtvConfirm"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvProtocol"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginRight="@dimen/dp18"
        android:text="@string/mm_cash_box_terms_and_conditions"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ckProtocol"
        app:layout_constraintLeft_toRightOf="@+id/ckProtocol"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ckProtocol"
        style="@style/Text.202046.10"/>
    <View
        android:layout_width="@dimen/dp100"
        android:layout_height="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProtocol"/>
</androidx.constraintlayout.widget.ConstraintLayout>
