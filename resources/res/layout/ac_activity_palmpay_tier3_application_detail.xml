<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_right_iconfont_2="pay_CustomerService"
        app:title_bar_show_right_2_iv="true"/>
    <TextView
        android:textSize="24dp"
        android:gravity="center_vertical"
        android:id="@+id/tvLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="16dp"
        android:text="@string/ac_enter_your_address"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvLine1"
        style="@style/txt_s_g"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="@dimen/dp64"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivPhotoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/ac_default_photo_frame_2"
                    android:scaleType="fitXY"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.transsnet.palmpay.custom_view.image.RoundImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_margin="2dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    app:cvRadius="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivPhotoFrame"
                    app:layout_constraintTop_toTopOf="@+id/ivPhotoFrame"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputAddressLevel1"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="@string/ac_please_select"
                    app:form_label_text="@string/ac_address_level1_name"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:enabled="false"
                    android:id="@+id/inputAddressLevel2"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp12"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="@string/ac_please_select"
                    app:form_label_text="@string/ac_address_level2_name"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:enabled="false"
                    android:id="@+id/inputAddressLevel3"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp12"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="@string/ac_please_select"
                    app:form_label_text="@string/ac_address_level3_name"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:enabled="false"
                    android:id="@+id/inputStreet"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                    android:paddingTop="@dimen/dp12"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="e.g. 32, Kolawole Street"
                    app:form_label_text="@string/ac_street_address"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/textViewConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/ac_manual_review"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        style="@style/ppButtonStyle"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
