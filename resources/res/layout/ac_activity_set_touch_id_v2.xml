<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_verify_fingerprint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        style="@style/txt_b_b_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_TouchSensor"
        app:iiv_size="@dimen/dp56"
        app:layout_constraintBottom_toTopOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/textViewMessage"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp30"
        android:layout_marginRight="@dimen/dp30"
        android:text="Please place your fingertip on the Touch ID area to verify your identity."
        android:lineSpacingExtra="5dp"
        android:layout_marginHorizontal="@dimen/dp30"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_g"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:id="@+id/textViewError"
        android:paddingTop="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp30"
        android:layout_marginRight="@dimen/dp30"
        android:text="@string/ac_msg_error_touch_id"
        android:lineSpacingExtra="5dp"
        android:layout_marginHorizontal="@dimen/dp30"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="textViewError, textViewMessage"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="14dp"
        android:gravity="center"
        android:id="@+id/btnClose"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp36"
        android:layout_marginTop="@dimen/dp24"
        android:text="Got it, Enter PalmPay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier1"
        style="@style/ppSmallButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
