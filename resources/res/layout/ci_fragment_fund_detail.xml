<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/core_transaction_details"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.custom_view.model.OrderResultHeaderModel
                android:id="@+id/orlm_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_container_top"
                android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <com.transsnet.palmpay.cash_in.ui.view.ModelUssdInfo
                android:id="@+id/cfrd_ussd_info"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:padding="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_container_middle"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp12"
                android:paddingVertical="@dimen/dp12"/>
            <com.transsnet.palmpay.core.ui.widget.FixedSavingsLayout
                android:id="@+id/layout_fixed_savings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultCustomerServiceModel
                android:id="@+id/model_order_result_customer_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginRight="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp12"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/ppColorBackgroundLight"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52">
        <FrameLayout
            android:id="@+id/cffd_share_receipt"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/core_view_receipt"
                android:drawableLeft="@drawable/core_ic_pay_bails"
                android:drawablePadding="@dimen/dp8"/>
        </FrameLayout>
    </LinearLayout>
    <com.transsnet.palmpay.custom_view.model.OrderResultViewReceiptModel
        android:id="@+id/btn_view_receipt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
