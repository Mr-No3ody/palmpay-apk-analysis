<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp4"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp4">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/tv_item_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_mi_g"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_item_tips_icon"
            android:padding="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp2"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_InformationOutline"
            app:iiv_size="12dp"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_item_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/txt_mi_b"/>
    </LinearLayout>
</LinearLayout>
