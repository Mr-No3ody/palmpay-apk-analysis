<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorDividerLine"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/core_pin_kb_item_height">
        <com.mikepenz.iconics.view.IconicsTextView
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tvSecurity"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/core_secure_input_mode_is_active"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            app:iiv_start_color="@color/ppColorSuccess"
            app:iiv_start_icon="pay_Security"
            app:iiv_start_size="@dimen/dp16"
            style="@style/txt_s_b"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:id="@+id/tvDone"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/core_done"
            android:layout_marginEnd="16dp"
            style="@style/txt_s_g"/>
    </FrameLayout>
    <com.transsnet.palmpay.core.viewmodel.KeyboardGridLayout
        android:id="@+id/number_keyboard_content"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="4"
        android:columnCount="3"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:columnCount="3"
        app:rowCount="4">
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_1"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_1"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_2"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_2"
            android:layout_columnSpan="1"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_3"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_3"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_4"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_4"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_5"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_5"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_6"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_6"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_7"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_7"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_8"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_8"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_9"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_9"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_blank"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_0"
            android:background="@drawable/core_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/core_digit_0"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/pin_input_text_style"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/digit_del"
            android:layout_width="wrap_content"
            android:scaleType="center"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            app:srcCompat="@drawable/core_pin_input_delete_icon"
            app:tint="@color/ppColorTextPrimary"
            style="@style/pin_input_text_style"/>
    </com.transsnet.palmpay.core.viewmodel.KeyboardGridLayout>
</LinearLayout>
