<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp6"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.transsnet.palmpay.custom_view.CircleProgressView
            android:id="@+id/clp_progress"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/clp_tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_1_4"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/text_color_gray14_646970"
        android:id="@+id/clp_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="@string/core_0"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/clp_tv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text="@string/core_due_on_s"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
