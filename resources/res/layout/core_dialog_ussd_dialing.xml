<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_shape_rect_corner_20_bg_white"
    android:padding="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cpi_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:indicatorColor="@color/ppColorPrimary"
        app:indicatorDirectionCircular="counterclockwise"
        app:indicatorSize="@dimen/dp80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="@color/ppColorDividerLineDark"
        app:trackThickness="@dimen/dp4"/>
    <TextView
        android:textSize="@dimen/dp20"
        android:id="@+id/tv_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cpi_countdown"
        app:layout_constraintEnd_toEndOf="@+id/cpi_countdown"
        app:layout_constraintStart_toStartOf="@+id/cpi_countdown"
        app:layout_constraintTop_toTopOf="@+id/cpi_countdown"
        style="@style/Text.202046"/>
    <TextView
        android:textSize="@dimen/dp18"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_dialing_ussd_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cpi_countdown"
        style="@style/Text.202046"/>
    <TextView
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/core_dialing_ussd_code_tips"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Text.6f7b85.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
