<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewRoot"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLightning"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivArrowRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightning"
            app:layout_constraintStart_toEndOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/ivLightning"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/tvSubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp12"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivLightning"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:textSize="@dimen/dp40"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:gravity="center"
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp12"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubTitle"
            style="@style/txt_number_me_b_b"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvIncreaseLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:includeFontPadding="false"
            app:iiv_end_color="@color/ppColorFlexiCashPrimary"
            app:iiv_end_icon="pay_ArrowCenterRight"
            app:iiv_end_size="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAmount"
            style="@style/Text.202046.14"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorWarning"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp12"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvIncreaseLimit"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/topBarrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvStatus, tvAmount,tvIncreaseLimit"/>
        <TextView
            android:gravity="center"
            android:id="@+id/btnAction"
            android:background="@drawable/cv_shape_round_corner_cash_primary"
            android:layout_width="181dp"
            android:layout_height="@dimen/dp36"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_cl_borrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarrier"
            style="@style/ppButtonStyle"/>
        <com.transsnet.palmpay.credit.view.MultiLoanCtaLightView
            android:id="@+id/multiLoanCtaLight"
            android:visibility="gone"
            android:layout_width="181dp"
            android:layout_height="@dimen/dp36"
            app:layout_constraintBottom_toBottomOf="@+id/btnAction"
            app:layout_constraintEnd_toEndOf="@+id/btnAction"
            app:layout_constraintStart_toStartOf="@+id/btnAction"
            app:layout_constraintTop_toTopOf="@+id/btnAction"/>
        <com.mikepenz.iconics.view.IconicsCheckBox
            android:id="@+id/checkAgreement"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:checked="true"
            android:layout_marginStart="@dimen/dp12"
            app:iiv_checked_color="@color/ppColorFlexiCashPrimary"
            app:iiv_checked_icon="pay_CheckboxFill"
            app:iiv_checked_size="16dp"
            app:iiv_unchecked_color="@color/ppColorFlexiCashPrimary"
            app:iiv_unchecked_icon="pay_CheckboxOutline"
            app:iiv_unchecked_size="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAction"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvApplicationAgreement"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkAgreement"
            app:layout_constraintTop_toBottomOf="@+id/btnAction"
            style="@style/Text.202046.12"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/agreementBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="btnAction,checkAgreement,tvApplicationAgreement"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:gravity="center_vertical"
            android:id="@+id/tvInterestLabel"
            android:background="@drawable/cs_interest_label_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnAction"
            app:layout_constraintEnd_toEndOf="@+id/btnAction"
            style="@style/txt_me_w_b"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCoupon"
            android:background="@drawable/cv_shape_rect_corner_8_bg_assist_background"
            android:paddingLeft="@dimen/dp8"
            android:paddingRight="@dimen/dp8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp36"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            android:paddingHorizontal="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/agreementBarrier">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCouponIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="true"
                app:iiv_color="@color/ppColorWarning"
                app:iiv_icon="pay_CouponsFill"
                app:iiv_size="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/ppColorWarning"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvCouponTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnCouponUse"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.14"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/btnCouponUse"
                android:background="@drawable/cs_corner_16_bg_00a49a"
                android:paddingLeft="@dimen/dp8"
                android:paddingRight="@dimen/dp8"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp20"
                android:text="@string/core_use"
                android:backgroundTint="@color/ppColorWarning"
                android:paddingHorizontal="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_mi_w"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.transsnet.palmpay.credit.view.MultiLoanHomeBannerView
            android:id="@+id/multiLoanBanner"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutCoupon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center"
        android:layout_gravity="start|top"
        android:id="@+id/tvBadge"
        android:background="@drawable/cs_oc_tag_tv_bg_2"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:paddingHorizontal="@dimen/dp8"
        style="@style/txt_mi_b_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorFlexiCashPrimary"
        android:gravity="center"
        android:layout_gravity="start|top"
        android:id="@+id/tvMultiLoanBadge"
        android:background="@drawable/cs_multi_loan_badge_bg"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp8"
        style="@style/Text.medium.202046.10"/>
</FrameLayout>
