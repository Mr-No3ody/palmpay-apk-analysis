<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp16"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/ct_link_fave_not_pp_user"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp51"
        android:layout_margin="@dimen/dp24">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tvCancel"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp44"
            android:text="@string/core_cancel"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp16"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/tvOk"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cv_default_button_height"
                android:text="@string/ct_invite_fave"
                android:layout_weight="1"
                android:layout_alignParentBottom="true"
                android:fontFamily="sans-serif-medium"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_alignParentRight="true"
                app:slot_id="@string/add_new_fave_invite_dialog_conner_marker_banner"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
