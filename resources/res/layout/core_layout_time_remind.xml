<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cltr_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/cltr_area1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp38"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_reminder"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/cltr_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp20"
            android:thumb="@drawable/core_switch_thumb"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:track="@drawable/core_switch_blue_gray"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/cltr_tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_time_reminder_tips"
        android:layout_centerVertical="true"
        app:layout_constraintTop_toBottomOf="@+id/cltr_area1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cltr_area2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cltr_tv1">
        <RelativeLayout
            android:id="@+id/cltr_bill_type"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp38"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_type"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/clt_airtime_check_iv"
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:src="@drawable/cv_purple_checked"/>
                <TextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/clt_airtime_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_airtime"
                    android:layout_marginStart="@dimen/dp5"/>
                <ImageView
                    android:id="@+id/clt_bundle_check_iv"
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:src="@drawable/cv_gray_unchecked"
                    android:layout_marginStart="@dimen/dp15"/>
                <TextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/clt_bundle_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_data"
                    android:layout_marginStart="@dimen/dp5"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/cltr_remind_period_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp38"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_reminder_period"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/cltr_remind_period_tv"
                android:background="@drawable/core_shape_rect_corner_10_stroke_gray_e2e2ea"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp38"
                android:minWidth="134dp"
                android:drawablePadding="@dimen/dp8"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/cv_dropdown"
                android:paddingStart="@dimen/dp20"
                android:paddingEnd="@dimen/dp11"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/cltr_remind_time_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp38"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/cltr_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_reminder_time"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/cltr_remind_time_tv"
                android:background="@drawable/core_shape_rect_corner_10_stroke_gray_e2e2ea"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp38"
                android:minWidth="134dp"
                android:drawablePadding="@dimen/dp8"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/cv_dropdown"
                android:paddingStart="@dimen/dp20"
                android:paddingEnd="@dimen/dp11"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
