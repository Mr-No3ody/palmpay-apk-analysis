<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ly_range"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/lib_ui_layout_date_picker_range"/>
    <com.palmpay.lib.ui.picker.picker.TimePickerView
        android:id="@+id/v_time_picker"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:layout_marginLeft="@dimen/ppPickerMarginHorizontal"
        android:layout_marginRight="@dimen/ppPickerMarginHorizontal"
        android:layout_marginHorizontal="@dimen/ppPickerMarginHorizontal"
        app:PickerView_text_size="@dimen/ppPickerTextSize"
        app:layout_constraintTop_toBottomOf="@+id/ly_range"/>
    <include
        android:id="@+id/ly_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppPickerButtonHeight"
        app:layout_constraintTop_toBottomOf="@+id/v_time_picker"
        layout="@layout/lib_ui_dialog_picker_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
