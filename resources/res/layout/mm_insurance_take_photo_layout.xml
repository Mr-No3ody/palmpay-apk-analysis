<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="Phone Screen Insurance"/>
    <FrameLayout
        android:id="@+id/camera_preview_fl"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/camera_preview_tips"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="150dp"
        android:paddingRight="@dimen/dp16"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp68"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/plan_progress_pb"
                android:layout_width="@dimen/dp120"
                android:layout_height="@dimen/dp120"
                android:max="5000"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/mm_bg_index_progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_divider_view"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center"
                android:id="@+id/tv_time_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5s"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/dp22"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp48"
            android:text="Please put your phone screen at the mirror."/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextAssist"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="Make sure that the body shot is complete"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/photo_img"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp68"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/countdown_shot_cl"
        android:background="@drawable/mm_bg_primary_disable_selected"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"
        android:layout_marginVertical="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/countdown_shot_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:text="Countdown Shot"
            android:drawableLeft="@drawable/mm_icon_schedule_outline"
            android:drawablePadding="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/review_photo_cl"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/try_again_tv"
            android:background="@drawable/cv_shape_rect_corner_12_bg_color_disable"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="Reshoot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/done_tv"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/done_tv"
            android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:text="@string/core_confirm"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/try_again_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/try_again_tv"
            app:layout_constraintTop_toTopOf="@+id/try_again_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
