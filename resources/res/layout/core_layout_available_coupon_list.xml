<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp48">
    <View
        android:id="@+id/view_bg_coupon_start"
        android:background="@drawable/cv_shape_rect_corner_tl_bl_4_bg_white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_bg_coupon_mid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/atua_coupon_text_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_coupon"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_coupons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_bg_coupon_start"
        app:layout_constraintStart_toEndOf="@+id/atua_coupon_text_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view_bg_coupon_mid"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg_coupon_start"
        app:layout_constraintEnd_toStartOf="@+id/view_bg_coupon_end"
        app:layout_constraintTop_toTopOf="@+id/view_bg_coupon_start"
        app:srcCompat="@drawable/core_bg_coupon_mid"/>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/view_bg_coupon_end"
        android:background="@drawable/cv_shape_rect_corner_rt_rb_4_bg_white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.28">
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_gravity="center"
            android:id="@+id/view_loading_indicator"
            android:visibility="gone"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:indicatorColor="@color/ppColorPrimary"
            app:indicatorName="BallSpinFadeLoaderIndicator"
            style="@style/AVLoadingIndicatorView.Large"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp12"
            android:layout_gravity="center"
            android:id="@+id/tv_arrow_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_view"
            app:iiv_end_color="@color/ppColorTextNormal"
            app:iiv_end_icon="pay_ArrowRight"
            app:iiv_end_size="@dimen/dp16"
            style="@style/Text.medium.6306b2.12"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
