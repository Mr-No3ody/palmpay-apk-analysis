<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fb_dp16"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="@dimen/fb_dp8"
        app:cardElevation="@dimen/fb_dp4">
        <com.flexibank.sdk.core.viewmodel.FlexiBankModelApplyOkCard
            android:id="@+id/fb_model_okCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
