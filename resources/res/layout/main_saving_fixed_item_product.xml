<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/tvInterestAmount"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/tvInterestPa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:id="@+id/tvPercent"
            android:text="%"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvInterestAmount"
            app:layout_constraintLeft_toRightOf="@+id/tvInterestAmount"
            style="@style/Text.medium.202046.10"/>
        <TextView
            android:textColor="#9ca2aa"
            android:id="@+id/tvInterestPa"
            android:text="Interest p.a."
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tvInterestAmount"
            app:layout_constraintTop_toBottomOf="@+id/tvInterestAmount"
            style="@style/Text.858a8f.10"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/tvDurationNum"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/tvDuration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:id="@+id/tvDurationDay"
            android:layout_marginLeft="@dimen/dp3"
            android:text="Days"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvDurationNum"
            app:layout_constraintLeft_toRightOf="@+id/tvDurationNum"
            style="@style/Text.medium.202046.10"/>
        <TextView
            android:textColor="#9ca2aa"
            android:id="@+id/tvDuration"
            android:text="Duration"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tvDurationNum"
            app:layout_constraintTop_toBottomOf="@+id/tvDurationNum"
            style="@style/Text.858a8f.10"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/md_white_1000"
        android:id="@+id/rtvInvest"
        android:layout_width="@dimen/dp50"
        android:layout_height="@dimen/dp24"
        android:text="@string/core_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rtv_background_color="@color/ppColorPrimary"
        app:rtv_corner_radius="@dimen/dp16"
        style="@style/Text.medium.ffffff.12"/>
</LinearLayout>
