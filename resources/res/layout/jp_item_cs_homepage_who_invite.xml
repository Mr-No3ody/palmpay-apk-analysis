<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp62"
    android:paddingStart="@dimen/dp12"
    android:paddingEnd="@dimen/dp12">
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/btnWhoInvite"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:minWidth="@dimen/dp44"
        android:text="@string/core_invite"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        app:autoSizeText="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llWhoInviteTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnWhoInvite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvWhoInvitePrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/txt_s_w"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:ellipsize="end"
            android:id="@+id/tvWhoInviteReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
