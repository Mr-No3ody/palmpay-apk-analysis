<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_1_iv="true"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/clRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.core.viewmodel.ModelBillNoticeItem
                android:id="@+id/adNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.transsnet.adsdk.widgets.banner.BannerAdView
                android:id="@+id/adBanner"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:ad_rounded_corners="@dimen/dp8"
                app:layout_constraintTop_toBottomOf="@+id/adNotice"
                app:layout_goneMarginTop="@dimen/dp12"
                app:slot_id="@string/betting_home_page_banner_slot_id"/>
            <com.transsnet.palmpay.core.viewmodel.ModelAvailableCouponItem
                android:id="@+id/availCoupons"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/adBanner"
                app:layout_goneMarginTop="@dimen/dp12"/>
            <View
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/space_body_2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/space_body_1"/>
            <Space
                android:id="@+id/space_body_1"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp12"
                app:layout_constraintBottom_toTopOf="@+id/inputBiller"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <Space
                android:id="@+id/space_body_2"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp8"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_save_to_beneficiary"/>
            <com.transsnet.palmpay.custom_view.ModelItemSelection
                android:id="@+id/inputBiller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp28"
                android:layout_marginStart="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp28"
                app:cv_item_selection_start_icon="@drawable/cv_palmpay_logo_6"
                app:cv_item_selection_start_icon_size="@dimen/dp20"
                app:cv_item_selection_start_icon_visible="true"
                app:cv_item_selection_title="@string/qt_biller"
                app:cv_item_selection_title_text_size="@dimen/dp12"
                app:cv_item_selection_value_text_size="@dimen/dp14"
                app:layout_constraintTop_toBottomOf="@+id/availCoupons"
                app:layout_goneMarginTop="@dimen/dp28"/>
            <com.transsnet.palmpay.custom_view.ModelItemSelection
                android:id="@+id/inputPaymentItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp28"
                app:cv_item_selection_hint="@string/qt_select_payment_item"
                app:cv_item_selection_title="@string/qt_payment_item"
                app:cv_item_selection_title_text_size="@dimen/dp12"
                app:cv_item_selection_value_text_size="@dimen/dp14"
                app:layout_constraintTop_toBottomOf="@+id/inputBiller"
                app:layout_goneMarginTop="@dimen/dp28"/>
            <TextView
                android:textSize="@dimen/dp10"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/qab_cashback_iv"
                android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp18"
                android:layout_marginTop="@dimen/dp2"
                android:paddingStart="@dimen/dp7"
                android:paddingEnd="@dimen/dp7"
                android:layout_marginStart="@dimen/dp90"
                app:layout_constraintStart_toStartOf="@+id/inputPaymentItem"
                app:layout_constraintTop_toTopOf="@+id/inputPaymentItem"/>
            <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
                android:id="@+id/model_input_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginStart="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp28"
                app:cv_hint="@string/qt_enter_account_number"
                app:cv_input_text_size="@dimen/dp14"
                app:cv_show_error_text="true"
                app:cv_title="@string/qt_water_customer_id"
                app:cv_title_visible="true"
                app:layout_constrainedHeight="true"
                app:layout_constraintTop_toBottomOf="@+id/inputPaymentItem"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_save_to_beneficiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginStart="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp28"
                app:layout_constraintTop_toBottomOf="@+id/model_input_customer">
                <com.mikepenz.iconics.view.IconicsCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/checkSaveToBeneficiaries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingEnd="4dp"
                    app:iiv_checked_color="@color/ppColorTextPrimary"
                    app:iiv_checked_icon="pay_Checkbox"
                    app:iiv_checked_size="@dimen/dp16"
                    app:iiv_unchecked_color="@color/ppColorTextAssist"
                    app:iiv_unchecked_icon="pay_CheckboxOutline"
                    app:iiv_unchecked_size="@dimen/dp16"/>
                <TextView
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qt_save_to_beneficiaries_tip"
                    style="@style/txt_mi_lg"/>
            </LinearLayout>
            <View
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/space_amount_2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/space_amount_1"/>
            <Space
                android:id="@+id/space_amount_1"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp12"
                app:layout_constraintBottom_toTopOf="@+id/editTextPayAmount"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <Space
                android:id="@+id/space_amount_2"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextPayAmount"/>
            <com.palmpay.lib.ui.edit.PpAmountEditText
                android:id="@+id/editTextPayAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp36"
                android:layout_marginStart="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp28"
                app:am_edit_hint="@string/core_enter_amount"
                app:am_edit_show_button="false"
                app:layout_constrainedHeight="true"
                app:layout_constraintTop_toBottomOf="@+id/ll_save_to_beneficiary"/>
            <com.palmpay.lib.ui.button.PpButton
                android:enabled="false"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewNext"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/ppButtonHeight"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp50"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="12dp"
                android:text="@string/core_next"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextPayAmount"
                app:layout_constraintVertical_bias="1"
                style="@style/ppButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
