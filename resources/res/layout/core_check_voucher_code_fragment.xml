<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.core.viewmodel.ModelPageTitleAreaInPayVerifyPage
        android:id="@+id/cmf_title_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cta_back_iv_iconfont="pay_Close"
        app:cta_content_text="@string/core_vodafone_voucher_desc"
        app:cta_title="@string/core_vodafone_voucher_text"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_lt_rt_8_bg_white"
        android:paddingTop="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp172">
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/cmf_mobile_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginTop="@dimen/dp30"
            android:layout_marginRight="@dimen/dp15"
            app:cv_te_inputType="number"
            app:cv_te_title="@string/core_voucher_code_text"/>
        <Button
            android:textSize="@dimen/dp18"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cmf_next_btn"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginLeft="@dimen/dp45"
            android:layout_marginTop="@dimen/dp30"
            android:layout_marginRight="@dimen/dp45"
            android:text="@string/core_next"
            android:textAllCaps="false"
            android:elevation="@dimen/dp5"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/voucher_guide_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/core_how_to_create_a_voucher"
        android:includeFontPadding="false"
        android:drawablePadding="5dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_InformationOutline"
        app:iiv_start_size="@dimen/dp14"/>
</RelativeLayout>
