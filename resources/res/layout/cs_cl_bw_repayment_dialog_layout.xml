<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cs_cl_bw_coupon_dialog_bg"
    android:paddingBottom="@dimen/dp12"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:paddingTop="@dimen/dp18"
            android:paddingBottom="@dimen/dp18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center"
                android:id="@+id/csTextview21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_repayment_details"
                android:fontFamily="sans-serif-medium"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="end"
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:iiv_color="@color/cs_cl_color_dialog_close"
                app:iiv_icon="pay_Close"
                app:iiv_size="@dimen/dp20"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_how_much_to_repay"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/repay_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bw_cl"
            android:background="@drawable/cv_shape_rect_corner_12_bg_white"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginStart="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp16">
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/csTextview96"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Principal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/principal_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview96"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/csTextview96"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/coupon_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_cl_borrow_coupon"
                android:drawablePadding="@dimen/dp4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview90"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/borrow_all_discount_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_cl_borrow_all_discount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/coupon_title_tv"/>
            <TextView
                android:id="@+id/borrow_all_discount_value_tv"
                android:background="@drawable/cv_shape_rect_corner_4_bg_warning"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_height="@dimen/dp18"
                android:paddingHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/borrow_all_discount_title_tv"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/borrow_all_discount_title_tv"
                style="@style/Text.ffffff.10"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/borrow_all_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="borrow_all_discount_title_tv,borrow_all_discount_value_tv"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cs_cl_bw_use_coupon_txt_color"
                android:id="@+id/coupon_content_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp2"
                android:drawableEnd="@drawable/cs_select_arrow_right"
                app:layout_constraintBottom_toBottomOf="@+id/coupon_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/coupon_title_tv"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/coupon_group"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="coupon_title_tv,coupon_content_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/service_fee_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_cl_service_fee"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/csTextview96"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/service_fee_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp7"
                app:layout_constraintBottom_toBottomOf="@+id/service_fee_title_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/service_fee_title_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/csTextview90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cs_cl_borrow_daily_interest"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/service_fee_title_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/bw_daily_interest_rate_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp7"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview90"
                app:layout_constraintEnd_toStartOf="@+id/interest_tips_img"
                app:layout_constraintTop_toTopOf="@+id/csTextview90"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/origin_interest_rate_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview90"
                app:layout_constraintEnd_toStartOf="@+id/bw_daily_interest_rate_tv"
                app:layout_constraintTop_toTopOf="@+id/csTextview90"
                app:layout_constraintVertical_bias="0"/>
            <ImageView
                android:id="@+id/interest_tips_img"
                android:layout_width="@dimen/dp14"
                android:layout_height="@dimen/dp14"
                android:src="@drawable/cs_cl_daily_interest_faq_icon"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/csTextview90"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#858a8f"
                android:id="@+id/csTextview93"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_cl_bw_Days"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/borrow_all_discount_title_tv"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/bw_all_interest_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview93"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/csTextview93"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/origin_total_interest_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview93"
                app:layout_constraintEnd_toStartOf="@+id/bw_all_interest_amount_tv"
                app:layout_constraintTop_toTopOf="@+id/csTextview93"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/repayment_plan_divider_view"
            android:background="@color/ppColorDividerLine"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/repayment_plan_rv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:id="@+id/confirm_bt"
            android:background="@drawable/cs_cl_bw_next_bt_bg"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/core_confirm"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
</ScrollView>
