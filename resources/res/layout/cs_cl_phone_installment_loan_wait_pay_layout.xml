<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_bill_top"
        android:background="@drawable/cv_shape_rect_corner_20_bg_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp6"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"
        android:layout_marginHorizontal="@dimen/dp10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutRepayOnTimeBanner"
            android:background="#e4f7f0"
            android:paddingLeft="@dimen/dp12"
            android:paddingTop="@dimen/dp8"
            android:paddingRight="@dimen/dp12"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp4"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_Security"
                app:iiv_size="@dimen/dp12"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_mi_repay_on_time_banner"
                style="@style/Text.202046.12"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDeviceInfo"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingTop="@dimen/dp9"
        android:paddingBottom="@dimen/dp32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp11"
        android:layout_marginRight="@dimen/dp16"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutDeviceActiveTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/tvMobilePriceLabel"
                    android:text="@string/cs_mi_mobile_price_label"
                    style="@style/Text.6f7b85.12"/>
                <ImageView
                    android:id="@+id/ivBrand"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvBrand"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvBrand"/>
                <TextView
                    android:id="@+id/tvBrand"
                    android:background="@drawable/cs_corner_16_bg_null_c0c3c8"
                    android:paddingLeft="@dimen/dp8"
                    android:paddingTop="@dimen/dp4"
                    android:paddingRight="@dimen/dp8"
                    android:paddingBottom="@dimen/dp4"
                    android:layout_marginStart="@dimen/dp8"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp4"
                    app:layout_constraintStart_toEndOf="@+id/ivBrand"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/Text.6f7b85.10"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:id="@+id/tvPriceAmount"
                android:layout_marginTop="@dimen/dp_4"
                style="@style/Text.202046.16"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivBrandIcon"
            android:layout_width="30dp"
            android:layout_height="52dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMobileInstallment"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="0dp"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="-23dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:id="@+id/tvDownPaymentTitle"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/cs_cl_down_payment"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <TextView
            android:textSize="@dimen/cs_mi_down_payment_highlight_text_size"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvDownPaymentAmount"
            android:layout_marginTop="@dimen/dp8"
            android:fontFamily="@font/lib_ui_palmpaynum_bold_ttf"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDownPaymentTitle"
            style="@style/Text.medium.202046.26"/>
        <TextView
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/btnConfirmPay"
            android:background="@drawable/lib_ui_button_bg_corner_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp2"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginRight="@dimen/dp2"
            android:text="@string/cs_cl_confirm_and_pay"
            android:layout_marginHorizontal="@dimen/dp2"
            app:layout_constraintTop_toBottomOf="@+id/tvDownPaymentAmount"
            style="@style/Text.medium.ffffff.16"/>
        <TextView
            android:textColor="@color/cs_main_color"
            android:id="@+id/tvContactAgent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConfirmPay"
            style="@style/Text.6306b2.12"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/clTotalOutstanding"
            android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp15"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tvContactAgent">
            <TextView
                android:id="@+id/tvTotalOutstandingTitle"
                android:layout_height="34dp"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/cs_total_outstanding"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.12"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/cs_main_color"
                android:gravity="center"
                android:id="@+id/tvTotalOutstandingAmount"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTotalOutstandingTitle"
                style="@style/txt_number_s_b_b"/>
            <View
                android:id="@+id/viewDivider"
                android:background="@drawable/dash_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintTop_toBottomOf="@+id/tvTotalOutstandingTitle"/>
            <TextView
                android:id="@+id/tvRepaymentTotalTerms"
                android:paddingBottom="4dp"
                android:layout_marginTop="@dimen/dp12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewDivider"
                style="@style/Text.6f7b85.10"/>
            <com.transsnet.palmpay.credit.view.InnerRecyclerView
                android:scrollbarStyle="insideInset"
                android:id="@+id/rvRepaymentPlan"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:fadeScrollbars="false"
                app:layout_constraintTop_toBottomOf="@+id/tvRepaymentTotalTerms"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_bill_bottow"
        android:background="@drawable/cs_bg_home_bill_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"/>
</LinearLayout>
