<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewLine1"
        android:background="@color/ppColorDividerLine"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/tvCbn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/main_msg_security_1"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/main_icon_cbn"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tvNidc"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewLine1"
        style="@style/txt_s_g"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/tvNidc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/main_msg_security_2"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/cv_ndic_icon"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvCbn"
        app:layout_constraintTop_toBottomOf="@+id/viewLine1"
        style="@style/txt_s_g"/>
    <View
        android:id="@+id/viewLine2"
        android:background="@color/ppColorDividerLine"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvCbn"/>
    <TextView
        android:textColor="#c0c3c8"
        android:gravity="center_vertical"
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewLine2"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
