<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@+id/viewNotice"
                android:background="@color/ppColorSecondary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/cv_notify_icon"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/dp12"
                app:slot_id="@string/ad_withdraw_to_agent_text_slot_id"/>
            <com.transsnet.palmpay.core.viewmodel.ModelWithdrawBankaccountItem
                android:id="@+id/ci_bank_account_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/ci_add_bank_account"
                android:visibility="gone"
                layout="@layout/ci_layout_add_bank_account"/>
            <View
                android:background="@color/ppColorBackgroundDark"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_top_corner_white_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-16dp">
                <TextView
                    android:id="@+id/tvAmountTitle"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6f7b85.12"/>
                <TextView
                    android:id="@+id/tvAmountUnit"
                    android:layout_height="@dimen/dp32"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAmountTitle"
                    style="@style/Text.202046.16"/>
                <com.transsnet.palmpay.custom_view.StateAmountEditText
                    android:textColorHint="@color/ppColorTextDisable"
                    android:gravity="center"
                    android:id="@+id/etAmount"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:lines="1"
                    android:maxLength="10"
                    android:inputType="numberDecimal"
                    android:textCursorDrawable="@drawable/cv_editor_cursor_purple"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAmountUnit"
                    app:layout_constraintLeft_toRightOf="@+id/tvAmountUnit"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvAmountUnit"
                    style="@style/Text.202046.16"/>
                <View
                    android:id="@+id/viewDivider"
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp24"
                    app:layout_constraintTop_toBottomOf="@+id/tvAmountUnit"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tvTips"
                    android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                    android:paddingLeft="@dimen/dp12"
                    android:paddingTop="@dimen/dp8"
                    android:paddingRight="@dimen/dp12"
                    android:paddingBottom="@dimen/dp8"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    android:paddingHorizontal="@dimen/dp12"
                    android:paddingVertical="@dimen/dp8"
                    app:layout_constraintTop_toBottomOf="@+id/viewDivider"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:id="@+id/balance_tv"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTips"
                    style="@style/Text.9ca2aa.12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMoneyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp14"
                    android:layout_marginRight="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/balance_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.core.ui.widget.DigitalKeyboardView
        android:id="@+id/keyboard_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
