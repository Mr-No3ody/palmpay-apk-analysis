<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp14"
        android:gravity="center_vertical"
        android:id="@+id/tvMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoContainer"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMsg">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_PositionFill"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutAddressRows"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel1Label"
                    android:layout_width="@dimen/dp56"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_address_level1_name"
                    android:includeFontPadding="false"
                    style="@style/txt_s_g"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp12"
                    style="@style/txt_s_b_b"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel2Label"
                    android:layout_width="@dimen/dp56"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_address_level2_name"
                    android:includeFontPadding="false"
                    style="@style/txt_s_g"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp12"
                    style="@style/txt_s_b_b"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel3Label"
                    android:layout_width="@dimen/dp56"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_address_level3_name"
                    android:includeFontPadding="false"
                    style="@style/txt_s_g"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLevel3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp12"
                    style="@style/txt_s_b_b"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddressLabel"
                    android:layout_width="@dimen/dp56"
                    android:layout_height="wrap_content"
                    android:text="@string/ac_address"
                    android:includeFontPadding="false"
                    style="@style/txt_s_g"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp12"
                    style="@style/txt_s_b_b"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
