<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tv_step_1"
        android:background="@drawable/lib_liveness_step_shape"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
    <View
        android:id="@+id/tv_step_1_line"
        android:background="@color/face_step_line_unchecked_color"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginHorizontal="4dp"/>
    <ImageView
        android:id="@+id/tv_step_2"
        android:background="@drawable/lib_liveness_step_shape"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
    <View
        android:id="@+id/tv_step_2_line"
        android:background="@color/face_step_line_unchecked_color"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginHorizontal="4dp"/>
    <ImageView
        android:id="@+id/tv_step_3"
        android:background="@drawable/lib_liveness_step_shape"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
    <View
        android:id="@+id/tv_step_3_line"
        android:background="@color/face_step_line_unchecked_color"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginHorizontal="4dp"/>
    <ImageView
        android:id="@+id/tv_step_4"
        android:background="@drawable/lib_liveness_step_shape"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</LinearLayout>
