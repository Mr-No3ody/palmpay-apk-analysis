<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sm_ic_bg_pay_me_account"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="@dimen/dp250"
    android:layout_height="367dp"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/sm_ic_bg_pay_me_account_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/dp22"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:paddingTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp53"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:text="@string/sm_palmpay_text"
            android:layout_marginHorizontal="@dimen/dp10"
            style="@style/txt_b_b_b"/>
        <TextView
            android:textSize="@dimen/dp24"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tv_account"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp53"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginHorizontal="@dimen/dp10"
            style="@style/txt_b_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tv_name"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp53"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginHorizontal="@dimen/dp10"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
</FrameLayout>
