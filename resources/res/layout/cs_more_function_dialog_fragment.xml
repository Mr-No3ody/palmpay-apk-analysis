<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp180"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp12"
        android:src="@drawable/cs_icon_triangle"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-0.5dp"
        android:divider="@drawable/cs_shape_more_function_divider"
        android:showDividers="middle"
        android:dividerPadding="@dimen/dp12">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:src="@drawable/cs_loan_records_icon"/>
            <TextView
                android:id="@+id/tvLoanRecords"
                android:layout_marginLeft="@dimen/dp2"
                android:text="@string/cs_cl_loan_records"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:src="@drawable/cs_repayment_records_icon"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvRepaymentRecords"
                android:layout_marginLeft="@dimen/dp2"
                android:text="@string/cs_cl_repayment_records"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:src="@drawable/cs_coupon_icon"/>
            <TextView
                android:id="@+id/tvCoupons"
                android:layout_marginLeft="@dimen/dp2"
                android:text="@string/cv_coupons"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50">
            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:src="@drawable/cs_cl_loan_agreement_icon"/>
            <TextView
                android:id="@+id/tvLoanAgreement"
                android:layout_marginLeft="@dimen/dp2"
                android:text="@string/cs_loan_agreement"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
