<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.image.RoundImageView
        android:id="@+id/ivItemBg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp90"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:cvRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvDesc"
        app:layout_constraintEnd_toStartOf="@+id/tvLabel"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        style="@style/txt_s_b_b"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/main_color_home_text_label"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp4"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:rtv_background_color="@color/ppColorSuccess"
        app:rtv_corner_radius="@dimen/dp4"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/btnRight"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/dp55"
        android:layout_marginStart="@dimen/extra_margin"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:loading_size="8dp"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <View
        android:id="@+id/btnRightClick"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnRight"
        app:layout_constraintStart_toStartOf="@+id/btnRight"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
