<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_view"
        android:background="#ffffff"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/back_bt"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginStart="5dp"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_ArrowLeft"
            app:iiv_size="24dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/ct_contact_search_bg"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1">
            <EditText
                android:textSize="14dp"
                android:textColor="#ff263138"
                android:textColorHint="#ff6f7b85"
                android:id="@+id/editSearch"
                android:background="@null"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/ct_mobile_number"
                android:maxLines="1"
                android:maxLength="11"
                android:layout_weight="1"
                android:inputType="number"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDelete"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="24dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/search_btn"
        android:layout_below="@+id/title_view">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/scan_qr_code_view"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="15dp"
                android:paddingRight="19dp"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Scan"
                    app:iiv_size="24dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#ff272a2d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/ct_scan_personal_qr_code"
                    android:layout_weight="1"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="16dp"/>
            </LinearLayout>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/add_local_contacts_view"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="15dp"
                android:paddingRight="19dp"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Addressbook"
                    app:iiv_size="24dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#ff272a2d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/ct_add_local_contacts"
                    android:layout_weight="1"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="16dp"/>
            </LinearLayout>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp10">
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ff263138"
                    android:id="@+id/caca_name_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ff6f7b85"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/receive_money_remark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:text="@string/ct_scan_desc"
                    android:maxLines="1"/>
                <ImageView
                    android:id="@+id/caca_qrcode"
                    android:layout_width="@dimen/dp160"
                    android:layout_height="@dimen/dp160"
                    android:layout_marginTop="22dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp40"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/cv_palmpay_text_and_logo"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffc1ccd5"
                    android:id="@+id/copy_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:text="@string/ct_palmpay_provided_by_transsnet"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ViewStub
        android:orientation="vertical"
        android:id="@+id/no_search_result_stub"
        android:layout="@layout/ct_no_search_result_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/search_btn"
        android:layout_below="@+id/title_view"/>
    <Button
        android:textSize="18dp"
        android:textColor="#ffffffff"
        android:id="@+id/search_btn"
        android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ct_search"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"/>
</RelativeLayout>
