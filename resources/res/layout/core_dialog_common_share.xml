<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/dcm_close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp10"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp10"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp32"
            android:text="@string/core_oops"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-black"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/dcm_iv_qr_code"
        android:layout_width="@dimen/dp120"
        android:layout_height="@dimen/dp120"
        android:layout_marginTop="@dimen/dp12"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextDisable"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp18"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_qr_code_dialog_desc"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/dcm_down_qr_code"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_margin="@dimen/dp24"
        android:text="@string/core_download_qr_code"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
