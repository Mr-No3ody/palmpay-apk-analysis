<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_bg_root"
        android:background="@drawable/cv_shape_rect_top_corner_white_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp36"
        app:layout_constraintBottom_toBottomOf="@+id/view_bottom_barrir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_order_result_logo"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:layout_marginTop="@dimen/dp20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_order_result_title"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_order_result_logo"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginTop="@dimen/dp48"
        style="@style/txt_s_b"/>
    <TextView
        android:textSize="@dimen/dp32"
        android:gravity="center"
        android:id="@+id/tv_order_result_amount"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_result_title"
        app:layout_goneMarginTop="@dimen/dp48"
        style="@style/txt_bb_b_b"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_order_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_result_amount">
        <ImageView
            android:id="@+id/iv_order_status_logo"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"/>
        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp5"
            style="@style/txt_mi_g"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_order_status_arrow"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvViewDetail"
        android:background="@drawable/cv_round_corner_stroke_purple_6306b2"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_order_status"
        style="@style/Text.6306b2.14"/>
    <TextView
        android:textColor="@color/ppColorTextDisable"
        android:gravity="center"
        android:id="@+id/tv_order_result_status_tips"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvViewDetail"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_mi_g"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv_order_pending_ac_tips"
        android:paddingLeft="@dimen/dp24"
        android:paddingRight="@dimen/dp24"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_result_status_tips"
        style="@style/txt_mi_g"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_order_pending_ac"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:minHeight="@dimen/dp40"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_pending_ac_tips">
        <TextView
            android:id="@+id/tv_order_pending_ac_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp5"
            style="@style/txt_mi_g"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_order_pending_ac_question_btn"
            android:background="@drawable/cv_shape_rect_corner_8_bg_primary"
            android:paddingLeft="@dimen/dp6"
            android:paddingTop="@dimen/dp3"
            android:paddingRight="@dimen/dp6"
            android:paddingBottom="@dimen/dp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_claim"
            android:layout_marginStart="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp6"
            android:paddingVertical="@dimen/dp3"
            style="@style/txt_mi_w"/>
    </LinearLayout>
    <View
        android:id="@+id/view_bottom_barrir"
        android:layout_width="1dp"
        android:layout_height="12dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_order_pending_ac"/>
</merge>
