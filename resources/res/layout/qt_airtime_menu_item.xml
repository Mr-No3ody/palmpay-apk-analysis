<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:padding="@dimen/dp12"
    android:layout_width="@dimen/dp140"
    android:layout_height="@dimen/dp140">
    <ImageView
        android:id="@+id/ami_menu_iv"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/cv_icon_refresh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/ami_menu_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ami_menu_iv"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/ami_desc_tv"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp32"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.3"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ami_menu_tv"
        app:layout_constraintVertical_bias="1"
        style="@style/Text.6f7b85.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
