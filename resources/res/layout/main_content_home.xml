<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp56"
        app:layout_constraintTop_toBottomOf="@+id/statusView">
        <ViewStub
            android:id="@+id/ch_top_bar"
            android:layout="@layout/main_home_page_top_bar"
            android:inflatedId="@+id/ch_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_home_top_bar_height"/>
    </FrameLayout>
    <com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarContainer">
        <com.transsnet.palmpay.ui.view.HomeScrollView
            android:id="@+id/ch_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/viewContainer"
                android:paddingBottom="@dimen/main_home_fragment_bottom_margin"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTopAdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    app:layout="@layout/main_layout_home_top_text_ad"
                    app:mode="0"/>
                <ViewStub
                    android:id="@+id/unVerifyUserStub"
                    android:visibility="gone"
                    android:layout="@layout/main_layout_unverify_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/accountNoBarStub"
                    android:visibility="gone"
                    android:layout="@layout/main_layout_home_account_no_bar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTopAccountBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/main_layout_home_account_bar"
                    app:mode="2"/>
                <ViewStub
                    android:id="@+id/asyncGuestTopAd"
                    android:visibility="gone"
                    android:layout="@layout/main_home_guest_top_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTopFunction"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/main_layout_home_top_function"
                    app:mode="1"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncTransactionHistory"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout="@layout/main_home_page_transaction_history_bar"
                    app:mode="2"/>
                <ViewStub
                    android:id="@+id/taskCenterViewStub"
                    android:layout="@layout/main_home_page_tasks_center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <FrameLayout
                    android:id="@+id/viewMessageHolder"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <ImageView
                        android:id="@+id/ivMessageHolder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"/>
                    <ViewStub
                        android:id="@+id/messageStub"
                        android:layout="@layout/main_layout_home_message_holder"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"/>
                </FrameLayout>
                <ViewStub
                    android:id="@+id/exclusiveViewStub"
                    android:layout="@layout/main_home_page_exclusive_new_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/welcomeBackView"
                    android:layout="@layout/main_home_page_welcome_back_user"
                    android:inflatedId="@+id/welcomeBackView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/funListContainerStub"
                    android:layout="@layout/main_layout_home_menus"
                    android:inflatedId="@+id/funListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/funListContainerV2Stub"
                    android:layout="@layout/main_layout_home_menus_v2"
                    android:inflatedId="@+id/funListContainerV2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/rewardTasksViewStub"
                    android:layout="@layout/main_home_page_reward_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/rewardsViewStub"
                    android:layout="@layout/main_home_page_rewards_center"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp90"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/wealthViewStub"
                    android:layout="@layout/main_home_page_wealth"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/middleAdStub"
                    android:layout="@layout/main_layout_home_middle_banner_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/asyncBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/main_home_fragment_vertical_margin"
                    app:layout="@layout/main_layout_home_banner_ad"
                    app:mode="2"/>
                <ViewStub
                    android:id="@+id/bottomViewStub"
                    android:layout="@layout/main_layout_home_tab_bottom_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
            </LinearLayout>
        </com.transsnet.palmpay.ui.view.HomeScrollView>
    </com.transsnet.palmpay.custom_view.swipe.VerticalSwipeRefreshLayout>
    <ViewStub
        android:id="@+id/viewNotNetworkStub"
        android:layout="@layout/main_layout_not_network_home_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarContainer"/>
    <ViewStub
        android:id="@+id/ch_signup_login_text_area_stub"
        android:layout="@layout/main_item_signup_login_suspension_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ViewStub
        android:layout_gravity="end|bottom"
        android:id="@+id/dragViewStub"
        android:layout="@layout/main_layout_home_tab_drag_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp5"
        android:layout_marginBottom="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
