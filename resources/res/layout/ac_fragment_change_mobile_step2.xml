<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/ac_change_mobile_number"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_current_mobile_number"
            style="@style/txt_mi_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_me_b_b"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="@dimen/dp12"
        app:cardElevation="0dp"
        app:contentPaddingTop="@dimen/dp12">
        <com.palmpay.lib.ui.form.PpFormVertical
            android:id="@+id/editMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:form_edit_input_type="number"
            app:form_edit_max_length="11"
            app:form_hide_text="@string/ac_msg_phone_hint"
            app:form_label_text="@string/ac_enter_your_new_mobile_number"/>
    </androidx.cardview.widget.CardView>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Change"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/ppButtonStyle"/>
</LinearLayout>
