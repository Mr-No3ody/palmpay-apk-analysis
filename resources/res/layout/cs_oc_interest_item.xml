<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/dp11"
        android:paddingBottom="@dimen/dp11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp22"
        android:paddingEnd="@dimen/dp22">
        <TextView
            android:textSize="12sp"
            android:textColor="#636262"
            android:id="@+id/amount_tv"
            android:layout_width="@dimen/dp115"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_oc_interest_arrow"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#636262"
            android:gravity="end"
            android:id="@+id/interest_tv"
            android:layout_width="@dimen/dp50"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_view"
        android:background="#cacaca"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
