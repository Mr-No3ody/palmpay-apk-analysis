<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <TextView
        android:textSize="24dp"
        android:gravity="center_vertical"
        android:id="@+id/tvLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/ac_enter_your_address"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvSubtitle"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/tvLine1"
        style="@style/txt_s_g"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/adView"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        app:layout_goneMarginBottom="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp16"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <com.palmpay.lib.ui.form.PpFormVertical
                android:id="@+id/inputAddressLevel1"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level1_name"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:enabled="false"
                android:id="@+id/inputAddressLevel2"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingTop="12dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:fontFamily="sans-serif-medium"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level2_name"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:enabled="false"
                android:id="@+id/inputAddressLevel3"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingTop="12dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:fontFamily="sans-serif-medium"
                app:form_edit_enable="false"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_please_select"
                app:form_label_text="@string/ac_address_level3_name"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:id="@+id/inputStreet"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:paddingTop="12dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:fontFamily="sans-serif-medium"
                app:form_edit_input_type="text"
                app:form_hide_text="@string/ac_street_address_hint"
                app:form_label_text="@string/ac_street_address"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="center_vertical"
                android:id="@+id/tvAddressError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/txt_mi_g"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/textViewConfirm"
        app:slot_id="C2E1513B50054D898B9950EB72C67862"/>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/textViewConfirm"
        android:layout_width="match_parent"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="12dp"
        android:text="@string/core_next"
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_goneMarginBottom="@dimen/dp12"
        style="@style/ppButtonStyle"/>
    <include
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/cv_layout_login_register_bottom_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
