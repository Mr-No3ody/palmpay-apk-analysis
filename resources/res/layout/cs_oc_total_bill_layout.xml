<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_color_total_bill_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/protocol_mtb"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/cs_oc_total_repayment_title"
        app:title_bar_title_color="@color/ppColorTextPrimary"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/marqueeView"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/dp12"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="@dimen/dp12"
                android:paddingBottom="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp12"
                android:paddingVertical="@dimen/dp8">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextPrimary"
                    app:iiv_icon="pay_Notification"
                    app:iiv_size="24dp"/>
                <com.transsnet.palmpay.custom_view.marqueeview.MarqueeView
                    android:id="@+id/marquee"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp8"
                    app:mvGravity="left"
                    app:mvShowIconImg="false"
                    app:mvSingleLine="true"
                    app:mvTextColor="@color/ppColorTextPrimary"
                    app:mvTextSize="@dimen/dp14"/>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/total_bill_top_sad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/oc_total_bill_top_slot_id"/>
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview141"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp16"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/cs_oc_auto_repayment_warn"
                android:paddingStart="@dimen/dp8"
                android:paddingEnd="@dimen/dp8"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/oc_bill_title_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_flexi"
                    android:drawablePadding="@dimen/dp8"
                    android:drawableStart="@drawable/cs_oc_flexi_logo_small"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="end"
                    android:id="@+id/oc_total_outstanding_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_total_outstanding"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/cs_oc_total_outstanding_right_arrow"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutBillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.transsnet.palmpay.credit.ui.viewmodel.AvailableCouponItem
                    android:id="@+id/itemAvailableCoupon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:transTypes="g7"/>
                <Space
                    android:id="@+id/space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/itemAvailableCoupon"
                    app:layout_goneMarginBottom="0dp"/>
                <com.transsnet.palmpay.credit.view.OcCommonBillCard
                    android:id="@+id/oc_bill_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/space"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cl_bill_title_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_flexi_cash"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/cs_oc_flexi_cash_logo_small"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="end"
                    android:id="@+id/cl_total_outstanding_tv"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_total_outstanding"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/cs_oc_total_outstanding_right_arrow"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutCashBillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.transsnet.palmpay.credit.ui.viewmodel.AvailableCouponItem
                    android:id="@+id/itemAvailableCashCoupon"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:transTypes="j7"/>
                <Space
                    android:id="@+id/spaceCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/itemAvailableCashCoupon"
                    app:layout_goneMarginBottom="0dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutFlexiCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/cs_cl_dash_line_icon"
                    android:showDividers="middle"
                    android:dividerPadding="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/spaceCash">
                    <com.transsnet.palmpay.credit.view.OcCommonBillCard
                        android:id="@+id/installment_bill_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.transsnet.palmpay.credit.view.OcCommonBillCard
                        android:id="@+id/cash_bill_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/total_bill_mid_sad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:slot_id="@string/oc_total_bill_middle_slot_id"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/export_more_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_oc_explore_more"
                    android:layout_marginStart="@dimen/dp12"
                    android:layout_marginEnd="@dimen/dp12"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/total_bill_bottom_sad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"
                app:slot_id="@string/oc_total_bill_first_slot_id"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bottom_ad_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/total_bill_bottom_left_sad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp5"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp8"
                    app:slot_id="@string/oc_total_bill_second_slot_id"/>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/total_bill_bottom_right_sad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp8"
                    app:slot_id="@string/oc_total_bill_third_slot_id"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp20"
                android:text="@string/cs_cl_powered_by_rockit_lenders"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
