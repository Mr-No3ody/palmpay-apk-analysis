<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/cv_ok_card_icon"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorFlexiPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_palmpay_oc"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:paddingEnd="@dimen/dp86"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/tvAmount"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp86"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/viewContainer"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_b"/>
    <com.transsnet.palmpay.custom_view.viewholder.LabelLayout
        android:id="@+id/viewContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginBottom="@dimen/dp12"
        android:paddingEnd="@dimen/dp87"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvApply"
        android:background="@drawable/cv_shape_halfround_purple"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp30"
        android:text="@string/core_use_now"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_w"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorFlexiPrimary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvMessage"
        android:background="@drawable/cv_shape_rect_corner_left_rt_12_bg_blue"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
