<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp16">
    <ImageView
        android:id="@+id/imageViewAvatar"
        android:layout_width="@dimen/dp35"
        android:layout_height="@dimen/dp35"
        android:layout_marginRight="10dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/textViewBalanceAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        android:layout_below="@+id/tvAmount"
        android:layout_alignParentRight="true"
        android:layout_marginStart="@dimen/dp5"
        android:layout_alignParentEnd="true"
        style="@style/txt_b_b"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/ll_amount"
        android:layout_toRightOf="@+id/imageViewAvatar"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/ll_amount"
        android:layout_toEndOf="@+id/imageViewAvatar">
        <TextView
            android:id="@+id/tvTitle"
            android:paddingTop="@dimen/dp17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_alignParentTop="true"
            style="@style/txt_s_b"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvBooked"
            android:background="@drawable/cv_shape_rect_corner_4_bg_086306b2_stroke_primary"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp16"
            android:text="@string/cv_book"
            android:layout_marginStart="@dimen/dp6"
            android:layout_toEndOf="@+id/mbri_title_tv"
            android:paddingHorizontal="@dimen/dp4"
            style="@style/txt_mi_g"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/imageViewAvatar"
        android:layout_below="@+id/layout_title"
        android:layout_toEndOf="@+id/imageViewAvatar"
        style="@style/txt_mi_lgn"/>
    <View
        android:id="@+id/tvLine3"
        android:layout_marginTop="@dimen/dp16"
        android:layout_below="@+id/tvDate"
        style="@style/core_divider_horizontal"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp18"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/dp5"
            android:layout_alignParentEnd="true"
            style="@style/txt_b_b_b"/>
        <TextView
            android:id="@+id/tvState"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_mi_g"/>
    </LinearLayout>
</RelativeLayout>
