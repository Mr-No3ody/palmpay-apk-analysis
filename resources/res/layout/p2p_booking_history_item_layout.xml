<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ppColorBackgroundLight"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/p2p_base"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_miss_symbol"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginLeft="12dp"
            app:cardBackgroundColor="#fe5455"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:contentPaddingTop="2dp"
            app:layout_constraintBottom_toTopOf="@+id/p2p_base"
            app:layout_constraintLeft_toLeftOf="parent">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ppColorTextBase"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="@string/p2p_str_missed"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/p2p_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="19dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#858a8f"
            android:id="@+id/p2p_agent_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/p2p_time"/>
        <View
            android:id="@+id/p2p_base2"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/p2p_base3"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toTopOf="@+id/p2p_base2"
            app:layout_constraintLeft_toRightOf="@+id/p2p_base2"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_status"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            app:cardBackgroundColor="#14ffaa0c"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:contentPaddingLeft="4dp"
            app:contentPaddingRight="6dp"
            app:contentPaddingTop="2dp"
            app:layout_constraintRight_toLeftOf="@+id/p2p_base3"
            app:layout_constraintTop_toBottomOf="@+id/p2p_base3">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ppColorWarning"
                android:id="@+id/p2p_status_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="14sp"
            android:textColor="#4f4f4f"
            android:id="@+id/p2p_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/p2p_time"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/p2p_time"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PDashLine
            android:id="@+id/p2p_line"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/p2p_agent_name"
            app:p2p_dash_color="@color/ppColorDividerLine"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_change_label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            app:cardBackgroundColor="#fff8ec"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/p2p_line">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/p2p_i"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorWarning"
                    app:iiv_icon="pay_InformationOutline"
                    app:iiv_size="@dimen/dp16"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/p2p_str_order_amount_changed_by_the_exchange_point"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/p2p_booking_code"
            android:background="@color/ppColorBackgroundDark"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/p2p_change_label">
            <TextView
                android:textSize="12sp"
                android:textColor="#828282"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p2p_str_booking_code"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/p2p_booking_code_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_pay"
            android:visibility="gone"
            android:layout_width="57dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/p2p_theme_color"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/p2p_change_label">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextBase"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_pay"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
