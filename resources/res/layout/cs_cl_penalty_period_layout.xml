<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cs_common_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Upgrade Service"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:src="@drawable/cs_cl_premium_card_img"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/cl_penalty_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp36"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:id="@+id/cl_penalty_content_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:text="@string/cs_you_have_not_met_upgrading"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp60"
                android:src="@drawable/cs_cl_penalty_empty_img"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/cl_got_it_bt"
            android:background="@drawable/cs_oc_agree_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="@dimen/dp14"
            android:text="@string/core_got_it"
            android:textAllCaps="false"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/interest_amount_tv"/>
    </LinearLayout>
</LinearLayout>
