<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            layout="@layout/ac_layout_login_header"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/ac_set_pin"
            android:layout_marginStart="@dimen/dp20"
            style="@style/Text.medium.202046.24"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:text="@string/ac_set_your_pin_for_account_security"
            android:layout_marginHorizontal="@dimen/dp20"
            style="@style/txt_s_g"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:layout_marginStart="@dimen/dp20">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ac_set_pin"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivEyes"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp20"
                android:layout_marginStart="@dimen/dp8"
                app:iiv_color="@color/ppColorTextPrimary"
                app:iiv_icon="pay_Show"
                app:iiv_size="20dp"/>
        </LinearLayout>
        <com.transsnet.palmpay.custom_view.PinEntryView
            android:layout_gravity="start"
            android:id="@+id/pinView1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="@dimen/dp20"
            app:accentType="character"
            app:accentWidth="0dp"
            app:digitBackground="@color/ppColorBackgroundDark"
            app:digitHeight="@dimen/dp48"
            app:digitRadius="@dimen/dp8"
            app:digitSelectStrokeColor="@color/ppColorPrimary"
            app:digitSpacing="@dimen/dp12"
            app:digitStrokeColor="@color/ppColorBackgroundDark"
            app:digitStrokeWidth="@dimen/dp1"
            app:digitTextColor="@color/ppColorTextPrimary"
            app:digitTextSize="@dimen/dp24"
            app:digitWidth="@dimen/dp48"
            app:leftMargin="0dp"
            app:mask="●"
            app:pinInputType="number"
            app:showHideButton="false"/>
        <TextView
            android:textColor="@color/ppColorError"
            android:gravity="center_vertical"
            android:id="@+id/tvError1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginHorizontal="@dimen/dp20"
            style="@style/txt_mi_g"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/ac_re_enter_pin"
            android:layout_marginStart="@dimen/dp20"
            style="@style/txt_s_b"/>
        <com.transsnet.palmpay.custom_view.PinEntryView
            android:layout_gravity="start"
            android:id="@+id/pinView2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="@dimen/dp20"
            app:accentType="character"
            app:accentWidth="0dp"
            app:digitBackground="@color/ppColorBackgroundDark"
            app:digitHeight="@dimen/dp48"
            app:digitRadius="@dimen/dp8"
            app:digitSelectStrokeColor="@color/ppColorPrimary"
            app:digitSpacing="@dimen/dp12"
            app:digitStrokeColor="@color/ppColorBackgroundDark"
            app:digitStrokeWidth="@dimen/dp1"
            app:digitTextColor="@color/ppColorTextPrimary"
            app:digitTextSize="@dimen/dp24"
            app:digitWidth="@dimen/dp48"
            app:leftMargin="0dp"
            app:mask="●"
            app:pinInputType="number"
            app:showHideButton="false"/>
        <TextView
            android:textColor="@color/ppColorError"
            android:gravity="center_vertical"
            android:id="@+id/tvError2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginHorizontal="@dimen/dp20"
            style="@style/txt_mi_g"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginTop="16dp"
            android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin">
            <com.mikepenz.iconics.view.IconicsTextView
                android:textColor="@color/ppColorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="I have an invitation code"
                android:includeFontPadding="false"
                android:drawablePadding="4dp"
                android:layout_marginStart="16dp"
                app:iiv_start_color="@color/ppColorPrimary"
                app:iiv_start_icon="pay_RewardFill"
                app:iiv_start_size="@dimen/dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_gravity="bottom"
                android:id="@+id/ivShowInputInvitationCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Arrowdown"
                app:iiv_size="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvName"/>
            <com.palmpay.lib.ui.form.PpFormVertical
                android:id="@+id/inputInvitationCode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:form_edit_input_type="text"
                app:form_hide_text="Please enter an invitation code"
                app:form_label_text="@string/ac_invitation_code"
                app:form_layout_background="@color/transparent"
                app:layout_constraintTop_toBottomOf="@+id/tvName"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="inputInvitationCode, tvName"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15"
                android:text="What is an invitation Code?"
                android:drawablePadding="@dimen/dp6"
                android:drawableStart="@drawable/ac_icon_q"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrier"
                style="@style/txt_s_b"/>
            <ImageView
                android:id="@+id/ivAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:src="@drawable/ac_icon_a"
                android:scaleType="fitXY"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvQuestion"/>
            <TextView
                android:gravity="start|top"
                android:id="@+id/tvAnswer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Get an invitation code from your inviter. Enter this code during the registration process to get rewards"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp6"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivAnswer"
                app:layout_constraintTop_toBottomOf="@+id/tvQuestion"
                style="@style/txt_mi_g"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.palmpay.lib.ui.button.PpButton
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/ac_sign_up_horizontal_margin"
            android:layout_marginBottom="@dimen/dp20"
            android:text="@string/ac_next"
            android:layout_marginHorizontal="@dimen/ac_sign_up_horizontal_margin"
            style="@style/ppButtonStyle"/>
        <include layout="@layout/cv_layout_login_register_bottom_view"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/securityKeyBoard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_number_keyboard_layout"/>
</FrameLayout>
