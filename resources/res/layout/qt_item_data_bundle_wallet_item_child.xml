<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white_stroke_dark_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/item_ratio_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,154:166"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ppColorWarning"
        android:gravity="center"
        android:id="@+id/set_meal_promotion_tv"
        android:background="@drawable/cv_rect_bg_fff4e5_corner_tl_tr_12"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp14"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.10"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp18"
        android:gravity="center_vertical"
        android:id="@+id/data_bundle_size_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintBottom_toTopOf="@+id/data_bundle_description_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/set_meal_promotion_tv"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/data_bundle_description_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintBottom_toTopOf="@+id/ll_data_bundle_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_bundle_size_tv"
        style="@style/Text.6f7b85.10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_data_bundle_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        app:layout_constraintBottom_toTopOf="@+id/data_bundle_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_bundle_description_tv">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/data_bundle_name_iv"
            android:layout_width="@dimen/dp12"
            android:layout_height="@dimen/dp12"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_ScheduleOutline"
            app:iiv_size="@dimen/dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/ppColorPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/data_bundle_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/qt_data_bundle_recent_purchases"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/data_bundle_name_iv"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6306b2.10"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_bundle_bottom_panel"
        android:background="@drawable/cv_rect_corner_bl_br_12_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp54"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/amountTitle"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp20"
            android:text="@string/qt_data_bundle_price"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/amount_tv"
            app:layout_constraintEnd_toStartOf="@+id/validity_start_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Text.6f7b85.12"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp14"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/amount_tv"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp20"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/validity_start_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/amountTitle"
            style="@style/txt_s_b_b"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/validity_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:text="@string/qt_data_bundle_validity"
            app:layout_constraintBottom_toTopOf="@+id/data_bundle_date_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Text.6f7b85.12"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/data_bundle_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp20"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/validity_label_tv"
            style="@style/Text.medium.202046.14"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/validity_start_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="validity_label_tv,data_bundle_date_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
