<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp64">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="32dp"
        android:layout_height="32dp"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvContent"
        android:paddingLeft="@dimen/dp10"
        android:paddingRight="@dimen/dp4"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp64"
        android:text="@string/ci_find_more_nearby"
        style="@style/txt_s_b_b"/>
    <ImageView
        android:id="@+id/iv_tag"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:maxWidth="@dimen/dp60"
        android:maxHeight="@dimen/dp35"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp20"
        android:layout_weight="1"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp16"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"/>
</LinearLayout>
