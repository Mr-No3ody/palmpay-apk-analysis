<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sm_ic_confirm_transfer_info_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_close"
            android:padding="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorBackgroundLight"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_info"
            app:layout_constraintEnd_toEndOf="@+id/ll_info"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_info"
            android:background="@drawable/sm_ic_confirm_transfer_info_bg"
            android:paddingLeft="@dimen/dp24"
            android:paddingTop="@dimen/dp57"
            android:paddingRight="@dimen/dp24"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="328dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp57"
            android:paddingHorizontal="@dimen/dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_confirm_details"
                style="@style/Text.medium.202046.20"/>
            <TextView
                android:gravity="start"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/sm_confirm_details"
                style="@style/Text.202046.14"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_info_container"
                android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"/>
            <TextView
                android:textColor="@color/cv_color_ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/cv_button_bg_purple_corner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="@string/core_confirm"
                style="@style/txt_b_w"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
