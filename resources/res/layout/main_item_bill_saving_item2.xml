<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp47"
    android:layout_marginBottom="@dimen/dp10"
    android:layout_marginStart="@dimen/dp8"
    android:layout_marginEnd="@dimen/dp8">
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/btnUse"
        android:background="@drawable/cv_shape_round_corner_primary"
        android:layout_width="81dp"
        android:layout_height="@dimen/dp27"
        android:text="@string/core_use_now"
        android:drawablePadding="4dp"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        android:layout_marginEnd="@dimen/dp9"
        android:layout_alignParentEnd="true"
        app:iiv_end_color="@color/ppColorTextBase"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp16"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp10"
        android:text="@string/core_coupons"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_0"
        android:layout_toRightOf="@+id/tvTitle"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp10"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivIcon"
        android:padding="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/tvAmount"
        android:layout_centerVertical="true"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Question"
        app:iiv_size="16dp"/>
</RelativeLayout>
