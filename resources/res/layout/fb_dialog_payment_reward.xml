<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fb_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/fb_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/fb_dp20"
        android:textColor="@color/fb_text_color_black1"
        android:id="@+id/fb_cdpr_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp16"
        android:layout_marginTop="@dimen/fb_dp30"
        android:layout_marginRight="@dimen/fb_dp16"
        android:text="@string/fb_dont_miss_out"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/fb_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/fb_dp14"
        android:textColor="@color/fb_text_color_gray2"
        android:id="@+id/fb_cdpr_content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp40"
        android:layout_marginTop="@dimen/fb_dp15"
        android:layout_marginRight="@dimen/fb_dp40"
        android:text="@string/fb_try_again_to_pay"
        android:layout_marginHorizontal="@dimen/fb_dp40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_cdpr_title_tv"/>
    <ImageView
        android:id="@+id/fb_cdpr_iv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp15"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_cdpr_content_tv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/fb_contentBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="fb_cdpr_iv,fb_cdpr_content_tv"/>
    <TextView
        android:textSize="@dimen/fb_dp16"
        android:textColor="@color/fb_text_color_purple"
        android:gravity="center"
        android:id="@+id/fb_cdpr_cancel_tv"
        android:background="@drawable/fb_button_bg_light_purple_corner"
        android:layout_width="0dp"
        android:layout_height="@dimen/fb_default_button_height"
        android:layout_marginTop="23dp"
        android:text="@string/fb_leave"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/fb_dp24"
        android:layout_marginEnd="@dimen/fb_dp6"
        app:layout_constraintEnd_toStartOf="@+id/fb_cdpr_confirm_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fb_contentBarrier"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/fb_cdpr_confirm_tv"
        android:layout_width="0dp"
        android:layout_height="@dimen/fb_default_button_height"
        android:text="@string/fb_core_continue"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/fb_dp6"
        android:layout_marginEnd="@dimen/fb_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fb_cdpr_cancel_tv"
        app:layout_constraintTop_toTopOf="@+id/fb_cdpr_cancel_tv"
        style="@style/fbButtonStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/fb_tvReward"
        android:background="@drawable/fb_button_bg_yellow_corner_2"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fb_dp18"
        android:layout_marginBottom="35dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/fb_cdpr_confirm_tv"
        app:layout_constraintEnd_toEndOf="@+id/fb_cdpr_confirm_tv"
        style="@style/fb_txt_mi_w"/>
</androidx.constraintlayout.widget.ConstraintLayout>
