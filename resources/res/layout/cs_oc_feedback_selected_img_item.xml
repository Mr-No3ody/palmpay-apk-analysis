<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp60"
    android:layout_height="@dimen/dp60">
    <com.luck.picture.lib.widget.SquareRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/selected_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/csSelectedImageStyle"/>
    </com.luck.picture.lib.widget.SquareRelativeLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/delete_fl"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32">
        <ImageView
            android:layout_gravity="end"
            android:layout_width="@dimen/dp17"
            android:layout_height="@dimen/dp17"
            android:src="@drawable/cs_oc_delete_feedback_img_icon"/>
    </FrameLayout>
</FrameLayout>
