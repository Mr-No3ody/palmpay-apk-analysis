<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_shape_rect_bottom_corner_white_12"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:minHeight="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Loanable Amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_s_w"/>
    <TextView
        android:textSize="@dimen/dp44"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:text="₦500,000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_number_me_b_b"/>
    <ImageView
        android:id="@+id/ivGift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp32"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp32"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="@dimen/dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAmount"/>
    <TextView
        android:id="@+id/tvConfinementPeriodContent"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp32"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp32"
        android:layout_marginBottom="@dimen/dp60"
        android:layout_marginHorizontal="@dimen/dp32"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Text.202046.14"/>
    <TextView
        android:id="@+id/tvConfinementPeriodSubContent"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConfinementPeriodContent"
        style="@style/Text.202046.14"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCalendar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dp4"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tvReapplyDate"
        app:layout_constraintTop_toBottomOf="@+id/tvConfinementPeriodSubContent"/>
    <TextView
        android:textColor="@color/ppColorWarning"
        android:id="@+id/tvReapplyDate"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCalendar"
        app:layout_constraintLeft_toRightOf="@+id/ivCalendar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCalendar"
        style="@style/Text.medium.202046.20"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupConfinementPeriod"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvConfinementPeriodContent,tvConfinementPeriodSubContent,ivCalendar,tvReapplyDate"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layoutNormal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutReview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/layoutNormal">
        <com.palmpay.lib.ui.button.PpButton
            android:enabled="false"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/layoutReviewBtn"
            android:layout_width="match_parent"
            android:text="Calculating..."
            style="@style/ppButtonStyle"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutGetMoneyNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="open_flexi_tv,ivFinger"/>
    <TextView
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/open_flexi_tv"
        android:background="@drawable/cv_shape_halfround_purple_enable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_oc_get_money_now"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/ppColorTextPrimary"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/layoutNormal"
        style="@style/ppButtonStyle"/>
    <ImageView
        android:id="@+id/ivFinger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:src="@drawable/cv_finger2"
        android:layout_marginEnd="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="@+id/open_flexi_tv"
        app:layout_constraintTop_toTopOf="@+id/open_flexi_tv"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="open_flexi_tv,tvReapplyDate,layoutReview"/>
    <com.mikepenz.iconics.view.IconicsCheckBox
        android:id="@+id/checkAgreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:checked="true"
        app:iiv_checked_color="@color/cs_color_amount"
        app:iiv_checked_icon="pay_Checkbox"
        app:iiv_checked_size="16dp"
        app:iiv_unchecked_color="@color/cs_color_amount"
        app:iiv_unchecked_icon="pay_CheckboxOutline"
        app:iiv_unchecked_size="16dp"
        app:layout_constraintStart_toStartOf="@+id/open_flexi_tv"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvApplicationAgreement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="@+id/open_flexi_tv"
        app:layout_constraintStart_toEndOf="@+id/checkAgreement"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/Text.202046.12"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvApplicationAgreement, tvReapplyDate, ivFinger, tvReapplyDate, layoutReview, ivCalendar"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
