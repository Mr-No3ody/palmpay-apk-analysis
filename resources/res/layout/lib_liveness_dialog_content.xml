<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#6f7b85"
        android:gravity="center"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
        android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
        android:lineSpacingExtra="4dp"
        android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ppDialogHorizontalMargin"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/ppDialogHorizontalMargin"
        android:layout_marginHorizontal="@dimen/ppDialogHorizontalMargin">
        <include
            android:id="@+id/itemLeft"
            android:layout_width="136dp"
            android:layout_height="136dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/itemRight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/lib_liveness_item_avatar_action"/>
        <include
            android:id="@+id/itemRight"
            android:visibility="gone"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/itemLeft"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/lib_liveness_item_avatar_action"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
