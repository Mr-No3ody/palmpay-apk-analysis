<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_increase_amount_top_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/spaceTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp28"
        app:layout_constraintBottom_toBottomOf="@+id/ivTop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:background="@drawable/cs_cl_increase_amount_bg"
        android:paddingLeft="@dimen/dp24"
        android:paddingTop="@dimen/dp8"
        android:paddingRight="@dimen/dp24"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/spaceTop">
        <TextView
            android:id="@+id/tvLoanableAmountTitle"
            android:text="@string/cs_loan_amount"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.12"/>
        <TextView
            android:id="@+id/tvLoanableTermTitle"
            android:text="@string/cs_loan_term"
            app:layout_constraintLeft_toLeftOf="@+id/tvLoanableTerm"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.12"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:id="@+id/tvLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            app:layout_constraintLeft_toLeftOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textSize="@dimen/dp26"
            android:id="@+id/tvLoanableTerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp2"
            app:layout_constraintRight_toLeftOf="@+id/tvDays"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableTermTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvPeriodDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintStart_toStartOf="@+id/tvLoanableTerm"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableTerm"/>
        <TextView
            android:id="@+id/tvDays"
            android:layout_marginRight="@dimen/dp36"
            android:text="@string/tv_days"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvLoanableTerm"
            app:layout_constraintRight_toRightOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:id="@+id/tvDailyInterest"
            android:visibility="invisible"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textSize="@dimen/dp11"
            android:id="@+id/tvBorrowTips"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDailyInterest"
            style="@style/Text.6f7b85.12"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:id="@+id/rtvBorrowNow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_borrow_now"
            app:layout_constraintTop_toBottomOf="@+id/tvBorrowTips"
            app:rtv_background_color="@color/ppColorFlexiCashPrimary"
            app:rtv_corner_radius="@dimen/dp12"
            style="@style/Text.medium.ffffff.16"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="@color/cs_cl_main_color"
            android:gravity="center_vertical"
            android:id="@+id/tvLearnMoreDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Learn more about installment"
            android:drawablePadding="4dp"
            app:iiv_end_color="@color/cs_cl_main_color"
            app:iiv_end_icon="pay_ArrowCenterRight"
            app:iiv_end_size="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="@+id/rtvBorrowNow"
            app:layout_constraintStart_toStartOf="@+id/rtvBorrowNow"
            app:layout_constraintTop_toBottomOf="@+id/rtvBorrowNow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp2"
        app:layout_constraintBottom_toTopOf="@+id/layoutContent"/>
    <TextView
        android:textSize="@dimen/dp11"
        android:gravity="center"
        android:id="@+id/tvInstallments"
        android:background="@drawable/cs_cl_repay_installments_bg"
        android:paddingRight="@dimen/dp8"
        app:layout_constraintRight_toRightOf="@+id/layoutContent"
        app:layout_constraintTop_toBottomOf="@+id/space"
        style="@style/Text.medium.ffffff.10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
