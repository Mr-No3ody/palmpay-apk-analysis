<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cv_shape_rect_top_corner_white_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cv_detailed_status"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_close_grey"
        android:layout_alignParentRight="true"/>
    <com.transsnet.palmpay.send_money.ui.view.TransferToBankProgressModel
        android:id="@+id/v_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_close"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_status_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/v_progress"/>
</RelativeLayout>
