<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="right"
        android:padding="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/cidfuf_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/ci_have_you_complete_the_ussd_funding"
        android:fontFamily="sans-serif-black"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textSize="@dimen/dp16"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/ci_have_you_complete_the_ussd_funding_desc"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/cdfucl_no"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ci_view_detail"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:layout_width="@dimen/dp12"
            android:layout_height="@dimen/dp1"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/cdfucl_yes"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ci_dial_ussd"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
