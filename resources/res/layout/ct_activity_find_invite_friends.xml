<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ct_find_invite_friends_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="@dimen/dp30"
        app:title_bar_title="Find My Friends"
        app:title_bar_title_color="@color/ppColorTextBase"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_8_bg_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp16">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/ct_local_contacts"
            android:drawablePadding="6dp"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_Addressbook"
            app:iiv_start_size="@dimen/dp24"
            style="@style/txt_me_b_b"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/viewSearch"
            android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp14"
            android:layout_marginTop="@dimen/dp14"
            android:layout_marginRight="@dimen/dp14"
            android:transitionName="searchTransition"
            android:layout_marginHorizontal="@dimen/dp14">
            <EditText
                android:textSize="14dp"
                android:textColor="#ff263138"
                android:textColorHint="#ff6f7b85"
                android:gravity="center_vertical"
                android:id="@+id/editSearch"
                android:background="@null"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/ct_name_or_mobile_number"
                android:maxLines="1"
                android:maxLength="30"
                android:drawablePadding="@dimen/dp10"
                android:layout_weight="1"
                android:inputType="text"
                android:drawableStart="@drawable/ct_search_icon"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDelete"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="24dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/viewList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/viewInvite"
        android:background="@color/ppColorPrimary"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60">
        <com.mikepenz.iconics.view.IconicsTextView
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ct_share_to_invite"
            android:drawablePadding="@dimen/dp9"
            android:layout_centerInParent="true"
            app:iiv_start_color="@color/ppColorTextBase"
            app:iiv_start_icon="pay_Share"
            app:iiv_start_size="@dimen/dp30"
            style="@style/txt_me_b_b"/>
    </RelativeLayout>
</LinearLayout>
