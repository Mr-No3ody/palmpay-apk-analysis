<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorDividerLine"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fb_pin_kb_item_height"
        android:text="@string/fb_secure_input_mode_is_active"
        android:drawableLeft="@drawable/fb_security_icon"
        android:drawablePadding="4dp"
        style="@style/fb_txt_s_b"/>
    <com.flexibank.sdk.core.viewmodel.FlexiBankKeyboardGridLayout
        android:id="@+id/fb_number_keyboard_content"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="4"
        android:columnCount="3"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        app:columnCount="3"
        app:rowCount="4">
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_1"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_1"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_2"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_2"
            android:layout_columnSpan="1"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_3"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_3"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_4"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_4"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_5"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_5"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_6"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_6"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_7"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_7"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_8"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_8"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_9"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_9"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_0"
            android:background="@drawable/fb_pin_input_digit_selector_bg"
            android:layout_width="wrap_content"
            android:text="@string/fb_digit_0"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            style="@style/fb_pin_input_text_style"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="fill_horizontal"
            android:id="@+id/fb_digit_del"
            android:layout_width="wrap_content"
            android:scaleType="center"
            android:layout_columnWeight="1"
            app:layout_columnWeight="1"
            app:srcCompat="@drawable/fb_pin_input_delete_icon"
            app:tint="@color/ppColorTextPrimary"
            style="@style/fb_pin_input_text_style"/>
    </com.flexibank.sdk.core.viewmodel.FlexiBankKeyboardGridLayout>
</LinearLayout>
