<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/cv_details"/>
    <RelativeLayout
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/sm_block"
            android:layout_marginStart="@dimen/dp16"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp16"
            android:text="@string/sm_block_desc"
            android:layout_below="@+id/tv1"
            android:layout_marginStart="@dimen/dp16"/>
        <CheckBox
            android:id="@+id/cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:button="@drawable/sm_checkbox_selector_bg"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="@dimen/dp11"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/saveLocalContact"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/sm_save_contact"
            android:layout_marginStart="@dimen/dp16"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp16"
            android:text="@string/sm_save_contact_desc"
            android:layout_marginStart="@dimen/dp16"/>
    </LinearLayout>
</LinearLayout>
