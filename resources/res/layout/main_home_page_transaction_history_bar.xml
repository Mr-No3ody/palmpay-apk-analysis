<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutTransHistory"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:paddingStart="16dp">
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingEnd="86dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_b"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:id="@+id/tvHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_history"
        android:includeFontPadding="false"
        android:paddingEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/txt_mi_lg"/>
    <ImageView
        android:id="@+id/ivDot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@drawable/cv_red_point"
        android:scaleType="fitXY"
        android:layout_marginEnd="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/ppTextStyleT2"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lib_ui_number_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvAmount"
        app:layout_constraintStart_toEndOf="@+id/tvAmount"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
