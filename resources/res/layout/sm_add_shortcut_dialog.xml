<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_temp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_top_corner_white_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp10">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48">
            <TextView
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/sm_add_shortcut_title"
                style="@style/txt_b_b_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivClose"
                android:padding="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:iiv_color="@color/ppColorTextNormal"
                app:iiv_icon="pay_Close"
                app:iiv_size="24dp"/>
        </RelativeLayout>
        <TextView
            android:gravity="center"
            android:paddingLeft="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/sm_add_shortcut_remark"
            android:lineSpacingMultiplier="1.2"
            android:paddingHorizontal="@dimen/dp16"
            style="@style/txt_s_b"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:src="@drawable/sm_add_shortcut"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/result_two_btn_view"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <Button
                android:textSize="16dp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_left_btn"
                android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/cv_default_button_height"
                android:text="@string/core_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/result_right_btn"
                android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/cv_default_button_height"
                android:text="@string/sm_add_shortcut"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp12"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
