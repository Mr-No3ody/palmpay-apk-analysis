<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/p2p_title"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/p2p_str_reason_for_cancellation"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/p2p_reasons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title">
        <com.transsnet.palmpay.p2pcash.ui.atm.view.ReasonItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.ReasonItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.ReasonItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.p2pcash.ui.atm.view.ReasonItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_other_reason_edit"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/ppColorBackgroundDark"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_reasons">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="#c0c3c8"
            android:gravity="top"
            android:id="@+id/p2p_edit"
            android:background="@null"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:hint="@string/p2p_str_please_provide_for_us_to_serve_you_better"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="bottom|right"
            android:id="@+id/p2p_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"/>
    </androidx.cardview.widget.CardView>
    <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PButton
        android:id="@+id/p2p_confirm"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_other_reason_edit"
        app:layout_goneMarginTop="24dp"
        app:p2p_btn_name="@string/core_confirm"
        app:p2p_btn_status="disable"/>
</androidx.constraintlayout.widget.ConstraintLayout>
