<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/apply_pending_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="110dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp14">
            <com.transsnet.palmpay.custom_view.CircleProgressView
                android:id="@+id/progressBar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                app:circleColor="@color/ppColorDividerLine"
                app:currentProgress="10"
                app:maxProgress="10"
                app:progressColor="@color/cs_main_color"
                app:progressStrokeWidth="6dp"/>
            <TextView
                android:textSize="@dimen/dp30"
                android:textStyle="bold"
                android:textColor="@color/cs_main_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/countdown_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/cs_application_processing"
            style="@style/Text.medium.202046"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/countdown_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/cs_cl_calculated_seconds"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24">
            <ImageView
                android:id="@+id/pending_first_start_iv"
                android:visibility="invisible"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cs_cl_pending_loading_small_icon"/>
            <TextView
                android:textColor="@color/cs_main_color"
                android:id="@+id/pending_first_tips_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:text="@string/cs_oc_checking_your_personal_information"
                android:layout_marginHorizontal="@dimen/dp4"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pending_risk_vp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp152"
        android:layout_marginTop="@dimen/dp48"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/pending_risk_indicator_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp12">
        <View
            android:id="@+id/pending_risk_dot_first"
            android:background="@drawable/cs_cl_pending_dot_selected_bg"
            android:layout_width="@dimen/dp10"
            android:layout_height="@dimen/dp3"/>
        <View
            android:id="@+id/pending_risk_dot_second"
            android:background="@drawable/cs_cl_pending_dot_unselected_bg"
            android:layout_width="@dimen/dp10"
            android:layout_height="@dimen/dp3"
            android:layout_marginStart="@dimen/dp4"/>
    </LinearLayout>
    <View
        android:layout_width="@dimen/dp1"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
