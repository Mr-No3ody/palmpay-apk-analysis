<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_cd_hour"
        android:background="@drawable/cv_shape_rect_corner_4_bg_text_primary"
        android:paddingLeft="@dimen/dp2"
        android:paddingRight="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:minWidth="@dimen/dp20"
        android:paddingHorizontal="@dimen/dp2"
        style="@style/Text.medium.ffffff.12"/>
    <TextView
        android:id="@+id/tv_colon_hour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        android:layout_marginRight="@dimen/dp4"
        android:text="@string/cv_colon"
        android:layout_marginHorizontal="@dimen/dp4"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:id="@+id/tv_cd_minute"
        android:background="@drawable/cv_shape_rect_corner_4_bg_text_primary"
        android:paddingLeft="@dimen/dp2"
        android:paddingRight="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:minWidth="@dimen/dp20"
        android:paddingHorizontal="@dimen/dp2"
        style="@style/Text.medium.ffffff.12"/>
    <TextView
        android:id="@+id/tv_colon_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        android:layout_marginRight="@dimen/dp4"
        android:text="@string/cv_colon"
        android:layout_marginHorizontal="@dimen/dp4"
        style="@style/Text.medium.202046.12"/>
    <TextView
        android:id="@+id/tv_cd_second"
        android:background="@drawable/cv_shape_rect_corner_4_bg_text_primary"
        android:paddingLeft="@dimen/dp2"
        android:paddingRight="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:minWidth="@dimen/dp20"
        android:paddingHorizontal="@dimen/dp2"
        style="@style/Text.medium.ffffff.12"/>
</merge>
