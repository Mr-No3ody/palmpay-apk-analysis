<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp12"
    android:paddingEnd="@dimen/dp12">
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_level_benefit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_b_b"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:id="@+id/tvHeaderLevel"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="@dimen/dp12"
        android:text="Tier"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_s_g"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextAssist"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvHeaderDailyLimit"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/ac_daily_transaction_limit"
        android:maxLines="1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/glDailyLimit"
        app:layout_constraintTop_toTopOf="@+id/tvHeaderLevel"
        style="@style/txt_s_g"/>
    <View
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderDailyLimit"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glDailyLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.32"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextAssist"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tvHeaderMaxBalance"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:text="@string/ac_maximum_balance_text"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHeaderLevel"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTier1"
        android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/dp4"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderLevel">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glDailyLimit1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.32"/>
        <TextView
            android:id="@+id/tvTier1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivTier1Selected"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="@dimen/dp4"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Selected"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvTier1NextLevel"
            android:background="@drawable/cv_rect_corner_16_bg_second_stroke_primary"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_next"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp6"
            android:paddingEnd="@dimen/dp6"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvTier1Amount1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/glDailyLimit1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvTier1Amount2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTier2"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTier1">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glDailyLimit2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.32"/>
        <TextView
            android:id="@+id/tvTier2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivTier2Selected"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="@dimen/dp4"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Selected"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier2"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvTier2NextLevel"
            android:background="@drawable/cv_rect_corner_16_bg_second_stroke_primary"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_next"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp6"
            android:paddingEnd="@dimen/dp6"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier2"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvTier2Amount1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/glDailyLimit2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvTier2Amount2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTier3"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTier2">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glDailyLimit3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.32"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivTier3Selected"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginStart="@dimen/dp4"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Selected"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier3"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvTier3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvTier3NextLevel"
            android:background="@drawable/cv_rect_corner_16_bg_second_stroke_primary"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_next"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp6"
            android:paddingEnd="@dimen/dp6"
            android:layout_marginStart="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvTier3"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvTier3Amount1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/glDailyLimit3"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvTier3Amount2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_mi_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
