<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cs_oc_open_protocol_dialog_bg"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/acTextview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cs_oc_flexi_agreements"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_oc_dialog_close_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/acTextview2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/cs_oc_open_protocol_dialog_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/acTextview"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkAgreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:checked="false"
        android:button="@drawable/cs_oc_protocol_check_bg"
        app:layout_constraintStart_toStartOf="@+id/acTextview2"
        app:layout_constraintTop_toBottomOf="@+id/acTextview2"/>
    <TextView
        android:textAppearance="@style/txt_s_b"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/term_condition_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/checkAgreement"
        app:layout_constraintBottom_toBottomOf="@+id/checkAgreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkAgreement"
        app:layout_constraintTop_toTopOf="@+id/checkAgreement"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/condition_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="checkAgreement, term_condition_tv"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/privacy_policy_cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:checked="false"
        android:button="@drawable/cs_oc_protocol_check_bg"
        app:layout_constraintStart_toStartOf="@+id/acTextview2"
        app:layout_constraintTop_toBottomOf="@+id/checkAgreement"/>
    <TextView
        android:textAppearance="@style/txt_s_b"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/privacy_prefix_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/checkAgreement"
        app:layout_constraintBottom_toBottomOf="@+id/privacy_policy_cb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/privacy_policy_cb"
        app:layout_constraintTop_toTopOf="@+id/privacy_policy_cb"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/privacy_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="privacy_policy_cb, privacy_prefix_tv"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/bank_info_cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:checked="false"
        android:button="@drawable/cs_oc_protocol_check_bg"
        app:layout_constraintStart_toStartOf="@+id/acTextview2"
        app:layout_constraintTop_toBottomOf="@+id/privacy_policy_cb"/>
    <TextView
        android:textAppearance="@style/txt_s_b"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/one_loop_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/checkAgreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bank_info_cb"
        app:layout_constraintTop_toTopOf="@+id/bank_info_cb"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/cbDebitMandate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:checked="false"
        android:button="@drawable/cs_oc_protocol_check_bg"
        app:layout_constraintStart_toStartOf="@+id/acTextview2"
        app:layout_constraintTop_toBottomOf="@+id/bank_info_cb"/>
    <TextView
        android:textAppearance="@style/txt_s_b"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvDebitMandate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp6"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/checkAgreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cbDebitMandate"
        app:layout_constraintTop_toTopOf="@+id/cbDebitMandate"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/one_loop_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bank_info_cb, one_loop_tv"/>
    <TextView
        android:enabled="true"
        android:textAppearance="@style/txt_me_w"
        android:gravity="center"
        android:id="@+id/agree_tv"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp36"
        android:layout_marginRight="24dp"
        android:text="@string/cs_oc_read_agree_all_agreements"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDebitMandate"/>
</androidx.constraintlayout.widget.ConstraintLayout>
