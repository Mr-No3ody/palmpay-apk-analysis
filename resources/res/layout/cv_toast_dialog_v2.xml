<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:paddingBottom="@dimen/dp20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?android:attr/actionBarSize">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/toast_dialog_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp16"
        style="@style/CardView">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_toast_dialog"
            android:background="@color/ppColorActivityMask"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp8"
            android:paddingVertical="@dimen/dp12">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/tips_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:iiv_color="@color/ppColorButtonTextWhite"
                app:iiv_icon="pay_WarningOutline"
                app:iiv_size="20dp"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center_vertical"
                android:id="@+id/tips_msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivClose"
                android:padding="@dimen/dp8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorButtonTextWhite"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
