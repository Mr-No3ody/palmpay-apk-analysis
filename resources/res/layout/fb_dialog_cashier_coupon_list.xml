<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fb_viewRoot"
    android:background="@drawable/fb_shape_rect_corner_lt_rt_8_bg_white"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/fb_dp16"
        android:textStyle="bold"
        android:textColor="@color/fb_text_color_black1"
        android:gravity="center"
        android:id="@+id/fb_cdsc_title_tv"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/fb_select_coupon"
        android:layout_alignParentTop="true"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_cdsc_close_iv"
        android:layout_width="@dimen/fb_dp24"
        android:layout_height="@dimen/fb_dp24"
        android:layout_marginTop="15dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/fb_dp15"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/fb_color_95a1ab"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/fb_dp20"/>
    <View
        android:background="@color/fb_divider_color_gray"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_dp1"
        android:layout_below="@+id/fb_cdsc_title_tv"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fb_cdsc_rcv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="60dp"
        android:layout_below="@+id/fb_cdsc_title_tv"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/fb_cdsc_confirm"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/fb_dp16"
        android:layout_marginRight="@dimen/fb_dp16"
        android:text="@string/fb_confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/fb_dp16"
        style="@style/fbButtonStyle"/>
    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/fb_loadingView"
        android:visibility="gone"
        android:layout_width="@dimen/fb_dp36"
        android:layout_height="@dimen/fb_dp36"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        app:indicatorColor="@color/fb_base_colorAccent"
        app:indicatorName="BallSpinFadeLoaderIndicator"
        style="@style/AVLoadingIndicatorView.Large"/>
</RelativeLayout>
