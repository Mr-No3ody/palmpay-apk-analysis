<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/core_transaction_receipt"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/receiptView"
            android:background="@drawable/cv_receipt_bg_2"
            android:paddingTop="@dimen/dp20"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp8"
                android:src="@drawable/core_receipt_palmpay_logo"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_logo"
                android:visibility="gone"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="26dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"/>
            <TextView
                android:ellipsize="none"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/core_successful_transaction"
                android:singleLine="true"
                style="@style/txt_s_b"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:gravity="center"
                android:id="@+id/tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/txt_me_lg"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/cv_shape_item_data_bundle_gray_line"
                android:layerType="software"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_item_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/cv_shape_item_data_bundle_gray_line"
                android:layerType="software"/>
            <TextView
                android:textColor="@color/text_color_gray4"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvBottomDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp16"
                android:text="@string/core_receipt_bottom_text_tips"
                android:layout_marginVertical="@dimen/dp16"
                style="@style/txt_mi_b"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bottomView"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_Share"
                app:iiv_size="16dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/shareTv"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/core_share_receipt"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorPrimary"
                app:iiv_icon="pay_download"
                app:iiv_size="16dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center"
                android:id="@+id/saveTv"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/core_save_document"
                android:layout_marginStart="@dimen/dp8"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
