<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutUserLevel"
    android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp67"
    android:paddingHorizontal="@dimen/dp12"
    app:layout_constraintTop_toTopOf="parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivUpgrade"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnUpgrade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnUpgrade"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/main_upgrade"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvUpgrade"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnUpgrade"
        app:layout_constraintEnd_toStartOf="@+id/btnUpgrade"
        app:layout_constraintStart_toEndOf="@+id/ivUpgrade"
        app:layout_constraintTop_toTopOf="@+id/btnUpgrade"
        style="@style/txt_mi_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="10dp"
        android:gravity="center"
        android:id="@+id/btnUpgrade"
        android:background="@drawable/core_rect_round_corner_bg_white_stroke_6306b2"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:text="@string/core_upgrade"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppSmallStrokeButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
