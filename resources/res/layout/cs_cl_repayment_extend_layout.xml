<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/oc_extend_mbt"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_right_iconfont_2="pay_CustomerService"
        app:title_bar_show_right_2_iv="true"
        app:title_bar_title="Extension Repayment"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cs_cl_defer_your_bill"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cs_oc_repay_zone_bg"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/currency_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/extend_amount_tv"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/dp36"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/extend_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/currency_tv"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_number_s_b_b"/>
        <View
            android:id="@+id/csTextview142"
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/extend_amount_tv"/>
        <com.transsnet.palmpay.credit.view.RepayStampDutyView
            android:id="@+id/repayStampDutyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/csTextview142"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/principal_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_cl_principal"
            android:drawablePadding="@dimen/dp6"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/repayStampDutyView"
            app:layout_goneMarginTop="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/principal_amount_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/principal_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/principal_title_tv"
            app:layout_constraintTop_toTopOf="@+id/principal_title_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/csTextview143"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/cs_cl_interest"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/principal_title_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/extend_penalty_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview143"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview143"
            app:layout_constraintTop_toTopOf="@+id/csTextview143"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/csTextview145"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_service_fee"
            app:layout_constraintStart_toStartOf="@+id/csTextview143"
            app:layout_constraintTop_toBottomOf="@+id/csTextview143"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/extend_fee_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview145"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview145"
            app:layout_constraintTop_toTopOf="@+id/csTextview145"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/over_interest_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_over_interest"
            app:layout_constraintStart_toStartOf="@+id/csTextview145"
            app:layout_constraintTop_toBottomOf="@+id/csTextview145"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/over_interest_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/over_interest_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/over_interest_title_tv"
            app:layout_constraintTop_toTopOf="@+id/over_interest_title_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/extend_service_fee_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cs_cl_extend_service_fee"
            app:layout_constraintStart_toStartOf="@+id/over_interest_title_tv"
            app:layout_constraintTop_toBottomOf="@+id/over_interest_title_tv"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="end"
            android:id="@+id/extend_service_fee_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/extend_service_fee_title_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/extend_service_fee_title_tv"
            app:layout_constraintTop_toTopOf="@+id/extend_service_fee_title_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/cs_oc_repay_zone_bg"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_extension_repayment_date"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/extend_repayment_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:id="@+id/oc_extend_bt"
        android:background="@drawable/cs_cl_shape_rect_corner_12_bg_00a49a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/cs_cl_pay_extension_fee"
        android:textAllCaps="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/Widget.AppCompat.Button.Borderless"/>
    <TextView
        android:textColor="@color/ppColorFlexiCashPrimary"
        android:layout_gravity="center"
        android:id="@+id/extend_agreement_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp16"
        android:text="@string/cs_cl_see_loan_agreement"/>
</LinearLayout>
