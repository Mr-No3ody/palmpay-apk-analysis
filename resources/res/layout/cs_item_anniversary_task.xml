<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_container"
    android:paddingTop="@dimen/dp14"
    android:paddingBottom="@dimen/dp14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp14">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:layout_marginStart="@dimen/dp16"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4">
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/text4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp10"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/text2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/dp10"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/textPerDay"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp2"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/cs_main_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/gobtn"
            android:background="@drawable/cs_cl_task_item_go_bg"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp24"
            android:text="@string/core_go"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="@dimen/dp16"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:layout_below="@+id/ll_container"
        android:layout_marginStart="@dimen/dp60"/>
</RelativeLayout>
