<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/layoutParent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48">
        <ImageView
            android:id="@+id/imageViewCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/textViewCountryCode"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="3dp"
            android:layout_centerVertical="true"
            android:paddingStart="25dp"
            android:paddingEnd="5dp"
            style="@style/txt_me_b"/>
        <com.google.android.material.textfield.TextInputEditText
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="start|center_vertical"
            android:id="@+id/editTextMobile"
            android:background="@null"
            android:paddingLeft="0dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="20"
            android:layout_centerVertical="true"
            android:inputType="number"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginStart="@dimen/dp16"
            android:layout_toEndOf="@+id/textViewCountryCode"
            style="@style/txt_me_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_enter_mobile_number"
            android:layout_centerVertical="true"
            android:layout_alignStart="@+id/editTextMobile"
            style="@style/txt_me_g"/>
        <View
            android:id="@+id/dividerView"
            android:background="@color/ppColorTextPrimary"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/ppColorError"
            android:gravity="center_vertical"
            android:id="@+id/textViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_s_g"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/textViewCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            style="@style/txt_s_g"/>
    </RelativeLayout>
</merge>
