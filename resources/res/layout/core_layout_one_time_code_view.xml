<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="center_horizontal"
        android:id="@+id/smsCodeView"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp16"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/ppColorBackgroundDark"
        app:digitHeight="44dp"
        app:digitRadius="@dimen/dp8"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/dp12"
        app:digitStrokeColor="@color/ppColorBackgroundDark"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="24dp"
        app:digitWidth="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        app:mask=""
        app:numDigits="6"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/viewError"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cv_warning"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/ppColorError"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/textViewError"
            android:paddingLeft="4dp"
            android:paddingTop="0dp"
            android:paddingRight="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            style="@style/txt_mi_g"/>
    </LinearLayout>
    <com.transsnet.palmpay.custom_view.StateListTextView
        android:enabled="true"
        android:textAppearance="@style/txt_b_w"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewSendSms"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="@string/core_send_code"
        android:elevation="@dimen/core_default_elevation"
        style="@style/CvCornerButtonStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewMessage"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="invisible"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/core_msg_send_voice_code_default"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        style="@style/txt_mi_g"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/viewSendVoiceCode"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/core_voice_call"
            android:scaleType="fitXY"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/core_try_voice_call"
            android:paddingStart="5dp"
            style="@style/txt_s_g"/>
    </LinearLayout>
</merge>
