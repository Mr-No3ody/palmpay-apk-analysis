<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_show_right_1_iv="true"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/header_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.transsnet.palmpay.cash_in.ui.view.BindBankCardProgressModel
                android:id="@+id/v_progress"
                android:paddingTop="@dimen/dp24"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_order_info"
                android:paddingTop="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/result_two_btn_view"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/result_right_btn"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/ci_complete_text"
            android:layout_marginHorizontal="@dimen/dp16"
            style="@style/ppButtonStyle"/>
    </FrameLayout>
</LinearLayout>
