<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="60dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="200dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.SingleAdView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ac_signup_header_ad_height"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/ac_ad_sign_up_3_slot_id"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/ac_complete_information"
                style="@style/txt_bb_b_b"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#fff4e5"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:contentPaddingBottom="@dimen/dp8"
                app:contentPaddingLeft="@dimen/dp12"
                app:contentPaddingRight="@dimen/dp12"
                app:contentPaddingTop="8dp">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp16"
                    app:iiv_color="@color/ppColorWarning"
                    app:iiv_icon="pay_InformationOutline"
                    app:iiv_size="@dimen/dp16"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/ppColorWarning"
                    android:gravity="top"
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    style="@style/txt_s_g"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:form_edit_input_type="text"
                    app:form_hide_text="Please enter first name"
                    app:form_label_text="@string/ac_legal_first_name"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputMiddleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:form_edit_input_type="text"
                    app:form_hide_text="Please enter middle name"
                    app:form_label_text="@string/ac_legal_middle_name_opt"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:form_edit_input_type="text"
                    app:form_hide_text="Please enter surname"
                    app:form_label_text="@string/ac_surname"
                    app:form_layout_background="@color/transparent"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/ac_gender"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_mi_b"/>
                <com.transsnet.palmpay.account.ui.view.GenderV2View
                    android:id="@+id/genderView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginBottom="4dp"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <View
                    android:background="@color/ppColorDividerLine"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <TextView
                    android:textColor="@color/ppColorError"
                    android:gravity="center_vertical"
                    android:id="@+id/tvGenderError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:text="@string/ac_select_your_gender"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/txt_s_g"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/inputBirthday"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    app:form_edit_enable="false"
                    app:form_edit_input_type="text"
                    app:form_hide_text="@string/ac_select_your_birthday"
                    app:form_icon_edit_right="@drawable/cv_arrow_down_black"
                    app:form_label_text="@string/ac_date_of_birth"
                    app:form_layout_background="@color/transparent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.palmpay.lib.ui.button.PpButton
        android:gravity="center"
        android:id="@+id/textViewNext"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:text="@string/core_next"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
