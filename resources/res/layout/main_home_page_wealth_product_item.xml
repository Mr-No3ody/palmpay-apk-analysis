<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctl_frame"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:padding="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="147dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tvProductTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tvProductSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp26"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProductTitle"
            style="@style/Text.202046.10"/>
        <TextView
            android:textColor="@color/ppColorSuccess"
            android:ellipsize="end"
            android:id="@+id/tvProductContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProductSubTitle"
            style="@style/Text.202046.20"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvProductSubContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProductContent"
            style="@style/Text.6f7b85.10"/>
        <com.palmpay.lib.ui.button.PpButton
            android:textSize="@dimen/dp12"
            android:gravity="center"
            android:id="@+id/btnOp"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/dp70"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ppSmallButtonNoPaddingStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp8"
        android:gravity="center"
        android:id="@+id/tvCornerMark"
        android:background="@drawable/main_wealth_bg_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp19"
        android:layout_marginRight="-10dp"
        android:includeFontPadding="false"
        android:maxLength="5"
        android:layout_alignParentRight="true"
        style="@style/Text.ffffff.10"/>
</RelativeLayout>
