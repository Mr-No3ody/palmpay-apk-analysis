<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp36"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="@dimen/dp16">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/cmrlta_content_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:text=""
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/cmrlta_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp11"
            android:text="@string/cv_this_month"
            android:layout_centerVertical="true"
            style="@style/txt_s_b_b"/>
    </RelativeLayout>
</LinearLayout>
