<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_list_item_bg"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <View
        android:id="@+id/qlf_base_view1"
        android:layout_width="1dp"
        android:layout_height="@dimen/dp10"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/qlf_cashback_iv"
        android:background="@drawable/cv_rect_corner_6_6_6_2_bg_38d79f"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp18"
        android:paddingStart="@dimen/dp7"
        android:paddingEnd="@dimen/dp7"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/qld_cashback_iv">
        <androidx.core.widget.ContentLoadingProgressBar
            android:theme="@style/QTContentLoadingProgress"
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            style="?android:attr/progressBarStyleLarge"/>
        <ImageView
            android:id="@+id/imageViewFavorite"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="@dimen/large_margin"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/qt_favorite_big"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"
            android:paddingStart="10dp"
            android:paddingEnd="@dimen/large_margin"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/textViewLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/imageViewFavorite"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/imageViewFavorite"
            android:layout_alignParentStart="true"
            style="@style/txt_me_b"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/textViewLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/textViewLine1"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            style="@style/txt_me_g"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/textViewLine2"/>
    </RelativeLayout>
</LinearLayout>
