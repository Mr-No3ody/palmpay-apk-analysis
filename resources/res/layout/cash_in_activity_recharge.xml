<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/ciar_page_top"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cta_content_text="@string/ci_add_fund_to_palmpay"
        app:cta_title="@string/core_fund"
        app:title_bar_right_text="@string/core_history"
        app:title_bar_title="@string/core_fund"/>
    <ScrollView
        android:id="@+id/ciarScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ciarAdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:slot_id="@string/ad_fund_home_slot_id"/>
            <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeView
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:id="@+id/fun_txt_mv"
                android:background="#f0ecfc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/cv_notify_icon"
                android:paddingStart="12dp"
                app:slot_id="@string/fund_txt_slot_id"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvFundMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="24dp"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/ci_fund_method"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/Text.medium.202046.14"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rl_select_bank"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60">
                    <ImageView
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        android:src="@drawable/cv_default_bank_logo"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp16"/>
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="start"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_select_bank_text"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp16"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp16"
                        app:iiv_color="@color/ppColorTextNormal"
                        app:iiv_icon="pay_ArrowRight"
                        app:iiv_size="@dimen/dp20"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/fl_add_bank_account"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60">
                    <TextView
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/ppColorPrimary"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_add_bank_card_account"
                        android:drawablePadding="@dimen/dp6"
                        android:drawableStart="@drawable/ci_add_new_bank_card"
                        android:drawableTint="@color/ppColorPrimary"/>
                </FrameLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rl_bank_info"
                    android:background="@drawable/cv_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp80">
                    <ImageView
                        android:id="@+id/iv_bank_icon"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        android:src="@drawable/cv_default_bank_logo"
                        android:layout_marginStart="@dimen/dp16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp15"
                        android:textColor="@color/ppColorTextPrimary"
                        android:ellipsize="end"
                        android:id="@+id/tv_bank_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp10"
                        app:layout_constraintBottom_toTopOf="@+id/tv_bank_no"
                        app:layout_constraintEnd_toStartOf="@+id/tv_change"
                        app:layout_constraintStart_toEndOf="@+id/iv_bank_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextAssist"
                        android:id="@+id/tv_bank_no"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp2"
                        android:layout_toRightOf="@+id/iv_bank_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_bank_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_bank_name"/>
                    <TextView
                        android:textSize="@dimen/dp12"
                        android:textColor="@color/ppColorTextDisable"
                        android:id="@+id/ciar_expire"
                        android:background="@drawable/core_background_storke_9ca2aa_4"
                        android:paddingLeft="@dimen/dp8"
                        android:paddingTop="@dimen/dp1"
                        android:paddingRight="@dimen/dp8"
                        android:paddingBottom="@dimen/dp1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_expired"
                        android:layout_marginStart="@dimen/dp4"
                        android:paddingHorizontal="@dimen/dp8"
                        android:paddingVertical="@dimen/dp1"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_bank_no"
                        app:layout_constraintStart_toEndOf="@+id/tv_bank_no"
                        app:layout_constraintTop_toTopOf="@+id/tv_bank_no"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:textColor="#858a8f"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ci_change"
                        android:layout_marginEnd="@dimen/dp16"
                        app:iiv_end_color="@color/ppColorTextAssist"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/ciar_mantle"
                        android:background="#66ffffff"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginRight="@dimen/dp16"
                android:text="@string/ci_select_amount"
                android:layout_marginHorizontal="@dimen/dp16"
                style="@style/Text.medium.202046.14"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp">
                <com.palmpay.lib.ui.edit.PpAmountEditText
                    android:id="@+id/inputAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:am_edit_btn_text="@string/ci_fund"
                    app:am_edit_hint="@string/ci_hint_enter_fund"
                    app:am_edit_hint_text_size="@dimen/dp18"
                    app:am_edit_show_button="true"
                    app:am_edit_show_currency="true"
                    app:am_edit_show_lock="false"
                    app:am_edit_show_title="false"
                    app:am_edit_text_size="@dimen/dp20"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/amount_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"/>
            </LinearLayout>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvFeeTips"
                android:layout_marginTop="@dimen/dp24"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
