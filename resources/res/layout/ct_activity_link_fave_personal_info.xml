<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title=""/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/viewInfo"
        android:background="@drawable/cv_rect_corner_12_bg_white"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp60"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar">
        <TextView
            android:textSize="@dimen/dp9"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="end"
            android:id="@+id/tvFriendTag"
            android:background="@drawable/ct_pp_contact_bg"
            android:paddingLeft="@dimen/dp5"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp5"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/ct_palmpay_contact"
            android:paddingHorizontal="@dimen/dp5"
            android:paddingVertical="@dimen/dp2"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:fontFamily="sans-serif-medium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <ImageView
                android:id="@+id/ivTag"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp24"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="left"
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp6"
                app:autoSizeMaxTextSize="@dimen/dp12"
                app:autoSizeMinTextSize="@dimen/dp8"
                app:autoSizeTextType="uniform"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/ivTag"
                app:layout_constraintLeft_toRightOf="@+id/ivTag"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivTag"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvOptional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginHorizontal="@dimen/dp10"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvBindingType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginHorizontal="@dimen/dp10"/>
    </LinearLayout>
    <ImageView
        android:layout_width="@dimen/dp80"
        android:layout_height="@dimen/dp80"
        android:layout_marginTop="@dimen/dp16"
        android:src="@drawable/cv_ring_white_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <ImageView
        android:id="@+id/ivHead"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:layout_marginTop="@dimen/dp24"
        android:src="@drawable/cv_avatar_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewInfo">
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:id="@+id/tvAdd"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:text="@string/ct_add_palmpay_contact"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvEdit"
            android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/core_edit"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:id="@+id/tvDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/core_delete"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
