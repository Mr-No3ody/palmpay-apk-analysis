<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp"
    android:layout_marginHorizontal="3dp">
    <ImageView
        android:layout_width="100dp"
        android:layout_height="72dp"
        android:src="@drawable/sm_schedule_empty_calendar"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp20"
        android:src="@drawable/sm_schedule_empty_headline"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/sm_schedule_empty_headline"
        android:layout_marginHorizontal="@dimen/dp20"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="20dp"
        android:text="@string/sm_schedule_empty_description"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="20dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/sm_schedule_empty_selected"
            android:contentDescription="@null"/>
        <TextView
            android:text="@string/sm_schedule_empty_easy"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="24dp"
            style="@style/SmScheduleEmptyBenefit"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/sm_schedule_empty_selected"
            android:contentDescription="@null"/>
        <TextView
            android:text="@string/sm_schedule_empty_smart"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="24dp"
            style="@style/SmScheduleEmptyBenefit"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/sm_schedule_empty_selected"
            android:contentDescription="@null"/>
        <TextView
            android:text="@string/sm_schedule_empty_secure"
            android:layout_marginStart="7dp"
            style="@style/SmScheduleEmptyBenefit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/SmScheduleEmptyCard">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sm_schedule_empty_friends"
                android:contentDescription="@null"/>
            <TextView
                android:text="@string/sm_schedule_empty_family_support"
                style="@style/SmScheduleEmptyCardTitle"/>
            <TextView
                android:text="@string/sm_schedule_empty_family_support_tip"
                style="@style/SmScheduleEmptyCardDescription"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/SmScheduleEmptyCard">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sm_schedule_empty_gift"
                android:contentDescription="@null"/>
            <TextView
                android:text="@string/sm_holiday_gift"
                style="@style/SmScheduleEmptyCardTitle"/>
            <TextView
                android:text="@string/sm_schedule_empty_holiday_tip"
                style="@style/SmScheduleEmptyCardDescription"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/SmScheduleEmptyCard">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sm_schedule_empty_rent"
                android:contentDescription="@null"/>
            <TextView
                android:text="@string/sm_pay_rent"
                style="@style/SmScheduleEmptyCardTitle"/>
            <TextView
                android:text="@string/sm_pay_your_rent_on_time"
                style="@style/SmScheduleEmptyCardDescription"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/SmScheduleEmptyCard">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/sm_schedule_empty_loan"
                android:contentDescription="@null"/>
            <TextView
                android:text="@string/sm_schedule_empty_repay_loan"
                style="@style/SmScheduleEmptyCardTitle"/>
            <TextView
                android:text="@string/sm_schedule_empty_repay_loan_tip"
                style="@style/SmScheduleEmptyCardDescription"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
