<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_installment_user_migrate_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:paddingStart="@dimen/dp24"
        android:paddingEnd="@dimen/dp24">
        <ImageView
            android:id="@+id/tv_installment_user_migrate_icon"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:src="@drawable/cs_installment_user_migrate_icon"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:textSize="18sp"
            android:gravity="center"
            android:id="@+id/iv_installment_user_migrate_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp16"
            android:src="@drawable/cs_cl_borrowing_multiple_services_online"
            android:scaleType="fitCenter"
            android:layout_below="@+id/tv_installment_user_migrate_icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cv_color_858a8f"
            android:gravity="center"
            android:id="@+id/tv_installment_user_migrate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/cs_cl_installment_user_migrate_content_no_join_debit"
            android:layout_below="@+id/iv_installment_user_migrate_title"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/btn_installment_user_migrate_btn"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_ok"
            android:layout_below="@+id/tv_installment_user_migrate_content"
            android:textAllCaps="false"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </RelativeLayout>
</RelativeLayout>
