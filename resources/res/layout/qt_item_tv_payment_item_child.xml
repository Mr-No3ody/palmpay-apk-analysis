<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/space_body"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_item_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_item_desc"
        android:background="@drawable/cv_rect_bg_f0ecfc_corner_e3cff4_stroke_bl_br_8"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintTop_toTopOf="@+id/space_body"
        style="@style/Text.202046.10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/ll_item_body"
        android:background="@drawable/cv_rect_bg_white_corner_e3cff4_stroke_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_item_view_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorTextBase"
            android:ellipsize="end"
            android:id="@+id/tv_activity_icon"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginBottom="@dimen/dp4"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.ffffff.10"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_activity_icon"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/txt_me_b_b"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:gravity="center"
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintBottom_toTopOf="@+id/tv_cashback"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_name"
            app:layout_goneMarginBottom="@dimen/dp8"
            style="@style/txt_me_b_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_arrow_right"
            android:paddingTop="0.5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_amount"
            app:layout_constraintStart_toEndOf="@+id/tv_amount"
            app:layout_constraintTop_toTopOf="@+id/tv_amount"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorSuccess"
            android:gravity="center"
            android:id="@+id/tv_cashback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginBottom="@dimen/dp8"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/txt_mi_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
