<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/layoutContent"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/viewBottompAd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/topSpace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivInstallmentLoan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvInstallmentLoan"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInstallmentLoan"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvInstallmentLoan"
            android:layout_marginLeft="@dimen/dp6"
            android:text="@string/cs_cl_installment_loan"
            app:layout_constraintLeft_toRightOf="@+id/ivInstallmentLoan"
            app:layout_constraintTop_toBottomOf="@+id/topSpace"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmountTitle"
            android:layout_marginTop="@dimen/dp12"
            android:text="@string/cs_loan_amount"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInstallmentLoan"
            style="@style/Text.202046.12"/>
        <com.transsnet.palmpay.custom_view.RoundedTextView
            android:textColor="@color/ppColorError"
            android:id="@+id/rtvFrozen"
            android:paddingLeft="@dimen/dp4"
            android:paddingRight="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp14"
            android:layout_marginLeft="@dimen/dp4"
            android:text="@string/cs_frozen"
            android:paddingHorizontal="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tvInstallmentLoan"
            app:layout_constraintLeft_toRightOf="@+id/tvInstallmentLoan"
            app:layout_constraintTop_toTopOf="@+id/tvInstallmentLoan"
            app:rtv_background_color="@color/transparent"
            app:rtv_border_color="@color/ppColorError"
            app:rtv_border_width="@dimen/dp1"
            app:rtv_corner_radius="@dimen/dp4"
            style="@style/Text.ffffff.10"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodTitle"
            android:layout_marginLeft="@dimen/dp40"
            android:layout_marginRight="@dimen/dp36"
            android:text="@string/cs_loan_period"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanableAmountTitle"
            app:layout_constraintTop_toTopOf="@+id/tvLoanableAmountTitle"
            style="@style/Text.202046.12"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="@+id/tvLoanPeriodTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvLoanPeriodDays"
            android:layout_marginLeft="@dimen/dp3"
            android:layout_marginTop="@dimen/dp6"
            android:text="Days"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvLoanPeriod"
            app:layout_constraintLeft_toRightOf="@+id/tvLoanPeriod"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:textColor="@color/cv_color_906948"
            android:id="@+id/tvDailyInterest"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.medium.202046.12"/>
        <com.transsnet.adsdk.widgets.SingleAdView
            android:id="@+id/viewAdRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tvDailyInterest"
            app:layout_constraintLeft_toRightOf="@+id/tvDailyInterest"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDailyInterest"/>
        <TextView
            android:id="@+id/tvFrozenReason"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoanableAmount"
            style="@style/Text.202046.12"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupOpened"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvLoanableAmountTitle,tvLoanableAmount,tvLoanPeriodTitle,tvLoanPeriod,tvLoanPeriodDays,tvDailyInterest,viewAdRight"/>
        <TextView
            android:id="@+id/tvUnOpenedLoanableAmountTitle"
            android:layout_marginTop="@dimen/dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInstallmentLoan"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:textSize="@dimen/dp28"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/tvUnOpenedLoanableAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUnOpenedLoanableAmountTitle"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:id="@+id/tvUnOpenedRight"
            android:layout_marginLeft="@dimen/dp1"
            app:layout_constraintLeft_toRightOf="@+id/tvUnOpenedLoanableAmount"
            app:layout_constraintTop_toTopOf="@+id/tvUnOpenedLoanableAmount"
            style="@style/Text.202046.10"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnOpened"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tvUnOpenedLoanableAmount"/>
        <include
            android:id="@+id/layoutInfoReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/rvUnOpened"
            layout="@layout/cs_cl_product_info_review_view"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupUnOpened"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvUnOpenedLoanableAmountTitle,tvUnOpenedLoanableAmount,tvUnOpenedRight,rvUnOpened,layoutInfoReview"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cs_borrow_text_color"
            android:gravity="center"
            android:id="@+id/rtvBorrow"
            android:background="@drawable/lib_ui_button_bg_corner_primary_5"
            android:layout_width="72dp"
            android:layout_height="24dp"
            android:layout_marginRight="@dimen/dp16"
            android:text="@string/cs_cl_borrow"
            app:layout_constraintBottom_toBottomOf="@+id/tvLoanPeriod"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvLoanPeriod"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp13"
        android:textColor="@color/cs_cl_installment_loan_terms_text_color"
        android:id="@+id/tvLoanTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
