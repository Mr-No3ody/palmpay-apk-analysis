<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="Select Current Location"/>
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:gravity="top"
        android:id="@+id/tvAddress"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:padding="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        style="@style/txt_s_g"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/msgContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="@dimen/dp16"
        app:cardBackgroundColor="@color/transparent_70"
        app:cardCornerRadius="@dimen/dp12"
        app:cardElevation="0dp"
        app:contentPadding="@dimen/dp8"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirm">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp4"
            android:paddingEnd="@dimen/dp26"
            style="@style/txt_mi_w"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|top"
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextBase"
            app:iiv_icon="pay_Close"
            app:iiv_size="16dp"/>
    </androidx.cardview.widget.CardView>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="12dp"
        android:text="@string/core_confirm"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
