<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_38"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/viewContainer"
        android:background="@drawable/cv_shape_rect_top_corner_white_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <TextView
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/core_str_input_pin_to_pay"
                android:layout_centerVertical="true"
                style="@style/txt_b_b_b"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivClose"
                android:padding="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Close"
                app:iiv_size="24dp"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/dp20"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/txt_me_b_b"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/paymentInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"/>
        <com.transsnet.palmpay.custom_view.PinEntryView
            android:enabled="false"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pinView"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            app:accentType="character"
            app:accentWidth="0dp"
            app:digitBackground="@color/ppColorTextBase"
            app:digitHeight="45dp"
            app:digitRadius="4dp"
            app:digitSelectStrokeColor="@color/ppColorPrimary"
            app:digitSpacing="10dp"
            app:digitStrokeColor="@color/ppColorTextDisable"
            app:digitStrokeWidth="0.5dp"
            app:digitTextColor="@color/ppColorTextPrimary"
            app:digitTextSize="@dimen/large_text"
            app:digitWidth="45dp"
            app:mask="●"
            app:pinInputType="number"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvForgotPin2"
            android:padding="@dimen/dp12"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/core_str_forget_pin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/viewLine"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/viewVerifyType"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/tvForgotPin"
                android:padding="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_str_forget_pin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/viewLine"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/viewLine"
                android:background="@color/ppColorDividerLineDark"
                android:layout_width="1px"
                android:layout_height="@dimen/dp10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tvTouchId"
                android:padding="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify by Touch ID"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/viewLine"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/txt_s_g"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
        <include
            android:background="@color/ppColorDividerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/core_number_keyboard_layout"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
