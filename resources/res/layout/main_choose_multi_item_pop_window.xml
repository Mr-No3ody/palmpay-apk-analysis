<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ppColorTextBase"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:paddingLeft="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="4dp"
                android:text="@string/core_money_flow"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="800"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"/>
            <TextView
                android:textColor="@color/ppColorTextPrimary"
                android:paddingLeft="@dimen/dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:text="@string/core_payment_type"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="800"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_all_container"
                android:paddingTop="@dimen/dp12"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textColor="@color/md_white_1000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
        android:layout_width="190dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dp10"
        android:text="@string/core_confirm"
        style="@style/txt_s_w"/>
    <View
        android:id="@+id/qbb_empty_area"
        android:background="#7f000000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
</LinearLayout>
