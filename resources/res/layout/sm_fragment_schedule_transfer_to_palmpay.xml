<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.send_money.ui.view.SearchRecipientAccountToPalmPayView
                android:id="@+id/vSearchToPalmPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.palmpay.lib.ui.edit.PpAmountEditText
                android:id="@+id/etTransferMoney"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingTop="@dimen/dp12"
                android:paddingRight="@dimen/dp16"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:inputType="numberDecimal"
                android:layout_marginHorizontal="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp16"
                android:paddingVertical="@dimen/dp12"
                app:am_edit_show_button="false"
                app:am_edit_show_lock="false"
                app:am_edit_show_title="true"
                app:am_edit_text_size="@dimen/dp22"
                app:am_edit_title="@string/core_amount"
                app:am_edit_title_focus_color="@color/ppColorTextPrimary"
                app:am_edit_title_normal_color="@color/ppColorTextPrimary"
                app:layout_constrainedHeight="true"
                app:layout_constraintTop_toBottomOf="@+id/vSearchToBank"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp12"
                android:layout_marginHorizontal="@dimen/dp16"
                android:layout_marginVertical="@dimen/dp12"
                android:paddingVertical="@dimen/dp12"
                app:layout_constraintTop_toBottomOf="@+id/etTransferMoney">
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:form_hide_text="What’s this for?"
                    app:form_label_text="Notes(Opt.)"
                    app:layout_constraintTop_toBottomOf="@+id/et_transfer_money"/>
                <com.google.android.flexbox.FlexboxLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/flNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:dividerDrawable="@drawable/sm_shape_relationship_divider"
                    app:flexWrap="wrap"
                    app:showDivider="middle"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp68"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btnNext"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_margin="@dimen/dp16"
            android:text="@string/core_continue"
            style="@style/txt_me_w"/>
    </FrameLayout>
</LinearLayout>
