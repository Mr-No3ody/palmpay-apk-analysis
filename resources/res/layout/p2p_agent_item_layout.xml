<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:id="@+id/p2p_agent_module"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ppColorBackgroundLight"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:ellipsize="end"
                    android:id="@+id/p2p_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:singleLine="true"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/p2p_distance"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/p2p_distance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/p2p_name"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/p2p_name"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/p2p_labels"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_name">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    app:cardBackgroundColor="#f0ecfc"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/p2p_theme_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/p2p_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="28dp"
                    android:lines="2"
                    android:lineSpacingMultiplier="1.2"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/p2p_phone"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/p2p_phone"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp16"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Phone"
                    app:iiv_size="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/p2p_address"
                    app:layout_constraintRight_toLeftOf="@+id/p2p_navigation"
                    app:layout_constraintTop_toTopOf="@+id/p2p_address"/>
                <ImageView
                    android:id="@+id/p2p_navigation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="16dp"
                    android:src="@mipmap/p2p_navigation"
                    app:layout_constraintBottom_toBottomOf="@+id/p2p_address"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/p2p_address"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/p2p_rest_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/p2p_address">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorTextDisable"
                    app:iiv_icon="pay_ScheduleOutline"
                    app:iiv_size="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/p2p_str_resting"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_gravity="right"
                    android:id="@+id/p2p_booking_notes"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginRight="16dp"
                    app:cardBackgroundColor="@color/p2p_theme_color"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintRight_toLeftOf="@+id/p2p_transfer"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        app:cardBackgroundColor="@color/ppColorBackgroundLight"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/p2p_theme_color"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="11dp"
                            android:layout_marginRight="11dp"
                            android:text="@string/p2p_str_booking_notes"
                            android:fontFamily="sans-serif-medium"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_gravity="right"
                    android:id="@+id/p2p_transfer"
                    android:layout_width="85dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginRight="16dp"
                    app:cardBackgroundColor="@color/p2p_theme_color"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/lib_ui_button_white_text_color"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="@string/p2p_str_get_cash"
                        android:fontFamily="sans-serif-medium"/>
                </androidx.cardview.widget.CardView>
                <ImageView
                    android:id="@+id/p2p_cashback_label"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
