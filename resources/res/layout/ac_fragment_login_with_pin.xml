<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ac_layout_login_header"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewAvatar"
        android:padding="0.5dp"
        android:layout_width="@dimen/dp48"
        android:layout_height="@dimen/dp48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader"
        app:srcCompat="@drawable/cv_avatar_default"/>
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewAvatar"
        style="@style/txt_b_b_b"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="@string/ac_enter_pin_to_unlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPhone"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv2"
        android:paddingTop="7dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_enter_pin_for_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        style="@style/txt_s_g"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupTop"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="imageViewAvatar, tvPhone"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pinView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="@dimen/dp12"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/ppColorBackgroundDark"
        app:digitHeight="@dimen/dp48"
        app:digitRadius="@dimen/dp8"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/dp12"
        app:digitStrokeColor="@color/ppColorBackgroundDark"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="@dimen/dp24"
        app:digitWidth="@dimen/dp48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        app:mask="●"
        app:pinInputType="number"
        app:showHideButton="false"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_horizontal"
        android:id="@+id/tvInputError"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pinView"
        style="@style/txt_s_g"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/securityKeyBoard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvForgotPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_forget_pin_2"
            app:layout_constraintEnd_toStartOf="@+id/viewLine1"
            style="@style/txt_s_b"/>
        <View
            android:id="@+id/viewLine1"
            android:background="@color/ppColorDividerLine"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp12"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/tvVerify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ac_verify_by_fingerprint"
            app:layout_constraintStart_toEndOf="@+id/viewLine1"
            style="@style/txt_s_b"/>
    </LinearLayout>
    <include
        android:id="@+id/securityKeyBoard"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/core_number_keyboard_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
