<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cv_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp68"
    android:paddingStart="@dimen/large_margin"
    android:paddingEnd="@dimen/large_margin">
    <ImageView
        android:id="@+id/imageViewAvatar"
        android:layout_width="@dimen/dp35"
        android:layout_height="@dimen/dp35"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/mlafi_right"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp5"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/dp14"
            android:id="@+id/textViewAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_b_b"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/textViewBanlanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/txt_b_b"/>
    </LinearLayout>
    <TextView
        android:id="@+id/textViewState"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp36"
        android:layout_alignParentEnd="true"
        style="@style/txt_s_g"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/mlafi_right"
        android:layout_toEndOf="@+id/imageViewAvatar">
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/textViewLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/textViewLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
