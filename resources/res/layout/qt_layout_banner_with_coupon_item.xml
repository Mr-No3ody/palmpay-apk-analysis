<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCouponCL"
        android:layout_width="94dp"
        android:layout_height="88dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCouponBg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/dp20"
            android:id="@+id/tvCouponAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/tvOperatorName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvOperatorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_marginTop="@dimen/dp2"
            android:layout_marginRight="@dimen/dp8"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp8"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCouponAmount"
            style="@style/Text.202046.10"/>
        <TextView
            android:textColor="@color/ppColorButtonTextWhite"
            android:id="@+id/tvStatus"
            android:background="@drawable/cv_shape_rect_corner_16_bg_primary"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp3"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp8"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp3"
            app:layout_constraintBottom_toBottomOf="@+id/ivCouponBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Text.medium.ffffff.12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivIconBg"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:src="@drawable/cv_shape_rect_corner_8_bg_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layoutCouponCL"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <ImageView
        android:id="@+id/ivIconBgLogo"
        android:layout_width="@dimen/dp52"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_palmpay_logo_f0ecfc"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layoutCouponCL"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layoutCouponCL"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <ImageView
        android:id="@+id/ivCouponTop"
        android:layout_width="@dimen/dp12"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginStart="88dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/qt_coupon_top_bg"/>
    <ImageView
        android:id="@+id/ivCouponBottom"
        android:layout_width="@dimen/dp12"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginStart="88dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/qt_coupon_bottom_bg"/>
    <com.transsnet.palmpay.custom_view.DashedLineView
        android:id="@+id/dlvCoupon"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginVertical="@dimen/dp12"
        app:dashColor="@color/ppColorPrimary"
        app:dashLength="@dimen/dp2"
        app:dashWidth="1dp"
        app:gapLength="@dimen/dp2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/layoutCouponCL"
        app:layout_constraintTop_toTopOf="parent"
        app:orientation_line="vertical"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupCoupon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="dlvCoupon,ivCouponTop,ivCouponBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
