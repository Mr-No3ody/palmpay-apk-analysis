<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp180"
        app:cardBackgroundColor="@color/transparent_70"
        app:cardCornerRadius="@dimen/dp8"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true"
        app:contentPadding="0dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp15"
            android:paddingEnd="@dimen/dp15">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp16">
                <ImageView
                    android:id="@+id/imageViewIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp32"
                    android:layout_height="@dimen/dp32"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_centerHorizontal="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageViewClose"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cv_close_grey"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/ppColorTextBase"/>
                <ViewStub
                    android:id="@+id/countdownStub"
                    android:visibility="gone"
                    android:layout="@layout/cv_layout_progress_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </RelativeLayout>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/txt_s_w_b"/>
            <TextView
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/textViewMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp8"
                android:layout_marginRight="@dimen/dp8"
                android:minWidth="150dp"
                android:layout_marginHorizontal="@dimen/dp8"
                style="@style/txt_s_b"/>
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewNext"
                android:visibility="gone"
                android:layout_width="200dp"
                android:layout_height="@dimen/cv_default_button_height"
                android:layout_marginTop="16dp"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
