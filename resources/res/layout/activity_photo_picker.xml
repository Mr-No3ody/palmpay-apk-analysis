<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="@color/photograph_colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageButton
            android:id="@+id/backBtn"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/photograph_ic_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="7dp"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#263138"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_picker_title"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/backBtn"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photograph_photo_picker_rv"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/mask_view"
            android:background="#99000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photo_folder_rv"
            android:background="@color/photograph_colorBackground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:background="@color/photograph_colorPrimaryDark"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@+id/photograph_select_album"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/photograph_all_picture"
            android:drawablePadding="5dp"
            android:drawableEnd="@drawable/photograph_select_album"
            android:layout_marginStart="15dp"/>
    </LinearLayout>
</LinearLayout>
