<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llBettingRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp12">
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/qfhdAdView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"
        app:slot_id="@string/betting_deposit_pocker_home_slot_id"/>
    <Space
        android:id="@+id/space_ad_mid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/qfhdAdView"
        app:layout_goneMarginBottom="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp24"
        android:paddingVertical="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@+id/space_ad_mid">
        <com.transsnet.palmpay.betting.ui.view.ModelBillerSelection
            android:id="@+id/billerSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"/>
        <com.transsnet.palmpay.teller.ui.view.ModelBillerTipsInfo
            android:id="@+id/operatorMsgLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"/>
        <com.transsnet.palmpay.custom_view.input.ModelNumberInputLayout
            android:id="@+id/modelInputCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:cv_hint="@string/qt_please_enter_user_id"
            app:cv_input_text_size="@dimen/dp16"
            app:cv_show_error_text="true"
            app:cv_title="@string/qt_user_id"
            app:cv_title_visible="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rvCouponList"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/amountRoot"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBettingAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12"/>
            <com.palmpay.lib.ui.edit.PpAmountEditText
                android:id="@+id/inputAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:layout_marginTop="@dimen/dp6"
                android:layout_marginRight="@dimen/dp12"
                android:layout_centerVertical="true"
                android:inputType="number"
                android:layout_marginHorizontal="@dimen/dp12"
                app:am_edit_error_text_size="@dimen/dp12"
                app:am_edit_hint="@string/qt_s_is_minimum"
                app:am_edit_show_lock="false"
                app:am_edit_show_title="false"
                app:am_edit_text_size="@dimen/dp16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
