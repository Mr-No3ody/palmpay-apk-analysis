<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/qt_airtime_str_log_in"/>
    <ImageView
        android:id="@+id/airtime_provider_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/cv_mobile_wallet_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:textSize="14dp"
        android:id="@+id/airtime_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="24dp"
        android:text="@string/qt_airtime_str_sms_tips"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/airtime_provider_logo"
        style="@style/txt_s_g"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/airtime_sms"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        app:cardBackgroundColor="@color/ppColorBackgroundDark"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/airtime_tips">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="14sp"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="#c0c3c8"
            android:gravity="center_vertical"
            android:id="@+id/airtime_sms_edit"
            android:background="@android:color/transparent"
            android:paddingLeft="14dp"
            android:paddingRight="14sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/qt_airtime_str_hint_enter_verification_code"
            android:inputType="number"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError"
        android:paddingTop="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/airtime_sms"
        app:layout_constraintStart_toStartOf="@+id/airtime_sms"
        app:layout_constraintTop_toBottomOf="@+id/airtime_sms"
        style="@style/txt_mi_g"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorPrimary"
        android:id="@+id/airtime_resend_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/qt_airtime_str_resend_code"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvError"/>
    <com.palmpay.lib.ui.button.PpButton
        android:id="@+id/airtime_login"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:text="@string/qt_airtime_str_log_in"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/airtime_resend_code"
        style="@style/ppButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
