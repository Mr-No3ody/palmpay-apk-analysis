<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="@string/cs_repayment"/>
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/cs_cl_interest_top_txt"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:paddingTop="@dimen/dp24"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:paddingStart="@dimen/dp16"
        android:paddingEnd="@dimen/dp16"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16">
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/in_days_interest_ll"
            android:background="@drawable/cs_oc_before_due_date_bg"
            android:layout_width="116dp"
            android:layout_height="@dimen/dp42"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/csTextview82"
            app:layout_constraintTop_toBottomOf="@+id/csTextview82">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/in_days_interest_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp3"
                android:text="@string/cs_cl_in_day_interest"
                android:layout_toRightOf="@+id/in_days_interest_tv"
                android:layout_alignBottom="@+id/in_days_interest_tv"
                android:layout_marginStart="@dimen/dp2"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/overdue_days_interest_ll"
            android:background="@drawable/cs_oc_after_due_date_bg"
            android:layout_width="207dp"
            android:layout_height="@dimen/dp42"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="@+id/csTextview85"
            app:layout_constraintTop_toBottomOf="@+id/csTextview85">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorError"
                android:gravity="center"
                android:id="@+id/overdue_days_interest_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp24"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/ppColorError"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp3"
                android:text="@string/cs_cl_overdue_interest_day"
                android:layout_toRightOf="@+id/overdue_days_interest_tv"
                android:layout_alignBottom="@+id/overdue_days_interest_tv"
                android:layout_marginStart="@dimen/dp2"/>
        </RelativeLayout>
        <View
            android:id="@+id/csTextview84"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="2dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview85"
            app:layout_constraintEnd_toEndOf="@+id/csTextview144"
            app:layout_constraintStart_toStartOf="@+id/csTextview144"
            app:layout_constraintTop_toTopOf="@+id/csTextview82"/>
        <View
            android:id="@+id/csTextview23"
            android:background="@drawable/cs_oc_before_due_date_indicator_bg"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview82"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/csTextview82"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/csTextview82"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_int_repayment_day"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/csTextview23"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/ppColorError"
            android:id="@+id/csTextview85"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cs_cl_overdue_day"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/csTextview144"
            app:layout_constraintTop_toBottomOf="@+id/in_days_interest_ll"/>
        <View
            android:id="@+id/csTextview144"
            android:background="@drawable/cs_oc_after_due_date_indicator_bg"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/csTextview85"
            app:layout_constraintEnd_toEndOf="@+id/csTextview23"
            app:layout_constraintStart_toStartOf="@+id/csTextview23"
            app:layout_constraintTop_toTopOf="@+id/csTextview85"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
