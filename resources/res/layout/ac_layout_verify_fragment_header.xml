<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/tvSwitchAccount"
        android:layout_width="wrap_content"
        android:layout_height="?android:attr/actionBarSize"
        android:paddingEnd="@dimen/dp16"
        style="@style/txt_s_b"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewAvatar"
        android:padding="0.5dp"
        android:layout_width="@dimen/dp64"
        android:layout_height="@dimen/dp64"
        android:layout_marginTop="@dimen/dp20"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        style="@style/txt_bb_b"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorSuccess"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvAutoLogoutProtection"
        android:background="@drawable/ac_shape_verified_badge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/dp8"
        android:text="@string/ac_auto_logout_protection"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawablePadding="@dimen/dp4"
        android:paddingStart="@dimen/dp8"
        android:paddingEnd="@dimen/dp8"
        app:iiv_start_color="@color/ppColorSuccess"
        app:iiv_start_icon="pay_Security"
        app:iiv_start_size="@dimen/dp16"/>
</LinearLayout>
