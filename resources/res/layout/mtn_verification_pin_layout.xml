<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:id="@+id/mtn_title_txt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#e41c1c"
        android:gravity="center"
        android:id="@+id/mtn_error_msg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/mtn_handle_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtn_pinView"/>
    <com.transsnet.mtn.sdk.ui.view.InputView
        android:id="@+id/mtn_input_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:mtn_input_view_hint="@string/mtn_str_hint_please_enter_the_pin"
        app:mtn_input_view_input_type="password_number"/>
    <com.transsnet.mtn.sdk.ui.view.MTNButton
        android:id="@+id/mtn_submit_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:mtn_button_status="disable"
        app:mtn_button_text="@string/mtn_str_submit"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#3c4abc"
        android:id="@+id/mtn_handle_txt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/mtn_str_choose_verify_method"/>
</LinearLayout>
