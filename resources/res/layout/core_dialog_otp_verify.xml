<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_body"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tvDialogTitle"
        android:background="@drawable/cv_rect_corner_tl_tr_12_bg_white"
        android:paddingLeft="@dimen/dp16"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="Get OTP via Other Methods"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp16"
        android:paddingVertical="@dimen/dp12"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.9ca2aa.14"/>
    <View
        android:id="@+id/viewDivider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/tvDialogTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMethodList"
        android:background="@drawable/cv_rect_corner_bl_br_12_bg_white"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp56"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_cancel"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvMethodList"
        style="@style/Text.202046.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
