<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="16dp"
    android:clipToOutline="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_order_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/view_detail_row"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextAssist"
            android:id="@+id/tv_view_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cv_view_detail"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_view_detail"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="2dp"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="14dp"/>
    </LinearLayout>
</LinearLayout>
