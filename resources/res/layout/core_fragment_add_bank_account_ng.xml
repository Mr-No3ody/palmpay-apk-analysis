<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.core.viewmodel.ModelBankInfoItem
        android:id="@+id/itemBankInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <com.transsnet.palmpay.custom_view.TitleEditView
        android:id="@+id/itemAccountNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_te_enable="false"
        app:cv_te_inputType="bankcode"
        app:cv_te_text_color="@color/ppColorTextPrimary"
        app:cv_te_title="@string/core_bank_account_number"/>
    <com.transsnet.palmpay.custom_view.model.ModelSendSms
        android:id="@+id/itemMobileSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp25"
        android:layout_marginRight="@dimen/dp25"
        app:cv_te_title="@string/core_otp"/>
    <RelativeLayout
        android:id="@+id/caanba_warn_text_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp25"
        android:layout_marginRight="@dimen/dp25">
        <TextView
            android:textSize="@dimen/dp11"
            android:textColor="@color/ppColorTextDisable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp5"
            android:text="@string/core_otp_will_send"
            android:layout_toLeftOf="@+id/caanba_warn_iv"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/caanba_warn_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp2"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_InformationFill"
            app:iiv_size="12dp"/>
    </RelativeLayout>
    <TextView
        android:enabled="false"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/core_next"
        style="@style/txt_b_w"/>
</LinearLayout>
