<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ct_personal_info_4dp_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:paddingTop="30dp"
        android:paddingRight="15dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/avatar_iv"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:id="@+id/note_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#6f7b85"
            android:ellipsize="end"
            android:id="@+id/full_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#6f7b85"
            android:id="@+id/mobile_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/apply_desc_tv"
            android:background="@drawable/ct_request_info_7dp_corner_bg"
            android:paddingLeft="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="@string/ct_add_desc_text"
            android:drawableLeft="@drawable/ct_request_emoji_icon"
            android:drawablePadding="5dp"/>
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/apply_arrow_icon"
            android:background="@drawable/ct_reqeust_desc_bg_arrow_down"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/favorite_bt"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp"
        android:src="@drawable/ct_favorite_selector_bg"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
