<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/lib_ui_date_picker_range_text_color"
        android:gravity="center"
        android:id="@+id/tv_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="8dp"
        android:text="@string/lib_ui_picker_range_dialog_title"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/v_divider_start"
        app:layout_constraintEnd_toStartOf="@+id/tv_to"
        app:layout_constraintHorizontal_weight="1.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"/>
    <View
        android:id="@+id/v_divider_start"
        android:background="@color/ppColorPrimary"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppPickerDividerHeight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_start"
        app:layout_constraintStart_toStartOf="@+id/tv_start"/>
    <View
        android:gravity="center"
        android:id="@+id/tv_to"
        android:background="@color/ppColorTextNormal"
        android:layout_width="8dp"
        android:layout_height="1dp"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="36dp"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_start"
        app:layout_constraintEnd_toStartOf="@+id/tv_end"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_start"
        app:layout_constraintTop_toTopOf="@+id/tv_start"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/pp_date_picker_range_text_color"
        android:gravity="center"
        android:id="@+id/tv_end"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="8dp"
        android:text="End Date"
        app:layout_constraintBottom_toTopOf="@+id/v_divider_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.55"
        app:layout_constraintStart_toEndOf="@+id/tv_to"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"/>
    <View
        android:id="@+id/v_divider_end"
        android:background="#f0f0f0"
        android:layout_width="0dp"
        android:layout_height="@dimen/ppPickerDividerHeight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_end"
        app:layout_constraintStart_toStartOf="@+id/tv_end"/>
</androidx.constraintlayout.widget.ConstraintLayout>
