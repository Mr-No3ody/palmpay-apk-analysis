<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_recently_item"
    android:background="@color/ppColorBackgroundLight"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/ivRecentlyBank"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tvRecipientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toTopOf="@+id/llBankinfo"
        app:layout_constraintEnd_toStartOf="@+id/iivCheck"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llBankinfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iivCheck"
        app:layout_constraintStart_toEndOf="@+id/ivRecentlyBank"
        app:layout_constraintTop_toBottomOf="@+id/tvRecipientName">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:ellipsize="end"
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="@dimen/dp8"
            android:gravity="start|center_vertical"
            android:id="@+id/tvPalmpayUser"
            android:background="@drawable/cv_shape_rect_corner_purple_border_12"
            android:paddingLeft="@dimen/dp6"
            android:paddingRight="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:text="@string/sm_palmpay_user"
            android:layout_marginStart="@dimen/dp6"
            android:paddingHorizontal="@dimen/dp6"
            style="@style/Text.6306b2.10"/>
    </LinearLayout>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iivCheck"
        android:paddingLeft="@dimen/dp8"
        android:paddingTop="@dimen/dp10"
        android:paddingRight="@dimen/dp8"
        android:paddingBottom="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp8"
        android:paddingVertical="@dimen/dp10"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_CircleOutline"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/core_divider_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
