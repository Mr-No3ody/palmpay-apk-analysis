<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.xiaofeidev.shadow.ShadowFrameLayout
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/mm_shape_rectangle_gradient_eae3ff_to_fff"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingVertical="@dimen/dp12">
            <TextView
                android:gravity="left"
                android:id="@+id/tvTips"
                android:layout_width="match_parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.medium.202046.16"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutSecurityGuaranteed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp32"
                app:layout_constraintTop_toBottomOf="@+id/tvTips">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivSecurityGuaranteed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:iiv_color="@color/ppColorSuccess"
                    app:iiv_icon="pay_Security"
                    app:iiv_size="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="#4ac097"
                    android:id="@+id/tvSecurityGuaranteed"
                    android:layout_marginLeft="4dp"
                    android:text="@string/mm_security_guaranteed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ivSecurityGuaranteed"
                    app:layout_constraintRight_toLeftOf="@+id/ivArrowRight"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.6306b2.12"/>
                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivArrowRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    app:iiv_color="@color/ppColorSuccess"
                    app:iiv_icon="pay_ArrowCenterRight"
                    app:iiv_size="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tvSecurityGuaranteed"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/tvAmountTitle"
                android:layout_marginTop="@dimen/dp16"
                android:text="Deposit Amount"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutSecurityGuaranteed"
                style="@style/Text.medium.202046.12"/>
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:id="@+id/rtvInterestRate"
                android:paddingLeft="@dimen/dp4"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="@dimen/dp8"
                app:layout_constraintBottom_toBottomOf="@+id/tvAmountTitle"
                app:layout_constraintLeft_toRightOf="@+id/tvAmountTitle"
                app:layout_constraintTop_toTopOf="@+id/tvAmountTitle"
                app:rtv_background_color="@color/ppColorBackgroundLight"
                app:rtv_border_color="@color/ppColorPrimary"
                app:rtv_border_width="0.5dp"
                app:rtv_corner_radius="4dp"
                style="@style/Text.6306b2.10"/>
            <TextView
                android:id="@+id/tvAmountUnit"
                app:layout_constraintBottom_toBottomOf="@+id/etAmount"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/etAmount"
                style="@style/Text.202046.16"/>
            <com.transsnet.palmpay.custom_view.AmountEditText
                android:textColorHint="@color/ppColorTextDisable"
                android:gravity="center"
                android:id="@+id/etAmount"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginRight="@dimen/dp24"
                android:lines="1"
                android:inputType="number"
                android:textCursorDrawable="@drawable/cv_editor_cursor_purple"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toRightOf="@+id/tvAmountUnit"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAmountTitle"
                style="@style/Text.202046.16"/>
            <View
                android:id="@+id/viewDivider"
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintTop_toBottomOf="@+id/etAmount"/>
            <TextView
                android:textColor="@color/mm_color_ff575c"
                android:gravity="left"
                android:id="@+id/tvAmountError"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="@dimen/dp16"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="@+id/viewDivider"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewDivider"
                style="@style/Text.000000.12"/>
            <TextView
                android:gravity="left"
                android:id="@+id/tvDepositLimitAmountTips"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="@+id/viewDivider"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewDivider"
                style="@style/Text.9ca2aa.12"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tvDepositLimitAmountTips,tvAmountError"/>
            <TextView
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tvPalmpayBalance"
                android:text="@string/mm_plan_palmpay_balance"
                app:layout_constraintLeft_toLeftOf="@+id/barrier"
                app:layout_constraintTop_toBottomOf="@+id/barrier"
                style="@style/Text.858a8f.12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clsAddMoney"
                android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                android:paddingLeft="16dp"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="16dp"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="@dimen/dp8"
                app:layout_constraintLeft_toLeftOf="@+id/tvPalmpayBalance"
                app:layout_constraintTop_toBottomOf="@+id/tvPalmpayBalance">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insufficient Balance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.12"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:textColor="@color/ppColorPrimary"
                    android:id="@+id/tvAddMoney"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="add money"
                    android:drawablePadding="4dp"
                    app:iiv_end_color="@color/ppColorPrimary"
                    app:iiv_end_icon="pay_ArrowCenterRight"
                    app:iiv_end_size="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.858a8f.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cls_withdraw"
                android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
                android:paddingLeft="16dp"
                android:paddingTop="@dimen/dp8"
                android:paddingRight="16dp"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="@dimen/dp8"
                app:layout_constraintLeft_toLeftOf="@+id/tvPalmpayBalance"
                app:layout_constraintTop_toBottomOf="@+id/tvPalmpayBalance">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Withdraw to"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.12"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PalmPay Balance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.github.xiaofeidev.shadow.ShadowFrameLayout>
    <com.github.xiaofeidev.shadow.ShadowFrameLayout
        android:id="@+id/layoutInterrestShow"
        android:background="@color/ppColorBackgroundDark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/space">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/cv_shape_rect_corner_12_bg_white"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp12"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <TextView
                android:id="@+id/tvEstimatedInterest"
                android:text="Estimated interest return"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Text.202046.12"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivWarn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_InformationOutline"
                app:iiv_size="@dimen/dp16"
                app:layout_constraintBottom_toBottomOf="@+id/tvEstimatedInterest"
                app:layout_constraintLeft_toRightOf="@+id/tvEstimatedInterest"
                app:layout_constraintTop_toTopOf="@+id/tvEstimatedInterest"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layoutEstimatedInterestReturnList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:divider="@drawable/mm_estimated_interest_return_divider"
                android:showDividers="middle"
                app:layout_constraintTop_toBottomOf="@+id/tvEstimatedInterest"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.github.xiaofeidev.shadow.ShadowFrameLayout>
</LinearLayout>
