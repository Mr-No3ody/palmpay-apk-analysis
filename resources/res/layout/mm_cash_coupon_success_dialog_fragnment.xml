<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/mm_bg_common_dialog"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:paddingBottom="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp56"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="right"
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="40dp"
            android:textStyle="bold"
            android:textColor="@color/ppColorSuccess"
            android:id="@+id/tvCouponAmount"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="35dp"
            android:layout_marginRight="@dimen/dp12"
            android:includeFontPadding="false"
            style="@style/Text.medium.6306b2.26"/>
        <TextView
            android:id="@+id/tvProductName"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:text="Has been paid into your CashBox"
            style="@style/Text.medium.202046.18"/>
        <TextView
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvTotalBackAmount"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:text="Save in CashBox and grow your money every day"
            style="@style/Text.6f7b85.14"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <com.transsnet.palmpay.custom_view.RoundedTextView
                android:textColor="@color/md_white_1000"
                android:id="@+id/rtvCreateNew"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp48"
                android:text="Save More"
                android:layout_weight="1"
                app:rtv_background_color="@color/mm_color_6306b2"
                app:rtv_corner_radius="@dimen/dp12"
                style="@style/Text.medium.ffffff.16"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mm_cash_coupon_success"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
