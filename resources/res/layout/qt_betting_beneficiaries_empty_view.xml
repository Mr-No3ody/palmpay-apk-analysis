<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/qbev_iv"
            android:layout_width="@dimen/dp80"
            android:layout_height="@dimen/dp80"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/cv_empty_no_palmpay_contacts"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/qbev_add_betting_info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_add_beneticary_tips"
            android:paddingStart="@dimen/dp45"
            android:paddingEnd="@dimen/dp45"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/qbev_add_betting_empty_tv"
            android:background="@drawable/cv_shape_round_corner_secondary"
            android:paddingTop="@dimen/dp6"
            android:paddingBottom="@dimen/dp6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp24"
            android:text="@string/core_add_more_beneficiary"
            android:drawablePadding="@dimen/dp4"
            android:paddingStart="@dimen/dp16"
            android:paddingEnd="@dimen/dp16"
            android:paddingVertical="@dimen/dp6"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_Add"
            app:iiv_start_size="@dimen/dp16"
            style="@style/txt_s_b_b"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
