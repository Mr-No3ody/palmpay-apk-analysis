<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/oc_no_lock_sad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                app:slot_id="@string/oc_no_lock_ad_slot_id"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_oc_in_order_to_enjoy"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"
                android:paddingHorizontal="@dimen/dp12">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/dp32"
                        android:layout_height="@dimen/dp32"
                        android:src="@drawable/cs_oc_phone_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp8">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_device_information"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_access_to_your_phone_number"
                            android:drawablePadding="@dimen/dp8"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24">
                    <ImageView
                        android:layout_width="@dimen/dp32"
                        android:layout_height="@dimen/dp32"
                        android:src="@drawable/cs_oc_location_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp8">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_permission_location"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:id="@+id/gsp_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_gps_location_services_how"
                            android:drawablePadding="@dimen/dp8"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24">
                    <ImageView
                        android:layout_width="@dimen/dp32"
                        android:layout_height="@dimen/dp32"
                        android:src="@drawable/cs_oc_contact_new_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp8">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_contact_list"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:id="@+id/contact_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_phone_contact_list_how"
                            android:drawablePadding="@dimen/dp8"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24">
                    <ImageView
                        android:layout_width="@dimen/dp32"
                        android:layout_height="@dimen/dp32"
                        android:src="@drawable/cs_oc_camera_icon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp8">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_camera_and_photos"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:id="@+id/camera_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_device_camera_and_photos_how"
                            android:drawablePadding="@dimen/dp8"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/ppColorButtonTextWhite"
                android:id="@+id/next_bt"
                android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp44"
                android:layout_marginTop="32dp"
                android:text="@string/cs_oc_active_overdraft"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/oc_proto_cl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginBottom="@dimen/dp24">
                <CheckBox
                    android:id="@+id/introduce_proto_cb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@drawable/cs_oc_check_ibt_bg"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/introduce_proto_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cs_i_agree_to"
                    android:lineSpacingExtra="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/introduce_proto_cb"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
