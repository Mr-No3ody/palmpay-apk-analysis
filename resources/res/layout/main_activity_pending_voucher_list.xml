<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:orientation="vertical"
        android:id="@+id/viewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/large_margin"
        android:layout_marginEnd="@dimen/large_margin"
        app:cardBackgroundColor="@color/ppColorPrimary"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22dp"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/core_voucher"
                android:textAllCaps="true"
                style="@style/txt_s_w"/>
            <androidx.cardview.widget.CardView
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#ff720de1"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/main_click_go_to_receive_or_open"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/viewMoneyTransfer"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="30dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/textViewMoneyTransferNo"
                    android:background="@drawable/cv_shape_rect_corner_tl_bl_4_bg_white"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/cv_banner_divider"
                    android:scaleType="fitXY"/>
                <RelativeLayout
                    android:background="@drawable/cv_shape_rect_corner_right_white"
                    android:paddingLeft="10dp"
                    android:paddingRight="@dimen/dp15"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="10dp"
                    android:paddingEnd="@dimen/dp15">
                    <TextView
                        android:textStyle="italic"
                        android:gravity="center"
                        android:id="@+id/textViewGo1"
                        android:background="@drawable/cv_shape_circle_gradient_purple"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="@string/core_go"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/txt_l_w"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/textViewLine11"
                        android:paddingTop="17dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_money_transfer_2"
                        android:layout_toLeftOf="@+id/textViewGo1"
                        android:layout_toStartOf="@+id/textViewGo1"
                        style="@style/txt_b_b"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_waiting_to_receive"
                        android:layout_toLeftOf="@+id/textViewGo1"
                        android:layout_below="@+id/textViewLine11"
                        android:layout_toStartOf="@+id/textViewGo1"
                        style="@style/txt_mi_g"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/viewLuckyMoney"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textSize="30dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:id="@+id/textViewLuckMoneyNo"
                    android:background="@drawable/cv_shape_rect_corner_tl_bl_4_bg_white"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/cv_banner_divider"
                    android:scaleType="fitXY"/>
                <RelativeLayout
                    android:background="@drawable/cv_shape_rect_corner_right_white"
                    android:paddingLeft="10dp"
                    android:paddingRight="@dimen/dp15"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="10dp"
                    android:paddingEnd="@dimen/dp15">
                    <TextView
                        android:textStyle="italic"
                        android:gravity="center"
                        android:id="@+id/textViewGo2"
                        android:background="@drawable/cv_shape_circle_gradient_purple"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:text="@string/core_go"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/txt_l_w"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/textViewLine21"
                        android:paddingTop="17dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/core_lucky_money"
                        android:layout_toLeftOf="@+id/textViewGo2"
                        android:layout_toStartOf="@+id/textViewGo2"
                        style="@style/txt_b_b"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_waiting_to_open"
                        android:layout_toLeftOf="@+id/textViewGo2"
                        android:layout_below="@+id/textViewLine21"
                        android:layout_toStartOf="@+id/textViewGo2"
                        style="@style/txt_mi_g"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="2dp"
        app:iiv_color="@color/ppColorBackgroundLight"
        app:iiv_icon="pay_CloseOutline"
        app:iiv_size="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
