<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ac_sign_up_reward"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cv_rect_bg_white_corner_bl_br_24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/ivIcon"
        app:layout_constraintStart_toStartOf="@+id/ivIcon"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon">
        <TextView
            android:textSize="@dimen/dp16"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don&apos;t miss it!"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            style="@style/txt_b_b_b"/>
        <TextView
            android:gravity="center"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_signup_reward_dialog_back_title"
            style="@style/txt_s_g"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:paddingBottom="@dimen/dp24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp24">
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/tvGiveUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/core_give_up"
                android:layout_weight="1"
                style="@style/ppSecondaryButtonStyle"/>
            <View
                android:layout_width="@dimen/dp16"
                android:layout_height="1dp"/>
            <com.palmpay.lib.ui.button.PpButton
                android:gravity="center"
                android:id="@+id/tvUseCoupon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/ac_use_coupon"
                android:layout_weight="1"
                style="@style/ppButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
