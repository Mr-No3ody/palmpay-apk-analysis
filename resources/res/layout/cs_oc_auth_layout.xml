<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="Flexi Authorisation"/>
    <ScrollView
        android:background="@color/ppColorBackgroundLight"
        android:paddingBottom="@dimen/dp5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview29"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:text="@string/cs_auth_top_tips"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/oc_bill_mtb"/>
            <View
                android:id="@+id/csView6"
                android:background="@drawable/cs_oc_auth_item_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview31"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/csTextview30"/>
            <ImageView
                android:id="@+id/csImageview15"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginTop="20dp"
                android:src="@drawable/cs_oc_deivce_icon"
                android:layout_marginStart="44dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/csTextview30"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview30"
                android:paddingTop="@dimen/dp20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cs_device_info"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview15"
                app:layout_constraintTop_toBottomOf="@+id/csTextview29"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/csTextview31"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_device_content"
                android:layout_marginEnd="44dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/csTextview30"
                app:layout_constraintTop_toBottomOf="@+id/csTextview30"/>
            <View
                android:id="@+id/csView7"
                android:background="@drawable/cs_oc_auth_item_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview33"
                app:layout_constraintEnd_toEndOf="@+id/csView6"
                app:layout_constraintStart_toStartOf="@+id/csView6"
                app:layout_constraintTop_toTopOf="@+id/csTextview32"/>
            <ImageView
                android:id="@+id/csImageview16"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="@+id/csImageview15"
                app:layout_constraintTop_toTopOf="@+id/csTextview32"
                app:srcCompat="@drawable/cs_oc_location_icon"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview32"
                android:paddingTop="@dimen/dp20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/cs_location_title"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview16"
                app:layout_constraintTop_toBottomOf="@+id/csTextview31"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/csTextview33"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_location_content"
                app:layout_constraintEnd_toEndOf="@+id/csTextview31"
                app:layout_constraintStart_toStartOf="@+id/csTextview32"
                app:layout_constraintTop_toBottomOf="@+id/csTextview32"/>
            <View
                android:id="@+id/csView8"
                android:background="@drawable/cs_oc_auth_item_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview35"
                app:layout_constraintEnd_toEndOf="@+id/csView7"
                app:layout_constraintStart_toStartOf="@+id/csView7"
                app:layout_constraintTop_toTopOf="@+id/csTextview34"/>
            <ImageView
                android:id="@+id/csImageview17"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginTop="@dimen/dp20"
                app:layout_constraintStart_toStartOf="@+id/csImageview16"
                app:layout_constraintTop_toTopOf="@+id/csTextview34"
                app:srcCompat="@drawable/cs_oc_contact_icon"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview34"
                android:paddingTop="@dimen/dp20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/cs_contacts_info"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview17"
                app:layout_constraintTop_toBottomOf="@+id/csTextview33"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/csTextview35"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_contacts_content"
                app:layout_constraintEnd_toEndOf="@+id/csTextview33"
                app:layout_constraintStart_toStartOf="@+id/csTextview34"
                app:layout_constraintTop_toBottomOf="@+id/csTextview34"/>
            <View
                android:id="@+id/csView9"
                android:background="@drawable/cs_oc_auth_item_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/csTextview37"
                app:layout_constraintEnd_toEndOf="@+id/csView8"
                app:layout_constraintStart_toStartOf="@+id/csView8"
                app:layout_constraintTop_toTopOf="@+id/csTextview36"/>
            <ImageView
                android:id="@+id/csImageview18"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginTop="@dimen/dp20"
                app:layout_constraintStart_toStartOf="@+id/csImageview17"
                app:layout_constraintTop_toTopOf="@+id/csTextview36"
                app:srcCompat="@drawable/cs_oc_camera_icon"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview36"
                android:paddingTop="@dimen/dp20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/cs_access_to_camera"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/csImageview18"
                app:layout_constraintTop_toBottomOf="@+id/csTextview35"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextDisable"
                android:id="@+id/csTextview37"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_camera_permission"
                app:layout_constraintEnd_toEndOf="@+id/csTextview35"
                app:layout_constraintStart_toStartOf="@+id/csTextview36"
                app:layout_constraintTop_toBottomOf="@+id/csTextview36"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/csTextview38"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cs_auth_bottom_tips"
                app:layout_constraintEnd_toEndOf="@+id/csView9"
                app:layout_constraintStart_toStartOf="@+id/csView9"
                app:layout_constraintTop_toBottomOf="@+id/csView9"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <Button
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/auth_bt"
        android:background="@drawable/cs_oc_agree_bt_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="12dp"
        android:text="@string/cs_authorise"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/csTextview38"
        app:layout_constraintStart_toStartOf="@+id/csTextview38"
        app:layout_constraintTop_toBottomOf="@+id/csTextview38"/>
</LinearLayout>
