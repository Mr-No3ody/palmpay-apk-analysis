<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp72"
    android:paddingStart="@dimen/large_margin">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mp_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/mp_tv_left2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/mp_tv_left1"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp4"
                android:paddingEnd="5dp"/>
            <TextView
                android:textSize="@dimen/dp8"
                android:textColor="@color/ppColorTextBase"
                android:gravity="center"
                android:id="@+id/mp_tv_new_tag"
                android:background="@drawable/core_new_tag"
                android:visibility="gone"
                android:layout_width="@dimen/dp22"
                android:layout_height="@dimen/dp11"
                android:text="@string/main_new"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/mp_tv_left2"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="5dp"
        app:layout_constraintStart_toStartOf="@+id/mp_ll"
        app:layout_constraintTop_toBottomOf="@+id/mp_ll"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewNext"
        android:paddingTop="@dimen/dp10"
        android:paddingRight="@dimen/dp10"
        android:paddingBottom="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp2"
        android:layout_marginEnd="@dimen/dp2"
        android:paddingVertical="@dimen/dp10"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="@dimen/dp20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageViewAvatar"
        android:visibility="gone"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:src="@drawable/cv_avatar_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageViewNext"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextAssist"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/mp_tv_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp10"
        app:layout_constraintBottom_toBottomOf="@+id/mp_ll"
        app:layout_constraintEnd_toStartOf="@+id/imageViewNext"
        app:layout_constraintStart_toEndOf="@+id/mp_ll"
        app:layout_constraintTop_toTopOf="@+id/mp_ll"
        app:layout_goneMarginEnd="@dimen/dp15"/>
    <View
        android:id="@+id/mp_view_top_line"
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="@dimen/dp15"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mp_view_bottom_line"
        android:background="@color/ppColorDividerLine"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="@dimen/dp15"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
