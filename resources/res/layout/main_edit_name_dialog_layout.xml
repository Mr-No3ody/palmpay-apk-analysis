<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_8_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewClose"
        android:padding="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/large_margin"
        android:paddingTop="30dp"
        android:paddingRight="@dimen/large_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="260dp"
        android:paddingStart="@dimen/large_margin"
        android:paddingEnd="@dimen/large_margin">
        <TextView
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_edit_name"
            style="@style/txt_b_b"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/main_first_name"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputMiddleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_required="false"
            app:cv_te_title="@string/main_middle_name"/>
        <com.transsnet.palmpay.custom_view.TitleEditView
            android:id="@+id/inputLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="0dp"
            app:cv_max_length="@integer/max_name_length"
            app:cv_te_inputType="text"
            app:cv_te_title="@string/main_last_name"/>
        <com.palmpay.lib.ui.form.PpFormVertical
            android:id="@+id/editNickName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/dp10"
            app:form_edit_input_type="text"
            app:form_edit_max_length="@integer/max_nick_name_length"
            app:form_hide_text="Enter nick name"
            app:form_label_text="@null"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/textViewComplete"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/large_margin"
            android:layout_marginBottom="24dp"
            android:text="@string/main_confirm"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
</RelativeLayout>
