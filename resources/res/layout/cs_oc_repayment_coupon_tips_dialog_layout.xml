<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_16_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/coupon_tips_close_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_oc_dialog_close_icon"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/csTextview119"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cs_oc_different_repayment_coupons"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coupon_tips_close_img"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview121"
        android:background="@drawable/cs_oc_repayment_coupon_left_title_bg"
        android:paddingTop="@dimen/dp10"
        android:paddingBottom="@dimen/dp10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cs_coupon_name"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="@dimen/dp10"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline4"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toBottomOf="@+id/csTextview119"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview135"
        android:background="@drawable/cs_oc_repayment_coupon_right_title_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/cs_reducing_parts"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview121"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csGuideline4"
        app:layout_constraintTop_toTopOf="@+id/csTextview121"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview136"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cs_flexi_repayment_slash"
        android:paddingVertical="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline4"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toBottomOf="@+id/csTextview121"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/csTextview138"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/cs_flexi_repayment_slash_content"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview136"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csGuideline4"
        app:layout_constraintTop_toTopOf="@+id/csTextview136"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview147"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cs_flexi_interest_slash"
        android:paddingVertical="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline4"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toBottomOf="@+id/csTextview136"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/csTextview148"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/cs_flexi_interest_slash_content"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview147"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csGuideline4"
        app:layout_constraintTop_toTopOf="@+id/csTextview147"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/csTextview149"
        android:paddingTop="@dimen/dp8"
        android:paddingBottom="@dimen/dp8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cs_flexi_penalty_slash"
        android:paddingVertical="@dimen/dp8"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline4"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toBottomOf="@+id/csTextview147"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:id="@+id/csTextview150"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/cscs_flexi_penalty_slash_content"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview149"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csGuideline4"
        app:layout_constraintTop_toTopOf="@+id/csTextview149"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/csGuideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/csGuideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="24dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/csGuideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="24dp"/>
    <View
        android:id="@+id/csView"
        android:background="@color/ppColorDividerLine"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/csView15"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csTextview121"
        app:layout_constraintTop_toTopOf="@+id/csTextview121"/>
    <View
        android:id="@+id/csView25"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview136"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csView15"
        app:layout_constraintTop_toBottomOf="@+id/csTextview136"/>
    <View
        android:id="@+id/second_hor_divider_view"
        android:background="@color/ppColorDividerLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview147"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csView15"
        app:layout_constraintTop_toBottomOf="@+id/csTextview147"/>
    <View
        android:id="@+id/csView15"
        android:background="@drawable/cs_oc_repayment_coupon_content_bg"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/csTextview149"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toTopOf="@+id/csTextview121"/>
    <TextView
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/coupon_tips_confirm_tv"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/core_confirm"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toStartOf="@+id/csGuideline7"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/csGuideline6"
        app:layout_constraintTop_toBottomOf="@+id/csTextview149"/>
</androidx.constraintlayout.widget.ConstraintLayout>
