<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f6f6f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/bill_detail_abl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="#f6f6f6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp16"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/oc_bill_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#858a8f"
                            android:id="@+id/all_active_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cs_all_active_bill"
                            android:drawableEnd="@drawable/cs_cl_view_loan_arrow_icon"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <View
                            android:id="@+id/csView22"
                            android:background="@color/ppColorBackgroundDark"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/oc_bill_tips_tv"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/csTextview12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cs_oc_total_outstanding_amount"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/csView22"/>
                        <TextView
                            android:textSize="32sp"
                            android:id="@+id/oc_outstanding_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/csTextview12"
                            style="@style/txt_number_s_b_b"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextNormal"
                            android:id="@+id/oc_overdue_top_tv"
                            android:background="@drawable/cs_due_in_bg"
                            android:paddingTop="@dimen/dp2"
                            android:paddingBottom="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_due_in"
                            android:paddingStart="@dimen/dp5"
                            android:paddingEnd="@dimen/dp5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/oc_outstanding_amount_tv"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextDisable"
                            android:gravity="center"
                            android:id="@+id/csTextview14"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cs_oc_spent"
                            app:layout_constraintEnd_toStartOf="@+id/oc_penalty_interest_tv"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintHorizontal_chainStyle="spread_inside"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/oc_overdue_top_tv"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextDisable"
                            android:gravity="center"
                            android:id="@+id/oc_repaid_title_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_repaid"
                            app:layout_constraintBottom_toBottomOf="@+id/oc_penalty_interest_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/oc_penalty_interest_tv"
                            app:layout_constraintTop_toTopOf="@+id/oc_penalty_interest_tv"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/oc_bill_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:layout_constraintEnd_toEndOf="@+id/csTextview14"
                            app:layout_constraintStart_toStartOf="@+id/csTextview14"
                            app:layout_constraintTop_toBottomOf="@+id/csTextview14"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/oc_bill_repaid_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="@+id/oc_bill_amount_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/oc_repaid_title_tv"
                            app:layout_constraintTop_toTopOf="@+id/oc_bill_amount_tv"
                            app:layout_constraintVertical_bias="0"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cs_interest_txt_title_color"
                            android:gravity="center"
                            android:id="@+id/oc_penalty_interest_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_interest"
                            android:drawablePadding="@dimen/dp5"
                            android:drawableEnd="@drawable/cs_oc_interest_question_icon"
                            android:paddingStart="@dimen/dp5"
                            app:layout_constraintBottom_toBottomOf="@+id/csTextview14"
                            app:layout_constraintEnd_toStartOf="@+id/oc_repaid_title_tv"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/csTextview14"
                            app:layout_constraintTop_toTopOf="@+id/csTextview14"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cs_interest_txt_color"
                            android:id="@+id/interest_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:layout_constraintEnd_toEndOf="@+id/oc_penalty_interest_tv"
                            app:layout_constraintStart_toStartOf="@+id/oc_penalty_interest_tv"
                            app:layout_constraintTop_toBottomOf="@+id/oc_penalty_interest_tv"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/detail_group"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="csTextview14,oc_bill_amount_tv,oc_penalty_interest_tv,interest_amount_tv,                             oc_repaid_title_tv,oc_bill_repaid_amount_tv"/>
                        <ImageView
                            android:id="@+id/bill_more_img"
                            android:padding="@dimen/dp8"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/interest_amount_tv"
                            app:srcCompat="@drawable/cs_oc_installment_down_icon"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/ppColorTextPrimary"
                        android:id="@+id/csTextview20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/cs_oc_bill_detail"
                        android:layout_marginStart="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/csTextview"/>
                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16">
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/cs_main_color"
                            android:gravity="center"
                            android:id="@+id/all_tv"
                            android:background="@drawable/cs_oc_bill_type_selected"
                            android:layout_width="@dimen/dp48"
                            android:layout_height="@dimen/dp28"
                            android:text="@string/cs_oc_bill_all"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/instalment_tv"
                            android:background="@drawable/cs_oc_bill_type_unselected"
                            android:layout_width="@dimen/dp86"
                            android:layout_height="@dimen/dp28"
                            android:text="@string/cs_oc_instalment"
                            android:layout_marginStart="@dimen/dp8"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/refund_tv"
                            android:background="@drawable/cs_oc_bill_type_unselected"
                            android:layout_width="@dimen/dp86"
                            android:layout_height="@dimen/dp28"
                            android:text="@string/cs_oc_bill_refund"
                            android:layout_marginStart="@dimen/dp8"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/ppColorTextPrimary"
                            android:gravity="center"
                            android:id="@+id/repaid_tv"
                            android:background="@drawable/cs_oc_bill_type_unselected"
                            android:layout_width="@dimen/dp86"
                            android:layout_height="@dimen/dp28"
                            android:text="@string/cs_oc_bill_repaid"
                            android:layout_marginStart="@dimen/dp8"/>
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/bill_detail_float_collapse_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:background="@color/ppColorBackgroundLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/csTextview16"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_oc_total_outstanding_amount"
                            android:layout_marginStart="16dp"
                            app:layout_constraintEnd_toStartOf="@+id/float_overdue_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="24sp"
                            android:id="@+id/float_outstanding_amount_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp4"
                            app:layout_constraintEnd_toStartOf="@+id/float_overdue_tv"
                            app:layout_constraintStart_toStartOf="@+id/csTextview16"
                            app:layout_constraintTop_toBottomOf="@+id/csTextview16"
                            style="@style/txt_number_s_b_b"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorError"
                            android:id="@+id/float_overdue_tv"
                            android:background="@drawable/cs_oc_overdue_txt_bg"
                            android:paddingTop="@dimen/dp3"
                            android:paddingBottom="@dimen/dp3"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/dp4"
                            android:paddingEnd="@dimen/dp4"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintBottom_toBottomOf="@+id/float_outstanding_amount_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/csTextview16"/>
                        <com.google.android.flexbox.FlexboxLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp16"
                            android:layout_marginBottom="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/float_overdue_tv"
                            app:layout_constraintStart_toStartOf="@+id/float_outstanding_amount_tv"
                            app:layout_constraintTop_toBottomOf="@+id/float_outstanding_amount_tv">
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/float_all_tv"
                                android:background="@drawable/cs_oc_bill_type_unselected"
                                android:layout_width="@dimen/dp48"
                                android:layout_height="@dimen/dp28"
                                android:text="All"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/float_instalment_tv"
                                android:background="@drawable/cs_oc_bill_type_unselected"
                                android:layout_width="@dimen/dp86"
                                android:layout_height="@dimen/dp28"
                                android:text="Installment"
                                android:layout_marginStart="@dimen/dp8"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/float_refund_tv"
                                android:background="@drawable/cs_oc_bill_type_unselected"
                                android:layout_width="@dimen/dp86"
                                android:layout_height="@dimen/dp28"
                                android:text="Refund"
                                android:layout_marginStart="@dimen/dp8"/>
                            <TextView
                                android:textSize="@dimen/dp14"
                                android:textColor="@color/ppColorTextPrimary"
                                android:gravity="center"
                                android:id="@+id/float_repaid_tv"
                                android:background="@drawable/cs_oc_bill_type_unselected"
                                android:layout_width="@dimen/dp86"
                                android:layout_height="@dimen/dp28"
                                android:text="Repaid"
                                android:layout_marginStart="@dimen/dp8"/>
                        </com.google.android.flexbox.FlexboxLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/rv_content"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/oc_bill_rv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/oc_instalment_bill_rv"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/ppColorTextBase"
            android:id="@+id/oc_bill_pay_bt"
            android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="14dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp14"
            android:text="@string/cs_oc_repay"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/interest_amount_tv"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
</LinearLayout>
