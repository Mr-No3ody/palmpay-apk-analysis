<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivTopDecoration"
        android:layout_width="228dp"
        android:layout_height="112dp"
        android:contentDescription="@null"
        android:elevation="@dimen/dp10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cs_cl_dialog_top_bj"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDialogBody"
        android:background="@drawable/cs_cl_increase_credit_limit_high_quality_dialog_bg"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivIncreaseAmountClose"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_marginTop="@dimen/dp12"
            android:contentDescription="@string/core_cancel"
            android:layout_marginEnd="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cs_cl_automatic_debit_dialog_close"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/cs_cl_high_quality_title_gold"
            android:gravity="center"
            android:id="@+id/tvHighQualityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/cs_cl_high_quality_congratulation"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivIncreaseAmountClose"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutGoldCard"
            android:background="@drawable/cs_cl_increase_credit_limit_high_quality_amount_dialog_bg"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp16"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp18"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHighQualityTitle">
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/cs_cl_high_quality_card_text"
                android:id="@+id/tvLoanableLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_cl_high_quality_your_loanable_amount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layoutAmountRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLoanableLabel">
                <TextView
                    android:textSize="@dimen/dp18"
                    android:textColor="@color/cs_cl_high_quality_card_text"
                    android:id="@+id/tvCurrencySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="@dimen/dp40"
                    android:textColor="@color/cs_cl_high_quality_card_text"
                    android:id="@+id/tvIncreaseDialogAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp4"
                    style="@style/txt_number_s_b_b"/>
                <ImageView
                    android:id="@+id/ivAmountArrow"
                    android:layout_width="@dimen/dp17"
                    android:layout_height="@dimen/dp14"
                    android:contentDescription="@null"
                    android:layout_marginStart="@dimen/dp4"
                    app:srcCompat="@drawable/cs_cl_amount_increase_arrow_up_v2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layoutExclusiveBadge"
                android:background="@drawable/cs_cl_high_quality_exclusive_badge_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutAmountRow">
                <ImageView
                    android:id="@+id/ivExclusiveIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/cs_cl_exclusive_super_elite_customer"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/tvIncreaseAmountBtn"
                android:background="@drawable/cs_cl_increase_credit_limit_high_quality_btn_dialog_bg"
                android:layout_width="219dp"
                android:layout_height="@dimen/dp48"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_cl_borrow"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutExclusiveBadge"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
