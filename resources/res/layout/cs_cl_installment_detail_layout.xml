<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_title="Loan Overview"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/cs_color_cl_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/csTextview118"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_remain_outstanding"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/total_installment_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="@+id/csTextview118"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview118"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ppColorTextDisable"
                    android:id="@+id/extended_tag_tv"
                    android:background="@drawable/cv_shape_rect_corner_4_bg_dark"
                    android:paddingLeft="@dimen/dp4"
                    android:paddingRight="@dimen/dp4"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_extended"
                    android:paddingHorizontal="@dimen/dp4"
                    app:layout_constraintBottom_toBottomOf="@+id/total_installment_amount_tv"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/pay_in_tv"
                    android:background="@drawable/cs_oc_pay_in_txt_bg"
                    android:padding="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/csTextview123"
                    android:background="@color/ppColorBackgroundDark"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/total_installment_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/csTextview134"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15"
                    android:text="@string/cs_cl_installment_unpaid_principal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview123"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/principal_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/csTextview134"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/csTextview134"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/principal_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="csTextview134, principal_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/unpaid_interest_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cs_cl_installment_unpaid_interest"
                    android:drawablePadding="@dimen/dp4"
                    android:drawableEnd="@drawable/cs_cl_info_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/csTextview134"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/interest_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/unpaid_interest_title_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/unpaid_interest_title_tv"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/interest_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="unpaid_interest_title_tv, interest_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/unpaid_service_fee_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cs_cl_installment_unpaid_service"
                    android:drawablePadding="@dimen/dp4"
                    android:drawableEnd="@drawable/cs_cl_info_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/unpaid_interest_title_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/unpaid_service_fee_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/unpaid_service_fee_title_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/unpaid_service_fee_title_tv"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/service_fee_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="unpaid_service_fee_title_tv, unpaid_service_fee_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/unpaid_penalty_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cs_cl_installment_unpaid_penalty"
                    android:drawablePadding="@dimen/dp4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/unpaid_service_fee_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/unpaid_penalty_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/unpaid_penalty_title_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/unpaid_penalty_title_tv"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/overdue_interest_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="unpaid_penalty_title_tv, unpaid_penalty_amount_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/extension_fee_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cs_cl_extension_fee"
                    android:drawablePadding="@dimen/dp4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/unpaid_penalty_title_tv"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/extension_fee_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/extension_fee_title_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/extension_fee_title_tv"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/extension_fee_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="extension_fee_title_tv, extension_fee_amount_tv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/loan_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_installment_loan_amount"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/loan_detail_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_ins_details"
                    android:drawableEnd="@drawable/cs_cl_view_loan_arrow_icon"
                    app:drawableEndCompat="@drawable/cs_cl_view_loan_arrow_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/loan_amount_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/loan_amount_tv"/>
                <View
                    android:id="@+id/divider_view"
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/loan_amount_tv"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:id="@+id/repayment_amount_rv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/cs_cl_installment_repaid_amount"
                    android:drawablePadding="@dimen/dp4"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider_view"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/repayment_record_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_cl_ins_repayment_record"
                    android:drawableEnd="@drawable/cs_cl_view_loan_arrow_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/repayment_amount_rv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/repayment_amount_rv"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/paid_off_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/cs_cl_statement"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/installment_rv"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_marginStart="@dimen/dp16"
                android:layout_marginEnd="@dimen/dp16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/extend_info_ll"
                android:background="@drawable/cv_shape_rect_corner_8_bg_white"
                android:padding="@dimen/dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/ppColorTextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extension Information"
                    android:fontFamily="sans-serif-medium"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extension Amount"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/extend_amount_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#858a8f"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extension Repayment Date"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ppColorTextPrimary"
                        android:gravity="end"
                        android:id="@+id/extend_repayment_date_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/installment_repay_ll"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/cv_color_ffffff"
            android:id="@+id/oc_installment_pay_bt"
            android:background="@drawable/cs_cl_bw_next_bt_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="@dimen/dp14"
            android:text="@string/cs_oc_repay"
            android:textAllCaps="false"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/interest_amount_tv"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
</LinearLayout>
