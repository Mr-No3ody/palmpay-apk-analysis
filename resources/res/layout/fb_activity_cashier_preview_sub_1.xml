<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fb_ll_pay_amount"
    android:background="@drawable/fb_rect_bg_white_corner_tl_tr_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constrainedHeight="true"
    app:layout_constraintBottom_toTopOf="@+id/fb_ll_cashier_confirm_to_pay"
    app:layout_constraintTop_toBottomOf="@+id/fb_view_top_transparent_bg"
    app:layout_constraintVertical_bias="1"
    app:layout_constraintVertical_chainStyle="packed">
    <FrameLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp16">
        <TextView
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fb_payment"
            style="@style/fb_Text.medium.202046.16"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/fb_iv_close"
            android:layout_width="@dimen/fb_dp24"
            android:layout_height="@dimen/fb_dp24"
            android:layout_marginEnd="@dimen/fb_dp16"
            app:iiv_color="@color/fb_color_95a1ab"
            app:iiv_icon="pay_Close"
            app:iiv_size="@dimen/fb_dp20"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/fb_dp28"
        android:textColor="@color/fb_base_colorPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_tv_pay_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp16"
        style="@style/fb_txt_number_s_b_b"/>
    <TextView
        android:textColor="@color/fb_base_gray_2_color"
        android:gravity="center"
        android:id="@+id/fb_tv_save_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp4"
        style="@style/fb_txt_number_s_b_b"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/fb_nsv_payment_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/fb_dp12"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fb_ll_payment_info_body"
                android:paddingTop="@dimen/fb_dp6"
                android:paddingBottom="@dimen/fb_dp6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/fb_dp6">
                <ViewStub
                    android:id="@+id/fb_previewOrderAmountItemStub"
                    android:layout="@layout/fb_layout_cashier_preview_order_amount_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/fb_previewFeeAmountItemStub"
                    android:layout="@layout/fb_layout_cashier_preview_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/fb_previewTaxesAmountItemStub"
                    android:layout="@layout/fb_layout_cashier_preview_fee_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fb_ll_payment_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:id="@+id/fb_previewEarlyRefundItemStub"
                    android:layout="@layout/fb_layout_cashier_preview_early_refund_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/fb_layoutMiddle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/fb_vs_extra_layout"
                    android:inflatedId="@+id/fb_vs_extra_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_dp12"/>
                <ViewStub
                    android:id="@+id/fb_previewPromotionItemStub"
                    android:layout="@layout/fb_layout_cashier_preview_promotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/fb_dp16"
                    android:layout_marginTop="@dimen/fb_dp12"
                    android:layout_marginRight="@dimen/fb_dp16"
                    android:layout_marginHorizontal="@dimen/fb_dp16"/>
            </LinearLayout>
            <include
                android:id="@+id/fb_layoutPaymentMethodHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_dp12"
                layout="@layout/fb_layout_preview_page_payment_method_header"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/fb_shape_rect_corner_8_bg_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/fb_dp16"
                android:layout_marginTop="@dimen/fb_dp12"
                android:layout_marginRight="@dimen/fb_dp16"
                android:layout_marginBottom="@dimen/fb_dp12"
                android:layout_marginHorizontal="@dimen/fb_dp16">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fb_ry_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.flexibank.sdk.cashier.ui.view.FlexiBankModelPaymentEarnLayout
                android:id="@+id/fb_model_payment_earn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ViewStub
        android:id="@+id/fb_llCashierCalculationDtoEmpty"
        android:layout="@layout/fb_view_cashier_empty_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
