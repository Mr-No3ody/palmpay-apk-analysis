<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/ac_set_psw"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:background="@drawable/cv_shape_rect_corner_8_bg_dark"
        android:padding="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_msg_set_your_psw"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/ac_set_psw"
        android:layout_marginStart="@dimen/dp16"
        style="@style/txt_s_b"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="start"
        android:id="@+id/pinView1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ac_psw_digit_height"
        android:layout_marginTop="6dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="@dimen/ac_psw_digit_height"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/ac_psw_digit_space"
        app:digitStrokeColor="@color/ac_pay_grey_1"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="@dimen/ac_psw_digit_text_size"
        app:digitWidth="@dimen/ac_psw_digit_width"
        app:leftMargin="0dp"
        app:mask="●"
        app:numDigits="6"
        app:pinInputType="number"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/ac_confirm_psw"
        android:layout_marginStart="@dimen/dp16"
        style="@style/txt_s_b"/>
    <com.transsnet.palmpay.custom_view.PinEntryView
        android:layout_gravity="start"
        android:id="@+id/pinView2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ac_psw_digit_height"
        android:layout_marginTop="6dp"
        app:accentType="character"
        app:accentWidth="0dp"
        app:digitBackground="@color/transparent"
        app:digitHeight="@dimen/ac_psw_digit_height"
        app:digitRadius="4dp"
        app:digitSelectStrokeColor="@color/ppColorPrimary"
        app:digitSpacing="@dimen/ac_psw_digit_space"
        app:digitStrokeColor="@color/ac_pay_grey_1"
        app:digitStrokeWidth="1dp"
        app:digitTextColor="@color/ppColorTextPrimary"
        app:digitTextSize="@dimen/ac_psw_digit_text_size"
        app:digitWidth="@dimen/ac_psw_digit_width"
        app:leftMargin="0dp"
        app:mask="●"
        app:numDigits="6"
        app:pinInputType="number"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:gravity="center_vertical"
        android:id="@+id/tvError2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_mi_g"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp16"
        android:text="No repeated numbers (111111,111222)\10No consecutive numbers (123456,123123)\10No consecutive repeated numbers (121212)"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_mi_g"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/textViewNext"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/ac_next"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pinView2"
        style="@style/ppButtonStyle"/>
</LinearLayout>
