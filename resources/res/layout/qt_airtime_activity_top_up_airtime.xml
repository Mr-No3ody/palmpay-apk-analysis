<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/atua_title_bar"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_show_right_1_iv="true"
        app:title_bar_title="@string/core_airtime"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/airtime_page_content_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/atua_title_bar">
        <com.transsnet.palmpay.custom_view.async.AsyncViewStub
            android:id="@+id/async_top_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout="@layout/qt_layout_airtime_top_view"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toTopOf="parent"
            app:mode="2"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/atua_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_top">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/atua_content_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/contentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/savAirtimePockerBanner"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <Space
                        android:id="@+id/spaceAdMidBill"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="@dimen/dp12"
                        app:layout_constraintBottom_toBottomOf="@+id/savAirtimePockerBanner"
                        app:layout_goneMarginBottom="0dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/operatorInputLayout"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/spaceAdMidBill">
                        <com.transsnet.palmpay.custom_view.input.ModelMobileWithIconInputLayout
                            android:id="@+id/atuaInputPhoneNumArea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:cv_list_item_full_screen="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ViewStub
                            android:orientation="vertical"
                            android:id="@+id/layoutLlDowntimeNotice"
                            android:layout="@layout/qt_airtime_home_downtime_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp12"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginRight="@dimen/dp12"
                            android:layout_marginBottom="@dimen/dp8"
                            android:layout_marginHorizontal="@dimen/dp12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/atuaInputPhoneNumArea"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.transsnet.palmpay.airtime.ui.view.DailyFlashSalesView
                        android:id="@+id/vDfs"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:layout_constraintTop_toBottomOf="@+id/operatorInputLayout"/>
                    <TextView
                        android:textSize="@dimen/dp16"
                        android:id="@+id/tvAirtimePockerBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:text="@string/core_top_up_airtime"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/vDfs"
                        style="@style/txt_s_b_b"/>
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/adViewBannerTitle"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp22"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:layout_constraintBottom_toBottomOf="@+id/tvAirtimePockerBannerTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toStartOf="@+id/tvAirtimePockerBannerTitle"
                        app:slot_id="@string/ad_airtime_home_banner_title_id"/>
                    <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                        android:id="@+id/asyncAmountView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:layout="@layout/qt_airtime_home_amount_layout"
                        app:layout_constraintTop_toBottomOf="@+id/tvAirtimePockerBannerTitle"
                        app:mode="2"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ViewStub
                    android:orientation="vertical"
                    android:id="@+id/vsb_group_purchase_item"
                    android:layout="@layout/qt_layout_group_purchase_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <ViewStub
                    android:orientation="vertical"
                    android:id="@+id/vsb_airtime_data_plan_quick_buy_item"
                    android:layout="@layout/qt_airtime_data_plan_quick_buy_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <com.transsnet.palmpay.teller.ui.view.ModelBillerBottomMenu
                    android:id="@+id/bottomMenuView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <ViewStub
                    android:id="@+id/bannerWithCouponStub"
                    android:layout="@layout/qt_layout_banner_coupon_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"/>
                <com.transsnet.palmpay.custom_view.async.AsyncViewStub
                    android:id="@+id/async_bottom_banner_ads_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    app:layout="@layout/qt_layout_airtime_bottom_banner_ads"
                    app:mode="2"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvServiceProviderDisclaimer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp16"
                    style="@style/Text.6f7b85.12"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
