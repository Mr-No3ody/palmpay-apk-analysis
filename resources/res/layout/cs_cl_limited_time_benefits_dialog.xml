<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="328dp"
        android:layout_height="100dp">
        <ImageView
            android:layout_width="328dp"
            android:layout_height="100dp"
            android:src="@drawable/cs_cl_calc_return_send_coupon_top_bg_v2"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp7"
            android:text="Limited Time BenefIts"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cs_cl_limited_time_benefits_bg"
        android:paddingTop="@dimen/dp20"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <TextView
            android:id="@+id/tvTitle"
            android:text="@string/cs_cl_amount_to_be_repaid"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:textSize="@dimen/dp44"
            android:textColor="@color/ppColorFlexiCashPrimary"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            style="@style/txt_number_s_b_b"/>
        <RelativeLayout
            android:id="@+id/rlContent"
            android:background="@drawable/cs_cl_calc_return_send_coupon_content_bg"
            android:padding="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="@dimen/dp208"
            android:layout_height="@dimen/dp72"
            android:layout_marginTop="@dimen/dp16"
            android:layout_below="@+id/tvCouponHint"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="32sp"
                    android:textColor="#9f6000"
                    android:id="@+id/tvCouponDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/txt_number_s_b_b"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#9f6000"
                    android:id="@+id/tvCouponDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp2"
                    android:text="Repayment Voucher"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#9f6000"
                android:gravity="center_horizontal"
                android:id="@+id/tvCouponValid"
                android:layout_width="@dimen/dp64"
                android:layout_height="wrap_content"
                android:text="Valid for the day"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16">
            <ImageView
                android:id="@+id/ivCalendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cs_cl_calendar_red_icon"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:id="@+id/tvDueDate"
                android:layout_marginLeft="@dimen/dp4"
                style="@style/Text.medium.202046.12"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layoutTips"
            android:background="@drawable/cs_cl_shape_rect_corner_8_bg_ebfdfc"
            android:paddingTop="@dimen/dp4"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24">
            <TextView
                android:id="@+id/tvTips"
                style="@style/Text.202046.10"/>
        </LinearLayout>
        <com.palmpay.lib.ui.button.PpButton
            android:id="@+id/clickEvent_limitedTimeBenefits_repayNow_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="-32dp"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_repay_now"
            android:backgroundTint="@color/ppColorFlexiCashPrimary"
            android:layout_marginHorizontal="@dimen/dp24"
            style="@style/ppButtonStyle"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/clickEvent_limitedTimeBenefits_close_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:src="@drawable/cs_cl_closed_white_icon"/>
</LinearLayout>
