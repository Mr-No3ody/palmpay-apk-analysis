<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/my_business_root"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/topContainer"
        android:background="@drawable/main_rect_bg_secondary_corner_bl_br_4"
        android:paddingLeft="10dp"
        android:paddingTop="3dp"
        android:paddingRight="10dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/business_account_number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/main_me_icon_store_top"
            android:adjustViewBounds="true"/>
    </FrameLayout>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvAccountNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topContainer"
        style="@style/Text.202046.22"/>
    <TextView
        android:id="@+id/tvStoreName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Sylvia"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAccountNumber"
        style="@style/Text.6f7b85.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/copy_icon"
        android:background="@drawable/cv_shape_round_corner_secondary"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="12dp"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Copy"
        app:iiv_size="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/section_divider"
        android:background="@drawable/main_rect_bg_secondary_corner_bl_br_12"
        android:paddingTop="@dimen/dp6"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingVertical="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStoreName">
        <com.mikepenz.iconics.view.IconicsTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Secure"
            android:includeFontPadding="false"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            style="@style/Text.6306b2.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:text=" Fast"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp20"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            style="@style/Text.6306b2.12"/>
        <com.mikepenz.iconics.view.IconicsTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Convenient"
            android:includeFontPadding="false"
            app:iiv_start_color="@color/ppColorPrimary"
            app:iiv_start_icon="pay_SelectedOutline"
            app:iiv_start_size="@dimen/dp16"
            style="@style/Text.6306b2.12"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
