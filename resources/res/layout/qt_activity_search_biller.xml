<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp36"
        android:layout_marginTop="@dimen/dp15"
        android:paddingEnd="@dimen/dp16">
        <ImageView
            android:id="@+id/ma_back_iv"
            android:padding="@dimen/dp8"
            android:layout_width="@dimen/dp36"
            android:layout_height="@dimen/dp36"
            android:src="@drawable/cv_arrow_back_black"
            android:layout_marginStart="@dimen/dp8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/qt_layout_search_item"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp35"
            app:layout_constraintEnd_toStartOf="@+id/ma_search_tv"
            app:layout_constraintStart_toEndOf="@+id/ma_back_iv"
            layout="@layout/qt_layout_search_item"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/ma_search_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qt_search"
            android:paddingStart="@dimen/dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/mls_search_empty_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="166dp"
        android:layout_marginTop="@dimen/dp68"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginEnd="@dimen/dp16"
        layout="@layout/qt_layout_search_item_empty"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ma_business_menu_rcv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ma_biller_rcv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tvSearchHistory"
                android:background="@color/ppColorBackgroundDark"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/qt_search_history"
                android:paddingStart="@dimen/dp15"
                style="@style/txt_s_g"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ma_history_rcv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp15"
                android:layout_marginEnd="@dimen/dp15"/>
            <com.transsnet.palmpay.custom_view.model.ModelEmptyView
                android:id="@+id/emptyView"
                android:background="@color/ppColorBackgroundLight"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp96"
                app:cv_empty_icon="@drawable/cv_empty_no_transaction_history"
                app:cv_empty_text=""/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
