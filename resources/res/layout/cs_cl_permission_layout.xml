<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/cl_permission_close_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:iiv_color="@color/cs_main_color"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/csTextview102"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/cs_cl_permission_title"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csImageview13"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/first_perm_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp14">
        <ImageView
            android:id="@+id/first_perm_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="43dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cs_cl_device_icon"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/first_perm_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_device_how"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/first_perm_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/first_perm_img"
            app:layout_constraintTop_toTopOf="@+id/first_perm_img"/>
        <View
            android:id="@+id/first_divider_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/first_perm_content_tv"
            app:layout_constraintStart_toStartOf="@+id/first_perm_img"
            app:layout_constraintTop_toBottomOf="@+id/first_perm_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/second_perm_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/second_perm_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="43dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cs_cl_contact_icon"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/second_perm_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_contact_how"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/second_perm_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/second_perm_img"
            app:layout_constraintTop_toTopOf="@+id/second_perm_img"/>
        <View
            android:id="@+id/second_divider_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/second_perm_content_tv"
            app:layout_constraintStart_toStartOf="@+id/second_perm_img"
            app:layout_constraintTop_toBottomOf="@+id/second_perm_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/third_perm_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/third_perm_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="43dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cs_cl_app_list_icon"/>
        <TextView
            android:textColor="@color/ppColorTextPrimary"
            android:id="@+id/third_perm_content_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cs_cl_app_list_how"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/third_perm_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/third_perm_img"
            app:layout_constraintTop_toTopOf="@+id/third_perm_img"/>
        <View
            android:id="@+id/third_divider_view"
            android:background="@color/ppColorBackgroundDark"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/third_perm_content_tv"
            app:layout_constraintStart_toStartOf="@+id/third_perm_img"
            app:layout_constraintTop_toBottomOf="@+id/third_perm_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/open_setting_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp52"
        android:layout_marginBottom="@dimen/dp45"
        android:text="@string/cs_cl_open_page"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"/>
</LinearLayout>
