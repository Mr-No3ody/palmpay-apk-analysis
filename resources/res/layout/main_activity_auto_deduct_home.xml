<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:orientation="vertical"
        android:id="@+id/emptyView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        layout="@layout/cv_layout_list_empty_view"/>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:title_bar_show_right_2_iv="false"
        app:title_bar_title="@string/main_auto_deduct"/>
    <ScrollView
        android:id="@+id/viewContainer"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/textViewHeader1"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/large_margin"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/main_in_use"
                android:paddingStart="@dimen/large_margin"
                style="@style/txt_s_b"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/textViewHeader2"
                android:background="@color/ppColorBackgroundLight"
                android:paddingLeft="@dimen/large_margin"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/main_auto_deduct_expired"
                android:paddingStart="@dimen/large_margin"
                style="@style/txt_s_b"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
