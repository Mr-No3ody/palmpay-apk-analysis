<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_dialog_top_left_right_corner_24dp_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/ppColorTextPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginRight="@dimen/dp16"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp16"
            app:autoSizeMaxTextSize="@dimen/dp16"
            app:autoSizeMinTextSize="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp14"
            android:layout_marginBottom="@dimen/dp14"
            android:layout_marginVertical="@dimen/dp14"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_Close"
            app:iiv_size="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/viewShareText"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:padding="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="4dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/cv_palmpay_logo_2"
            android:scaleType="fitXY"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvShareText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            style="@style/txt_s_b"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivCopyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextPrimary"
            app:iiv_icon="pay_Copy"
            app:iiv_size="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvShareText2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_b"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/contacts_area"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp74">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cds_contact_rcv"
            android:paddingLeft="@dimen/dp5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:id="@+id/cds_more_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:text="@string/core_more"
            android:drawableTop="@drawable/cv_more"
            android:drawablePadding="3dp"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/viewShareChannelArea"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        android:paddingHorizontal="@dimen/dp12"
        android:paddingVertical="@dimen/dp12">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShareChannelList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/viewShareTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"
        android:layout_marginVertical="@dimen/dp12">
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:text="Share Via"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp20"
            style="@style/txt_s_b"/>
        <View
            android:background="@color/ppColorDividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cds_app_rcv"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="@dimen/dp12"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cds_bottom_area"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp86">
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center_vertical"
            android:id="@+id/cds_copy_link_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_copy_link"
            android:drawableTop="@drawable/cv_copy_link"
            android:drawablePadding="@dimen/dp6"
            android:layout_marginStart="@dimen/dp22"
            style="@style/txt_s_g"/>
        <TextView
            android:textSize="@dimen/dp10"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/cds_qr_code_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_qr_code"
            android:drawableTop="@drawable/cv_qr_code_circle"
            android:drawablePadding="@dimen/dp6"
            android:layout_marginStart="@dimen/dp22"/>
    </LinearLayout>
</LinearLayout>
