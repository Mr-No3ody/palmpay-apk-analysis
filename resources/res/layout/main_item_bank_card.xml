<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginRight="@dimen/dp16"
    android:minHeight="@dimen/dp138"
    android:layout_marginHorizontal="@dimen/dp16">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_status_bg"
        android:background="@drawable/cv_rect_bg_black_70_corner_tl_tr_24"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorError"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_status_bg"
        style="@style/Text.6f7b85.12"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/tv_status_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_status"
        style="@style/Text.ffffff.12"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_status_bg,tv_status,tv_status_tips"/>
    <ImageView
        android:id="@+id/iv_bank"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginStart="@dimen/dp24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_status_bg"
        app:layout_goneMarginTop="@dimen/dp24"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_bank_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginRight="@dimen/dp8"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bank"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_bank"
        app:layout_constraintTop_toTopOf="@+id/iv_bank"
        style="@style/Text.medium.ffffff.14"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_bank_name"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivDelete"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp24"
        app:iiv_color="@color/md_white_1000"
        app:iiv_icon="pay_Delete"
        app:iiv_padding="@dimen/dp4"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/iv_bank"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_setting"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp24"
        app:iiv_color="@color/md_white_1000"
        app:iiv_icon="pay_Setup"
        app:iiv_padding="@dimen/dp2"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/iv_bank"/>
    <TextView
        android:id="@+id/tv_default"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp22"
        android:layout_marginBottom="@dimen/dp8"
        android:text="@string/core_default"
        app:layout_constraintBottom_toTopOf="@+id/tv_bank_card_no"
        app:layout_constraintStart_toStartOf="@+id/iv_bank"
        style="@style/Text.medium.ffffff.14"/>
    <TextView
        android:id="@+id/tv_bank_card_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_bank"
        app:layout_goneMarginTop="@dimen/dp14"
        style="@style/txt_number_s_w"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iiv_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bank_card_no"
        app:layout_constraintStart_toEndOf="@+id/tv_bank_card_no"
        app:layout_constraintTop_toTopOf="@+id/tv_bank_card_no"/>
    <ImageView
        android:id="@+id/iv_copy"
        android:padding="@dimen/dp1"
        android:visibility="gone"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:src="@drawable/cv_copy_1"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bank_card_no"
        app:layout_constraintStart_toEndOf="@+id/iiv_show"
        app:layout_constraintTop_toTopOf="@+id/tv_bank_card_no"
        app:tint="@color/md_white_1000"/>
    <TextView
        android:id="@+id/tv_valid_thru"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bank_card_no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/tv_bank_card_no"
        app:layout_constraintTop_toTopOf="@+id/tv_bank_card_no"
        style="@style/Text.ffffff.14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
