<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bank_account"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingTop="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:text="@string/sm_recipient_Account"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/dp12"
            style="@style/Text.202046.12"/>
        <com.transsnet.palmpay.custom_view.input.CustomAutoCompleteTextView
            android:textSize="@dimen/dp16"
            android:textColor="@color/ppColorTextPrimary"
            android:textColorHint="@color/ppColorTextDisable"
            android:gravity="center_vertical"
            android:id="@+id/et_bank_account"
            android:background="@color/transparent"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp32"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp12"
            android:hint="@string/sm_enter_10_digits_account_number"
            android:maxLines="@integer/sm_bank_phone_edit_text_max_lines"
            android:digits="0123456789"
            android:inputType="phone"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/dp12"
            style="@style/MyAutoCompleteTextView"/>
        <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
            android:id="@+id/med_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp12"
            android:layout_marginHorizontal="@dimen/dp12"
            app:cv_divider_focus_color="@color/ppColorPrimary"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_matched_recipients"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </LinearLayout>
    <com.transsnet.palmpay.send_money.ui.view.ClipboardAccountPromptView
        android:id="@+id/clipboard_account_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlSelectBank"
        android:background="@drawable/cv_shape_rect_corner_12_bg_dark"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:minHeight="@dimen/dp82"
        android:paddingHorizontal="@dimen/dp12">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvBankLabel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:text="@string/sm_bank"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.202046.12"/>
        <TextView
            android:textColor="@color/ppColorTextDisable"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvSelectBank"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp32"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/sm_select_your_bank"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp10"
            app:layout_constraintEnd_toStartOf="@+id/iv_label"
            app:layout_constraintStart_toEndOf="@+id/account_bank_icon"
            app:layout_constraintTop_toBottomOf="@+id/tvBankLabel"
            app:layout_goneMarginStart="0dp"
            style="@style/Text.202046.16"/>
        <ImageView
            android:id="@+id/account_bank_icon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            app:layout_constraintBottom_toBottomOf="@+id/tvSelectBank"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvSelectBank"
            app:srcCompat="@drawable/cv_bank_account"/>
        <ImageView
            android:id="@+id/iv_label"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp18"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/dp10"
            app:layout_constraintBottom_toBottomOf="@+id/tvSelectBank"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow_right"
            app:layout_constraintStart_toEndOf="@+id/tvSelectBank"
            app:layout_constraintTop_toTopOf="@+id/tvSelectBank"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/g_selected_bank"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="account_bank_icon,iv_label"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iv_arrow_right"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="@dimen/dp20"
            app:layout_constraintBottom_toBottomOf="@+id/tvSelectBank"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvSelectBank"/>
        <com.transsnet.palmpay.custom_view.model.ModelErrorDivider
            android:id="@+id/med_bank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSelectBank"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_loading"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp34"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/med_bank">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/indicatorView"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:indeterminate="true"
                app:indicatorColor="@color/ppColorTextPrimary"
                app:indicatorSize="@dimen/dp16"
                app:trackThickness="@dimen/dp1"/>
            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sm_matching_banks"
                android:layout_marginStart="@dimen/dp8"
                style="@style/txt_mi_lg"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_matched_bank"
            android:background="@drawable/cv_shape_rect_corner_bl_br_12_bg_dark"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_recipient_loading"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_recipient_name"
            android:background="@drawable/cv_shape_rect_corner_8_bg_e4f7f0"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:minHeight="@dimen/dp34"
            android:backgroundTint="@color/ppColorSuccessBackground"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp6">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_recipient_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorSuccess"
                app:iiv_icon="pay_SelectedFill"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textColor="@color/ppColorSuccess"
                android:id="@+id/tv_recipient_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp4"
                style="@style/txt_s_b_b"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_query_status"
            android:background="@drawable/cv_shape_rect_corner_8_bg_error_background"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp6"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp6">
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/iv_query_status"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                app:iiv_color="@color/ppColorError"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="@dimen/dp16"/>
            <TextView
                android:textColor="@color/ppColorError"
                android:gravity="start"
                android:id="@+id/tv_query_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                style="@style/Text.6f7b85.12"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_next"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_next"
            style="@style/txt_me_w_b"/>
    </FrameLayout>
</LinearLayout>
