<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp22"
        android:text="@string/core_switch_bank_account"
        style="@style/Text.202046.14"/>
    <com.transsnet.palmpay.custom_view.TitleEditView
        android:id="@+id/itemAccountNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="@dimen/dp24"
        app:cv_max_length="12"
        app:cv_te_always_show_title_color="true"
        app:cv_te_collapse="false"
        app:cv_te_error_text="false"
        app:cv_te_hint="@string/core_enter_your_bank_account_number"
        app:cv_te_inputType="bankcode"
        app:cv_te_title=""
        app:cv_te_title_color="@color/cv_color_263138"
        app:cv_te_title_text_size="@dimen/dp14"/>
    <View
        android:background="@drawable/core_card_number_et_bg"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvNote"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp6"
        android:text="@string/core_bank_account_can_receiving_money_only"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvAccountNoError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        style="@style/AddCardItemErrorStyle"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp32"
        android:text="@string/core_bank"
        style="@style/AddCardItemTitleStyle"/>
    <com.transsnet.palmpay.core.viewmodel.ModelBankCardItem1
        android:id="@+id/bank_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="24dp"
        android:text="@string/core_next"
        app:rtv_background_color="@color/core_text_color_common"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
</LinearLayout>
