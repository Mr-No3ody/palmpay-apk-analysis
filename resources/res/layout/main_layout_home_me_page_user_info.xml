<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/main_home_top_bar_height">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="center"
        android:id="@+id/ivSettings"
        android:padding="@dimen/dp10"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        android:layout_marginEnd="@dimen/dp3"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Setup"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivScan"
        android:paddingTop="@dimen/dp5"
        android:paddingBottom="@dimen/dp5"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingVertical="@dimen/dp5"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Scan"
        app:iiv_size="@dimen/dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivSettings"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivNew"
        android:visibility="gone"
        android:layout_width="@dimen/dp8"
        android:layout_height="@dimen/dp8"
        android:layout_marginTop="8dp"
        android:src="@drawable/cv_red_point"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/ivSettings"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageViewAvatar"
        android:layout_width="@dimen/dp32"
        android:layout_height="@dimen/dp32"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cv_avatar_default"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:gravity="center_vertical"
        android:id="@+id/tvSignUpLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_sign_up_login"
        android:layout_marginStart="@dimen/dp12"
        app:iiv_end_color="@color/ppColorTextPrimary"
        app:iiv_end_icon="pay_ArrowCenterRight"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewAvatar"
        app:layout_constraintLeft_toRightOf="@+id/imageViewAvatar"
        app:layout_constraintTop_toTopOf="@+id/imageViewAvatar"
        style="@style/Text.medium.202046.14"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:maxLength="15"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toTopOf="@+id/ivLevel"
        app:layout_constraintStart_toEndOf="@+id/imageViewAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:src="@drawable/main_home_me_level_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvName"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tvLevel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="19dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivLevel"
        app:layout_constraintStart_toStartOf="@+id/ivLevel"
        app:layout_constraintTop_toTopOf="@+id/ivLevel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
