<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_view"
        android:background="#ffffff"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageButton
            android:id="@+id/back_bt"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:src="@drawable/cv_arrow_back_black"
            android:layout_marginStart="5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/ct_contact_search_bg"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1">
            <EditText
                android:textSize="14dp"
                android:textColor="#ff263138"
                android:textColorHint="#ff6f7b85"
                android:id="@+id/editSearch"
                android:background="@null"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/ct_name_or_mobile_number"
                android:maxLines="1"
                android:maxLength="30"
                android:layout_weight="1"
                android:inputType="text"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivDelete"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:iiv_color="@color/ppColorTextDisable"
                app:iiv_icon="pay_CloseFill"
                app:iiv_size="24dp"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsnet.palmpay.custom_view.SwipeRecyclerView
            android:id="@+id/contact_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsnet.palmpay.contacts.ui.view.SideBarView
            android:id="@+id/side_bar"
            android:layout_width="20dp"
            android:layout_height="350dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:ct_press_bg_color="@color/ppColorBackgroundDark"
            app:ct_selectTextColor="@color/ppColorPrimary"
            app:ct_textColor="#00001a"
            app:ct_with_favourite="false"/>
    </RelativeLayout>
</LinearLayout>
