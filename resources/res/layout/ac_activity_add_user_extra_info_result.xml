<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/tvComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp19"
        android:text="@string/core_complete"
        android:layout_marginEnd="@dimen/dp16"
        style="@style/txt_s_g"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="109dp"
        android:layout_marginTop="@dimen/dp20"
        android:scaleType="fitXY"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:text="Congratulations!"
        style="@style/txt_b_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        style="@style/txt_s_g"/>
    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="16dp"/>
    <com.transsnet.adsdk.widgets.SingleAdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="16dp"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="16dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginBottom="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <com.transsnet.adsdk.widgets.SingleAdView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:slot_id="FF4E4C6FA72241368C9F28F42290795F"/>
        <com.palmpay.lib.ui.button.PpButton
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/core_confirm"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ppButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
