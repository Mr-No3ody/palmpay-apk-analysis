<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:paddingLeft="@dimen/dp15"
        android:paddingRight="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/mdp_close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp15"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorPrimary"
            android:id="@+id/mdp_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginLeft="@dimen/dp15"
        android:layout_marginRight="@dimen/dp15"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp15"
        android:paddingRight="@dimen/dp15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp153"
        android:layout_below="@+id/mdp_title_tv">
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/mdp_wheel_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="@dimen/dp15"
            android:layout_height="match_parent"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/mdp_wheel_middle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:layout_width="@dimen/dp15"
            android:layout_height="match_parent"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/mdp_wheel_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp18"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/mdp_confirm_btn"
        android:background="@drawable/cv_button_bg_purple"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:text="@string/core_confirm"
        android:textAllCaps="false"/>
</LinearLayout>
