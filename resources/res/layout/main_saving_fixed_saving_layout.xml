<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctl_title"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="left"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="80dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.202046.16"/>
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextNormal"
            android:id="@+id/tvDesc"
            android:paddingBottom="@dimen/dp6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp10"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/iconArrow"
            app:layout_constraintRight_toLeftOf="@+id/iconArrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/iconArrow"
            android:paddingLeft="@dimen/dp12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iiv_color="@color/ppColorTextAssist"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/csl_exclusiveList"
        android:background="@drawable/main_bg_saving_exclusive"
        android:paddingLeft="@dimen/dp6"
        android:paddingTop="@dimen/dp12"
        android:paddingRight="@dimen/dp6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp1"
        android:layout_marginTop="@dimen/dp1"
        android:layout_marginRight="@dimen/dp1"
        android:layout_marginHorizontal="@dimen/dp1"
        android:paddingHorizontal="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ctl_title">
        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/main_icon_star"
            app:layout_constraintBottom_toBottomOf="@+id/tvExcluesiveTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvExcluesiveTitle"/>
        <TextView
            android:id="@+id/tvExcluesiveTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp4"
            android:text="Exclusive Fixed Savings Offer"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toRightOf="@+id/ivStar"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.medium.6306b2.14"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rl_exclusiveList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvExcluesiveTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rl_productList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginHorizontal="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/csl_exclusiveList"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvMoreInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="More"
        app:iiv_end_color="@color/ppColorTextAssist"
        app:iiv_end_icon="pay_ArrowRight"
        app:iiv_end_size="@dimen/dp12"
        app:iiv_start_color="@color/ppColorTextAssist"
        app:iiv_start_padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_productList"
        style="@style/txt_mi_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
