<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/imageViewResult"
            android:layout_width="@dimen/cv_result_success_img_size"
            android:layout_height="@dimen/cv_result_success_img_size"
            android:layout_marginTop="50dp"
            android:src="@drawable/cv_result_success"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/cv_result_success"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/large_margin"
            android:layout_marginTop="@dimen/large_margin"
            android:layout_marginRight="@dimen/large_margin"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/large_margin"
            android:layout_marginEnd="@dimen/large_margin"
            style="@style/txt_b_b"/>
        <TextView
            android:gravity="center"
            android:id="@+id/textViewMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            style="@style/txt_s_g"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="16dp"/>
        <TextView
            android:textAppearance="@style/txt_b_w"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewButton1"
            android:background="@drawable/cv_button_bg_purple_corner"
            android:visibility="invisible"
            android:layout_width="270dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginTop="16dp"
            android:elevation="@dimen/core_default_elevation"/>
        <TextView
            android:textAppearance="@style/txt_b_w"
            android:textColor="@color/ppColorPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textViewButton2"
            android:background="@drawable/cv_button_bg_light_purple_corner"
            android:visibility="invisible"
            android:layout_width="270dp"
            android:layout_height="@dimen/ppButtonHeight"
            android:layout_marginTop="16dp"
            android:elevation="@dimen/core_default_elevation"/>
    </LinearLayout>
</ScrollView>
