<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ii_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp12"
        android:layout_alignParentEnd="true"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="@dimen/dp20"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ii_close">
        <TextView
            android:textSize="@dimen/dp18"
            android:textColor="@color/ppColorTextPrimary"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_automatic_repayment_nauthorization"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:src="@drawable/cs_agent_auto_repay"
            android:layout_marginVertical="@dimen/dp12"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="@color/ppColorTextNormal"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginRight="@dimen/dp24"
            android:text="@string/cs_agent_auto_repayment_desc"
            android:layout_marginHorizontal="@dimen/dp24"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp44"
            android:layout_marginLeft="@dimen/dp24"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp24"
            android:layout_marginHorizontal="@dimen/dp24">
            <TextView
                android:textSize="@dimen/dp16"
                android:textColor="@color/md_white_1000"
                android:gravity="center"
                android:id="@+id/tv_agree"
                android:background="@drawable/cs_next_btn_cash_selector_corner_12dp_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/core_agree"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
