<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:src="@drawable/cv_default_bank_logo"
        android:scaleType="fitXY"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvBankName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        style="@style/txt_s_b"/>
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp30"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/dp30"
        android:text="@string/core_msg_require_card_pin_verify"
        android:layout_marginHorizontal="@dimen/dp30"
        style="@style/txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp34"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/core_card_pin"
        android:drawableTint="@color/ppColorTextPrimary"
        android:layout_marginHorizontal="@dimen/dp16"
        style="@style/txt_s_b"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/medium_text"
        android:gravity="center_vertical"
        android:id="@+id/editCardPin"
        android:background="@drawable/cv_title_input_underline"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:hint="@string/core_enter_card_pin"
        android:maxLength="4"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/dp16"/>
    <Button
        android:enabled="false"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/buttonNext"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp40"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_next"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/txt_b_w"/>
</LinearLayout>
