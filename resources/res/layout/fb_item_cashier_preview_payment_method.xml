<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fb_mbci_root"
    android:background="@drawable/fb_shape_rect_corner_8_bg_dark"
    android:paddingLeft="@dimen/fb_dp12"
    android:paddingTop="@dimen/fb_dp15"
    android:paddingRight="@dimen/fb_dp12"
    android:paddingBottom="@dimen/fb_dp15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/fb_dp12"
    android:paddingVertical="@dimen/fb_dp15">
    <ImageView
        android:id="@+id/fb_iv_cashier_item_payment_method_icon"
        android:layout_width="@dimen/fb_dp30"
        android:layout_height="@dimen/fb_dp30"
        android:src="@drawable/fb_palmpay_icon_circle_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/fb_tv_cashier_item_payment_method_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/fb_dp12"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/fb_tv_item_payment_method_normal_tips"
        app:layout_constraintEnd_toStartOf="@+id/fb_tv_cashier_item_payment_balance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/fb_iv_cashier_item_payment_method_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_s_b_b"/>
    <TextView
        android:textColor="@color/fb_text_color_gray2"
        android:gravity="center"
        android:id="@+id/fb_tv_cashier_item_payment_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tv_cashier_item_payment_method_name"
        app:layout_constraintEnd_toStartOf="@+id/fb_tv_item_payment_method_discount_amount"
        app:layout_constraintStart_toEndOf="@+id/fb_tv_cashier_item_payment_method_name"
        app:layout_goneMarginEnd="@dimen/fb_dp20"
        style="@style/fb_txt_s_lg"/>
    <TextView
        android:textSize="@dimen/fb_dp10"
        android:textColor="@color/ppColorTextBase"
        android:id="@+id/fb_tv_item_payment_method_discount_amount"
        android:background="@drawable/fb_button_bg_yellow_corner_2"
        android:paddingLeft="@dimen/fb_dp4"
        android:paddingTop="@dimen/fb_dp1"
        android:paddingRight="@dimen/fb_dp4"
        android:paddingBottom="@dimen/fb_dp1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_dp4"
        android:layout_marginEnd="@dimen/fb_dp30"
        android:paddingHorizontal="@dimen/fb_dp4"
        android:paddingVertical="@dimen/fb_dp1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/fb_tv_cashier_item_payment_method_name"
        app:layout_constraintEnd_toStartOf="@+id/fb_cashier_item_barrier_end"
        app:layout_constraintStart_toEndOf="@+id/fb_tv_cashier_item_payment_balance"
        app:layout_constraintTop_toTopOf="@+id/fb_tv_cashier_item_payment_method_name"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:textSize="@dimen/fb_dp12"
        android:id="@+id/fb_tv_item_payment_method_normal_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp2"
        android:paddingEnd="@dimen/fb_dp5"
        android:layout_marginEnd="@dimen/fb_dp5"
        app:layout_constraintBottom_toTopOf="@+id/fb_tv_item_payment_method_activity_tips"
        app:layout_constraintEnd_toStartOf="@+id/fb_cashier_item_barrier_end"
        app:layout_constraintStart_toStartOf="@+id/fb_tv_cashier_item_payment_method_name"
        app:layout_constraintTop_toBottomOf="@+id/fb_tv_cashier_item_payment_method_name"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:textSize="@dimen/fb_dp12"
        android:textColor="@color/fb_text_color_orange"
        android:id="@+id/fb_tv_item_payment_method_activity_tips"
        android:background="@drawable/fb_shape_rect_bg_fff7e8_conrner_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp2"
        android:paddingStart="@dimen/fb_dp5"
        android:paddingEnd="@dimen/fb_dp5"
        android:layout_marginEnd="@dimen/fb_dp5"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fb_cashier_item_barrier_end"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/fb_tv_cashier_item_payment_method_name"
        app:layout_constraintTop_toBottomOf="@+id/fb_tv_item_payment_method_normal_tips"
        style="@style/fb_txt_s_b_b"/>
    <TextView
        android:gravity="center"
        android:id="@+id/fb_tv_cashier_item_top_up"
        android:background="@drawable/fb_shape_halfround_purple"
        android:paddingLeft="@dimen/fb_dp10"
        android:paddingRight="@dimen/fb_dp10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fb_dp30"
        android:text="@string/fb_top_up"
        android:paddingHorizontal="@dimen/fb_dp10"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_mi_w"/>
    <ImageView
        android:id="@+id/fb_iv_cashier_item_selected"
        android:layout_width="@dimen/fb_dp24"
        android:layout_height="@dimen/fb_dp24"
        android:src="@drawable/fb_checked_single_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/fb_cashier_item_barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="fb_iv_cashier_item_selected,fb_tv_cashier_item_top_up"/>
</androidx.constraintlayout.widget.ConstraintLayout>
