<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/viewRoot"
    android:background="@drawable/cv_dialog_top_left_right_corner_white_bg"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivClose"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:paddingEnd="15dp"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_Close"
            app:iiv_size="24dp"/>
        <TextView
            android:textSize="@dimen/dp15"
            android:paddingTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_msg_fund_your_balance"
            android:layout_toLeftOf="@+id/ivClose"
            android:paddingEnd="15dp"
            style="@style/txt_b_lg"/>
    </RelativeLayout>
    <TextView
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_pay_using"
        style="@style/txt_me_b_b"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/cv_shape_rect_corner_bg_gray_with_purple_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_marginBottom="115dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:layout_marginEnd="15dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/cv_palmpay_icon_circle_purple"
            android:scaleType="fitXY"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_palmpay_payment_balance"
            android:paddingStart="15dp"
            style="@style/txt_me_b"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/txt_b_b_b"/>
    </LinearLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/tvFund"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_balance_topup"
        android:layout_marginEnd="15dp"
        style="@style/txt_b_w"/>
</LinearLayout>
