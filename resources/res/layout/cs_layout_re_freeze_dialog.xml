<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cs_refer_earn_details_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp17"
    android:layout_marginRight="@dimen/dp17"
    android:paddingStart="@dimen/dp19"
    android:paddingEnd="@dimen/dp19"
    android:layout_marginHorizontal="@dimen/dp17"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStatus">
        <TextView
            android:textSize="@dimen/dp22"
            android:textColor="@color/cv_text_color_white"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bonus Unfrozen"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp14"
            android:textColor="#8a8cb2"
            android:gravity="center"
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp16"
            android:text="Your previous frozen bonus is available now! Go and withdraw your cash now!"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="@dimen/dp16"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp16"
        android:textColor="@color/cv_text_color_white"
        android:id="@+id/btnConfirm"
        android:background="@drawable/cs_shape_orange_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginTop="@dimen/dp26"
        android:layout_marginBottom="@dimen/dp20"
        android:text="@string/core_got_it"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llContent"/>
</LinearLayout>
