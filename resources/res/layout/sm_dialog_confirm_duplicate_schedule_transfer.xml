<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white_stroke_divider_line"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/dp10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp32"
        android:text="@string/sm_confirm_duplicate_transfer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_you_have_a_scheduled"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/Text.6f7b85.14"/>
    <View
        android:id="@+id/v_divider"
        android:layout_marginTop="@dimen/dp12"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        style="@style/core_divider_horizontal"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cl_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/v_divider">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_amount"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/cvGuideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/tv_amount_title"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/txt_number_s_b_b"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_recipient_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/core_recipient"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bank_name"
            app:layout_constraintEnd_toStartOf="@+id/cvGuideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_user_name"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:maxLines="1"
            android:lineSpacingExtra="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_bank_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/tv_recipient_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_amount_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/dp142"
            style="@style/Text.medium.202046.14"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_bank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/tv_bank_account"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
            app:layout_constraintWidth_max="106dp"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_bank_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bank_name"
            app:layout_constraintEnd_toEndOf="@+id/tv_user_name"
            app:layout_constraintTop_toTopOf="@+id/tv_bank_name"
            app:layout_constraintWidth_max="106dp"
            style="@style/Text.6f7b85.12"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp16"
            android:text="@string/core_payment_method"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/cvGuideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bank_name"
            style="@style/Text.6f7b85.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_payment_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/tv_amount_title"
            app:layout_constraintTop_toTopOf="@+id/tv_payment_title"
            style="@style/Text.medium.202046.14"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ppButtonHeight"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_keep_transferring"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/cl_info"
        style="@style/Text.medium.ffffff.16"/>
    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/sm_view_scheduled_transfer"
        android:layout_marginHorizontal="@dimen/dp24"
        app:layout_constraintTop_toBottomOf="@+id/tv_confirm"
        style="@style/Text.6f7b85.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
