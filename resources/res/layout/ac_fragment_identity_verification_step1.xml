<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="320dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.adsdk.widgets.MarqueeTextView.MarqueeViewV2
                    android:background="@color/ppColorBackgroundDark"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    app:slot_id="D86D54B7623E4E09A91DF36BD333145F"/>
                <TextView
                    android:textSize="24dp"
                    android:gravity="center_vertical"
                    android:layout_gravity="start"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:text="Verify Your ID"
                    android:layout_marginHorizontal="16dp"
                    style="@style/txt_bb_b_b"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tvMessage"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/ac_msg_identity_verification"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginHorizontal="16dp"
                    style="@style/txt_s_g"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvSubTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ac_id_type"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/txt_s_b"/>
                    <TextView
                        android:textColor="@color/ac_id_type_state_color"
                        android:gravity="center"
                        android:id="@+id/tvType1"
                        android:background="@drawable/cv_corner_mark_selector_bg"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toStartOf="@+id/tvType2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSubTitle"
                        style="@style/txt_me_b_b"/>
                    <TextView
                        android:textColor="@color/ac_id_type_state_color"
                        android:gravity="center"
                        android:id="@+id/tvType2"
                        android:background="@drawable/cv_corner_mark_selector_bg"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginStart="@dimen/dp16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvType1"
                        app:layout_constraintTop_toTopOf="@+id/tvType1"
                        style="@style/txt_me_b_b"/>
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:id="@+id/ivThumb"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="60dp"
                        app:iiv_color="@color/ppColorPrimary"
                        app:iiv_icon="pay_ThumbupFill"
                        app:iiv_size="24dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvType1"
                        app:layout_constraintEnd_toEndOf="@+id/tvType1"
                        app:layout_constraintStart_toStartOf="@+id/tvType1"
                        app:layout_constraintTop_toTopOf="@+id/tvType1"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/topBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tvType1, tvType2"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tvName"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ac_id_number"
                        app:layout_constraintTop_toBottomOf="@+id/topBarrier"
                        style="@style/txt_s_b"/>
                    <com.palmpay.lib.ui.form.PpFormVertical
                        android:textSize="@dimen/dp22"
                        android:id="@+id/inputIdNo"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:form_edit_input_type="number"
                        app:form_hide_text="@string/ac_enter_id_number"
                        app:layout_constraintTop_toBottomOf="@+id/tvName"
                        style="@style/AcPpFormStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tvForgotBvn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ac_forget_bvn_2"
                        app:layout_constraintBottom_toBottomOf="@+id/btnGet"
                        app:layout_constraintEnd_toStartOf="@+id/btnGet"
                        app:layout_constraintTop_toTopOf="@+id/btnGet"
                        style="@style/txt_mi_g"/>
                    <com.palmpay.lib.ui.button.PpButton
                        android:textSize="12dp"
                        android:gravity="center"
                        android:id="@+id/btnGet"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp24"
                        android:minWidth="@dimen/dp20"
                        android:text="Get"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="12dp"
                        app:autoSizeText="false"
                        app:layout_constraintStart_toEndOf="@+id/tvForgotBvn"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ppSecondarySmallButtonNoPaddingStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="16dp"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp16">
            <com.palmpay.lib.ui.button.PpButton
                android:enabled="false"
                android:gravity="center"
                android:id="@+id/textViewNext"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="@string/ac_next"
                style="@style/ppButtonStyle"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:layout_gravity="end|top"
                android:id="@+id/cornerAd"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
        </FrameLayout>
        <include
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="16dp"
            layout="@layout/cv_layout_login_register_bottom_view"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/securityKeyBoard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/core_number_keyboard_layout"/>
</FrameLayout>
