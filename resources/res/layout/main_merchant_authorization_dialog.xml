<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp8"
        style="@style/CardView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/core_merchant_authorization_title"
                android:includeFontPadding="false"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/merchant_icon_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="30dp"
                android:text="@string/core_merchant_authorization_desc"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/merchant_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="30dp"/>
            <View
                android:background="@color/ppColorDividerLine"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="30dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff6f7b85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_digit_dot"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ppColorTextAssist"
                    android:id="@+id/authorization_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="30dp">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/ppColorPrimary"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/disagree_tv"
                    android:background="@drawable/cv_button_bg_grey_corner"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:text="@string/core_disagree"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/agree_tv"
                    android:background="@drawable/core_next_btn_selector_bg"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="14dp"
                    android:text="@string/core_agree"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
