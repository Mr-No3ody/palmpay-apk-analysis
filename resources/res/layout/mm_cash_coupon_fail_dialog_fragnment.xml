<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/mm_bg_common_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="40dp"
        android:textColor="@color/ppColorTextAssist"
        android:id="@+id/tvCouponAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose"
        style="@style/Text.medium.6306b2.26"/>
    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="Redemption Failed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCouponAmount"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvTotalBackAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:text="Sorry, the system is currently busy, please try again later."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProductName"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/tvMaturedOrderNum"
        android:paddingTop="@dimen/dp16"
        android:paddingBottom="@dimen/dp20"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalBackAmount"
        style="@style/Text.000000.12"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/md_white_1000"
        android:id="@+id/rtvCreateNew"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="16dp"
        android:text="Okay"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMaturedOrderNum"
        app:rtv_background_color="@color/mm_color_6306b2"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rtvCreateNew"/>
</androidx.constraintlayout.widget.ConstraintLayout>
