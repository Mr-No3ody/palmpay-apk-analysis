<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/rootFlexiView"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:paddingLeft="@dimen/dp16"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp16"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp16"
    android:paddingVertical="@dimen/dp12">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tvTitle"
        android:layout_marginLeft="@dimen/dp8"
        style="@style/Text.6f7b85.12"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:textColor="@color/ppColorError"
        android:id="@+id/rtvFrozen"
        android:paddingLeft="@dimen/dp4"
        android:paddingRight="@dimen/dp4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginLeft="@dimen/dp4"
        android:text="@string/cs_frozen"
        android:paddingHorizontal="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
        app:layout_constraintLeft_toRightOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"
        app:rtv_background_color="@color/transparent"
        app:rtv_border_color="@color/ppColorError"
        app:rtv_border_width="@dimen/dp1"
        app:rtv_corner_radius="@dimen/dp4"
        style="@style/Text.ffffff.10"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/tvAmount"
        android:fontFamily="@font/cv_palmpay_number_bold"
        style="@style/Text.202046.14"/>
    <TextView
        android:id="@+id/tvExtraInfoTitle"
        style="@style/Text.202046.12"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/tvApply"
        android:visibility="gone"
        android:layout_width="@dimen/dp72"
        android:layout_height="@dimen/dp24"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivArrowRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="@dimen/dp16"/>
</LinearLayout>
