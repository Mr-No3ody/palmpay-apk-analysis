<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:background="@drawable/cv_shape_rect_top_corner_white_24"
    android:paddingBottom="@dimen/dp12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvTitle"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/mm_terms_and_conditions"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="left"
        android:id="@+id/tvContent"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="16dp"
        android:text="@string/mm_payout_options_terms_conditions"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Text.6f7b85.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvCancel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp12"
        android:text="@string/core_cancel"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rtvAgree"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        app:rtv_background_color="@color/ppColorSecondary"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.6306b2.16"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvAgree"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="16dp"
        android:text="@string/core_agree"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toRightOf="@+id/rtvCancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        app:rtv_background_color="@color/ppColorPrimary"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
