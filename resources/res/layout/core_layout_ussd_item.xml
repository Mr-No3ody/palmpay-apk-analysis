<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ppColorBackgroundDark"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp">
    <RelativeLayout
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="10dp">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvLine1"
            android:paddingTop="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingEnd="30dp"
            style="@style/txt_s_b"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvLine2"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_below="@+id/tvLine1"
            android:paddingEnd="30dp"
            style="@style/txt_mi_lg"/>
        <com.mikepenz.iconics.view.IconicsImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:iiv_color="@color/ppColorPrimary"
            app:iiv_icon="pay_ArrowRight"
            app:iiv_size="16dp"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
