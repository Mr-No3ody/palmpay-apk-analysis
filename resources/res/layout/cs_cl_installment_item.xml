<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp16">
    <View
        android:id="@+id/top_divider_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="2dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/status_img"
        app:layout_constraintEnd_toEndOf="@+id/status_img"
        app:layout_constraintStart_toStartOf="@+id/status_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/status_img"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:layout_marginLeft="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="@+id/due_date_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/index_title_tv"
        app:srcCompat="@drawable/cs_oc_bill_installment_uncompleted_icon"/>
    <TextView
        android:textColor="@color/ppColorSuccess"
        android:id="@+id/tvPeriod"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/due_date_tv"
        app:layout_constraintLeft_toLeftOf="@+id/top_divider_view"
        app:layout_constraintRight_toRightOf="@+id/top_divider_view"
        app:layout_constraintTop_toTopOf="@+id/index_title_tv"
        style="@style/Text.medium.202046.10"/>
    <View
        android:id="@+id/bottom_divider_view"
        android:background="@color/cs_oc_installment_uncompleted_color"
        android:layout_width="2dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/status_img"
        app:layout_constraintStart_toStartOf="@+id/status_img"
        app:layout_constraintTop_toBottomOf="@+id/status_img"/>
    <ProgressBar
        android:id="@+id/index_progress"
        android:layout_width="@dimen/dp28"
        android:layout_height="@dimen/dp28"
        android:max="100"
        android:progress="25"
        android:indeterminate="false"
        android:progressDrawable="@drawable/cs_oc_installment_index_progress"
        app:layout_constraintBottom_toBottomOf="@+id/index_tv"
        app:layout_constraintEnd_toEndOf="@+id/index_tv"
        app:layout_constraintStart_toStartOf="@+id/index_tv"
        app:layout_constraintTop_toTopOf="@+id/index_tv"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/index_tv"
        android:layout_width="@dimen/dp28"
        android:layout_height="@dimen/dp28"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/due_date_tv"
        app:layout_constraintStart_toEndOf="@+id/status_img"
        app:layout_constraintTop_toTopOf="@+id/index_title_tv"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#858a8f"
        android:id="@+id/index_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/due_date_tv"
        app:layout_constraintStart_toEndOf="@+id/index_progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorError"
        android:id="@+id/due_date_tv"
        android:background="@drawable/cs_cl_ins_due_txt_bg"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:text="@string/cs_cl_ins_days_overdue"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        app:layout_constraintBottom_toTopOf="@+id/principal_title_tv"
        app:layout_constraintStart_toStartOf="@+id/index_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/index_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/interest_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_oc_interest_fee"
        app:layout_constraintStart_toStartOf="@+id/principal_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/principal_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/interest_fee_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/interest_title_tv"
        app:layout_constraintEnd_toEndOf="@+id/principal_amount_tv"
        app:layout_constraintTop_toTopOf="@+id/interest_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/service_fee_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_oc_service_fee"
        app:layout_constraintBottom_toTopOf="@+id/padding_view"
        app:layout_constraintStart_toStartOf="@+id/principal_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/interest_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/principal_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cs_oc_installment_principal"
        app:layout_constraintBottom_toTopOf="@+id/service_fee_title_tv"
        app:layout_constraintStart_toStartOf="@+id/due_date_tv"
        app:layout_constraintTop_toBottomOf="@+id/due_date_tv"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cs_pay_off_txt_color"
        android:id="@+id/amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cs_cur_paid_off"
        android:drawablePadding="@dimen/dp5"
        android:drawableEnd="@drawable/cs_oc_installment_down_icon"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/due_date_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/index_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/principal_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/principal_title_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/principal_title_tv"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#858a8f"
        android:id="@+id/service_fee_amount_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/service_fee_title_tv"
        app:layout_constraintEnd_toEndOf="@+id/principal_amount_tv"
        app:layout_constraintTop_toTopOf="@+id/service_fee_title_tv"/>
    <View
        android:id="@+id/padding_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/amount_tv"
        app:layout_constraintStart_toStartOf="@+id/due_date_tv"
        app:layout_constraintTop_toBottomOf="@+id/service_fee_title_tv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/principal_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="principal_title_tv, principal_amount_tv, service_fee_title_tv, service_fee_amount_tv, interest_title_tv, interest_fee_amount_tv"/>
    <View
        android:id="@+id/hor_divider_view"
        android:background="@color/ppColorBackgroundDark"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/index_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
