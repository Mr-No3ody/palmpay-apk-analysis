<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_title="@string/core_transaction_details"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:paddingLeft="@dimen/dp12"
        android:paddingRight="@dimen/dp12"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/titleBar"
        android:paddingHorizontal="@dimen/dp12">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.custom_view.model.OrderResultHeaderModel
                android:id="@+id/model_order_result_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_result_amount_list"
                android:background="@drawable/cv_rect_bg_white_corner_bl_br_12"
                android:paddingTop="@dimen/dp8"
                android:paddingBottom="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp8"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingTop="@dimen/dp12"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingVertical="@dimen/dp12">
                <com.transsnet.palmpay.custom_view.model.OrderResultCopyToken
                    android:id="@+id/layout_result_token_copy"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_marginStart="@dimen/dp16"
                    android:layout_marginEnd="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/stub_result_special_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp8"
                    android:layout_marginStart="@dimen/dp12"
                    android:layout_marginEnd="@dimen/dp12"/>
                <com.transsnet.palmpay.custom_view.model.OrderDetailInfoListModel
                    android:id="@+id/layout_result_info_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <ViewStub
                android:id="@+id/stub_result_reward"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"/>
            <com.transsnet.palmpay.custom_view.model.OrderResultCustomerServiceModel
                android:id="@+id/model_order_result_customer_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.transsnet.palmpay.custom_view.model.OrderResultViewReceiptModel
        android:id="@+id/model_order_result_view_receipt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</LinearLayout>
