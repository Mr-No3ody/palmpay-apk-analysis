<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_title="@string/sm_schedule_empty_title"/>
    <com.transsnet.palmpay.custom_view.marqueeview.MarqueeView
        android:id="@+id/marqueeView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp40"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toTopOf="@+id/llBottom"
        app:layout_constraintTop_toBottomOf="@+id/marqueeView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/dp40"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginTop="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp4"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/iv_relationship"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                    app:layout_constraintTop_toTopOf="@+id/iv_avatar"
                    app:layout_goneMarginEnd="@dimen/dp16"
                    style="@style/Text.medium.202046.16"/>
                <ImageView
                    android:id="@+id/iv_relationship"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp20"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_name"
                    app:layout_constraintTop_toTopOf="@+id/tv_name"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp10"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"
                    style="@style/Text.6f7b85.14"/>
                <TextView
                    android:gravity="start"
                    android:id="@+id/tv_nont_verified"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:drawablePadding="@dimen/dp4"
                    android:drawableStart="@drawable/sm_ic_none_verified"
                    app:layout_constraintTop_toBottomOf="@+id/tv_info"
                    style="@style/Text.202046.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_input"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingBottom="@dimen/dp14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                app:layout_constraintTop_toBottomOf="@+id/tv_nont_verified">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp44"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tabGravity="fill"
                    app:tabIndicator="@drawable/core_tab_indicator_25"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/ppColorPrimary"
                    app:tabTextAppearance="@style/NormalTextStyle"
                    app:tabTextColor="@color/ppColorTextPrimary"/>
                <com.palmpay.lib.ui.edit.PpAmountEditText
                    android:id="@+id/et_transfer_money"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:inputType="numberDecimal"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:am_edit_show_button="false"
                    app:am_edit_show_lock="false"
                    app:am_edit_show_title="false"
                    app:am_edit_text_size="@dimen/dp22"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
                <com.palmpay.lib.ui.form.PpFormVertical
                    android:id="@+id/et_note"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:form_hide_text="Enter note (Within 200 characters）"
                    app:layout_constraintTop_toBottomOf="@+id/et_transfer_money"/>
                <Button
                    android:textSize="@dimen/dp10"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_add_note"
                    android:background="@drawable/core_next_btn_selector_corner_12dp_gray_bg"
                    android:layout_width="65dp"
                    android:layout_height="@dimen/dp24"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="@string/sm_add_a_note"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_transfer_money"
                    style="@style/Text.6306b2.12"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_date"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <TextView
                    android:id="@+id/tv_frequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12"
                    android:text="@string/sm_frequency"
                    android:layout_marginStart="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.14"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_frequency">
                    <RadioButton
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/sm_radio_btn_text_color"
                        android:gravity="center"
                        android:id="@+id/rb_only_once"
                        android:background="@drawable/core_selector_corner_4_bg_white_purple_stroke"
                        android:layout_width="72dp"
                        android:layout_height="30dp"
                        android:checked="true"
                        android:button="@null"
                        android:text="@string/sm_only_once"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>
                    <RadioButton
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/sm_radio_btn_text_color"
                        android:gravity="center"
                        android:id="@+id/rb_every_day"
                        android:background="@drawable/core_selector_corner_4_bg_white_purple_stroke"
                        android:layout_width="72dp"
                        android:layout_height="30dp"
                        android:checked="false"
                        android:button="@null"
                        android:text="@string/sm_every_day"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>
                    <RadioButton
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/sm_radio_btn_text_color"
                        android:gravity="center"
                        android:id="@+id/rb_weekly"
                        android:background="@drawable/core_selector_corner_4_bg_white_purple_stroke"
                        android:layout_width="72dp"
                        android:layout_height="30dp"
                        android:checked="false"
                        android:button="@null"
                        android:text="@string/sm_weekly"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>
                    <RadioButton
                        android:textSize="@dimen/dp14"
                        android:textColor="@color/sm_radio_btn_text_color"
                        android:gravity="center"
                        android:id="@+id/rb_monthly"
                        android:background="@drawable/core_selector_corner_4_bg_white_purple_stroke"
                        android:layout_width="72dp"
                        android:layout_height="30dp"
                        android:checked="false"
                        android:button="@null"
                        android:text="@string/sm_monthly"
                        android:layout_weight="1"/>
                </RadioGroup>
                <View
                    android:id="@+id/v_divider"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rg_period"
                    style="@style/core_divider_horizontal"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="v_divider"/>
                <ViewStub
                    android:id="@+id/vst_once"
                    android:layout="@layout/sm_layout_schedule_transfer_once"
                    android:inflatedId="@+id/cl_only_once"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/barrier_date"/>
                <ViewStub
                    android:id="@+id/vst_daily"
                    android:layout="@layout/sm_layout_schedule_transfer_daily"
                    android:inflatedId="@+id/cl_every_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/barrier_date"/>
                <ViewStub
                    android:id="@+id/vst_weekly"
                    android:layout="@layout/sm_layout_schedule_transfer_weekly"
                    android:inflatedId="@+id/cl_weekly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/barrier_date"/>
                <ViewStub
                    android:id="@+id/vst_monthly"
                    android:layout="@layout/sm_layout_schedule_transfer_monthly"
                    android:inflatedId="@+id/cl_monthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/barrier_date"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"
                    android:text="@string/core_payment_method"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Text.202046.14"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/tv_payment_tip"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/ppColorTextDisable"
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:text="@string/sm_when_the_default_payment_method"
                style="@style/Text.9ca2aa.12"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/llBottom"
        android:background="@color/ppColorBackgroundLight"
        android:paddingTop="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.mikepenz.iconics.view.IconicsCheckBox
            android:id="@+id/cb_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginStart="@dimen/dp16"
            app:iiv_checked_color="@color/ppColorPrimary"
            app:iiv_checked_icon="pay_CheckboxFill"
            app:iiv_checked_size="@dimen/dp20"
            app:iiv_unchecked_color="@color/ppColorTextAssist"
            app:iiv_unchecked_icon="pay_CheckboxOutline"
            app:iiv_unchecked_size="@dimen/dp20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/text_color_gray14_646970"
            android:id="@+id/tv_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="@+id/cb_agreement"
            app:layout_constraintStart_toEndOf="@+id/cb_agreement"
            app:layout_constraintTop_toTopOf="@+id/cb_agreement"
            style="@style/txt_mi_b"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/lib_ui_button_white_text_color"
            android:gravity="center"
            android:id="@+id/tv_create_order"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cv_default_button_height"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/sm_schedule_this_payment"
            android:layout_marginHorizontal="@dimen/dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cb_agreement"
            style="@style/txt_me_w_b"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
