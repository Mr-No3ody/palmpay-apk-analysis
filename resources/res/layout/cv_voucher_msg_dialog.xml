<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/CardView">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp45"
            android:paddingStart="@dimen/dp15"
            android:paddingEnd="@dimen/dp15">
            <ImageView
                android:id="@+id/msg_close_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cv_close_grey"/>
            <TextView
                android:textSize="@dimen/dp20"
                android:textColor="#de000000"
                android:gravity="center"
                android:id="@+id/msg_title_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cv_message"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorPrimary"
                android:id="@+id/msg_skip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cv_skip"/>
        </LinearLayout>
        <EditText
            android:id="@+id/msg_input_et"
            android:background="@drawable/cv_voucher_msg_edit_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/msg_operation"
            android:background="@color/ppColorPrimary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:text="@string/cv_reject"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
