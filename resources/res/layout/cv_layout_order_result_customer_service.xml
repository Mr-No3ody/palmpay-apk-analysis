<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_rect_corner_12_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center"
        android:id="@+id/tv_questions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cv_any_questions_about_this_transaction"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_me_g"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp12"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_CustomerService"
        app:iiv_size="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_questions_title"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv_left"
        android:paddingLeft="@dimen/dp6"
        android:paddingTop="@dimen/dp16"
        android:paddingRight="@dimen/dp6"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_customer_service"
        android:drawablePadding="@dimen/dp4"
        android:paddingHorizontal="@dimen/dp6"
        android:paddingVertical="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_left"
        app:layout_constraintTop_toBottomOf="@+id/tv_questions_title"
        style="@style/txt_s_g"/>
    <ImageView
        android:id="@+id/iv_right"
        android:layout_width="@dimen/dp16"
        android:layout_height="@dimen/dp16"
        android:src="@drawable/cv_ic_feedback_now"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_left"
        app:layout_constraintTop_toBottomOf="@+id/tv_questions_title"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv_right"
        android:paddingLeft="@dimen/dp6"
        android:paddingTop="@dimen/dp16"
        android:paddingRight="@dimen/dp6"
        android:paddingBottom="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cv_feedback_now"
        android:drawablePadding="@dimen/dp4"
        android:paddingHorizontal="@dimen/dp6"
        android:paddingVertical="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_right"
        app:layout_constraintTop_toBottomOf="@+id/tv_questions_title"
        style="@style/txt_s_g"/>
</merge>
