<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp16"
    android:paddingRight="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp16">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llCouponBg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp62"
        android:layout_marginBottom="@dimen/dp28"
        android:weightSum="3.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/vCouponLeftBg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="1"
            app:srcCompat="@drawable/main_reward_coupon_single_item_bg_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/vCouponRightBg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="2.6"
            app:srcCompat="@drawable/main_reward_coupon_single_item_bg_2"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glCouponSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2778"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierCouponBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="llCouponBg"/>
    <TextView
        android:textSize="@dimen/dp24"
        android:textColor="@color/ppColorPrimary"
        android:id="@+id/tvCouponAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/barrierCouponBg"
        app:layout_constraintEnd_toStartOf="@+id/glCouponSplit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llCouponBg"
        style="@style/txt_number_s_b_b"/>
    <TextView
        android:background="@drawable/cv_shape_rect_corner_tl_tr_4_bg_disabled"
        android:paddingLeft="@dimen/dp6"
        android:paddingRight="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp14"
        android:layout_marginBottom="@dimen/dp1"
        android:text="@string/core_coupon"
        android:paddingHorizontal="@dimen/dp6"
        app:layout_constraintBottom_toBottomOf="@+id/barrierCouponBg"
        app:layout_constraintEnd_toStartOf="@+id/glCouponSplit"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Text.202046.10"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvCouponTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tvCouponDesc"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/glCouponSplit"
        app:layout_constraintTop_toTopOf="@+id/llCouponBg"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/txt_s_b_b"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ppColorTextNormal"
        android:ellipsize="end"
        android:id="@+id/tvCouponDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrierCouponBg"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        app:layout_constraintStart_toEndOf="@+id/glCouponSplit"
        app:layout_constraintTop_toBottomOf="@+id/tvCouponTitle"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:gravity="center"
        android:id="@+id/btnRight"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/dp55"
        android:layout_marginStart="@dimen/extra_margin"
        android:layout_marginEnd="@dimen/dp8"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/barrierCouponBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llCouponBg"
        app:loading_size="8dp"
        style="@style/ppSmallButtonNoPaddingStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
