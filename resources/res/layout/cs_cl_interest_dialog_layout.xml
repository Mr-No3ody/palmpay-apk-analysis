<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/interest_close_img"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dp12"
        android:src="@drawable/cs_oc_dialog_close_icon"
        android:scaleType="fitXY"
        android:layout_marginEnd="@dimen/dp12"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_interest_dialog_title"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <TextView
        android:textColor="#646970"
        android:id="@+id/interest_desc_content_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginHorizontal="@dimen/dp24"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/cv_color_ffffff"
        android:id="@+id/interest_ok_bt"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp24"
        android:layout_marginRight="@dimen/dp24"
        android:layout_marginBottom="@dimen/dp22"
        android:text="@string/core_ok"
        android:backgroundTint="@color/cs_main_color"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
