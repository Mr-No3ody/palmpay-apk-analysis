<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layoutTax"
        android:background="@drawable/mm_bg_common_dialog"
        android:padding="@dimen/dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3"
            android:src="@drawable/mm_icon_warn_purple"/>
        <TextView
            android:gravity="left"
            android:id="@+id/tvTaxAmountDesc"
            android:layout_marginLeft="@dimen/dp8"
            style="@style/Text.202046.12"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/mm_bg_select_state"
        android:paddingTop="@dimen/dp20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16">
        <TextView
            android:text="Select State"
            style="@style/Text.medium.202046.18"/>
        <com.transsnet.palmpay.custom_view.wheelview.widget.WheelView
            android:id="@+id/areaWv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp180"/>
        <View
            android:background="@color/mm_color_f3f3f3"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp56"
            android:divider="@drawable/mm_select_state_divider"
            android:showDividers="middle">
            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Cancel"
                android:layout_weight="1"
                style="@style/Text.medium.9ca2aa.16"/>
            <TextView
                android:id="@+id/tvConfirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Confirm"
                android:layout_weight="1"
                style="@style/Text.medium.6306b2.16"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
