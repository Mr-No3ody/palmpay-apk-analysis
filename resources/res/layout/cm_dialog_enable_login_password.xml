<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@drawable/cv_dialog_top_left_right_corner_24dp_white_bg"
    android:paddingBottom="@dimen/dp12"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:text="@string/cm_set_a_password_for_login"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.202046.18"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_Lock"
        app:iiv_size="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp44"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/cm_use_independent_login_password"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon"
        style="@style/Text.6f7b85.14"/>
    <TextView
        android:id="@+id/btn_later"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:layout_marginTop="28dp"
        android:text="@string/core_later"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintEnd_toStartOf="@+id/btn_enbale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"
        style="@style/Text.medium.6306b2.16"/>
    <TextView
        android:id="@+id/btn_enbale"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp48"
        android:text="@string/cm_set"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_later"
        app:layout_constraintTop_toTopOf="@+id/btn_later"
        style="@style/Text.medium.ffffff.16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
