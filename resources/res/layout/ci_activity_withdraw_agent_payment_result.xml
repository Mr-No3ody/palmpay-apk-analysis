<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title_bar_background="@color/ppColorBackgroundLight"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsnet.palmpay.custom_view.model.TransactionResultHeaderModel
                android:id="@+id/progressView"
                android:background="@color/md_white_1000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_order_info"
                android:background="@drawable/cv_shape_rect_corner_12_bg_f6f6fa"
                android:padding="@dimen/dp12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_order_result_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.mikepenz.iconics.view.IconicsTextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_view_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="@string/core_result_view_detail"
                    android:lineHeight="@dimen/dp14"
                    app:iiv_end_color="@color/ppColorTextAssist"
                    app:iiv_end_icon="pay_ArrowCenterRight"
                    app:iiv_end_size="@dimen/dp14"
                    style="@style/Text.9ca2aa.12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/btnShareReceipt"
                android:background="@drawable/cv_shape_round_purple_border"
                android:visibility="gone"
                android:layout_width="@dimen/dp140"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20">
                <com.mikepenz.iconics.view.IconicsImageView
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    app:iiv_color="@color/ppColorPrimary"
                    app:iiv_icon="pay_Share"
                    app:iiv_size="16dp"/>
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp36"
                    android:text="@string/core_share_receipt"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp4"
                    style="@style/Text.medium.6306b2.14"/>
            </LinearLayout>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ad_cashback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.adsdk.widgets.SingleAdView
                android:id="@+id/ad_cashback2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/result_two_btn_view"
        android:paddingTop="10dp"
        android:paddingBottom="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16">
        <Button
            android:textSize="16dp"
            android:textColor="@color/ppColorTextBase"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_right_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
