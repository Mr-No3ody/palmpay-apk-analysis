<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ci_withdraw_amount_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp32">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/amount_tv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:fontFamily="@font/lib_ui_number_normal"
        app:autoSizeMaxTextSize="@dimen/dp12"
        app:autoSizeMinTextSize="@dimen/dp6"
        app:autoSizeTextType="uniform"/>
</FrameLayout>
