<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lib_ui_amount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ppTextStyleT2"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/amount_tip"
        android:background="@drawable/lib_ui_rect_corner_2_bg_assist"
        android:paddingLeft="4dp"
        android:paddingTop="@dimen/ppEditTextMarginTop_1"
        android:paddingRight="4dp"
        android:paddingBottom="@dimen/ppEditTextMarginTop_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingHorizontal="4dp"
        android:paddingVertical="@dimen/ppEditTextMarginTop_1"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <ImageView
        android:id="@+id/iv_arrow_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:src="@drawable/lib_ui_icon_arrow_down"
        app:layout_constraintStart_toStartOf="@+id/amount_tip"
        app:layout_constraintTop_toBottomOf="@+id/amount_tip"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="amount_tip,iv_arrow_down"/>
    <TextView
        android:gravity="start"
        android:id="@+id/tv_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="18dp"
        android:text="@string/lib_ui_currency_char_ng"
        android:fontFamily="@font/lib_ui_number_bold"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_amount_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/barrier_amount_top"
        style="@style/ppTextStyleT4"/>
    <com.palmpay.lib.ui.edit.AmountEditText
        android:textSize="@dimen/ppAmountEditTextSize"
        android:gravity="bottom"
        android:id="@+id/edit_amount"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ppAmountEditVerticalMargin"
        android:maxLines="1"
        android:maxLength="10"
        android:layout_centerVertical="true"
        android:inputType="number"
        android:textCursorDrawable="@drawable/lib_ui_editor_cursor_1"
        android:fontFamily="@font/lib_ui_number_bold"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/barrier_right_3"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/ppAmountEditTextSize"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tv_hint"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/edit_amount"
        app:layout_constraintStart_toStartOf="@+id/edit_amount"
        app:layout_constraintTop_toTopOf="@+id/edit_amount"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_amount_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="edit_amount,tv_hint"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_amount_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="edit_amount,tv_hint"/>
    <TextView
        android:enabled="false"
        android:textSize="12dp"
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:id="@+id/tv_action"
        android:background="@drawable/lib_ui_medium_button_bg_corner"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ppMediumButtonHeight"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/edit_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_lock"
        app:layout_constraintTop_toTopOf="@+id/edit_amount"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:iiv_color="@color/ppColorTextDisable"
        app:iiv_icon="pay_CloseFill"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_amount"
        app:layout_constraintEnd_toStartOf="@+id/iv_lock"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/edit_amount"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/iv_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginStart="10dp"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_LockFill"
        app:iiv_size="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_amount"
        app:layout_constraintEnd_toStartOf="@+id/tv_action"
        app:layout_constraintStart_toEndOf="@+id/iv_close"
        app:layout_constraintTop_toTopOf="@+id/edit_amount"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tv_action, iv_lock, parent, iv_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_divider"
        android:background="@color/ppColorDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ppAmountEditVerticalMargin"
        app:layout_constraintTop_toBottomOf="@+id/edit_amount"/>
    <TextView
        android:textSize="@dimen/ppAmountEditErrorTextSize"
        android:textColor="@color/ppColorError"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_weight="1"
        android:paddingEnd="5dp"
        app:layout_constraintTop_toBottomOf="@+id/view_divider"/>
</merge>
