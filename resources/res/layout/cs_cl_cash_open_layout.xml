<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_open_fl"
    android:background="@color/ppColorBackgroundDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cs_cl_open_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.palmpay.lib.ui.titlebar.PpTitleBar
            android:id="@+id/cl_cash_open_mtb"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="@dimen/dp24"
            app:title_bar_show_right_2_iv="false"
            app:title_bar_title=""/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.custom_view.marqueeview.MarqueeView
                    android:layout_gravity="bottom"
                    android:id="@+id/marquee"
                    android:background="@drawable/cs_cl_marquee_txt_bg"
                    android:paddingLeft="@dimen/dp8"
                    android:paddingTop="@dimen/dp6"
                    android:paddingRight="@dimen/dp8"
                    android:paddingBottom="@dimen/dp6"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp170"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp6"
                    app:mvGravity="left"
                    app:mvShowIconImg="false"
                    app:mvSingleLine="true"
                    app:mvTextColor="@color/ppColorTextPrimary"
                    app:mvTextSize="@dimen/dp10"/>
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/ppColorTextPrimary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp24"
                    android:layout_marginBottom="@dimen/dp30"
                    android:text="@string/core_cash_loan"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.transsnet.adsdk.widgets.SingleAdView
                        android:id="@+id/cl_open_top_sav"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rate_tv"
                        app:slot_id="@string/cl_open_top_single_ad_slot_id"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/open_card_cl"
                        android:background="@drawable/cv_shape_rect_corner_12_bg_white"
                        android:paddingTop="@dimen/dp16"
                        android:paddingBottom="@dimen/dp16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp30"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp16">
                        <ImageView
                            android:id="@+id/download_app_img"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/cs_cl_download_cash_app_icon"
                            android:layout_marginStart="16dp"
                            app:layout_constraintBottom_toBottomOf="@+id/document_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/download_app_tv"/>
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#bf7b16"
                            android:id="@+id/download_app_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_download_flexi_cash_app"
                            android:layout_marginStart="@dimen/dp7"
                            app:layout_constraintStart_toEndOf="@+id/download_app_img"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorWarning"
                            android:id="@+id/benefit_tv"
                            android:background="@drawable/cs_cl_benefit_txt_bg"
                            android:paddingLeft="@dimen/dp4"
                            android:paddingRight="@dimen/dp4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_cl_exclusive_benefits"
                            android:layout_marginStart="@dimen/dp4"
                            android:paddingHorizontal="@dimen/dp4"
                            app:layout_constraintBottom_toBottomOf="@+id/download_app_tv"
                            app:layout_constraintStart_toEndOf="@+id/download_app_tv"
                            app:layout_constraintTop_toTopOf="@+id/download_app_tv"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#b77b3b"
                            android:id="@+id/document_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/cs_no_need_to_submit"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/download_app_tv"
                            app:layout_constraintTop_toBottomOf="@+id/download_app_tv"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/precredit_group"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="download_app_img, download_app_tv,                         benefit_tv,document_tv"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/csTextview28"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cs_cl_loan_amount_up_to"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/document_tv"/>
                        <TextView
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/ppColorTextPrimary"
                            android:id="@+id/max_amount_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/csTextview28"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cs_cl_open_rate_txt_color"
                            android:ellipsize="marquee"
                            android:id="@+id/rate_tv"
                            android:background="@drawable/cs_oc_cl_ad_txt_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/cs_min_interest_rate"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/max_amount_tv"/>
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/cl_open_sav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp16"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rate_tv"
                            app:slot_id="@string/cl_open_single_ad_slot_id"/>
                        <TextView
                            android:enabled="false"
                            android:textSize="16sp"
                            android:textColor="@color/cs_cl_open_borrow_txt_color"
                            android:gravity="center"
                            android:id="@+id/cl_open_tv"
                            android:background="@drawable/cs_cl_open_borrow_txt_bg"
                            android:paddingTop="@dimen/dp14"
                            android:paddingBottom="@dimen/dp14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp16"
                            android:text="@string/cs_cl_borrow"
                            android:layout_marginStart="@dimen/dp16"
                            android:layout_marginEnd="@dimen/dp16"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.505"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/cl_open_sav"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ppColorTextBase"
                            android:gravity="center"
                            android:layout_gravity="end|bottom"
                            android:id="@+id/apply_bt_expired_tv"
                            android:background="@drawable/cs_cl_apply_bt_expired_bg"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:text="@string/cs_cl_expired_in_days"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginEnd="@dimen/dp24"
                            android:paddingHorizontal="6dp"
                            app:layout_constraintBottom_toTopOf="@+id/cl_open_tv"
                            app:layout_constraintEnd_toEndOf="@+id/cl_open_tv"
                            app:layout_constraintTop_toTopOf="@+id/cl_open_tv"/>
                        <com.transsnet.adsdk.widgets.SingleAdView
                            android:id="@+id/cl_borrow_bt_sav"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:scaleType="fitXY"
                            android:adjustViewBounds="true"
                            android:layout_marginHorizontal="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/cl_open_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/cl_open_tv"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/ppColorTextDisable"
                            android:gravity="center"
                            android:id="@+id/apply_after_date_tv"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/cs_cl_apply_for_loan_again_after"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/cl_open_tv"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/bottom_ad_title_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp32">
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="@dimen/dp12"
                        android:layout_height="@dimen/dp1"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/ppColorTextDisable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cs_cl_product_benefit"
                        android:layout_marginStart="@dimen/dp12"
                        android:layout_marginEnd="@dimen/dp12"/>
                    <View
                        android:background="@color/ppColorDividerLine"
                        android:layout_width="@dimen/dp12"
                        android:layout_height="@dimen/dp1"/>
                </LinearLayout>
                <com.transsnet.adsdk.widgets.SingleAdView
                    android:id="@+id/cl_open_bottom_sav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginRight="16dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rate_tv"
                    app:slot_id="@string/cl_open_bottom_single_ad_slot_id"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ppColorTextDisable"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp20"
            android:text="@string/cs_cl_powered_by_rockit_lenders"/>
    </LinearLayout>
</FrameLayout>
