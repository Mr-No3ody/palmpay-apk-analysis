<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/fb_tv_payment_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fb_payment_method"
        android:layout_marginStart="@dimen/fb_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/fb_txt_s_b"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_iv_payment_method_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fb_dp16"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_ArrowRight"
        app:iiv_size="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/fb_tv_payment_method"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fb_tv_payment_method"/>
    <TextView
        android:id="@+id/fb_tv_payment_method_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fb_all"
        android:paddingEnd="@dimen/fb_dp3"
        app:layout_constrainedHeight="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/fb_tv_payment_method"
        app:layout_constraintEnd_toStartOf="@+id/fb_iv_payment_method_arrow"
        style="@style/fb_txt_s_g"/>
</androidx.constraintlayout.widget.ConstraintLayout>
