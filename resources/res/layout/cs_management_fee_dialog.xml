<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/cv_shape_rect_corner_24_bg_white"
    android:paddingBottom="@dimen/dp24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsImageView
        android:layout_gravity="top|right"
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Close"
        app:iiv_size="20dp"/>
    <TextView
        android:text="@string/core_tips"
        style="@style/Text.medium.202046.18"/>
    <TextView
        android:gravity="left"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/cs_go_download_cash_app_desc"
        android:layout_marginHorizontal="@dimen/dp24"
        style="@style/Text.6f7b85.14"/>
    <com.transsnet.palmpay.custom_view.RoundedTextView
        android:id="@+id/rtvBorrowNow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="@dimen/dp24"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp24"
        android:text="@string/core_borrow_now"
        android:layout_marginHorizontal="@dimen/dp24"
        app:rtv_background_color="@color/cs_main_color"
        app:rtv_corner_radius="@dimen/dp12"
        style="@style/Text.medium.ffffff.16"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:id="@+id/tvTryAgain"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/cs_try_again_later"
        style="@style/Text.medium.ffffff.16"/>
</LinearLayout>
