<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@drawable/cv_shape_rect_corner_12_bg_white"
    android:layout_width="@dimen/dp270"
    android:layout_height="418dp">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_b"/>
    <ImageView
        android:id="@+id/iv_account"
        android:layout_width="226dp"
        android:layout_height="332dp"
        android:layout_marginTop="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textColor="@color/ppColorPrimary"
        android:gravity="center"
        android:id="@+id/tv_copy_info"
        android:background="@drawable/cv_shape_rect_corner_12_bg_secondary"
        android:layout_width="106dp"
        android:layout_height="@dimen/dp30"
        android:text="@string/core_copy_number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_download"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_account"
        style="@style/txt_s_b"/>
    <TextView
        android:textColor="@color/lib_ui_button_white_text_color"
        android:gravity="center"
        android:id="@+id/tv_download"
        android:background="@drawable/cv_shape_rect_corner_12_bg_primary"
        android:layout_width="106dp"
        android:layout_height="@dimen/dp30"
        android:text="@string/core_download"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_copy_info"
        app:layout_constraintTop_toBottomOf="@+id/iv_account"
        style="@style/txt_s_w"/>
</androidx.constraintlayout.widget.ConstraintLayout>
