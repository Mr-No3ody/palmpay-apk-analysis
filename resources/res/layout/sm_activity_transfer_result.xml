<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/result_two_btn_view"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.send_money.ui.view.TransferResultHeaderModel
                    android:id="@+id/v_header"
                    android:paddingTop="36dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/vs_transfer_to_palmpay_progress"
                    android:layout="@layout/sm_layout_transfer_to_palmpay_progress_viewstub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/vs_transfer_to_bank_progress"
                    android:layout="@layout/sm_layout_transfer_to_bank_progress_viewstub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <ViewStub
                    android:id="@+id/vs_transfer_to_bank_fast_refund_progress"
                    android:layout="@layout/sm_layout_transfer_to_bank_fast_refund_safeguard_viewstub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"/>
                <TextView
                    android:id="@+id/tvTransferToPP"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    style="@style/Text.6f7b85.12"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llOrderResultCard"
                    android:background="@drawable/cv_shape_rect_corner_12_bg_f6f6fa"
                    android:padding="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/llOrderResultList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.mikepenz.iconics.view.IconicsTextView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_view_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:text="@string/sm_view_transfer_details"
                        android:lineHeight="@dimen/dp14"
                        app:iiv_end_color="@color/ppColorTextAssist"
                        app:iiv_end_icon="pay_ArrowCenterRight"
                        app:iiv_end_size="@dimen/dp14"
                        style="@style/Text.9ca2aa.12"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/llSuccessfulBtn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_marginHorizontal="@dimen/dp16"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/btnShareReceipt"
                        android:background="@drawable/cv_shape_round_purple_border"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            app:iiv_color="@color/ppColorPrimary"
                            app:iiv_icon="pay_Share"
                            app:iiv_size="16dp"/>
                        <TextView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp36"
                            android:text="@string/core_share_receipt"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp4"
                            style="@style/Text.medium.6306b2.14"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/btnAddToFavorite"
                        android:background="@drawable/cv_shape_round_purple_border"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp12">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:id="@+id/iivFovarit"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            app:iiv_color="@color/ppColorPrimary"
                            app:iiv_icon="pay_LikeOutline"
                            app:iiv_size="16dp"/>
                        <TextView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tvAddFavorite"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp36"
                            android:text="@string/sm_add_to_favorite"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/dp4"
                            style="@style/Text.medium.6306b2.14"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <ViewStub
                android:id="@+id/vs_payment_rewards"
                android:layout="@layout/core_layout_order_result_rewords_view_stub"
                android:inflatedId="@+id/vReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/vs_cashback"
                android:layout="@layout/sm_layout_transfer_result_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/vs_success"
                android:layout="@layout/sm_layout_transfer_result_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/vs_view_ad"
                android:layout="@layout/sm_layout_transfer_result_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <ViewStub
                android:id="@+id/vs_fail"
                android:layout="@layout/sm_layout_transfer_result_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:layout_marginHorizontal="@dimen/dp16"/>
            <com.transsnet.palmpay.core.viewmodel.FailResultPageAdView
                android:id="@+id/viewFailOkcardAd"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp16"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginRight="@dimen/dp16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="@dimen/dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/result_two_btn_view"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="16dp"
            android:textColor="@color/ppColorButtonTextWhite"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/result_right_btn"
            android:background="@drawable/core_next_btn_selector_corner_12dp_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/cv_default_button_height"
            android:text="@string/core_complete"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <com.palmpay.lib.ui.titlebar.PpTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
