<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/p2p_about_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="#263138"
        android:id="@+id/p2p_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/core_payment"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/p2p_close"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cv_close_grey"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_booking_deposit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="22dp"
        android:text="@string/p2p_str_booking_deposit"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_title"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/p2p_i"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorPrimary"
        app:iiv_icon="pay_InformationOutline"
        app:iiv_size="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_booking_deposit"
        app:layout_constraintLeft_toRightOf="@+id/p2p_booking_deposit"
        app:layout_constraintTop_toTopOf="@+id/p2p_booking_deposit"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_deposit_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/p2p_booking_deposit"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/p2p_booking_deposit"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/p2p_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:cardBackgroundColor="@color/ppColorBackgroundDark"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_booking_deposit">
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7b85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/p2p_booking_pay_tips_______"
            android:lineSpacingMultiplier="1.2"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ppColorTextPrimary"
        android:id="@+id/p2p_payment_method_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="32dp"
        android:text="@string/p2p_str_balance_payment_only"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_tips"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/p2p_balance"
        android:background="@drawable/cv_payment_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp132"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_payment_method_tips">
        <ImageView
            android:id="@+id/p2p_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:src="@mipmap/p2p_palmpay_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/p2p_logo"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ppColorTextPrimary"
                android:id="@+id/p2p_payment_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p2p_str_balance_________"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/p2p_free"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="#fff7e7"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ppColorWarning"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:text="@string/p2p_str_first_account_top_up_get_free"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <com.mikepenz.iconics.view.IconicsImageView
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:iiv_color="@color/ppColorTextNormal"
            app:iiv_icon="pay_ArrowCenterRight"
            app:iiv_size="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/p2p_fund"
            android:visibility="gone"
            android:layout_width="63dp"
            android:layout_height="30dp"
            android:layout_marginRight="32dp"
            app:cardBackgroundColor="@color/p2p_theme_color"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ppColorTextBase"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_fund"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.transsnet.palmpay.p2pcash.ui.atm.view.P2PButton
        android:id="@+id/p2p_pay"
        android:background="@color/ppColorBackgroundLight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/p2p_balance"
        app:p2p_btn_name="@string/core_pay"
        app:p2p_btn_status="disable"/>
</androidx.constraintlayout.widget.ConstraintLayout>
