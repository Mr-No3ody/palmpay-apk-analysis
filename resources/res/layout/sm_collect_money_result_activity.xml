<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/sm_foreground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/collect_money_result_img"
        android:layout_width="@dimen/cv_result_success_img_size"
        android:layout_height="@dimen/cv_result_success_img_size"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/cv_result_success"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/cv_result_success"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#ff263138"
        android:gravity="center"
        android:id="@+id/collect_money_result_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:text="@string/sm_tf_money_success"
        android:textAllCaps="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ff95a1ab"
        android:gravity="center"
        android:id="@+id/collect_money_result_desc_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem
        android:id="@+id/collect_result_money"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cv_tt_title="@string/sm_confirm_amount"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem
        android:id="@+id/collect_result_sender"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cv_tt_title="@string/sm_receive_sender_text"/>
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTextItem
        android:id="@+id/collect_result_sender_msg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cv_tt_title="@string/sm_confirm_remark"/>
    <Button
        android:textSize="18sp"
        android:textColor="@color/sm_confirm_btn_text_color"
        android:gravity="center"
        android:id="@+id/collect_money_result_upgrade_account"
        android:background="@drawable/core_next_btn_selector_bg"
        android:visibility="gone"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="@string/sm_upgrade_account_text"
        android:textAllCaps="false"/>
    <Button
        android:textSize="18sp"
        android:textColor="@color/sm_confirm_btn_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/collect_money_complete"
        android:background="@drawable/core_next_btn_selector_bg"
        android:visibility="gone"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:text="@string/sm_complete_text"
        android:textAllCaps="false"/>
</LinearLayout>
