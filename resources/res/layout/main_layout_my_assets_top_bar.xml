<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutSecurityGuaranteed"
    android:background="@drawable/cv_shape_rect_corner_tl_tr_12_bg_success_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp24">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivSecurityGuaranteed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorSuccess"
        app:iiv_icon="pay_Security"
        app:iiv_size="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tvSecurityGuaranteed"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ppColorSuccess"
        android:id="@+id/tvSecurityGuaranteed"
        android:text="@string/main_str_security_guaranteed"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ivSecurityGuaranteed"
        app:layout_constraintRight_toLeftOf="@+id/ivArrowRight"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.6306b2.12"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivArrowRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:iiv_color="@color/ppColorSuccess"
        app:iiv_icon="pay_ArrowCenterRight"
        app:iiv_size="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tvSecurityGuaranteed"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
