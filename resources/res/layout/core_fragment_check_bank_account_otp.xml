<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iiv_color="@color/ppColorBackgroundLight"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:paddingTop="38dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_title_attention"
        style="@style/txt_l_b"/>
    <TextView
        android:textColor="@color/ppColorTextNormal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_msg_verify_otp_for_bank_account"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"/>
    <com.transsnet.palmpay.custom_view.model.ModelSendSms
        android:id="@+id/send_opt_mss"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:cv_te_title="@string/core_otp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_bank_account_tev"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ppColorError"
        android:id="@+id/invalidate_otp_tip_tv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_invalidate_otp_tips"
        android:drawableEnd="@drawable/cv_warning"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"/>
    <com.transsnet.palmpay.custom_view.StateListTextView
        android:enabled="false"
        android:textAppearance="@style/txt_s_w"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewContinue"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="45dp"
        android:text="@string/core_continue"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        style="@style/CvCornerButtonStyle"/>
</LinearLayout>
