<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsnet.palmpay.custom_view.model.ModelBillDetailTitle
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleBar">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/ppColorBackgroundLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsnet.palmpay.custom_view.model.ModelAmountList
                android:id="@+id/amountList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <include
                android:id="@+id/viewFailReason"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_transaction_fail_reason"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/itemPaymentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_show_img="false"
                app:ctai_title="@string/core_payment_type"/>
            <com.transsnet.palmpay.custom_view.model.ModelTitleContentImg
                android:id="@+id/itemPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginRight="@dimen/dp15"
                app:ctai_title="@string/core_payment_method"/>
            <com.transsnet.palmpay.custom_view.model.ModelCopyableText
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvOrderNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp15"
                app:mctTitle="@string/core_reference_no_2"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvPostDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"/>
            <TextView
                android:textSize="@dimen/dp11"
                android:textColor="@color/ppColorTextDisable"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvTransDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp15"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp25"/>
            <LinearLayout
                android:id="@+id/itemReport"
                android:background="@color/ppColorBackgroundDark"
                android:paddingTop="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsnet.palmpay.core.viewmodel.ReportTransactionItem
                    android:id="@+id/common_report_item"
                    android:background="@color/ppColorBackgroundLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <include
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/cv_layout_contact_service"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
