<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/qt_scene_betting_auto_renew_overlay">
    <View
        android:id="@+id/overlay_background"
        android:background="@color/transparent_54"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_sheet_container"
        android:background="@drawable/qt_shape_betting_auto_renew_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp48">
            <TextView
                android:textSize="@dimen/dp18"
                android:textStyle="bold"
                android:textColor="@color/ppColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp48"
                android:layout_marginRight="@dimen/dp48"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/dp48"/>
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/btn_close"
                android:padding="@dimen/dp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp8"
                android:layout_alignParentEnd="true"
                app:iiv_color="@color/ppColorTextAssist"
                app:iiv_icon="pay_Close"
                app:iiv_size="@dimen/dp20"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_plan"
            android:background="@drawable/qt_shape_betting_auto_renew_card"
            android:padding="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:layout_marginBottom="@dimen/dp16"
            android:layout_marginHorizontal="@dimen/dp20">
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorTextNormal"
                android:id="@+id/tv_plan_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qt_betting_auto_topup_plan"/>
            <TextView
                android:textSize="@dimen/dp24"
                android:textStyle="bold"
                android:textColor="@color/qt_betting_auto_renew_gold"
                android:id="@+id/tv_plan_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_first_topup_row"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tv_first_topup_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/qt_betting_first_topup_special"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textColor="@color/ppColorTextNormal"
                    android:id="@+id/tv_first_topup_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp4"/>
                <TextView
                    android:textSize="@dimen/dp16"
                    android:textStyle="bold"
                    android:textColor="@color/qt_betting_auto_renew_gold"
                    android:id="@+id/tv_first_topup_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/confirmation_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.mikepenz.iconics.view.IconicsCheckBox
                android:id="@+id/cbAgreement"
                android:background="@null"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:button="@null"
                app:iiv_checked_color="@color/qt_betting_auto_renew_gold"
                app:iiv_checked_icon="pay_CheckboxFill"
                app:iiv_checked_size="@dimen/dp16"
                app:iiv_unchecked_color="@color/ppColorTextAssist"
                app:iiv_unchecked_icon="pay_CheckboxOutline"
                app:iiv_unchecked_size="@dimen/dp16"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/qt_betting_auto_renew_gold"
                android:id="@+id/tvAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp16"
            android:paddingTop="@dimen/dp10"
            android:paddingRight="@dimen/dp16"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp16">
            <TextView
                android:textSize="@dimen/dp16"
                android:textStyle="bold"
                android:textColor="@color/ppColorPopupWhiteBg"
                android:gravity="center"
                android:id="@+id/btnTurnOn"
                android:background="@drawable/qt_shape_betting_auto_renew_turn_on_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp48"
                android:text="@string/qt_betting_turn_on"/>
            <TextView
                android:textSize="@dimen/dp14"
                android:textColor="@color/ppColorTextAssist"
                android:gravity="center"
                android:id="@+id/tv_dont_remind"
                android:padding="@dimen/dp4"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/qt_betting_dont_remind_again"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.motion.widget.MotionLayout>
