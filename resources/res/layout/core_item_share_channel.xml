<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivItemIcon"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:scaleType="fitCenter"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvItemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/ivItemIcon"
        app:layout_constraintStart_toEndOf="@+id/ivItemIcon"
        app:layout_constraintTop_toTopOf="@+id/ivItemIcon"
        style="@style/Text.202046.12"/>
    <View
        android:id="@+id/vItemDivider"
        android:background="@color/ppColorDisabled"
        android:layout_width="@dimen/dp1"
        android:layout_height="@dimen/dp19"
        android:layout_marginStart="@dimen/dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvItemName"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvItemCopy"
        android:background="@drawable/cv_shape_halfround_purple_stroke"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp20"
        android:minWidth="@dimen/dp40"
        android:text="@string/core_copy"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.10"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvItemValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvItemCopy"
        app:layout_constraintStart_toEndOf="@+id/vItemDivider"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.medium.6306b2.12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
