<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.palmpay.lib.liveness.ui.widget.LTitleBar
        android:id="@+id/face_titlebar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title_bar_back_icon="@drawable/lib_liveness_ic_back"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/face_business_tip_txt_color"
        android:gravity="center"
        android:id="@+id/face_business_tips_tv"
        android:background="@color/face_business_tip_bg_color"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/face_titlebar"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/face_liveness_tip_color"
        android:gravity="center"
        android:id="@+id/face_bottom_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:minHeight="50dp"
        android:layout_below="@+id/face_business_tips_tv"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="16dp"/>
    <FrameLayout
        android:id="@+id/centerFrameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/face_bottom_tips_tv"
        android:layout_centerHorizontal="true">
        <com.palmpay.lib.liveness.ui.widget.RoundFrameLayout
            android:layout_gravity="center"
            android:id="@+id/face_circle_framelayout"
            android:layout_width="240dp"
            android:layout_height="240dp">
            <androidx.camera.view.PreviewView
                android:layout_gravity="center"
                android:id="@+id/camera_preview"
                android:layout_width="240dp"
                android:layout_height="240dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/face_path"
                android:layout_width="256dp"
                android:layout_height="256dp"
                app:srcCompat="0x7f080963"/>
        </com.palmpay.lib.liveness.ui.widget.RoundFrameLayout>
        <com.palmpay.lib.liveness.ui.widget.AlgorithmScheduleProgressBar
            android:layout_gravity="center"
            android:id="@+id/face_algorithm_schedule_progressbar"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:face_color_bg_width="256dp"
            app:face_end_angle="360"
            app:face_max="3600"
            app:face_progress_shader="true"
            app:face_round_progress_end_color="@color/face_primary_color"
            app:face_round_progress_start_color="@color/face_primary_color"
            app:face_round_width="4dp"
            app:face_text_is_displayable="false"/>
    </FrameLayout>
    <com.palmpay.lib.liveness.ui.widget.LivenessStepLayout
        android:id="@+id/face_step"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/centerFrameView"/>
    <ViewFlipper
        android:id="@+id/liveness_view_flipper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:inAnimation="@anim/right_in"
        android:outAnimation="@anim/left_out"
        android:layout_below="@+id/face_step"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/face_pp_license"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:src="@drawable/lib_liveness_pp_license"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
