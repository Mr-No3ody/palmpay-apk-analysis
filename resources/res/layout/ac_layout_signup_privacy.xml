<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewPrivacy"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mikepenz.iconics.view.IconicsCheckBox
        android:id="@+id/checkAgreement2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        app:iiv_checked_color="@color/ppColorTextPrimary"
        app:iiv_checked_icon="pay_Checkbox"
        app:iiv_checked_size="16dp"
        app:iiv_unchecked_color="@color/ppColorTextPrimary"
        app:iiv_unchecked_icon="pay_CheckboxOutline"
        app:iiv_unchecked_size="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/textViewAgreement2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textViewAgreement2"/>
    <TextView
        android:textAppearance="@style/txt_mi_g"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textViewAgreement2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_msg_terms_line1"
        android:paddingStart="4dp"
        android:paddingEnd="3dp"
        app:layout_constraintStart_toEndOf="@+id/checkAgreement2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_msg_terms_line23"
        app:layout_constraintStart_toEndOf="@+id/textViewAgreement2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_b"/>
</androidx.constraintlayout.widget.ConstraintLayout>
