<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/ussd_desc_tv"
        android:paddingLeft="@dimen/dp16"
        android:paddingRight="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ci_ussd_result_content"
        android:paddingHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_mi_g"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/ussdBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp64"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/ppColorSecondary"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="0dp"
        app:contentPadding="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ussd_desc_tv"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/ussd_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ussdBg"
        style="@style/txt_s_g"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/ussd_phone_num_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="4dp"
        app:iiv_end_color="@color/ppColorTextPrimary"
        app:iiv_end_icon="pay_Copy"
        app:iiv_end_size="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ussd_countdown"
        style="@style/txt_me_b_b"/>
    <View
        android:background="@drawable/cv_button_bg_purple_corner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cv_default_button_height"
        app:layout_constraintTop_toTopOf="@+id/ussd_call_bt"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="14dp"
        android:textColor="@color/ppColorButtonTextWhite"
        android:gravity="center"
        android:id="@+id/ussd_call_bt"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp26"
        android:layout_marginTop="17dp"
        android:layout_marginRight="@dimen/dp26"
        android:text="@string/core_tap_to_call"
        android:drawablePadding="4dp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/dp26"
        app:iiv_start_color="@color/ppColorButtonTextWhite"
        app:iiv_start_icon="pay_Phone"
        app:iiv_start_size="@dimen/dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ussdBg"/>
</merge>
