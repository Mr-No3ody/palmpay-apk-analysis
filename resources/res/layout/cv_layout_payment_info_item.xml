<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:paddingLeft="@dimen/dp12"
    android:paddingTop="@dimen/dp6"
    android:paddingRight="@dimen/dp12"
    android:paddingBottom="@dimen/dp6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp28"
    android:paddingHorizontal="@dimen/dp12"
    android:paddingVertical="@dimen/dp6">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_item_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/space_item"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/dp100"
        style="@style/txt_s_b">
        <TextView
            android:gravity="start"
            android:id="@+id/tv_item_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/iv_item_key_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.6f7b85.14"/>
        <ImageView
            android:id="@+id/iv_item_key_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp7"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_item_key"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_item_key"
            app:layout_constraintTop_toTopOf="@+id/tv_item_key"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:id="@+id/space_item"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp1"
        app:layout_constraintEnd_toStartOf="@+id/ll_item_value"
        app:layout_constraintStart_toEndOf="@+id/ll_item_key"
        app:layout_constraintWidth_min="@dimen/dp20"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp4"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/space_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="@dimen/dp100"
        style="@style/txt_s_b_b">
        <ImageView
            android:id="@+id/iv_item_value_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp7"
            android:layout_marginEnd="@dimen/dp4"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_item_line_value"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="@dimen/dp4"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4"
            style="@style/Text.9ca2aa.14"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_item_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/dp4"
            style="@style/Text.202046.14"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_content_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ll_item_key,ll_item_value"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tv_item_key_hint"
        android:paddingTop="@dimen/dp5"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp20"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_content_bottom"
        style="@style/txt_s_g"/>
    <ImageView
        android:id="@+id/iv_item_value_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp16"
        android:adjustViewBounds="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_content_bottom"
        style="@style/txt_s_g"/>
</merge>
