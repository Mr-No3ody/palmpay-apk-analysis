<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cv_shape_rect_top_corner_white_12"
    android:paddingBottom="@dimen/dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <com.transsnet.palmpay.custom_view.image.RoundImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/dp44"
        android:layout_height="@dimen/dp44"
        android:layout_marginTop="@dimen/dp16"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp16"
        app:cvRadius="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp27"
        android:src="@drawable/main_head_picture"
        android:layout_marginStart="@dimen/dp30"
        app:layout_constraintStart_toStartOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="@dimen/dp14"
        android:textColor="@color/ppColorTextPrimary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:paddingBottom="@dimen/dp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp4"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:paddingEnd="66dp"
        android:layout_marginStart="@dimen/dp8"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
    <ImageView
        android:id="@+id/ivPremium"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:id="@+id/tvAccountNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp8"
        app:layout_constraintLeft_toRightOf="@+id/ivAvatar"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/txt_mi_g"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/tvCopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp5"
        app:iiv_color="@color/ppColorTextNormal"
        app:iiv_icon="pay_Copy"
        app:iiv_size="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvAccountNo"
        app:layout_constraintLeft_toRightOf="@+id/tvAccountNo"
        app:layout_constraintTop_toTopOf="@+id/tvAccountNo"/>
    <com.mikepenz.iconics.view.IconicsTextView
        android:textSize="10dp"
        android:textColor="@color/ppColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tvPrivacyAccount"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Privacy Account No."
        android:drawablePadding="2dp"
        android:layout_marginStart="6dp"
        app:iiv_start_color="@color/ppColorPrimary"
        app:iiv_start_icon="pay_Exchange"
        app:iiv_start_size="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvAccountNo"
        app:layout_constraintLeft_toRightOf="@+id/tvAccountNo"
        app:layout_constraintTop_toTopOf="@+id/tvAccountNo"/>
    <TextView
        android:textSize="@dimen/dp10"
        android:textColor="@color/ppColorTextAssist"
        android:gravity="center_vertical"
        android:id="@+id/tvLastLogin"
        android:paddingTop="@dimen/dp2"
        android:paddingBottom="@dimen/dp2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp2"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupAccountNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvAccountNo,tvCopy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
