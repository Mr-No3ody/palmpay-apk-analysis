<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/jp_refer_earn_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/jp_my_cash_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp16"
        android:text="@string/jp_my_cash_reward"
        android:layout_marginStart="@dimen/dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/txt_b_w_b"/>
    <com.palmpay.lib.ui.button.PpButton
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tvWithdraw"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:text="@string/core_withdraw"
        android:layout_marginEnd="@dimen/dp16"
        android:backgroundTint="@color/ppColorFlexiCashAssist"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintBottom_toBottomOf="@+id/jp_my_cash_reward"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_my_cash_reward"
        style="@style/ppSmallButtonNoPaddingStyle"/>
    <TextView
        android:textSize="@dimen/dp22"
        android:textColor="@color/ppColorFlexiCashAssist"
        android:id="@+id/tvCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/core_ngn_symbol"
        android:layout_marginStart="@dimen/dp4"
        app:layout_constraintBottom_toBottomOf="@+id/jp_my_cash_reward"
        app:layout_constraintStart_toEndOf="@+id/jp_my_cash_reward"
        app:layout_constraintTop_toTopOf="@+id/jp_my_cash_reward"/>
    <com.rollingtextview.RollingTextView
        android:textSize="@dimen/dp22"
        android:textColor="@color/ppColorFlexiCashAssist"
        android:id="@+id/jp_my_cash_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/jp_my_cash_reward"
        app:layout_constraintStart_toEndOf="@+id/tvCurrency"
        app:layout_constraintTop_toTopOf="@+id/jp_my_cash_reward"/>
    <TextView
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/jp_cash_invite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCurrency"
        style="@style/txt_s_b_b"/>
    <com.transsnet.palmpay.jara_packet.ui.model.ReferEarnTaskProgressModel
        android:id="@+id/reTaskProgress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp80"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_cash_invite"/>
    <ViewStub
        android:id="@+id/rewardProgressStub"
        android:layout="@layout/jp_layout_re_progress"
        android:inflatedId="@+id/rewardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginEnd="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_cash_invite"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="reTaskProgress, rewardProgressStub, rewardProgress"/>
    <View
        android:id="@+id/line1"
        android:background="#4a2aa1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginRight="@dimen/dp16"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomBarrier"/>
    <ImageView
        android:id="@+id/ivIcon1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/dp12"
        android:src="@drawable/jp_icon_guide_1"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dp36"
        app:layout_constraintEnd_toStartOf="@+id/ivIcon12"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line1"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Share Link"
        app:layout_constraintEnd_toEndOf="@+id/ivIcon1"
        app:layout_constraintStart_toStartOf="@+id/ivIcon1"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon1"
        style="@style/txt_mi_w"/>
    <ImageView
        android:id="@+id/ivIcon12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/jp_icon_guide_link"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon1"
        app:layout_constraintEnd_toStartOf="@+id/ivIcon2"
        app:layout_constraintStart_toEndOf="@+id/ivIcon1"
        app:layout_constraintTop_toTopOf="@+id/ivIcon1"/>
    <ImageView
        android:id="@+id/ivIcon2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/jp_icon_guide_2"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon1"
        app:layout_constraintEnd_toStartOf="@+id/ivIcon23"
        app:layout_constraintStart_toEndOf="@+id/ivIcon12"
        app:layout_constraintTop_toTopOf="@+id/ivIcon1"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Invitee Finished Tasks"
        app:layout_constraintEnd_toEndOf="@+id/ivIcon2"
        app:layout_constraintStart_toStartOf="@+id/ivIcon2"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon1"
        style="@style/txt_mi_w"/>
    <ImageView
        android:id="@+id/ivIcon23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/jp_icon_guide_link"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon1"
        app:layout_constraintEnd_toStartOf="@+id/ivIcon3"
        app:layout_constraintStart_toEndOf="@+id/ivIcon2"
        app:layout_constraintTop_toTopOf="@+id/ivIcon1"/>
    <ImageView
        android:id="@+id/ivIcon3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/jp_icon_guide_3"
        android:scaleType="fitXY"
        android:layout_marginEnd="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivIcon1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivIcon23"
        app:layout_constraintTop_toTopOf="@+id/ivIcon1"/>
    <TextView
        android:textSize="10dp"
        android:gravity="center_vertical"
        android:id="@+id/tv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Get Cash"
        app:layout_constraintEnd_toEndOf="@+id/ivIcon3"
        app:layout_constraintStart_toStartOf="@+id/ivIcon3"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon1"
        style="@style/txt_mi_w"/>
    <TextView
        android:textColor="@color/ppColorTextPrimary"
        android:gravity="center"
        android:id="@+id/jp_cash_invite_btn"
        android:background="@drawable/jp_shape_orange_r22_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cv_default_button_height"
        android:layout_marginLeft="@dimen/dp16"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginRight="@dimen/dp16"
        android:text="@string/jp_invite_now"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv3"
        style="@style/txt_me_b_b"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:src="@drawable/cv_finger1"
        android:layout_marginEnd="@dimen/dp40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/jp_cash_invite_btn"/>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextDisable"
        android:id="@+id/tvReward"
        android:paddingTop="@dimen/dp12"
        android:paddingBottom="@dimen/dp12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jp_reward_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/jp_cash_invite_btn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clInvitationCodeSection"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvReward">
        <TextView
            android:textSize="@dimen/dp12"
            android:textColor="@color/ppColorTextDisable"
            android:id="@+id/tvShareInvitationCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jp_share_invitation_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clInvitationCodeContainer"
            android:background="@drawable/cv_shape_rect_corner_8_bg_secondary"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp16"
            android:backgroundTint="#150854"
            android:layout_marginHorizontal="@dimen/dp16"
            android:paddingHorizontal="@dimen/dp8"
            android:paddingVertical="@dimen/dp2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvShareInvitationCodeLabel">
            <TextView
                android:textSize="@dimen/dp24"
                android:textColor="@color/ppColorFlexiCashAssist"
                android:gravity="center"
                android:id="@+id/tvInvitationCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnCopyInvitationCode"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp12"
                android:textColor="@color/ppColorButtonTextWhite"
                android:gravity="center"
                android:id="@+id/btnCopyInvitationCode"
                android:background="@drawable/cv_shape_rect_corner_16_bg_transparent_stroke_white"
                android:paddingLeft="@dimen/dp12"
                android:paddingRight="@dimen/dp12"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp24"
                android:minWidth="@dimen/dp44"
                android:text="@string/jp_copy"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp12"
                android:paddingHorizontal="@dimen/dp12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvInvitationCode"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dp12"
        android:textColor="@color/ppColorTextBase"
        android:gravity="center"
        android:id="@+id/jp_cash_invite_expire"
        android:background="@drawable/jp_re_time_bg"
        android:paddingLeft="@dimen/dp8"
        android:paddingRight="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="@dimen/dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clInvitationCodeSection"/>
</androidx.constraintlayout.widget.ConstraintLayout>
