<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ppColorBackgroundLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/fb_ivClose"
        android:paddingLeft="@dimen/fb_dp16"
        android:paddingRight="@dimen/fb_dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fb_dp16"
        app:iiv_color="@color/ppColorTextPrimary"
        app:iiv_icon="pay_Close"
        app:iiv_size="24dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_ivBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp10"
        android:src="@drawable/fb_default_bank_logo"
        android:scaleType="fitXY"/>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_tvBankName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_dp16"
        style="@style/fb_txt_s_b"/>
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp30"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/fb_dp30"
        android:text="@string/fb_msg_require_card_pin_verify"
        android:layout_marginHorizontal="@dimen/fb_dp30"
        style="@style/fb_txt_s_g"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/fb_tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fb_dp16"
        android:layout_marginTop="@dimen/fb_dp34"
        android:layout_marginRight="@dimen/fb_dp16"
        android:text="@string/fb_card_pin"
        android:drawableTint="@color/fb_text_color_black1"
        android:layout_marginHorizontal="@dimen/fb_dp16"
        style="@style/fb_txt_s_b"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/fb_medium_text"
        android:gravity="center_vertical"
        android:id="@+id/fb_editCardPin"
        android:background="@drawable/fb_title_input_underline"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/fb_dp16"
        android:layout_marginRight="@dimen/fb_dp16"
        android:hint="@string/fb_enter_card_pin"
        android:maxLength="4"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/fb_dp16"/>
    <com.palmpay.lib.ui.button.PpButton
        android:enabled="false"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fb_buttonNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fb_default_button_height"
        android:layout_marginLeft="@dimen/fb_dp24"
        android:layout_marginTop="@dimen/fb_dp40"
        android:layout_marginRight="@dimen/fb_dp24"
        android:text="@string/fb_core_next"
        android:layout_marginHorizontal="@dimen/fb_dp24"
        style="@style/fbButtonStyle"/>
</LinearLayout>
