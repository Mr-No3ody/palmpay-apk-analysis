<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_account"
    android:background="@drawable/main_rect_bg_secondary_corner_bl_br_12"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp16"
    android:layout_marginTop="-5dp"
    android:layout_marginRight="@dimen/dp16"
    android:layout_marginHorizontal="@dimen/dp16"
    app:layout_constraintBottom_toTopOf="@+id/imageViewNext"
    app:layout_constraintTop_toBottomOf="@+id/tvTotalAssetsAmount">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rl_accountList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mikepenz.iconics.view.IconicsImageView
        android:id="@+id/imageViewUp"
        android:paddingLeft="@dimen/dp30"
        android:paddingTop="@dimen/dp5"
        android:paddingRight="@dimen/dp30"
        android:paddingBottom="@dimen/dp5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp30"
        app:iiv_color="@color/ppColorTextAssist"
        app:iiv_icon="pay_ArrowUp"
        app:iiv_size="@dimen/dp16"/>
</LinearLayout>
