<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <corners android:radius="@dimen/dp4"/>
            <solid android:color="@color/cs_oc_main_color"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dp4"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorDividerLine"/>
        </shape>
    </item>
</selector>
