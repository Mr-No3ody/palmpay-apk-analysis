<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:top="0dp"
        android:bottom="0dp">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#8862f4"
                android:endColor="#4e23db"
                android:angle="0"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <solid android:color="@color/ppColorFlexiCashAssist"/>
            </shape>
        </clip>
    </item>
</layer-list>
