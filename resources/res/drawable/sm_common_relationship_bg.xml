<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/dp100"/>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorPrimary"/>
            <solid android:color="#ffffff"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp100"/>
            <solid android:color="@color/ppColorDividerLine"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dp100"/>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorTextDisable"/>
            <solid android:color="#ffffff"/>
        </shape>
    </item>
</selector>
