<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/fb_base_colorPrimary"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/fb_purple_color6"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="@color/fb_base_colorPrimary"
                android:endColor="@color/fb_base_colorPrimary"
                android:angle="315"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>
</selector>
