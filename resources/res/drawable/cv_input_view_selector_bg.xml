<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_enabled="false">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorDividerLine"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item app:state_error="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorError"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorPrimary"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorTextAssist"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
