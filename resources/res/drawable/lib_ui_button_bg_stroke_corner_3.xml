<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/ppButtonCornerBigRadius"/>
            <solid android:color="@color/ppColorSecondary"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ppButtonCornerBigRadius"/>
            <stroke
                android:width="1dp"
                android:color="@color/ppColorPrimary"/>
            <solid android:color="@color/pp_transparent"/>
        </shape>
    </item>
</selector>
