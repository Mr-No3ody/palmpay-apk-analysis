<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <corners android:radius="8dp"/>
            <solid android:color="@color/cs_main_color"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp"/>
            <solid android:color="@color/ppColorBackgroundLight"/>
            <stroke
                android:width="1dp"
                android:color="@color/cs_main_color"/>
        </shape>
    </item>
</selector>
