<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="50dp"
        android:width="50dp">
        <shape>
            <solid android:color="#eceefc"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
    <item
        android:height="40dp"
        android:width="40dp"
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape>
            <solid android:color="@color/theme_color"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
