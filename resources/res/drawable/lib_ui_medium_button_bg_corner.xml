<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/ppMediumButtonHeight"/>
            <padding
                android:left="@dimen/ppButtonVerticalPadding"
                android:top="@dimen/ppButtonVerticalPadding"
                android:right="@dimen/ppButtonVerticalPadding"
                android:bottom="@dimen/ppButtonVerticalPadding"/>
            <size
                android:height="@dimen/ppMediumButtonHeight"
                android:width="60dp"/>
            <solid android:color="@color/ppColorDisabled"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ppMediumButtonHeight"/>
            <padding
                android:left="@dimen/ppButtonVerticalPadding"
                android:top="@dimen/ppButtonVerticalPadding"
                android:right="@dimen/ppButtonVerticalPadding"
                android:bottom="@dimen/ppButtonVerticalPadding"/>
            <size
                android:height="@dimen/ppMediumButtonHeight"
                android:width="60dp"/>
            <solid android:color="@color/ppColorPrimary"/>
        </shape>
    </item>
</selector>
