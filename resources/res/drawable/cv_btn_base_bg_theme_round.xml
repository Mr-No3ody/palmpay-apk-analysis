<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ppColorPrimary"/>
            <corners android:radius="500dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/ppColorDisabled"/>
            <corners android:radius="500dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="@color/ppColorPrimary"
                android:endColor="@color/ppColorPrimary"
                android:angle="315"/>
            <corners android:radius="500dp"/>
        </shape>
    </item>
</selector>
